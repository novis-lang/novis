<?nvs
namespace Novis\Pdf;

use LogicError;

/// An HTML document to render as a PDF file, with the images, stylesheets and fonts it uses.
/// Each method returns a new `Document` and leaves this one as it was.
final class Document
{
    type Asset = { name: string, data: bytes };
    type Margin = { fn: callable(Page): Core\Html\Markup, height: ?string };
    type Fill = { fn: callable(Page): array<Core\Html\Markup> };

    private function constructor(
        private readonly string $html,
        private readonly array<Asset> $assets,
        private readonly ?Standard $standard,
        private readonly ?string $invoiceXml,
        private readonly ?string $password,
        private readonly ?Core\Time\Instant $created,
        private readonly ?Margin $header,
        private readonly ?Margin $footer,
        private readonly ?Fill $slots,
    )
    {}

    /// `Document::fromHtml` starts a document from its HTML.
    /// The HTML may name assets, such as `<img src="logo.png">`. Add each one with `asset`.
    public static function fromHtml(Core\Html\Markup|string $html): Document
    {
        if ($html is Core\Html\Markup) {
            return new Document(Core\Html::toSource($html, 'the PDF engine parses the document itself'), [], null, null, null, null, null, null, null);
        }
        return new Document($html as string, [], null, null, null, null, null, null, null);
    }

    /// `asset` adds a file the HTML names, such as an image or a stylesheet.
    /// A render reads only these files and `data:` URIs. Any other name throws a `LogicError`.
    public function asset(string $name, bytes $data): Document
    {
        array<Asset> $assets = $this->assets;
        $assets[] = { name: $name, data: $data };
        return new Document($this->html, $assets, $this->standard, $this->invoiceXml, $this->password, $this->created, $this->header, $this->footer, $this->slots);
    }

    /// `standard` sets the PDF standard the file follows.
    public function standard(Standard $standard): Document
    {
        return new Document($this->html, $this->assets, $standard, $this->invoiceXml, $this->password, $this->created, $this->header, $this->footer, $this->slots);
    }

    /// `invoiceXml` attaches the XML of an electronic invoice to the file.
    /// It needs the standard `Document::Standard::PdfA3b`. With any other standard, `render` throws a `LogicError`.
    public function invoiceXml(string $xml): Document
    {
        return new Document($this->html, $this->assets, $this->standard, $xml, $this->password, $this->created, $this->header, $this->footer, $this->slots);
    }

    /// `password` encrypts the file. A reader needs the password to open it.
    /// A PDF/A standard does not allow a password, so `render` then throws a `LogicError`.
    public function password(string $password): Document
    {
        return new Document($this->html, $this->assets, $this->standard, $this->invoiceXml, $password, $this->created, $this->header, $this->footer, $this->slots);
    }

    /// `created` sets the creation time in the file. Without it, the file has no creation time.
    public function created(Core\Time\Instant $at): Document
    {
        return new Document($this->html, $this->assets, $this->standard, $this->invoiceXml, $this->password, $at, $this->header, $this->footer, $this->slots);
    }

    /// `header` sets a function that returns the header of each page. `render` calls it once for each page.
    /// The header is drawn in the top margin. `height` sets that margin, such as `"2cm"`. Without it, the margin is the one `@page` gives.
    public function header(callable(Page): Core\Html\Markup $fn, ?{ height?: string } $options = null): Document
    {
        Margin $header = { fn: $fn, height: $options?->height };
        return new Document($this->html, $this->assets, $this->standard, $this->invoiceXml, $this->password, $this->created, $header, $this->footer, $this->slots);
    }

    /// `footer` sets a function that returns the footer of each page. It works like `header`, in the bottom margin.
    public function footer(callable(Page): Core\Html\Markup $fn, ?{ height?: string } $options = null): Document
    {
        Margin $footer = { fn: $fn, height: $options?->height };
        return new Document($this->html, $this->assets, $this->standard, $this->invoiceXml, $this->password, $this->created, $this->header, $footer, $this->slots);
    }

    /// `slots` sets a function that fills each `<slot name="...">` in a table row. `render` calls it once for each page.
    /// It returns the HTML for each slot name. Nothing on the page moves, and HTML too tall for its cell is listed in `Rendered::overflows`.
    public function slots(callable(Page): array<Core\Html\Markup> $fn): Document
    {
        Fill $slots = { fn: $fn };
        return new Document($this->html, $this->assets, $this->standard, $this->invoiceXml, $this->password, $this->created, $this->header, $this->footer, $slots);
    }

    /// `render` returns the PDF file and its pages.
    /// Two renders of the same document give the same bytes.
    public function render(): Rendered
    {
        var $document = {
            html: $this->html,
            assets: $this->assets,
            options: {
                standard: $this->standard,
                password: $this->password,
                invoiceXml: $this->invoiceXml,
                created: $this->created,
            },
        };
        if ($this->header == null && $this->footer == null && $this->slots == null) {
            var $whole = Engine::render($document);
            return new Rendered($whole->data, $whole->pageCount, $whole->dropped, $whole->missingGlyphs, $whole->overflows);
        }
        var $facts = Engine::render({
            document: $document,
            headerHeight: $this->header?->height,
            footerHeight: $this->footer?->height,
        });
        array<array<Page::Named>> $marks = [];
        foreach ($facts->pages as var $page) {
            $marks[] = $page->marks;
        }
        array<{ header: ?string, footer: ?string, slots: array<{ name: string, value: string }> }> $pages = [];
        foreach ($facts->pages as var $page) {
            var $one = new Page($page->number, $facts->pageCount, $page->name, $page->strings, $marks);
            $pages[] = { header: self::markup($this->header, $one), footer: self::markup($this->footer, $one), slots: self::fills($this->slots, $one) };
        }
        var $result = Engine::render({ pages: $pages });
        return new Rendered($result->data, $result->pageCount, $result->dropped, $result->missingGlyphs, $result->overflows);
    }

    private static function markup(?Margin $margin, Page $page): ?string
    {
        if ($margin == null) {
            return null;
        }
        callable(Page): Core\Html\Markup $fn = $margin->fn;
        return Core\Html::toSource($fn($page), 'the PDF engine parses the markup itself');
    }

    private static function fills(?Fill $slots, Page $page): array<{ name: string, value: string }>
    {
        array<{ name: string, value: string }> $out = [];
        if ($slots == null) {
            return $out;
        }
        callable(Page): array<Core\Html\Markup> $fn = $slots->fn;
        foreach ($fn($page) as string $name => Core\Html\Markup $markup) {
            $out[] = { name: $name, value: Core\Html::toSource($markup, 'the PDF engine parses the markup itself') };
        }
        return $out;
    }
}
