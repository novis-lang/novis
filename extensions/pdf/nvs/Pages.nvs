<?nvs
namespace Novis\Pdf;

/// Pages chosen from an existing PDF file. `Pages::merge` puts the chosen pages of several files into one file.
final class Pages
{
    private function constructor(
        private readonly bytes $pdf,
        private readonly ?array<uint> $pages,
    )
    {}

    /// `Pages::of` chooses pages of a PDF file, in the order of `$pages`. Pages count from 1.
    /// Without `$pages`, every page is chosen. A page listed twice is used twice, and a page not listed is left out.
    public static function of(bytes $pdf, ?array<uint> $pages = null): Pages
    {
        return new Pages($pdf, $pages);
    }

    /// `Pages::merge` returns one PDF file with the chosen pages of each part, in order.
    /// A page number past the end of its file throws a `LogicError`. A file that is encrypted or does not parse throws a `ParseError`.
    public static function merge(array<Pages> $parts): bytes
    {
        array<{ data: bytes, pages: ?array<uint> }> $sources = [];
        foreach ($parts as Pages $part) {
            $sources[] = { data: $part->pdf, pages: $part->pages };
        }
        return Engine::merge($sources, { maxBytes: null, maxRatio: null });
    }
}
