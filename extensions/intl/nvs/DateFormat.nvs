<?nvs
namespace Novis\Intl;

/// Writes dates and times the way a language and region write them. Each method takes a whole
/// list and a locale tag, such as `"de"` or `"en-GB"`, and formats the whole list in one call.
final class DateFormat
{
    /// `DateFormat::dateTimes` returns each date and time as a string in the language of `$locale`,
    /// such as `"de"` for German. The time is the time in the value's own time zone.
    /// `length` and `fields` work as in `DateFormat::dates`. Set `seconds` to `true` to show the
    /// seconds. `zone` is a `ZoneStyle` and chooses how the time zone is shown, such as "GMT+1".
    /// By default, no seconds and no time zone are shown.
    public static function dateTimes(array<Core\Time\DateTime> $values, string $locale, ?{ length?: Length, fields?: Fields, seconds?: bool, zone?: ZoneStyle } $options = null): array<string>
    {
        array<{ year: int, month: int, day: int, hour: int, minute: int, second: int, nanos: int, offsetSeconds: int, zone: string }> $fields = [];
        foreach ($values as Core\Time\DateTime $value) {
            $fields[] = {
                year: $value->year(),
                month: $value->month() as int,
                day: $value->day() as int,
                hour: $value->hour() as int,
                minute: $value->minute() as int,
                second: $value->second() as int,
                nanos: $value->nanoseconds() as int,
                offsetSeconds: $value->zone()->offsetAt($value->toInstant())->toSeconds(),
                zone: $value->format('VV'),
            };
        }
        return Icu::formatDateTimes($fields, $locale, $options ?? {});
    }

    /// `DateFormat::dates` returns each calendar date as a string in the language of `$locale`,
    /// such as `"de"` for German. `length` is a `Length` and chooses how long each string is.
    /// `fields` is a `Fields` and chooses which parts of the date are shown.
    /// The defaults are `Length::Medium` and `Fields::YearMonthDay`, such as "Mar 1, 2026".
    public static function dates(array<Core\Time\Date> $values, string $locale, ?{ length?: Length, fields?: Fields } $options = null): array<string>
    {
        return Icu::formatDates($values, $locale, $options ?? {});
    }

    /// `DateFormat::times` returns each time of day, with hours and minutes. Set `seconds` to
    /// `true` to show the seconds too.
    public static function times(array<Core\Time\TimeOfDay> $values, string $locale, ?{ seconds?: bool } $options = null): array<string>
    {
        return Icu::formatTimes($values, $locale, $options ?? {});
    }
}
