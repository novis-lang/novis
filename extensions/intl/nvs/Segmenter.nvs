<?nvs
namespace Novis\Intl;

/// Splits text into words or sentences, the way a language does. The methods take many strings
/// and a locale tag, such as `"ja"`, and split them all in one call.
final class Segmenter
{
    /// `Segmenter::words` returns each string as a list of parts. `wordLike` is `true` for a word
    /// or a number, and `false` for spaces and punctuation. All parts joined give the string.
    public static function words(array<string> $strings, string $locale): array<array<{text: string, wordLike: bool}>>
    {
        return Icu::wordSegments($strings, $locale);
    }

    /// `Segmenter::sentences` returns each string as a list of sentences. A sentence keeps the
    /// spaces after it. An empty string gives an empty list.
    public static function sentences(array<string> $strings, string $locale): array<array<string>>
    {
        return Icu::sentenceSegments($strings, $locale);
    }
}
