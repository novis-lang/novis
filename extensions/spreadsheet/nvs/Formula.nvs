<?nvs
namespace Novis\Spreadsheet;

/// An Excel formula for one cell, such as `SUM(C2:C9)`. Make one with `Formula::of`.
/// A string is always written as text. Only a `Formula` is written as a formula.
final class Formula
{
    /// `new Formula` makes a formula from its values. `Formula::of` makes one for you.
    /// `text` has no `=` at the start. It is `tainted`, because `Reader` can read a formula from a file. `cached` is the result the file has for a program that does not calculate.
    public function constructor(
        public readonly tainted string $text,
        public readonly string|int|float|null $cached,
    )
    {}

    /// `Formula::of` makes a formula from its Excel text, such as `'SUM(C2:C9)'`. You can write the text with or without `=` at the start.
    /// `cached` is the result the file has for a program that does not calculate. Excel calculates every formula again when it opens the file.
    public static function of(string $text, ?{ cached?: string|int|float } $options = null): Formula
    {
        string $plain = Core\Str::startsWith($text, '=') ? Core\Str::slice($text, 1) : $text;
        return new Formula($plain, $options?->cached ?? null);
    }
}
