<?nvs
namespace Novis\Spreadsheet;

use Iterator;
use LogicError;
use RuntimeError;

/// A spreadsheet file that your program reads row by row, such as an upload. It can be xlsx, xlsm, xlsb, xls, ods or CSV.
/// Open one with `Reader::open`. Every string and `bytes` value it returns is `tainted`, because it comes from the file.
final class Reader
{
    type RowOptions = ?{ header?: bool|int, from?: uint, limit?: uint, columns?: array<string>, zone?: string, text?: bool|array<string>, formulas?: bool, emptyRows?: string, merged?: string, hidden?: string, locale?: string };
    type SheetInfo = { name: tainted string, position: uint, visibility: Visibility, rows: uint, columns: uint, kind: SheetKind };
    type Link = { anchor: tainted string, target: tainted string, text: ?tainted string, tooltip: ?tainted string, external: bool };
    type Note = { noted: tainted string, note: tainted string, author: ?tainted string };
    type Name = { name: tainted string, reference: tainted string, sheet: ?tainted string };
    type Table = { table: tainted string, name: tainted string, sheet: tainted string };
    type Image = { at: tainted string, image: tainted bytes, format: tainted string, link: ?tainted string };
    type Properties = { title: ?tainted string, subject: ?tainted string, author: ?tainted string, company: ?tainted string, keywords: ?tainted string, created: ?Core\Time\Instant };
    type Read = { text: tainted string }|{ integer: int }|{ number: float }|{ boolean: bool }|{ day: Core\Time\Date, clock: Core\Time\TimeOfDay }|{ date: Core\Time\Date }|{ time: Core\Time\TimeOfDay }|{ duration: Core\Time\Duration }|{ error: CellError };
    type Asked = { sheet: string, headerRow: ?uint, from: ?uint, limit: ?uint, columns: array<string>, text: array<string>, textAll: bool, formulas: bool, keepEmptyRows: bool, fillMerged: bool, skipHidden: bool, locale: string };

    // `$reader` is `null` for a CSV file. `$csv` is the text of CSV bytes, and `$skip` is the length of a byte order mark at the start of a CSV file.
    private function constructor(
        private readonly ?Reading $reader,
        private readonly tainted bytes|Core\IO\File $source,
        private readonly ?tainted string $csv,
        private readonly uint $skip,
    )
    {}

    /// `Reader::open` opens the workbook in `$source`, the bytes of the file or a file your program opened. Another file type throws an error.
    /// An xls or ods file is read whole here. A CSV file is UTF-8 text with one sheet, `Sheet1`, and each value in it is a `string`.
    public static function open(tainted bytes|Core\IO\File $source): Reader
    {
        if ($source is Core\IO\File) {
            ?uint $skip = self::csvFile($source);
            if ($skip != null) {
                return new Reader(null, $source, null, $skip);
            }
        } elseif ($source is bytes) {
            ?tainted string $text = self::csvText($source);
            if ($text != null) {
                return new Reader(null, $source, $text, 0);
            }
        }
        return new Reader(Engine::readerOpen($source, { maxBytes: null, maxRatio: null }), $source, null, 0);
    }

    /// `sheets` returns each sheet in tab order, with its name, its position from 0, whether it is hidden, its size and its kind.
    public function sheets(): array<SheetInfo>
    {
        if ($this->reader == null) {
            return [$this->csvInfo()];
        }
        return Engine::readerSheets($this->engine(), $this->source);
    }

    /// `macros` returns the names of the macro modules in an xlsm or xls file. The list is empty when the file has no macros.
    /// Reading a file never runs its macros.
    public function macros(): array<tainted string>
    {
        if ($this->reader == null) {
            return [];
        }
        return Engine::readerMacros($this->engine(), $this->source);
    }

    /// `merged` returns the merged cells of the sheet `$sheet`, by name or by position from 0. Each one is a range such as `"A1:C2"`.
    /// When you read rows, the value of a merged range is in its top-left cell. With `merged: 'fill'`, every cell of the range has that value.
    public function merged(string|int $sheet): array<tainted string>
    {
        string $name = $this->sheetName($sheet);
        if ($this->reader == null) {
            return [];
        }
        return Engine::readerMerged($this->engine(), $this->source, $name);
    }

    /// `links` returns the hyperlinks of the sheet `$sheet`. `anchor` is the cell, such as `"B2"`, and `target` is where the link goes.
    /// `external` is `true` for a URL or a file. Reading a file never opens its links.
    public function links(string|int $sheet): array<Link>
    {
        string $name = $this->sheetName($sheet);
        if ($this->reader == null) {
            return [];
        }
        return Engine::readerLinks($this->engine(), $this->source, $name);
    }

    /// `notes` returns the notes of the sheet `$sheet`. Each one has its cell in `noted`, its text in `note`, and its `author`.
    public function notes(string|int $sheet): array<Note>
    {
        string $name = $this->sheetName($sheet);
        if ($this->reader == null) {
            return [];
        }
        return Engine::readerNotes($this->engine(), $this->source, $name);
    }

    /// `names` returns the defined names of the workbook. `reference` is the text of the name, such as `"Shop!$A$1:$C$9"`.
    /// `sheet` is `null` for a name the whole workbook can use.
    public function names(): array<Name>
    {
        if ($this->reader == null) {
            return [];
        }
        return Engine::readerNames($this->engine(), $this->source);
    }

    /// `tables` returns the Excel tables of the sheet `$sheet`. `table` is the range, such as `"A1:C10"`, and `name` is the table name.
    public function tables(string|int $sheet): array<Table>
    {
        string $name = $this->sheetName($sheet);
        if ($this->reader == null) {
            return [];
        }
        return Engine::readerTables($this->engine(), $this->source, $name);
    }

    /// `images` returns the pictures of the sheet `$sheet`. `at` is the top-left cell, and `image` is the bytes of the picture.
    /// A linked picture has empty `image` bytes, and `link` is its target. Reading a file never fetches a link.
    public function images(string|int $sheet): array<Image>
    {
        string $name = $this->sheetName($sheet);
        if ($this->reader == null) {
            return [];
        }
        return Engine::readerImages($this->engine(), $this->source, $name);
    }

    /// `properties` returns the title, subject, author, company and keywords of the workbook, and the time it was created.
    /// A property the file does not have is `null`, and every property of a CSV file is `null`. An xls or ods file throws an error.
    public function properties(): Properties
    {
        if ($this->reader == null) {
            return { title: null, subject: null, author: null, company: null, keywords: null, created: null };
        }
        var $found = Engine::readerProperties($this->engine(), $this->source);
        ?Core\Time\Instant $created = null;
        var $at = $found->created;
        if ($at != null) {
            $created = Core\Time::parse($at->day->format('yyyy-MM-dd'), 'yyyy-MM-dd', Core\Time\Zone::of('UTC'))->withTime($at->clock)->toInstant();
        }
        return {
            title: $found->title,
            subject: $found->subject,
            author: $found->author,
            company: $found->company,
            keywords: $found->keywords,
            created: $created,
        };
    }

    /// `rows` reads the sheet `$sheet`, by name or by position from 0, and gives one `Row` at a time. With `header: true`, the keys are the header cells.
    /// `text: ["Zip"]` reads the column `Zip` as the text Excel shows, so `1234` with the format `00000` is `"01234"`. `text: true` reads every column this way.
    public function rows(string|int $sheet, RowOptions $options = null): Iterator<Row>
    {
        bool|array<string> $text = $options?->text ?? false;
        Asked $asked = {
            sheet: $this->sheetName($sheet),
            headerRow: null,
            from: $options?->from ?? null,
            limit: null,
            columns: $options?->columns ?? [],
            text: $text is array<string> ? $text : [],
            textAll: $text is bool && $text,
            formulas: $options?->formulas ?? false,
            keepEmptyRows: self::choice($options?->emptyRows ?? null, 'emptyRows', 'skip', 'keep'),
            fillMerged: self::choice($options?->merged ?? null, 'merged', 'first', 'fill'),
            skipHidden: self::choice($options?->hidden ?? null, 'hidden', 'read', 'skip'),
            locale: $options?->locale ?? 'en',
        };
        Core\Time\Zone $zone = Core\Time\Zone::of($options?->zone ?? 'UTC');
        bool|int $header = $options?->header ?? false;
        ?uint $headerRow = null;
        if ($header is int) {
            if ($header < 1) {
                throw new LogicError("The option `header` is `true` or a row number, and the first row is 1. It cannot be {$header}.");
            }
            $headerRow = $header as uint;
        }
        if ($this->reader == null) {
            return $this->csvWalk($header is bool && $header, $headerRow, $options?->from ?? null, $options?->limit ?? null, $asked->columns, $asked->keepEmptyRows);
        }
        return $this->walk($asked, $header is bool && $header, $headerRow, $options?->from ?? null, $options?->limit ?? null, $zone);
    }

    private function walk(Asked $asked, bool $findHeader, ?uint $headerRow, ?uint $from, ?uint $limit, Core\Time\Zone $zone): Iterator<Row>
    {
        if ($findHeader) {
            $headerRow = $this->firstRow($asked, $from);
            if ($headerRow == null) {
                return;
            }
        }
        array<tainted string> $keys = $this->keys($asked, $headerRow, $from);
        ?uint $next = $from;
        ?uint $left = $limit;
        while (true) {
            uint $most = 1000;
            if ($left != null && $left < $most) {
                $most = $left;
            }
            if ($most == 0) {
                return;
            }
            var $batch = Engine::readerRows($this->engine(), $this->source, Reader::with($asked, $headerRow, $next, $left, $asked->keepEmptyRows, true), $most);
            uint $count = Core\Arr::count($batch->rows);
            foreach ($batch->rows as var $row) {
                array<mixed> $values = [];
                uint $column = 0;
                foreach ($keys as tainted string $named) {
                    $column = $column + 1;
                    if (Reader::selected($asked->columns, $column)) {
                        $values[$named] = null;
                    }
                }
                foreach ($row->cells as var $cell) {
                    tainted string $key = $cell->column <= Core\Arr::count($keys) ? $keys[$cell->column - 1] : Reader::letters($cell->column);
                    $values[$key] = Reader::value($cell->value, $cell->formula, $cell->display, $asked->formulas, $zone);
                }
                $next = $row->number + 1;
                yield new Row($row->number, $values);
            }
            if ($count < $most) {
                return;
            }
            ?uint $before = $left;
            if ($before != null) {
                $left = $before - $count;
            }
        }
    }

    private function firstRow(Asked $asked, ?uint $from): ?uint
    {
        var $first = Engine::readerRows($this->engine(), $this->source, self::with($asked, null, $from, 1, false, false), 1);
        foreach ($first->rows as var $row) {
            return $row->number;
        }
        return null;
    }

    private function keys(Asked $asked, ?uint $headerRow, ?uint $from): array<tainted string>
    {
        if ($headerRow == null) {
            return [];
        }
        return Engine::readerHeader($this->engine(), $this->source, self::with($asked, $headerRow, $from, null, $asked->keepEmptyRows, false));
    }


    // Reads a CSV file one record at a time. Only the header row and the empty rows are kept out, and each row is numbered by its record.
    private function csvWalk(bool $findHeader, ?uint $headerRow, ?uint $from, ?uint $limit, array<string> $columns, bool $keepEmptyRows): Iterator<Row>
    {
        array<tainted string> $keys = [];
        bool $keyed = !$findHeader && $headerRow == null;
        uint $number = 0;
        uint $given = 0;
        foreach ($this->records() as array<tainted string> $record) {
            $number = $number + 1;
            bool $empty = $this->csvBlank($record);
            bool $after = $from == null || $number >= $from;
            if (!$keyed) {
                if (($findHeader && !$empty && $after) || $number == $headerRow) {
                    $keys = $this->csvKeys($record);
                    $keyed = true;
                }
            } elseif ($after && ($keepEmptyRows || !$empty)) {
                if ($limit != null && $given >= $limit) {
                    return;
                }
                $given = $given + 1;
                Row $row = $this->csvRow($number, $record, $keys, $columns);
                yield $row;
            }
        }
    }

    // Each record of the CSV file, from its first byte after a byte order mark. A walk to the end puts the position of an open file back.
    private function records(): Iterator<array<tainted string>>
    {
        ?tainted string $text = $this->csv;
        if ($text != null) {
            foreach (Core\Csv::parse($text) as array<tainted string> $record) {
                yield $record;
            }
            return;
        }
        var $source = $this->source;
        if ($source is Core\IO\File) {
            uint $at = $source->tell();
            $source->seek($this->skip);
            foreach (Core\Csv::rows($source) as array<string> $line) {
                yield $line;
            }
            $source->seek($at);
        }
    }

    private function csvBlank(array<tainted string> $record): bool
    {
        foreach ($record as tainted string $field) {
            if ($field != '') {
                return false;
            }
        }
        return true;
    }

    // The header keys of a CSV file: a repeated name gets ` (2)`, and an empty one is its column letter, as in a workbook.
    private function csvKeys(array<tainted string> $record): array<tainted string>
    {
        array<tainted string> $keys = [];
        uint $column = 0;
        foreach ($record as tainted string $field) {
            $column = $column + 1;
            tainted string $key = $field == '' ? self::letters($column) : $field;
            tainted string $named = $key;
            uint $count = 1;
            while (Core\Arr::contains($keys, $named)) {
                $count = $count + 1;
                $named = $key . " ({$count})";
            }
            $keys[] = $named;
        }
        return $keys;
    }

    // One record as a `Row`. An empty field is an empty cell, so it is `null` under a header and has no key without one.
    private function csvRow(uint $number, array<tainted string> $record, array<tainted string> $keys, array<string> $columns): Row
    {
        array<mixed> $values = [];
        uint $column = 0;
        foreach ($keys as tainted string $named) {
            $column = $column + 1;
            if (self::selected($columns, $column)) {
                $values[$named] = null;
            }
        }
        $column = 0;
        foreach ($record as tainted string $field) {
            $column = $column + 1;
            if ($field != '' && self::selected($columns, $column)) {
                tainted string $key = $column <= Core\Arr::count($keys) ? $keys[$column - 1] : self::letters($column);
                $values[$key] = $field;
            }
        }
        return new Row($number, $values);
    }

    private function csvInfo(): SheetInfo
    {
        uint $rows = 0;
        uint $columns = 0;
        foreach ($this->records() as array<tainted string> $record) {
            $rows = $rows + 1;
            uint $width = Core\Arr::count($record);
            if ($width > $columns) {
                $columns = $width;
            }
        }
        return { name: 'Sheet1', position: 0, visibility: Visibility::Visible, rows: $rows, columns: $columns, kind: SheetKind::Worksheet };
    }

    // The text of CSV bytes, or `null` for a zip archive or bytes that are not UTF-8, which the engine reads.
    private static function csvText(tainted bytes $data): ?tainted string
    {
        tainted string $text = '';
        try {
            $text = Core\Encoding::decodeText($data, Core\Charset::Utf8);
        } catch (RuntimeError $e) {
            return null;
        }
        if (self::zipStart(Core\Str::codePoints(Core\Str::slice($text, 0, 3)))) {
            return null;
        }
        if (Core\Str::startsWith($text, "\u{FEFF}")) {
            return Core\Str::slice($text, 1);
        }
        return $text;
    }

    // The length of the byte order mark of a CSV file. It is `null` for a zip archive, or a file that does not start with UTF-8 text.
    // The position of `$file` is the same after this call.
    private static function csvFile(Core\IO\File $file): ?uint
    {
        uint $at = $file->tell();
        $file->seek(0);
        string $head = '';
        try {
            $head = $file->read(4);
        } catch (RuntimeError $e) {
            $file->seek($at);
            return null;
        }
        $file->seek($at);
        array<uint> $codes = Core\Str::codePoints($head);
        if (self::zipStart($codes)) {
            return null;
        }
        if (Core\Arr::count($codes) > 0 && $codes[0] == 65279) {
            return 3;
        }
        return 0;
    }

    // A zip archive starts with `PK` and a control byte. A CSV file that starts with `PK` has a letter or a separator next.
    private static function zipStart(array<uint> $codes): bool
    {
        return Core\Arr::count($codes) >= 3 && $codes[0] == 80 && $codes[1] == 75 && $codes[2] < 9;
    }

    private function engine(): Reading
    {
        ?Reading $reader = $this->reader;
        if ($reader == null) {
            throw new LogicError('A CSV file has no workbook parts.');
        }
        return $reader;
    }

    private function sheetName(string|int $sheet): string
    {
        if ($this->reader == null) {
            if (($sheet is string && $sheet == 'Sheet1') || ($sheet is int && $sheet == 0)) {
                return 'Sheet1';
            }
            throw new LogicError("A CSV file has one sheet, `Sheet1` at position 0. It has no sheet `{$sheet}`.");
        }
        if ($sheet is string) {
            return $sheet;
        }
        foreach ($this->sheets() as var $info) {
            if ($info->position as int == $sheet) {
                return Core\Taint::assertTrusted($info->name, 'the file gave this sheet name, and it goes back only to the same file');
            }
        }
        throw new LogicError("The workbook has no sheet at position {$sheet}. The first sheet is at position 0.");
    }

    private static function with(Asked $asked, ?uint $headerRow, ?uint $from, ?uint $limit, bool $keepEmptyRows, bool $shown): Asked
    {
        return {
            sheet: $asked->sheet,
            headerRow: $headerRow,
            from: $from,
            limit: $limit,
            columns: $asked->columns,
            text: $shown ? $asked->text : [],
            textAll: $shown && $asked->textAll,
            formulas: $asked->formulas,
            keepEmptyRows: $keepEmptyRows,
            fillMerged: $asked->fillMerged,
            skipHidden: $asked->skipHidden,
            locale: $asked->locale,
        };
    }

    private static function choice(?string $given, string $option, string $usual, string $other): bool
    {
        if ($given == null || $given == $usual) {
            return false;
        }
        if ($given == $other) {
            return true;
        }
        throw new LogicError("The option `{$option}` is `'{$usual}'` or `'{$other}'`, not `'{$given}'`.");
    }

    private static function value(?Read $value, ?tainted string $formula, ?tainted string $display, bool $formulas, Core\Time\Zone $zone): mixed
    {
        if ($display != null) {
            return $display;
        }
        mixed $plain = self::plain($value, $zone);
        if ($formulas && $formula != null) {
            string|int|float|null $cached = null;
            if ($plain is int) {
                $cached = $plain;
            } elseif ($plain is float) {
                $cached = $plain;
            }
            return new Formula($formula, $cached);
        }
        return $plain;
    }

    private static function plain(?Read $value, Core\Time\Zone $zone): mixed
    {
        if ($value is { text: tainted string }) {
            return $value->text;
        }
        if ($value is { integer: int }) {
            return $value->integer;
        }
        if ($value is { number: float }) {
            return $value->number;
        }
        if ($value is { boolean: bool }) {
            return $value->boolean;
        }
        if ($value is { day: Core\Time\Date, clock: Core\Time\TimeOfDay }) {
            return Core\Time::parse($value->day->format('yyyy-MM-dd'), 'yyyy-MM-dd', $zone)->withTime($value->clock);
        }
        if ($value is { date: Core\Time\Date }) {
            return $value->date;
        }
        if ($value is { time: Core\Time\TimeOfDay }) {
            return $value->time;
        }
        if ($value is { duration: Core\Time\Duration }) {
            return $value->duration;
        }
        if ($value is { error: CellError }) {
            return $value->error;
        }
        return null;
    }

    private static function selected(array<string> $columns, uint $column): bool
    {
        if (Core\Arr::count($columns) == 0) {
            return true;
        }
        foreach ($columns as string $range) {
            array<string> $ends = Core\Str::split($range, ':');
            uint $first = self::number($ends[0]);
            uint $last = Core\Arr::count($ends) > 1 ? self::number($ends[1]) : $first;
            if ($column >= $first && $column <= $last) {
                return true;
            }
        }
        return false;
    }

    private static function number(string $letters): uint
    {
        uint $number = 0;
        foreach (Core\Str::codePoints(Core\Str::upper($letters)) as uint $code) {
            $number = $number * 26 + ($code - 64);
        }
        return $number;
    }

    private static function letters(uint $column): string
    {
        string $letters = '';
        int $left = $column as int;
        while ($left > 0) {
            int $rest = ($left - 1) % 26;
            $letters = Core\Str::fromCodePoint((65 + $rest) as uint) . $letters;
            $left = Core\Math::intDiv($left - 1, 26);
        }
        return $letters;
    }
}
