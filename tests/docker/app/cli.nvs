<?nvs
// The script `nvs run` starts. Each line prints one fact the image must get right.

// The arguments after `--` reach the program. With `-- a b` this prints "arguments: 2".
echo 'arguments: ', Core\Arr::count(Core\Cli::arguments()), "\n";

// A named time zone needs the zone files of the image. This prints "zone: ok".
var $zone = Core\Time\Zone::of('America/New_York');
echo "zone: ok\n";

// `Core\IO::temporaryDir` creates its folder in the data folder, so the user `nonroot`
// must be able to write there. This prints "data folder: ok".
string $draft = Core\Path::join(Core\IO::temporaryDir(), 'draft.txt');
Core\IO::write($draft, 'ok');
echo 'data folder: ', Core\IO::readText($draft), "\n";
