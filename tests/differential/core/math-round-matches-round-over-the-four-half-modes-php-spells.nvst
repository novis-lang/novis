--TEST--
Core\Math::round answers what round answers under each of the four PHP_ROUND_HALF_* constants, at a precision on either side of the point, and its two remaining modes are the away-and-toward-zero pair PHP has no half-rule for
--FILE--
<?nvs
// Spec § 3's `round` row: one member and a `RoundMode` where PHP has a function
// and four constants. The tie is the whole question — away from a tie every mode
// agrees with every other, so a member that ignored `mode` entirely would print
// plausibly on any subject that is not exactly half. Every subject in the first
// sweep is therefore exactly representable in binary *and* exactly half, so the
// four columns are four different answers and no float is being asked to
// approximate anything.
array<float> $halves = [0.5, 1.5, 2.5, -1.5, -2.5];

foreach ($halves as float $h) {
    echo Core\Math::round($h, {mode: Core\RoundMode::HalfUp}), " ",
         Core\Math::round($h, {mode: Core\RoundMode::HalfDown}), " ",
         Core\Math::round($h, {mode: Core\RoundMode::HalfEven}), " ",
         Core\Math::round($h, {mode: Core\RoundMode::HalfOdd}), "\n";
}

// `precision` moves the tie rather than changing the rule: an eighth is exactly
// half of a hundredth, so the same four answers appear two digits along.
echo Core\Math::round(0.125, {precision: 2, mode: Core\RoundMode::HalfUp}), " ",
     Core\Math::round(0.125, {precision: 2, mode: Core\RoundMode::HalfEven}), " ",
     Core\Math::round(-0.375, {precision: 2, mode: Core\RoundMode::HalfUp}), " ",
     Core\Math::round(-0.375, {precision: 2, mode: Core\RoundMode::HalfEven}), "\n";

// A negative precision moves it the other way, to a tie between two hundreds —
// the direction a member built around a decimal-place count rather than a scale
// does not have.
echo Core\Math::round(1250.0, {precision: -2, mode: Core\RoundMode::HalfUp}), " ",
     Core\Math::round(1250.0, {precision: -2, mode: Core\RoundMode::HalfEven}), " ",
     Core\Math::round(1234.5678, {precision: 2}), " ",
     Core\Math::round(1234.5678, {precision: -2}), "\n";

// The default: no `mode` named is half away from zero, which is `round`'s own
// default and the one every PHP program that never passed a constant is
// relying on.
echo Core\Math::round(2.5), " ", Core\Math::round(-2.5), " ", Core\Math::round(2.4), "\n";

// The two modes PHP's constants cannot spell as a *half* rule, because they are
// not half rules at all: they take every value away from or toward zero
// whatever its fraction. PHP callers write them as a signed `ceil`/`floor`
// pair, which is what the oracle does.
echo Core\Math::round(2.1, {mode: Core\RoundMode::Up}), " ",
     Core\Math::round(-2.1, {mode: Core\RoundMode::Up}), " ",
     Core\Math::round(2.9, {mode: Core\RoundMode::Down}), " ",
     Core\Math::round(-2.9, {mode: Core\RoundMode::Down}), "\n";

// A value already at the precision asked for is returned unchanged under every
// mode, which is the row that says the tie rule is reached only by a tie.
echo Core\Math::round(7.0, {mode: Core\RoundMode::HalfEven}), " ",
     Core\Math::round(7.0, {mode: Core\RoundMode::HalfOdd}), " ",
     Core\Math::round(7.25, {precision: 2, mode: Core\RoundMode::HalfDown}), "\n";
--ORACLE--
<?php
function away(float $n): float {
    return $n >= 0 ? ceil($n) : floor($n);
}

function toward(float $n): float {
    return $n >= 0 ? floor($n) : ceil($n);
}

$halves = [0.5, 1.5, 2.5, -1.5, -2.5];

foreach ($halves as $h) {
    echo round($h, 0, PHP_ROUND_HALF_UP), " ",
         round($h, 0, PHP_ROUND_HALF_DOWN), " ",
         round($h, 0, PHP_ROUND_HALF_EVEN), " ",
         round($h, 0, PHP_ROUND_HALF_ODD), "\n";
}

echo round(0.125, 2, PHP_ROUND_HALF_UP), " ",
     round(0.125, 2, PHP_ROUND_HALF_EVEN), " ",
     round(-0.375, 2, PHP_ROUND_HALF_UP), " ",
     round(-0.375, 2, PHP_ROUND_HALF_EVEN), "\n";

echo round(1250.0, -2, PHP_ROUND_HALF_UP), " ",
     round(1250.0, -2, PHP_ROUND_HALF_EVEN), " ",
     round(1234.5678, 2), " ",
     round(1234.5678, -2), "\n";

echo round(2.5), " ", round(-2.5), " ", round(2.4), "\n";

echo away(2.1), " ", away(-2.1), " ", toward(2.9), " ", toward(-2.9), "\n";

echo round(7.0, 0, PHP_ROUND_HALF_EVEN), " ",
     round(7.0, 0, PHP_ROUND_HALF_ODD), " ",
     round(7.25, 2, PHP_ROUND_HALF_DOWN), "\n";
