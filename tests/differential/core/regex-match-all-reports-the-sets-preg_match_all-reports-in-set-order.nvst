--TEST--
Core\Regex::matchAll answers preg_match_all's sets under PREG_SET_ORDER — the same matches, in the same order, each carrying every declared group
--FILE--
<?nvs
// Spec § 5's `matchAll` row against its PHP twin. `matchAll` returns an
// `array<Match>` and PHP returns an array of arrays, so the reading being
// compared is `PREG_SET_ORDER`: one entry per match, each holding that match's
// whole group set. `PREG_PATTERN_ORDER` — PHP's default, one entry per *group*
// holding every match of it — is the shape `rule:core-api/shape-rules` R7 refuses, because it is
// the same member answering a differently-shaped array.
//
// `PREG_UNMATCHED_AS_NULL` is the second half of the reading, for the reason
// `regex-match-groups-is-preg_match-s-matches-under-unmatched-as-null` argues
// once and this case does not restate: under PHP's default a trailing
// unmatched group is dropped from the set entirely, which conflates "did not
// participate" with "is not declared".
//
// Eleven rows chosen for the ways a *sequence* of matches can be got wrong:
// adjacency, a zero-width match that has to advance a position it did not
// consume, alternation order, a set whose groups do not all participate, a row
// matching nothing at all, and an empty subject.
//
// **No row puts a zero-width match directly after a non-empty one** — `a*`
// against `baaac`, say. The two do not agree there and the disagreement is not
// this member's: every one of § 5's iterating members is built on the `regex`
// crate's `captures_iter`, which drops an empty match starting where the
// previous match ended, where PCRE reports it. That is one open divergence
// across `matchAll`, `replace`, `replaceWith` and `split` alike, and it wants a
// fix in `crates/nvs-stdlib/src/regex.rs` rather than a row here freezing it.
array<array<string>> $rows = [
    ["a1b22c333", "\\d+"],
    ["aaaa", "a"],
    ["x1 y2", "(?<w>\\w)(\\d)"],
    ["abc", "z"],
    ["abcabc", "ab|abc"],
    ["abc", "x*"],
    ["one two three", "(\\w+)\\s*"],
    ["ab", "(a)?(b)"],
    ["2026-08-24 2027-01-02", "(?<y>\\d{4})-(?<m>\\d{2})-(?<d>\\d{2})"],
    ["", "a*"],
    ["aXbXc", "(a)|(c)"],
];

// Each line is the number of sets, then every entry of every set in iteration
// order. `NULL` and `EMPTY` are spelled out because `echo` renders both as
// nothing, and the difference between them is half the claim.
int $sets = 0;
int $entries = 0;
int $absent = 0;
int $empty = 0;
foreach ($rows as array<string> $row) {
    var $found = Core\Regex::matchAll($row["0"], $row["1"]);
    echo Core\Arr::count($found) as string, ":";
    foreach ($found as Core\Regex\Match $one) {
        $sets = $sets + 1;
        foreach ($one->groups() as string $key => ?string $value) {
            $entries = $entries + 1;
            echo " ", $key, "=";
            if ($value == null) {
                $absent = $absent + 1;
                echo "NULL";
            } else {
                if ($value == "") {
                    $empty = $empty + 1;
                    echo "EMPTY";
                } else {
                    echo $value;
                }
            }
        }
        echo ";";
    }
    echo "\n";
}

// The totals are what a member answering plausibly row by row still has to
// meet: a reading that dropped one trailing unmatched group, or advanced a
// zero-width match by one match too few, moves one of these three numbers.
echo $sets, " sets, ", $entries, " entries, ", $absent, " absent, ", $empty, " empty\n";
--ORACLE--
<?php
$rows = [
    ['a1b22c333', '\\d+'],
    ['aaaa', 'a'],
    ['x1 y2', '(?<w>\\w)(\\d)'],
    ['abc', 'z'],
    ['abcabc', 'ab|abc'],
    ['abc', 'x*'],
    ['one two three', '(\\w+)\\s*'],
    ['ab', '(a)?(b)'],
    ['2026-08-24 2027-01-02', '(?<y>\\d{4})-(?<m>\\d{2})-(?<d>\\d{2})'],
    ['', 'a*'],
    ['aXbXc', '(a)|(c)'],
];

$sets = 0;
$entries = 0;
$absent = 0;
$empty = 0;
foreach ($rows as $row) {
    $found = [];
    preg_match_all("/" . $row[1] . "/", $row[0], $found, PREG_SET_ORDER | PREG_UNMATCHED_AS_NULL);
    echo count($found), ":";
    foreach ($found as $one) {
        $sets = $sets + 1;
        foreach ($one as $key => $value) {
            $entries = $entries + 1;
            echo " ", $key, "=";
            if ($value === null) {
                $absent = $absent + 1;
                echo "NULL";
            } else {
                if ($value === "") {
                    $empty = $empty + 1;
                    echo "EMPTY";
                } else {
                    echo $value;
                }
            }
        }
        echo ";";
    }
    echo "\n";
}

echo $sets, " sets, ", $entries, " entries, ", $absent, " absent, ", $empty, " empty\n";
