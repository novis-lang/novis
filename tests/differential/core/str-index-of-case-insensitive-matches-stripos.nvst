--TEST--
Core\Str::indexOf's {caseInsensitive} option selects between strpos and stripos on the same call (ADR 0063 R20)
--FILE--
<?nvs
// ADR 0063 R20: one member with an option replaces PHP's `strpos`/`stripos`
// pair rather than carrying a second spelling of one operation. So the claim
// here is not "indexOf can search case-insensitively" — it is that the *same
// call*, with the option off and then on, is each of PHP's two functions in
// turn. Every row is printed twice for that reason, sensitive then insensitive,
// and the oracle names a different PHP function in each column.
final class Show {
    public static function render(?uint $found): string {
        if ($found == null) {
            return "none";
        }
        return $found as string;
    }
}

final class Both {
    public static function of(string $subject, string $needle): string {
        return Show::render(Core\Str::indexOf($subject, $needle))
            . " "
            . Show::render(Core\Str::indexOf($subject, $needle, {caseInsensitive: true}));
    }
}

// ASCII only: folding a non-ASCII subject is UAX #44's question, and the `php`
// on this project's Windows PATH has no mbstring to ask it of (playbook).
echo Both::of("Haystack", "h"), "\n";
echo Both::of("HAYSTACK", "st"), "\n";
echo Both::of("aAaA", "A"), "\n";
echo Both::of("aAaA", "a"), "\n";
echo Both::of("needle", "N"), "\n";
echo Both::of("needle", "zz"), "\n";

// The option composes with `from` rather than replacing it: the scan still
// starts where `from` says it does, and only the comparison changes.
echo Show::render(Core\Str::indexOf("aAaA", "A", {from: 1})), " ",
     Show::render(Core\Str::indexOf("aAaA", "A", {from: 1, caseInsensitive: true})), "\n";
echo Show::render(Core\Str::indexOf("aAaA", "a", {from: 2})), " ",
     Show::render(Core\Str::indexOf("aAaA", "a", {from: 2, caseInsensitive: true})), "\n";
echo Show::render(Core\Str::indexOf("Haystack", "H", {from: -4})), " ",
     Show::render(Core\Str::indexOf("Haystack", "H", {from: -4, caseInsensitive: true})), "\n";
--ORACLE--
<?php
function render(int|false $found): string {
    if ($found === false) {
        return "none";
    }
    return (string) $found;
}

function both(string $subject, string $needle): string {
    return render(strpos($subject, $needle)) . " " . render(stripos($subject, $needle));
}

echo both("Haystack", "h"), "\n";
echo both("HAYSTACK", "st"), "\n";
echo both("aAaA", "A"), "\n";
echo both("aAaA", "a"), "\n";
echo both("needle", "N"), "\n";
echo both("needle", "zz"), "\n";

echo render(strpos("aAaA", "A", 1)), " ", render(stripos("aAaA", "A", 1)), "\n";
echo render(strpos("aAaA", "a", 2)), " ", render(stripos("aAaA", "a", 2)), "\n";
echo render(strpos("Haystack", "H", -4)), " ", render(stripos("Haystack", "H", -4)), "\n";
