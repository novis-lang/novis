--TEST--
Core\Arr::sort over thousands of ints and of non-numeric strings, both orders, answers what PHP's sort and rsort answer
--FILE--
<?nvs
// The same seeded list on both sides, at a size that leaves the key sort's
// small path and reaches its radix route. The strings are non-numeric on
// purpose: PHP compares two numeric strings as numbers, which Novis does not,
// and that divergence is pinned by its own case beside this one.
class Gen {
    public static function ints(int $n, int $seed): array<int> {
        array<int> $out = [];
        int $i = 0;
        while ($i < $n) {
            $seed = ($seed * 1103515245 + 12345) % 2147483648;
            $out[] = $seed % 100000 - 50000;
            $i = $i + 1;
        }
        return $out;
    }
}

class Digest {
    // A position-weighted sum: a single swap anywhere changes it.
    public static function ofInts(array<int> $a): int {
        int $sum = 0;
        int $i = 1;
        foreach ($a as int $v) {
            $sum = ($sum + $i * ($v + 50000)) % 1000000007;
            $i = $i + 1;
        }
        return $sum;
    }
    public static function ofStrings(array<string> $a): string {
        int $sum = 0;
        int $i = 1;
        foreach ($a as string $s) {
            $sum = ($sum + $i * (Core\Str::length($s) as int)) % 1000000007;
            $i = $i + 1;
        }
        return ($sum as string) . ":" . (Core\Arr::first($a) ?? "") . ":" . (Core\Arr::last($a) ?? "");
    }
}

array<int> $sizes = [1000, 5000];
foreach ($sizes as int $n) {
    array<int> $ints = Gen::ints($n, $n);
    array<string> $strings = Core\Arr::map($ints, fn(int $v): string => "k" . (($v % 3001) as string));
    array<int> $asc = Core\Arr::sort($ints);
    array<int> $desc = Core\Arr::sort($ints, {order: Core\Order::Desc});
    echo $n as string, " int ", Digest::ofInts($asc) as string, " ", Digest::ofInts($desc) as string, " ", ($asc[0] ?? 0) as string, " ", ($desc[0] ?? 0) as string, "\n";
    array<string> $sasc = Core\Arr::sort($strings);
    array<string> $sdesc = Core\Arr::sort($strings, {order: Core\Order::Desc});
    echo $n as string, " str ", Digest::ofStrings($sasc), " ", Digest::ofStrings($sdesc), "\n";
}
--ORACLE--
<?php
function gen(int $n, int $seed): array {
    $out = [];
    for ($i = 0; $i < $n; $i++) {
        $seed = ($seed * 1103515245 + 12345) % 2147483648;
        $out[] = $seed % 100000 - 50000;
    }
    return $out;
}
function digestInts(array $a): int {
    $sum = 0;
    $i = 1;
    foreach ($a as $v) {
        $sum = ($sum + $i * ($v + 50000)) % 1000000007;
        $i++;
    }
    return $sum;
}
function digestStrings(array $a): string {
    $sum = 0;
    $i = 1;
    foreach ($a as $s) {
        $sum = ($sum + $i * strlen($s)) % 1000000007;
        $i++;
    }
    return $sum . ":" . ($a[0] ?? "") . ":" . ($a[count($a) - 1] ?? "");
}
foreach ([1000, 5000] as $n) {
    $ints = gen($n, $n);
    $strings = array_map(fn($v) => "k" . ($v % 3001), $ints);
    $asc = $ints;
    sort($asc);
    $desc = $ints;
    rsort($desc);
    echo $n, " int ", digestInts($asc), " ", digestInts($desc), " ", $asc[0] ?? 0, " ", $desc[0] ?? 0, "\n";
    $sasc = $strings;
    sort($sasc);
    $sdesc = $strings;
    rsort($sdesc);
    echo $n, " str ", digestStrings($sasc), " ", digestStrings($sdesc), "\n";
}
