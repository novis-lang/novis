--TEST--
`Core\Digest::Crc32` is CRC-32/ISO-HDLC — what PHP's `crc32()` function and its `crc32b` algorithm both compute — while `Core\Digest::Crc32c` is Castagnoli's, and the two disagree on every non-trivial subject (spec § 11's roster table)
--FILE--
<?nvs
// Spec § 11 gives the checksum half of the roster two cases, and the whole
// risk is that they are one polynomial reached twice: `crc32` and `crc32c`
// differ only in a constant, both answer four octets, and either one alone
// prints a plausible eight hex digits. PHP is the right oracle for exactly
// this, because it carries *three* spellings of CRC-32 — the `crc32()`
// function, the `crc32b` algorithm and the `crc32` algorithm — and only two
// of them agree.
//
// `Core\Digest::Crc32` is the first two. The third, PHP's `hash("crc32")`, is
// the BZIP2 bit ordering and has no case here at all; what this file pins is
// the pair Novis does carry, and that they are genuinely two.
final class Show {
    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

// The empty subject, where every CRC is its own initial value folded once and
// the two polynomials are most likely to coincide; a single octet; a subject
// whose length is a multiple of the four-octet word a table-driven
// implementation steps by; and one that is not.
array<string> $subjects = ["", "a", "abcd", "The quick brown fox jumps over the lazy dog", "123456789"];

// The algorithm spelling, against PHP's `hash("crc32b", …)`.
echo "iso:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Crc32)), "|";
}
echo "\n";

// The same member and the same case, against PHP's `crc32()` *function*
// rendered to eight hex digits. Novis prints one member twice on purpose:
// the claim is that PHP's two spellings are one answer and that it is this
// one, which is a claim about the oracle's rows agreeing with each other as
// much as with Novis.
echo "function:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Crc32)), "|";
}
echo "\n";

echo "castagnoli:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Crc32c)), "|";
}
echo "\n";

// The separation, asserted rather than left to be read off two rows of hex.
// `123456789` is the check vector both CRC-32 catalogues publish, so the row
// where they must differ is one a reader can verify against the catalogue.
echo "differ:";
foreach ($subjects as string $s) {
    echo Show::flag(!Core\Hash::equals(
        Core\Hash::of($s, Core\Digest::Crc32),
        Core\Hash::of($s, Core\Digest::Crc32c)
    )), "|";
}
echo "\n";

// Four octets each, which is the roster's own column and what makes the hex
// above eight digits rather than the digest widths either could be confused
// with.
echo "widths:",
    Core\Bytes::length(Core\Hash::of("123456789", Core\Digest::Crc32)), "|",
    Core\Bytes::length(Core\Hash::of("123456789", Core\Digest::Crc32c)), "|\n";
--ORACLE--
<?php
function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

$subjects = ["", "a", "abcd", "The quick brown fox jumps over the lazy dog", "123456789"];

echo "iso:";
foreach ($subjects as $s) {
    echo hash("crc32b", $s), "|";
}
echo "\n";

// `crc32()` answers an integer, and it is the same four octets big-endian.
echo "function:";
foreach ($subjects as $s) {
    echo sprintf("%08x", crc32($s)), "|";
}
echo "\n";

echo "castagnoli:";
foreach ($subjects as $s) {
    echo hash("crc32c", $s), "|";
}
echo "\n";

echo "differ:";
foreach ($subjects as $s) {
    echo flag(hash("crc32b", $s, true) !== hash("crc32c", $s, true)), "|";
}
echo "\n";

echo "widths:";
echo strlen(hash("crc32b", "123456789", true)), "|";
echo strlen(hash("crc32c", "123456789", true)), "|";
echo "\n";
