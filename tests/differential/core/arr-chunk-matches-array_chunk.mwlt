--TEST--
Core\Arr::chunk cuts the same runs as array_chunk at every size, and its preserveKeys option is array_chunk's fourth-argument rule exactly
--FILE--
<?mwl
// Spec § 2's fixed-step window against its PHP twin. `chunk` shares
// `carry_entry` with `slice`, so it inherits the same key question — but the
// two members' twins answer it differently, and that is the whole reason this
// case exists beside `arr-slice-on-string-keys-diverges-from-array_slice`:
// `array_slice(..., false)` renumbers the integers and keeps the strings,
// while `array_chunk(..., false)` reindexes a run numerically whatever its
// keys were. MWL renumbers unconditionally, so it *agrees* with the second and
// not the first. A string-keyed subject is therefore in this case rather than
// in a divergence one, and it is the row that proves the point.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }

    public static function runs(array<array<int>> $r): string {
        var $out = "";
        foreach ($r as array<int> $run) {
            $out = $out . "[" . Render::of($run) . "]";
        }
        return $out;
    }
}

array<int> $list = [10, 20, 30, 40, 50, 60];
array<int> $map = ["x" => 1, "y" => 2, "z" => 3, "w" => 4, "v" => 5];
array<int> $sizes = [1, 2, 3, 4, 5, 6, 7];

// Every size from the smallest that terminates to one past the subject's own
// count, so the short last run, the exact division and the size that cannot
// fill even one run are all in the sweep.
foreach ($sizes as int $s) {
    echo Render::runs(Core\Arr::chunk($list, $s as uint)), "|", Render::runs(Core\Arr::chunk($list, $s as uint, {preserveKeys: true})), "\n";
}

// The same sweep over a subject with no integer key at all. With the keys kept
// the runs carry the strings; without, both languages number from zero *within
// each run* — which is the one place a renumbering restarts rather than
// running through.
foreach ($sizes as int $mapSize) {
    echo Render::runs(Core\Arr::chunk($map, $mapSize as uint)), "|", Render::runs(Core\Arr::chunk($map, $mapSize as uint, {preserveKeys: true})), "\n";
}

// An empty subject yields no runs at all rather than one empty run, on both
// sides.
array<int> $empty = [];
echo Render::runs(Core\Arr::chunk($empty, 3)), "|", Render::runs(Core\Arr::chunk($empty, 3, {preserveKeys: true})), "|\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

function runs(array $r): string {
    $out = "";
    foreach ($r as $run) {
        $out = $out . "[" . render($run) . "]";
    }
    return $out;
}

$list = [10, 20, 30, 40, 50, 60];
$map = ["x" => 1, "y" => 2, "z" => 3, "w" => 4, "v" => 5];
$sizes = [1, 2, 3, 4, 5, 6, 7];

foreach ($sizes as $s) {
    echo runs(array_chunk($list, $s)), "|", runs(array_chunk($list, $s, true)), "\n";
}

foreach ($sizes as $mapSize) {
    echo runs(array_chunk($map, $mapSize)), "|", runs(array_chunk($map, $mapSize, true)), "\n";
}

$empty = [];
echo runs(array_chunk($empty, 3)), "|", runs(array_chunk($empty, 3, true)), "|\n";
