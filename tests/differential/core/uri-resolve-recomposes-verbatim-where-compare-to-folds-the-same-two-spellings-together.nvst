--TEST--
$uri->resolve recomposes RFC 3986 § 5.3 verbatim — the scheme's case, the host's case and every escape survive it — while $uri->compareTo folds exactly those and answers 0 for the pair, and a hand-written PHP of both sections agrees on each — spec § 12
--FILE--
<?nvs
// The two members that have no PHP twin are the two halves of one question:
// which of them normalizes. § 5.2's transform is defined over components it
// copies, and § 5.3 recomposes them as written — so a resolved reference is
// still spelled the way the base and the reference were, uppercase scheme and
// all. § 6.2.2's normal form is the other half, and `compareTo` is the only
// member that computes one (`uri.rs:2155`). Asking both of every row is what
// makes this an agreement case rather than two lists: a member that grew its
// own normalization would answer plausibly on its own line and fail here.
//
// Column 3 of each row is the same URI written in the folded spelling, so the
// comparison is 0 on every row while column 1 and column 2 read differently.
array<array<string>> $rows = [
    ["HTTP://Example.COM/a/b", "../C%7ed", "http://example.com/C~d"],
    ["http://H/x/", "%7Ey", "http://h/x/~y"],
    ["http://h/a/b", "./%2f", "http://h/a/%2F"],
    ["http://U%73er@h/x/", "y", "http://user@h/x/y"],
    ["https://h:8443/a/", "../B%2Fc", "https://h:8443/B%2fc"],
    ["http://h/a/b", "//OTHER.example/D%7Ee", "http://other.EXAMPLE/D~e"],
];
foreach ($rows as array<string> $row) {
    var $resolved = Core\Uri::parse($row["0"])->resolve($row["1"]);
    echo $resolved->toString(), " ", $resolved->compareTo(Core\Uri::parse($row["2"])), "\n";
}
--ORACLE--
<?php
// § 5.2 and § 5.3, as in
// `uri-resolve-matches-a-hand-written-rfc-3986-reference-transform` — the same
// transform, because the claim here is what it does *not* change.
function split_ref(string $s): array {
    $re = '%^(([^:/?#]+):)?(//([^/?#]*))?([^?#]*)(\?([^#]*))?(#(.*))?%';
    preg_match($re, $s, $m);
    $present = static fn(int $i): bool => isset($m[$i]) && $m[$i] !== '';
    return [
        'scheme' => $present(1) ? $m[2] : null,
        'authority' => $present(3) ? ($m[4] ?? '') : null,
        'path' => $m[5] ?? '',
        'query' => $present(6) ? ($m[7] ?? '') : null,
        'fragment' => $present(8) ? ($m[9] ?? '') : null,
    ];
}

function remove_dot_segments(string $p): string {
    $out = '';
    while ($p !== '') {
        if (str_starts_with($p, '../')) {
            $p = substr($p, 3);
        } elseif (str_starts_with($p, './')) {
            $p = substr($p, 2);
        } elseif (str_starts_with($p, '/./')) {
            $p = '/' . substr($p, 3);
        } elseif ($p === '/.') {
            $p = '/';
        } elseif (str_starts_with($p, '/../')) {
            $p = '/' . substr($p, 4);
            $out = strip_last_segment($out);
        } elseif ($p === '/..') {
            $p = '/';
            $out = strip_last_segment($out);
        } elseif ($p === '.' || $p === '..') {
            $p = '';
        } else {
            $at = strpos($p, '/', $p[0] === '/' ? 1 : 0);
            if ($at === false) {
                $out .= $p;
                $p = '';
            } else {
                $out .= substr($p, 0, $at);
                $p = substr($p, $at);
            }
        }
    }
    return $out;
}

function strip_last_segment(string $out): string {
    $at = strrpos($out, '/');
    return $at === false ? '' : substr($out, 0, $at);
}

function merge(array $base, string $path): string {
    if ($base['authority'] !== null && $base['path'] === '') {
        return '/' . $path;
    }
    $at = strrpos($base['path'], '/');
    return $at === false ? $path : substr($base['path'], 0, $at + 1) . $path;
}

function transform(array $base, string $reference): array {
    $r = split_ref($reference);
    $t = ['scheme' => null, 'authority' => null, 'path' => '', 'query' => null];
    if ($r['scheme'] !== null) {
        $t['scheme'] = $r['scheme'];
        $t['authority'] = $r['authority'];
        $t['path'] = remove_dot_segments($r['path']);
        $t['query'] = $r['query'];
    } elseif ($r['authority'] !== null) {
        $t['authority'] = $r['authority'];
        $t['path'] = remove_dot_segments($r['path']);
        $t['query'] = $r['query'];
        $t['scheme'] = $base['scheme'];
    } else {
        if ($r['path'] === '') {
            $t['path'] = $base['path'];
            $t['query'] = $r['query'] ?? $base['query'];
        } else {
            $t['path'] = str_starts_with($r['path'], '/')
                ? remove_dot_segments($r['path'])
                : remove_dot_segments(merge($base, $r['path']));
            $t['query'] = $r['query'];
        }
        $t['authority'] = $base['authority'];
        $t['scheme'] = $base['scheme'];
    }
    $t['fragment'] = $r['fragment'];
    return $t;
}

function recompose(array $t): string {
    $out = '';
    if ($t['scheme'] !== null) {
        $out .= $t['scheme'] . ':';
    }
    if ($t['authority'] !== null) {
        $out .= '//' . $t['authority'];
    }
    $out .= $t['path'];
    if ($t['query'] !== null) {
        $out .= '?' . $t['query'];
    }
    if ($t['fragment'] !== null) {
        $out .= '#' . $t['fragment'];
    }
    return $out;
}

// § 6.2.2.1 and § 6.2.2.2, over one component: an escape's hex digits fold to
// upper case, an escape spelling an unreserved character becomes that
// character, and the letters themselves fold only in a case-insensitive
// component.
function normalize_pct(string $s, bool $fold): string {
    $out = '';
    $n = strlen($s);
    $i = 0;
    while ($i < $n) {
        if ($s[$i] === '%' && $i + 2 < $n && ctype_xdigit($s[$i + 1]) && ctype_xdigit($s[$i + 2])) {
            $ch = chr(hexdec(substr($s, $i + 1, 2)));
            if (preg_match('/^[A-Za-z0-9\-._~]$/', $ch) === 1) {
                $out .= $fold ? strtolower($ch) : $ch;
            } else {
                $out .= '%' . strtoupper(substr($s, $i + 1, 2));
            }
            $i += 3;
        } else {
            $out .= $fold ? strtolower($s[$i]) : $s[$i];
            $i += 1;
        }
    }
    return $out;
}

// The authority, split the way § 3.2 writes it: userinfo before the last `@`,
// then a port only where what follows the last `:` is decimal.
function split_authority(?string $authority): array {
    if ($authority === null) {
        return [null, null, null];
    }
    $user = null;
    $at = strrpos($authority, '@');
    if ($at !== false) {
        $user = substr($authority, 0, $at);
        $authority = substr($authority, $at + 1);
    }
    $port = null;
    $colon = strrpos($authority, ':');
    if ($colon !== false && ctype_digit(substr($authority, $colon + 1))) {
        $port = (int) substr($authority, $colon + 1);
        $authority = substr($authority, 0, $colon);
    }
    return [$user, $authority, $port];
}

// The seven components in the order the comparison walks them, each in the
// normal form its own case-sensitivity asks for.
function key_of(string $uri): array {
    $p = split_ref($uri);
    [$user, $host, $port] = split_authority($p['authority']);
    return [
        $p['scheme'] !== null ? normalize_pct($p['scheme'], true) : null,
        $user !== null ? normalize_pct($user, false) : null,
        $host !== null ? normalize_pct($host, true) : null,
        $port,
        remove_dot_segments(normalize_pct($p['path'], false)),
        $p['query'] !== null ? normalize_pct($p['query'], false) : null,
        $p['fragment'] !== null ? normalize_pct($p['fragment'], false) : null,
    ];
}

// An absent component sorts before a present one; everything else compares by
// bytes, or numerically for the port.
function cmp_key(array $a, array $b): int {
    for ($i = 0; $i < 7; $i++) {
        $x = $a[$i];
        $y = $b[$i];
        if ($x === null && $y === null) { continue; }
        if ($x === null) { return -1; }
        if ($y === null) { return 1; }
        $r = is_int($x) ? ($x <=> $y) : strcmp($x, $y);
        if ($r !== 0) { return $r < 0 ? -1 : 1; }
    }
    return 0;
}

$rows = [
    ['HTTP://Example.COM/a/b', '../C%7ed', 'http://example.com/C~d'],
    ['http://H/x/', '%7Ey', 'http://h/x/~y'],
    ['http://h/a/b', './%2f', 'http://h/a/%2F'],
    ['http://U%73er@h/x/', 'y', 'http://user@h/x/y'],
    ['https://h:8443/a/', '../B%2Fc', 'https://h:8443/B%2fc'],
    ['http://h/a/b', '//OTHER.example/D%7Ee', 'http://other.EXAMPLE/D~e'],
];
foreach ($rows as $row) {
    $resolved = recompose(transform(split_ref($row[0]), $row[1]));
    echo $resolved, ' ', cmp_key(key_of($resolved), key_of($row[2])), "\n";
}
