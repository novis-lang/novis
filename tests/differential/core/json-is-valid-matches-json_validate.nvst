--TEST--
Core\Json::isValid answers what json_validate answers, over every edge of JSON's grammar and on both sides of the 512-level depth bound
--FILE--
<?nvs
// Spec § 6's `isValid` row names `json_validate` as the twin, and this host's
// `php` is 8.5.9, so it is present. The other leg's version is not known here,
// so the oracle guards on `function_exists` and falls back to
// `json_decode` + `json_last_error()`, which is what `json_validate` was added
// to replace and answers the same question at the same default depth.
//
// `isValid` is `nvs_core_json_is_valid` (`json.rs:989`) and answers by *doing*
// the decode and throwing the value away, so what it accepts is exactly what
// `Core\Json::decode` accepts. That makes this case a grammar test: every row
// is a boundary where a reader could plausibly be one character more or less
// permissive than the other.
//
// One divergence is deliberately not here, because it does not agree: a number
// too large for a `float` — `1e999` — is `INF` to PHP and accepted, and is
// refused here. That is its own case, not a row in this one.

final class Show {
    // A whole table as one digit string, so a row that flipped is visible at
    // the column rather than as a single re-rendered value.
    public static function sweep(array<string> $rows): string {
        string $out = "";
        foreach ($rows as string $row) {
            $out = Core\Str::join([$out, Core\Json::isValid($row) ? "1" : "0"], "");
        }
        return $out;
    }

    // The same table counted, which is what a reader silently accepting one
    // extra row fails on even when its digit string still looks plausible.
    public static function accepted(array<string> $rows): uint {
        uint $n = 0;
        foreach ($rows as string $row) {
            if (Core\Json::isValid($row)) {
                $n = $n + (1 as uint);
            }
        }
        return $n;
    }

    public static function nest(string $open, string $inner, string $close, uint $levels): string {
        return Core\Str::join([Core\Str::repeat($open, $levels), $inner, Core\Str::repeat($close, $levels)], "");
    }

    public static function yn(string $json): string {
        return Core\Json::isValid($json) ? "1" : "0";
    }
}

// A bare scalar is a whole document. RFC 4627 required an array or an object
// at the top; RFC 7159 dropped that, and both readers are at the later rule —
// this is the row where a hand-written validator written from the older RFC
// disagrees on every one of six inputs.
array<string> $scalars = ["1", "-2.5", "\"x\"", "true", "false", "null"];
echo "scalars      ", Show::sweep($scalars), "\n";

// Nothing at all is not a document. The empty string is the one every reader
// has a special case for; whitespace-only is the one that reaches the parser
// and has to run out of input rather than fail on a character.
array<string> $nothing = ["", "   ", "\n\t\r "];
echo "nothing      ", Show::sweep($nothing), "\n";

// Commas and what follows the document. A trailing comma is the single most
// common accidental acceptance — JavaScript takes it, JSON does not — and it
// has an object spelling, a hole spelling and an empty-container spelling.
// Trailing *whitespace* is the one row here that is accepted, which is what
// separates "refuses trailing junk" from "refuses anything after the value".
array<string> $commas = ["[1,]", "{\"a\":1,}", "[,]", "[null,]", "[1,,2]", "{} {}", "[1][2]", "[1] "];
echo "commas       ", Show::sweep($commas), "\n";

// JSON's number grammar, refused half first. No leading zero, no bare decimal
// point on either side, no leading `+`, no sign on its own, no hex, no
// exponent without digits. Then the accepted half: both zeros, a fraction, a
// capitalised exponent with an explicit `+`, an exponent that underflows to
// zero, the largest magnitude a `float` holds, and an integer with more digits
// than any integer type — the last two being where a reader that validates by
// converting starts refusing what the grammar allows. That is not a theory
// here: the one integer *width* both readers can hold is where they part, and
// `9223372036854775808` — which fits `uint` but not `int` — is refused by this
// member and accepted by PHP, so it is a row in that divergence's case rather
// than in this one.
array<string> $numbers = [
    "01", "1.", ".1", "+1", "-", "0x1", "1e",
    "0", "-0", "0.0", "1E+2", "1e-999", "1e308", "12345678901234567890123",
];
echo "numbers      ", Show::sweep($numbers), "\n";

// Spellings from the languages JSON is a subset of. PHP's own `json_encode`
// cannot produce `NaN` or `Infinity` and its reader cannot take them either;
// `Core\Json::encode` refuses to write them for the same reason (`json.rs:294`).
// Single quotes and the three-quarters-typed keywords are the rows a reader
// that dispatches on the first character alone gets wrong.
array<string> $literals = ["NaN", "Infinity", "-Infinity", "undefined", "'x'", "{'a':1}", "tru", "TRUE"];
echo "literals     ", Show::sweep($literals), "\n";

// Strings, refused half first: a lone high surrogate, a pair in the wrong
// order, two highs in a row, C's `\x` escape which JSON does not have, four
// non-hex digits after `\u`, an unterminated string, and a raw tab *inside*
// the string, which JSON requires be escaped. Then accepted: a correctly
// paired surrogate, an escaped NUL, the optional `\/`, and a non-ASCII code
// point. Surrogate handling is where two readers most often differ — one
// replacing what the other refuses — and the answer here is that neither
// repairs anything.
array<string> $strings = [
    "\"\\ud800\"", "\"\\ude00\\ud83d\"", "\"\\ud800\\ud800\"", "\"\\x41\"", "\"\\uZZZZ\"", "\"unterminated", "[\"\t\"]",
    "\"\\ud83d\\ude00\"", "\"\\u0000\"", "\"\\/\"", "\"\\u00e9\"",
];
echo "strings      ", Show::sweep($strings), "\n";

// Containers, all accepted: both empties, a nest, the empty key, a duplicate
// key — which JSON does not forbid and neither reader rejects, however the
// value is then stored — and two shapes of nesting well inside the bound.
array<string> $containers = ["[]", "{}", "[[]]", "{\"\":1}", "{\"a\":1,\"a\":2}", "{\"a\":{\"b\":{\"c\":[]}}}", "[[1],[2]]"];
echo "containers   ", Show::sweep($containers), "\n";

// The whole table counted, so a reader that agreed row by row above but
// accepts one more input than it should still fails here.
echo "accepted     ", Show::accepted($scalars) + Show::accepted($nothing) + Show::accepted($commas) + Show::accepted($numbers) + Show::accepted($literals) + Show::accepted($strings) + Show::accepted($containers), " of ", Core\Arr::count($scalars) + Core\Arr::count($nothing) + Core\Arr::count($commas) + Core\Arr::count($numbers) + Core\Arr::count($literals) + Core\Arr::count($strings) + Core\Arr::count($containers), "\n";

// The depth bound, named on both sides. Spec § 6's default is 512
// (`json.rs:212`) and PHP's is 512 as well, and the two agree about what is
// being counted: 511 nested containers is the last accepted document and 512
// the first refused one, and an empty innermost container lands the bound in
// the same place a scalar one does. The four pairs below are that one bound
// reached by an empty innermost array, a scalar one, an object chain, and an
// alternation of the two, which is what rules out a counter that only tracks
// one container kind.
echo "arrays       ", Show::yn(Show::nest("[", "", "]", 511)), Show::yn(Show::nest("[", "", "]", 512)), "\n";
echo "with scalar  ", Show::yn(Show::nest("[", "1", "]", 511)), Show::yn(Show::nest("[", "1", "]", 512)), "\n";
echo "objects      ", Show::yn(Show::nest("{\"a\":", "1", "}", 511)), Show::yn(Show::nest("{\"a\":", "1", "}", 512)), "\n";
echo "alternating  ", Show::yn(Core\Str::join([Core\Str::repeat("[{\"a\":", 255), "[1]", Core\Str::repeat("}]", 255)], "")), Show::yn(Show::nest("[{\"a\":", "1", "}]", 256)), "\n";
--ORACLE--
<?php
// `json_validate` is PHP 8.3+. Where it is absent, the same question is
// `json_decode` at the same default depth, asked through `json_last_error`.
function nvs_is_valid(string $json): bool {
    if (function_exists('json_validate')) {
        return json_validate($json);
    }
    json_decode($json);
    return json_last_error() === JSON_ERROR_NONE;
}

function sweep(array $rows): string {
    $out = "";
    foreach ($rows as $row) {
        $out = $out . (nvs_is_valid($row) ? "1" : "0");
    }
    return $out;
}

function accepted(array $rows): int {
    $n = 0;
    foreach ($rows as $row) {
        if (nvs_is_valid($row)) {
            $n = $n + 1;
        }
    }
    return $n;
}

function nest(string $open, string $inner, string $close, int $levels): string {
    return str_repeat($open, $levels) . $inner . str_repeat($close, $levels);
}

function yn(string $json): string {
    return nvs_is_valid($json) ? "1" : "0";
}

$scalars = ["1", "-2.5", "\"x\"", "true", "false", "null"];
echo "scalars      ", sweep($scalars), "\n";

$nothing = ["", "   ", "\n\t\r "];
echo "nothing      ", sweep($nothing), "\n";

$commas = ["[1,]", "{\"a\":1,}", "[,]", "[null,]", "[1,,2]", "{} {}", "[1][2]", "[1] "];
echo "commas       ", sweep($commas), "\n";

$numbers = [
    "01", "1.", ".1", "+1", "-", "0x1", "1e",
    "0", "-0", "0.0", "1E+2", "1e-999", "1e308", "12345678901234567890123",
];
echo "numbers      ", sweep($numbers), "\n";

$literals = ["NaN", "Infinity", "-Infinity", "undefined", "'x'", "{'a':1}", "tru", "TRUE"];
echo "literals     ", sweep($literals), "\n";

$strings = [
    "\"\\ud800\"", "\"\\ude00\\ud83d\"", "\"\\ud800\\ud800\"", "\"\\x41\"", "\"\\uZZZZ\"", "\"unterminated", "[\"\t\"]",
    "\"\\ud83d\\ude00\"", "\"\\u0000\"", "\"\\/\"", "\"\\u00e9\"",
];
echo "strings      ", sweep($strings), "\n";

$containers = ["[]", "{}", "[[]]", "{\"\":1}", "{\"a\":1,\"a\":2}", "{\"a\":{\"b\":{\"c\":[]}}}", "[[1],[2]]"];
echo "containers   ", sweep($containers), "\n";

echo "accepted     ", accepted($scalars) + accepted($nothing) + accepted($commas) + accepted($numbers) + accepted($literals) + accepted($strings) + accepted($containers), " of ", count($scalars) + count($nothing) + count($commas) + count($numbers) + count($literals) + count($strings) + count($containers), "\n";

echo "arrays       ", yn(nest("[", "", "]", 511)), yn(nest("[", "", "]", 512)), "\n";
echo "with scalar  ", yn(nest("[", "1", "]", 511)), yn(nest("[", "1", "]", 512)), "\n";
echo "objects      ", yn(nest("{\"a\":", "1", "}", 511)), yn(nest("{\"a\":", "1", "}", 512)), "\n";
echo "alternating  ", yn(str_repeat("[{\"a\":", 255) . "[1]" . str_repeat("}]", 255)), yn(nest("[{\"a\":", "1", "}]", 256)), "\n";
