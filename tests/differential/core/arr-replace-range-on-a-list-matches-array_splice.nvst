--TEST--
Core\Arr::replaceRange substitutes the same window as array_splice at every sign of offset and length, on a list where the two key rules coincide
--FILE--
<?nvs
// Spec § 2's substituting window against the returning half of its PHP twin.
// ADR 0063 R3 makes every member pure, so `array_splice`'s by-reference form
// is not reproduced and the oracle has to copy the subject before splicing it;
// what is being compared is the *array afterwards*, not the removed entries.
//
// The subject is a list because `array_splice` renumbers the integer keys and
// keeps the string ones, where `replaceRange` renumbers everything — ADR 0069
// § 3's rule rather than this member's opinion, and the divergence
// `arr-replace-range-on-string-keys-diverges-from-array_splice` pins. Over a
// list the two rules coincide, so what remains to compare is the window
// itself: which entries went, where the replacement landed, and how the tail
// renumbered behind it.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $subject = [10, 20, 30, 40, 50, 60];
array<int> $rep = [7, 8];
array<int> $offsets = [-9, -6, -4, -1, 0, 1, 4, 6, 9];
array<int> $lengths = [-9, -6, -4, -1, 0, 1, 4, 6, 9];

// A window that closes to nothing is an insertion at that position rather than
// an error, in both languages — which is what the negative and zero lengths in
// this sweep are asking about.
foreach ($offsets as int $o) {
    var $line = "";
    foreach ($lengths as int $n) {
        $line = $line . Render::of(Core\Arr::replaceRange($subject, $o, $n, $rep)) . "|";
    }
    echo $line, "\n";
}

// The same table with the replacement omitted, which makes the member a pure
// removal. PHP has no omitted-replacement form that is not also an omitted
// length, so the oracle passes `[]` explicitly.
foreach ($offsets as int $cutOffset) {
    var $cutLine = "";
    foreach ($lengths as int $cutLength) {
        $cutLine = $cutLine . Render::of(Core\Arr::replaceRange($subject, $cutOffset, $cutLength)) . "|";
    }
    echo $cutLine, "\n";
}

// A `null` length reaches the end on both sides — the row an `array<int>`
// sweep cannot carry — and an offset at the end appends rather than throwing.
echo Render::of(Core\Arr::replaceRange($subject, 2, null, $rep)), "|", Render::of(Core\Arr::replaceRange($subject, -2, null, $rep)), "|", Render::of(Core\Arr::replaceRange($subject, 6, null, $rep)), "|\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

function spliced(array $a, int $offset, ?int $length, array $replacement): string {
    array_splice($a, $offset, $length, $replacement);
    return render($a);
}

$subject = [10, 20, 30, 40, 50, 60];
$rep = [7, 8];
$offsets = [-9, -6, -4, -1, 0, 1, 4, 6, 9];
$lengths = [-9, -6, -4, -1, 0, 1, 4, 6, 9];

foreach ($offsets as $o) {
    $line = "";
    foreach ($lengths as $n) {
        $line = $line . spliced($subject, $o, $n, $rep) . "|";
    }
    echo $line, "\n";
}

foreach ($offsets as $cutOffset) {
    $cutLine = "";
    foreach ($lengths as $cutLength) {
        $cutLine = $cutLine . spliced($subject, $cutOffset, $cutLength, []) . "|";
    }
    echo $cutLine, "\n";
}

echo spliced($subject, 2, null, $rep), "|", spliced($subject, -2, null, $rep), "|", spliced($subject, 6, null, $rep), "|\n";
