--TEST--
`Core\Hash::hmac` answers over RFC 4231's key and message vectors what `hash_hmac` answers for each of spec § 11's ten `StrongDigest` cases, including the key longer than the compression block (spec § 11, RFC 2104, ADR 0009 § 1)
--FILE--
<?nvs
// `Core\Hash::hmac` is a member rather than an option on `of` because its
// third parameter is the closed `StrongDigest` subset. What PHP is the oracle
// for is the *construction*: RFC 2104's two padded passes, the block width
// each algorithm pads to, and the rule that a key wider than that block is
// hashed first. The last of those is where an implementation that treated the
// key as opaque bytes diverges, and it is the fourth vector below.
//
// `Digest::Md5`, `Digest::Sha1` and the two checksums are absent because
// `hmac` refuses them at compile time — that refusal is
// `hash-blake3-is-outside-the-strong-subset`'s claim, not this file's.
final class Row {
    // Every strong case, in spec § 11's roster order, so a case added to the
    // subset without an implementation shows up as a missing cell rather than
    // as nothing at all.
    public static function every(bytes $message, bytes $key): string {
        string $out = "";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha224)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha256)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha384)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha512)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha512_224)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha512_256)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha3_224)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha3_256)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha3_384)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha3_512)) . "|";
        return $out;
    }

    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

// RFC 4231 case 1: a twenty-octet key, well inside every block width here.
bytes $key1 = Core\Encoding::fromHex(Core\Str::repeat("0b", 20));
bytes $message1 = Core\Encoding::encodeText("Hi There", Core\Charset::Utf8);
echo "v1:", Row::every($message1, $key1), "\n";

// Case 2, whose key is short text rather than a round number of octets.
bytes $key2 = Core\Encoding::fromHex("4a656665");
bytes $message2 = Core\Encoding::encodeText("what do ya want for nothing?", Core\Charset::Utf8);
echo "v2:", Row::every($message2, $key2), "\n";

// Case 3: a message of fifty non-text octets, which is what makes `hmac`'s
// message parameter `bytes|string` rather than text.
bytes $key3 = Core\Encoding::fromHex(Core\Str::repeat("aa", 20));
bytes $message3 = Core\Encoding::fromHex(Core\Str::repeat("dd", 50));
echo "v3:", Row::every($message3, $key3), "\n";

// Case 6: a 131-octet key, wider than SHA-256's 64-octet block and wider than
// SHA-3-224's 144-octet rate is not — so the same key is hashed first by some
// of the ten and padded by the rest, in one row.
bytes $key4 = Core\Encoding::fromHex(Core\Str::repeat("aa", 131));
bytes $message4 = Core\Encoding::encodeText("Test Using Larger Than Block-Size Key - Hash Key First", Core\Charset::Utf8);
echo "v4:", Row::every($message4, $key4), "\n";

// The empty key, which RFC 2104 permits and which is where an implementation
// that skipped the padding for a zero-length key would answer the bare digest.
bytes $empty = Core\Encoding::fromHex("");
echo "v5:", Row::every($message1, $empty), "\n";

// Authentication is not hashing: over every vector above, the keyed answer
// differs from the unkeyed digest of the same message. Counted, because a row
// of hex cannot say it.
int $held = 0;
int $cells = 0;
array<bytes> $messages = [$message1, $message2, $message3, $message4];
foreach ($messages as bytes $message) {
    $cells = $cells + 2;
    if (!Core\Hash::equals(
        Core\Hash::hmac($message, $key1, Core\Digest::Sha256),
        Core\Hash::of($message, Core\Digest::Sha256)
    )) {
        $held = $held + 1;
    }
    // And it is a function of the key: two keys, two tags.
    if (!Core\Hash::equals(
        Core\Hash::hmac($message, $key1, Core\Digest::Sha256),
        Core\Hash::hmac($message, $key3, Core\Digest::Sha256)
    )) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";

// The tag is the digest's own width, not the key's.
echo "widths:",
    Core\Bytes::length(Core\Hash::hmac($message1, $key4, Core\Digest::Sha224)), "|",
    Core\Bytes::length(Core\Hash::hmac($message1, $key4, Core\Digest::Sha512)), "|",
    Core\Bytes::length(Core\Hash::hmac($message1, $key4, Core\Digest::Sha3_384)), "|\n";
--ORACLE--
<?php
$algos = [
    "sha224",
    "sha256",
    "sha384",
    "sha512",
    "sha512/224",
    "sha512/256",
    "sha3-224",
    "sha3-256",
    "sha3-384",
    "sha3-512",
];

function every($message, $key) {
    global $algos;
    $out = "";
    foreach ($algos as $algo) {
        $out = $out . hash_hmac($algo, $message, $key) . "|";
    }
    return $out;
}

function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

$key1 = hex2bin(str_repeat("0b", 20));
$message1 = "Hi There";
echo "v1:", every($message1, $key1), "\n";

$key2 = hex2bin("4a656665");
$message2 = "what do ya want for nothing?";
echo "v2:", every($message2, $key2), "\n";

$key3 = hex2bin(str_repeat("aa", 20));
$message3 = hex2bin(str_repeat("dd", 50));
echo "v3:", every($message3, $key3), "\n";

$key4 = hex2bin(str_repeat("aa", 131));
$message4 = "Test Using Larger Than Block-Size Key - Hash Key First";
echo "v4:", every($message4, $key4), "\n";

echo "v5:", every($message1, ""), "\n";

$held = 0;
$cells = 0;
foreach ([$message1, $message2, $message3, $message4] as $message) {
    $cells = $cells + 2;
    if (hash_hmac("sha256", $message, $key1, true) !== hash("sha256", $message, true)) {
        $held = $held + 1;
    }
    if (hash_hmac("sha256", $message, $key1, true) !== hash_hmac("sha256", $message, $key3, true)) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";

echo "widths:";
echo strlen(hash_hmac("sha224", $message1, $key4, true)), "|";
echo strlen(hash_hmac("sha512", $message1, $key4, true)), "|";
echo strlen(hash_hmac("sha3-384", $message1, $key4, true)), "|";
echo "\n";
