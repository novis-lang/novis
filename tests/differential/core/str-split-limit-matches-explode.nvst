--TEST--
Core\Str::split's `{limit}` matches explode's third argument, for a positive and a negative limit alike
--FILE--
<?nvs
echo Core\Str::join(Core\Str::split("a,b,c,d", ","), "|"), "\n";
echo Core\Str::join(Core\Str::split("a,b,c,d", ",", {limit: 2}), "|"), "\n";
echo Core\Str::join(Core\Str::split("a,b,c,d", ",", {limit: 1}), "|"), "\n";
echo Core\Str::join(Core\Str::split("a,b,c,d", ",", {limit: -1}), "|"), "\n";
echo Core\Str::join(Core\Str::split("a,b,c,d", ",", {limit: -3}), "|"), "\n";
--ORACLE--
<?php
echo implode("|", explode(",", "a,b,c,d")), "\n";
echo implode("|", explode(",", "a,b,c,d", 2)), "\n";
echo implode("|", explode(",", "a,b,c,d", 1)), "\n";
echo implode("|", explode(",", "a,b,c,d", -1)), "\n";
echo implode("|", explode(",", "a,b,c,d", -3)), "\n";
