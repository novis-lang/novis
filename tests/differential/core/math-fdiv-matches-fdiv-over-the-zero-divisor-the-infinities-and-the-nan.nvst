--TEST--
Core\Math::fdiv answers what PHP's fdiv answers over every row a division can have no ordinary value for — a zero divisor in both its signs, a zero over a zero, an operand that is infinite, an operand that is NAN, and a quotient that overflows — while the `/` operator refuses the zero divisor in both languages
--FILE--
<?nvs
// Spec § 3's `fdiv` row, and `math.rs:1810`'s doc comment for why the member
// exists at all: ADR 0007 § 4 refuses the zero divisor for `/` before the
// operand types are consulted, so an infinity is otherwise unreachable through
// a division. PHP grew `fdiv` for exactly that reason once `/` began throwing,
// which makes this the one member in the module whose whole surface is the
// rows the operator will not answer — and therefore the one place the two
// languages could disagree without any ordinary quotient noticing.
//
// The IEEE rows are the test. An implementation that reached for a special
// case anywhere — normalizing `-0.0` away, answering `0` rather than `NAN` for
// `0.0 / 0.0`, taking the divisor's sign from its magnitude rather than its
// sign bit — prints plausibly on the first line and fails below it.

final class Show {
    // `NAN` coerced to a string is a warning in PHP 8.4 and later, so neither
    // side renders one: a value that is not equal to itself is the only `NAN`
    // there is, and the sentinel is what both languages print instead. Every
    // other value renders through the ordinary float-to-string conversion,
    // which already agrees across the two languages down to `INF`, `-INF` and
    // the sign of a zero — asserting that agreement is half of what these rows
    // are for, so nothing else here is spelled as a word.
    public static function real(float $value): string {
        if (Core\Math::isNan($value)) {
            return "nan";
        }
        return $value as string;
    }
}

// The ordinary quotients, in all four sign quadrants. This line is the control:
// it is the only one a plain `/` would also answer, and it says the member is
// a division before the rows below say which division.
echo Core\Math::fdiv(7.0, 2.0), " ", Core\Math::fdiv(-7.0, 2.0), " ", Core\Math::fdiv(7.0, -2.0), " ", Core\Math::fdiv(-7.0, -2.0), "\n";

// A zero divisor with a non-zero dividend: an infinity whose sign is the sign
// of the *dividend* against the sign of the *zero*. `-0.0` is a distinct
// divisor from `0.0` here and nowhere else in the module, so a member reading
// its divisor's magnitude answers `INF` to the third of these.
echo Core\Math::fdiv(1.0, 0.0), " ", Core\Math::fdiv(-1.0, 0.0), " ", Core\Math::fdiv(1.0, -0.0), " ", Core\Math::fdiv(-1.0, -0.0), "\n";

// A zero over a zero, in all four sign combinations. This is the one row where
// the answer is neither a number nor an infinity, and it is `NAN` in every
// combination — the sign bits cancel into nothing to carry.
echo Show::real(Core\Math::fdiv(0.0, 0.0)), " ", Show::real(Core\Math::fdiv(-0.0, 0.0)), " ", Show::real(Core\Math::fdiv(0.0, -0.0)), " ", Show::real(Core\Math::fdiv(-0.0, -0.0)), "\n";

// A zero dividend over a non-zero divisor — the quotient is a zero carrying
// the sign of the division, which is the row that says neither language
// normalizes `-0.0` away on the way out any more than it did on the way in.
echo Core\Math::fdiv(0.0, 2.0), " ", Core\Math::fdiv(0.0, -2.0), " ", Core\Math::fdiv(-0.0, 2.0), " ", Core\Math::fdiv(-0.0, -2.0), "\n";

// Either operand a `NAN`, including the two rows where the other operand is
// itself one of the special values above: `NAN` wins over a zero divisor and
// over an infinity alike, so no row here is the `INF` or the `0` the other
// operand would have produced on its own.
float $nan = Core\Math::NAN;
echo Show::real(Core\Math::fdiv($nan, 2.0)), " ", Show::real(Core\Math::fdiv(2.0, $nan)), " ", Show::real(Core\Math::fdiv($nan, 0.0)), " ", Show::real(Core\Math::fdiv($nan, $nan)), "\n";

// An infinite operand, on each side. An infinite dividend is an infinity of
// the combined sign; an infinite divisor is a zero of the combined sign, which
// is the other place a signed zero is *produced* rather than consumed.
float $huge = Core\Math::INFINITY;
float $vast = 0.0 - Core\Math::INFINITY;
echo Core\Math::fdiv($huge, 2.0), " ", Core\Math::fdiv($vast, 2.0), " ", Core\Math::fdiv(2.0, $huge), " ", Core\Math::fdiv(2.0, $vast), "\n";

// Both operands infinite, and an infinity against a zero on both sides. The
// first two are `NAN` — there is no ratio of two infinities — where the last
// two are the infinity and the zero the finite rows above already gave, which
// is what says the `NAN` is the pairing and not the infinity itself.
echo Show::real(Core\Math::fdiv($huge, $huge)), " ", Show::real(Core\Math::fdiv($huge, $vast)), " ", Show::real(Core\Math::fdiv($huge, 0.0)), " ", Show::real(Core\Math::fdiv(0.0, $huge)), "\n";

// A quotient that overflows the range without either operand being special —
// the third way to reach an infinity, and the one an implementation clamping
// to `FLOAT_MAX` would miss. Beside it, the same value divided by itself,
// which is the exactness check the overflow row cannot make.
echo Core\Math::fdiv(Core\Math::FLOAT_MAX, 0.5), " ", Core\Math::fdiv(Core\Math::FLOAT_MAX, Core\Math::FLOAT_MAX), "\n";

// The reason the member exists, asserted rather than described: `/` throws on
// a zero divisor in *both* languages — PHP's `DivisionByZeroError` and Novis's
// refusal under ADR 0007 § 4 — and `fdiv` is what each offers instead. The
// divisor is a local rather than a literal so that the refusal is the one a
// division takes at run time, which is the one PHP can be asked about.
float $zero = 0.0;
try {
    var $quotient = 1.0 / $zero;
    echo "divided ", Show::real($quotient), "\n";
} catch (Throwable $byZero) {
    echo "refused ", Core\Math::fdiv(1.0, $zero), "\n";
}

// Four properties over every ordered pair drawn from one table, asserted by
// *counting* so that a member answering plausibly row by row above still fails
// here. The table carries both zeros, so a third of the pairs are rows `/`
// would refuse, and the counts partition all of them:
//
//  - `fdiv` agrees with `/` on every pair the operator will answer at all,
//    which is what says this is the same division and not a second one;
//  - the answer is `NAN` exactly for a zero over a zero;
//  - the answer is infinite exactly for a non-zero over a zero;
//  - the answer is finite exactly for a non-zero divisor.
//
// The row total is printed beside the four counts, so a sweep that silently
// stopped short cannot agree with itself.
array<float> $table = [-7.5, -1.0, -0.0, 0.0, 1.0, 2.5, 8.0];
int $agreed = 0;
int $undefined = 0;
int $unbounded = 0;
int $bounded = 0;
int $pairs = 0;
foreach ($table as float $a) {
    foreach ($table as float $b) {
        $pairs = $pairs + 1;
        var $q = Core\Math::fdiv($a, $b);
        if ($b != 0.0 && $q == $a / $b) {
            $agreed = $agreed + 1;
        }
        if (Core\Math::isNan($q)) {
            $undefined = $undefined + 1;
        } else {
            if (Core\Math::isFinite($q)) {
                $bounded = $bounded + 1;
            } else {
                $unbounded = $unbounded + 1;
            }
        }
    }
}
echo $agreed, " ", $undefined, " ", $unbounded, " ", $bounded, " ", $pairs, "\n";
--ORACLE--
<?php
function real(float $value): string {
    if (is_nan($value)) {
        return "nan";
    }
    return (string) $value;
}

echo fdiv(7.0, 2.0), " ", fdiv(-7.0, 2.0), " ", fdiv(7.0, -2.0), " ", fdiv(-7.0, -2.0), "\n";

echo fdiv(1.0, 0.0), " ", fdiv(-1.0, 0.0), " ", fdiv(1.0, -0.0), " ", fdiv(-1.0, -0.0), "\n";

echo real(fdiv(0.0, 0.0)), " ", real(fdiv(-0.0, 0.0)), " ", real(fdiv(0.0, -0.0)), " ", real(fdiv(-0.0, -0.0)), "\n";

echo fdiv(0.0, 2.0), " ", fdiv(0.0, -2.0), " ", fdiv(-0.0, 2.0), " ", fdiv(-0.0, -2.0), "\n";

$nan = NAN;
echo real(fdiv($nan, 2.0)), " ", real(fdiv(2.0, $nan)), " ", real(fdiv($nan, 0.0)), " ", real(fdiv($nan, $nan)), "\n";

$huge = INF;
$vast = 0.0 - INF;
echo fdiv($huge, 2.0), " ", fdiv($vast, 2.0), " ", fdiv(2.0, $huge), " ", fdiv(2.0, $vast), "\n";

echo real(fdiv($huge, $huge)), " ", real(fdiv($huge, $vast)), " ", real(fdiv($huge, 0.0)), " ", real(fdiv(0.0, $huge)), "\n";

echo fdiv(PHP_FLOAT_MAX, 0.5), " ", fdiv(PHP_FLOAT_MAX, PHP_FLOAT_MAX), "\n";

$zero = 0.0;
try {
    $quotient = 1.0 / $zero;
    echo "divided ", real($quotient), "\n";
} catch (Throwable $byZero) {
    echo "refused ", fdiv(1.0, $zero), "\n";
}

$table = [-7.5, -1.0, -0.0, 0.0, 1.0, 2.5, 8.0];
$agreed = 0;
$undefined = 0;
$unbounded = 0;
$bounded = 0;
$pairs = 0;
foreach ($table as $a) {
    foreach ($table as $b) {
        $pairs = $pairs + 1;
        $q = fdiv($a, $b);
        if ($b != 0.0 && $q == $a / $b) {
            $agreed = $agreed + 1;
        }
        if (is_nan($q)) {
            $undefined = $undefined + 1;
        } else {
            if (is_finite($q)) {
                $bounded = $bounded + 1;
            } else {
                $unbounded = $unbounded + 1;
            }
        }
    }
}
echo $agreed, " ", $undefined, " ", $unbounded, " ", $bounded, " ", $pairs, "\n";
