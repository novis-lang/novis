--TEST--
Core\Str::split on a separator longer than one character matches explode, absent separator included
--FILE--
<?nvs
echo Core\Str::join(Core\Str::split("a::b::c", "::"), "|"), "\n";
echo Core\Str::join(Core\Str::split("abc", "::"), "|"), "\n";
echo Core\Str::join(Core\Str::split("::a::", "::"), "|"), "\n";
echo Core\Arr::count(Core\Str::split("::a::", "::")), "\n";
--ORACLE--
<?php
echo implode("|", explode("::", "a::b::c")), "\n";
echo implode("|", explode("::", "abc")), "\n";
echo implode("|", explode("::", "::a::")), "\n";
echo count(explode("::", "::a::")), "\n";
