--TEST--
Core\Time::at agrees with mktime()/gmmktime() on every date both of them accept — spec § 4
--FILE--
<?nvs
// `Core\Time::at(int $year, uint $month, uint $day, Zone $zone, {hour?, minute?,
// second?, nanos?})` is `mktime`'s six positional arguments turned round: the
// calendar fields read in the order they are written, the time-of-day fields
// are named rather than counted, and the zone is an argument rather than the
// ambient `date_default_timezone_set` state PHP reads. The oracle below writes
// each row both ways, so the two spellings are the assertion.
var $utc = Core\Time\Zone::UTC;
echo Core\Time::at(2024, 2, 29, $utc, {hour: 13, minute: 45, second: 7})->toInstant()->toEpochSeconds(), "\n";

// The epoch itself, with every time-of-day option omitted — PHP has no such
// spelling, so `gmmktime` writes the three zeroes out.
echo Core\Time::at(1970, 1, 1, $utc)->toInstant()->toEpochSeconds(), "\n";

// Before the epoch, and at the last second `time_t` held as a 32-bit integer:
// the two boundaries a ported program's own tests tend to name.
echo Core\Time::at(1960, 6, 15, $utc, {hour: 23, minute: 59, second: 59})->toInstant()->toEpochSeconds(), "\n";
echo Core\Time::at(2038, 1, 19, $utc, {hour: 3, minute: 14, second: 7})->toInstant()->toEpochSeconds(), "\n";

// `mktime` reads the ambient zone where `at` takes one, so the same civil time
// on either side of Berlin's summer offset is the same pair of instants.
var $berlin = Core\Time\Zone::of("Europe/Berlin");
echo Core\Time::at(2024, 7, 4, $berlin, {hour: 12})->toInstant()->toEpochSeconds(), "\n";
echo Core\Time::at(2024, 1, 4, $berlin, {hour: 12})->toInstant()->toEpochSeconds(), "\n";

// The two civil times a zone does not have exactly once. 02:30 on the morning
// New York springs forward never happens, and both implementations resolve it
// forward to 03:30 EDT rather than throwing; 01:30 on the morning it falls back
// happens twice, and both take the earlier of the two offsets.
var $ny = Core\Time\Zone::of("America/New_York");
echo Core\Time::at(2024, 3, 10, $ny, {hour: 2, minute: 30})->format("yyyy-MM-dd HH:mm XXX"), "\n";
echo Core\Time::at(2024, 11, 3, $ny, {hour: 1, minute: 30})->format("yyyy-MM-dd HH:mm XXX"), "\n";
echo Core\Time::at(2024, 11, 3, $ny, {hour: 1, minute: 30})->toInstant()->toEpochSeconds(), "\n";
--ORACLE--
<?php
date_default_timezone_set("UTC");
echo gmmktime(13, 45, 7, 2, 29, 2024), "\n";
echo gmmktime(0, 0, 0, 1, 1, 1970), "\n";
echo gmmktime(23, 59, 59, 6, 15, 1960), "\n";
echo gmmktime(3, 14, 7, 1, 19, 2038), "\n";

date_default_timezone_set("Europe/Berlin");
echo mktime(12, 0, 0, 7, 4, 2024), "\n";
echo mktime(12, 0, 0, 1, 4, 2024), "\n";

date_default_timezone_set("America/New_York");
echo date("Y-m-d H:i P", mktime(2, 30, 0, 3, 10, 2024)), "\n";
echo date("Y-m-d H:i P", mktime(1, 30, 0, 11, 3, 2024)), "\n";
echo mktime(1, 30, 0, 11, 3, 2024), "\n";
