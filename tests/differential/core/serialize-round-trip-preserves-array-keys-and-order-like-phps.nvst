--TEST--
An array survives a Core\Serialize round-trip with its keys, its gaps and its insertion order intact, exactly as PHP's serialize/unserialize pair leaves them
--FILE--
<?nvs
// ADR 0023 § 2's copy over the array carrier. An array's identity in both
// languages is its key set *and* the order those keys were inserted in, so a
// round-trip that renumbered a gap or sorted anything is caught by the
// rendering rather than by a count.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

// A gapped list, then a string key added after the gap: the next free integer
// key and the string key both have to come back where they were.
array<int> $a = [10, 20, 30, 40];
unset($a[1]);
$a["x"] = 50;
$a[] = 60;
echo Render::of($a), "\n";
echo Render::of(Core\Serialize::decode(Core\Serialize::encode($a)) as array<int>), "\n";

// Insertion order that is neither sorted by key nor by value.
array<int> $order = ["b" => 2, "a" => 1, "c" => 3];
echo Render::of(Core\Serialize::decode(Core\Serialize::encode($order)) as array<int>), "\n";

// Nothing to copy is still a copy.
array<int> $empty = [];
echo "|", Render::of(Core\Serialize::decode(Core\Serialize::encode($empty)) as array<int>), "|\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$a = [10, 20, 30, 40];
unset($a[1]);
$a["x"] = 50;
$a[] = 60;
echo render($a), "\n";
echo render(unserialize(serialize($a))), "\n";

$order = ["b" => 2, "a" => 1, "c" => 3];
echo render(unserialize(serialize($order))), "\n";

$empty = [];
echo "|", render(unserialize(serialize($empty))), "|\n";
