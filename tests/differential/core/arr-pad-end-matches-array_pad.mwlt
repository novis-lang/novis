--TEST--
Core\Arr::padEnd adds the same entries in the same places as array_pad with a positive size, at every size around the subject's own count
--FILE--
<?mwl
// Spec § 2's `array_pad` row, positive half. The conformance suite already pins
// that `padEnd` reaches `$size` entries and stops; this asks whether PHP agrees
// about *where* the added entries land and what the untouched half looks like
// afterwards — which is a different claim, because `array_pad` is one function
// answering both directions and `padEnd` is one of two members.
//
// Keys are rendered and not just values, because padding is exactly where the
// two rules can part: MWL's result is always a list, where `array_pad`
// renumbers the integer keys and keeps the string ones. On a *list* subject the
// two coincide, which is why this case's subject is a list and
// `arr-pad-on-string-keys-diverges-from-array_pad` is the case that says where
// they part.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $subject = [10, 20, 30, 40];
array<int> $sizes = [0, 1, 3, 4, 5, 7, 9];

// Both sides of the subject's own count in one sweep: a size that asks for
// fewer entries than there are (PHP returns the subject unchanged, MWL returns
// its values as a list, and over a list those are the same array), the exact
// count, and every width past it.
foreach ($sizes as int $n) {
    echo Render::of(Core\Arr::padEnd($subject, $n as uint, 7)), "\n";
}

// The empty subject, which is the one row where every entry in the answer is a
// pad and no walk over the subject contributes anything.
array<int> $empty = [];
echo Render::of(Core\Arr::padEnd($empty, 0, 7)), "|", Render::of(Core\Arr::padEnd($empty, 3, 7)), "|\n";

// The padding value is copied, not moved: asking for six entries twice off the
// same subject answers the same array both times, and the subject is unchanged
// between them.
echo Render::of(Core\Arr::padEnd($subject, 6, 7)), "|", Render::of(Core\Arr::padEnd($subject, 6, 7)), "|", Render::of($subject), "\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$subject = [10, 20, 30, 40];
$sizes = [0, 1, 3, 4, 5, 7, 9];

foreach ($sizes as $n) {
    echo render(array_pad($subject, $n, 7)), "\n";
}

$empty = [];
echo render(array_pad($empty, 0, 7)), "|", render(array_pad($empty, 3, 7)), "|\n";

echo render(array_pad($subject, 6, 7)), "|", render(array_pad($subject, 6, 7)), "|", render($subject), "\n";
