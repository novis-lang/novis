--TEST--
Core\Arr::find and findKey answer what array_find and array_find_key answer, once absence is rendered the same on both sides
--FILE--
<?nvs
// Spec § 2's `array_find`/`array_find_key` rows. Both members answer `?T` and
// `?string`, and PHP's two answer `mixed|null` and `int|string|null`, so a case
// that compared the *representation* would be comparing `echo`'s rendering of
// null rather than the search. Rendering absence as `none` on both sides is what
// makes the two comparable at all, and it is the row where a value that is
// itself falsy — the `0` below — separates "found" from "not found".
//
// `findKey` answers a `string` where PHP answers the int key a list was written
// with; `arr-first-key-and-last-key-match-array_key_first-and-array_key_last`
// owns why (ADR 0007 § 5), and `echo` renders both as the same digits, so what
// these rows compare is *which* key.
final class Show {
    public static function value(?int $found): string {
        if ($found == null) {
            return "none";
        }
        // The checker does not carry the `== null` guard into the binding's
        // type (E0403), so the conversion — total in this branch — is what
        // states the narrowing.
        return $found as string;
    }

    public static function key(?string $found): string {
        if ($found == null) {
            return "none";
        }
        return $found as string;
    }
}

array<int> $nums = [3, 8, 5, 12, 7];

// The first match wins even though a later entry matches too, which is the
// whole difference between this member and `filter` plus `first`.
echo Show::value(Core\Arr::find($nums, fn (int $v): bool => $v > 6)), " ", Show::key(Core\Arr::findKey($nums, fn (int $v): bool => $v > 6)), "\n";

// The three positions a single match can sit in, and the one where there is
// none: a member off by one entry prints plausibly against any one of them
// alone.
echo Show::value(Core\Arr::find($nums, fn (int $v): bool => $v == 3)), " ", Show::key(Core\Arr::findKey($nums, fn (int $v): bool => $v == 3)), "\n";
echo Show::value(Core\Arr::find($nums, fn (int $v): bool => $v == 5)), " ", Show::key(Core\Arr::findKey($nums, fn (int $v): bool => $v == 5)), "\n";
echo Show::value(Core\Arr::find($nums, fn (int $v): bool => $v == 7)), " ", Show::key(Core\Arr::findKey($nums, fn (int $v): bool => $v == 7)), "\n";
echo Show::value(Core\Arr::find($nums, fn (int $v): bool => $v > 99)), " ", Show::key(Core\Arr::findKey($nums, fn (int $v): bool => $v > 99)), "\n";

// A predicate no entry can satisfy over an empty subject, and one every entry
// would: both answer absence, and neither language calls the predicate at all.
array<int> $empty = [];
echo Show::value(Core\Arr::find($empty, fn (int $v): bool => $v > 0)), " ", Show::key(Core\Arr::findKey($empty, fn (int $v): bool => $v > 0)), "\n";

// The value found is `0`, which is falsy in both languages — so this is the row
// that says the answer is the value and not a truthiness. A caller reading it
// as "not found" is the bug `?T` exists to remove.
array<int> $withZero = [3, 0, 5];
echo Show::value(Core\Arr::find($withZero, fn (int $v): bool => $v < 1)), " ", Show::key(Core\Arr::findKey($withZero, fn (int $v): bool => $v < 1)), "\n";

// A map, where the key answered is a name rather than a position, and the
// predicate is offered the key as its second argument — the same
// `($value, $key)` shape every other `Core\Arr` callback takes.
array<int> $map = ["a" => 1, "b" => 9, "c" => 4];
echo Show::value(Core\Arr::find($map, fn (int $v): bool => $v > 3)), " ", Show::key(Core\Arr::findKey($map, fn (int $v): bool => $v > 3)), "\n";
echo Show::value(Core\Arr::find($map, fn (int $v, string $k): bool => $k == "c")), " ", Show::key(Core\Arr::findKey($map, fn (int $v, string $k): bool => $k == "c")), "\n";
echo Show::value(Core\Arr::find($map, fn (int $v, string $k): bool => $k == "z")), " ", Show::key(Core\Arr::findKey($map, fn (int $v, string $k): bool => $k == "z")), "\n";

// A gapped list: the key answered is the entry's own, not its position in the
// walk, so nothing here renumbers.
array<int> $gapped = [10, 20, 30, 40];
unset($gapped[0]);
unset($gapped[1]);
echo Show::value(Core\Arr::find($gapped, fn (int $v): bool => $v > 0)), " ", Show::key(Core\Arr::findKey($gapped, fn (int $v): bool => $v > 0)), "\n";
--ORACLE--
<?php
function show(mixed $found): string {
    if ($found === null) {
        return "none";
    }
    return (string) $found;
}

$nums = [3, 8, 5, 12, 7];

echo show(array_find($nums, fn ($v) => $v > 6)), " ", show(array_find_key($nums, fn ($v) => $v > 6)), "\n";

echo show(array_find($nums, fn ($v) => $v === 3)), " ", show(array_find_key($nums, fn ($v) => $v === 3)), "\n";
echo show(array_find($nums, fn ($v) => $v === 5)), " ", show(array_find_key($nums, fn ($v) => $v === 5)), "\n";
echo show(array_find($nums, fn ($v) => $v === 7)), " ", show(array_find_key($nums, fn ($v) => $v === 7)), "\n";
echo show(array_find($nums, fn ($v) => $v > 99)), " ", show(array_find_key($nums, fn ($v) => $v > 99)), "\n";

$empty = [];
echo show(array_find($empty, fn ($v) => $v > 0)), " ", show(array_find_key($empty, fn ($v) => $v > 0)), "\n";

$withZero = [3, 0, 5];
echo show(array_find($withZero, fn ($v) => $v < 1)), " ", show(array_find_key($withZero, fn ($v) => $v < 1)), "\n";

$map = ["a" => 1, "b" => 9, "c" => 4];
echo show(array_find($map, fn ($v) => $v > 3)), " ", show(array_find_key($map, fn ($v) => $v > 3)), "\n";
echo show(array_find($map, fn ($v, $k) => $k === "c")), " ", show(array_find_key($map, fn ($v, $k) => $k === "c")), "\n";
echo show(array_find($map, fn ($v, $k) => $k === "z")), " ", show(array_find_key($map, fn ($v, $k) => $k === "z")), "\n";

$gapped = [10, 20, 30, 40];
unset($gapped[0]);
unset($gapped[1]);
echo show(array_find($gapped, fn ($v) => $v > 0)), " ", show(array_find_key($gapped, fn ($v) => $v > 0)), "\n";
