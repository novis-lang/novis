--TEST--
Core\Math::sin, ::cos and ::tan answer what sin, cos and tan answer at the quadrant boundaries, where the quarter turn is not exactly representable, and past a full turn
--FILE--
<?nvs
// Spec § 3's three circular members. Each is one PHP function with the same
// name, so the question is not the shape of the API but whether the two agree
// where a quadrant boundary lands — and none of the four boundaries is exactly
// representable, because `PI` is not. `cos(PI/2)` is therefore a very small
// number rather than zero and `tan(PI/2)` is a very large one rather than an
// infinity, and both languages have to print the *same* wrong-looking value
// rather than each rounding it its own way. That is the whole content of this
// case: a member that tidied its answer near a boundary would look better and
// disagree here.
array<float> $quadrants = [0.0, Core\Math::PI / 2.0, Core\Math::PI, Core\Math::TAU];

foreach ($quadrants as float $a) {
    echo Core\Math::sin($a), " ", Core\Math::cos($a), " ", Core\Math::tan($a), "\n";
}

// Odd and even symmetry, asserted as the values rather than as the identity, so
// a member that took a magnitude somewhere prints a wrong sign here instead of
// a right one.
echo Core\Math::sin(-1.0), " ", Core\Math::cos(-1.0), " ", Core\Math::tan(-1.0), "\n";
echo Core\Math::sin(1.0), " ", Core\Math::cos(1.0), " ", Core\Math::tan(1.0), "\n";

// Past a full turn, where the argument reduction the implementation performs
// becomes visible: `TAU + 1` is one radian, up to the error in representing
// `TAU`, and the two languages have to make the same error.
echo Core\Math::sin(Core\Math::TAU + 1.0), " ", Core\Math::cos(Core\Math::TAU + 1.0), "\n";

// A large argument, where reduction is most of the computation and a naive
// implementation loses every digit.
echo Core\Math::sin(1000000.0), " ", Core\Math::cos(1000000.0), "\n";

// The signed zero, which `sin` and `tan` carry through and `cos` does not —
// three answers that a member returning a plain zero for all of them would
// print two thirds of correctly.
echo Core\Math::sin(-0.0), " ", Core\Math::cos(-0.0), " ", Core\Math::tan(-0.0), "\n";
--ORACLE--
<?php
$quadrants = [0.0, M_PI / 2.0, M_PI, M_PI * 2.0];

foreach ($quadrants as $a) {
    echo sin($a), " ", cos($a), " ", tan($a), "\n";
}

echo sin(-1.0), " ", cos(-1.0), " ", tan(-1.0), "\n";
echo sin(1.0), " ", cos(1.0), " ", tan(1.0), "\n";

echo sin(M_PI * 2.0 + 1.0), " ", cos(M_PI * 2.0 + 1.0), "\n";

echo sin(1000000.0), " ", cos(1000000.0), "\n";

echo sin(-0.0), " ", cos(-0.0), " ", tan(-0.0), "\n";
