--TEST--
Core\Arr::slice reads the same window as array_slice at every sign of offset and length, with keys compared and not just values
--FILE--
<?nvs
// Spec § 2's window member against its PHP twin. The conformance suite already
// proves `slice`, `replaceRange` and `chunk` agree *with each other* over the
// whole sign table; this asks whether PHP agrees, which is a different claim —
// `window` was written to be `Core\Str`'s sign rule one unit up, not to be
// `array_slice`'s.
//
// Keys are rendered, not just values, because the key-preservation flag is
// where the two are least likely to agree: Novis's `{preserveKeys: false}`
// discards every key and renumbers from "0", where `array_slice`'s `false`
// renumbers the integers and keeps the strings. On a *list* subject those two
// rules answer the same thing, which is why this case's subject is a list and
// `arr-slice-on-string-keys-diverges-from-array_slice` is the case that says
// where they part.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $subject = [10, 20, 30, 40, 50, 60];
array<int> $offsets = [-9, -6, -4, -1, 0, 1, 4, 6, 9];
array<int> $lengths = [-9, -6, -4, -1, 0, 1, 4, 6, 9];

// Both edges and both signs of each argument against a six-entry subject: an
// offset reaching back past the front, one landing past the end, and a length
// that stops short of its own start.
foreach ($offsets as int $o) {
    var $line = "";
    foreach ($lengths as int $n) {
        $line = $line . Render::of(Core\Arr::slice($subject, $o, $n)) . "|";
    }
    echo $line, "\n";
}

// The same table with the keys kept. `array_slice`'s fourth argument is the
// same option, so agreement here is agreement about *which* entries the window
// names as well as how many.
foreach ($offsets as int $keptOffset) {
    var $keptLine = "";
    foreach ($lengths as int $keptLength) {
        $keptLine = $keptLine . Render::of(Core\Arr::slice($subject, $keptOffset, $keptLength, {preserveKeys: true})) . "|";
    }
    echo $keptLine, "\n";
}

// An omitted length is `null` in both languages and means "to the end" in
// both — the one row the sweep above cannot carry, because a `null` does not
// fit an `array<int>`.
echo Render::of(Core\Arr::slice($subject, 2, null)), "|", Render::of(Core\Arr::slice($subject, -2, null)), "|", Render::of(Core\Arr::slice($subject, 9, null)), "|\n";
echo Render::of(Core\Arr::slice($subject, 2, null, {preserveKeys: true})), "|", Render::of(Core\Arr::slice($subject, -2, null, {preserveKeys: true})), "|\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$subject = [10, 20, 30, 40, 50, 60];
$offsets = [-9, -6, -4, -1, 0, 1, 4, 6, 9];
$lengths = [-9, -6, -4, -1, 0, 1, 4, 6, 9];

foreach ($offsets as $o) {
    $line = "";
    foreach ($lengths as $n) {
        $line = $line . render(array_slice($subject, $o, $n)) . "|";
    }
    echo $line, "\n";
}

foreach ($offsets as $keptOffset) {
    $keptLine = "";
    foreach ($lengths as $keptLength) {
        $keptLine = $keptLine . render(array_slice($subject, $keptOffset, $keptLength, true)) . "|";
    }
    echo $keptLine, "\n";
}

echo render(array_slice($subject, 2, null)), "|", render(array_slice($subject, -2, null)), "|", render(array_slice($subject, 9, null)), "|\n";
echo render(array_slice($subject, 2, null, true)), "|", render(array_slice($subject, -2, null, true)), "|\n";
