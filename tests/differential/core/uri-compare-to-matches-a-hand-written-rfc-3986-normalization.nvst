--TEST--
Core\Uri::compareTo agrees with RFC 3986 § 6.2.2 written out by hand over parse_url, which is what a PHP program comparing two URLs has to write for itself
--FILE--
<?nvs
// PHP has no member to be differential against here — `parse_url` decomposes
// and nothing recombines or normalizes — so the oracle is § 6.2.2 written out
// in PHP over `parse_url`'s keys. That makes this a genuine second
// implementation rather than a restatement of the first, which is the whole
// point of the pair.
//
// Every row is an **absolute** http/https URI on purpose: `parse_url` is not
// an RFC 3986 parser and reads a relative reference differently from one, so a
// corpus that included one would be measuring that divergence instead of this
// member. The relative rows live in the conformance case beside this one.
array<array<string>> $rows = [
    ["HTTP://Example.COM/a%7Eb", "http://example.com/a~b"],
    ["http://h/%7e", "http://h/~"],
    ["http://u%73er@h/", "http://user@h/"],
    ["http://h/x/./y/../z", "http://h/x/z"],
    ["http://h:80/", "http://h/"],
    ["http://h/a%2Fb", "http://h/a/b"],
    ["http://h/A", "http://h/a"],
    ["http://h//a", "http://h/a"],
    ["http://a/", "http://b/"],
    ["http://b/", "http://a/"],
    ["https://user:pw@h:8443/a?q=1#f", "https://user:pw@h:8443/a?q=1#f"],
];
foreach ($rows as array<string> $row) {
    var $left = Core\Uri::parse($row["0"]);
    var $right = Core\Uri::parse($row["1"]);
    echo $left->compareTo($right), ";";
}
echo "\n";
--ORACLE--
<?php
// RFC 3986 § 6.2.2.1 and § 6.2.2.2 over one component: escapes fold to upper
// case, an escape spelling an unreserved character becomes that character, and
// the ASCII letters fold only where the component is case-insensitive.
function normalize_pct(string $s, bool $fold): string {
    $out = '';
    $n = strlen($s);
    $i = 0;
    while ($i < $n) {
        if ($s[$i] === '%' && $i + 2 < $n && ctype_xdigit($s[$i + 1]) && ctype_xdigit($s[$i + 2])) {
            $ch = chr(hexdec(substr($s, $i + 1, 2)));
            if (preg_match('/^[A-Za-z0-9\-._~]$/', $ch) === 1) {
                $out .= $fold ? strtolower($ch) : $ch;
            } else {
                $out .= '%' . strtoupper(substr($s, $i + 1, 2));
            }
            $i += 3;
        } else {
            $out .= $fold ? strtolower($s[$i]) : $s[$i];
            $i += 1;
        }
    }
    return $out;
}

// RFC 3986 § 5.2.4, which § 6.2.2.3 asks for — over an absolute path only.
function remove_dots(string $path): string {
    if ($path === '' || $path[0] !== '/') {
        return $path;
    }
    $segments = explode('/', $path);
    array_shift($segments);
    $last = count($segments) - 1;
    $kept = [];
    foreach ($segments as $i => $seg) {
        if ($seg === '.') {
            if ($i === $last) { $kept[] = ''; }
        } elseif ($seg === '..') {
            array_pop($kept);
            if ($i === $last) { $kept[] = ''; }
        } else {
            $kept[] = $seg;
        }
    }
    return '/' . implode('/', $kept);
}

// The seven components, in the order the comparison walks them.
function key_of(string $uri): array {
    $p = parse_url($uri);
    $user = $p['user'] ?? null;
    if ($user !== null && isset($p['pass'])) {
        $user .= ':' . $p['pass'];
    }
    return [
        isset($p['scheme']) ? normalize_pct($p['scheme'], true) : null,
        $user !== null ? normalize_pct($user, false) : null,
        isset($p['host']) ? normalize_pct($p['host'], true) : null,
        $p['port'] ?? null,
        remove_dots(normalize_pct($p['path'] ?? '', false)),
        isset($p['query']) ? normalize_pct($p['query'], false) : null,
        isset($p['fragment']) ? normalize_pct($p['fragment'], false) : null,
    ];
}

// An absent component sorts before a present one; everything else compares by
// bytes, or numerically for the port.
function cmp_key(array $a, array $b): int {
    for ($i = 0; $i < 7; $i++) {
        $x = $a[$i];
        $y = $b[$i];
        if ($x === null && $y === null) { continue; }
        if ($x === null) { return -1; }
        if ($y === null) { return 1; }
        $r = is_int($x) ? ($x <=> $y) : strcmp($x, $y);
        if ($r !== 0) { return $r < 0 ? -1 : 1; }
    }
    return 0;
}

$rows = [
    ["HTTP://Example.COM/a%7Eb", "http://example.com/a~b"],
    ["http://h/%7e", "http://h/~"],
    ["http://u%73er@h/", "http://user@h/"],
    ["http://h/x/./y/../z", "http://h/x/z"],
    ["http://h:80/", "http://h/"],
    ["http://h/a%2Fb", "http://h/a/b"],
    ["http://h/A", "http://h/a"],
    ["http://h//a", "http://h/a"],
    ["http://a/", "http://b/"],
    ["http://b/", "http://a/"],
    ["https://user:pw@h:8443/a?q=1#f", "https://user:pw@h:8443/a?q=1#f"],
];
foreach ($rows as $row) {
    echo cmp_key(key_of($row[0]), key_of($row[1])), ";";
}
echo "\n";
