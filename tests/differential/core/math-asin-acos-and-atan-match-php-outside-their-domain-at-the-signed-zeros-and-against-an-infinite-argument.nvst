--TEST--
Core\Math::asin, Core\Math::acos and Core\Math::atan answer what PHP's three functions of the same names answer at the closed ends of the unit interval, outside it, at a zero of either sign and against an infinite argument — where atan has a finite limit and the other two have no answer at all
--FILE--
<?nvs
// Spec § 3's `asin`, `acos` and `atan` rows, and the three forward members
// they invert. Each is one PHP function with the same name and one argument,
// so the ordinary rows are not the question: the roster case
// every-math-member-with-a-php-twin-agrees asks all six the shallow question
// over a shared in-domain corpus and says so, and
// math-hypot-and-atan2-match-hypot-and-atan2 owns `atan2`, which is the
// two-argument member and a different function.
//
// This case is the boundary the roster leaves out. `asin` and `acos` are
// defined only on the closed unit interval and `atan` on all of it, so the
// three part exactly where an argument leaves that interval — and the answer
// there is a `NAN` rather than the throw this module gives for `sqrt` of a
// negative or `log` of a zero. `atan` is the one whose limit at an infinite
// argument is a finite angle, which is the row that separates "undefined" from
// "unbounded" and the one an implementation clamping its argument gets wrong.

final class Show {
    // `NAN` coerced to a string is a warning in PHP 8.4 and later, so neither
    // side renders one: a value that is not equal to itself is the only `NAN`
    // there is, and the sentinel is what both languages print instead. Every
    // other value renders through the ordinary float-to-string conversion,
    // which already agrees across the two languages down to the sign of a zero
    // — and a zero is an answer on three of the lines below, so folding it
    // would hide the rows this case exists for.
    public static function real(float $value): string {
        if (Core\Math::isNan($value)) {
            return "nan";
        }
        return $value as string;
    }
}

float $nan = Core\Math::NAN;
float $huge = Core\Math::INFINITY;

// A zero of either sign. `asin` and `atan` are odd and each keeps the sign of
// its zero; `acos` answers a right angle either way, which is the row that
// says the three are not one function with a sign fixed up.
echo Core\Math::asin(0.0), " ", Core\Math::asin(-0.0), " ", Core\Math::atan(0.0), " ", Core\Math::atan(-0.0), " ", Core\Math::acos(0.0), " ", Core\Math::acos(-0.0), "\n";

// The closed ends of the unit interval, where `asin` and `acos` are still
// defined and answer a quarter and a half turn. These are the last accepted
// values; the line after them is the first refused ones.
echo Core\Math::asin(1.0), " ", Core\Math::asin(-1.0), " ", Core\Math::acos(1.0), " ", Core\Math::acos(-1.0), "\n";

// Just past each end, and well past it. Both members answer a `NAN` rather
// than throwing or saturating at the angle the boundary gave — a member
// clamping its argument into range would answer the line above twice here.
echo Show::real(Core\Math::asin(1.5)), " ", Show::real(Core\Math::asin(-1.5)), " ", Show::real(Core\Math::acos(1.5)), " ", Show::real(Core\Math::acos(-1.5)), "\n";

// One ordinary argument through all three, in both signs — the control that
// says each is the function it is named for before the edges are read. The
// half is chosen because its three angles are all distinct and none is a
// multiple of another.
echo Core\Math::asin(0.5), " ", Core\Math::asin(-0.5), " ", Core\Math::acos(0.5), " ", Core\Math::acos(-0.5), " ", Core\Math::atan(0.5), " ", Core\Math::atan(-0.5), "\n";

// `atan` has no boundary: it accepts the arguments the other two refuse, and
// its limit at an infinite argument is a right angle of the matching sign
// rather than an infinity or a `NAN`. That is the whole of what makes it the
// inverse with an unbounded domain, and it is the row a shared range check
// over the three members would fail.
echo Core\Math::atan(1.5), " ", Core\Math::atan(-1.5), " ", Core\Math::atan($huge), " ", Core\Math::atan(0.0 - $huge), "\n";

// An infinite argument to the two bounded members, and a `NAN` to all three.
// An infinity is outside the unit interval like any other out-of-range value,
// so it gets that answer and not its own.
echo Show::real(Core\Math::asin($huge)), " ", Show::real(Core\Math::acos($huge)), " ", Show::real(Core\Math::asin($nan)), " ", Show::real(Core\Math::acos($nan)), " ", Show::real(Core\Math::atan($nan)), "\n";

// The forward members against the same arguments, which is where the three
// inverses' domain comes from: `sin` and `cos` never leave the unit interval,
// so nothing outside it has an inverse — and against an infinite argument they
// answer a `NAN`, since no angle is named by an unbounded number of turns.
echo Core\Math::sin(0.0), " ", Core\Math::sin(-0.0), " ", Core\Math::cos(0.0), " ", Core\Math::tan(0.0), " ", Core\Math::tan(-0.0), "\n";
echo Show::real(Core\Math::sin($huge)), " ", Show::real(Core\Math::cos($huge)), " ", Show::real(Core\Math::tan($huge)), " ", Show::real(Core\Math::sin($nan)), " ", Show::real(Core\Math::cos($nan)), "\n";

// Four properties over one table, asserted by *counting* so that a member
// answering plausibly row by row above still fails here. The table spans both
// zeros, both ends of the unit interval, an interior magnitude in both signs
// and one value past each end.
//
//  - the parity of each member: `asin` and `atan` are odd on every row,
//    including the rows where both sides are `NAN` and the equality is false;
//  - the complement, `asin($x) + acos($x) == PI / 2`, which is not a float
//    identity everywhere — what is asserted is that both languages lose it on
//    the *same* rows;
//  - the round trip `sin(asin($x)) == $x`, by the same standard, which ties
//    an inverse to its forward member rather than each to itself;
//  - how many rows are outside the shared domain at all, counted as the rows
//    where `asin` answers a `NAN`, which is the partition the three lines of
//    refusals above assert one entry at a time.
//
// The row total is printed beside the four counts, so a sweep that silently
// stopped short cannot agree with itself.
array<float> $table = [-1.5, -1.0, -0.5, -0.0, 0.0, 0.5, 1.0, 1.5];
int $parity = 0;
int $complement = 0;
int $roundTrip = 0;
int $outside = 0;
int $rows = 0;
foreach ($table as float $x) {
    $rows = $rows + 1;
    var $a = Core\Math::asin($x);
    var $b = Core\Math::acos($x);
    if ($a == 0.0 - Core\Math::asin(0.0 - $x) && Core\Math::atan($x) == 0.0 - Core\Math::atan(0.0 - $x)) {
        $parity = $parity + 1;
    }
    if ($a + $b == Core\Math::PI / 2.0) {
        $complement = $complement + 1;
    }
    if (Core\Math::sin($a) == $x) {
        $roundTrip = $roundTrip + 1;
    }
    if (Core\Math::isNan($a)) {
        $outside = $outside + 1;
    }
}
echo $parity, " ", $complement, " ", $roundTrip, " ", $outside, " ", $rows, "\n";
--ORACLE--
<?php
function real(float $value): string {
    if (is_nan($value)) {
        return "nan";
    }
    return (string) $value;
}

$nan = NAN;
$huge = INF;

echo asin(0.0), " ", asin(-0.0), " ", atan(0.0), " ", atan(-0.0), " ", acos(0.0), " ", acos(-0.0), "\n";

echo asin(1.0), " ", asin(-1.0), " ", acos(1.0), " ", acos(-1.0), "\n";

echo real(asin(1.5)), " ", real(asin(-1.5)), " ", real(acos(1.5)), " ", real(acos(-1.5)), "\n";

echo asin(0.5), " ", asin(-0.5), " ", acos(0.5), " ", acos(-0.5), " ", atan(0.5), " ", atan(-0.5), "\n";

echo atan(1.5), " ", atan(-1.5), " ", atan($huge), " ", atan(0.0 - $huge), "\n";

echo real(asin($huge)), " ", real(acos($huge)), " ", real(asin($nan)), " ", real(acos($nan)), " ", real(atan($nan)), "\n";

echo sin(0.0), " ", sin(-0.0), " ", cos(0.0), " ", tan(0.0), " ", tan(-0.0), "\n";
echo real(sin($huge)), " ", real(cos($huge)), " ", real(tan($huge)), " ", real(sin($nan)), " ", real(cos($nan)), "\n";

$table = [-1.5, -1.0, -0.5, -0.0, 0.0, 0.5, 1.0, 1.5];
$parity = 0;
$complement = 0;
$roundTrip = 0;
$outside = 0;
$rows = 0;
foreach ($table as $x) {
    $rows = $rows + 1;
    $a = asin($x);
    $b = acos($x);
    if ($a == 0.0 - asin(0.0 - $x) && atan($x) == 0.0 - atan(0.0 - $x)) {
        $parity = $parity + 1;
    }
    if ($a + $b == M_PI / 2.0) {
        $complement = $complement + 1;
    }
    if (sin($a) == $x) {
        $roundTrip = $roundTrip + 1;
    }
    if (is_nan($a)) {
        $outside = $outside + 1;
    }
}
echo $parity, " ", $complement, " ", $roundTrip, " ", $outside, " ", $rows, "\n";
