--TEST--
splitting then joining lands on the same text in Novis and PHP
--FILE--
<?nvs
string $csv = "alpha,beta,gamma";
var $parts = Core\Str::split($csv, ",");

echo Core\Arr::count($parts), "\n";
echo Core\Str::join($parts, ","), "\n";
echo Core\Str::join($parts, " / "), "\n";

var $single = Core\Str::split("nosep", ",");
echo Core\Arr::count($single), ":", Core\Str::join($single, "|"), "\n";

var $blanks = Core\Str::split("a,,b", ",");
echo Core\Arr::count($blanks), ":", Core\Str::join($blanks, "|"), "\n";
--ORACLE--
<?php
$csv = "alpha,beta,gamma";
$parts = explode(",", $csv);

echo count($parts), "\n";
echo implode(",", $parts), "\n";
echo implode(" / ", $parts), "\n";

$single = explode(",", "nosep");
echo count($single), ":", implode("|", $single), "\n";

$blanks = explode(",", "a,,b");
echo count($blanks), ":", implode("|", $blanks), "\n";
