--TEST--
Core\Arr::map and ::filter keep the keys PHP's array_map and array_filter keep
--FILE--
<?mwl
class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $scores = ["ann" => 3, "bob" => 8, "cy" => 5];

echo Render::of(Core\Arr::map($scores, fn(int $n) => $n * 10)), "\n";
echo Render::of(Core\Arr::filter($scores, fn(int $n) => $n > 4)), "\n";
echo Render::of($scores), "\n";
echo Core\Arr::count(Core\Arr::filter($scores, fn(int $n) => $n > 100)), "\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$scores = ["ann" => 3, "bob" => 8, "cy" => 5];

echo render(array_map(fn(int $n) => $n * 10, $scores)), "\n";
echo render(array_filter($scores, fn(int $n) => $n > 4)), "\n";
echo render($scores), "\n";
echo count(array_filter($scores, fn(int $n) => $n > 100)), "\n";
