--TEST--
Core\Path::dirname, basename, basename with withoutExtension and extension answer pathinfo's dirname, basename, filename and extension keys over every name whose extension both readers see, spec § 8
--FILE--
<?nvs
// `pathinfo` returns four keys and § 8 spells them as four members, so this
// case asks all four of one subject at a time — the decomposition is only
// right if the parts agree *together*, since a reader that put the dot in the
// wrong place still answers plausibly on any one line.
//
// Every subject here is one both readers see the same way. The two names where
// they do not are `path-extension-declines-the-dotfile-and-the-trailing-dot-pathinfo-reads-as-an-extension`'s,
// and the empty path is `path-of-the-empty-path-answers-the-current-directory-where-phps-dirname-answers-nothing`'s.
// `basename`'s own suffix argument is `path-basename-matches-basename-including-its-suffix-argument`'s
// and `dirname`'s levels are `path-dirname-matches-dirname-including-its-levels-argument`'s.
final class Show {
    public static function of(string $path): string {
        // `Core\Path` emits `SEPARATOR`, which is `\` on Windows and `/` on
        // Linux, and PHP's `dirname` hands back the separator it was given —
        // so the emitted one is folded away, exactly as path.rs's module doc
        // says a case must (`path.rs:10`).
        var $dir = Core\Str::replace(Core\Path::dirname($path), Core\Path::SEPARATOR, "/");
        return "[" . $dir
            . "][" . Core\Path::basename($path)
            . "][" . Core\Path::basename($path, {withoutExtension: true})
            . "][" . (Core\Path::extension($path) ?? "<none>") . "]";
    }
}

// The ordinary shapes: absolute, relative, and a bare name whose parent is the
// current directory.
echo Show::of("/var/log/syslog.txt"), "\n";
echo Show::of("var/log/syslog.txt"), "\n";
echo Show::of("syslog.txt"), "\n";

// The last dot opens the extension, not the first, so a doubled extension is
// one extension to both readers — which is why `tar.gz` is a name people write
// and not a thing either reader knows about.
echo Show::of("archive.tar.gz"), "\n";
echo Show::of("a.b.c.d"), "\n";

// A name with no dot in it has no extension, and PHP says so by leaving the
// key out where this says so with `null` (`rule:core-api/shape-rules` R5).
echo Show::of("/usr/bin/env"), "\n";
echo Show::of("/etc/hosts"), "\n";

// A dot in a *directory* is not the name's, so neither reader finds an
// extension here — the decomposition happens after the last separator.
echo Show::of("/etc/nginx.d/hosts"), "\n";
echo Show::of("a.b/c"), "\n";

// A trailing separator names the same component, and both readers ignore it.
echo Show::of("/var/log/syslog.txt/"), "\n";
echo Show::of("/a/b.c/"), "\n";

// The extension is bytes, not a known set: case is preserved and length is not
// bounded.
echo Show::of("photo.JPG"), "\n";
echo Show::of("dump.sqlite3"), "\n";
echo Show::of("x.reallylongextension"), "\n";
--ORACLE--
<?php
function show(string $path): string {
    $i = pathinfo($path);
    return "[" . $i['dirname']
        . "][" . $i['basename']
        . "][" . $i['filename']
        . "][" . ($i['extension'] ?? "<none>") . "]";
}

echo show("/var/log/syslog.txt"), "\n";
echo show("var/log/syslog.txt"), "\n";
echo show("syslog.txt"), "\n";

echo show("archive.tar.gz"), "\n";
echo show("a.b.c.d"), "\n";

echo show("/usr/bin/env"), "\n";
echo show("/etc/hosts"), "\n";

echo show("/etc/nginx.d/hosts"), "\n";
echo show("a.b/c"), "\n";

echo show("/var/log/syslog.txt/"), "\n";
echo show("/a/b.c/"), "\n";

echo show("photo.JPG"), "\n";
echo show("dump.sqlite3"), "\n";
echo show("x.reallylongextension"), "\n";
