--TEST--
Core\Csv::format writes a document byte for byte as fputcsv's formatting half does — quoting a field exactly where a byte in it would change the parse, doubling an inner quote, ending every record with one LF — and turns the separator and header knobs the same way
--FILE--
<?nvs
// `fputcsv` writes one record to a stream, so its twin for a whole document is
// the loop below on the PHP side; `crates/nvs-stdlib/src/csv.rs`'s known-gaps
// note owns why the streaming half is `Core\IO`'s and not this member's. Both
// sides pass `""` for PHP's `$escape`, which is the dialect Novis has and the
// one PHP 8.5 defaults to, and `"\n"` for its `$eol`, which is the terminator
// Novis writes.
//
// The written document holds CR and LF by construction and the terminal is a
// sink that renders those itself (ADR 0086), so both sides spell them out.
final class Show {
    public static function of(string $document): string {
        return "[" . Core\Str::replaceAll($document, ["\r" => "<CR>", "\n" => "<LF>"]) . "]";
    }
}

// The writer's whole rule is *quote a field where a byte in it would otherwise
// change the parse*: the separator, the quote itself, and either terminator
// byte. A field holding none of them is written as itself, and an inner quote
// is written by doubling it rather than by an escape byte neither dialect has.
array<array<string>> $plain = [["a", "b", "c"]];
array<array<string>> $separator = [["a,b", "c"]];
array<array<string>> $quote = [["a\"b", "c"]];
array<array<string>> $lf = [["one\ntwo", "x"]];
array<array<string>> $crlf = [["one\r\ntwo", "x"]];
echo Show::of(Core\Csv::format($plain)), "\n";
echo Show::of(Core\Csv::format($separator)), "\n";
echo Show::of(Core\Csv::format($quote)), "\n";
echo Show::of(Core\Csv::format($lf)), "\n";
echo Show::of(Core\Csv::format($crlf)), "\n";

// The empty field is written as nothing rather than as an empty pair of quotes,
// on both sides — a field that holds no byte holds no byte that would change
// the parse, so the one rule already answers it.
array<array<string>> $empty = [["a", "", "c"], ["", ""]];
echo Show::of(Core\Csv::format($empty)), "\n";

// A ragged document is written ragged: the writer does not pad a short record
// to the width of the first one, and `csv-keys-a-ragged-record-by-what-it-has`
// is the reader's half of the same question.
array<array<string>> $ragged = [["a"], ["b", "c", "d"], []];
echo Show::of(Core\Csv::format($ragged)), "\n";

// The separator knob decides both what is written between fields and which byte
// now forces a quote — a `,` in a semicolon dialect is an ordinary field byte
// and is written bare.
array<array<string>> $dialect = [["a,b", "c;d"]];
echo Show::of(Core\Csv::format($dialect, {separator: ";"})), "\n";

// `{header: [...]}` writes those names as the first record and is otherwise
// independent of the rows, so its PHP twin is one more `fputcsv` before the
// loop — including the quoting, which is the same rule again.
array<array<string>> $rows = [["fig", "2"], ["pear", "5"]];
echo Show::of(Core\Csv::format($rows, {header: ["name,label", "qty"]})), "\n";
--ORACLE--
<?php
function show(string $document): string {
    return "[" . strtr($document, ["\r" => "<CR>", "\n" => "<LF>"]) . "]";
}

function writeCsv(array $rows, string $separator = ",", ?array $header = null): string {
    $handle = fopen("php://memory", "r+");
    if ($header !== null) {
        fputcsv($handle, $header, $separator, "\"", "", "\n");
    }
    foreach ($rows as $row) {
        fputcsv($handle, $row, $separator, "\"", "", "\n");
    }
    rewind($handle);
    $out = stream_get_contents($handle);
    fclose($handle);
    return $out;
}

$plain = [["a", "b", "c"]];
$separator = [["a,b", "c"]];
$quote = [["a\"b", "c"]];
$lf = [["one\ntwo", "x"]];
$crlf = [["one\r\ntwo", "x"]];
echo show(writeCsv($plain)), "\n";
echo show(writeCsv($separator)), "\n";
echo show(writeCsv($quote)), "\n";
echo show(writeCsv($lf)), "\n";
echo show(writeCsv($crlf)), "\n";

$empty = [["a", "", "c"], ["", ""]];
echo show(writeCsv($empty)), "\n";

$ragged = [["a"], ["b", "c", "d"], []];
echo show(writeCsv($ragged)), "\n";

$dialect = [["a,b", "c;d"]];
echo show(writeCsv($dialect, ";")), "\n";

$rows = [["fig", "2"], ["pear", "5"]];
echo show(writeCsv($rows, ",", ["name,label", "qty"])), "\n";
