--TEST--
Core\Uri::encodeComponent and decodeComponent answer what rawurlencode and rawurldecode answer, and encodeFormValue and decodeFormValue answer what urlencode and urldecode answer — including the one byte the two spellings disagree about
--FILE--
<?nvs
// Spec § 12's first table pairs each of these four with its PHP twin by name.
// There are two spellings and not one because there are two conventions in the
// wild — RFC 3986's, where a space is `%20`, and the form convention, where a
// space is `+` — and the whole reason both are members is that choosing the
// wrong one silently corrupts exactly one byte. The sweep below therefore runs
// the same subjects through both, so that byte is visible rather than assumed.
final class Show {
    public static function of(string $subject): string {
        return "[" . Core\Uri::encodeComponent($subject)
            . "|" . Core\Uri::encodeFormValue($subject) . "]";
    }
}

array<string> $subjects = [
    "plain",
    "a b",
    "a+b",
    "a/b?c=d&e",
    "~tilde-and_dot.",
    "!*'()",
    "%41",
    "",
    "ünïcödé",
    "100%",
];

foreach ($subjects as string $subject) {
    echo Show::of($subject), "\n";
}

// Each decoder is its own encoder's inverse, and the round trip is the identity
// over every subject above — so the two conventions differ in what they write
// and agree on what they mean.
foreach ($subjects as string $subject) {
    echo "[", Core\Uri::decodeComponent(Core\Uri::encodeComponent($subject)),
        "|", Core\Uri::decodeFormValue(Core\Uri::encodeFormValue($subject)), "]\n";
}

// And the decoders read text they did not write, which is where the `+` splits
// them: `decodeFormValue` reads it as a space and `decodeComponent` reads it as
// itself, exactly as `urldecode` and `rawurldecode` do.
array<string> $encoded = [
    "a+b",
    "a%20b",
    "%7Etilde",
    "%2f",
    "caf%C3%A9",
];

foreach ($encoded as string $subject) {
    echo "[", Core\Uri::decodeComponent($subject), "|", Core\Uri::decodeFormValue($subject), "]\n";
}
--ORACLE--
<?php
function show(string $subject): string {
    return "[" . rawurlencode($subject) . "|" . urlencode($subject) . "]";
}

$subjects = [
    "plain",
    "a b",
    "a+b",
    "a/b?c=d&e",
    "~tilde-and_dot.",
    "!*'()",
    "%41",
    "",
    "ünïcödé",
    "100%",
];

foreach ($subjects as $subject) {
    echo show($subject), "\n";
}

foreach ($subjects as $subject) {
    echo "[", rawurldecode(rawurlencode($subject)),
        "|", urldecode(urlencode($subject)), "]\n";
}

$encoded = [
    "a+b",
    "a%20b",
    "%7Etilde",
    "%2f",
    "caf%C3%A9",
];

foreach ($encoded as $subject) {
    echo "[", rawurldecode($subject), "|", urldecode($subject), "]\n";
}
