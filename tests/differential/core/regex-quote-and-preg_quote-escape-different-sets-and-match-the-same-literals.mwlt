--TEST--
Core\Regex::quote and preg_quote escape different character sets, so what agrees is the behaviour: a quoted literal matches itself, matches itself inside a larger subject, and matches nothing else
--FILE--
<?mwl
// Spec § 5's `quote` row, and ADR 0056 §§ 4-5. The member takes no
// `$delimiter` argument because § 5 removed the `/…/` syntax the PHP one
// existed for — a pattern here is a pattern, not a pattern wrapped in
// punctuation — so there is nothing to pass through and nothing to compare
// on that axis.
//
// The two *escape sets* differ outright, which is why nothing below compares
// the quoted strings row by row. Over printable ASCII this member escapes 18
// characters, `#$&()*+-.?[\]^{|}~`, and `preg_quote($c, "/")` escapes 22,
// `!#$()*+-./:<=>?[\]^{|}`: `&` and `~` are meta to the Rust engine's
// character-class set operators and are not meta to PCRE, `!:<=>` are escaped
// by PCRE's launderer out of caution and are not meta to either engine, and
// `/` is escaped only because a delimiter was handed in. A comparison of the
// outputs is therefore a divergence in 8 of 95 cells and says nothing about
// whether either one is correct.
//
// What both launderers *claim* is one thing, and it is the same thing: the
// result matches the literal it was made from and nothing else. That is what
// is counted here.

// The whole printable ASCII table against itself. Every character is used
// once as the literal and once as the subject, so the 95 agreements are a
// diagonal: a member that escaped too little lands a metacharacter in the
// `other` column, and one that escaped a character the engine gives no
// meaning to at all — turning `\q` into an unknown escape, or `\8` into a
// back-reference — loses its own cell from `self`.
array<int> $codes = Core\Arr::range(32, 126);
int $self = 0;
int $other = 0;
int $cells = 0;
foreach ($codes as int $needle) {
    string $quoted = Core\Regex::quote(Core\Str::fromCodePoint($needle as uint));
    foreach ($codes as int $subject) {
        $cells = $cells + 1;
        if (Core\Regex::matches(Core\Str::fromCodePoint($subject as uint), $quoted)) {
            if ($needle == $subject) {
                $self = $self + 1;
            } else {
                $other = $other + 1;
            }
        }
    }
}
echo $self, " of ", $cells, " matched itself, ", $other, " matched something else\n";

// The one row-level agreement the two sets do have, stated as the subset it
// holds on rather than as a count of everything left alone: neither launderer
// touches a word character, so on all 63 of them quoting is the identity.
// That is the floor a laundering member is worth having — a `quote` that
// escaped every byte would pass the diagonal above and fail here.
int $word = 0;
foreach ($codes as int $code) {
    string $one = Core\Str::fromCodePoint($code as uint);
    if (Core\Regex::matches($one, "^[A-Za-z0-9_]$")) {
        if (Core\Regex::quote($one) == $one) {
            $word = $word + 1;
        }
    }
}
echo $word, " word characters quote to themselves\n";

// Twenty literals that each read as a pattern if they are not laundered —
// a wildcard, an alternation, a class, both anchors, a quantifier, a group,
// a comment character, the two the engines disagree about, an escape and a
// quoted string — against a subject table that is those twenty followed by
// the nineteen strings the *unlaundered* reading would have reached: `axb`
// for `a.b`, `q` for `[a-z]`, `end` for `^end$`, `backslash` for the escape.
// Counting over the whole 20 × 39 grid rather than asserting twenty `true`s
// is what makes "and nothing else" a claim: a launderer that left one
// metacharacter live still answers every diagonal cell correctly.
array<string> $literals = ["a.b", "1+1=2", "(x)", "[a-z]", "a|b", "^end$", "x*?", "{2,3}", "#tag", "a~b", "<tag>", "50%", "-dash-", "mail@host", "a/b", "back\\slash", "he said \"hi\"", "  two  spaces  ", "q?", "e+1"];
array<string> $subjects = ["a.b", "1+1=2", "(x)", "[a-z]", "a|b", "^end$", "x*?", "{2,3}", "#tag", "a~b", "<tag>", "50%", "-dash-", "mail@host", "a/b", "back\\slash", "he said \"hi\"", "  two  spaces  ", "q?", "e+1", "axb", "11=2", "x", "q", "b", "end", "", "23", "tag", "ab", "50", "dash", "mailXhost", "aXb", "backslash", "he said hi", "two spaces", "qq", "ee1"];
int $found = 0;
int $stray = 0;
int $grid = 0;
foreach ($literals as string $lit) {
    string $q = Core\Regex::quote($lit);
    foreach ($subjects as string $against) {
        $grid = $grid + 1;
        if (Core\Regex::matches($against, $q)) {
            if ($against == $lit) {
                $found = $found + 1;
            } else {
                $stray = $stray + 1;
            }
        }
    }
}
echo $found, " of ", $grid, " matched itself, ", $stray, " matched something else\n";

// And the half that says the result is still a *search* and not an anchored
// equality: every quoted literal is found inside a larger subject. A `quote`
// that wrapped its answer in `^…$` to be safe would pass both grids above and
// fail all twenty of these, which is the failure mode the diagonal cannot see.
int $inside = 0;
foreach ($literals as string $one) {
    if (Core\Regex::matches("AA" . $one . "ZZ", Core\Regex::quote($one))) {
        $inside = $inside + 1;
    }
}
echo $inside, " of ", Core\Arr::count($literals), " were found inside a larger subject\n";
--ORACLE--
<?php
$codes = range(32, 126);
$self = 0;
$other = 0;
$cells = 0;
foreach ($codes as $needle) {
    $quoted = preg_quote(chr($needle), "/");
    foreach ($codes as $subject) {
        $cells = $cells + 1;
        if (preg_match("/" . $quoted . "/", chr($subject)) === 1) {
            if ($needle === $subject) {
                $self = $self + 1;
            } else {
                $other = $other + 1;
            }
        }
    }
}
echo $self, " of ", $cells, " matched itself, ", $other, " matched something else\n";

$word = 0;
foreach ($codes as $code) {
    $one = chr($code);
    if (preg_match('/^[A-Za-z0-9_]$/', $one) === 1) {
        if (preg_quote($one, "/") === $one) {
            $word = $word + 1;
        }
    }
}
echo $word, " word characters quote to themselves\n";

$literals = ["a.b", "1+1=2", "(x)", "[a-z]", "a|b", "^end$", "x*?", "{2,3}", "#tag", "a~b", "<tag>", "50%", "-dash-", "mail@host", "a/b", "back\\slash", "he said \"hi\"", "  two  spaces  ", "q?", "e+1"];
$subjects = ["a.b", "1+1=2", "(x)", "[a-z]", "a|b", "^end$", "x*?", "{2,3}", "#tag", "a~b", "<tag>", "50%", "-dash-", "mail@host", "a/b", "back\\slash", "he said \"hi\"", "  two  spaces  ", "q?", "e+1", "axb", "11=2", "x", "q", "b", "end", "", "23", "tag", "ab", "50", "dash", "mailXhost", "aXb", "backslash", "he said hi", "two spaces", "qq", "ee1"];
$found = 0;
$stray = 0;
$grid = 0;
foreach ($literals as $lit) {
    $q = preg_quote($lit, "/");
    foreach ($subjects as $against) {
        $grid = $grid + 1;
        if (preg_match("/" . $q . "/", $against) === 1) {
            if ($against === $lit) {
                $found = $found + 1;
            } else {
                $stray = $stray + 1;
            }
        }
    }
}
echo $found, " of ", $grid, " matched itself, ", $stray, " matched something else\n";

$inside = 0;
foreach ($literals as $one) {
    if (preg_match("/" . preg_quote($one, "/") . "/", "AA" . $one . "ZZ") === 1) {
        $inside = $inside + 1;
    }
}
echo $inside, " of ", count($literals), " were found inside a larger subject\n";
