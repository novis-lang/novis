--TEST--
`Core\Bytes::join`, `::fill` and `::repeat` build the buffers `implode`, `str_repeat(chr(…), n)` and `str_repeat` build, including at a count of zero and over an octet no text spelling can carry (spec § 7, `rule:core-api/shape-rules` R6)
--FILE--
<?nvs
// § 7 keeps `join` rather than giving `Core\Bytes` a `concat` of its own,
// "which keeps R6's pairing with `Core\Str`" — so the members that *build* a
// buffer are the three below, and there is no operator and no literal to
// build one any other way. That makes them the constructors every other case
// in this file's neighbourhood leans on, and PHP's three twins are exactly
// what they have to agree with.
final class Show {
    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

bytes $none = Core\Encoding::fromHex("");
bytes $comma = Core\Encoding::fromHex("2c");
bytes $nul = Core\Encoding::fromHex("00");

// The empty list, one part, parts of unequal width, and a list holding the
// empty buffer between two non-empty ones — where the separator doubles up
// and a `join` that skipped empty parts would print one separator too few.
array<array<bytes>> $lists = [
    [],
    [Core\Encoding::fromHex("01")],
    [Core\Encoding::fromHex("01"), Core\Encoding::fromHex("0203"), Core\Encoding::fromHex("ff")],
    [Core\Encoding::fromHex("01"), Core\Encoding::fromHex(""), Core\Encoding::fromHex("ff")],
];

echo "joinEmpty:";
foreach ($lists as array<bytes> $parts) {
    echo "[", Core\Encoding::toHex(Core\Bytes::join($parts, $none)), "]";
}
echo "\n";

echo "joinComma:";
foreach ($lists as array<bytes> $parts) {
    echo "[", Core\Encoding::toHex(Core\Bytes::join($parts, $comma)), "]";
}
echo "\n";

// A separator that is itself the octet a C string would end at, which is the
// case a text-shaped implementation gets wrong.
echo "joinNul:";
foreach ($lists as array<bytes> $parts) {
    echo "[", Core\Encoding::toHex(Core\Bytes::join($parts, $nul)), "]";
}
echo "\n";

// `fill` takes the count first and the octet second — the count is the
// subject, the way `repeat`'s buffer is. Zero, one, and a width past a single
// machine word; the octets are the two ends of the range and one in the middle.
array<uint> $counts = [0, 1, 5, 9];
array<uint> $octets = [0, 65, 128, 255];

echo "fill:";
foreach ($counts as uint $count) {
    foreach ($octets as uint $octet) {
        echo "[", Core\Encoding::toHex(Core\Bytes::fill($count, $octet)), "]";
    }
}
echo "\n";

echo "repeat:";
foreach ($counts as uint $count) {
    echo "[", Core\Encoding::toHex(Core\Bytes::repeat(Core\Encoding::fromHex("00ff"), $count)), "]";
    echo "[", Core\Encoding::toHex(Core\Bytes::repeat($none, $count)), "]";
}
echo "\n";

// The three widths, asserted rather than counted off the hex: `fill` answers
// the count it was given, `repeat` answers the product, and `join` answers
// the parts plus one separator per gap.
int $held = 0;
int $cells = 0;
foreach ($counts as uint $count) {
    $cells = $cells + 2;
    if (Core\Bytes::length(Core\Bytes::fill($count, 65)) as int == $count as int) {
        $held = $held + 1;
    }
    if (Core\Bytes::length(Core\Bytes::repeat(Core\Encoding::fromHex("00ff"), $count)) as int == $count as int * 2) {
        $held = $held + 1;
    }
}
foreach ($lists as array<bytes> $parts) {
    $cells = $cells + 1;
    int $total = 0;
    foreach ($parts as bytes $part) {
        $total = $total + Core\Bytes::length($part) as int;
    }
    if (Core\Arr::count($parts) as int > 0) {
        $total = $total + Core\Arr::count($parts) as int - 1;
    }
    if (Core\Bytes::length(Core\Bytes::join($parts, $comma)) as int == $total) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";

// `fill` and `repeat` meet at a one-octet buffer, which is the identity that
// says the two members count in the same unit.
echo Show::flag(Core\Bytes::compare(
    Core\Bytes::fill(4, 255),
    Core\Bytes::repeat(Core\Encoding::fromHex("ff"), 4)
) == 0), "\n";
--ORACLE--
<?php
function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

$none = "";
$comma = hex2bin("2c");
$nul = hex2bin("00");

$lists = [
    [],
    [hex2bin("01")],
    [hex2bin("01"), hex2bin("0203"), hex2bin("ff")],
    [hex2bin("01"), "", hex2bin("ff")],
];

echo "joinEmpty:";
foreach ($lists as $parts) {
    echo "[", bin2hex(implode($none, $parts)), "]";
}
echo "\n";

echo "joinComma:";
foreach ($lists as $parts) {
    echo "[", bin2hex(implode($comma, $parts)), "]";
}
echo "\n";

echo "joinNul:";
foreach ($lists as $parts) {
    echo "[", bin2hex(implode($nul, $parts)), "]";
}
echo "\n";

$counts = [0, 1, 5, 9];
$octets = [0, 65, 128, 255];

echo "fill:";
foreach ($counts as $count) {
    foreach ($octets as $octet) {
        echo "[", bin2hex(str_repeat(chr($octet), $count)), "]";
    }
}
echo "\n";

echo "repeat:";
foreach ($counts as $count) {
    echo "[", bin2hex(str_repeat(hex2bin("00ff"), $count)), "]";
    echo "[", bin2hex(str_repeat($none, $count)), "]";
}
echo "\n";

$held = 0;
$cells = 0;
foreach ($counts as $count) {
    $cells = $cells + 2;
    if (strlen(str_repeat(chr(65), $count)) === $count) {
        $held = $held + 1;
    }
    if (strlen(str_repeat(hex2bin("00ff"), $count)) === $count * 2) {
        $held = $held + 1;
    }
}
foreach ($lists as $parts) {
    $cells = $cells + 1;
    $total = 0;
    foreach ($parts as $part) {
        $total = $total + strlen($part);
    }
    if (count($parts) > 0) {
        $total = $total + count($parts) - 1;
    }
    if (strlen(implode($comma, $parts)) === $total) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";

echo flag(str_repeat(chr(255), 4) === str_repeat(hex2bin("ff"), 4)), "\n";
