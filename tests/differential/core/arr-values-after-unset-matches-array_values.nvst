--TEST--
Core\Arr::values renumbers a gapped array exactly as array_values does
--FILE--
<?nvs
class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $a = [10, 20, 30, 40];
unset($a[1]);
unset($a[3]);
echo Render::of($a), "\n";
echo Render::of(Core\Arr::values($a)), "\n";

array<int> $map = ["x" => 1, "y" => 2];
echo Render::of(Core\Arr::values($map)), "\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$a = [10, 20, 30, 40];
unset($a[1]);
unset($a[3]);
echo render($a), "\n";
echo render(array_values($a)), "\n";

$map = ["x" => 1, "y" => 2];
echo render(array_values($map)), "\n";
