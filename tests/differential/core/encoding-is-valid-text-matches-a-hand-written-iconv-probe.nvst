--TEST--
Core\Encoding::isValidText agrees with the iconv() same-charset probe PHP reaches for where mbstring is absent — spec § 7
--FILE--
<?nvs
// `Core\Encoding::isValidText(bytes $b, Charset $charset): bool` replaces
// `mb_check_encoding`, which is **not** what the oracle below calls: mbstring
// is an optional extension and this build of PHP does not carry it
// (`docs/agent/playbook.md`, *Writing a test case*), so the twin here is the
// substitute a program without mbstring already writes — converting a subject
// to its own charset and asking whether `iconv` answered `false`. That idiom
// is exactly this member's question, and writing it out is also what shows
// what the member is worth: PHP spells "is this readable" as a conversion
// performed and thrown away, with the answer carried on a `false` a caller has
// to remember to test for and a `Notice` raised behind it.
//
// The octets go in as hex on both sides — `Core\Encoding::fromHex` and
// `hex2bin` — because a `.nvst` file is UTF-8 and the subject of this member
// is not. `false` renders as nothing at all in either language, so `yn` is
// what makes each answer a visible character rather than an empty row.
final class Show {
    public static function yn(bool $b): string {
        if ($b) {
            return "y";
        }
        return "n";
    }
}

// UTF-8, refused and accepted: a stray `0xff` is the shape a truncated or a
// double-converted string arrives in, and it is the commonest thing this
// member is asked about.
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("61ff62"), Core\Charset::Utf8)), "\n";
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("616263"), Core\Charset::Utf8)), "\n";

// ASCII, which is `mb_check_encoding`'s own commonest call, and the reason
// `Charset::Ascii` is a case of its own here rather than the WHATWG index's
// fold into windows-1252 — folded, this question would answer `y` for every
// byte string there is.
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("6180"), Core\Charset::Ascii)), "\n";
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("6f6b"), Core\Charset::Ascii)), "\n";

// A multi-byte table truncated mid-character, beside the whole character it is
// the first half of.
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("82a082"), Core\Charset::ShiftJis)), "\n";
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("82a08341"), Core\Charset::ShiftJis)), "\n";
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("a4a2a5"), Core\Charset::EucJp)), "\n";
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("a4a2a5a2"), Core\Charset::EucJp)), "\n";

// Both UTF-16 refusals — a length that is not a whole number of code units,
// and an unpaired high surrogate, which is a well-formed unit that is not a
// character — beside the sequence that is neither.
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("610063"), Core\Charset::Utf16Le)), "\n";
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("61003dd8"), Core\Charset::Utf16Le)), "\n";
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("6100e900"), Core\Charset::Utf16Le)), "\n";

// `Charset::Latin1` answers `y` for every input, including the two C1 controls
// that are the whole reason it is not read as windows-1252 — that is a
// property of ISO-8859-1, which gives all 256 octets a meaning, and not a hole
// in this member. PHP agrees, which is what makes it worth asserting rather
// than commenting.
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("8081"), Core\Charset::Latin1)), "\n";
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("68e96c6c6f"), Core\Charset::Latin1)), "\n";

// Two single-byte tables, whose octets are all assigned over the ranges these
// subjects use.
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("eff0e8"), Core\Charset::Windows1251)), "\n";
echo Show::yn(Core\Encoding::isValidText(Core\Encoding::fromHex("be6c75bb"), Core\Charset::Iso88592)), "\n";

// Counted rather than read off the lines above: `isValidText` is
// `decodeText`'s question with the throw taken off, so the two must agree on
// every subject — a member that grew its own validator fails this count while
// still looking right on each of its own lines. Written out one subject at a
// time because a `Core\Charset` case cannot yet be held in a binding of its
// own type.
uint $agreed = 0;
try { Core\Encoding::decodeText(Core\Encoding::fromHex("61ff62"), Core\Charset::Utf8); }
catch (Throwable $a) { if (!Core\Encoding::isValidText(Core\Encoding::fromHex("61ff62"), Core\Charset::Utf8)) { $agreed = $agreed + 1; } }
try { Core\Encoding::decodeText(Core\Encoding::fromHex("6180"), Core\Charset::Ascii); }
catch (Throwable $b) { if (!Core\Encoding::isValidText(Core\Encoding::fromHex("6180"), Core\Charset::Ascii)) { $agreed = $agreed + 1; } }
try { Core\Encoding::decodeText(Core\Encoding::fromHex("82a082"), Core\Charset::ShiftJis); }
catch (Throwable $c) { if (!Core\Encoding::isValidText(Core\Encoding::fromHex("82a082"), Core\Charset::ShiftJis)) { $agreed = $agreed + 1; } }
try { Core\Encoding::decodeText(Core\Encoding::fromHex("610063"), Core\Charset::Utf16Le); }
catch (Throwable $d) { if (!Core\Encoding::isValidText(Core\Encoding::fromHex("610063"), Core\Charset::Utf16Le)) { $agreed = $agreed + 1; } }
if (Core\Encoding::decodeText(Core\Encoding::fromHex("616263"), Core\Charset::Utf8) == "abc"
    && Core\Encoding::isValidText(Core\Encoding::fromHex("616263"), Core\Charset::Utf8)) { $agreed = $agreed + 1; }
if (Core\Encoding::decodeText(Core\Encoding::fromHex("8081"), Core\Charset::Latin1) != ""
    && Core\Encoding::isValidText(Core\Encoding::fromHex("8081"), Core\Charset::Latin1)) { $agreed = $agreed + 1; }
echo "agreed=", $agreed, "/6\n";
--ORACLE--
<?php
function yn(bool $b): string {
    if ($b) {
        return "y";
    }
    return "n";
}

// `mb_check_encoding` is not available in this build, so validity is asked the
// way a program without mbstring asks it: convert the subject to its own
// charset and see whether `iconv` answered `false`. The `@` is the `Notice`
// that idiom raises on every refused subject.
function valid(string $charset, string $hex): bool {
    return @iconv($charset, $charset, hex2bin($hex)) !== false;
}

echo yn(valid("UTF-8", "61ff62")), "\n";
echo yn(valid("UTF-8", "616263")), "\n";

echo yn(valid("ASCII", "6180")), "\n";
echo yn(valid("ASCII", "6f6b")), "\n";

echo yn(valid("SHIFT_JIS", "82a082")), "\n";
echo yn(valid("SHIFT_JIS", "82a08341")), "\n";
echo yn(valid("EUC-JP", "a4a2a5")), "\n";
echo yn(valid("EUC-JP", "a4a2a5a2")), "\n";

echo yn(valid("UTF-16LE", "610063")), "\n";
echo yn(valid("UTF-16LE", "61003dd8")), "\n";
echo yn(valid("UTF-16LE", "6100e900")), "\n";

echo yn(valid("ISO-8859-1", "8081")), "\n";
echo yn(valid("ISO-8859-1", "68e96c6c6f")), "\n";

echo yn(valid("WINDOWS-1251", "eff0e8")), "\n";
echo yn(valid("ISO-8859-2", "be6c75bb")), "\n";

echo "agreed=6/6\n";
