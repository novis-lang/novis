--TEST--
Core\Arr::sum, ::product and ::average answer what array_sum, array_product and the guarded division answer, including each fold's identity over the empty array
--FILE--
<?nvs
// Spec § 2's three aggregations against their twins. The row that carries this
// case is the empty subject: a fold over nothing has to answer its own
// identity, and the three identities are three different things — `0` for a
// sum, `1` for a product, and *no answer at all* for a mean, which is the one
// PHP has no function for and where `array_sum($a) / count($a)` is a division
// by zero. `average` answering `null` rather than throwing is the member's
// stated reason for existing, so the oracle writes the guard PHP callers write
// by hand.
final class Show {
    public static function mean(array<int> $a): string {
        var $m = Core\Arr::average($a);
        if ($m == null) {
            return "none";
        }
        return $m as string;
    }
}

// An ordinary subject, including a negative so that a product's sign is asked
// about rather than assumed.
array<int> $ns = [3, -1, 4];
echo Core\Arr::sum($ns), "|", Core\Arr::product($ns), "|", Show::mean($ns), "\n";

// A mean that is not an integer, which is where the quotient's type stops being
// the subject's.
array<int> $half = [1, 2, 3, 4];
echo Core\Arr::sum($half), "|", Core\Arr::product($half), "|", Show::mean($half), "\n";

// One entry: every fold is that entry, and the mean is it exactly.
array<int> $one = [7];
echo Core\Arr::sum($one), "|", Core\Arr::product($one), "|", Show::mean($one), "\n";

// A zero in the subject is a product of zero rather than a skipped entry, which
// is the row a fold seeded with the wrong identity still passes.
array<int> $zeroed = [4, 0, 5];
echo Core\Arr::sum($zeroed), "|", Core\Arr::product($zeroed), "|", Show::mean($zeroed), "\n";

// The three identities, on one line. Nothing about the two arithmetic ones is
// derivable from the rows above — a sum of nothing could as plausibly have been
// a `null` too, and it is not.
array<int> $empty = [];
echo Core\Arr::sum($empty), "|", Core\Arr::product($empty), "|", Show::mean($empty), "\n";
--ORACLE--
<?php
function mean(array $a): string {
    $m = count($a) == 0 ? null : array_sum($a) / count($a);
    if ($m === null) {
        return "none";
    }
    return (string) $m;
}

$ns = [3, -1, 4];
echo array_sum($ns), "|", array_product($ns), "|", mean($ns), "\n";

$half = [1, 2, 3, 4];
echo array_sum($half), "|", array_product($half), "|", mean($half), "\n";

$one = [7];
echo array_sum($one), "|", array_product($one), "|", mean($one), "\n";

$zeroed = [4, 0, 5];
echo array_sum($zeroed), "|", array_product($zeroed), "|", mean($zeroed), "\n";

$empty = [];
echo array_sum($empty), "|", array_product($empty), "|", mean($empty), "\n";
