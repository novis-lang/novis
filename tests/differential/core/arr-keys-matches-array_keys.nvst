--TEST--
Core\Arr::keys answers the key sequence array_keys answers, over the spellings PHP folds together and the gaps unset leaves
--FILE--
<?nvs
// Spec § 2's `keys` against its twin. Novis types every key `string` where
// `array_keys` hands back an `int` for an integer key, so what these rows
// compare is the *sequence* — the same normalisation, the same order, the same
// gaps — and never the type each language chose for a key; ADR 0069 § 5 owns
// that choice. The interesting half is that the normalisation itself has to
// agree, because a subject is built out of key spellings before `keys` ever
// sees it: if `"7"` were a string key here and an integer one in PHP, the two
// arrays would not have the same number of entries and no rendering could hide
// it.
final class Render {
    public static function of(array<string> $keys): string {
        var $out = "";
        foreach ($keys as string $k) {
            $out = $out . "<" . $k . ">";
        }
        return $out;
    }
}

// A list's keys are its positions and a map's are what was written, in
// insertion order rather than in any sorted one.
array<int> $list = [10, 20, 30];
array<int> $map = ["b" => 1, "a" => 2];
echo Render::of(Core\Arr::keys($list)), "|", Render::of(Core\Arr::keys($map)), "\n";

// The normalisation boundary, asserted by *counting* as well as by reading: a
// decimal integer spelled as text is the integer key, a leading zero is not,
// a negative one is, and the empty string is an ordinary key. Four entries
// means the fold took exactly the pair it should have.
array<int> $numeral = ["7" => 1, "07" => 2, "-3" => 3, "" => 4];
echo Core\Arr::count($numeral), "|", Render::of(Core\Arr::keys($numeral)), "\n";

// The other side of that bound: one key written under both spellings is one
// entry, keeping its first position and taking the later value.
array<int> $twice = ["7" => 1, 7 => 2];
echo Core\Arr::count($twice), "|", Render::of(Core\Arr::keys($twice)), "\n";

// `unset` leaves a gap rather than renumbering, which is the case where the
// keys stop being the positions and `keys` is the only way to read them back.
array<int> $gapped = [10, 20, 30, 40];
unset($gapped[1]);
unset($gapped[3]);
echo Render::of(Core\Arr::keys($gapped)), "\n";

// The empty array has no keys at all rather than one empty key, so the
// brackets below are adjacent.
array<int> $empty = [];
echo "[", Render::of(Core\Arr::keys($empty)), "]\n";
--ORACLE--
<?php
function render(array $keys): string {
    $out = "";
    foreach ($keys as $k) {
        $out = $out . "<" . $k . ">";
    }
    return $out;
}

$list = [10, 20, 30];
$map = ["b" => 1, "a" => 2];
echo render(array_keys($list)), "|", render(array_keys($map)), "\n";

$numeral = ["7" => 1, "07" => 2, "-3" => 3, "" => 4];
echo count($numeral), "|", render(array_keys($numeral)), "\n";

$twice = ["7" => 1, 7 => 2];
echo count($twice), "|", render(array_keys($twice)), "\n";

$gapped = [10, 20, 30, 40];
unset($gapped[1]);
unset($gapped[3]);
echo render(array_keys($gapped)), "\n";

$empty = [];
echo "[", render(array_keys($empty)), "]\n";
