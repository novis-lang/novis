--TEST--
Core\Arr::count tracks insert, unset, re-insert and append the way PHP's count does
--FILE--
<?nvs
array<int> $a = ["x" => 1, "y" => 2, "z" => 3];
echo Core\Arr::count($a), ";";

unset($a["y"]);
echo Core\Arr::count($a), ";";

$a["y"] = 20;
echo Core\Arr::count($a), ";";

$a["x"] = 100;
echo Core\Arr::count($a), ";";

array<int> $empty = [];
echo Core\Arr::count($empty), "\n";
--ORACLE--
<?php
$a = ["x" => 1, "y" => 2, "z" => 3];
echo count($a), ";";

unset($a["y"]);
echo count($a), ";";

$a["y"] = 20;
echo count($a), ";";

$a["x"] = 100;
echo count($a), ";";

$empty = [];
echo count($empty), "\n";
