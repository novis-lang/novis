--TEST--
Core\Math::toBase and ::fromBase answer what PHP's decbin, dechex, decoct and base_convert answer for a non-negative number written in digits the base has room for, including the same lowercase alphabet, the same case-insensitive reading and the same refusal outside base 2 to 36
--FILE--
<?nvs
// Spec § 3's `toBase` and `fromBase` rows. Each member folds four PHP
// spellings: `decbin`, `dechex` and `decoct` are `base_convert`'s to-half at
// three fixed bases, and `bindec`, `hexdec` and `octdec` are its from-half.
// So what this case asks is whether one member with a `$base` argument
// answers what four functions with the base baked in do, across the whole
// range of bases both languages accept.
//
// It is the *agreeing* half on purpose. The two members are written around
// three refusals PHP has no equivalent for — a negative number, a digit the
// base cannot hold, an answer past `int` — and those are
// `math-to-base-and-from-base-refuse-what-php-silently-repairs`. Everything
// below is a row where the two sides give the same answer, so the boundary
// between them is drawn by the pair rather than by either case alone.

// The three dedicated spellings at the bases they are named for, plus the
// general one at base 36 — the largest base there are digits for.
echo Core\Math::toBase(5, 2), " ", Core\Math::toBase(255, 16), " ", Core\Math::toBase(8, 8), " ", Core\Math::toBase(35, 36), "\n";

// Zero, which has no digits to derive at all and is written as the single
// digit `0` in every base rather than as an empty string.
echo Core\Math::toBase(0, 2), " ", Core\Math::toBase(0, 16), " ", Core\Math::toBase(0, 36), "\n";

// The widest non-negative `int` there is. `base_convert` works digit by digit
// on a string rather than through a `float`, so it stays exact here — which
// is what makes this an agreeing row and not a rounding one.
echo Core\Math::toBase(Core\Math::INT_MAX, 16), " ", Core\Math::toBase(Core\Math::INT_MAX, 36), "\n";

// Digits above nine are lowercase on both sides. `dechex` is the spelling
// that fixes that convention in PHP, and `base_convert` follows it up to `z`;
// the counted sweep at the foot is what actually pins it across the alphabet.
echo Core\Math::toBase(3735928559, 16), " ", Core\Math::toBase(46655, 36), "\n";

// The from-half, on the same four bases.
echo Core\Math::fromBase("101", 2), " ", Core\Math::fromBase("ff", 16), " ", Core\Math::fromBase("10", 8), " ", Core\Math::fromBase("zz", 36), "\n";

// Reading is case-insensitive above nine on both sides, even though writing
// only ever produces the lowercase form. So the alphabet is asymmetric in the
// same direction in each language: one spelling out, either spelling in.
echo Core\Math::fromBase("FF", 16), " ", Core\Math::fromBase("DeadBeef", 16), " ", Core\Math::fromBase("ZZ", 36), "\n";

// A leading zero carries no value and is not an error, so a fixed-width
// spelling reads as the number it spells.
echo Core\Math::fromBase("00ff", 16), " ", Core\Math::fromBase("0000", 2), " ", Core\Math::fromBase("007", 8), "\n";

// Both ends of the accepted range of bases, named together: base 2 is the
// first base with more than one digit and base 36 the last the Latin letters
// reach. A member that stopped one short at either end would still print
// plausibly on every row above.
echo Core\Math::toBase(10, 2), " ", Core\Math::toBase(10, 36), " ", Core\Math::fromBase("1010", 2), " ", Core\Math::fromBase("a", 36), "\n";

// And the first base refused past each end. PHP raises a `ValueError` for a
// base outside 2 to 36 — for the to-base and the from-base argument alike —
// where Novis raises a `Fault::thrown`; the class differs, so what is asserted
// is that a `Throwable` handler reaches each of them, exactly as the base
// guard in `math-sqrt-exp-and-log-match-sqrt-exp-and-the-log-family` is.
try {
    var $writtenBelow = Core\Math::toBase(10, 1);
    echo "answered\n";
} catch (Throwable $writeTooLow) {
    echo "refused\n";
}
try {
    var $writtenAbove = Core\Math::toBase(10, 37);
    echo "answered\n";
} catch (Throwable $writeTooHigh) {
    echo "refused\n";
}
try {
    var $readBelow = Core\Math::fromBase("10", 1);
    echo "answered\n";
} catch (Throwable $readTooLow) {
    echo "refused\n";
}
try {
    var $readAbove = Core\Math::fromBase("10", 37);
    echo "answered\n";
} catch (Throwable $readTooHigh) {
    echo "refused\n";
}

// Base zero is refused as well rather than treated as "no base given", which
// is the one reading of it a caller might expect to be repaired into a
// default. Neither language repairs it.
try {
    var $writtenAtZero = Core\Math::toBase(10, 0);
    echo "answered\n";
} catch (Throwable $writeAtZero) {
    echo "refused\n";
}

// Three invariants asserted by *counting* rather than read off a line, so a
// member answering plausibly row by row still fails here. The round trip
// holds through base 2 and through base 16 for every value including
// `INT_MAX`, and every base-36 spelling is already lowercase. All four totals
// are printed, so a sweep that stopped short cannot agree with itself.
array<int> $values = [0, 1, 7, 42, 255, 4095, 1000000, Core\Math::INT_MAX];
int $binHeld = 0;
int $hexHeld = 0;
int $lowercase = 0;
int $rows = 0;
foreach ($values as int $v) {
    $rows = $rows + 1;
    if (Core\Math::fromBase(Core\Math::toBase($v, 2), 2) == $v) {
        $binHeld = $binHeld + 1;
    }
    if (Core\Math::fromBase(Core\Math::toBase($v, 16), 16) == $v) {
        $hexHeld = $hexHeld + 1;
    }
    if (Core\Math::toBase($v, 36) == Core\Str::lower(Core\Math::toBase($v, 36))) {
        $lowercase = $lowercase + 1;
    }
}
echo $binHeld, " ", $hexHeld, " ", $lowercase, " ", $rows, "\n";

// The same round trip swept across every base in range rather than every
// value, which is what says the `$base` argument reaches the whole alphabet
// and not just the three bases the dedicated PHP spellings cover.
array<int> $bases = Core\Arr::range(2, 36);
int $exact = 0;
int $baseRows = 0;
foreach ($bases as int $base) {
    $baseRows = $baseRows + 1;
    if (Core\Math::fromBase(Core\Math::toBase(1000000, $base as uint), $base as uint) == 1000000) {
        $exact = $exact + 1;
    }
}
echo $exact, " ", $baseRows, "\n";
--ORACLE--
<?php
echo decbin(5), " ", dechex(255), " ", decoct(8), " ", base_convert("35", 10, 36), "\n";

echo decbin(0), " ", dechex(0), " ", base_convert("0", 10, 36), "\n";

echo dechex(PHP_INT_MAX), " ", base_convert((string) PHP_INT_MAX, 10, 36), "\n";

echo dechex(3735928559), " ", base_convert("46655", 10, 36), "\n";

echo bindec("101"), " ", hexdec("ff"), " ", octdec("10"), " ", base_convert("zz", 36, 10), "\n";

echo hexdec("FF"), " ", hexdec("DeadBeef"), " ", base_convert("ZZ", 36, 10), "\n";

echo hexdec("00ff"), " ", bindec("0000"), " ", octdec("007"), "\n";

echo base_convert("10", 10, 2), " ", base_convert("10", 10, 36), " ", base_convert("1010", 2, 10), " ", base_convert("a", 36, 10), "\n";

try {
    $writtenBelow = base_convert("10", 10, 1);
    echo "answered\n";
} catch (Throwable $writeTooLow) {
    echo "refused\n";
}
try {
    $writtenAbove = base_convert("10", 10, 37);
    echo "answered\n";
} catch (Throwable $writeTooHigh) {
    echo "refused\n";
}
try {
    $readBelow = base_convert("10", 1, 10);
    echo "answered\n";
} catch (Throwable $readTooLow) {
    echo "refused\n";
}
try {
    $readAbove = base_convert("10", 37, 10);
    echo "answered\n";
} catch (Throwable $readTooHigh) {
    echo "refused\n";
}

try {
    $writtenAtZero = base_convert("10", 10, 0);
    echo "answered\n";
} catch (Throwable $writeAtZero) {
    echo "refused\n";
}

$values = [0, 1, 7, 42, 255, 4095, 1000000, PHP_INT_MAX];
$binHeld = 0;
$hexHeld = 0;
$lowercase = 0;
$rows = 0;
foreach ($values as $v) {
    $rows = $rows + 1;
    if (bindec(decbin($v)) == $v) {
        $binHeld = $binHeld + 1;
    }
    if (hexdec(dechex($v)) == $v) {
        $hexHeld = $hexHeld + 1;
    }
    if (base_convert((string) $v, 10, 36) == strtolower(base_convert((string) $v, 10, 36))) {
        $lowercase = $lowercase + 1;
    }
}
echo $binHeld, " ", $hexHeld, " ", $lowercase, " ", $rows, "\n";

$bases = range(2, 36);
$exact = 0;
$baseRows = 0;
foreach ($bases as $base) {
    $baseRows = $baseRows + 1;
    if (base_convert(base_convert("1000000", 10, $base), $base, 10) == 1000000) {
        $exact = $exact + 1;
    }
}
echo $exact, " ", $baseRows, "\n";
