--TEST--
`Core\Hash::hmac` answers what `hash_hmac` answers for a key one octet under, exactly at and one octet over every block width in spec § 11's strong subset, and the zero-extension collision RFC 2104's padding creates holds up to that width and stops at it (spec § 11, RFC 2104, `rule:types/bytes`)
--FILE--
<?nvs
// `hash-hmac-matches-hash_hmac-over-every-strong-digest` sweeps the ten
// algorithms with four keys; what it does not ask is RFC 2104's own boundary.
// A key at or under the compression block width is *zero-padded* to it, and a
// key past it is *hashed first* and the digest padded instead — two different
// code paths, chosen by one comparison, and an off-by-one in that comparison
// is invisible everywhere except within one octet of the width itself.
//
// The widths are not uniform across the subset: 64 for SHA-224 and SHA-256,
// 128 for SHA-384, SHA-512 and both SHA-512 truncations, and for SHA-3 the
// sponge *rate* rather than a compression block — 144, 136, 104 and 72 for
// the 224-, 256-, 384- and 512-bit cases. So the sweep is every one of those
// six widths, each with its two neighbours, asked of all ten algorithms at
// once: the row where an implementation used a single hardcoded width is a
// row where nine cells agree and one does not.
final class Row {
    // Every strong case, in spec § 11's roster order.
    public static function every(bytes $message, bytes $key): string {
        string $out = "";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha224)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha256)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha384)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha512)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha512_224)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha512_256)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha3_224)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha3_256)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha3_384)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::hmac($message, $key, Core\Digest::Sha3_512)) . "|";
        return $out;
    }

    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

// The empty key and a one-octet key, then each width's neighbourhood: 64 for
// the SHA-2 pair, 72 and 104 and 136 and 144 for the four SHA-3 rates, and
// 128 for SHA-384, SHA-512 and the truncations.
array<uint> $lengths = [
    0, 1,
    63, 64, 65,
    71, 72, 73,
    103, 104, 105,
    127, 128, 129,
    135, 136, 137,
    143, 144, 145,
];
bytes $message = Core\Encoding::encodeText("block-boundary", Core\Charset::Utf8);
foreach ($lengths as uint $n) {
    bytes $key = Core\Encoding::fromHex(Core\Str::repeat("0b", $n));
    echo "k", $n, ":", Row::every($message, $key), "\n";
}

// The bound, asserted on both sides of itself. Padding a key with zeros is
// what HMAC does to any key at or under the block width, so a key and that
// same key with one trailing zero octet authenticate *identically* — a
// collision the construction really has, not an implementation slip. One
// octet past the width the key is hashed instead, and the collision stops. A
// member whose comparison is off by one keeps it going one row too far.
bytes $k63 = Core\Encoding::fromHex(Core\Str::repeat("0b", 63));
bytes $k63z = Core\Encoding::fromHex(Core\Str::repeat("0b", 63) . "00");
bytes $k64 = Core\Encoding::fromHex(Core\Str::repeat("0b", 64));
bytes $k64z = Core\Encoding::fromHex(Core\Str::repeat("0b", 64) . "00");
echo "sha256-under:", Row::flag(Core\Hash::equals(
    Core\Hash::hmac($message, $k63, Core\Digest::Sha256),
    Core\Hash::hmac($message, $k63z, Core\Digest::Sha256)
)), "\n";
echo "sha256-over:", Row::flag(Core\Hash::equals(
    Core\Hash::hmac($message, $k64, Core\Digest::Sha256),
    Core\Hash::hmac($message, $k64z, Core\Digest::Sha256)
)), "\n";

// The same bound one block width up, where SHA-512 pads to 128 rather than to
// 64 — so the pair that collides here is the pair that does not, above.
bytes $k127 = Core\Encoding::fromHex(Core\Str::repeat("0b", 127));
bytes $k127z = Core\Encoding::fromHex(Core\Str::repeat("0b", 127) . "00");
bytes $k128 = Core\Encoding::fromHex(Core\Str::repeat("0b", 128));
bytes $k128z = Core\Encoding::fromHex(Core\Str::repeat("0b", 128) . "00");
echo "sha512-under:", Row::flag(Core\Hash::equals(
    Core\Hash::hmac($message, $k127, Core\Digest::Sha512),
    Core\Hash::hmac($message, $k127z, Core\Digest::Sha512)
)), "\n";
echo "sha512-over:", Row::flag(Core\Hash::equals(
    Core\Hash::hmac($message, $k128, Core\Digest::Sha512),
    Core\Hash::hmac($message, $k128z, Core\Digest::Sha512)
)), "\n";
echo "sha512-at-64:", Row::flag(Core\Hash::equals(
    Core\Hash::hmac($message, $k64, Core\Digest::Sha512),
    Core\Hash::hmac($message, $k64z, Core\Digest::Sha512)
)), "\n";

// And the rule that makes the over-width path what it is, stated directly:
// past the block, the key is replaced by its own digest under the same
// algorithm, so authenticating with the long key and with that digest are the
// same operation. Counted over four over-width keys, because it is the
// property the whole sweep above is evidence for.
array<uint> $long = [65, 100, 131, 200];
int $held = 0;
int $cells = 0;
foreach ($long as uint $n) {
    $cells = $cells + 1;
    bytes $wide = Core\Encoding::fromHex(Core\Str::repeat("aa", $n));
    if (Core\Hash::equals(
        Core\Hash::hmac($message, $wide, Core\Digest::Sha256),
        Core\Hash::hmac($message, Core\Hash::of($wide, Core\Digest::Sha256), Core\Digest::Sha256)
    )) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
--ORACLE--
<?php
$algos = [
    "sha224",
    "sha256",
    "sha384",
    "sha512",
    "sha512/224",
    "sha512/256",
    "sha3-224",
    "sha3-256",
    "sha3-384",
    "sha3-512",
];

function every($message, $key) {
    global $algos;
    $out = "";
    foreach ($algos as $algo) {
        $out = $out . hash_hmac($algo, $message, $key) . "|";
    }
    return $out;
}

function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

$lengths = [
    0, 1,
    63, 64, 65,
    71, 72, 73,
    103, 104, 105,
    127, 128, 129,
    135, 136, 137,
    143, 144, 145,
];
$message = "block-boundary";
foreach ($lengths as $n) {
    $key = hex2bin(str_repeat("0b", $n));
    echo "k", $n, ":", every($message, $key), "\n";
}

$k63 = hex2bin(str_repeat("0b", 63));
$k63z = hex2bin(str_repeat("0b", 63) . "00");
$k64 = hex2bin(str_repeat("0b", 64));
$k64z = hex2bin(str_repeat("0b", 64) . "00");
echo "sha256-under:", flag(hash_hmac("sha256", $message, $k63, true) === hash_hmac("sha256", $message, $k63z, true)), "\n";
echo "sha256-over:", flag(hash_hmac("sha256", $message, $k64, true) === hash_hmac("sha256", $message, $k64z, true)), "\n";

$k127 = hex2bin(str_repeat("0b", 127));
$k127z = hex2bin(str_repeat("0b", 127) . "00");
$k128 = hex2bin(str_repeat("0b", 128));
$k128z = hex2bin(str_repeat("0b", 128) . "00");
echo "sha512-under:", flag(hash_hmac("sha512", $message, $k127, true) === hash_hmac("sha512", $message, $k127z, true)), "\n";
echo "sha512-over:", flag(hash_hmac("sha512", $message, $k128, true) === hash_hmac("sha512", $message, $k128z, true)), "\n";
echo "sha512-at-64:", flag(hash_hmac("sha512", $message, $k64, true) === hash_hmac("sha512", $message, $k64z, true)), "\n";

$held = 0;
$cells = 0;
foreach ([65, 100, 131, 200] as $n) {
    $cells = $cells + 1;
    $key = hex2bin(str_repeat("aa", $n));
    if (hash_hmac("sha256", $message, $key, true) === hash_hmac("sha256", $message, hash("sha256", $key, true), true)) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
