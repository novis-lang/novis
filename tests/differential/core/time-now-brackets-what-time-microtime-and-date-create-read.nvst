--TEST--
Core\Time::now agrees with time()/microtime()/date_create() on every property a clock reading can be held to — spec § 4
--FILE--
<?nvs
// `Core\Time::now(): Instant` replaces `time`, `microtime` and `date_create` at
// once, and none of the four has a value a case could pin: two runs a
// microsecond apart are both correct. So every row below is a *property* both
// implementations must hold — a bracket, an ordering, or an agreement between
// two spellings of one reading — computed on each side from that side's own
// clock, and the verdict is what the two halves compare.
var $utc = Core\Time\Zone::UTC;

// The bracket. 1767225600 is 2026-01-01T00:00:00Z and 4102444800 is
// 2100-01-01T00:00:00Z: a reading outside either end is a clock that is not
// telling the wall time, which is the whole of what this member promises.
var $first = Core\Time::now();
int $secs = $first->toEpochSeconds();
echo "afterFixedPast=", $secs >= 1767225600 ? "yes" : "no", "\n";
echo "beforeFixedFuture=", $secs < 4102444800 ? "yes" : "no", "\n";

// The three scales of one reading agree, which is `microtime`'s own question:
// an `Instant` is one point, so its milliseconds and its microseconds are its
// seconds scaled and not three independent readings of the clock.
int $millis = $first->toEpochMillis();
int $micros = $first->toEpochMicros();
echo "millisAgree=", Core\Math::intDiv($millis, 1000) == $secs ? "yes" : "no", "\n";
echo "microsAgree=", Core\Math::intDiv($micros, 1000000) == $secs ? "yes" : "no", "\n";

// The ordering. A wall clock may be stepped by the operating system, so this
// asserts only that a second reading is not *behind* the first and not far
// ahead of it — `Core\Time::monotonic` is the member that promises more, and it
// has its own case.
var $second = Core\Time::now();
echo "nonDecreasing=", $second->compareTo($first) >= 0 ? "yes" : "no", "\n";
echo "withinFiveSeconds=", $second->toEpochSeconds() - $secs < 5 ? "yes" : "no", "\n";
echo "sinceIsNonNegative=", $second->since($first)->toNanoseconds() >= 0 ? "yes" : "no", "\n";

// `date_create()` reads the same clock `time()` does, and so does the civil
// view of an `Instant`: reading the wall time through a zone and coming back
// out of it lands on the same second.
int $civil = Core\Time::now()->in($utc)->toInstant()->toEpochSeconds();
echo "civilAgrees=", $civil - $secs < 2 ? "yes" : "no", "\n";

// The reading survives being written out and read back, which is the property
// `strtotime(gmdate("c", time()))` asserts on the PHP side.
int $roundTrip = Core\Time::fromIso($first->toIso())->toEpochSeconds();
echo "isoRoundTrip=", $roundTrip == $secs ? "yes" : "no", "\n";
--ORACLE--
<?php
date_default_timezone_set("UTC");

$first = microtime(true);
$secs = (int) $first;
echo "afterFixedPast=", $secs >= 1767225600 ? "yes" : "no", "\n";
echo "beforeFixedFuture=", $secs < 4102444800 ? "yes" : "no", "\n";

$millis = (int) floor($first * 1000);
$micros = (int) floor($first * 1000000);
echo "millisAgree=", intdiv($millis, 1000) === $secs ? "yes" : "no", "\n";
echo "microsAgree=", intdiv($micros, 1000000) === $secs ? "yes" : "no", "\n";

$second = microtime(true);
echo "nonDecreasing=", $second >= $first ? "yes" : "no", "\n";
echo "withinFiveSeconds=", (int) $second - $secs < 5 ? "yes" : "no", "\n";
echo "sinceIsNonNegative=", ($second - $first) * 1000000000 >= 0 ? "yes" : "no", "\n";

$civil = date_create()->getTimestamp();
echo "civilAgrees=", $civil - $secs < 2 ? "yes" : "no", "\n";

$roundTrip = strtotime(gmdate("c", $secs));
echo "isoRoundTrip=", $roundTrip === $secs ? "yes" : "no", "\n";
