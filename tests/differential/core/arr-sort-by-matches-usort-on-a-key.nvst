--TEST--
Core\Arr::sort's `{by}` orders by a projected key the way usort over the same projection does
--FILE--
<?nvs
array<string> $words = ["ccc", "a", "dddd", "bb"];
echo Core\Str::join(Core\Arr::sort($words, {by: fn(string $s): int => Core\Str::length($s) as int}), ","), "\n";
echo Core\Str::join(Core\Arr::sort($words), ","), "\n";
echo Core\Str::join($words, ","), "\n";
--ORACLE--
<?php
$words = ["ccc", "a", "dddd", "bb"];
$byLength = $words;
usort($byLength, fn(string $a, string $b) => strlen($a) <=> strlen($b));
echo implode(",", $byLength), "\n";
$plain = $words;
sort($plain);
echo implode(",", $plain), "\n";
echo implode(",", $words), "\n";
