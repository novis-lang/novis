--TEST--
Core\Math::ceil, Core\Math::floor and Core\Math::truncate answer what PHP's ceil and floor answer on every row where the three could part — a zero of either sign, the half boundary in both directions, an infinite or NAN argument, and a magnitude past the range where a float still counts integers
--FILE--
<?nvs
// Spec § 3's `ceil`, `floor` and `truncate` rows. `ceil` and `floor` are one
// PHP function each with the same name; `truncate`'s stated twin is a `(int)`
// cast, which loses the sign of a negative zero where the member keeps it, so
// the oracle writes the cast's sign-preserving spelling out —
// `$n >= 0 ? floor($n) : ceil($n)` — exactly as the roster case
// every-math-member-with-a-php-twin-agrees does, and for the same reason.
//
// What is under test is not the ordinary row. The three members agree with
// each other wherever a value has no fraction, and
// math-the-four-rounding-members-agree-wherever-there-is-no-fraction already
// pins that against Novis's own ordering. This case asks the rows where they
// *have* to part, and where an implementation reaching for a cast, an
// `as int`, or a comparison against zero prints plausibly on one line and
// fails on the next.

final class Show {
    // `NAN` coerced to a string is a warning in PHP 8.4 and later, so neither
    // side renders one: a value that is not equal to itself is the only `NAN`
    // there is, and the sentinel is what both languages print instead. Every
    // other value renders through the ordinary float-to-string conversion,
    // which already agrees across the two languages down to `INF`, `-INF`, the
    // sign of a zero and the exponent form a large magnitude takes.
    public static function real(float $value): string {
        if (Core\Math::isNan($value)) {
            return "nan";
        }
        return $value as string;
    }
}

float $nan = Core\Math::NAN;
float $huge = Core\Math::INFINITY;

// A zero of either sign is its own answer through all three members, sign
// included. This is the row a `(int)` cast fails and an `as int` fails with
// it: the answer is a `float` and it carries a sign bit an integer has no
// room for.
echo Core\Math::ceil(0.0), " ", Core\Math::floor(0.0), " ", Core\Math::truncate(0.0), " ", Core\Math::ceil(-0.0), " ", Core\Math::floor(-0.0), " ", Core\Math::truncate(-0.0), "\n";

// The half boundary just below zero, where the three members give three
// different answers and two of them are a negative zero rather than a zero.
// A member normalizing that away agrees with the third and fails here.
echo Core\Math::ceil(-0.5), " ", Core\Math::floor(-0.5), " ", Core\Math::truncate(-0.5), "\n";

// The half boundary just above zero, where `floor` and `truncate` agree and
// `ceil` does not — the mirror of the line above, which is what says the
// difference is the direction and not the sign.
echo Core\Math::ceil(0.5), " ", Core\Math::floor(0.5), " ", Core\Math::truncate(0.5), "\n";

// A half past one, in both signs: the row that separates truncation toward
// zero from flooring toward negative infinity, which is the whole of what
// `truncate` and `floor` disagree about.
echo Core\Math::ceil(1.5), " ", Core\Math::floor(1.5), " ", Core\Math::truncate(1.5), " ", Core\Math::ceil(-1.5), " ", Core\Math::floor(-1.5), " ", Core\Math::truncate(-1.5), "\n";

// A value already integral is its own answer through all three, in both signs
// — the control that says none of the three is off by one before the rows
// above are read.
echo Core\Math::ceil(3.0), " ", Core\Math::floor(3.0), " ", Core\Math::truncate(3.0), " ", Core\Math::ceil(-3.0), " ", Core\Math::floor(-3.0), " ", Core\Math::truncate(-3.0), "\n";

// The specials. An infinity has no nearer integer, so all three answer it
// unchanged rather than saturating at the largest representable value, and a
// `NAN` propagates rather than becoming a zero.
echo Core\Math::ceil($huge), " ", Core\Math::floor(0.0 - $huge), " ", Core\Math::truncate($huge), " ", Show::real(Core\Math::ceil($nan)), " ", Show::real(Core\Math::floor($nan)), " ", Show::real(Core\Math::truncate($nan)), "\n";

// Past `2 ** 53`, where consecutive integers are no longer all representable:
// the argument is already integral, so all three answer it unchanged, and the
// rendering both languages give it is the exponent form rather than the digits.
// A member routing through an `int` would refuse or wrap the third of these.
echo Core\Math::ceil(4503599627370497.0), " ", Core\Math::floor(4503599627370497.0), " ", Core\Math::truncate(-1.0e300), "\n";

// Four properties over one table, asserted by *counting* so that a member
// answering plausibly row by row above still fails here:
//
//  - `ceil` is never below its argument and `floor` never above it, which is
//    the pair of inequalities that names each member's direction;
//  - `truncate` is `floor` for a non-negative argument and `ceil` otherwise,
//    which is the derivation the oracle writes out;
//  - the three never differ by more than one, which is what says a member is
//    rounding to a *neighbour* rather than to some other integer;
//  - `ceil` is the negation of `floor` of the negation, the reflection that
//    ties the two members to each other rather than each to itself.
//
// The `NAN` row is excluded from all four, since no inequality holds of it;
// the row total is printed beside the counts, so a sweep that silently
// stopped short cannot agree with itself.
array<float> $table = [-1.0e300, -3.0, -1.5, -0.5, -0.0, 0.0, 0.5, 1.5, 3.0, 4503599627370497.0];
int $bracketed = 0;
int $derived = 0;
int $adjacent = 0;
int $reflected = 0;
int $rows = 0;
foreach ($table as float $n) {
    $rows = $rows + 1;
    var $up = Core\Math::ceil($n);
    var $down = Core\Math::floor($n);
    var $toward = Core\Math::truncate($n);
    if ($up >= $n && $down <= $n) {
        $bracketed = $bracketed + 1;
    }
    if ($n >= 0.0) {
        if ($toward == $down) {
            $derived = $derived + 1;
        }
    } else {
        if ($toward == $up) {
            $derived = $derived + 1;
        }
    }
    if ($up - $down <= 1.0) {
        $adjacent = $adjacent + 1;
    }
    if ($up == 0.0 - Core\Math::floor(0.0 - $n)) {
        $reflected = $reflected + 1;
    }
}
echo $bracketed, " ", $derived, " ", $adjacent, " ", $reflected, " ", $rows, "\n";
--ORACLE--
<?php
function real(float $value): string {
    if (is_nan($value)) {
        return "nan";
    }
    return (string) $value;
}

function truncate(float $n): float {
    return $n >= 0 ? floor($n) : ceil($n);
}

$nan = NAN;
$huge = INF;

echo ceil(0.0), " ", floor(0.0), " ", truncate(0.0), " ", ceil(-0.0), " ", floor(-0.0), " ", truncate(-0.0), "\n";

echo ceil(-0.5), " ", floor(-0.5), " ", truncate(-0.5), "\n";

echo ceil(0.5), " ", floor(0.5), " ", truncate(0.5), "\n";

echo ceil(1.5), " ", floor(1.5), " ", truncate(1.5), " ", ceil(-1.5), " ", floor(-1.5), " ", truncate(-1.5), "\n";

echo ceil(3.0), " ", floor(3.0), " ", truncate(3.0), " ", ceil(-3.0), " ", floor(-3.0), " ", truncate(-3.0), "\n";

echo ceil($huge), " ", floor(0.0 - $huge), " ", truncate($huge), " ", real(ceil($nan)), " ", real(floor($nan)), " ", real(truncate($nan)), "\n";

echo ceil(4503599627370497.0), " ", floor(4503599627370497.0), " ", truncate(-1.0e300), "\n";

$table = [-1.0e300, -3.0, -1.5, -0.5, -0.0, 0.0, 0.5, 1.5, 3.0, 4503599627370497.0];
$bracketed = 0;
$derived = 0;
$adjacent = 0;
$reflected = 0;
$rows = 0;
foreach ($table as $n) {
    $rows = $rows + 1;
    $up = ceil($n);
    $down = floor($n);
    $toward = truncate($n);
    if ($up >= $n && $down <= $n) {
        $bracketed = $bracketed + 1;
    }
    if ($n >= 0.0) {
        if ($toward == $down) {
            $derived = $derived + 1;
        }
    } else {
        if ($toward == $up) {
            $derived = $derived + 1;
        }
    }
    if ($up - $down <= 1.0) {
        $adjacent = $adjacent + 1;
    }
    if ($up == 0.0 - floor(0.0 - $n)) {
        $reflected = $reflected + 1;
    }
}
echo $bracketed, " ", $derived, " ", $adjacent, " ", $reflected, " ", $rows, "\n";
