--TEST--
Core\Out::capture answers at every depth what ob_start/ob_get_clean answers at that depth, siblings take only their own writes, a level whose answer is dropped swallows exactly as ob_end_clean does, and {through:} runs after the level has closed
--FILE--
<?nvs
// Spec § 12 says `Core\Out` has one member and that a buffer is scoped to a
// callable, where PHP's `ob_*` family is a global stack any function can push
// and pop. The two therefore have no *shape* in common — but for a program
// whose starts and ends happen to nest, they must answer the same bytes at
// every depth, and that is what is compared here. The PHP side spells the
// bracketing out by hand at each level, which is the point: nothing on the
// Novis side can be written non-nesting.

// One level. `capture` answers what the callable wrote and not what it returned,
// which is `ob_get_clean`'s answer too.
echo "[", Core\Out::capture(fn (): void => { echo "one"; }), "]\n";

// Three deep, with every level's answer visible as it is re-emitted into its
// parent — so a level that took too much or too little shows up as the wrong
// bytes at the wrong depth rather than as the wrong total.
echo "[", Core\Out::capture(fn (): void => {
    echo "1<";
    echo Core\Out::capture(fn (): void => {
        echo "2<";
        echo Core\Out::capture(fn (): void => { echo "3"; });
        echo ">";
    });
    echo ">";
}), "]\n";

// Two captures that are siblings at the same depth each take only their own
// writes, because the second opens after the first has closed. On the PHP side
// that is the same claim about the stack having been popped.
echo "[", Core\Out::capture(fn (): void => {
    echo "a";
    echo Core\Out::capture(fn (): void => { echo "b"; });
    echo "|";
    echo Core\Out::capture(fn (): void => { echo "c"; });
    echo "d";
}), "]\n";

// A level whose answer is never echoed swallows what it collected. `capture`
// always swallows — re-emitting is the visible `echo` above — so the dropped
// answer here is `ob_end_clean`'s twin and not `ob_end_flush`'s.
var $dropped = Core\Out::capture(fn (): void => { echo "swallowed"; });
echo "[after]\n";

// The same, one level in: what the inner level took never reaches the outer
// one, so the outer answers only the bytes written around it.
echo "[", Core\Out::capture(fn (): void => {
    echo "kept<";
    var $inner = Core\Out::capture(fn (): void => { echo "gone"; });
    echo ">kept";
}), "]\n";

// Nesting is *call* nesting: a capture opened inside a method called from
// inside a capture is the inner level, with no stack for the two to have agreed
// on. PHP reaches the same answer through the stack, which is the agreement.
final class Inner {
    public static function run(): void {
        echo "<";
        echo Core\Out::capture(fn (): void => { echo "deep"; });
        echo ">";
    }
}
echo "[", Core\Out::capture(fn (): void => {
    echo "outer";
    Inner::run();
}), "]\n";

// `{through:}` transforms the captured carrier and runs *after* the level has
// closed, so anything it writes reaches the enclosing sink at once — which is
// why the marker is printed before the body this statement is echoing. Its PHP
// twin is therefore a call made after `ob_get_clean` has already popped, not
// `ob_start($callback)`, whose invisible pass-through spec § 12 declines to
// have.
echo "[", Core\Out::capture(
    fn (): void => { echo "body"; },
    {through: fn (Core\Cli\Text $t): Core\Cli\Text => { echo "<mark>"; return $t; }}
), "]\n";
--ORACLE--
<?php
ob_start();
echo "one";
$one = ob_get_clean();
echo "[", $one, "]\n";

ob_start();
    echo "1<";
    ob_start();
        echo "2<";
        ob_start();
        echo "3";
        $level3 = ob_get_clean();
        echo $level3;
        echo ">";
    $level2 = ob_get_clean();
    echo $level2;
    echo ">";
$level1 = ob_get_clean();
echo "[", $level1, "]\n";

ob_start();
    echo "a";
    ob_start();
    echo "b";
    $first = ob_get_clean();
    echo $first;
    echo "|";
    ob_start();
    echo "c";
    $second = ob_get_clean();
    echo $second;
    echo "d";
$siblings = ob_get_clean();
echo "[", $siblings, "]\n";

ob_start();
echo "swallowed";
ob_end_clean();
echo "[after]\n";

ob_start();
    echo "kept<";
    ob_start();
    echo "gone";
    ob_end_clean();
    echo ">kept";
$kept = ob_get_clean();
echo "[", $kept, "]\n";

function inner(): void {
    echo "<";
    ob_start();
    echo "deep";
    $deep = ob_get_clean();
    echo $deep;
    echo ">";
}

ob_start();
    echo "outer";
    inner();
$nested = ob_get_clean();
echo "[", $nested, "]\n";

// The `[` is already out before the transform runs, because an `echo` list is
// emitted argument by argument and the capture is the second argument — so the
// twin brackets by hand in that order rather than hoisting the whole call.
echo "[";
ob_start();
echo "body";
$body = ob_get_clean();
echo "<mark>";
echo $body, "]\n";
