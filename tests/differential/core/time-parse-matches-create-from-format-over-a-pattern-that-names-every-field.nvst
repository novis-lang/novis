--TEST--
Core\Time::parse agrees with DateTime::createFromFormat() wherever the pattern names every field it reads — spec § 4
--FILE--
<?nvs
// `Core\Time::parse(string $text, string $pattern, Zone $zone): DateTime` is
// `strptime` — removed from PHP outright — and `DateTime::createFromFormat`,
// over CLDR pattern letters rather than PHP's own: `yyyy-MM-dd HH:mm:ss`
// against `Y-m-d H:i:s`. The oracle below writes each row in both alphabets,
// so the two spellings of one pattern are the assertion.
final class Read {
    public static function seconds(string $text, string $pattern): int {
        return Core\Time::parse($text, $pattern, Core\Time\Zone::UTC)->toInstant()->toEpochSeconds();
    }
}

echo Read::seconds("2024-02-29 13:45:07", "yyyy-MM-dd HH:mm:ss"), "\n";
echo Read::seconds("2024-02-29 00:00:00", "yyyy-MM-dd HH:mm:ss"), "\n";
echo Read::seconds("29/02/2024 13:45:07", "dd/MM/yyyy HH:mm:ss"), "\n";

// A twelve-hour clock with its meridiem, which is `hh … a` against `h … A`.
echo Read::seconds("2024-02-29 01:45 PM", "yyyy-MM-dd hh:mm a"), "\n";
echo Read::seconds("2024-02-29 01:45 AM", "yyyy-MM-dd hh:mm a"), "\n";

// A month name, short and full — `MMM`/`MMMM` against `M`/`F`.
echo Read::seconds("Feb 29 2024 13:45:07", "MMM dd yyyy HH:mm:ss"), "\n";
echo Read::seconds("February 29 2024 13:45:07", "MMMM dd yyyy HH:mm:ss"), "\n";

// A subsecond run, read as the fraction it is: `SSS` against `v`.
echo Core\Time::parse("2024-02-29 13:45:07.500", "yyyy-MM-dd HH:mm:ss.SSS", Core\Time\Zone::UTC)->toInstant()->toEpochMillis(), "\n";

// Literal text in the pattern: quoted here, backslash-escaped there.
echo Read::seconds("at 2024-02-29 13:45:07", "'at' yyyy-MM-dd HH:mm:ss"), "\n";

// The zone is this member's third argument rather than ambient state, which is
// `createFromFormat`'s own third argument and the one thing about `strptime`
// there was never a way to say.
echo Core\Time::parse("2024-02-29 13:45:07", "yyyy-MM-dd HH:mm:ss", Core\Time\Zone::of("Europe/Berlin"))->toInstant()->toEpochSeconds(), "\n";
echo Core\Time::parse("2024-07-04 13:45:07", "yyyy-MM-dd HH:mm:ss", Core\Time\Zone::of("Europe/Berlin"))->toInstant()->toEpochSeconds(), "\n";
--ORACLE--
<?php
date_default_timezone_set("UTC");
$utc = new DateTimeZone("UTC");
echo DateTime::createFromFormat("Y-m-d H:i:s", "2024-02-29 13:45:07", $utc)->getTimestamp(), "\n";
echo DateTime::createFromFormat("Y-m-d H:i:s", "2024-02-29 00:00:00", $utc)->getTimestamp(), "\n";
echo DateTime::createFromFormat("d/m/Y H:i:s", "29/02/2024 13:45:07", $utc)->getTimestamp(), "\n";
echo DateTime::createFromFormat("Y-m-d h:i A", "2024-02-29 01:45 PM", $utc)->getTimestamp(), "\n";
echo DateTime::createFromFormat("Y-m-d h:i A", "2024-02-29 01:45 AM", $utc)->getTimestamp(), "\n";
echo DateTime::createFromFormat("M d Y H:i:s", "Feb 29 2024 13:45:07", $utc)->getTimestamp(), "\n";
echo DateTime::createFromFormat("F d Y H:i:s", "February 29 2024 13:45:07", $utc)->getTimestamp(), "\n";
$fraction = DateTime::createFromFormat("Y-m-d H:i:s.v", "2024-02-29 13:45:07.500", $utc);
echo $fraction->getTimestamp() * 1000 + (int) $fraction->format("v"), "\n";
echo DateTime::createFromFormat('\a\t Y-m-d H:i:s', "at 2024-02-29 13:45:07", $utc)->getTimestamp(), "\n";
$berlin = new DateTimeZone("Europe/Berlin");
echo DateTime::createFromFormat("Y-m-d H:i:s", "2024-02-29 13:45:07", $berlin)->getTimestamp(), "\n";
echo DateTime::createFromFormat("Y-m-d H:i:s", "2024-07-04 13:45:07", $berlin)->getTimestamp(), "\n";
