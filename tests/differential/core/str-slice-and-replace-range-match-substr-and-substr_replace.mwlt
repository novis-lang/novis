--TEST--
Core\Str::slice and ::replaceRange read one window the way substr and substr_replace read theirs, over every sign of every argument, and the two members compose into the identity PHP's pair also holds
--FILE--
<?mwl
// Spec § 1's `slice` and `replaceRange` rows. Both members read their
// `int $offset` and `?int $length` through one shared helper — `window` in
// `mwl_stdlib::str`, whose own doc comment owns the sign rule — so what is
// worth pinning is not two members' arithmetic but that the single reading
// they share is PHP's, at every sign and past every end.
//
// The subject here is ASCII on purpose. `Core\Str::slice` counts in grapheme
// clusters (ADR 0009 § 2, `mwl_stdlib::granularity::DEFAULT`), `substr`
// counts bytes and `mb_substr` counts code points; inside ASCII with no
// carriage return all three units are the same unit, which is exactly what
// `granularity::one_byte_per_grapheme` asserts. So this file is the whole
// sign table over a subject where the units cannot disagree, and the
// companion `-diverge-` case is where they do.

string $subject = "abcdef";

// Every offset a caller can write: inside, at the end, past it, and the same
// four counted backwards from the end. -9 is further back than the subject is
// long, which clamps to the start rather than throwing.
array<int> $offsets = [0, 1, 2, 5, 6, 7, -1, -3, -6, -9];

// Every length: zero, short, exact, past the end, and the negative spellings
// that mean "stop this many short of the end" rather than "run backwards".
// -9 reaches back past the offset, which closes the window before it opens.
array<int> $lengths = [0, 1, 3, 6, 9, -1, -3, -6, -9];

// The slice table. Ninety cells, bracketed so an empty answer is a cell
// rather than a gap — a member that clamped a backwards window to one
// character instead of none prints plausibly without the brackets.
foreach ($offsets as int $offset) {
    foreach ($lengths as int $length) {
        echo "[", Core\Str::slice($subject, $offset, $length), "]";
    }
    echo "\n";
}

// The same ninety cells substituted rather than returned. The replacement is
// two characters wide and is not a substring of the subject, so an insertion
// at a closed window is visible as itself and a cell that replaced the wrong
// extent shows which extent it took.
foreach ($offsets as int $start) {
    foreach ($lengths as int $width) {
        echo "[", Core\Str::replaceRange($subject, $start, $width, "<>"), "]";
    }
    echo "\n";
}

// The identity the shared window buys, counted rather than read off a row:
// putting a cell's own slice back into the range it came from reproduces the
// subject, for every one of the ninety windows. This is the claim that says
// the two members read one window and not two that usually agree — a member
// clamping its end differently from the other fails here while both tables
// above still print something reasonable. PHP holds it too, on all ninety.
int $held = 0;
int $cells = 0;
foreach ($offsets as int $anchor) {
    foreach ($lengths as int $reach) {
        $cells = $cells + 1;
        if (Core\Str::replaceRange($subject, $anchor, $reach, Core\Str::slice($subject, $anchor, $reach)) == $subject) {
            $held = $held + 1;
        }
    }
}
echo $held, " of ", $cells, "\n";

// The `null` length — "to the end of the subject" said by the type rather
// than by a sentinel (ADR 0063 R5). `slice` may omit it, because it is the
// first `Core` member whose default is `null`; `replaceRange` must write it,
// since a default there would put an optional parameter before a mandatory
// one. PHP spells the same thing by leaving the argument off in both.
echo "[", Core\Str::slice($subject, 2), "][", Core\Str::slice($subject, 2, null), "][", Core\Str::slice($subject, -2), "][", Core\Str::slice($subject, 9), "][", Core\Str::slice($subject, -9), "]\n";
echo "[", Core\Str::replaceRange($subject, 2, null, "<>"), "][", Core\Str::replaceRange($subject, -2, null, "<>"), "][", Core\Str::replaceRange($subject, 9, null, "<>"), "][", Core\Str::replaceRange($subject, -9, null, "<>"), "]\n";

// An empty subject has no window at all to name, so every offset and every
// length reach the same answer: `""` sliced, and the replacement alone
// substituted. This is the boundary where the arithmetic has nothing to clamp
// against, which is where an off-by-one in the clamp becomes an index out of
// range instead of a wrong answer.
string $none = "";
echo "[", Core\Str::slice($none, 0), "][", Core\Str::slice($none, 3, 2), "][", Core\Str::slice($none, -3, -2), "]\n";
echo "[", Core\Str::replaceRange($none, 0, null, "<>"), "][", Core\Str::replaceRange($none, 3, 2, "<>"), "][", Core\Str::replaceRange($none, -3, -2, "<>"), "]\n";

// An empty replacement is a deletion, and it is the spelling a caller reaches
// for far more often than the general substitution. Pinned at the four signs,
// because a deletion is where a window that closes before it opens is least
// visible: it prints the subject unchanged, which is also what a correct
// empty window prints.
echo "[", Core\Str::replaceRange($subject, 1, 3, ""), "][", Core\Str::replaceRange($subject, -3, 2, ""), "][", Core\Str::replaceRange($subject, 2, -2, ""), "][", Core\Str::replaceRange($subject, 2, -9, ""), "]\n";
--ORACLE--
<?php
$subject = "abcdef";

$offsets = [0, 1, 2, 5, 6, 7, -1, -3, -6, -9];

$lengths = [0, 1, 3, 6, 9, -1, -3, -6, -9];

foreach ($offsets as $offset) {
    foreach ($lengths as $length) {
        echo "[", substr($subject, $offset, $length), "]";
    }
    echo "\n";
}

foreach ($offsets as $start) {
    foreach ($lengths as $width) {
        echo "[", substr_replace($subject, "<>", $start, $width), "]";
    }
    echo "\n";
}

$held = 0;
$cells = 0;
foreach ($offsets as $anchor) {
    foreach ($lengths as $reach) {
        $cells = $cells + 1;
        if (substr_replace($subject, substr($subject, $anchor, $reach), $anchor, $reach) == $subject) {
            $held = $held + 1;
        }
    }
}
echo $held, " of ", $cells, "\n";

echo "[", substr($subject, 2), "][", substr($subject, 2), "][", substr($subject, -2), "][", substr($subject, 9), "][", substr($subject, -9), "]\n";
echo "[", substr_replace($subject, "<>", 2), "][", substr_replace($subject, "<>", -2), "][", substr_replace($subject, "<>", 9), "][", substr_replace($subject, "<>", -9), "]\n";

$none = "";
echo "[", substr($none, 0), "][", substr($none, 3, 2), "][", substr($none, -3, -2), "]\n";
echo "[", substr_replace($none, "<>", 0), "][", substr_replace($none, "<>", 3, 2), "][", substr_replace($none, "<>", -3, -2), "]\n";

echo "[", substr_replace($subject, "", 1, 3), "][", substr_replace($subject, "", -3, 2), "][", substr_replace($subject, "", 2, -2), "][", substr_replace($subject, "", 2, -9), "]\n";
