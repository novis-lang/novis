--TEST--
Core\Validate::isEmail, isDomain, isIp and isMac answer what filter_var's FILTER_VALIDATE_EMAIL, _DOMAIN with FILTER_FLAG_HOSTNAME, _IP and _MAC answer, and {version: 4}/{version: 6} answer what FILTER_FLAG_IPV4/IPV6 answer
--FILE--
<?nvs
// Spec § 12: `Core\Validate` is what survives of `filter` — the genuine
// validators only, each named after a *format*, none of them a launderer.
// `filter_var`'s validate half is therefore the twin for exactly these four
// members, and the two flag-selected IP families are the `{version:}` option
// rather than two more member names (spec § 12; `rule:types/single-value-types`'s closed literal set).
//
// PHP's answer is a value-or-`false`, which is the fourth of the four failure
// spellings `rule:core-api/shape-rules` replaces with a `bool` here; the twin below compares
// against `false` at every call so that the *question* is the same one.
//
// Two subjects the two languages answer differently are deliberately not in the
// tables below — a bracketed IP address for a mailbox host and a domain written
// with its root dot — and they are the subject of
// `validate-refuses-the-bracketed-ip-address-and-the-root-dot-filter_var-accepts`.
final class Show {
    public static function of(bool $answer): string {
        return $answer ? "1" : "0";
    }
}

array<string> $emails = [
    "user@example.com",
    "user.name+tag@example.co.uk",
    "a@b",
    "user@",
    "@example.com",
    "user example.com",
    "",
    "user@example..com",
];
foreach ($emails as string $subject) {
    echo Show::of(Core\Validate::isEmail($subject));
}
echo "\n";

array<string> $domains = [
    "example.com",
    "sub.example.com",
    "a",
    "-bad.example",
    "example-.com",
    "exa mple.com",
    "",
];
foreach ($domains as string $subject) {
    echo Show::of(Core\Validate::isDomain($subject));
}
echo "\n";

// One subject list asked three ways: any family, then each family alone. The
// sweep is the point — a member that answered plausibly for `127.0.0.1` and
// wrongly for `::1` still prints a right-looking first row.
array<string> $addresses = [
    "127.0.0.1",
    "255.255.255.255",
    "0.0.0.0",
    "256.1.1.1",
    "1.2.3",
    "1.2.3.4.5",
    "::1",
    "2001:db8::1",
    "2001:db8:::1",
    "",
];
foreach ($addresses as string $subject) {
    echo Show::of(Core\Validate::isIp($subject));
}
echo "\n";
foreach ($addresses as string $subject) {
    echo Show::of(Core\Validate::isIp($subject, {version: 4}));
}
echo "\n";
foreach ($addresses as string $subject) {
    echo Show::of(Core\Validate::isIp($subject, {version: 6}));
}
echo "\n";

array<string> $macs = [
    "01:23:45:67:89:ab",
    "01-23-45-67-89-AB",
    "01:23:45:67:89",
    "01:23:45:67:89:ab:cd",
    "gg:23:45:67:89:ab",
    "",
];
foreach ($macs as string $subject) {
    echo Show::of(Core\Validate::isMac($subject));
}
echo "\n";
--ORACLE--
<?php
function show(bool $answer): string {
    return $answer ? "1" : "0";
}

$emails = [
    "user@example.com",
    "user.name+tag@example.co.uk",
    "a@b",
    "user@",
    "@example.com",
    "user example.com",
    "",
    "user@example..com",
];
foreach ($emails as $subject) {
    echo show(filter_var($subject, FILTER_VALIDATE_EMAIL) !== false);
}
echo "\n";

$domains = [
    "example.com",
    "sub.example.com",
    "a",
    "-bad.example",
    "example-.com",
    "exa mple.com",
    "",
];
foreach ($domains as $subject) {
    echo show(filter_var($subject, FILTER_VALIDATE_DOMAIN, FILTER_FLAG_HOSTNAME) !== false);
}
echo "\n";

$addresses = [
    "127.0.0.1",
    "255.255.255.255",
    "0.0.0.0",
    "256.1.1.1",
    "1.2.3",
    "1.2.3.4.5",
    "::1",
    "2001:db8::1",
    "2001:db8:::1",
    "",
];
foreach ($addresses as $subject) {
    echo show(filter_var($subject, FILTER_VALIDATE_IP) !== false);
}
echo "\n";
foreach ($addresses as $subject) {
    echo show(filter_var($subject, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4) !== false);
}
echo "\n";
foreach ($addresses as $subject) {
    echo show(filter_var($subject, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6) !== false);
}
echo "\n";

$macs = [
    "01:23:45:67:89:ab",
    "01-23-45-67-89-AB",
    "01:23:45:67:89",
    "01:23:45:67:89:ab:cd",
    "gg:23:45:67:89:ab",
    "",
];
foreach ($macs as $subject) {
    echo show(filter_var($subject, FILTER_VALIDATE_MAC) !== false);
}
echo "\n";
