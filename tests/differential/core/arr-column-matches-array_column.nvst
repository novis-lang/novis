--TEST--
Core\Arr::column skips, appends and collapses the rows array_column skips, appends and collapses, and reads one cell for both spellings of a numeral
--FILE--
<?nvs
// Spec § 2's `column` against its twin. Every row of the subject below is a
// boundary rather than an ordinary one: a row that has no cell to take, a row
// that has the cell but nothing to key it by, and a row whose key was already
// used. The member's reference card states all three in one sentence, and each
// of them is a place an implementation can be plausible on its own line while
// disagreeing with PHP — a missing `indexBy` cell could as easily have been a
// skip as an append, and only the count and the position say which happened.
final class Render {
    public static function of(array<string> $a): string {
        var $out = "";
        foreach ($a as string $k => string $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<array<string>> $rows = [
    ["id" => "7", "name" => "ann"],
    ["id" => "8", "name" => "bob"],
    ["name" => "cy"],
    ["id" => "8", "name" => "dee"],
];

// With no `indexBy` the result is a list: every row that has the cell, in row
// order, under fresh integer keys — the row with no `id` still has a `name` and
// is therefore *not* the one that gets skipped here.
echo Render::of(Core\Arr::column($rows, "name")), "\n";

// Keyed by a cell one row does not have. `cy` lands under the next free integer
// key rather than being dropped, and it lands there *after* the rows that
// preceded it; `dee` collapses onto `bob`'s key, keeping that key's position
// rather than moving to the end.
echo Render::of(Core\Arr::column($rows, "name", {indexBy: "id"})), "\n";

// Taking the cell one row lacks: that row is skipped outright, so three of the
// four survive and the count is the assertion.
echo Core\Arr::count(Core\Arr::column($rows, "id")), "|", Render::of(Core\Arr::column($rows, "id")), "\n";

// `0` and `"0"` name one cell, exactly as `$row[0]` and `$row["0"]` do, so both
// spellings read the same value out of the same row.
array<array<string>> $indexed = [["0" => "zero", "1" => "one"]];
echo Render::of(Core\Arr::column($indexed, 0)), "|", Render::of(Core\Arr::column($indexed, "0")), "\n";

// No rows yields no cells rather than one empty one.
array<array<string>> $empty = [];
echo "[", Render::of(Core\Arr::column($empty, "name")), "]\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$rows = [
    ["id" => "7", "name" => "ann"],
    ["id" => "8", "name" => "bob"],
    ["name" => "cy"],
    ["id" => "8", "name" => "dee"],
];

echo render(array_column($rows, "name")), "\n";

echo render(array_column($rows, "name", "id")), "\n";

echo count(array_column($rows, "id")), "|", render(array_column($rows, "id")), "\n";

$indexed = [["0" => "zero", "1" => "one"]];
echo render(array_column($indexed, 0)), "|", render(array_column($indexed, "0")), "\n";

$empty = [];
echo "[", render(array_column($empty, "name")), "]\n";
