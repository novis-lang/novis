--TEST--
Core\Math::intDiv truncates toward zero and refuses the two divisions intdiv refuses, and Core\Math::mod takes the sign of its dividend exactly as fmod does
--FILE--
<?mwl
// Spec § 3's `intDiv` and `mod` rows. The two members split what PHP spells
// with one function each: `intdiv` is the integer quotient and `fmod` the
// floating remainder, but `fmod` also accepts two `int`s and widens them,
// where `Core\Math::mod` is declared `float, float` and the integer remainder
// is the `%` operator. So the identity at the foot mixes a member and an
// operator here and two functions there, and that is the whole of the
// spelling difference — the answers are the same.
//
// The one place the two languages part is `Core\Math::mod`'s zero divisor,
// which is `math-mod-refuses-the-zero-divisor-fmod-answers-with-nan`.

final class Show {
    // `NAN` coerced to a string is a warning in PHP 8.4 and later, so neither
    // side renders one: a value that is not equal to itself is the only `NAN`
    // there is, and the sentinel is what both languages print instead.
    public static function real(float $value): string {
        if ($value == $value) {
            return $value as string;
        }
        return "nan";
    }
}

// The four sign quadrants of a truncating quotient. Truncation toward zero is
// what separates `intdiv` from a flooring division: a member that floored
// would answer `-4` to the second and third of these and is caught here alone.
echo Core\Math::intDiv(7, 2), " ", Core\Math::intDiv(-7, 2), " ", Core\Math::intDiv(7, -2), " ", Core\Math::intDiv(-7, -2), "\n";

// The magnitudes at which a quotient is zero, in both signs: truncation makes
// `-1 / 2` zero rather than `-1`, so a flooring member fails the middle entry
// while printing the outer two correctly.
echo Core\Math::intDiv(1, 2), " ", Core\Math::intDiv(-1, 2), " ", Core\Math::intDiv(0, 5), "\n";

// Both ends of `int`, divided by one. The asymmetric range is what makes the
// overflow row below a throw rather than a value.
echo Core\Math::intDiv(Core\Math::INT_MAX, 1), " ", Core\Math::intDiv(Core\Math::INT_MIN, 1), "\n";

// The two divisions that have no `int` answer, and both languages refuse both:
// a zero divisor, and `INT_MIN / -1`, whose exact quotient is one past `int`'s
// largest value. PHP raises `DivisionByZeroError` and `ArithmeticError`; MWL
// raises a `Fault::thrown`. The class differs, so what is asserted is that a
// `Throwable` handler reaches each of them, which is the observable both
// languages share.
try {
    var $undefined = Core\Math::intDiv(7, 0);
    echo "divided\n";
} catch (Throwable $byZero) {
    echo "refused\n";
}
try {
    var $unrepresentable = Core\Math::intDiv(Core\Math::INT_MIN, -1);
    echo "divided\n";
} catch (Throwable $overflow) {
    echo "refused\n";
}

// The four sign quadrants of the floating remainder, where the rule is the
// *dividend's* sign and not the divisor's — a member implementing Euclidean
// or floored modulo answers `0.5` to the second of these.
echo Core\Math::mod(7.5, 2.0), " ", Core\Math::mod(-7.5, 2.0), " ", Core\Math::mod(7.5, -2.0), " ", Core\Math::mod(-7.5, -2.0), "\n";

// A remainder that is exactly representable and one that is exactly zero: the
// two lengths at which a remainder can look right for the wrong reason.
echo Core\Math::mod(7.0, 2.0), " ", Core\Math::mod(4.0, 2.0), "\n";

// A zero dividend keeps its own sign through the remainder, on both sides —
// which is the row that says neither language normalizes `-0.0` away.
echo Core\Math::mod(0.0, 3.0), " ", Core\Math::mod(-0.0, 3.0), "\n";

// The three IEEE rows this module's docs keep at IEEE's answer rather than
// turning into throws: an infinite dividend, and either operand a `NAN`. An
// infinite *divisor* is the one that answers the dividend unchanged.
float $nan = Core\Math::NAN;
float $huge = Core\Math::INFINITY;
echo Show::real(Core\Math::mod($huge, 2.0)), " ", Show::real(Core\Math::mod($nan, 2.0)), " ", Show::real(Core\Math::mod(2.0, $nan)), " ", Show::real(Core\Math::mod(2.0, $huge)), "\n";

// The identity that ties the quotient to the remainder — `intDiv($a, $b) * $b
// + $a % $b == $a` — asserted by *counting* over every ordered pair drawn from
// one table with a zero divisor skipped, so a member answering plausibly row
// by row above still fails. Both counts are printed: a sweep that silently
// stopped short would otherwise agree with itself.
array<int> $values = [-7, -1, 0, 1, 7, 13];
int $held = 0;
int $seen = 0;
foreach ($values as int $a) {
    foreach ($values as int $b) {
        if ($b != 0) {
            $seen = $seen + 1;
            if (Core\Math::intDiv($a, $b) * $b + $a % $b == $a) {
                $held = $held + 1;
            }
        }
    }
}
echo $held, " ", $seen, "\n";
--ORACLE--
<?php
function real(float $value): string {
    if ($value == $value) {
        return (string) $value;
    }
    return "nan";
}

echo intdiv(7, 2), " ", intdiv(-7, 2), " ", intdiv(7, -2), " ", intdiv(-7, -2), "\n";

echo intdiv(1, 2), " ", intdiv(-1, 2), " ", intdiv(0, 5), "\n";

echo intdiv(PHP_INT_MAX, 1), " ", intdiv(PHP_INT_MIN, 1), "\n";

try {
    $undefined = intdiv(7, 0);
    echo "divided\n";
} catch (Throwable $byZero) {
    echo "refused\n";
}
try {
    $unrepresentable = intdiv(PHP_INT_MIN, -1);
    echo "divided\n";
} catch (Throwable $overflow) {
    echo "refused\n";
}

echo fmod(7.5, 2.0), " ", fmod(-7.5, 2.0), " ", fmod(7.5, -2.0), " ", fmod(-7.5, -2.0), "\n";

echo fmod(7.0, 2.0), " ", fmod(4.0, 2.0), "\n";

echo fmod(0.0, 3.0), " ", fmod(-0.0, 3.0), "\n";

$nan = NAN;
$huge = INF;
echo real(fmod($huge, 2.0)), " ", real(fmod($nan, 2.0)), " ", real(fmod(2.0, $nan)), " ", real(fmod(2.0, $huge)), "\n";

$values = [-7, -1, 0, 1, 7, 13];
$held = 0;
$seen = 0;
foreach ($values as $a) {
    foreach ($values as $b) {
        if ($b != 0) {
            $seen = $seen + 1;
            if (intdiv($a, $b) * $b + $a % $b == $a) {
                $held = $held + 1;
            }
        }
    }
}
echo $held, " ", $seen, "\n";
