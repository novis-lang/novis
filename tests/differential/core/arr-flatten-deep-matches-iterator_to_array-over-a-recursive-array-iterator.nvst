--TEST--
Core\Arr::flattenDeep answers what iterator_to_array over a RecursiveIteratorIterator answers, at every depth, over both kinds of key, and on the leaves that look like absence — `rule:types/preserve-keys`, `rule:types/grammar`
--FILE--
<?nvs
// Spec § 2's `flattenDeep` row, whose **Replaces** column names
// `iterator_to_array(new RecursiveIteratorIterator(new RecursiveArrayIterator($a)), false)`.
//
// This is an *agreement* case and not the divergence its `Core\Arr` neighbours
// are, and the second argument is why. Every other member carrying a key rule —
// `reverse`, `slice`, `pad`, `replaceRange` — parts from its twin because PHP
// renumbers a result's integer keys and keeps its string ones, which `rule:types/preserve-keys`
// refuses. The twin here is handed `false`, which discards every key alike,
// so PHP is asked for exactly the rule Novis has. Its *other* setting is not a
// second answer to compare against: `true` re-keys each leaf by its own level's
// key, so `[[1,2],[3,4]]` collapses to `[3,4]` and a string-keyed subject to
// `{"a":1,"c":2,"0":3}` — the twin loses entries at the setting that keeps
// keys, which is the concrete form of the rule `rule:types/preserve-keys` states abstractly.
//
// The answer is rendered through `Core\Json::encode`, not element by element:
// the member erases to `array<mixed>` (`rule:types/grammar`'s one unchecked position,
// and the member's own doc comment says why the honest type cannot be
// narrower), so there is no element binding a `foreach` could declare, and
// encoding the whole result is byte-identical to `json_encode` over PHP's.

// A table swept twice: once for the order of the leaves, and once for the claim
// that flattening an already-flat answer changes nothing. The second is counted
// rather than printed, so a member that answered plausibly on every printed line
// while re-nesting one of them still fails here.
array<array<mixed>> $rows = [
    [[1, 2], [3, 4]],
    [1, [2, [3, [4, [5]]]]],
    [],
    [[], []],
    [[[]], 1],
    ["a" => 1, "b" => ["c" => 2, "d" => [3]]],
    [1, "two", true, null, 1.5],
    [[1, 2], 3, [[4], [5, [6]]]],
];
int $idempotent = 0;
int $seen = 0;
foreach ($rows as array<mixed> $row) {
    $seen = $seen + 1;
    var $once = Core\Json::encode(Core\Arr::flattenDeep($row));
    var $twice = Core\Json::encode(Core\Arr::flattenDeep(Core\Arr::flattenDeep($row)));
    if ($once == $twice) {
        $idempotent = $idempotent + 1;
    }
    echo $once, "\n";
}
echo $seen, " rows, ", $idempotent, " idempotent\n";

// The rows above already pin the two shapes an empty level can take — a level
// with nothing in it contributes nothing on either side, and it does not
// contribute a hole either, so `[[],[]]` is empty and `[[[]],1]` is one entry.

// A leaf that looks like absence is still a leaf. `0`, `""`, `false` and `null`
// are the four values a walk written around truthiness would drop, and the
// count is asserted beside the rendering because JSON spells two of them the
// same width as nothing at all.
array<mixed> $falsy = [0, "", false, null, [0, [""]]];
echo Core\Json::encode(Core\Arr::flattenDeep($falsy)), "\n";
echo Core\Arr::count(Core\Arr::flattenDeep($falsy)), "\n";

// Depth is the caller's data, which is why the member walks an explicit stack
// instead of recursing. Three hundred levels around a single leaf is well past
// any nesting a hand-written recursive walk would survive, and both languages
// answer the one leaf.
array<mixed> $chain = [1];
foreach (Core\Arr::range(1, 300) as int $i) {
    $chain = [$chain];
}
echo Core\Json::encode(Core\Arr::flattenDeep($chain)), "\n";
echo Core\Arr::count(Core\Arr::flattenDeep($chain)), "\n";

// `flatten` and `flattenDeep` are two members rather than one with a depth
// argument, so the place they must agree is a subject that is exactly two
// levels deep — where "one level" and "all of them" name the same walk. Asked
// of three subjects and counted, since either member answering its own way on
// a single line still reads correctly.
array<array<int>> $pairs = [[1, 2], [3], [], [4, 5, 6]];
array<array<int>> $emptyPair = [[], []];
array<array<int>> $singleton = [[7]];
int $agree = 0;
if (Core\Json::encode(Core\Arr::flatten($pairs)) == Core\Json::encode(Core\Arr::flattenDeep($pairs))) {
    $agree = $agree + 1;
}
if (Core\Json::encode(Core\Arr::flatten($emptyPair)) == Core\Json::encode(Core\Arr::flattenDeep($emptyPair))) {
    $agree = $agree + 1;
}
if (Core\Json::encode(Core\Arr::flatten($singleton)) == Core\Json::encode(Core\Arr::flattenDeep($singleton))) {
    $agree = $agree + 1;
}
echo Core\Json::encode(Core\Arr::flatten($pairs)), " ", $agree, " of 3 agree\n";

// The subject is untouched by any of it.
echo Core\Json::encode($pairs), "\n";
--ORACLE--
<?php
function flat(array $a): array {
    return iterator_to_array(new RecursiveIteratorIterator(new RecursiveArrayIterator($a)), false);
}

$rows = [
    [[1, 2], [3, 4]],
    [1, [2, [3, [4, [5]]]]],
    [],
    [[], []],
    [[[]], 1],
    ["a" => 1, "b" => ["c" => 2, "d" => [3]]],
    [1, "two", true, null, 1.5],
    [[1, 2], 3, [[4], [5, [6]]]],
];
$idempotent = 0;
$seen = 0;
foreach ($rows as $row) {
    $seen = $seen + 1;
    $once = json_encode(flat($row));
    $twice = json_encode(flat(flat($row)));
    if ($once == $twice) {
        $idempotent = $idempotent + 1;
    }
    echo $once, "\n";
}
echo $seen, " rows, ", $idempotent, " idempotent\n";

$falsy = [0, "", false, null, [0, [""]]];
echo json_encode(flat($falsy)), "\n";
echo count(flat($falsy)), "\n";

$chain = [1];
foreach (range(1, 300) as $i) {
    $chain = [$chain];
}
echo json_encode(flat($chain)), "\n";
echo count(flat($chain)), "\n";

$pairs = [[1, 2], [3], [], [4, 5, 6]];
$emptyPair = [[], []];
$singleton = [[7]];
$agree = 0;
if (json_encode(array_merge(...$pairs)) == json_encode(flat($pairs))) {
    $agree = $agree + 1;
}
if (json_encode(array_merge(...$emptyPair)) == json_encode(flat($emptyPair))) {
    $agree = $agree + 1;
}
if (json_encode(array_merge(...$singleton)) == json_encode(flat($singleton))) {
    $agree = $agree + 1;
}
echo json_encode(array_merge(...$pairs)), " ", $agree, " of 3 agree\n";

echo json_encode($pairs), "\n";
