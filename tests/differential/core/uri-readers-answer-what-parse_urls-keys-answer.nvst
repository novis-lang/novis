--TEST--
Core\Uri's eight readers answer component for component what parse_url's array keys answer, over absolute references, relative ones and the schemes with no authority — and both report rather than normalize, spec § 12's first table
--FILE--
<?nvs
// Spec § 12: `parse` reads RFC 3986 and *reports* — every component comes back
// as it was written, still percent-encoded, still in its own case, dot segments
// still in the path — which is `parse_url`'s contract too, and the reason both
// are the right thing to compare an allowlist against. What the readers are is
// `parse_url`'s keys with the two differences that array cannot express, and
// only one of those is visible here: `userInfo()` is one reader where PHP has a
// `user` and a `pass` key, so the twin reassembles it. The other — `host()`
// answering `""` for an authority that was written empty — has no key at all on
// PHP's side and is its own case,
// `uri-reports-an-empty-authority-where-parse_url-omits-the-key`.
final class Show {
    public static function opt(?string $value): string {
        if ($value == null) {
            return "-";
        }
        return $value;
    }

    public static function port(?int $value): string {
        if ($value == null) {
            return "-";
        }
        return $value as string;
    }

    public static function of(string $reference): string {
        var $uri = Core\Uri::parse($reference);
        return Show::opt($uri->scheme())
            . "|" . Show::opt($uri->userInfo())
            . "|" . Show::opt($uri->host())
            . "|" . Show::port($uri->port())
            . "|" . $uri->path()
            . "|" . Show::opt($uri->query())
            . "|" . Show::opt($uri->fragment());
    }
}

// Every component present at once, then each one dropped in turn, so an absent
// component is distinguished from an empty one on both sides.
array<string> $references = [
    "https://user:pw@example.com:8443/a/b?x=1&y=2#frag",
    "https://user@example.com/a",
    "https://example.com:8443/a",
    "https://example.com/a?x=1",
    "https://example.com/a#frag",
    "https://example.com",
    "//example.com/a",
    "/a/b?c=d#e",
    "a/b",
    "mailto:someone@example.com",
    "urn:isbn:0451450523",
];

foreach ($references as string $reference) {
    echo Show::of($reference), "\n";
}

// Reporting rather than normalizing, which is the property an allowlist check
// depends on: the scheme and host keep the case they were written in, a `%XX`
// escape is not decoded and not case-folded, and the dot segments stay in the
// path. RFC 3986 § 5.2.4 removes those at `$uri->resolve` and § 6.2.2's folding
// happens at `$uri->compareTo`, neither of which is a reader.
array<string> $verbatim = [
    "HTTPS://EXAMPLE.COM/A/B",
    "https://example.com/%7euser/%2F",
    "https://example.com/a/./b/../c",
    "https://example.com//a//b",
];

foreach ($verbatim as string $reference) {
    echo Show::of($reference), "\n";
}
--ORACLE--
<?php
function opt(?string $value): string {
    return $value !== null ? $value : "-";
}

function show(string $reference): string {
    $parts = parse_url($reference);
    $userInfo = $parts['user'] ?? null;
    if ($userInfo !== null && isset($parts['pass'])) {
        $userInfo = $userInfo . ":" . $parts['pass'];
    }
    $port = isset($parts['port']) ? (string) $parts['port'] : "-";
    return opt($parts['scheme'] ?? null)
        . "|" . opt($userInfo)
        . "|" . opt($parts['host'] ?? null)
        . "|" . $port
        . "|" . ($parts['path'] ?? "")
        . "|" . opt($parts['query'] ?? null)
        . "|" . opt($parts['fragment'] ?? null);
}

$references = [
    "https://user:pw@example.com:8443/a/b?x=1&y=2#frag",
    "https://user@example.com/a",
    "https://example.com:8443/a",
    "https://example.com/a?x=1",
    "https://example.com/a#frag",
    "https://example.com",
    "//example.com/a",
    "/a/b?c=d#e",
    "a/b",
    "mailto:someone@example.com",
    "urn:isbn:0451450523",
];

foreach ($references as $reference) {
    echo show($reference), "\n";
}

$verbatim = [
    "HTTPS://EXAMPLE.COM/A/B",
    "https://example.com/%7euser/%2F",
    "https://example.com/a/./b/../c",
    "https://example.com//a//b",
];

foreach ($verbatim as $reference) {
    echo show($reference), "\n";
}
