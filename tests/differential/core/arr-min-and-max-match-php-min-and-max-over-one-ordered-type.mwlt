--TEST--
Core\Arr::min and max answer what PHP's min and max answer wherever a subject's values share one ordered type, ties and the extreme's position included
--FILE--
<?mwl
// Spec § 2's `min`/`max` rows, in the array form — PHP's variadic `min(1, 2, 3)`
// has no member at all (ADR 0063 R17), so the array argument is the whole
// overlap between the two.
//
// The two members do not ask the same question. PHP compares with `<`, the
// loose comparison, so what it orders depends on how a value is *written*;
// `Core\Arr::min` orders by `mwl_stdlib::ordering::compare_values`, the same
// total order `Core\Arr::sort` uses without a comparator. Those two coincide
// exactly where every value shares one ordered type and no string is a numeral,
// which is every subject in this case.
// `arr-min-and-max-diverge-from-php-over-an-empty-mixed-or-numeric-string-subject`
// is where they part.
//
// ADR 0069 § 3's key rule cannot bite here, unusually for a `Core\Arr` member:
// both members answer a *value*, so there is no result array whose integer keys
// either language could renumber. That is what lets a map be an agreeing row
// below rather than a second, diverging case.
//
// Both members answer `?T` where PHP's answer is never null, so absence is
// rendered as `none` on both sides — the same shape
// `arr-find-and-find-key-match-array_find-and-array_find_key` uses, and the
// reason the empty subject is the *other* case's row rather than this one's.
final class Show {
    public static function num(?int $found): string {
        if ($found == null) {
            return "none";
        }
        // The checker does not carry the `== null` guard into the binding's
        // type (E0403), so the conversion — total in this branch — is what
        // states the narrowing.
        return $found as string;
    }

    public static function text(?string $found): string {
        if ($found == null) {
            return "none";
        }
        return $found as string;
    }

    public static function real(?float $found): string {
        if ($found == null) {
            return "none";
        }
        return $found as string;
    }

    public static function number(int|float|null $found): string {
        if ($found == null) {
            return "none";
        }
        return $found as string;
    }
}

// The ordinary subject: neither extreme is at an end, and `1` occurs twice, so
// a member that answered the *last* tie rather than the first still prints this
// row correctly and is caught by the equal-values row further down.
array<int> $ints = [3, 1, 4, 1, 5];
echo Show::num(Core\Arr::min($ints)), " ", Show::num(Core\Arr::max($ints)), "\n";

// The extreme at each end in turn. A walk that skipped its first entry prints
// plausibly against the row above and against one of these, never both.
array<int> $lowFirst = [1, 5, 9];
array<int> $lowLast = [9, 5, 1];
echo Show::num(Core\Arr::min($lowFirst)), Show::num(Core\Arr::max($lowFirst)), " ", Show::num(Core\Arr::min($lowLast)), Show::num(Core\Arr::max($lowLast)), "\n";

// The two lengths at which an extreme can look right for the wrong reason:
// nothing to compare against, and every comparison equal. `min` and `max` must
// agree with each other on both.
array<int> $one = [7];
array<int> $same = [4, 4, 4];
echo Show::num(Core\Arr::min($one)), Show::num(Core\Arr::max($one)), " ", Show::num(Core\Arr::min($same)), Show::num(Core\Arr::max($same)), "\n";

// Zero and a negative in one subject, which is the row a member comparing
// magnitudes rather than values fails.
array<int> $signed = [-2, 0, 5];
echo Show::num(Core\Arr::min($signed)), " ", Show::num(Core\Arr::max($signed)), "\n";

// Strings, where PHP's `<` falls back to `strcmp` and MWL's ordering is
// bytewise: the same answer, as long as no operand is a numeral.
array<string> $words = ["pear", "apple", "fig"];
echo Show::text(Core\Arr::min($words)), " ", Show::text(Core\Arr::max($words)), "\n";

// Case is part of the byte sequence on both sides, so an upper-case initial
// sorts below every lower-case one.
array<string> $cased = ["ann", "Ann", "Bob"];
echo Show::text(Core\Arr::min($cased)), " ", Show::text(Core\Arr::max($cased)), "\n";

// A prefix and its extensions, the bound of a bytewise comparison: the shorter
// string is the smaller one, and length alone does not decide the larger.
array<string> $prefix = ["abc", "ab", "abcd"];
echo Show::text(Core\Arr::min($prefix)), " ", Show::text(Core\Arr::max($prefix)), "\n";

// Floats, where MWL's `f64::total_cmp` and PHP's `<` agree on every value that
// is neither a `NaN` nor a signed zero.
array<float> $reals = [2.5, 0.5, 1.5];
echo Show::real(Core\Arr::min($reals)), " ", Show::real(Core\Arr::max($reals)), "\n";

// The one pair of representations MWL's ordering lets cross, and the one PHP
// compares numerically rather than by spelling: an `int` and a `float` in one
// subject. The answer keeps its own type, which `echo` shows by rendering the
// `float` with its point and the `int` without.
array<int|float> $numbers = [2, 1.5, 3];
echo Show::number(Core\Arr::min($numbers)), " ", Show::number(Core\Arr::max($numbers)), "\n";

// A map. Both members answer a value, so the keys take no part at all — which
// is why this is an agreeing row and not the divergence every windowing member
// has over string keys.
array<int> $map = ["b" => 8, "a" => 2, "c" => 9];
echo Show::num(Core\Arr::min($map)), " ", Show::num(Core\Arr::max($map)), "\n";

// A gapped list, where both extremes of the original subject have been removed:
// the answer is over the entries that are live, not over the positions.
array<int> $gapped = [10, 20, 30, 40];
unset($gapped[0]);
unset($gapped[3]);
echo Show::num(Core\Arr::min($gapped)), " ", Show::num(Core\Arr::max($gapped)), "\n";

// The invariant that ties the member to the sort: `min` is the first entry of
// the sorted subject and `max` is its last, in both languages, because both
// order by the same comparison in both languages. A member that grew its own
// ordering answers plausibly on every row above and fails here.
echo Show::num(Core\Arr::first(Core\Arr::sort($ints))), Show::num(Core\Arr::last(Core\Arr::sort($ints))), " ", Show::text(Core\Arr::first(Core\Arr::sort($words))), Show::text(Core\Arr::last(Core\Arr::sort($words))), "\n";

// The subject is a value and no call touched it.
echo Show::num(Core\Arr::min($ints)), Show::num(Core\Arr::max($ints)), " ", Core\Arr::count($ints), "\n";
--ORACLE--
<?php
function show(mixed $found): string {
    if ($found === null) {
        return "none";
    }
    return (string) $found;
}

$ints = [3, 1, 4, 1, 5];
echo show(min($ints)), " ", show(max($ints)), "\n";

$lowFirst = [1, 5, 9];
$lowLast = [9, 5, 1];
echo show(min($lowFirst)), show(max($lowFirst)), " ", show(min($lowLast)), show(max($lowLast)), "\n";

$one = [7];
$same = [4, 4, 4];
echo show(min($one)), show(max($one)), " ", show(min($same)), show(max($same)), "\n";

$signed = [-2, 0, 5];
echo show(min($signed)), " ", show(max($signed)), "\n";

$words = ["pear", "apple", "fig"];
echo show(min($words)), " ", show(max($words)), "\n";

$cased = ["ann", "Ann", "Bob"];
echo show(min($cased)), " ", show(max($cased)), "\n";

$prefix = ["abc", "ab", "abcd"];
echo show(min($prefix)), " ", show(max($prefix)), "\n";

$reals = [2.5, 0.5, 1.5];
echo show(min($reals)), " ", show(max($reals)), "\n";

$numbers = [2, 1.5, 3];
echo show(min($numbers)), " ", show(max($numbers)), "\n";

$map = ["b" => 8, "a" => 2, "c" => 9];
echo show(min($map)), " ", show(max($map)), "\n";

$gapped = [10, 20, 30, 40];
unset($gapped[0]);
unset($gapped[3]);
echo show(min($gapped)), " ", show(max($gapped)), "\n";

$sortedInts = $ints;
sort($sortedInts);
$sortedWords = $words;
sort($sortedWords);
echo show(reset($sortedInts)), show(end($sortedInts)), " ", show(reset($sortedWords)), show(end($sortedWords)), "\n";

echo show(min($ints)), show(max($ints)), " ", count($ints), "\n";
