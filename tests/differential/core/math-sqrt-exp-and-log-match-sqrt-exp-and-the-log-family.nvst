--TEST--
Core\Math::sqrt, ::exp and ::log answer exactly what PHP's sqrt, exp and log do, including at the domain edges IEEE answers with NAN or an infinity, and ::log's base option folds log10 and log2 the same way PHP's second argument does
--FILE--
<?mwl
// Spec § 3's `sqrt`, `exp` and `log` rows. The first two are one PHP function
// each; `log` is three — `log`, `log10` and `log2` — folded into one member by
// a `{base?: float}` option whose default is `E`. So what this case asks is
// whether each default matches its twin, and what happens at the edges where
// the twin stops answering an ordinary number: a square root below zero, a
// logarithm of zero and of a negative, an exponential that overflows and one
// that underflows to a subnormal.
//
// The argument's domain is IEEE's on both sides — no guard anywhere in it.
// The *base's* domain is the one place a guard exists, and both languages have
// one: a base that is not greater than zero is refused rather than answered
// with the signed zero or the `NaN` that `ln($n) / ln($base)` would produce.
// PHP raises a `ValueError` and MWL a `Fault::thrown`, so what is asserted
// there is that a `Throwable` handler reaches it, exactly as
// `math-int-div-and-mod-match-intdiv-and-fmod` asserts its two refusals.

final class Show {
    // `NAN` coerced to a string is a warning in PHP 8.4 and later, so neither
    // side renders one: a value that is not equal to itself is the only `NAN`
    // there is, and the sentinel is what both languages print instead.
    public static function real(float $value): string {
        if ($value == $value) {
            return $value as string;
        }
        return "nan";
    }
}

float $huge = Core\Math::INFINITY;
float $nan = Core\Math::NAN;

// The square root over its ordinary domain, with both signed zeros. IEEE
// carries the sign of a zero through the root, so `sqrt(-0.0)` is `-0.0` and
// not `0.0` — the row that says neither language normalizes it away — and an
// infinite argument stays infinite rather than saturating.
echo Core\Math::sqrt(4.0), " ", Core\Math::sqrt(2.0), " ", Core\Math::sqrt(0.0), " ", Core\Math::sqrt(-0.0), " ", Core\Math::sqrt($huge), "\n";

// The one argument `sqrt` has no answer for. A member that guarded it — the
// way `mod` guards a zero divisor — would throw here and part from PHP, which
// answers `NAN`; it does not, and this is the row that says so.
echo Show::real(Core\Math::sqrt(-1.0)), " ", Show::real(Core\Math::sqrt($nan)), "\n";

// `exp` at the three points its answer is nameable, then at both ends of the
// range where it stops being one: `exp(710.0)` overflows to an infinity and
// `exp(-745.0)` underflows to the smallest subnormal `float` there is. Those
// two are also the sharpest rendering rows in this case — a subnormal printed
// at precision 14 is where two `float`-to-string routines would part company
// if they were going to.
echo Core\Math::exp(0.0), " ", Core\Math::exp(1.0), " ", Core\Math::exp(-1.0), " ", Core\Math::exp(710.0), " ", Core\Math::exp(-745.0), "\n";

// The default base is the natural logarithm, so `log(E)` is exactly `1` and
// `log(1.0)` exactly `0`. The two edges below them are the ones a guard would
// have taken away: zero is `-INF` and a negative is `NaN` on both sides.
echo Core\Math::log(1.0), " ", Core\Math::log(Core\Math::E), " ", Core\Math::log(0.0), " ", Core\Math::log($huge), "\n";
echo Show::real(Core\Math::log(-1.0)), " ", Show::real(Core\Math::log($nan)), "\n";

// The base option, folding the other two PHP functions in. Bases `10` and `2`
// take their own dedicated routine on both sides rather than the ratio, which
// is why these are the exact integers and not one unit in the last place off
// them; the sweep at the foot is what actually pins that. A base that is
// neither is the ratio, and a fractional base gives a negative logarithm.
echo Core\Math::log(100.0, {base: 10.0}), " ", Core\Math::log(1024.0, {base: 2.0}), " ", Core\Math::log(81.0, {base: 3.0}), " ", Core\Math::log(8.0, {base: 0.5}), "\n";

// Naming `E` explicitly is the same answer as leaving the option off, because
// PHP's ratio divides by `log(M_E)`, which is exactly `1.0`, where MWL takes
// the `ln` shortcut. Two routes, one value.
echo Core\Math::log(100.0, {base: Core\Math::E}), " ", Core\Math::log(100.0), "\n";

// The base's own domain. `1.0` is the base with no logarithm to give: the
// ratio divides by zero there and would answer an infinity whose sign came
// from the argument, so both languages answer `NAN` instead. A `NAN` base
// propagates and an infinite base flattens every argument to zero — neither
// is an error on either side.
echo Show::real(Core\Math::log(8.0, {base: 1.0})), " ", Show::real(Core\Math::log(8.0, {base: $nan})), " ", Core\Math::log(8.0, {base: $huge}), "\n";

// The two bases that are refused rather than answered. PHP raises a
// `ValueError`; MWL raises a `Fault::thrown`. The class differs, so what is
// asserted is that a `Throwable` handler reaches each of them.
try {
    var $atZero = Core\Math::log(8.0, {base: 0.0});
    echo "answered\n";
} catch (Throwable $zeroBase) {
    echo "refused\n";
}
try {
    var $atNegative = Core\Math::log(8.0, {base: -2.0});
    echo "answered\n";
} catch (Throwable $negativeBase) {
    echo "refused\n";
}

// The shortcut, asserted by *counting* rather than read off a line. Base `10`
// is `log10` and not `ln($n) / ln(10.0)`, and the two disagree on some of
// these rows and not others — which row is which does not matter here, only
// that both languages take the shortcut on the same rows. A member computing
// the ratio for base 10 would answer a different count while every line above
// still printed plausibly.
array<float> $tens = [1.0, 10.0, 100.0, 1000.0, 10000.0, 0.001, 7.0, 0.5];
int $sameAsRatio = 0;
int $ratioRows = 0;
foreach ($tens as float $n) {
    $ratioRows = $ratioRows + 1;
    if (Core\Math::log($n, {base: 10.0}) == Core\Math::log($n) / Core\Math::log(10.0)) {
        $sameAsRatio = $sameAsRatio + 1;
    }
}
echo $sameAsRatio, " ", $ratioRows, "\n";

// The two round trips, counted the same way: squaring then rooting, and
// exponentiating then taking the logarithm. Neither holds on every row — a
// `float` round trip is not an identity — and that is the point: both
// languages perform the same sequence of IEEE operations, so they lose the
// same bits on the same rows and the counts agree. All three are printed, so
// a sweep that silently stopped short cannot agree with itself.
array<float> $points = [0.0, 0.25, 0.5, 1.0, 2.0, 3.0, 10.0, 100.0];
int $sqrtHeld = 0;
int $logHeld = 0;
int $tripRows = 0;
foreach ($points as float $x) {
    $tripRows = $tripRows + 1;
    if (Core\Math::sqrt($x * $x) == $x) {
        $sqrtHeld = $sqrtHeld + 1;
    }
    if (Core\Math::log(Core\Math::exp($x)) == $x) {
        $logHeld = $logHeld + 1;
    }
}
echo $sqrtHeld, " ", $logHeld, " ", $tripRows, "\n";
--ORACLE--
<?php
function real(float $value): string {
    if ($value == $value) {
        return (string) $value;
    }
    return "nan";
}

$huge = INF;
$nan = NAN;

echo sqrt(4.0), " ", sqrt(2.0), " ", sqrt(0.0), " ", sqrt(-0.0), " ", sqrt($huge), "\n";

echo real(sqrt(-1.0)), " ", real(sqrt($nan)), "\n";

echo exp(0.0), " ", exp(1.0), " ", exp(-1.0), " ", exp(710.0), " ", exp(-745.0), "\n";

echo log(1.0), " ", log(M_E), " ", log(0.0), " ", log($huge), "\n";
echo real(log(-1.0)), " ", real(log($nan)), "\n";

echo log(100.0, 10.0), " ", log(1024.0, 2.0), " ", log(81.0, 3.0), " ", log(8.0, 0.5), "\n";

echo log(100.0, M_E), " ", log(100.0), "\n";

echo real(log(8.0, 1.0)), " ", real(log(8.0, $nan)), " ", log(8.0, $huge), "\n";

try {
    $atZero = log(8.0, 0.0);
    echo "answered\n";
} catch (Throwable $zeroBase) {
    echo "refused\n";
}
try {
    $atNegative = log(8.0, -2.0);
    echo "answered\n";
} catch (Throwable $negativeBase) {
    echo "refused\n";
}

$tens = [1.0, 10.0, 100.0, 1000.0, 10000.0, 0.001, 7.0, 0.5];
$sameAsRatio = 0;
$ratioRows = 0;
foreach ($tens as $n) {
    $ratioRows = $ratioRows + 1;
    if (log($n, 10.0) == log($n) / log(10.0)) {
        $sameAsRatio = $sameAsRatio + 1;
    }
}
echo $sameAsRatio, " ", $ratioRows, "\n";

$points = [0.0, 0.25, 0.5, 1.0, 2.0, 3.0, 10.0, 100.0];
$sqrtHeld = 0;
$logHeld = 0;
$tripRows = 0;
foreach ($points as $x) {
    $tripRows = $tripRows + 1;
    if (sqrt($x * $x) == $x) {
        $sqrtHeld = $sqrtHeld + 1;
    }
    if (log(exp($x)) == $x) {
        $logHeld = $logHeld + 1;
    }
}
echo $sqrtHeld, " ", $logHeld, " ", $tripRows, "\n";
