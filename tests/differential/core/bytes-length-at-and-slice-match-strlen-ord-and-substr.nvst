--TEST--
`Core\Bytes::length`, `::at` and `::slice` count, address and cut the same octets `strlen`, `ord` and `substr` do, over buffers holding the octets no text subject can carry (spec § 7, `rule:types/bytes` and `rule:types/string-is-utf8`)
--FILE--
<?nvs
// Spec § 7 pairs `Core\Bytes` with `Core\Str` by name and separates them by
// unit: `Core\Str::length` counts grapheme clusters, and the whole of
// `str-length-diverges-from-strlen` is that this is *not* PHP's answer. The
// binary counterpart is where PHP is the authority again, because an octet is
// an octet in both languages — so this file is the other half of that
// divergence, and the subjects are chosen to be exactly what a text subject
// cannot be: an isolated `0x00`, a lone continuation octet, and a buffer that
// is not valid UTF-8 anywhere.
//
// `at` answers a `uint` rather than a one-octet buffer (§ 7's second
// departure), which is `ord` on this side of the comparison and `$b[$i]` on
// PHP's.
array<string> $inputs = ["", "00", "0102030405", "89504e470d0a1a0a", "fffefd", "80808080"];

echo "length:";
foreach ($inputs as string $hex) {
    echo Core\Bytes::length(Core\Encoding::fromHex($hex)), "|";
}
echo "\n";

// Every octet of every buffer, addressed one index at a time. The empty
// buffer contributes no cell, which is the loop's own answer to a length of
// zero rather than a special case written into it.
int $index = 0;
echo "octets:";
foreach ($inputs as string $hex) {
    bytes $buffer = Core\Encoding::fromHex($hex);
    $index = 0;
    while ($index < Core\Bytes::length($buffer) as int) {
        echo Core\Bytes::at($buffer, $index), ".";
        $index = $index + 1;
    }
    echo "|";
}
echo "\n";

// The windows `substr` is asked for at each of its shapes: from the front
// with a width, from inside, to the end, the empty window, and from the back
// — where a start further back than the buffer is long clamps on both sides.
echo "slices:";
foreach ($inputs as string $hex) {
    bytes $cut = Core\Encoding::fromHex($hex);
    echo "[", Core\Encoding::toHex(Core\Bytes::slice($cut, 0, 2)), "]";
    echo "[", Core\Encoding::toHex(Core\Bytes::slice($cut, 1, 3)), "]";
    echo "[", Core\Encoding::toHex(Core\Bytes::slice($cut, 2, null)), "]";
    echo "[", Core\Encoding::toHex(Core\Bytes::slice($cut, 0, 0)), "]";
    echo "[", Core\Encoding::toHex(Core\Bytes::slice($cut, -3, null)), "]";
    echo "|";
}
echo "\n";

// The three members measure one buffer in one unit, asserted as a count. A
// `length` that answered characters, an `at` that answered a different index
// or a `slice` that cut in a different unit each print a plausible row above
// and fail here.
int $held = 0;
int $cells = 0;
foreach ($inputs as string $hex) {
    bytes $subject = Core\Encoding::fromHex($hex);
    $cells = $cells + 3;
    // Slicing the whole is the whole.
    if (Core\Bytes::compare(Core\Bytes::slice($subject, 0, null), $subject) == 0) {
        $held = $held + 1;
    }
    // A one-octet window at index i names the octet `at` names there, over
    // every index of the buffer.
    bool $agreed = true;
    $index = 0;
    while ($index < Core\Bytes::length($subject) as int) {
        if (Core\Bytes::compare(
            Core\Bytes::slice($subject, $index, 1),
            Core\Bytes::fill(1, Core\Bytes::at($subject, $index))
        ) != 0) {
            $agreed = false;
        }
        $index = $index + 1;
    }
    if ($agreed) {
        $held = $held + 1;
    }
    // The hex spelling counts two characters per octet `length` counted.
    if (Core\Str::length(Core\Encoding::toHex($subject)) as int == Core\Bytes::length($subject) as int * 2) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
--ORACLE--
<?php
$inputs = ["", "00", "0102030405", "89504e470d0a1a0a", "fffefd", "80808080"];

echo "length:";
foreach ($inputs as $hex) {
    echo strlen(hex2bin($hex)), "|";
}
echo "\n";

echo "octets:";
foreach ($inputs as $hex) {
    $buffer = hex2bin($hex);
    for ($index = 0; $index < strlen($buffer); $index++) {
        echo ord($buffer[$index]), ".";
    }
    echo "|";
}
echo "\n";

echo "slices:";
foreach ($inputs as $hex) {
    $buffer = hex2bin($hex);
    echo "[", bin2hex(substr($buffer, 0, 2)), "]";
    echo "[", bin2hex(substr($buffer, 1, 3)), "]";
    echo "[", bin2hex(substr($buffer, 2)), "]";
    echo "[", bin2hex(substr($buffer, 0, 0)), "]";
    echo "[", bin2hex(substr($buffer, -3)), "]";
    echo "|";
}
echo "\n";

$held = 0;
$cells = 0;
foreach ($inputs as $hex) {
    $subject = hex2bin($hex);
    $cells = $cells + 3;
    if (substr($subject, 0) === $subject) {
        $held = $held + 1;
    }
    $agreed = true;
    for ($index = 0; $index < strlen($subject); $index++) {
        if (substr($subject, $index, 1) !== chr(ord($subject[$index]))) {
            $agreed = false;
        }
    }
    if ($agreed) {
        $held = $held + 1;
    }
    if (strlen(bin2hex($subject)) === strlen($subject) * 2) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
