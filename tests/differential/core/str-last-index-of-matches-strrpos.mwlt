--TEST--
Core\Str::lastIndexOf matches strrpos and strripos, and its {before} bound is a search of the prefix (ADR 0063 R5, R20)
--FILE--
<?mwl
// The mirror of `str-index-of-matches-strpos`: absence is `null` here too, so
// both sides render it as `none` and what is compared is the position.
final class Show {
    public static function render(?uint $found): string {
        if ($found == null) {
            return "none";
        }
        return $found as string;
    }
}

// Occurrences may overlap, because the last occurrence of something is a
// question about positions and not about a partition — `strrpos` agrees, and
// `str-count-of-matches-substr_count` is where the same subject is counted
// instead and answers differently.
echo Show::render(Core\Str::lastIndexOf("abcabcabc", "abc")), "\n";
echo Show::render(Core\Str::lastIndexOf("aaa", "aa")), "\n";
echo Show::render(Core\Str::lastIndexOf("haystack", "h")), "\n";
echo Show::render(Core\Str::lastIndexOf("abcabcabc", "zz")), "\n";
echo Show::render(Core\Str::lastIndexOf("abcabcabc", "")), "\n";
echo Show::render(Core\Str::lastIndexOf("", "a")), "\n";

// {caseInsensitive} picks strripos over strrpos, exactly as it picks stripos
// over strpos on the forward member.
echo Show::render(Core\Str::lastIndexOf("aAaA", "a")), "\n";
echo Show::render(Core\Str::lastIndexOf("aAaA", "a", {caseInsensitive: true})), "\n";

// `before` names the end of the window — an occurrence counts only if it ends
// at or before that position — so its PHP twin is a search of the prefix of
// that length, and *not* `strrpos`'s own third argument, which bounds where a
// match may start. `str-index-of-out-of-range-from-diverges-from-strpos` is
// where that difference is stated on its own.
echo Show::render(Core\Str::lastIndexOf("abcabcabc", "abc", {before: 9})), "\n";
echo Show::render(Core\Str::lastIndexOf("abcabcabc", "abc", {before: 8})), "\n";
echo Show::render(Core\Str::lastIndexOf("abcabcabc", "abc", {before: 6})), "\n";
echo Show::render(Core\Str::lastIndexOf("abcabcabc", "abc", {before: 5})), "\n";
echo Show::render(Core\Str::lastIndexOf("abcabcabc", "abc", {before: 3})), "\n";
echo Show::render(Core\Str::lastIndexOf("abcabcabc", "abc", {before: 2})), "\n";
echo Show::render(Core\Str::lastIndexOf("abcabcabc", "abc", {before: 0})), "\n";
--ORACLE--
<?php
function render(int|false $found): string {
    if ($found === false) {
        return "none";
    }
    return (string) $found;
}

echo render(strrpos("abcabcabc", "abc")), "\n";
echo render(strrpos("aaa", "aa")), "\n";
echo render(strrpos("haystack", "h")), "\n";
echo render(strrpos("abcabcabc", "zz")), "\n";
echo render(strrpos("abcabcabc", "")), "\n";
echo render(strrpos("", "a")), "\n";

echo render(strrpos("aAaA", "a")), "\n";
echo render(strripos("aAaA", "a")), "\n";

echo render(strrpos(substr("abcabcabc", 0, 9), "abc")), "\n";
echo render(strrpos(substr("abcabcabc", 0, 8), "abc")), "\n";
echo render(strrpos(substr("abcabcabc", 0, 6), "abc")), "\n";
echo render(strrpos(substr("abcabcabc", 0, 5), "abc")), "\n";
echo render(strrpos(substr("abcabcabc", 0, 3), "abc")), "\n";
echo render(strrpos(substr("abcabcabc", 0, 2), "abc")), "\n";
echo render(strrpos(substr("abcabcabc", 0, 0), "abc")), "\n";
