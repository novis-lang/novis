--TEST--
Core\Math::abs, ::sign and ::clamp answer what abs, a spaceship against zero and min(max(...)) answer, at both bounds and on both sides of zero
--FILE--
<?nvs
// Spec § 3's three magnitude members against the spellings their **Replaces**
// column names — one function, one operator and one nested pair. Each keeps its
// argument's type here, so an `int` row and a `float` row are both asked: a
// member that went through a float would still print `3` for `abs(-3)` and is
// caught only where the two types render differently or where a bound is exact.
echo Core\Math::abs(-3), " ", Core\Math::abs(3), " ", Core\Math::abs(0), " ",
     Core\Math::abs(-2.5), " ", Core\Math::abs(2.5), " ", Core\Math::abs(-0.0), "\n";

// `sign` is the comparison against zero rather than a scaled value, so every
// magnitude collapses to one of three answers — the row a member returning the
// number's own sign bit would pass and a member returning the number would not.
echo Core\Math::sign(-5), " ", Core\Math::sign(0), " ", Core\Math::sign(5), " ",
     Core\Math::sign(-0.001), " ", Core\Math::sign(0.0), " ", Core\Math::sign(1000000.0), "\n";

// `clamp` below, inside and above its window, and then *at* each bound: a
// bound is inclusive, so a value equal to one is answered unchanged rather than
// being pushed to the other side of it.
echo Core\Math::clamp(-4, 0, 10), " ", Core\Math::clamp(5, 0, 10), " ", Core\Math::clamp(14, 0, 10), " ",
     Core\Math::clamp(0, 0, 10), " ", Core\Math::clamp(10, 0, 10), "\n";

// A window of one value answers that value for every argument, which is the
// degenerate bound both spellings have to agree on.
echo Core\Math::clamp(-4, 7, 7), " ", Core\Math::clamp(7, 7, 7), " ", Core\Math::clamp(99, 7, 7), "\n";

// The same window in floats, and one whose bounds are both negative — the row
// that says the member compares rather than taking a magnitude.
echo Core\Math::clamp(-2.5, -1.5, 1.5), " ", Core\Math::clamp(0.25, -1.5, 1.5), " ",
     Core\Math::clamp(2.5, -1.5, 1.5), " ", Core\Math::clamp(-9.0, -8.0, -2.0), "\n";
--ORACLE--
<?php
echo abs(-3), " ", abs(3), " ", abs(0), " ",
     abs(-2.5), " ", abs(2.5), " ", abs(-0.0), "\n";

echo (-5 <=> 0), " ", (0 <=> 0), " ", (5 <=> 0), " ",
     (-0.001 <=> 0), " ", (0.0 <=> 0), " ", (1000000.0 <=> 0), "\n";

echo min(max(-4, 0), 10), " ", min(max(5, 0), 10), " ", min(max(14, 0), 10), " ",
     min(max(0, 0), 10), " ", min(max(10, 0), 10), "\n";

echo min(max(-4, 7), 7), " ", min(max(7, 7), 7), " ", min(max(99, 7), 7), "\n";

echo min(max(-2.5, -1.5), 1.5), " ", min(max(0.25, -1.5), 1.5), " ",
     min(max(2.5, -1.5), 1.5), " ", min(max(-9.0, -8.0), -2.0), "\n";
