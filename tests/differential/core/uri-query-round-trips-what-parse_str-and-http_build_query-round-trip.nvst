--TEST--
Core\Uri::parseQuery and buildQuery round-trip a query string to the same text parse_str and http_build_query round-trip it to — the bracket convention at every depth, a repeated bare key, the empty value and the empty query
--FILE--
<?nvs
// Spec § 12: `parseQuery` reads PHP's bracket convention in full and
// `buildQuery` writes it. It is not a URL-spec feature — it is how every PHP
// form posts — so PHP is the specification here rather than a comparison, and
// the pair is compared as a *round trip* because that is the one shape whose
// two ends are both strings: `array<mixed>` is the return type precisely
// because a value is a `string` or another `array<mixed>`, and rendering that
// tree would be asserting a rendering rather than the convention.
//
// A round trip that agreed by both sides losing the same thing would still be
// wrong, which is why the subjects below carry a nesting depth, a list, a map
// and a mixed pair: a reader that flattened brackets would answer a visibly
// different string here.
array<string> $queries = [
    "a=1&b=2",
    "a[]=1&a[]=2",
    "a[b]=c&a[d]=e",
    "a[b][c]=d",
    "a[b][]=c&a[b][]=d",
    "a=1&a=2",
    "a",
    "a=",
    "a=hello+world",
    "a=hello%20world",
    "a%5Bb%5D=c",
    "x=1&y[z]=2&y[w][]=3",
    "",
];

foreach ($queries as string $query) {
    echo "[", Core\Uri::buildQuery(Core\Uri::parseQuery($query)), "]\n";
}
--ORACLE--
<?php
$queries = [
    "a=1&b=2",
    "a[]=1&a[]=2",
    "a[b]=c&a[d]=e",
    "a[b][c]=d",
    "a[b][]=c&a[b][]=d",
    "a=1&a=2",
    "a",
    "a=",
    "a=hello+world",
    "a=hello%20world",
    "a%5Bb%5D=c",
    "x=1&y[z]=2&y[w][]=3",
    "",
];

foreach ($queries as $query) {
    parse_str($query, $parsed);
    echo "[", http_build_query($parsed), "]\n";
}
