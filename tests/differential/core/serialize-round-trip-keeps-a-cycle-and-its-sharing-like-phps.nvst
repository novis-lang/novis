--TEST--
A round-trip through Core\Serialize keeps a cycle a cycle and keeps shared substructure shared, exactly as PHP's serialize/unserialize pair does
--FILE--
<?nvs
// ADR 0023 § 2's graph copy, against the one implementation PHP already has of
// the same operation. The wire formats are unrelated and neither side can read
// the other's bytes, so what is compared here is the *shape of the value that
// comes back* — which is the whole of what a caller can observe.
final class Node {
    public string $name;
    public Node $next;

    public function constructor(string $name) {
        $this->name = $name;
        $this->next = $this;
    }
}

// Two nodes pointing at each other: a copy that unrolled the cycle cannot be
// walked past its end, and one that collapsed the pair lands on the wrong name.
var $a = new Node("a");
var $b = new Node("b");
$a->next = $b;
$b->next = $a;

var $copy = Core\Serialize::decode(Core\Serialize::encode($a)) as Node;
echo $copy->name, $copy->next->name, $copy->next->next->name, $copy->next->next->next->name, "\n";

// The copy shares no mutable state with its source: a write through the copy's
// cycle moves the copy's node and leaves this side of the boundary alone.
$copy->next->next->name = "rewritten";
echo $copy->name, ",", $a->name, "\n";

// The self-cycle the ADR spells out by name, which the two-node walk above
// cannot tell apart from a bug.
var $self = new Node("self");
var $selfCopy = Core\Serialize::decode(Core\Serialize::encode($self)) as Node;
echo $selfCopy->next->next->next->name, "\n";
--ORACLE--
<?php
class Node {
    public string $name;
    public Node $next;

    public function __construct(string $name) {
        $this->name = $name;
        $this->next = $this;
    }
}

$a = new Node("a");
$b = new Node("b");
$a->next = $b;
$b->next = $a;

$copy = unserialize(serialize($a));
echo $copy->name, $copy->next->name, $copy->next->next->name, $copy->next->next->next->name, "\n";

$copy->next->next->name = "rewritten";
echo $copy->name, ",", $a->name, "\n";

$self = new Node("self");
$selfCopy = unserialize(serialize($self));
echo $selfCopy->next->next->next->name, "\n";
