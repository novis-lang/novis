--TEST--
Core\Arr::flip builds the entries array_flip builds, where a repeat keeps its first position and takes its last key
--FILE--
<?nvs
// Spec § 2's `flip` against its twin. The member's own reference card states
// the rule this case exists for as two halves that disagree — "a repeated value
// keeps its first position and takes its last key" — so a member that took the
// first key, or that moved the entry to the end where the repeat was, would
// still print plausibly against one half alone. Both halves are on one line
// below, and PHP answers the same way.
final class Render {
    public static function of(array<string> $a): string {
        var $out = "";
        foreach ($a as string $k => string $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

// The plain direction. Novis hands the old key back as a `string` and PHP as
// whatever type it held, which `echo` cannot tell apart — that is what makes
// these two lines comparable (`rule:types/arrays`).
array<int|string> $roles = ["ann" => "admin", "bob" => "guest"];
echo Render::of(Core\Arr::flip($roles)), "\n";

// The repeat: `1` appears first under `x` and last under `z`, so the entry is
// first and its value is the later key.
array<int|string> $repeat = ["x" => 1, "y" => 2, "z" => 1];
echo Render::of(Core\Arr::flip($repeat)), "\n";

// `1` and `"1"` become one key on both sides while `"01"` becomes its own, so
// the count is the assertion and the rendering is the reading: three values
// flip to two entries.
array<int|string> $spellings = ["a" => 1, "b" => "1", "c" => "01"];
echo Core\Arr::count(Core\Arr::flip($spellings)), "|", Render::of(Core\Arr::flip($spellings)), "\n";

// The empty string is a value like any other and becomes the empty key, which
// is why the row below has an `=` with nothing before it.
array<int|string> $blank = ["k" => ""];
echo "[", Render::of(Core\Arr::flip($blank)), "]\n";

// A list flips to its positions as values, so flipping is not an involution
// unless the values already were the positions — the second line is the same
// array back and the first is not.
array<int|string> $list = [10, 20];
echo Render::of(Core\Arr::flip($list)), "|", Render::of(Core\Arr::flip(Core\Arr::flip($list))), "\n";

// Nothing to flip yields nothing rather than one empty entry.
array<int|string> $empty = [];
echo "[", Render::of(Core\Arr::flip($empty)), "]\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$roles = ["ann" => "admin", "bob" => "guest"];
echo render(array_flip($roles)), "\n";

$repeat = ["x" => 1, "y" => 2, "z" => 1];
echo render(array_flip($repeat)), "\n";

$spellings = ["a" => 1, "b" => "1", "c" => "01"];
echo count(array_flip($spellings)), "|", render(array_flip($spellings)), "\n";

$blank = ["k" => ""];
echo "[", render(array_flip($blank)), "]\n";

$list = [10, 20];
echo render(array_flip($list)), "|", render(array_flip(array_flip($list))), "\n";

$empty = [];
echo "[", render(array_flip($empty)), "]\n";
