--TEST--
Core\Arr::firstKey and lastKey name the keys array_key_first and array_key_last name, as strings (ADR 0007 § 5, ADR 0069)
--FILE--
<?nvs
// ADR 0007 § 5 stores every key as a string, so these two answer `?string`
// where PHP's `array_key_first`/`array_key_last` answer `int|string|null`
// depending on how the key was written. `echo` cannot see that difference —
// PHP renders the int key `0` as `0` too — which is exactly why the difference
// is safe: a member that guessed a key's "original" type would be the
// key-type-dependent behaviour ADR 0069 removes. What the rows below compare is
// therefore *which* key, and `Core\Arr::keys`' `array<string>` is where the
// type itself is pinned.
class Show {
    public static function key(?string $found): string {
        if ($found == null) {
            return "none";
        }
        // `?string as string` rather than a bare `$found`: the checker does not
        // carry the `== null` guard into the type of the binding (E0403), so the
        // conversion — total in this branch, a throw in no other — is what
        // states the narrowing.
        return $found as string;
    }
}

array<int> $list = [10, 20, 30];
echo Show::key(Core\Arr::firstKey($list)), " ", Show::key(Core\Arr::lastKey($list)), "\n";

array<int> $map = ["y" => 2, "x" => 1];
echo Show::key(Core\Arr::firstKey($map)), " ", Show::key(Core\Arr::lastKey($map)), "\n";

// A gapped list keeps its keys, so both ends move and neither renumbers —
// `Core\Arr::values` is the member that renumbers, and it has its own case.
array<int> $gapped = [10, 20, 30, 40];
unset($gapped[0]);
unset($gapped[3]);
echo Show::key(Core\Arr::firstKey($gapped)), " ", Show::key(Core\Arr::lastKey($gapped)), "\n";

// An appended key continues the list's numbering rather than filling the hole.
$gapped[9] = 90;
echo Show::key(Core\Arr::firstKey($gapped)), " ", Show::key(Core\Arr::lastKey($gapped)), "\n";

array<int> $one = ["only" => 7];
echo Show::key(Core\Arr::firstKey($one)), " ", Show::key(Core\Arr::lastKey($one)), "\n";

// The empty array is the row where the two sides could have disagreed and do
// not: PHP's `array_key_*` answer `null` here, where its `reset`/`end` answer
// `false` — see `arr-first-and-last-match-reset-and-end`.
array<int> $empty = [];
echo Show::key(Core\Arr::firstKey($empty)), " ", Show::key(Core\Arr::lastKey($empty)), "\n";
--ORACLE--
<?php
function show(int|string|null $found): string {
    if ($found === null) {
        return "none";
    }
    return (string) $found;
}

$list = [10, 20, 30];
echo show(array_key_first($list)), " ", show(array_key_last($list)), "\n";

$map = ["y" => 2, "x" => 1];
echo show(array_key_first($map)), " ", show(array_key_last($map)), "\n";

$gapped = [10, 20, 30, 40];
unset($gapped[0]);
unset($gapped[3]);
echo show(array_key_first($gapped)), " ", show(array_key_last($gapped)), "\n";

$gapped[9] = 90;
echo show(array_key_first($gapped)), " ", show(array_key_last($gapped)), "\n";

$one = ["only" => 7];
echo show(array_key_first($one)), " ", show(array_key_last($one)), "\n";

$empty = [];
echo show(array_key_first($empty)), " ", show(array_key_last($empty)), "\n";
