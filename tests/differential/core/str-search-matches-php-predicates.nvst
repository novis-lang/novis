--TEST--
Core\Str::contains/startsWith/endsWith render exactly as PHP's str_contains/str_starts_with/str_ends_with
--FILE--
<?nvs
echo Core\Str::contains("haystack", "ays") as string, "|\n";
echo Core\Str::contains("haystack", "zzz") as string, "|\n";
echo Core\Str::contains("haystack", "") as string, "|\n";
echo Core\Str::startsWith("haystack", "hay") as string, "|\n";
echo Core\Str::startsWith("haystack", "stack") as string, "|\n";
echo Core\Str::endsWith("haystack", "stack") as string, "|\n";
echo Core\Str::endsWith("haystack", "hay") as string, "|\n";
--ORACLE--
<?php
echo str_contains("haystack", "ays"), "|\n";
echo str_contains("haystack", "zzz"), "|\n";
echo str_contains("haystack", ""), "|\n";
echo str_starts_with("haystack", "hay"), "|\n";
echo str_starts_with("haystack", "stack"), "|\n";
echo str_ends_with("haystack", "stack"), "|\n";
echo str_ends_with("haystack", "hay"), "|\n";
