--TEST--
Core\Db::execute answers the counts SQLite3::changes and SQLite3::lastInsertRowID answer, and query answers the rows fetchArray walks — `rule:core-classes/db-one-api` and `rule:core-classes/db-statement-members`
--FILE--
<?nvs
// `rule:core-classes/db-statement-members`'s `Write` carries two numbers, and on this backend both are
// read off the connection after the statement ran — SQLite's own rule, which
// `affected` departs from in one place only: a statement that changed no rows
// answers `0` rather than repeating the last data-changing statement's count.
// PHP's `SQLite3` reads the same two through `changes()` and
// `lastInsertRowID()`, and every statement below is one where the two agree.
use Core\Db;

var $db = Db::connect("main");

// A DDL statement changes no rows, so the count it inherits is 0 on both.
var $made = $db->execute("create table t (id integer primary key, name text not null)", []);
echo "created ", $made->affected(), "\n";

// § 1: there is no prepare step here and `SQLite3::prepare` is one, so what has
// to agree is the outcome of running the same statement with the same value
// bound, not the number of calls it took to get there.
var $ada = $db->execute("insert into t (name) values (?)", ["ada"]);
echo "inserted ", $ada->affected(), " at ", $ada->lastId() ?? 0, "\n";

var $grace = $db->execute("insert into t (name) values (?)", ["grace"]);
echo "inserted ", $grace->affected(), " at ", $grace->lastId() ?? 0, "\n";

// A multi-row write, so the count is something other than the 1 an insert would
// print whether it was read off the statement or invented.
var $renamed = $db->execute("update t set name = ? where id > ?", ["ada lovelace", 1]);
echo "updated ", $renamed->affected(), "\n";

// A write that matches nothing is 0 rather than an absence — the distinction
// `Write` keeps and `changes()` also makes.
var $none = $db->execute("delete from t where name = ?", ["nobody"]);
echo "deleted ", $none->affected(), "\n";

// § 4's read answers a materialized `Rows`, which is why it can be counted
// before it is walked; PHP's `SQLite3Result` is a cursor, so its own count is
// the array the loop below builds.
var $rows = $db->query("select id, name from t order by id", []);
echo "rows ", $rows->count(), "\n";
foreach ($rows->all() as Core\Db\Row $row) {
    echo "row ", $row->int("id") ?? -1, " ", $row->string("name") ?? "?", "\n";
}
--FILE nvs.toml--
# § 3: a SQLite connection's file path comes from its config block, so
# `db.connect` covers it.
[capabilities.db]
connect = ["main"]

[db.main]
driver = "sqlite"
path = ":memory:"
--ORACLE--
<?php
$db = new SQLite3(':memory:');

$db->exec("create table t (id integer primary key, name text not null)");
echo "created ", $db->changes(), "\n";

$insert = $db->prepare("insert into t (name) values (?)");
$insert->bindValue(1, "ada", SQLITE3_TEXT);
$insert->execute();
echo "inserted ", $db->changes(), " at ", $db->lastInsertRowID(), "\n";

$insert->reset();
$insert->bindValue(1, "grace", SQLITE3_TEXT);
$insert->execute();
echo "inserted ", $db->changes(), " at ", $db->lastInsertRowID(), "\n";

$rename = $db->prepare("update t set name = ? where id > ?");
$rename->bindValue(1, "ada lovelace", SQLITE3_TEXT);
$rename->bindValue(2, 1, SQLITE3_INTEGER);
$rename->execute();
echo "updated ", $db->changes(), "\n";

$drop = $db->prepare("delete from t where name = ?");
$drop->bindValue(1, "nobody", SQLITE3_TEXT);
$drop->execute();
echo "deleted ", $db->changes(), "\n";

$result = $db->query("select id, name from t order by id");
$all = [];
while ($row = $result->fetchArray(SQLITE3_ASSOC)) {
    $all[] = $row;
}
echo "rows ", count($all), "\n";
foreach ($all as $row) {
    echo "row ", $row['id'], " ", $row['name'], "\n";
}
