--TEST--
`Core\Hash\Stream` answers over every chunking of a subject what PHP's `hash_init`/`hash_update`/`hash_final` answer over the same chunking, and what the one-shot `Core\Hash::of` answers over the whole (spec § 11, `rule:types/bytes`)
--FILE--
<?nvs
// Spec § 11 gives the incremental digest three members where PHP gives it a
// `HashContext` and three functions. The property both shapes exist for is
// that the chunking is *invisible*: a digest is a function of the octets, not
// of how many times the caller handed them over. That is asserted here as a
// sweep — every chunk width against every subject — because a stream that
// mishandled a partial block would still print a correct digest for the one
// width that happens to align with it.
final class Show {
    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }

    // The whole of the streamed shape, so the three rows below differ only in
    // which construction they name.
    public static function chunked(string $s, uint $size, string $algo): string {
        if ($algo == "sha256") {
            var $stream = Core\Hash::stream(Core\Digest::Sha256);
            foreach (Core\Str::chunk($s, $size) as string $part) {
                $stream->update($part);
            }
            return Core\Encoding::toHex($stream->finish());
        }
        if ($algo == "sha3_256") {
            var $sponge = Core\Hash::stream(Core\Digest::Sha3_256);
            foreach (Core\Str::chunk($s, $size) as string $part) {
                $sponge->update($part);
            }
            return Core\Encoding::toHex($sponge->finish());
        }
        var $legacy = Core\Hash::stream(Core\Digest::Md5);
        foreach (Core\Str::chunk($s, $size) as string $part) {
            $legacy->update($part);
        }
        return Core\Encoding::toHex($legacy->finish());
    }
}

// The empty subject — where the stream is finished having been updated zero
// times, which is the edge PHP's own context has to get right too — a subject
// shorter than one chunk, the 56-octet vector whose padding needs a second
// SHA-256 block, and one longer than any width below so that every chunking
// leaves a partial tail.
array<string> $subjects = [
    "",
    "ab",
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    "The quick brown fox jumps over the lazy dog",
];

// One octet at a time, a width that divides nothing, the SHA-3-256 rate in
// octets minus one, and a width wider than two of the subjects.
array<uint> $widths = [1, 3, 7, 16, 68];

echo "sha256:";
foreach ($subjects as string $s) {
    foreach ($widths as uint $size) {
        echo Show::chunked($s, $size, "sha256"), "|";
    }
}
echo "\n";

echo "sha3_256:";
foreach ($subjects as string $s) {
    foreach ($widths as uint $size) {
        echo Show::chunked($s, $size, "sha3_256"), "|";
    }
}
echo "\n";

echo "md5:";
foreach ($subjects as string $s) {
    foreach ($widths as uint $size) {
        echo Show::chunked($s, $size, "md5"), "|";
    }
}
echo "\n";

// The agreement claim: every streamed answer above is the one-shot answer for
// the same subject. Counted rather than read off the rows, so a stream that
// agreed with itself across widths while diverging from `of` still fails.
int $held = 0;
int $cells = 0;
foreach ($subjects as string $s) {
    foreach ($widths as uint $size) {
        $cells = $cells + 3;
        if (Show::chunked($s, $size, "sha256")
            == Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha256))) {
            $held = $held + 1;
        }
        if (Show::chunked($s, $size, "sha3_256")
            == Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha3_256))) {
            $held = $held + 1;
        }
        if (Show::chunked($s, $size, "md5")
            == Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Md5))) {
            $held = $held + 1;
        }
    }
}
echo $held, " of ", $cells, "\n";

// A stream is consumed by its own `finish`, and two streams over one input
// are how a program takes two digests — the shape spec § 11 states because
// PHP's `HashContext` invalidates itself the same way.
var $first = Core\Hash::stream(Core\Digest::Sha256);
var $second = Core\Hash::stream(Core\Digest::Sha256);
$first->update("abc");
$second->update("abc");
echo Show::flag(Core\Encoding::toHex($first->finish()) == Core\Encoding::toHex($second->finish())), "\n";
--ORACLE--
<?php
function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

// `str_split` answers the empty list for the empty subject on PHP 8.2 and
// later, so the empty row streams zero updates on this side too rather than
// one update of "".
function chunked($s, $size, $algo) {
    $ctx = hash_init($algo);
    foreach (str_split($s, $size) as $part) {
        hash_update($ctx, $part);
    }
    return hash_final($ctx);
}

$subjects = [
    "",
    "ab",
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    "The quick brown fox jumps over the lazy dog",
];

$widths = [1, 3, 7, 16, 68];

$algos = ["sha256" => "sha256", "sha3_256" => "sha3-256", "md5" => "md5"];

foreach ($algos as $label => $algo) {
    echo $label, ":";
    foreach ($subjects as $s) {
        foreach ($widths as $size) {
            echo chunked($s, $size, $algo), "|";
        }
    }
    echo "\n";
}

$held = 0;
$cells = 0;
foreach ($subjects as $s) {
    foreach ($widths as $size) {
        $cells = $cells + 3;
        foreach ($algos as $algo) {
            if (chunked($s, $size, $algo) === hash($algo, $s)) {
                $held = $held + 1;
            }
        }
    }
}
echo $held, " of ", $cells, "\n";

$first = hash_init("sha256");
$second = hash_init("sha256");
hash_update($first, "abc");
hash_update($second, "abc");
echo flag(hash_final($first) === hash_final($second)), "\n";
