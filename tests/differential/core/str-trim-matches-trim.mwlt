--TEST--
Core\Str::trim/trimStart/trimEnd match PHP's trim/ltrim/rtrim on ASCII whitespace
--FILE--
<?mwl
echo "[", Core\Str::trim("  padded  "), "]\n";
echo "[", Core\Str::trimStart("  padded  "), "]\n";
echo "[", Core\Str::trimEnd("  padded  "), "]\n";
echo "[", Core\Str::trim("\n\tmixed \t\n"), "]\n";
echo "[", Core\Str::trim("nothing"), "]\n";
echo "[", Core\Str::trim("   "), "]\n";
--ORACLE--
<?php
echo "[", trim("  padded  "), "]\n";
echo "[", ltrim("  padded  "), "]\n";
echo "[", rtrim("  padded  "), "]\n";
echo "[", trim("\n\tmixed \t\n"), "]\n";
echo "[", trim("nothing"), "]\n";
echo "[", trim("   "), "]\n";
