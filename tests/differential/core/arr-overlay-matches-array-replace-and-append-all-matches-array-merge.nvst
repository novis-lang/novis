--TEST--
Core\Arr::overlay is PHP's array_replace and ::appendAll is its array_merge over lists, values and key order alike
--FILE--
<?nvs
array<int> $a = ["x" => 1, "y" => 2];
array<int> $b = ["y" => 9, "z" => 3];
array<int> $c = ["x" => 7];
echo Core\Json::encode(Core\Arr::overlay($a, $b)), ";";
echo Core\Json::encode(Core\Arr::overlay($a, $b, $c)), ";";
echo Core\Json::encode(Core\Arr::overlay($a)), ";";

array<string> $l = [0 => "zero", 1 => "one"];
array<string> $r = [1 => "ONE", 2 => "two"];
echo Core\Json::encode(Core\Arr::overlay($l, $r)), ";";

// `appendAll` is `array_merge` only where the arguments are lists — over a map
// PHP keeps the string keys and this discards them, which is the divergence
// ADR 0069 § 1 exists for and `tests/conformance/core` pins instead.
array<int> $ones = [1, 2, 3];
array<int> $twos = [4, 5];
array<int> $none = [];
echo Core\Json::encode(Core\Arr::appendAll($ones, $twos)), ";";
echo Core\Json::encode(Core\Arr::appendAll($ones, $none, $twos)), "\n";
--ORACLE--
<?php
$a = ["x" => 1, "y" => 2];
$b = ["y" => 9, "z" => 3];
$c = ["x" => 7];
echo json_encode(array_replace($a, $b)), ";";
echo json_encode(array_replace($a, $b, $c)), ";";
echo json_encode(array_replace($a)), ";";

$l = [0 => "zero", 1 => "one"];
$r = [1 => "ONE", 2 => "two"];
echo json_encode(array_replace($l, $r)), ";";

$ones = [1, 2, 3];
$twos = [4, 5];
$none = [];
echo json_encode(array_merge($ones, $twos)), ";";
echo json_encode(array_merge($ones, $none, $twos)), "\n";
