--TEST--
`Core\Hash::equals` answers over equal operands, operands differing in their first and in their last octet, and operands of different lengths what `hash_equals` answers, and is reflexive and symmetric across the whole corpus (spec § 11, `rule:types/bytes`, `rule:core-api/shape-rules` R17)
--FILE--
<?nvs
// The one member of `Core\Hash` that had no oracle file. Both sides are
// constant-time comparisons answering `bool`, so what PHP is the oracle for
// here is the *verdict* rather than the timing: which pairs compare equal,
// and — the part an implementation can get wrong while still printing
// plausible digests everywhere else — what happens when the two operands have
// different lengths. `hash_equals` answers `false` for that immediately
// instead of comparing the common prefix, and `nvs_core_hash_equals`'s own
// doc comment says Novis does the same, because a digest's length is a
// property of the algorithm and never a secret.
//
// The operands are built from hex rather than from `Core\Hash::of`, because
// that is the only way to name a pair differing in exactly one octet and to
// choose *which* octet. A comparison that short-circuits agrees with PHP on
// the equal pair and on the first-octet pair; the last-octet pair is the one
// that separates it from one that reads every octet.
final class Row {
    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

// A 32-octet subject — the width this member most often compares — and its
// three neighbours.
bytes $base = Core\Encoding::fromHex(Core\Str::repeat("ab", 32));
bytes $same = Core\Encoding::fromHex(Core\Str::repeat("ab", 32));
bytes $first = Core\Encoding::fromHex("cd" . Core\Str::repeat("ab", 31));
bytes $last = Core\Encoding::fromHex(Core\Str::repeat("ab", 31) . "cd");
// A prefix of `$base`: every octet the two share is equal, and the answer is
// still `false`. This is the length case, arriving in its hardest form.
bytes $prefix = Core\Encoding::fromHex(Core\Str::repeat("ab", 31));
bytes $empty = Core\Encoding::fromHex("");

echo "same:", Row::flag(Core\Hash::equals($base, $same)), "\n";
echo "self:", Row::flag(Core\Hash::equals($base, $base)), "\n";
echo "first:", Row::flag(Core\Hash::equals($base, $first)), "\n";
echo "last:", Row::flag(Core\Hash::equals($base, $last)), "\n";
echo "prefix:", Row::flag(Core\Hash::equals($base, $prefix)), "\n";
echo "prefix-reversed:", Row::flag(Core\Hash::equals($prefix, $base)), "\n";
echo "empty:", Row::flag(Core\Hash::equals($empty, $empty)), "\n";
echo "empty-against-base:", Row::flag(Core\Hash::equals($empty, $base)), "\n";

// Real digests, since that is what the member exists for: one subject hashed
// twice compares equal, a subject differing in one letter does not, and two
// algorithms over one subject are the different-length case arriving the way
// a program would actually meet it.
bytes $abc256 = Core\Hash::of("abc", Core\Digest::Sha256);
bytes $abd256 = Core\Hash::of("abd", Core\Digest::Sha256);
bytes $abc512 = Core\Hash::of("abc", Core\Digest::Sha512);
echo "digest-same:", Row::flag(Core\Hash::equals($abc256, Core\Hash::of("abc", Core\Digest::Sha256))), "\n";
echo "digest-other:", Row::flag(Core\Hash::equals($abc256, $abd256)), "\n";
echo "digest-widths:", Row::flag(Core\Hash::equals($abc256, $abc512)), "\n";

// Reflexive and symmetric over the whole corpus, counted rather than read off
// a line: a comparison that had grown an order dependence — a prefix rule, or
// a length check applied to one side only — answers plausibly on every row
// above and fails here.
array<bytes> $corpus = [$base, $first, $last, $prefix, $empty, $abc256, $abc512];
int $held = 0;
int $cells = 0;
foreach ($corpus as bytes $a) {
    $cells = $cells + 1;
    if (Core\Hash::equals($a, $a)) {
        $held = $held + 1;
    }
    foreach ($corpus as bytes $b) {
        $cells = $cells + 1;
        bool $ab = Core\Hash::equals($a, $b);
        bool $ba = Core\Hash::equals($b, $a);
        if ($ab) {
            if ($ba) {
                $held = $held + 1;
            }
        } else {
            if (!$ba) {
                $held = $held + 1;
            }
        }
    }
}
echo $held, " of ", $cells, "\n";

// The lengths the pairs above were built to have, so that a corpus that had
// silently normalized or padded its operands is a failing row rather than an
// invisible one.
echo "lengths:",
    Core\Bytes::length($base), "|",
    Core\Bytes::length($prefix), "|",
    Core\Bytes::length($empty), "|",
    Core\Bytes::length($abc256), "|",
    Core\Bytes::length($abc512), "|\n";
--ORACLE--
<?php
function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

$base = hex2bin(str_repeat("ab", 32));
$same = hex2bin(str_repeat("ab", 32));
$first = hex2bin("cd" . str_repeat("ab", 31));
$last = hex2bin(str_repeat("ab", 31) . "cd");
$prefix = hex2bin(str_repeat("ab", 31));
$empty = hex2bin("");

echo "same:", flag(hash_equals($base, $same)), "\n";
echo "self:", flag(hash_equals($base, $base)), "\n";
echo "first:", flag(hash_equals($base, $first)), "\n";
echo "last:", flag(hash_equals($base, $last)), "\n";
echo "prefix:", flag(hash_equals($base, $prefix)), "\n";
echo "prefix-reversed:", flag(hash_equals($prefix, $base)), "\n";
echo "empty:", flag(hash_equals($empty, $empty)), "\n";
echo "empty-against-base:", flag(hash_equals($empty, $base)), "\n";

$abc256 = hash("sha256", "abc", true);
$abd256 = hash("sha256", "abd", true);
$abc512 = hash("sha512", "abc", true);
echo "digest-same:", flag(hash_equals($abc256, hash("sha256", "abc", true))), "\n";
echo "digest-other:", flag(hash_equals($abc256, $abd256)), "\n";
echo "digest-widths:", flag(hash_equals($abc256, $abc512)), "\n";

$corpus = [$base, $first, $last, $prefix, $empty, $abc256, $abc512];
$held = 0;
$cells = 0;
foreach ($corpus as $a) {
    $cells = $cells + 1;
    if (hash_equals($a, $a)) {
        $held = $held + 1;
    }
    foreach ($corpus as $b) {
        $cells = $cells + 1;
        $ab = hash_equals($a, $b);
        $ba = hash_equals($b, $a);
        if ($ab) {
            if ($ba) {
                $held = $held + 1;
            }
        } else {
            if (!$ba) {
                $held = $held + 1;
            }
        }
    }
}
echo $held, " of ", $cells, "\n";

echo "lengths:";
echo strlen($base), "|";
echo strlen($prefix), "|";
echo strlen($empty), "|";
echo strlen($abc256), "|";
echo strlen($abc512), "|";
echo "\n";
