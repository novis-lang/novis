--TEST--
Core\Json::encode writes the document json_encode writes under JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE — every scalar, the escapes JSON requires and the ones neither writer adds, and the list-or-object choice both make from the keys alone, spec § 6
--FILE--
<?nvs
// Spec § 6's `encode` row names `json_encode` and its fifteen `JSON_*` flags as
// what it replaces; the neighbouring `json-decode-matches-json_decode-and-json_last_error`
// case asks what the *reader* built and uses this writer only to render it.
// What is asked here is the writer itself.
//
// The oracle's two flags are what makes this a comparison rather than a
// thaw: `Core\Json::encode`'s defaults are the compact document with UTF-8
// written through (`json.rs:192`), which `json_encode` spells with
// `JSON_UNESCAPED_UNICODE`, and Novis has no spelling at all for escaping `/`.
// That second one is a divergence rather than an agreement, and it is pinned
// in `json-encode-writes-the-slash-bare-and-indents-two-spaces-where-json_encode-escapes-it-and-indents-four`.
// The escaping `escapeUnicode: true` turns back on is
// `json-encode-escaping-unicode-matches-json_encodes-default-including-the-surrogate-pair`'s.

// Every scalar JSON can spell, including the two `false` values a writer is
// most likely to confuse with absence.
echo Core\Json::encode(null), "\n";
echo Core\Json::encode(true), "\n";
echo Core\Json::encode(false), "\n";
echo Core\Json::encode(0), "\n";
echo Core\Json::encode(42), "\n";
echo Core\Json::encode(-7), "\n";
echo Core\Json::encode(9223372036854775807), "\n";
echo Core\Json::encode(""), "\n";

// A float is written by whichever shortest-round-trip printer the two writers
// hold — ryu here, PHP's own `serialize_precision = -1` there — and over a
// fraction they agree digit for digit, including on a sum that has to keep
// every digit of the error it accumulated. The rows where they do not agree
// are the ones where the shortest spelling is an *integer*, and they are
// `json-encode-keeps-a-whole-numbered-floats-point-where-json_encode-drops-it`'s.
echo Core\Json::encode(0.5), "\n";
echo Core\Json::encode(-2.25), "\n";
echo Core\Json::encode(0.1 + 0.2), "\n";

// The escapes JSON *requires*: the quote, the backslash, and every byte below
// 0x20 — the named five and one that has no name and becomes a `\u00XX`.
echo Core\Json::encode("he said \"hi\""), "\n";
echo Core\Json::encode("a\\b"), "\n";
echo Core\Json::encode("tab\there"), "\n";
echo Core\Json::encode("line\nbreak"), "\n";
echo Core\Json::encode("ret\rurn"), "\n";
echo Core\Json::encode("\u{8}\u{c}"), "\n";
echo Core\Json::encode("nul\u{0}end"), "\n";
echo Core\Json::encode("unit\u{1f}sep"), "\n";

// And the ones neither writer adds. `<`, `>`, `&` and `'` are escaped by
// `json_encode` only under `JSON_HEX_TAG`, `JSON_HEX_AMP` and `JSON_HEX_APOS`,
// which have no Novis spelling because they are HTML's escaping done in the
// wrong layer — `rule:security/launderers-are-sink-named` puts that at the sink, in `Core\Html::escape`.
// DEL is 0x7f, above the band JSON requires escaped, so both writers leave it
// as the byte it is — and the terminal is a sink that would substitute it
// (ADR 0086), so both sides spell it out before echoing.
echo Core\Json::encode("<script>a && b</script>"), "\n";
echo Core\Json::encode("it's"), "\n";
echo Core\Str::replaceAll(Core\Json::encode("del\u{7f}end"), ["\u{7f}" => "<DEL>"]), "\n";

// UTF-8 written through, which is `JSON_UNESCAPED_UNICODE`: a two-byte code
// point, a three-byte one, and an astral one that is a surrogate pair only
// once something escapes it.
echo Core\Json::encode("caf\u{e9}"), "\n";
echo Core\Json::encode("\u{65e5}\u{672c}"), "\n";
echo Core\Json::encode("\u{1f600}"), "\n";

// Novis has one array type and JSON has two, so the choice is made from the
// keys — and both writers make it the same way. A list is a JSON array; the
// first key that is not the next index makes the whole thing an object,
// including a list whose keys arrived out of order and one with a hole in it.
echo Core\Json::encode([1, 2, 3]), "\n";
echo Core\Json::encode(["b" => 2, "a" => 1]), "\n";
echo Core\Json::encode(["0" => "a", "1" => "b"]), "\n";
echo Core\Json::encode(["1" => "a", "0" => "b"]), "\n";
echo Core\Json::encode(["0" => "a", "2" => "b"]), "\n";

// The empty array is the one shape neither writer can spell as `{}`: it is a
// list of nothing on both sides, and a JSON object with no keys is a document
// neither language's array type has a value for.
array<int> $empty = [];
echo Core\Json::encode($empty), "\n";

// Nesting, so the choice above is asked at a depth rather than only at the
// document's root, and so an empty array *inside* one is asked too.
echo Core\Json::encode([["a" => 1], ["a" => 2]]), "\n";
echo Core\Json::encode(["rows" => [1, 2], "none" => $empty]), "\n";
--ORACLE--
<?php
function e($value): string {
    return json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}

echo e(null), "\n";
echo e(true), "\n";
echo e(false), "\n";
echo e(0), "\n";
echo e(42), "\n";
echo e(-7), "\n";
echo e(9223372036854775807), "\n";
echo e(""), "\n";

echo e(0.5), "\n";
echo e(-2.25), "\n";
echo e(0.1 + 0.2), "\n";

echo e("he said \"hi\""), "\n";
echo e("a\\b"), "\n";
echo e("tab\there"), "\n";
echo e("line\nbreak"), "\n";
echo e("ret\rurn"), "\n";
echo e("\u{8}\u{c}"), "\n";
echo e("nul\u{0}end"), "\n";
echo e("unit\u{1f}sep"), "\n";

echo e("<script>a && b</script>"), "\n";
echo e("it's"), "\n";
echo strtr(e("del\u{7f}end"), ["\u{7f}" => "<DEL>"]), "\n";

echo e("caf\u{e9}"), "\n";
echo e("\u{65e5}\u{672c}"), "\n";
echo e("\u{1f600}"), "\n";

echo e([1, 2, 3]), "\n";
echo e(["b" => 2, "a" => 1]), "\n";
echo e(["0" => "a", "1" => "b"]), "\n";
echo e(["1" => "a", "0" => "b"]), "\n";
echo e(["0" => "a", "2" => "b"]), "\n";

$empty = [];
echo e($empty), "\n";

echo e([["a" => 1], ["a" => 2]]), "\n";
echo e(["rows" => [1, 2], "none" => $empty]), "\n";
