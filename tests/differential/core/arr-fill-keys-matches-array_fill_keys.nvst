--TEST--
Core\Arr::fillKeys keys the result by its argument's values exactly as array_fill_keys does, folding the spellings that name one key
--FILE--
<?nvs
// Spec § 2's `fillKeys` against its twin. The member reads its argument's
// *values* as the keys to create and ignores that argument's own keys, so the
// two rows below are the same call written over a list and over a map. The
// boundary worth pinning is that the values are normalised on the way in
// exactly as a subscript would be — `fill` next door has no keys to normalise
// at all, which is why that member's own case says nothing about this.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

// Every key spelling in one call: a name, an integer as text, the same integer
// as an integer, a leading zero that is not one, the empty string and a
// negative. Six values, five entries — the count is what says the fold took the
// one pair it should have and left the rest alone.
array<int|string> $keys = ["a", "1", 1, "01", "", -2];
echo Core\Arr::count(Core\Arr::fillKeys($keys, 0)), "|", Render::of(Core\Arr::fillKeys($keys, 0)), "\n";

// The argument's own keys are ignored, so a map produces exactly what the list
// of its values produces.
array<int|string> $mapped = ["p" => "x", "q" => "y"];
array<int|string> $flat = ["x", "y"];
echo Render::of(Core\Arr::fillKeys($mapped, 9)), "|", Render::of(Core\Arr::fillKeys($flat, 9)), "\n";

// A value written twice is one entry keeping its first position, which is the
// same rule `flip` follows for the same reason: the result is an array and an
// array has one entry per key.
array<int|string> $repeat = ["x", "y", "x"];
echo Core\Arr::count(Core\Arr::fillKeys($repeat, 1)), "|", Render::of(Core\Arr::fillKeys($repeat, 1)), "\n";

// No keys to create yields no entries rather than one.
array<int|string> $empty = [];
echo "[", Render::of(Core\Arr::fillKeys($empty, 1)), "]\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$keys = ["a", "1", 1, "01", "", -2];
echo count(array_fill_keys($keys, 0)), "|", render(array_fill_keys($keys, 0)), "\n";

$mapped = ["p" => "x", "q" => "y"];
$flat = ["x", "y"];
echo render(array_fill_keys($mapped, 9)), "|", render(array_fill_keys($flat, 9)), "\n";

$repeat = ["x", "y", "x"];
echo count(array_fill_keys($repeat, 1)), "|", render(array_fill_keys($repeat, 1)), "\n";

$empty = [];
echo "[", render(array_fill_keys($empty, 1)), "]\n";
