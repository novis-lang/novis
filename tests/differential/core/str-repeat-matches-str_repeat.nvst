--TEST--
Core\Str::repeat matches PHP's str_repeat, zero included
--FILE--
<?nvs
echo "[", Core\Str::repeat("ab", 3), "]\n";
echo "[", Core\Str::repeat("-", 10), "]\n";
echo "[", Core\Str::repeat("x", 1), "]\n";
echo "[", Core\Str::repeat("x", 0), "]\n";
echo "[", Core\Str::repeat("", 5), "]\n";
--ORACLE--
<?php
echo "[", str_repeat("ab", 3), "]\n";
echo "[", str_repeat("-", 10), "]\n";
echo "[", str_repeat("x", 1), "]\n";
echo "[", str_repeat("x", 0), "]\n";
echo "[", str_repeat("", 5), "]\n";
