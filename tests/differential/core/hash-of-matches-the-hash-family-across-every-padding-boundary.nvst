--TEST--
`Core\Hash::of` answers what `hash()` answers for a subject one octet under, exactly at and one octet over every block width and length-field boundary in spec § 11's roster, and no trailing zero octet is absorbed by the padding (spec § 11, `rule:types/bytes`, `rule:core-api/shape-rules` R17)
--FILE--
<?nvs
// `hash-of-matches-the-hash-family` asks all fourteen algorithms about five
// subjects; this file asks them about the one dimension that is not the
// algorithm — where the *padding* is. Every Merkle-Damgård digest here appends
// a terminator, a run of zeros and a big-endian length field, so a subject
// that leaves too little room in its last block forces an extra one. That
// happens at 56 for the 64-octet block with an 8-octet length (MD5, SHA-1,
// SHA-224, SHA-256) and at 112 for the 128-octet block with a 16-octet one
// (SHA-384, SHA-512 and both truncations). The SHA-3 sponge has no length
// field at all and absorbs at its rate — 144, 136, 104 and 72 — so its
// boundaries are somewhere else entirely, which is what makes one sweep over
// all fourteen worth more than fourteen sweeps: a row where one column moved
// and thirteen did not is a column with its own arithmetic.
final class Row {
    // Every algorithm PHP can compute, in spec § 11's roster order.
    // `Digest::Blake3` is absent for the reason the roster gives — PHP cannot
    // compute it — and `hash-computes-every-digest-and-authenticates-with-hmac`
    // covers it against its published vectors instead.
    public static function every(bytes $subject): string {
        string $out = "";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Crc32)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Crc32c)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Md5)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha1)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha224)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha256)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha384)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha512)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha512_224)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha512_256)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha3_224)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha3_256)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha3_384)) . "|";
        $out = $out . Core\Encoding::toHex(Core\Hash::of($subject, Core\Digest::Sha3_512)) . "|";
        return $out;
    }
}

// The empty subject, a one-octet one, then each boundary with its neighbours:
// 56 and 112 are the two length-field overflows, 64 and 128 the two block
// widths, and 72, 104, 136 and 144 the four sponge rates.
array<uint> $lengths = [
    0, 1,
    55, 56, 57,
    63, 64, 65,
    71, 72, 73,
    103, 104, 105,
    111, 112, 113,
    127, 128, 129,
    135, 136, 137,
    143, 144, 145,
];
foreach ($lengths as uint $n) {
    // Built from hex rather than from text, so that the sweep below can
    // append an octet no `string` may hold.
    bytes $subject = Core\Encoding::fromHex(Core\Str::repeat("61", $n));
    echo "n", $n, ":", Row::every($subject), "\n";
}

// The padding is a terminator, not a fill: a subject and that same subject
// with one trailing zero octet are two different messages at every length,
// including the ones that leave room in the last block. An implementation
// that had zero-filled to the block instead would collide for every length
// under it and agree with PHP everywhere else — so this is counted over the
// whole sweep rather than shown on a line, and asked of both a
// Merkle-Damgård digest and the sponge.
int $held = 0;
int $cells = 0;
foreach ($lengths as uint $n) {
    $cells = $cells + 2;
    bytes $plain = Core\Encoding::fromHex(Core\Str::repeat("61", $n));
    bytes $zeroed = Core\Encoding::fromHex(Core\Str::repeat("61", $n) . "00");
    if (!Core\Hash::equals(
        Core\Hash::of($plain, Core\Digest::Sha256),
        Core\Hash::of($zeroed, Core\Digest::Sha256)
    )) {
        $held = $held + 1;
    }
    if (!Core\Hash::equals(
        Core\Hash::of($plain, Core\Digest::Sha3_256),
        Core\Hash::of($zeroed, Core\Digest::Sha3_256)
    )) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
--ORACLE--
<?php
$algos = [
    "crc32b",
    "crc32c",
    "md5",
    "sha1",
    "sha224",
    "sha256",
    "sha384",
    "sha512",
    "sha512/224",
    "sha512/256",
    "sha3-224",
    "sha3-256",
    "sha3-384",
    "sha3-512",
];

function every($subject) {
    global $algos;
    $out = "";
    foreach ($algos as $algo) {
        $out = $out . hash($algo, $subject) . "|";
    }
    return $out;
}

$lengths = [
    0, 1,
    55, 56, 57,
    63, 64, 65,
    71, 72, 73,
    103, 104, 105,
    111, 112, 113,
    127, 128, 129,
    135, 136, 137,
    143, 144, 145,
];
foreach ($lengths as $n) {
    $subject = hex2bin(str_repeat("61", $n));
    echo "n", $n, ":", every($subject), "\n";
}

$held = 0;
$cells = 0;
foreach ($lengths as $n) {
    $cells = $cells + 2;
    $plain = hex2bin(str_repeat("61", $n));
    $zeroed = hex2bin(str_repeat("61", $n) . "00");
    if (hash("sha256", $plain, true) !== hash("sha256", $zeroed, true)) {
        $held = $held + 1;
    }
    if (hash("sha3-256", $plain, true) !== hash("sha3-256", $zeroed, true)) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
