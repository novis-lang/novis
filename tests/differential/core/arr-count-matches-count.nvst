--TEST--
Core\Arr::count over a list agrees with PHP's count()
--FILE--
<?nvs
echo Core\Arr::count([]), "\n";
echo Core\Arr::count(["a"]), "\n";
echo Core\Arr::count(["a", "b", "c"]), "\n";
echo Core\Arr::count(Core\Arr::range(1, 10)), "\n";
--ORACLE--
<?php
echo count([]), "\n";
echo count(["a"]), "\n";
echo count(["a", "b", "c"]), "\n";
echo count(range(1, 10)), "\n";
