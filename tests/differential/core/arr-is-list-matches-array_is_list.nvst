--TEST--
Core\Arr::isList answers exactly what PHP's array_is_list answers, `unset` included
--FILE--
<?nvs
array<int> $list = [10, 20, 30];
array<int> $map = ["b" => 2, "a" => 1];
array<int> $none = [];

echo Core\Arr::isList($list) as string, "|", Core\Arr::isList($map) as string, "|", Core\Arr::isList($none) as string, "|\n";

unset($list[1]);
echo Core\Arr::isList($list) as string, "|\n";
--ORACLE--
<?php
$list = [10, 20, 30];
$map = ["b" => 2, "a" => 1];
$none = [];

echo array_is_list($list), "|", array_is_list($map), "|", array_is_list($none), "|\n";

unset($list[1]);
echo array_is_list($list), "|\n";
