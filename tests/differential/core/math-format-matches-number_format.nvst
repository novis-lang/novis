--TEST--
Core\Math::format groups, cuts and rounds exactly where number_format does, with the separators named rather than taken from a locale
--FILE--
<?nvs
// Spec § 3's `format` row. The member takes its separators explicitly because
// Novis has no ambient locale, so every call below states both and the PHP twin
// is passed the same two — what is being compared is the *arithmetic*: where
// the groups fall, where the fraction is cut, and which way the cut rounds.
// The first row is the shape every call has, and the ones after it are the
// places two implementations of it can differ.
echo Core\Math::format(1234567.891, {decimals: 2, decimalSeparator: ".", groupSeparator: ","}), "\n";

// The grouping boundary from both sides: three digits are one group and four
// are two, and the leading group is the short one rather than the trailing one.
echo Core\Math::format(999.0, {groupSeparator: ","}), " ",
     Core\Math::format(1000.0, {groupSeparator: ","}), " ",
     Core\Math::format(1000000.0, {groupSeparator: ","}), "\n";

// A negative sign sits outside the leading group rather than being counted into
// it, which is where a formatter that grouped the rendered text instead of the
// digits goes wrong.
echo Core\Math::format(-1234.5, {decimals: 2, groupSeparator: ","}), " ",
     Core\Math::format(-999999.0, {groupSeparator: ","}), "\n";

// The fraction is padded up to `decimals` and cut down to it, and the cut
// rounds half away from zero — `0.125` and `-0.125` are exactly half of a
// hundredth, so both directions are asserted rather than assumed.
echo Core\Math::format(5.0, {decimals: 3}), " ",
     Core\Math::format(0.125, {decimals: 2}), " ",
     Core\Math::format(-0.125, {decimals: 2}), " ",
     Core\Math::format(2.5, {decimals: 0}), "\n";

// Separators are two independent strings: either may be anything, including
// each other's usual value, and the group separator may be empty — the
// continental spelling and the ungrouped one on one line.
echo Core\Math::format(1234567.891, {decimals: 2, decimalSeparator: ",", groupSeparator: "."}), " ",
     Core\Math::format(1234567.891, {decimals: 2, decimalSeparator: ".", groupSeparator: ""}), "\n";

// An integer subject formats as one, and a subject smaller than one group is
// unchanged by the grouping — the rows a formatter that always inserts a
// separator fails.
echo Core\Math::format(42, {groupSeparator: ","}), " ",
     Core\Math::format(0.0, {decimals: 2}), " ",
     Core\Math::format(0.4, {decimals: 0}), "\n";
--ORACLE--
<?php
echo number_format(1234567.891, 2, ".", ","), "\n";

echo number_format(999.0, 0, ".", ","), " ",
     number_format(1000.0, 0, ".", ","), " ",
     number_format(1000000.0, 0, ".", ","), "\n";

echo number_format(-1234.5, 2, ".", ","), " ",
     number_format(-999999.0, 0, ".", ","), "\n";

echo number_format(5.0, 3, ".", ","), " ",
     number_format(0.125, 2, ".", ","), " ",
     number_format(-0.125, 2, ".", ","), " ",
     number_format(2.5, 0, ".", ","), "\n";

echo number_format(1234567.891, 2, ",", "."), " ",
     number_format(1234567.891, 2, ".", ""), "\n";

echo number_format(42, 0, ".", ","), " ",
     number_format(0.0, 2, ".", ","), " ",
     number_format(0.4, 0, ".", ","), "\n";
