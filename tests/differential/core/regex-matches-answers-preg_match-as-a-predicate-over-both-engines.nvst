--TEST--
Core\Regex::matches answers what preg_match answers as a predicate, over anchors, word boundaries, backreferences, both lookarounds, a POSIX class and the two ends of a counted quantifier
--FILE--
<?nvs
// Spec § 5's `matches` row against its PHP twin. The member is the one place
// § 5 answers a `bool` rather than a `Match`, so what is being compared here
// is *whether the pattern matched at all* — the question underneath every
// other member of the class, and the one `rule:core-classes/regex-two-tiers`'s two engines have to agree
// on before anything they report can be compared.
//
// Every row is a pattern feature and the subject that decides it, in pairs:
// the one that matches beside the nearest one that does not. A predicate is
// the shape where a single answer is least informative — half a table of `1`s
// is what a member returning `true` unconditionally prints — so the rows come
// in pairs and the count of each is printed at the end.
//
// The rows straddle `rule:core-classes/regex-two-tiers`'s tiers on purpose: a backreference and both
// lookarounds are patterns only the backtracking engine can express, and the
// rest compile on the linear one, so a disagreement between the tiers shows
// here as a disagreement with PHP.
array<array<string>> $rows = [
    ["abc", "^a"],
    ["abc", "^b"],
    ["abc", "c$"],
    ["abc", "b$"],
    ["hello world", "\\bworld\\b"],
    ["helloworld", "\\bworld\\b"],
    ["aa", "(a)\\1"],
    ["ab", "(a)\\1"],
    ["foobar", "foo(?=bar)"],
    ["foobaz", "foo(?=bar)"],
    ["aXb", "(?<=a)X"],
    ["bXb", "(?<=a)X"],
    ["aaa", "a{2,3}"],
    ["a", "a{2,3}"],
    ["abc123", "[[:alpha:]]+[[:digit:]]+"],
    ["123abc", "^[[:alpha:]]+[[:digit:]]+$"],
    ["a\nb", "a.b"],
    ["a\nb", "a[\\s\\S]b"],
    ["", "^$"],
    ["", "a"],
    ["ABC", "abc"],
    ["ABC", "[A-Z]{3}"],
    ["x", ""],
    ["2026-08-24", "^\\d{4}-\\d{2}-\\d{2}$"],
    ["2026-8-24", "^\\d{4}-\\d{2}-\\d{2}$"],
    ["cat dog", "cat|dog"],
    ["fish", "cat|dog"],
    ["aaab", "a+?b"],
];

int $hits = 0;
int $misses = 0;
foreach ($rows as array<string> $row) {
    bool $hit = Core\Regex::matches($row["0"], $row["1"]);
    if ($hit) {
        $hits = $hits + 1;
    } else {
        $misses = $misses + 1;
    }
    echo "[", $hit as string, "]";
}
echo "\n", $hits, " matched, ", $misses, " did not\n";
--ORACLE--
<?php
// The patterns are single-quoted so `\\d` reaches PCRE as `\d`, and the two
// subjects carrying an escape are double-quoted so the newline in them is a
// newline rather than a backslash and an `n`.
$rows = [
    ['abc', '^a'],
    ['abc', '^b'],
    ['abc', 'c$'],
    ['abc', 'b$'],
    ['hello world', '\\bworld\\b'],
    ['helloworld', '\\bworld\\b'],
    ['aa', '(a)\\1'],
    ['ab', '(a)\\1'],
    ['foobar', 'foo(?=bar)'],
    ['foobaz', 'foo(?=bar)'],
    ['aXb', '(?<=a)X'],
    ['bXb', '(?<=a)X'],
    ['aaa', 'a{2,3}'],
    ['a', 'a{2,3}'],
    ['abc123', '[[:alpha:]]+[[:digit:]]+'],
    ['123abc', '^[[:alpha:]]+[[:digit:]]+$'],
    ["a\nb", 'a.b'],
    ["a\nb", 'a[\\s\\S]b'],
    ['', '^$'],
    ['', 'a'],
    ['ABC', 'abc'],
    ['ABC', '[A-Z]{3}'],
    ['x', ''],
    ['2026-08-24', '^\\d{4}-\\d{2}-\\d{2}$'],
    ['2026-8-24', '^\\d{4}-\\d{2}-\\d{2}$'],
    ['cat dog', 'cat|dog'],
    ['fish', 'cat|dog'],
    ['aaab', 'a+?b'],
];

$hits = 0;
$misses = 0;
foreach ($rows as $row) {
    $hit = preg_match("/" . $row[1] . "/", $row[0]) === 1;
    if ($hit) {
        $hits = $hits + 1;
    } else {
        $misses = $misses + 1;
    }
    echo "[", (string) $hit, "]";
}
echo "\n", $hits, " matched, ", $misses, " did not\n";
