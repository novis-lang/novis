--TEST--
Core\Path::basename answers PHP's basename at every boundary, and `{withoutExtension}` is its suffix argument, from docs/spec/01-core-library.md § 8
--FILE--
<?nvs
// The plain reading: the name of the last component, a trailing separator
// ignored however many there are (crates/nvs-stdlib/src/path.rs's `parse`
// drops an empty component, exactly as basename does).
echo "[", Core\Path::basename("/var/log/syslog.txt"), "]\n";
echo "[", Core\Path::basename("/var/log/"), "]\n";
echo "[", Core\Path::basename("/var/log//"), "]\n";
echo "[", Core\Path::basename("syslog.txt"), "]\n";

// The two subjects with no name in them at all. A root is not an *absent*
// name, so the answer is `''` and not null — and PHP's is `''` too.
echo "[", Core\Path::basename("/"), "]\n";
echo "[", Core\Path::basename(""), "]\n";

// `.` and `..` are ordinary components to both; resolving them is the job of
// `normalize` alone (named without its class here, because gaps.py reads a
// `Core\X::member` spelling in a comment as a call and would drop that
// member's own row).
echo "[", Core\Path::basename("."), "]\n";
echo "[", Core\Path::basename(".."), "]\n";

// `{withoutExtension: true}` is what PHP writes as a second argument naming
// the suffix, on every row where that suffix is the extension — including a
// double extension, where both stop at the *last* dot.
echo "[", Core\Path::basename("/var/log/syslog.txt", {withoutExtension: true}), "]\n";
echo "[", Core\Path::basename("archive.tar.gz", {withoutExtension: true}), "]\n";

// Where PHP's suffix does not match, PHP leaves the name whole — which is
// what `{withoutExtension: false}`, the default, answers.
echo "[", Core\Path::basename("notes.md"), "]\n";

// The two names this module reads as having no extension at all (path.rs's
// `stem_and_extension`, divergences one and two): a dotfile, whose leading
// dot does not open one, and a trailing dot, whose empty extension is an
// absence. PHP agrees on both, for its own reasons — it refuses a suffix
// that is the whole name, and its plain basename strips nothing.
echo "[", Core\Path::basename("/etc/.env", {withoutExtension: true}), "]\n";
echo "[", Core\Path::basename("report.", {withoutExtension: true}), "]\n";

// And the option over a name that has no extension to drop, and over the
// root that has no name to drop it from.
echo "[", Core\Path::basename("/usr/bin/env", {withoutExtension: true}), "]\n";
echo "[", Core\Path::basename("/", {withoutExtension: true}), "]\n";
--ORACLE--
<?php
echo "[", basename("/var/log/syslog.txt"), "]\n";
echo "[", basename("/var/log/"), "]\n";
echo "[", basename("/var/log//"), "]\n";
echo "[", basename("syslog.txt"), "]\n";
echo "[", basename("/"), "]\n";
echo "[", basename(""), "]\n";
echo "[", basename("."), "]\n";
echo "[", basename(".."), "]\n";
echo "[", basename("/var/log/syslog.txt", ".txt"), "]\n";
echo "[", basename("archive.tar.gz", ".gz"), "]\n";
echo "[", basename("notes.md", ".txt"), "]\n";
echo "[", basename("/etc/.env", ".env"), "]\n";
echo "[", basename("report."), "]\n";
echo "[", basename("/usr/bin/env", ".txt"), "]\n";
echo "[", basename("/", ".txt"), "]\n";
