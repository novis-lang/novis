--TEST--
Core\Str::reverse answers what strrev answers over an ASCII table, and both are their own involution, both preserve length, both agree on which rows are palindromes, and both turn a concatenation inside out
--FILE--
<?nvs
// Spec § 1's `reverse` row. The subjects here are ASCII on purpose:
// `Core\Str::reverse` walks grapheme clusters
// (`nvs_stdlib::granularity::DEFAULT`, `rule:types/string-is-utf8`) and `strrev` walks
// bytes, and inside ASCII those are the same walk — which is what makes the
// whole table below an oracle rather than a frozen expectation. Where the two
// units part is the companion case,
// `str-reverse-on-clusters-diverges-from-strrev`.
//
// A row of answers is the weakest thing this file says. Reversal is defined
// by three properties rather than by its output, so each of them is asserted
// as a *count* over the whole table: a member that reversed only up to the
// first space, or that stopped one unit early, prints plausibly on several
// rows and fails every count.

// Ten rows: the empty subject, one character, two, a run, a sentence with
// punctuation, a palindrome, a subject with an interior space, one that is
// mostly whitespace, one that is nothing but symbols, and one whose
// reversal is a rearrangement of the same two letters.
array<string> $rows = ["", "a", "ab", "abcdef", "Hello, World!", "racecar", "12 34", "  x  ", "!@#-%^&*()", "aabb"];

// The answers themselves, bracketed so an empty one is a cell rather than a
// gap and so a subject that is all spaces has visible ends.
foreach ($rows as string $row) {
    echo "[", Core\Str::reverse($row), "]";
}
echo "\n";

// Three counts over the same ten rows.
//
// * **The involution.** `reverse` is its own inverse, so reversing twice is
//   the identity on every subject — ten of ten, and `strrev` holds it too,
//   byte-wise. This is the property that fails loudly for a member that drops
//   or duplicates a unit at either end, because the second pass cannot put
//   back what the first one lost.
// * **The palindromes.** Reversing once is the identity on exactly four of
//   these rows and not on the other six, which is what says the member is
//   doing something at all. A `reverse` that returned its subject unchanged
//   would pass the involution count with full marks and score ten here.
// * **The width.** A reversal is a rearrangement, so it answers as many
//   units as it was given. Over ASCII the unit `Core\Str::length` counts and
//   the one `strlen` counts are the same unit, so both sides read the same
//   ten.
int $back = 0;
int $same = 0;
int $wide = 0;
int $cells = 0;
foreach ($rows as string $one) {
    $cells = $cells + 1;
    if (Core\Str::reverse(Core\Str::reverse($one)) == $one) {
        $back = $back + 1;
    }
    if (Core\Str::reverse($one) == $one) {
        $same = $same + 1;
    }
    if (Core\Str::length(Core\Str::reverse($one)) == Core\Str::length($one)) {
        $wide = $wide + 1;
    }
}
echo $back, " ", $same, " ", $wide, " of ", $cells, "\n";

// The property that pins the *order* rather than the contents: reversal
// turns a concatenation inside out, so the reversal of `$left . $right` is
// the reversal of `$right` followed by the reversal of `$left`. Asserted
// over every one of the hundred ordered pairs of the table, because it is
// the one claim above that a member reversing by any wrong unit still has to
// answer — it relates two reversals to a third rather than to a subject, so
// there is no expectation for it to be accidentally right about. PHP holds
// it on all hundred as well.
int $anti = 0;
int $pairs = 0;
foreach ($rows as string $left) {
    foreach ($rows as string $right) {
        $pairs = $pairs + 1;
        if (Core\Str::reverse($left . $right) == Core\Str::reverse($right) . Core\Str::reverse($left)) {
            $anti = $anti + 1;
        }
    }
}
echo $anti, " of ", $pairs, "\n";
--ORACLE--
<?php
$rows = ["", "a", "ab", "abcdef", "Hello, World!", "racecar", "12 34", "  x  ", "!@#-%^&*()", "aabb"];

foreach ($rows as $row) {
    echo "[", strrev($row), "]";
}
echo "\n";

$back = 0;
$same = 0;
$wide = 0;
$cells = 0;
foreach ($rows as $one) {
    $cells = $cells + 1;
    if (strrev(strrev($one)) == $one) {
        $back = $back + 1;
    }
    if (strrev($one) == $one) {
        $same = $same + 1;
    }
    if (strlen(strrev($one)) == strlen($one)) {
        $wide = $wide + 1;
    }
}
echo $back, " ", $same, " ", $wide, " of ", $cells, "\n";

$anti = 0;
$pairs = 0;
foreach ($rows as $left) {
    foreach ($rows as $right) {
        $pairs = $pairs + 1;
        if (strrev($left . $right) == strrev($right) . strrev($left)) {
            $anti = $anti + 1;
        }
    }
}
echo $anti, " of ", $pairs, "\n";
