--TEST--
Core\Arr::sortByKey over keys PHP cannot read as numbers produces what ksort, krsort and uksort produce
--FILE--
<?nvs
final class Render {
    // The claim of every row is the key order, which is what the member
    // sorted on; preserving the keys is unconditional here, because a sort
    // by key that renumbered would have discarded what it just ordered on.
    public static function keys(array<mixed> $a): string {
        return Core\Str::join(Core\Arr::keys($a), ",");
    }
}

// Not one of these keys is a numeral, so `ksort`'s default SORT_REGULAR falls
// through to `strcmp` — the same bytewise compare
// `nvs_stdlib::ordering::compare_values` gives two strings. The subject is
// chosen so that a locale- or case-aware collation would answer differently
// from either: upper case sorts before lower, `_` falls between the two, and
// a digit-led key that is still not a number sorts before every letter.
array<int> $rows = ["banana" => 1, "Apple" => 2, "apple" => 3, "9a" => 4, "_x" => 5, "Zoo" => 6];

echo Render::keys(Core\Arr::sortByKey($rows)), "\n";
echo Render::keys(Core\Arr::sortByKey($rows, {order: Core\Order::Desc})), "\n";

// `comparator` is handed the two *keys* — that is `uksort`'s contract, and the
// reason the member's option bag has no `by`. Both sorts are stable, so the
// two two-byte keys and the two five-byte keys come out in their insertion
// order on either side, which is the second thing this row asserts.
echo Render::keys(Core\Arr::sortByKey($rows, {comparator: fn(string $a, string $b): int => (Core\Str::length($a) as int) - (Core\Str::length($b) as int)})), "\n";

// And the subject is untouched by all three: `sortByKey` answers a new array
// where `ksort` rewrites its argument in place.
echo Render::keys($rows), "\n";
--ORACLE--
<?php
$rows = ["banana" => 1, "Apple" => 2, "apple" => 3, "9a" => 4, "_x" => 5, "Zoo" => 6];

$up = $rows;
ksort($up);
echo implode(",", array_keys($up)), "\n";

$down = $rows;
krsort($down);
echo implode(",", array_keys($down)), "\n";

$byLength = $rows;
uksort($byLength, fn($a, $b) => strlen($a) <=> strlen($b));
echo implode(",", array_keys($byLength)), "\n";

echo implode(",", array_keys($rows)), "\n";
