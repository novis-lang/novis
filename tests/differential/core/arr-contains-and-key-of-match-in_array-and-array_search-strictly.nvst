--TEST--
Core\Arr::contains and keyOf answer what in_array and array_search answer with strict comparison on, over list, map and non-contiguous subjects
--FILE--
<?mwl
// Spec § 2's membership pair. `contains` is "(always strict)" in that table and
// `keyOf` answers `?string`, so both PHP twins are called here with their third
// argument on and their `false` rendered as `none` — that rendering is what
// makes the two comparable at all, and what is compared below is the answer,
// never the representation.
//
// Every subject here holds one type, so PHP's strict reading and MWL's are the
// same comparison. The two rows where they are not — MWL's one numeric domain,
// and PHP's *default* being loose — are in
// `arr-contains-is-strict-with-one-numeric-domain-where-in_array-is-loose`.
final class Show {
    public static function key(?string $k): string {
        if ($k == null) {
            return "none";
        }
        return $k as string;
    }

    public static function yes(bool $b): string {
        if ($b) {
            return "yes";
        }
        return "no";
    }
}

// A list with a repeated value: the first occurrence is the answer on both
// sides, which is the only thing that distinguishes `keyOf` from "some key of".
array<string> $words = ["alpha", "beta", "gamma", "beta"];
echo Show::yes(Core\Arr::contains($words, "alpha")), "|", Show::key(Core\Arr::keyOf($words, "alpha")), "\n";
echo Show::yes(Core\Arr::contains($words, "beta")), "|", Show::key(Core\Arr::keyOf($words, "beta")), "\n";
echo Show::yes(Core\Arr::contains($words, "delta")), "|", Show::key(Core\Arr::keyOf($words, "delta")), "\n";
echo Show::yes(Core\Arr::contains($words, "")), "|", Show::key(Core\Arr::keyOf($words, "")), "\n";

// The two members must agree with each other as well as with PHP: a `keyOf`
// that answers a key is a `contains` that answers true, at every needle.
array<string> $needles = ["alpha", "beta", "gamma", "delta", ""];
var $agreements = 0;
bool $isKeyed = false;
foreach ($needles as string $needle) {
    $isKeyed = true;
    if (Core\Arr::keyOf($words, $needle) == null) {
        $isKeyed = false;
    }
    if (Core\Arr::contains($words, $needle) == $isKeyed) {
        $agreements = $agreements + 1;
    }
}
echo $agreements, "\n";

// A map, where the answer is a string key rather than a position, and where the
// same value sits under two keys.
array<string> $map = ["a" => "x", "b" => "y", "c" => "x"];
echo Show::key(Core\Arr::keyOf($map, "x")), "|", Show::key(Core\Arr::keyOf($map, "y")), "|", Show::key(Core\Arr::keyOf($map, "z")), "|\n";

// Integer keys that are neither contiguous nor in order: the answer is the key,
// not the position, and PHP renders its `int` key as the same digits.
array<string> $sparse = ["7" => "x", "2" => "y", "5" => "x"];
echo Show::key(Core\Arr::keyOf($sparse, "x")), "|", Show::key(Core\Arr::keyOf($sparse, "y")), "|\n";

// An int subject, including the value `0` at position `0` — the row that
// `array_search`'s manual warns about, and the only one where PHP's own answer
// is indistinguishable from "not found" under a loose test.
array<int> $nums = [0, 3, 1, 4, 1];
echo Show::yes(Core\Arr::contains($nums, 0)), "|", Show::key(Core\Arr::keyOf($nums, 0)), "\n";
echo Show::yes(Core\Arr::contains($nums, 1)), "|", Show::key(Core\Arr::keyOf($nums, 1)), "\n";
echo Show::yes(Core\Arr::contains($nums, 9)), "|", Show::key(Core\Arr::keyOf($nums, 9)), "\n";

// A bool subject, where `false` is a value to be found rather than an answer.
array<bool> $flags = [false, true, false];
echo Show::key(Core\Arr::keyOf($flags, false)), "|", Show::key(Core\Arr::keyOf($flags, true)), "|\n";

// The empty subject: nothing is in it, and nothing is the key of anything.
array<string> $empty = [];
echo Show::yes(Core\Arr::contains($empty, "a")), "|", Show::key(Core\Arr::keyOf($empty, "a")), "\n";
--ORACLE--
<?php
function showKey(string|int|false $k): string {
    if ($k === false) {
        return "none";
    }
    return (string) $k;
}

function showYes(bool $b): string {
    if ($b) {
        return "yes";
    }
    return "no";
}

$words = ["alpha", "beta", "gamma", "beta"];
echo showYes(in_array("alpha", $words, true)), "|", showKey(array_search("alpha", $words, true)), "\n";
echo showYes(in_array("beta", $words, true)), "|", showKey(array_search("beta", $words, true)), "\n";
echo showYes(in_array("delta", $words, true)), "|", showKey(array_search("delta", $words, true)), "\n";
echo showYes(in_array("", $words, true)), "|", showKey(array_search("", $words, true)), "\n";

$needles = ["alpha", "beta", "gamma", "delta", ""];
$agreements = 0;
foreach ($needles as $needle) {
    if (in_array($needle, $words, true) === (array_search($needle, $words, true) !== false)) {
        $agreements = $agreements + 1;
    }
}
echo $agreements, "\n";

$map = ["a" => "x", "b" => "y", "c" => "x"];
echo showKey(array_search("x", $map, true)), "|", showKey(array_search("y", $map, true)), "|", showKey(array_search("z", $map, true)), "|\n";

$sparse = [7 => "x", 2 => "y", 5 => "x"];
echo showKey(array_search("x", $sparse, true)), "|", showKey(array_search("y", $sparse, true)), "|\n";

$nums = [0, 3, 1, 4, 1];
echo showYes(in_array(0, $nums, true)), "|", showKey(array_search(0, $nums, true)), "\n";
echo showYes(in_array(1, $nums, true)), "|", showKey(array_search(1, $nums, true)), "\n";
echo showYes(in_array(9, $nums, true)), "|", showKey(array_search(9, $nums, true)), "\n";

$flags = [false, true, false];
echo showKey(array_search(false, $flags, true)), "|", showKey(array_search(true, $flags, true)), "|\n";

$empty = [];
echo showYes(in_array("a", $empty, true)), "|", showKey(array_search("a", $empty, true)), "\n";
