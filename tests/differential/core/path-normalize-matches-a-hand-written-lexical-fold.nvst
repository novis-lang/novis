--TEST--
Core\Path::normalize agrees with a hand-written fold of `.` and `..`, which is the half of PHP's realpath that does not touch the disk, from docs/spec/01-core-library.md § 8
--FILE--
<?nvs
// PHP's `realpath` is the wrong side of this pair: it stats the disk, follows
// symlinks, and answers `false` for a path that does not exist, so not one row
// below can be asked of it. `Core\Path::normalize` is realpath's *lexical*
// half, and the oracle for a lexical half is that half written out in PHP —
// the same shape uri-compare-to-matches-a-hand-written-rfc-3986-normalization
// already uses for § 6.2.2. That makes this a genuine second implementation
// rather than a restatement of the first.
//
// No subject spells a `\`: Novis reads both separators on every platform where
// PHP reads `\` on Windows only, so a backslash row would pass one leg and
// fail the other.
final class Norm {
    // The answer is a path, so it carries Core\Path::SEPARATOR — `\` on the
    // Windows leg and `/` on the WSL one. The oracle renders with `/`, so a
    // row reads identically on both legs.
    public static function of(string $path): string {
        return Core\Str::replace($path, Core\Path::SEPARATOR, "/");
    }
}

array<string> $paths = [
    // The plain reading: a `.` drops, a `..` cancels the component before it.
    "/var/www/../log/./app.log",
    // A `..` past the root of an absolute path: a root has no parent, so it is
    // dropped rather than kept or refused. Twice over, and once with a
    // component still to come.
    "/a/../..",
    "/../x",
    // The same `..` on a *relative* path survives, because `../a` names
    // something real and nothing lexical knows what. Including the row where a
    // second `..` meets a first one already kept.
    "a/../..",
    "../../a",
    "a/b/../../../c",
    // A relative path that cancels down to nothing renders as `.`, not as the
    // empty string: every member here answers a path a program can use.
    "a/..",
    "",
    ".",
    // A repeated and a trailing separator, which re-rendering drops.
    "a//b/./c/",
    "/var/log//",
    "./x/",
    // The roots and the bare `..`, where there is nothing left to fold.
    "..",
    "/",
    // A drive is a root on both legs — this module's one-grammar rule — so a
    // `..` past it is dropped exactly as it is past `/`.
    "C:/a/./b/..",
    "C:/../..",
    // Already normal: the row that would catch a re-render that is not the
    // identity.
    "/a/b/c",
];
foreach ($paths as string $p) {
    echo "[", $p, "] -> [", Norm::of(Core\Path::normalize($p)), "]\n";
}
--ORACLE--
<?php
// A drive is a root here too, spelled out rather than borrowed from the host:
// PHP reads one only on Windows, and this oracle has to answer the same on
// both legs.
function split_drive(string $path): array {
    if (preg_match('#^[A-Za-z]:[/\\\\]#', $path) === 1) {
        return [substr($path, 0, 2), substr($path, 2)];
    }
    return ['', $path];
}

// The fold itself: an empty component is nothing, a `.` is nothing, and a `..`
// cancels the component before it — unless there is none and the path is
// absolute, where it is dropped, or the one before it is itself a `..`, where
// it is kept.
function normalize(string $path): string {
    [$drive, $rest] = split_drive($path);
    $absolute = $rest !== '' && ($rest[0] === '/' || $rest[0] === '\\');
    $kept = [];
    foreach (preg_split('#[/\\\\]#', $rest) as $component) {
        if ($component === '' || $component === '.') {
            continue;
        }
        if ($component !== '..') {
            $kept[] = $component;
            continue;
        }
        $last = end($kept);
        if ($last !== false && $last !== '..') {
            array_pop($kept);
        } elseif ($last === false && $absolute) {
            // A root has no parent.
        } else {
            $kept[] = '..';
        }
    }
    $root = $drive . ($absolute ? '/' : '');
    if ($root === '' && $kept === []) {
        return '.';
    }
    return $root . implode('/', $kept);
}

$paths = [
    "/var/www/../log/./app.log",
    "/a/../..",
    "/../x",
    "a/../..",
    "../../a",
    "a/b/../../../c",
    "a/..",
    "",
    ".",
    "a//b/./c/",
    "/var/log//",
    "./x/",
    "..",
    "/",
    "C:/a/./b/..",
    "C:/../..",
    "/a/b/c",
];
foreach ($paths as $p) {
    echo "[", $p, "] -> [", normalize($p), "]\n";
}
