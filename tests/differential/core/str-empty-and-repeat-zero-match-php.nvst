--TEST--
Core\Str::isEmpty and a zero-count Core\Str::repeat agree with PHP's `=== ""` and str_repeat
--FILE--
<?nvs
echo "[", Core\Str::repeat("ab", 0), "]\n";
echo "[", Core\Str::repeat("", 5), "]\n";
echo "[", Core\Str::repeat("ab", 3), "]\n";
echo Core\Str::isEmpty("") as string, "|", Core\Str::isEmpty(" ") as string, "|", Core\Str::isEmpty("x") as string, "|\n";
echo Core\Str::isEmpty(Core\Str::repeat("x", 0)) as string, "|\n";
--ORACLE--
<?php
echo "[", str_repeat("ab", 0), "]\n";
echo "[", str_repeat("", 5), "]\n";
echo "[", str_repeat("ab", 3), "]\n";
echo "" === "", "|", " " === "", "|", "x" === "", "|\n";
echo str_repeat("x", 0) === "", "|\n";
