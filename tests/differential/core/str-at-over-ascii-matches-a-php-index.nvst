--TEST--
Core\Str::at over ASCII returns the same one-character string PHP's `$s[$i]` does
--FILE--
<?mwl
string $s = "haystack";
echo Core\Str::at($s, 0), "|", Core\Str::at($s, 3), "|", Core\Str::at($s, 7), "|\n";
echo Core\Str::at("x", 0), "|\n";
echo Core\Str::length($s), "|\n";
--ORACLE--
<?php
$s = "haystack";
echo $s[0], "|", $s[3], "|", $s[7], "|\n";
echo "x"[0], "|\n";
echo strlen($s), "|\n";
