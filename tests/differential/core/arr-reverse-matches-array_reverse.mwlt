--TEST--
Core\Arr::reverse answers what array_reverse answers at both settings of its key option, and the option's default is the same one in both languages
--FILE--
<?mwl
// Spec § 2's `array_reverse` row. `{preserveKeys?: bool}` and `$preserve_keys`
// are the same option with the same default, so this case asserts three things
// at once: the order, the keys each setting leaves behind, and that *omitting*
// the option means the same thing on both sides.
//
// A list subject, because the two rules for `false` differ in kind: MWL discards
// every key alike and renumbers from "0", where `array_reverse` renumbers the
// integer keys and keeps the string ones. Over a list there are no string keys
// for that difference to show up in.
// `arr-reverse-on-string-keys-diverges-from-array_reverse` is where they part.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $subject = [10, 20, 30, 40, 50];

// The default, the same setting written out, and the other one. The first two
// must agree with each other as well as with PHP, which is what pins the
// default rather than assuming it.
echo Render::of(Core\Arr::reverse($subject)), "\n";
echo Render::of(Core\Arr::reverse($subject, {preserveKeys: false})), "\n";
echo Render::of(Core\Arr::reverse($subject, {preserveKeys: true})), "\n";

// The lengths at which an order can look right for the wrong reason: nothing to
// reverse, one entry, and an even count where no entry sits still.
array<int> $empty = [];
array<int> $one = [10];
array<int> $two = [10, 20];
echo Render::of(Core\Arr::reverse($empty)), "|", Render::of(Core\Arr::reverse($one)), "|", Render::of(Core\Arr::reverse($two)), "|\n";
echo Render::of(Core\Arr::reverse($empty, {preserveKeys: true})), "|", Render::of(Core\Arr::reverse($one, {preserveKeys: true})), "|", Render::of(Core\Arr::reverse($two, {preserveKeys: true})), "|\n";

// Reversing twice is the identity over a list at either setting — and at
// `true` that is a claim about the keys as well, since the first call leaves
// them descending.
echo Render::of(Core\Arr::reverse(Core\Arr::reverse($subject))), "\n";
echo Render::of(Core\Arr::reverse(Core\Arr::reverse($subject, {preserveKeys: true}), {preserveKeys: true})), "\n";

// The subject is untouched by any of it.
echo Render::of($subject), "\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$subject = [10, 20, 30, 40, 50];

echo render(array_reverse($subject)), "\n";
echo render(array_reverse($subject, false)), "\n";
echo render(array_reverse($subject, true)), "\n";

$empty = [];
$one = [10];
$two = [10, 20];
echo render(array_reverse($empty)), "|", render(array_reverse($one)), "|", render(array_reverse($two)), "|\n";
echo render(array_reverse($empty, true)), "|", render(array_reverse($one, true)), "|", render(array_reverse($two, true)), "|\n";

echo render(array_reverse(array_reverse($subject))), "\n";
echo render(array_reverse(array_reverse($subject, true), true)), "\n";

echo render($subject), "\n";
