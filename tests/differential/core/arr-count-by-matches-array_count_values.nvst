--TEST--
Core\Arr::countBy answers what array_count_values answers, bucket for bucket and in the same first-occurrence order
--FILE--
<?nvs
// Spec § 2's `array_count_values` row. Both members name a bucket by the value
// itself, normalized the way an array key is normalized, and both order the
// result by where each bucket was first seen rather than by name or by count —
// so the rendering below asserts the order as well as the tallies.
//
// `countBy` returns `array<uint>` where PHP returns ints; a count cannot be
// negative, which is the reason `nvs_core_arr_count` gives for the same choice.
// The two render identically, which is what this case checks and all a caller
// can observe.
final class Render {
    public static function counts(array<uint> $a): string {
        var $out = "";
        foreach ($a as string $k => uint $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

// Three buckets, first seen in an order that is neither alphabetical nor by
// count, so a member that sorted anything would be caught here.
array<string> $words = ["red", "blue", "red", "green", "blue", "red"];
echo Render::counts(Core\Arr::countBy($words)), "\n";

// An int and its decimal spelling are one bucket in both languages, because
// both name the bucket through the same normalization a key gets. This is the
// one place `countBy` deliberately does *not* follow `Core\Arr::unique`, which
// compares by identity and keeps the two apart —
// `arr-unique-on-mixed-types-diverges-from-array_unique` is that half.
array<int|string> $numbers = [3, "3", 1];
echo Render::counts(Core\Arr::countBy($numbers)), "\n";

array<string|int> $spellings = ["red", 1, "red", "1", "blue"];
echo Render::counts(Core\Arr::countBy($spellings)), "\n";

// Nothing to count, and one thing to count.
array<string> $empty = [];
array<string> $solo = ["solo"];
echo Render::counts(Core\Arr::countBy($empty)), "|", Render::counts(Core\Arr::countBy($solo)), "|\n";

// The two counting members agree on how many distinct values a single-typed
// subject holds: one bucket per survivor. Over `$numbers` above they would
// not, on purpose.
echo Core\Arr::count(Core\Arr::countBy($words)), Core\Arr::count(Core\Arr::unique($words)), "\n";

// The tallies sum back to the subject's own count, and the subject is untouched.
echo Core\Arr::count($words), "\n";
--ORACLE--
<?php
function counts(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$words = ["red", "blue", "red", "green", "blue", "red"];
echo counts(array_count_values($words)), "\n";

$numbers = [3, "3", 1];
echo counts(array_count_values($numbers)), "\n";

$spellings = ["red", 1, "red", "1", "blue"];
echo counts(array_count_values($spellings)), "\n";

$empty = [];
$solo = ["solo"];
echo counts(array_count_values($empty)), "|", counts(array_count_values($solo)), "|\n";

echo count(array_count_values($words)), count(array_unique($words)), "\n";

echo count($words), "\n";
