--TEST--
Core\Str::replaceAll answers strtr on every cell of a table where PHP's two twins disagree, the sequential reading str_replace's array form gives is Core\Str::replace applied pair by pair, and only the one-pass reading is independent of the order the pairs were written
--FILE--
<?mwl
// Spec § 1's `replaceAll` row. Two PHP functions fold into one member, so
// this is checked as a *fold*: what has to be pinned is not that the member
// substitutes a table — the conformance case
// `str-replace-all-substitutes-a-table-in-one-pass` already says that — but
// **which of the two twins it is**, over subjects where they disagree.
//
// They disagree because they read the table differently, as the member's own
// doc comment in `mwl_stdlib::str` records: `strtr` scans the subject once,
// takes the longest needle matching at each position, and never rescans what
// it produced; `str_replace`'s array form runs each pair over the whole
// subject in turn, so an earlier pair's output is fed to every later pair.
// `replaceAll` is `strtr`'s reading, and ADR 0063 R20 is why — the other one
// makes the answer depend on the literal order of an array whose order is
// otherwise never observable.

// Six tables, six shapes of disagreement: a cascade, a swap, two needles
// where one is the other's prefix, a growth the next pair can re-match, a
// pair of disjoint words, and a single pair. The last two are here so the
// case is not made only of cells that differ — a member that agreed with
// neither twin would fail those first.
array<array<string>> $tables = [
    ["a" => "b", "b" => "c"],
    ["a" => "b", "b" => "a"],
    ["he" => "HE", "hell" => "HELL"],
    ["a" => "aa", "aa" => "z"],
    ["cat" => "dog", "bird" => "fish"],
    ["x" => "y"],
];

// The same six tables written in the opposite order. Hand-written rather than
// reversed by a member, so nothing about `Core\Arr` is being asserted here.
array<array<string>> $mirrors = [
    ["b" => "c", "a" => "b"],
    ["b" => "a", "a" => "b"],
    ["hell" => "HELL", "he" => "HE"],
    ["aa" => "z", "a" => "aa"],
    ["bird" => "fish", "cat" => "dog"],
    ["x" => "y"],
];

// The empty subject, one character, the two-character subject the swap turns
// round, a subject with a needle that is another needle's prefix, one with
// several separated occurrences, one with adjacent occurrences, a doubled
// character the longest-match rule reaches, and a sentence.
array<string> $subjects = ["", "a", "ab", "hello", "banana", "abab", "aa", "cat and bird"];

// Each cell prints both readings side by side: the member's answer, then the
// sequential reading written out in MWL as a `foreach` over the pairs. PHP
// prints `strtr` and `str_replace`'s array form in the same two columns, so
// the second column is also the claim that the port of a program that wanted
// PHP's cascading shape is exactly this loop — there is no option on the
// member for it and none is owed.
int $differ = 0;
int $stable = 0;
int $shifted = 0;
foreach ($tables as string $at => array<string> $table) {
    array<string> $mirror = $mirrors[$at];
    foreach ($subjects as string $subject) {
        string $sequential = $subject;
        foreach ($table as string $needle => string $replacement) {
            $sequential = Core\Str::replace($sequential, $needle, $replacement);
        }
        string $once = Core\Str::replaceAll($subject, $table);
        if ($once != $sequential) {
            $differ = $differ + 1;
        }

        // The property the reading was chosen for, counted on both sides: the
        // same table written back to front answers the same thing. A member
        // that had taken `str_replace`'s reading prints plausibly cell by cell
        // above and fails this count.
        if ($once == Core\Str::replaceAll($subject, $mirror)) {
            $stable = $stable + 1;
        }
        string $mirrored = $subject;
        foreach ($mirror as string $back => string $into) {
            $mirrored = Core\Str::replace($mirrored, $back, $into);
        }
        if ($sequential == $mirrored) {
            $shifted = $shifted + 1;
        }

        echo "[", $subject, "|", $once, "|", $sequential, "]";
    }
    echo "\n";
}

// 19 of the 48 cells tell the two twins apart, which is what makes the two
// columns above an assertion rather than a rendering.
echo "differ: ", $differ, "\n";
echo "order-independent: ", $stable, ", in sequence: ", $shifted, "\n";

// An empty table returns the subject unchanged, as `strtr` with an empty
// array does. The neighbouring boundary — an empty *needle*, which both
// languages skip rather than insert between every character — is pinned in
// the conformance case instead: PHP's answer agrees, but it warns while
// answering, and a warning on stdout is not a difference in the result.
array<string> $none = [];
echo Core\Str::replaceAll("abc", $none), "\n";

// `{caseInsensitive: true}` has a twin only at a single pair, and it is
// `str_ireplace` — `strtr` has no case-insensitive form at all, and
// `str_ireplace` is the cascading reading, so a table of several pairs under
// this option is a member with no twin to compare against. ASCII on purpose:
// the member folds case through Unicode's full mapping where `str_ireplace`
// folds bytes.
echo Core\Str::replaceAll("Hello World", ["hello" => "hi"], {caseInsensitive: true}), "\n";
echo Core\Str::replaceAll("Hello World", ["L" => "1"], {caseInsensitive: true}), "\n";

// The unit question this member does *not* have. `Core\Str::slice` and
// `::chunk` count grapheme clusters where their twins count bytes, so each
// of those owes a divergence case; `replaceAll` matches a needle as a byte
// sequence, and a needle that is valid UTF-8 can never begin at a position
// inside a character, so the two readings coincide and there is nothing to
// diverge. The third line is what proves it rather than assumes it: `"e"`
// matches the base of a *decomposed* cluster and splits it, leaving the
// combining acute behind — exactly what `strtr` does, and not what a member
// segmenting by cluster could do. `Core\Str::length` of that subject is 4,
// so the member counts clusters elsewhere and bytes here on purpose.
echo Core\Encoding::toHex(Core\Str::replaceAll("naïve café", ["ï" => "i", "é" => "e"]) as bytes), "\n";
echo Core\Encoding::toHex(Core\Str::replaceAll("naïve café", ["café" => "tea"]) as bytes), "\n";
echo Core\Encoding::toHex(Core\Str::replaceAll("e\u{301}ta\u{301}t", ["e" => "x", "a" => "y"]) as bytes), "\n";
--ORACLE--
<?php
$tables = [
    ["a" => "b", "b" => "c"],
    ["a" => "b", "b" => "a"],
    ["he" => "HE", "hell" => "HELL"],
    ["a" => "aa", "aa" => "z"],
    ["cat" => "dog", "bird" => "fish"],
    ["x" => "y"],
];
$mirrors = [
    ["b" => "c", "a" => "b"],
    ["b" => "a", "a" => "b"],
    ["hell" => "HELL", "he" => "HE"],
    ["aa" => "z", "a" => "aa"],
    ["bird" => "fish", "cat" => "dog"],
    ["x" => "y"],
];
$subjects = ["", "a", "ab", "hello", "banana", "abab", "aa", "cat and bird"];

$differ = 0;
$stable = 0;
$shifted = 0;
foreach ($tables as $at => $table) {
    $mirror = $mirrors[$at];
    foreach ($subjects as $subject) {
        $sequential = str_replace(array_keys($table), array_values($table), $subject);
        $once = strtr($subject, $table);
        if ($once != $sequential) {
            $differ = $differ + 1;
        }

        if ($once == strtr($subject, $mirror)) {
            $stable = $stable + 1;
        }
        $mirrored = str_replace(array_keys($mirror), array_values($mirror), $subject);
        if ($sequential == $mirrored) {
            $shifted = $shifted + 1;
        }

        echo "[", $subject, "|", $once, "|", $sequential, "]";
    }
    echo "\n";
}

echo "differ: ", $differ, "\n";
echo "order-independent: ", $stable, ", in sequence: ", $shifted, "\n";

echo strtr("abc", []), "\n";

echo str_ireplace("hello", "hi", "Hello World"), "\n";
echo str_ireplace("L", "1", "Hello World"), "\n";

echo bin2hex(strtr("naïve café", ["ï" => "i", "é" => "e"])), "\n";
echo bin2hex(strtr("naïve café", ["café" => "tea"])), "\n";
echo bin2hex(strtr("e\u{301}ta\u{301}t", ["e" => "x", "a" => "y"])), "\n";
