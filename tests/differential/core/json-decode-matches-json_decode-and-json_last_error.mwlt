--TEST--
Core\Json::decode round-trips every JSON value to the same text json_decode and json_encode do, refuses exactly what json_last_error reports, and its maxDepth option counts json_decode's $depth argument
--FILE--
<?mwl
// Spec § 6's `decode` row names `json_decode`, `json_last_error`,
// `json_last_error_msg` and `$depth` as the four things it replaces, and this
// case asks all four. There is no `$associative` flag — `decode` is always the
// associative shape (`json.rs:682`) — so the oracle passes `true`, and the
// comparison is made by *re-encoding*: a decoded value has no other rendering
// both languages share, and a `mixed` cannot be indexed past its first level
// here anyway.
//
// The oracle's two `json_encode` flags are not a thaw of the comparison, they
// are what makes it one: PHP escapes `/` and every non-ASCII code point by
// default and `Core\Json::encode` escapes neither (its `escapeUnicode` option
// defaults to `false`), so the flags line the two writers up on the question
// this case is actually about, which is what the *reader* built.
//
// Two number rows are deliberately absent because they do not agree, and both
// belong to a divergence case rather than here: `1e999`, which PHP reads as
// `INF` and this refuses, and `9223372036854775808`, which fits `uint` but not
// `int` — PHP widens it to a `float`, this refuses it. An integer past *every*
// integer type is not that row and is not a divergence: both readers take
// `12345678901234567890123` as a `float`. The scalar table names one more.

final class Show {
    // The round trip. A failure is the word rather than the message: PHP's
    // `json_last_error_msg` and this member's `ParseError` say the same thing
    // in two dependencies' wordings, and freezing either one here would pin a
    // sentence the next version of that dependency rewrites.
    public static function round(string $doc): string {
        try {
            return Core\Json::encode(Core\Json::decode($doc));
        } catch (Throwable $bad) {
            return "refused";
        }
    }

    // The same trip under an explicit cap, which is `json_decode`'s third
    // argument.
    public static function capped(string $doc, uint $max): string {
        try {
            return Core\Json::encode(Core\Json::decode($doc, {maxDepth: $max}));
        } catch (Throwable $deep) {
            return "refused";
        }
    }
}

// Every kind of value JSON has, at the top level, where the round trip has to
// be the identity on the text. `9223372036854775807` is the row that decides
// the reader picked an integer type wide enough for the whole of `int`, and
// `-2.5` that a fraction survives both directions unrounded.
//
// A float with no fractional digits is not asked here, and the reason is the
// instrument rather than the member: PHP's `json_encode` writes `0.0` as `0`
// and `100.0` as `100`, so `0.0` and `1e2` would be measuring the two
// *writers* against each other and not the reader. `-0` is a reader row and it
// also disagrees — PHP reads it as the integer `0`, this reads it as `-0.0`.
// All three belong to the same divergence and are its case, not rows here.
array<string> $scalars = ["1", "-2.5", "\"x\"", "true", "false", "null", "9223372036854775807"];
foreach ($scalars as string $scalar) {
    echo $scalar, " -> ", Show::round($scalar), "\n";
}

// Containers. `{}` and `[]` are the pair that separates a reader with two
// container types from one with a single associative array: both languages
// have the single one here, so an empty object comes back as an empty array
// and is written `[]`. Key order is insertion order in both, a numeral string
// key survives both directions, and a duplicate key keeps the last value.
array<string> $containers = [
    "[]",
    "{}",
    "[1,2,3]",
    "[[],{}]",
    "{\"a\":1,\"b\":[true,null]}",
    "{\"b\":1,\"a\":2}",
    "{\"1\":2}",
    "{\"a\":1,\"a\":2}",
    "{\"\":1}",
    "[{\"a\":[{\"b\":[]}]}]",
];
foreach ($containers as string $container) {
    echo $container, " -> ", Show::round($container), "\n";
}

// Strings, where the reader's escape handling is what is under test and the
// writer's is held still by the oracle's two flags. A `\/` and a non-ASCII
// code point come back unescaped; an escaped surrogate pair comes back as the
// one character it denotes, not as the pair.
array<string> $strings = ["\"a\\/b\"", "\"\\u00e9\"", "\"\\ud83d\\ude00\"", "\"tab\\there\"", "\"\\\"\"", "\"\\\\\""];
foreach ($strings as string $text) {
    echo $text, " -> ", Show::round($text), "\n";
}

// The refusals, which is `json_last_error` reporting anything but
// `JSON_ERROR_NONE`. Both readers stop at the same seven inputs, and the point
// of asking them here rather than only through `isValid` is that `decode` has
// to *throw* where PHP sets a flag and answers `null` — so a row that read
// `null` back instead of refusing would be indistinguishable from the `null`
// document above if the flag were not checked.
array<string> $malformed = ["", "[1,]", "NaN", "{", "\"\\ud800\"", "01", "[1][2]"];
foreach ($malformed as string $bad) {
    echo $bad, " -> ", Show::round($bad), "\n";
}

// `maxDepth` is `json_decode`'s `$depth`, counted the same way: a scalar
// document is depth 1, so `[[1]]` needs 3 and is refused at 2. Each document
// is asked at the last cap that refuses it and the first that accepts it,
// which is what a cap counting containers rather than levels gets wrong by one
// on every row.
echo "[1] at 1 2       ", Show::capped("[1]", 1), " ", Show::capped("[1]", 2), "\n";
echo "[[1]] at 2 3     ", Show::capped("[[1]]", 2), " ", Show::capped("[[1]]", 3), "\n";
echo "[[[1]]] at 3 4   ", Show::capped("[[[1]]]", 3), " ", Show::capped("[[[1]]]", 4), "\n";
echo "{\"a\":{}} at 2 3  ", Show::capped("{\"a\":{}}", 2), " ", Show::capped("{\"a\":{}}", 3), "\n";
echo "1 at 1           ", Show::capped("1", 1), "\n";
--ORACLE--
<?php
function round_trip(string $doc): string {
    $value = json_decode($doc, true);
    if (json_last_error() !== JSON_ERROR_NONE) {
        return "refused";
    }
    return json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}

function capped(string $doc, int $max): string {
    $value = json_decode($doc, true, $max);
    if (json_last_error() !== JSON_ERROR_NONE) {
        return "refused";
    }
    return json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}

$scalars = ["1", "-2.5", "\"x\"", "true", "false", "null", "9223372036854775807"];
foreach ($scalars as $scalar) {
    echo $scalar, " -> ", round_trip($scalar), "\n";
}

$containers = [
    "[]",
    "{}",
    "[1,2,3]",
    "[[],{}]",
    "{\"a\":1,\"b\":[true,null]}",
    "{\"b\":1,\"a\":2}",
    "{\"1\":2}",
    "{\"a\":1,\"a\":2}",
    "{\"\":1}",
    "[{\"a\":[{\"b\":[]}]}]",
];
foreach ($containers as $container) {
    echo $container, " -> ", round_trip($container), "\n";
}

$strings = ["\"a\\/b\"", "\"\\u00e9\"", "\"\\ud83d\\ude00\"", "\"tab\\there\"", "\"\\\"\"", "\"\\\\\""];
foreach ($strings as $text) {
    echo $text, " -> ", round_trip($text), "\n";
}

$malformed = ["", "[1,]", "NaN", "{", "\"\\ud800\"", "01", "[1][2]"];
foreach ($malformed as $bad) {
    echo $bad, " -> ", round_trip($bad), "\n";
}

echo "[1] at 1 2       ", capped("[1]", 1), " ", capped("[1]", 2), "\n";
echo "[[1]] at 2 3     ", capped("[[1]]", 2), " ", capped("[[1]]", 3), "\n";
echo "[[[1]]] at 3 4   ", capped("[[[1]]]", 3), " ", capped("[[[1]]]", 4), "\n";
echo "{\"a\":{}} at 2 3  ", capped("{\"a\":{}}", 2), " ", capped("{\"a\":{}}", 3), "\n";
echo "1 at 1           ", capped("1", 1), "\n";
