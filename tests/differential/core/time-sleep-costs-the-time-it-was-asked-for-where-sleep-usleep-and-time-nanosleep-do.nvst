--TEST--
Core\Time::sleep costs what sleep()/usleep()/time_nanosleep() cost, measured on each side's own clock — spec § 4
--FILE--
<?nvs
// `Core\Time::sleep(Duration): void` replaces `sleep`, `usleep` and
// `time_nanosleep` at once — one member where PHP has three, because a
// `Duration` already carries the scale each of those functions fixes in its
// name. It returns nothing and has no value to pin, so every row below is a
// property of the time it *cost*, measured on each side against that side's own
// monotonic clock: at least what was asked for, and not five seconds of it.
var $before = Core\Time::monotonic();
Core\Time::sleep(Core\Time\Duration::milliseconds(50));
int $slept = Core\Time::monotonic()->minus($before)->toMilliseconds();
echo "sleptAtLeastFortyMillis=", $slept >= 40 ? "yes" : "no", "\n";
echo "sleptUnderFiveSeconds=", $slept < 5000 ? "yes" : "no", "\n";

// The three PHP functions are three scales of one request, and so are the three
// `Duration` constructors: the same 50 milliseconds asked for in microseconds
// and in nanoseconds costs the same time.
var $beforeMicros = Core\Time::monotonic();
Core\Time::sleep(Core\Time\Duration::microseconds(50000));
echo "microsecondSpellingAgrees=", Core\Time::monotonic()->minus($beforeMicros)->toMilliseconds() >= 40 ? "yes" : "no", "\n";

var $beforeNanos = Core\Time::monotonic();
Core\Time::sleep(Core\Time\Duration::nanoseconds(50000000));
echo "nanosecondSpellingAgrees=", Core\Time::monotonic()->minus($beforeNanos)->toMilliseconds() >= 40 ? "yes" : "no", "\n";

// The wall clock moved forward across all of it too — which is the weaker of
// the two promises, `Core\Time::now` being steppable by the operating system
// where the monotonic clock is not.
var $wallBefore = Core\Time::now();
Core\Time::sleep(Core\Time\Duration::milliseconds(50));
echo "wallClockNotBehind=", Core\Time::now()->compareTo($wallBefore) >= 0 ? "yes" : "no", "\n";

// A duration of nothing costs nothing, which both implementations answer the
// same way and by the same route.
var $beforeZero = Core\Time::monotonic();
Core\Time::sleep(Core\Time\Duration::nanoseconds(0));
echo "zeroCostsNoTime=", Core\Time::monotonic()->minus($beforeZero)->toMilliseconds() < 5 ? "yes" : "no", "\n";

// A *negative* duration costs nothing either, and this is the one row the two
// implementations reach by different routes: Novis returns at once, where all
// three PHP functions raise a `ValueError` the oracle below has to catch. What
// both can be held to is the cost, which is what this row measures — the
// difference in how they refuse is named here rather than pinned, and is in the
// handoff's backlog as a divergence still to be decided.
var $beforeNegative = Core\Time::monotonic();
Core\Time::sleep(Core\Time\Duration::milliseconds(-5));
echo "negativeCostsNoTime=", Core\Time::monotonic()->minus($beforeNegative)->toMilliseconds() < 5 ? "yes" : "no", "\n";
--ORACLE--
<?php
$before = hrtime(true);
usleep(50000);
$slept = intdiv(hrtime(true) - $before, 1000000);
echo "sleptAtLeastFortyMillis=", $slept >= 40 ? "yes" : "no", "\n";
echo "sleptUnderFiveSeconds=", $slept < 5000 ? "yes" : "no", "\n";

$beforeMicros = hrtime(true);
usleep(50000);
echo "microsecondSpellingAgrees=", intdiv(hrtime(true) - $beforeMicros, 1000000) >= 40 ? "yes" : "no", "\n";

$beforeNanos = hrtime(true);
time_nanosleep(0, 50000000);
echo "nanosecondSpellingAgrees=", intdiv(hrtime(true) - $beforeNanos, 1000000) >= 40 ? "yes" : "no", "\n";

$wallBefore = microtime(true);
usleep(50000);
echo "wallClockNotBehind=", microtime(true) >= $wallBefore ? "yes" : "no", "\n";

$beforeZero = hrtime(true);
time_nanosleep(0, 0);
echo "zeroCostsNoTime=", intdiv(hrtime(true) - $beforeZero, 1000000) < 5 ? "yes" : "no", "\n";

$beforeNegative = hrtime(true);
try {
    usleep(-5000);
} catch (ValueError $e) {
}
echo "negativeCostsNoTime=", intdiv(hrtime(true) - $beforeNegative, 1000000) < 5 ? "yes" : "no", "\n";
