--TEST--
$uri->resolve agrees with RFC 3986 § 5.2's transform written out by hand over the RFC's own reference parser, which is what a PHP program resolving a link against a page's URL has to write for itself — spec § 12
--FILE--
<?nvs
// PHP has no member to be differential against here: `parse_url` decomposes a
// reference and nothing recombines one, so there is no `resolve` twin to
// compare with. The oracle beside this file is therefore § 5.2's transform —
// the merge of § 5.2.3, the dot-segment removal of § 5.2.4 and the
// recomposition of § 5.3 — written out in PHP over the RFC's own Appendix B
// splitter. That makes this a genuine second implementation rather than a
// restatement of the first, which is the whole point of the pair; the same
// choice, for the same reason, is why
// `uri-compare-to-matches-a-hand-written-rfc-3986-normalization` writes § 6.2.2
// out by hand.
//
// The base is § 5.4's own, so the corpus is the RFC's table rather than a
// shape chosen here, and the rows are the *normal* examples of § 5.4.1 — what
// two implementations must agree on. § 5.4.2's abnormal half is where an
// implementation is allowed a second reading, and it is pinned against this
// one's chosen answers in
// `tests/conformance/core/uri-resolve-runs-rfc-3986-s-5-4-abnormal-table`
// rather than against a hand-written PHP that would only be agreeing with a
// choice the RFC left open.
var $base = Core\Uri::parse("http://a/b/c/d;p?q");
array<string> $refs = [
    "g:h", "g", "./g", "g/", "/g", "//g",
    "?y", "g?y", "#s", "g#s", "g?y#s", ";x", "g;x", "g;x?y#s",
    "", ".", "./", "..", "../", "../g", "../..", "../../", "../../g",
];
foreach ($refs as string $ref) {
    echo $base->resolve($ref)->toString(), "\n";
}
--ORACLE--
<?php
// RFC 3986 Appendix B's regular expression, which is the RFC's own reference
// parser, kept here rather than `parse_url` because a relative reference is
// exactly what `parse_url` reads differently from an RFC 3986 parser — `//g`
// and `g:h` are the two rows that would go wrong.
function split_ref(string $s): array {
    $re = '%^(([^:/?#]+):)?(//([^/?#]*))?([^?#]*)(\?([^#]*))?(#(.*))?%';
    preg_match($re, $s, $m);
    $present = static fn(int $i): bool => isset($m[$i]) && $m[$i] !== '';
    return [
        'scheme' => $present(1) ? $m[2] : null,
        'authority' => $present(3) ? ($m[4] ?? '') : null,
        'path' => $m[5] ?? '',
        'query' => $present(6) ? ($m[7] ?? '') : null,
        'fragment' => $present(8) ? ($m[9] ?? '') : null,
    ];
}

// § 5.2.4, as the RFC's own loop rather than an `explode`, because the two
// disagree over a trailing `.` and a leading `../`.
function remove_dot_segments(string $p): string {
    $out = '';
    while ($p !== '') {
        if (str_starts_with($p, '../')) {
            $p = substr($p, 3);
        } elseif (str_starts_with($p, './')) {
            $p = substr($p, 2);
        } elseif (str_starts_with($p, '/./')) {
            $p = '/' . substr($p, 3);
        } elseif ($p === '/.') {
            $p = '/';
        } elseif (str_starts_with($p, '/../')) {
            $p = '/' . substr($p, 4);
            $out = strip_last_segment($out);
        } elseif ($p === '/..') {
            $p = '/';
            $out = strip_last_segment($out);
        } elseif ($p === '.' || $p === '..') {
            $p = '';
        } else {
            $at = strpos($p, '/', $p[0] === '/' ? 1 : 0);
            if ($at === false) {
                $out .= $p;
                $p = '';
            } else {
                $out .= substr($p, 0, $at);
                $p = substr($p, $at);
            }
        }
    }
    return $out;
}

function strip_last_segment(string $out): string {
    $at = strrpos($out, '/');
    return $at === false ? '' : substr($out, 0, $at);
}

// § 5.2.3: the base's path up to its last `/`, or a root when the base has an
// authority and no path at all.
function merge(array $base, string $path): string {
    if ($base['authority'] !== null && $base['path'] === '') {
        return '/' . $path;
    }
    $at = strrpos($base['path'], '/');
    return $at === false ? $path : substr($base['path'], 0, $at + 1) . $path;
}

// § 5.2.2's transform, in the *strict* reading: a reference that names a
// scheme is its own URI even where that scheme matches the base's.
function transform(array $base, string $reference): array {
    $r = split_ref($reference);
    $t = ['scheme' => null, 'authority' => null, 'path' => '', 'query' => null];
    if ($r['scheme'] !== null) {
        $t['scheme'] = $r['scheme'];
        $t['authority'] = $r['authority'];
        $t['path'] = remove_dot_segments($r['path']);
        $t['query'] = $r['query'];
    } elseif ($r['authority'] !== null) {
        $t['authority'] = $r['authority'];
        $t['path'] = remove_dot_segments($r['path']);
        $t['query'] = $r['query'];
        $t['scheme'] = $base['scheme'];
    } else {
        if ($r['path'] === '') {
            $t['path'] = $base['path'];
            $t['query'] = $r['query'] ?? $base['query'];
        } else {
            $t['path'] = str_starts_with($r['path'], '/')
                ? remove_dot_segments($r['path'])
                : remove_dot_segments(merge($base, $r['path']));
            $t['query'] = $r['query'];
        }
        $t['authority'] = $base['authority'];
        $t['scheme'] = $base['scheme'];
    }
    $t['fragment'] = $r['fragment'];
    return $t;
}

// § 5.3, which appends nothing an absent component would have carried.
function recompose(array $t): string {
    $out = '';
    if ($t['scheme'] !== null) {
        $out .= $t['scheme'] . ':';
    }
    if ($t['authority'] !== null) {
        $out .= '//' . $t['authority'];
    }
    $out .= $t['path'];
    if ($t['query'] !== null) {
        $out .= '?' . $t['query'];
    }
    if ($t['fragment'] !== null) {
        $out .= '#' . $t['fragment'];
    }
    return $out;
}

// § 5.1: a base URI has no fragment, so there is none to strip off this one.
$base = split_ref('http://a/b/c/d;p?q');
$refs = [
    'g:h', 'g', './g', 'g/', '/g', '//g',
    '?y', 'g?y', '#s', 'g#s', 'g?y#s', ';x', 'g;x', 'g;x?y#s',
    '', '.', './', '..', '../', '../g', '../..', '../../', '../../g',
];
foreach ($refs as $ref) {
    echo recompose(transform($base, $ref)), "\n";
}
