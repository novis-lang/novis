--TEST--
Core\Str::chunk divides an ASCII subject into the same pieces str_split does, rejoining them with a separator reproduces chunk_split exactly, and both twins refuse a size of zero
--FILE--
<?nvs
// Spec § 1's `chunk` row. One member replaces three PHP functions, and the
// member's own doc comment in `nvs_stdlib::str` says why: `str_split`,
// `mb_str_split` and `chunk_split` differ only in what they count and in
// whether they hand back the pieces or a string with a separator after each
// one. So there are two claims here rather than one — that the division is
// `str_split`'s, and that `chunk_split` is this member plus a `join`, with no
// third function needed.
//
// The subjects are ASCII on purpose. `chunk` counts grapheme clusters
// (`nvs_stdlib::granularity::DEFAULT`, `rule:types/string-is-utf8`) where `str_split` counts
// bytes, and inside ASCII those are the same count; the companion case
// `str-chunk-on-clusters-diverges-from-str_split` is where they part.

// Six subjects and five sizes: the empty subject, one character, a subject
// the size divides evenly, one it does not, and one long enough that a short
// final chunk is unmistakable. The sizes reach past the longest subject, so
// "the whole subject is one chunk" is a cell rather than a special case.
array<string> $rows = ["", "a", "ab", "abcde", "abcdef", "0123456789"];
array<int> $sizes = [1, 2, 3, 5, 7];

// Each cell is the pieces joined with a `|`, then how many there were, then
// how many of them were the full width. The third number is what says only
// the *last* chunk may be short: a member that padded the tail, or that
// distributed the remainder across the pieces, agrees with the first two
// numbers on several cells and disagrees here.
foreach ($rows as string $row) {
    foreach ($sizes as int $size) {
        int $full = 0;
        foreach (Core\Str::chunk($row, $size as uint) as string $piece) {
            if (Core\Str::length($piece) == $size as uint) {
                $full = $full + 1;
            }
        }
        echo "[", Core\Str::join(Core\Str::chunk($row, $size as uint), "|"), ":", Core\Arr::count(Core\Str::chunk($row, $size as uint)), ":", $full, "]";
    }
    echo "\n";
}

// `chunk_split`, written in Novis. PHP's third function appends its separator
// after *every* chunk including the last, so the port is this member's answer
// joined by the separator with one more separator on the end — and the empty
// subject is the cell that makes the shape non-obvious, because `chunk` gives
// no chunks there and `chunk_split("")` is still the separator alone. Both
// sides print the same thirty cells, which is what says no fourth member is
// owed for it.
foreach ($rows as string $one) {
    foreach ($sizes as int $width) {
        echo "[", Core\Str::join(Core\Str::chunk($one, $width as uint), "|"), "|]";
    }
    echo "\n";
}

// The invariance that makes the division a division rather than a mapping:
// the pieces rejoined with nothing between them are the subject again, on
// every one of the thirty cells. A member that dropped a character at a
// boundary, or that emitted an extra empty chunk when the size divided
// evenly, still prints plausibly above and fails here. PHP holds it on all
// thirty as well, `implode("", str_split(…))` being the same claim in bytes.
int $held = 0;
int $cells = 0;
foreach ($rows as string $text) {
    foreach ($sizes as int $span) {
        $cells = $cells + 1;
        if (Core\Str::join(Core\Str::chunk($text, $span as uint), "") == $text) {
            $held = $held + 1;
        }
    }
}
echo $held, " of ", $cells, "\n";

// The one boundary both languages refuse rather than answer. A size of zero
// names no chunk count at all, and PHP 8 made it a `ValueError` for the same
// reason `nvs_stdlib::str` makes it a `Fault::thrown`: every other reading —
// the subject unsplit, an empty array, an endless list of empty chunks —
// hides a size that came out zero by mistake. Both sides print the refusal
// and carry on, so what is pinned is that the boundary is refused on both
// and not what either diagnostic says.
try {
    Core\Str::chunk("abc", 0);
} catch (Throwable $zero) {
    echo "refused\n";
}
--ORACLE--
<?php
$rows = ["", "a", "ab", "abcde", "abcdef", "0123456789"];
$sizes = [1, 2, 3, 5, 7];

foreach ($rows as $row) {
    foreach ($sizes as $size) {
        $full = 0;
        foreach (str_split($row, $size) as $piece) {
            if (strlen($piece) == $size) {
                $full = $full + 1;
            }
        }
        echo "[", implode("|", str_split($row, $size)), ":", count(str_split($row, $size)), ":", $full, "]";
    }
    echo "\n";
}

foreach ($rows as $one) {
    foreach ($sizes as $width) {
        echo "[", chunk_split($one, $width, "|"), "]";
    }
    echo "\n";
}

$held = 0;
$cells = 0;
foreach ($rows as $text) {
    foreach ($sizes as $span) {
        $cells = $cells + 1;
        if (implode("", str_split($text, $span)) == $text) {
            $held = $held + 1;
        }
    }
}
echo $held, " of ", $cells, "\n";

try {
    str_split("abc", 0);
} catch (ValueError $zero) {
    echo "refused\n";
}
