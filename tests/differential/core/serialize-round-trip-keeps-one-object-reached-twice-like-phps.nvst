--TEST--
An object reached twice from one array comes back as one object and not as two, which is what PHP's serialize/unserialize pair does with the same shape
--FILE--
<?nvs
// `rule:classes/graph-copy`'s "shared substructure inside the source stays shared inside the
// copy", over the array carrier rather than the object one. Both languages
// record the second route as a reference to the first rather than as a second
// copy, and the only way to see the difference is to write through one route
// and read back through the other — a duplicating copy renders identically on
// every line that does not do that.
//
// `decode` answers `mixed`, and `rule:types/conversion` refuses `as array<Cell>` because a
// runtime tag does not decide a class (`E0711`): the array is converted to
// `array<mixed>` and each element is converted where it is read, which is the
// spelling that diagnostic names.
final class Cell {
    public int $n;

    public function constructor(int $n) {
        $this->n = $n;
    }
}

var $cell = new Cell(1);
array<Cell> $row = [$cell, $cell];

var $copy = Core\Serialize::decode(Core\Serialize::encode($row)) as array<mixed>;
var $first = $copy[0] as Cell;
var $second = $copy[1] as Cell;
$first->n = 9;
echo $first->n, ",", $second->n, ",", $cell->n, "\n";

// The same node reached from two different arrays inside one encode: sharing
// is a property of the whole graph handed over, not of one container.
array<Cell> $left = [$cell];
array<Cell> $right = [$cell];
array<array<Cell>> $both = [$left, $right];

var $bothBack = Core\Serialize::decode(Core\Serialize::encode($both)) as array<mixed>;
var $viaLeft = ($bothBack[0] as array<mixed>)[0] as Cell;
var $viaRight = ($bothBack[1] as array<mixed>)[0] as Cell;
$viaLeft->n = 4;
echo $viaRight->n, ",", $cell->n, "\n";

// Two distinct cells stay two, so the line above is about sharing rather than
// about every object in a copy collapsing into one.
array<Cell> $pair = [new Cell(2), new Cell(3)];
var $pairBack = Core\Serialize::decode(Core\Serialize::encode($pair)) as array<mixed>;
var $pairFirst = $pairBack[0] as Cell;
var $pairSecond = $pairBack[1] as Cell;
$pairFirst->n = 5;
echo $pairFirst->n, ",", $pairSecond->n, "\n";
--ORACLE--
<?php
class Cell {
    public int $n;

    public function __construct(int $n) {
        $this->n = $n;
    }
}

$cell = new Cell(1);
$row = [$cell, $cell];

$copy = unserialize(serialize($row));
$first = $copy[0];
$second = $copy[1];
$first->n = 9;
echo $first->n, ",", $second->n, ",", $cell->n, "\n";

$left = [$cell];
$right = [$cell];
$both = [$left, $right];

$bothBack = unserialize(serialize($both));
$viaLeft = $bothBack[0][0];
$viaRight = $bothBack[1][0];
$viaLeft->n = 4;
echo $viaRight->n, ",", $cell->n, "\n";

$pair = [new Cell(2), new Cell(3)];
$pairBack = unserialize(serialize($pair));
$pairFirst = $pairBack[0];
$pairSecond = $pairBack[1];
$pairFirst->n = 5;
echo $pairFirst->n, ",", $pairSecond->n, "\n";
