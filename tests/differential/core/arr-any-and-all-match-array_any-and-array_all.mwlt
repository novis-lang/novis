--TEST--
Core\Arr::any and all answer what array_any and array_all answer, the vacuous empty-array row included
--FILE--
<?mwl
// Spec § 2's `array_any`/`array_all` rows. Both members answer `bool`, and
// `echo` renders `false` as nothing at all in either language — a rendering in
// which a row that answered nothing and a row that failed to print look the
// same. `yn` is what makes each answer a visible character, so the empty rows
// below are asserted rather than assumed.
final class Show {
    public static function yn(bool $b): string {
        if ($b) {
            return "y";
        }
        return "n";
    }
}

array<int> $nums = [3, 8, 5, 12, 7];

// A predicate satisfied by one entry, by every entry, and by none: the three
// answers the pair can give between them.
echo Show::yn(Core\Arr::any($nums, fn (int $v): bool => $v > 6)), Show::yn(Core\Arr::all($nums, fn (int $v): bool => $v > 6)), "\n";
echo Show::yn(Core\Arr::any($nums, fn (int $v): bool => $v > 0)), Show::yn(Core\Arr::all($nums, fn (int $v): bool => $v > 0)), "\n";
echo Show::yn(Core\Arr::any($nums, fn (int $v): bool => $v > 99)), Show::yn(Core\Arr::all($nums, fn (int $v): bool => $v > 99)), "\n";

// The entry that decides the answer sits first, last, and alone: an
// implementation that stopped one entry early prints plausibly against the
// middle rows above but not against these.
echo Show::yn(Core\Arr::any($nums, fn (int $v): bool => $v == 3)), Show::yn(Core\Arr::any($nums, fn (int $v): bool => $v == 7)), "\n";
echo Show::yn(Core\Arr::all($nums, fn (int $v): bool => $v != 3)), Show::yn(Core\Arr::all($nums, fn (int $v): bool => $v != 7)), "\n";

// The empty array, where the two answers are not each other's negation: `any`
// is false because no entry satisfied the predicate and `all` is true because
// none failed it. Both languages take the vacuous reading.
array<int> $empty = [];
echo Show::yn(Core\Arr::any($empty, fn (int $v): bool => $v > 0)), Show::yn(Core\Arr::all($empty, fn (int $v): bool => $v > 0)), "\n";
echo Show::yn(Core\Arr::any($empty, fn (int $v): bool => $v < 0)), Show::yn(Core\Arr::all($empty, fn (int $v): bool => $v < 0)), "\n";

// One entry, so `any` and `all` must agree with each other and with the
// predicate itself.
array<int> $one = [4];
echo Show::yn(Core\Arr::any($one, fn (int $v): bool => $v == 4)), Show::yn(Core\Arr::all($one, fn (int $v): bool => $v == 4)), "\n";
echo Show::yn(Core\Arr::any($one, fn (int $v): bool => $v == 5)), Show::yn(Core\Arr::all($one, fn (int $v): bool => $v == 5)), "\n";

// The predicate is offered the key as its second argument here as everywhere
// else, and a map's key is a name.
array<int> $map = ["a" => 1, "b" => 9, "c" => 4];
echo Show::yn(Core\Arr::any($map, fn (int $v, string $k): bool => $k == "b")), Show::yn(Core\Arr::all($map, fn (int $v, string $k): bool => $k != "b")), "\n";

// "Every entry matches" is "no entry fails", asserted as the pair of answers a
// caller would get by writing it either way: each column must read `yn` and
// never `yy` or `nn`.
echo Show::yn(Core\Arr::all($nums, fn (int $v): bool => $v > 2)), Show::yn(Core\Arr::any($nums, fn (int $v): bool => $v <= 2)), "\n";
echo Show::yn(Core\Arr::all($nums, fn (int $v): bool => $v > 4)), Show::yn(Core\Arr::any($nums, fn (int $v): bool => $v <= 4)), "\n";
--ORACLE--
<?php
function yn(bool $b): string {
    if ($b) {
        return "y";
    }
    return "n";
}

$nums = [3, 8, 5, 12, 7];

echo yn(array_any($nums, fn ($v) => $v > 6)), yn(array_all($nums, fn ($v) => $v > 6)), "\n";
echo yn(array_any($nums, fn ($v) => $v > 0)), yn(array_all($nums, fn ($v) => $v > 0)), "\n";
echo yn(array_any($nums, fn ($v) => $v > 99)), yn(array_all($nums, fn ($v) => $v > 99)), "\n";

echo yn(array_any($nums, fn ($v) => $v === 3)), yn(array_any($nums, fn ($v) => $v === 7)), "\n";
echo yn(array_all($nums, fn ($v) => $v !== 3)), yn(array_all($nums, fn ($v) => $v !== 7)), "\n";

$empty = [];
echo yn(array_any($empty, fn ($v) => $v > 0)), yn(array_all($empty, fn ($v) => $v > 0)), "\n";
echo yn(array_any($empty, fn ($v) => $v < 0)), yn(array_all($empty, fn ($v) => $v < 0)), "\n";

$one = [4];
echo yn(array_any($one, fn ($v) => $v === 4)), yn(array_all($one, fn ($v) => $v === 4)), "\n";
echo yn(array_any($one, fn ($v) => $v === 5)), yn(array_all($one, fn ($v) => $v === 5)), "\n";

$map = ["a" => 1, "b" => 9, "c" => 4];
echo yn(array_any($map, fn ($v, $k) => $k === "b")), yn(array_all($map, fn ($v, $k) => $k !== "b")), "\n";

echo yn(array_all($nums, fn ($v) => $v > 2)), yn(array_any($nums, fn ($v) => $v <= 2)), "\n";
echo yn(array_all($nums, fn ($v) => $v > 4)), yn(array_any($nums, fn ($v) => $v <= 4)), "\n";
