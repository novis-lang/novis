--TEST--
Core\Arr::groupBy builds the buckets the hand-written PHP loop builds, each entry keeping its own key rather than being appended
--FILE--
<?nvs
// Spec § 2's `groupBy` against the loop it replaces — the one member of the
// class whose **Replaces** column says "nothing", so the oracle is the userland
// helper every PHP codebase has a copy of rather than a built-in. Which copy
// matters: the helper is usually written `$out[$g][] = $v`, and `groupBy` keeps
// each entry under its own key instead. That is not a detail of the rendering,
// it is the member's stated rule — a partition cannot collide two entries, so
// there is nothing for a renumbering to protect against and `Arr::values` over
// a bucket recovers the list while the other direction is lost. The oracle
// below is therefore the key-preserving spelling, and this case is what says
// the two agree.
final class Band {
    public static function of(int $n): string {
        if ($n > 4) {
            return "high";
        }
        return "low";
    }
}

final class Render {
    public static function groups(array<array<int>> $g): string {
        var $out = "";
        foreach ($g as string $name => array<int> $bucket) {
            $out = $out . $name . "{";
            foreach ($bucket as string $k => int $v) {
                $out = $out . $k . "=" . $v . ";";
            }
            $out = $out . "}";
        }
        return $out;
    }
}

// Buckets come out in first-occurrence order — the order the answers appeared
// in, not a sorted one — and each keeps the subject's own keys.
array<int> $scores = ["ann" => 3, "bob" => 8, "cy" => 5, "dee" => 8];
echo Render::groups(Core\Arr::groupBy($scores, fn(int $n): string => Band::of($n))), "\n";

// The row the naive helper fails: over a *list*, the entries keep the positions
// they had rather than being renumbered inside each bucket, so `1` and `3` name
// entries of the second bucket and no bucket starts at zero twice.
array<int> $list = [10, 3, 20, 4];
echo Render::groups(Core\Arr::groupBy($list, fn(int $n): string => Band::of($n))), "\n";

// The callback is offered `($value, $key)` and may take both, which is what
// removes the flag argument PHP's own filtering functions need.
echo Render::groups(Core\Arr::groupBy($scores, fn(int $n, string $k): string => Core\Str::at($k, 0))), "\n";

// One entry per subject entry, counted across the buckets rather than read off
// them: a partition loses nothing and duplicates nothing.
echo Core\Arr::count(Core\Arr::groupBy($scores, fn(int $n): string => Band::of($n))), "|",
     Core\Arr::count(Core\Arr::flattenDeep(Core\Arr::groupBy($scores, fn(int $n): string => Band::of($n)))), "\n";

// Nothing to partition yields no buckets rather than one empty bucket.
array<int> $empty = [];
echo "[", Render::groups(Core\Arr::groupBy($empty, fn(int $n): string => Band::of($n))), "]\n";
--ORACLE--
<?php
function band(int $n): string {
    if ($n > 4) {
        return "high";
    }
    return "low";
}

function group_by(array $a, callable $key): array {
    $out = [];
    foreach ($a as $k => $v) {
        $out[$key($v, $k)][$k] = $v;
    }
    return $out;
}

function render(array $g): string {
    $out = "";
    foreach ($g as $name => $bucket) {
        $out = $out . $name . "{";
        foreach ($bucket as $k => $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        $out = $out . "}";
    }
    return $out;
}

$scores = ["ann" => 3, "bob" => 8, "cy" => 5, "dee" => 8];
echo render(group_by($scores, fn(int $n): string => band($n))), "\n";

$list = [10, 3, 20, 4];
echo render(group_by($list, fn(int $n): string => band($n))), "\n";

echo render(group_by($scores, fn(int $n, string $k): string => substr($k, 0, 1))), "\n";

echo count(group_by($scores, fn(int $n): string => band($n))), "|",
     count($scores), "\n";

$empty = [];
echo "[", render(group_by($empty, fn(int $n): string => band($n))), "]\n";
