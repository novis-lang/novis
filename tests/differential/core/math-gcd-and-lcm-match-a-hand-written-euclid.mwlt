--TEST--
Core\Math::gcd and Core\Math::lcm answer what Euclid's algorithm written out in PHP does, over both signs, both zeros and the magnitude where the least common multiple stops fitting an int
--FILE--
<?mwl
// Spec § 3's `gcd` and `lcm` rows name `gmp_gcd` and `gmp_lcm` as the twins,
// and neither can be asked here: `gmp` is a PHP extension, absent from the
// `php` on this host's PATH, so a case calling it would die rather than
// disagree. The oracle is therefore the same shape the `Core\Path::normalize`
// case uses — a second implementation written out in PHP — which is honest
// for these two members because the definition is four lines and is not the
// thing under test. What is under test is every edge around it: which sign the
// answer carries, what a zero argument means, and where `lcm` stops fitting.

final class Show {
    // `lcm` throws where the answer is past `int`'s largest value
    // (`math.rs:960`), so the rendering both languages share is the word, not
    // the number. PHP has no throw to catch — an integer overflow there
    // becomes a `float` — so the oracle tests for that instead, which is the
    // same question asked the way each language answers it.
    public static function lcm(int $a, int $b): string {
        try {
            return Core\Math::lcm($a, $b) as string;
        } catch (Throwable $over) {
            return "refused";
        }
    }
}

// The textbook pairs, where the two members are each other's complement:
// `gcd` shrinks to the shared factors and `lcm` grows to hold both.
echo Core\Math::gcd(12, 18), " ", Core\Math::gcd(48, 18), " ", Core\Math::gcd(17, 5), " ", Core\Math::gcd(270, 192), "\n";
echo Core\Math::lcm(4, 6), " ", Core\Math::lcm(21, 6), " ", Core\Math::lcm(17, 5), " ", Core\Math::lcm(270, 192), "\n";

// A zero argument. `gcd($a, 0)` is `$a` because every integer divides zero, so
// zero is the identity that keeps `gcd` associative; `lcm($a, 0)` is `0`
// because zero is the only common multiple there is. `gcd(0, 0)` is `0` by the
// same convention, and it is the one input where the set of common divisors is
// unbounded.
echo Core\Math::gcd(0, 5), " ", Core\Math::gcd(5, 0), " ", Core\Math::gcd(0, 0), "\n";
echo Core\Math::lcm(0, 5), " ", Core\Math::lcm(5, 0), " ", Core\Math::lcm(0, 0), "\n";

// Both signs, in both positions. Neither answer is ever negative — a divisor
// and a multiple are magnitudes — so all four sign combinations of one pair
// give one answer, which is the row that fails for an implementation carrying
// a sign out of its remainder loop.
echo Core\Math::gcd(-12, 18), " ", Core\Math::gcd(12, -18), " ", Core\Math::gcd(-12, -18), "\n";
echo Core\Math::lcm(-4, 6), " ", Core\Math::lcm(4, -6), " ", Core\Math::lcm(-4, -6), "\n";

// One argument dividing the other, and one pair coprime — the two ends of the
// range, where `gcd` is the smaller argument and `lcm` the larger, and where
// `gcd` is `1` and `lcm` the product.
echo Core\Math::gcd(7, 49), " ", Core\Math::lcm(7, 49), " ", Core\Math::gcd(9, 28), " ", Core\Math::lcm(9, 28), "\n";

// The magnitude where `lcm` stops fitting, named on both sides of its bound.
// `2 ** 62` and `2` share a factor, so their least common multiple is the
// larger of them and fits; `2 ** 62` and `3` are coprime, so theirs is three
// times a number already a quarter of the range, and is refused rather than
// wrapped. `gcd` has no such bound — its answer is at most its smaller
// argument.
echo Show::lcm(4611686018427387904, 2), " ", Show::lcm(4611686018427387904, 3), "\n";
echo Core\Math::gcd(4611686018427387904, 3), " ", Core\Math::gcd(4611686018427387904, 2), "\n";

// Four properties over every ordered pair drawn from one table, asserted by
// *counting* so that a member answering plausibly row by row above still fails
// here. The table spans both signs, a zero, a prime, a prime square and two
// composites with a shared factor.
//
//  - commutativity: neither member reads its arguments in an order;
//  - `gcd` divides both arguments — and is `0` only when both are;
//  - `lcm` is a multiple of both arguments — and is `0` only when one is;
//  - the product identity, `gcd * lcm == |a * b|`, which is what ties the two
//    members to each other rather than each to itself.
//
// The row total is printed beside the four counts, so a sweep that silently
// stopped short cannot agree with itself.
array<int> $table = [0, 1, 2, 6, 12, 18, 35, 49, -8, -15];
int $commutes = 0;
int $divides = 0;
int $multiple = 0;
int $product = 0;
int $pairs = 0;
foreach ($table as int $a) {
    foreach ($table as int $b) {
        $pairs = $pairs + 1;
        var $g = Core\Math::gcd($a, $b);
        var $l = Core\Math::lcm($a, $b);
        if ($g == Core\Math::gcd($b, $a) && $l == Core\Math::lcm($b, $a)) {
            $commutes = $commutes + 1;
        }
        if ($g == 0) {
            if ($a == 0 && $b == 0) {
                $divides = $divides + 1;
            }
        } else {
            if ($a % $g == 0 && $b % $g == 0) {
                $divides = $divides + 1;
            }
        }
        if ($l == 0) {
            if ($a == 0 || $b == 0) {
                $multiple = $multiple + 1;
            }
        } else {
            if ($l % $a == 0 && $l % $b == 0) {
                $multiple = $multiple + 1;
            }
        }
        var $p = $a * $b;
        if ($g * $l == (($p < 0) ? (0 - $p) : $p)) {
            $product = $product + 1;
        }
    }
}
echo $commutes, " ", $divides, " ", $multiple, " ", $product, " ", $pairs, "\n";
--ORACLE--
<?php
function mwl_gcd(int $a, int $b): int {
    $a = $a < 0 ? -$a : $a;
    $b = $b < 0 ? -$b : $b;
    while ($b != 0) {
        $t = $a % $b;
        $a = $b;
        $b = $t;
    }
    return $a;
}

function mwl_lcm(int $a, int $b) {
    $a = $a < 0 ? -$a : $a;
    $b = $b < 0 ? -$b : $b;
    if ($a == 0 || $b == 0) {
        return 0;
    }
    return intdiv($a, mwl_gcd($a, $b)) * $b;
}

function show_lcm(int $a, int $b): string {
    $r = mwl_lcm($a, $b);
    if (is_float($r)) {
        return "refused";
    }
    return (string) $r;
}

echo mwl_gcd(12, 18), " ", mwl_gcd(48, 18), " ", mwl_gcd(17, 5), " ", mwl_gcd(270, 192), "\n";
echo mwl_lcm(4, 6), " ", mwl_lcm(21, 6), " ", mwl_lcm(17, 5), " ", mwl_lcm(270, 192), "\n";

echo mwl_gcd(0, 5), " ", mwl_gcd(5, 0), " ", mwl_gcd(0, 0), "\n";
echo mwl_lcm(0, 5), " ", mwl_lcm(5, 0), " ", mwl_lcm(0, 0), "\n";

echo mwl_gcd(-12, 18), " ", mwl_gcd(12, -18), " ", mwl_gcd(-12, -18), "\n";
echo mwl_lcm(-4, 6), " ", mwl_lcm(4, -6), " ", mwl_lcm(-4, -6), "\n";

echo mwl_gcd(7, 49), " ", mwl_lcm(7, 49), " ", mwl_gcd(9, 28), " ", mwl_lcm(9, 28), "\n";

echo show_lcm(4611686018427387904, 2), " ", show_lcm(4611686018427387904, 3), "\n";
echo mwl_gcd(4611686018427387904, 3), " ", mwl_gcd(4611686018427387904, 2), "\n";

$table = [0, 1, 2, 6, 12, 18, 35, 49, -8, -15];
$commutes = 0;
$divides = 0;
$multiple = 0;
$product = 0;
$pairs = 0;
foreach ($table as $a) {
    foreach ($table as $b) {
        $pairs = $pairs + 1;
        $g = mwl_gcd($a, $b);
        $l = mwl_lcm($a, $b);
        if ($g == mwl_gcd($b, $a) && $l == mwl_lcm($b, $a)) {
            $commutes = $commutes + 1;
        }
        if ($g == 0) {
            if ($a == 0 && $b == 0) {
                $divides = $divides + 1;
            }
        } else {
            if ($a % $g == 0 && $b % $g == 0) {
                $divides = $divides + 1;
            }
        }
        if ($l == 0) {
            if ($a == 0 || $b == 0) {
                $multiple = $multiple + 1;
            }
        } else {
            if ($l % $a == 0 && $l % $b == 0) {
                $multiple = $multiple + 1;
            }
        }
        $p = $a * $b;
        if ($g * $l == (($p < 0) ? (0 - $p) : $p)) {
            $product = $product + 1;
        }
    }
}
echo $commutes, " ", $divides, " ", $multiple, " ", $product, " ", $pairs, "\n";
