--TEST--
Core\Regex\Match::groups answers preg_match's $matches — the same keys, the same order and the same values — but only against PREG_UNMATCHED_AS_NULL, which ADR 0063 R11 makes the one reading rather than an opt-in flag
--FILE--
<?nvs
// Spec § 5's `groups` row and ADR 0063 R3, R5 and R11. There is no `$matches`
// out-parameter here — the match is the return value — and there are no
// `PREG_*` constants either, so `groups()` has to pick one of the two shapes
// `preg_match` can be asked for. It picks the flagged one, and the whole point
// of this case is that the choice is not arbitrary: under
// `PREG_UNMATCHED_AS_NULL` the two agree on every cell of the table below,
// and under PHP's default they disagree on six of its twelve rows.
//
// The default trims *trailing* unmatched groups out of `$matches` entirely and
// writes `""` for the ones in the middle, which conflates three different
// answers — "the group is not declared", "the group is declared and did not
// participate" and "the group participated and captured nothing". R5's `?T`
// separates the second from the third and R4's throw separates the first, so
// the flagged shape is the only one `group()` can be built on.

// Twelve rows: named beside numbered, an unmatched group in the middle and
// two at the end, a named group that did not participate, a nested group set,
// a group that participated and captured the empty string, a non-capturing
// group taking no number at all, an alternation whose losing branch is
// declared, an all-named pattern, an empty subject, and one that does not
// match at all. Each row's pattern is written without delimiters because § 5
// removed them; the oracle wraps each in `/…/` to hand it to PCRE.
array<array<string>> $rows = [
    ["order 4711 shipped", "(?<kind>[a-z]+) (\\d+)"],
    ["abc", "([a-z]+)(\\d+)?"],
    ["b", "(a)?(b)"],
    ["x", "(x)(y)?(z)?"],
    ["x", "(?<a>x)(?<b>y)?"],
    ["ab", "((a)(b))"],
    ["ab", "(a)(z*)(b)"],
    ["2026-08-26", "(?<y>\\d{4})-(?<m>\\d{2})-(?<d>\\d{2})"],
    ["zzz", "(\\d+)"],
    ["aXb", "(a)(?:X)(b)"],
    ["cab", "(a)|(c)"],
    ["", "(a)?"],
];

// Each line is every entry in iteration order, then the entry count in
// parentheses. The count is what makes trimming visible: a reading that
// dropped the trailing unmatched groups prints a smaller number on four of
// the twelve rows, six entries short across the table. `NULL` and `EMPTY` are
// spelled out because the difference between them is the claim — `echo`
// renders both as nothing at all.
int $entries = 0;
int $absent = 0;
int $empty = 0;
int $leads = 0;
int $matched = 0;
foreach ($rows as array<string> $row) {
    var $found = Core\Regex::match($row["0"], $row["1"]);
    if ($found == null) {
        echo "no match\n";
    } else {
        $matched = $matched + 1;
        foreach ($found->groups() as string $key => ?string $value) {
            $entries = $entries + 1;
            echo $key, "=";
            if ($value == null) {
                $absent = $absent + 1;
                echo "NULL";
            } else {
                if ($value == "") {
                    $empty = $empty + 1;
                    echo "EMPTY";
                } else {
                    echo $value;
                }
            }
            echo " ";
        }
        // The whole match leads, under the key every other group is numbered
        // from. Novis asserts one conjunct more than the oracle can: the entry
        // at that key is `text()`, which on PHP's side is `$matches[0]` by
        // definition and so cannot be checked against itself. The number the
        // two print is the same either way, and the extra conjunct can only
        // subtract from Novis's.
        if (Core\Arr::firstKey($found->groups()) == "0") {
            if ($found->groups()["0"] == $found->text()) {
                $leads = $leads + 1;
            }
        }
        echo "(", Core\Arr::count($found->groups()) as string, ")\n";
    }
}

// The three counts across the whole table. `absent` is the one the default
// reading gets wrong in both directions at once — it drops six of these eight
// entries and rewrites the other two as `EMPTY`, which moves `empty` from 2
// to 4 in the same pass.
echo $entries, " entries, ", $absent, " absent, ", $empty, " empty\n";
echo $leads, " of ", $matched, " led with the whole match under key 0\n";

// A named group is reachable under its name *and* its number, which is why
// the entry count exceeds the group count on the named rows: § 5 says
// `groups()` is in `preg_match`'s own order, and PHP emits the name first.
// Counted rather than read off a line, because the pair only shows up on the
// rows that have a name at all.
int $named = 0;
foreach ($rows as array<string> $pair) {
    var $one = Core\Regex::match($pair["0"], $pair["1"]);
    if ($one != null) {
        foreach ($one->groups() as string $name => ?string $text) {
            if (Core\Regex::matches($name, "^[0-9]+$")) {
                continue;
            }
            $named = $named + 1;
        }
    }
}
echo $named, " entries are keyed by a name rather than a number\n";
--ORACLE--
<?php
$rows = [
    ["order 4711 shipped", "(?<kind>[a-z]+) (\\d+)"],
    ["abc", "([a-z]+)(\\d+)?"],
    ["b", "(a)?(b)"],
    ["x", "(x)(y)?(z)?"],
    ["x", "(?<a>x)(?<b>y)?"],
    ["ab", "((a)(b))"],
    ["ab", "(a)(z*)(b)"],
    ["2026-08-26", "(?<y>\\d{4})-(?<m>\\d{2})-(?<d>\\d{2})"],
    ["zzz", "(\\d+)"],
    ["aXb", "(a)(?:X)(b)"],
    ["cab", "(a)|(c)"],
    ["", "(a)?"],
];

$entries = 0;
$absent = 0;
$empty = 0;
$leads = 0;
$matched = 0;
foreach ($rows as $row) {
    $found = [];
    if (preg_match("/" . $row[1] . "/", $row[0], $found, PREG_UNMATCHED_AS_NULL) !== 1) {
        echo "no match\n";
    } else {
        $matched = $matched + 1;
        foreach ($found as $key => $value) {
            $entries = $entries + 1;
            echo $key, "=";
            if ($value === null) {
                $absent = $absent + 1;
                echo "NULL";
            } else {
                if ($value === "") {
                    $empty = $empty + 1;
                    echo "EMPTY";
                } else {
                    echo $value;
                }
            }
            echo " ";
        }
        if (array_key_first($found) === 0) {
            $leads = $leads + 1;
        }
        echo "(", count($found), ")\n";
    }
}

echo $entries, " entries, ", $absent, " absent, ", $empty, " empty\n";
echo $leads, " of ", $matched, " led with the whole match under key 0\n";

$named = 0;
foreach ($rows as $pair) {
    $one = [];
    if (preg_match("/" . $pair[1] . "/", $pair[0], $one, PREG_UNMATCHED_AS_NULL) === 1) {
        foreach ($one as $name => $text) {
            if (preg_match('/^[0-9]+$/', (string) $name) === 1) {
                continue;
            }
            $named = $named + 1;
        }
    }
}
echo $named, " entries are keyed by a name rather than a number\n";
