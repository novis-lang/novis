--TEST--
Core\Arr::hasKey answers what array_key_exists answers, for both key types
--FILE--
<?nvs
array<int> $map = ["b" => 2, "a" => 1];
array<int> $list = [10, 20, 30];

echo Core\Arr::hasKey($map, "a") as string, "|", Core\Arr::hasKey($map, "z") as string, "|\n";
echo Core\Arr::hasKey($list, 0) as string, "|", Core\Arr::hasKey($list, 2) as string, "|", Core\Arr::hasKey($list, 9) as string, "|\n";

unset($list[1]);
echo Core\Arr::hasKey($list, 1) as string, "|", Core\Arr::hasKey($list, 2) as string, "|\n";
--ORACLE--
<?php
$map = ["b" => 2, "a" => 1];
$list = [10, 20, 30];

echo array_key_exists("a", $map), "|", array_key_exists("z", $map), "|\n";
echo array_key_exists(0, $list), "|", array_key_exists(2, $list), "|", array_key_exists(9, $list), "|\n";

unset($list[1]);
echo array_key_exists(1, $list), "|", array_key_exists(2, $list), "|\n";
