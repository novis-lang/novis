--TEST--
Decoding an object builds it by assignment rather than by construction, so the constructor runs once per new and never on the way back — the same count PHP's unserialize reports
--FILE--
<?nvs
// ADR 0023 § 2's "never runs a constructor". The copy is built by direct
// assignment into the new instance's storage, which is why the operation does
// not reopen definite-property-initialization: the properties arrive already
// populated. PHP's unserialize builds an instance the same way, so the two
// agree on the one thing a constructor with a side effect can report — how
// many times it ran.
final class Counter {
    public int $n;
    public string $tag;

    public function constructor(int $n, string $tag) {
        $this->n = $n;
        $this->tag = $tag;
        echo "[built ", $tag, "]";
    }
}

var $one = new Counter(7, "one");
echo "\n";

// One decode, no second "[built …]" — and the properties are the ones the
// constructor left, not the ones a re-run would produce.
var $back = Core\Serialize::decode(Core\Serialize::encode($one)) as Counter;
echo $back->n, ",", $back->tag, "\n";

// A nested object is built the same way, so a graph of three is still one
// "[built …]" per `new` and none per decode.
final class Pair {
    public Counter $left;
    public Counter $right;

    public function constructor(Counter $left, Counter $right) {
        $this->left = $left;
        $this->right = $right;
        echo "[paired]";
    }
}

var $pair = new Pair(new Counter(1, "l"), new Counter(2, "r"));
echo "\n";
var $pairBack = Core\Serialize::decode(Core\Serialize::encode($pair)) as Pair;
echo $pairBack->left->tag, $pairBack->right->tag, $pairBack->left->n + $pairBack->right->n, "\n";
--ORACLE--
<?php
class Counter {
    public int $n;
    public string $tag;

    public function __construct(int $n, string $tag) {
        $this->n = $n;
        $this->tag = $tag;
        echo "[built ", $tag, "]";
    }
}

$one = new Counter(7, "one");
echo "\n";

$back = unserialize(serialize($one));
echo $back->n, ",", $back->tag, "\n";

class Pair {
    public Counter $left;
    public Counter $right;

    public function __construct(Counter $left, Counter $right) {
        $this->left = $left;
        $this->right = $right;
        echo "[paired]";
    }
}

$pair = new Pair(new Counter(1, "l"), new Counter(2, "r"));
echo "\n";
$pairBack = unserialize(serialize($pair));
echo $pairBack->left->tag, $pairBack->right->tag, $pairBack->left->n + $pairBack->right->n, "\n";
