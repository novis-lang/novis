--TEST--
`Core\Hash\Stream` answers for every algorithm what `hash_init`/`hash_update`/`hash_final` answer when an empty update is placed before, between and after every real one, and a stream updated only with empty subjects finishes as the empty digest (spec § 11, ADR 0009 § 1)
--FILE--
<?nvs
// `hash-stream-matches-hash_init-update-and-final` already sweeps the chunk
// *widths* — one octet at a time through wider than the subject — for three
// algorithms. Two things it cannot ask, because `Core\Str::chunk` never yields
// an empty part: what an empty `update` does, and whether the incremental form
// reaches the whole roster rather than the three that case names.
//
// Both are the same bug when they go wrong. A stream carries a partial block
// between updates, and the update that contributes nothing is the one that can
// still flush it, reset it or count it — so an empty update is placed here
// before the first real one, after every real one, and after the last, where a
// naive buffer would move exactly once too often.
final class Show {
    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }

    // The subject in `$size`-octet chunks, with an empty update surrounding
    // every one of them.
    public static function padded(Core\Digest $algo, string $s, uint $size): string {
        var $stream = Core\Hash::stream($algo);
        $stream->update("");
        foreach (Core\Str::chunk($s, $size) as string $part) {
            $stream->update($part);
            $stream->update("");
        }
        $stream->update("");
        return Core\Encoding::toHex($stream->finish());
    }

    // Three updates that contribute no octets at all, which has to be the
    // empty subject's digest and not the digest of anything else.
    public static function emptyOnly(Core\Digest $algo): string {
        var $stream = Core\Hash::stream($algo);
        $stream->update("");
        $stream->update("");
        $stream->update("");
        return Core\Encoding::toHex($stream->finish());
    }
}

// Every algorithm PHP can compute, in spec § 11's roster order — the whole
// table rather than one row per family, because the incremental form is a
// second implementation of each and this is the only case that asks all of
// them. `Digest::Blake3` is absent for the roster's own reason: PHP cannot
// compute it.
array<Core\Digest> $algos = [
    Core\Digest::Crc32,
    Core\Digest::Crc32c,
    Core\Digest::Md5,
    Core\Digest::Sha1,
    Core\Digest::Sha224,
    Core\Digest::Sha256,
    Core\Digest::Sha384,
    Core\Digest::Sha512,
    Core\Digest::Sha512_224,
    Core\Digest::Sha512_256,
    Core\Digest::Sha3_224,
    Core\Digest::Sha3_256,
    Core\Digest::Sha3_384,
    Core\Digest::Sha3_512,
];

// The empty subject — where every update is an empty one — a subject shorter
// than the wider chunk, the 56-octet vector whose padding needs a second
// SHA-256 block, and one that leaves a partial tail under both widths.
array<string> $subjects = [
    "",
    "abc",
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    "The quick brown fox jumps over the lazy dog",
];

// One octet at a time, so an empty update falls between every pair of octets,
// and a width that divides none of the block sizes.
array<uint> $widths = [1, 16];

foreach ($subjects as string $s) {
    foreach ($widths as uint $size) {
        echo "n", Core\Str::length($s), "w", $size, ":";
        foreach ($algos as Core\Digest $algo) {
            echo Show::padded($algo, $s, $size), "|";
        }
        echo "\n";
    }
}

echo "empty-only:";
foreach ($algos as Core\Digest $algo) {
    echo Show::emptyOnly($algo), "|";
}
echo "\n";

// The invariant the rows are evidence for, counted over all fourteen
// algorithms and both widths: an empty update is not an event. A stream that
// flushed its partial block on one would print a plausible digest for the
// one-octet width — where every block is flushed anyway — and fail here on
// the sixteen.
int $held = 0;
int $cells = 0;
foreach ($subjects as string $s) {
    foreach ($widths as uint $size) {
        foreach ($algos as Core\Digest $algo) {
            $cells = $cells + 1;
            if (Show::padded($algo, $s, $size)
                == Core\Encoding::toHex(Core\Hash::of($s, $algo))) {
                $held = $held + 1;
            }
        }
    }
}
echo $held, " of ", $cells, "\n";
--ORACLE--
<?php
function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

// `str_split` answers the empty list for the empty subject on PHP 8.2 and
// later, so the empty row streams only the surrounding empty updates on this
// side too.
function padded($algo, $s, $size) {
    $ctx = hash_init($algo);
    hash_update($ctx, "");
    foreach (str_split($s, $size) as $part) {
        hash_update($ctx, $part);
        hash_update($ctx, "");
    }
    hash_update($ctx, "");
    return hash_final($ctx);
}

function emptyOnly($algo) {
    $ctx = hash_init($algo);
    hash_update($ctx, "");
    hash_update($ctx, "");
    hash_update($ctx, "");
    return hash_final($ctx);
}

$algos = [
    "crc32b",
    "crc32c",
    "md5",
    "sha1",
    "sha224",
    "sha256",
    "sha384",
    "sha512",
    "sha512/224",
    "sha512/256",
    "sha3-224",
    "sha3-256",
    "sha3-384",
    "sha3-512",
];

$subjects = [
    "",
    "abc",
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    "The quick brown fox jumps over the lazy dog",
];

$widths = [1, 16];

foreach ($subjects as $s) {
    foreach ($widths as $size) {
        echo "n", strlen($s), "w", $size, ":";
        foreach ($algos as $algo) {
            echo padded($algo, $s, $size), "|";
        }
        echo "\n";
    }
}

echo "empty-only:";
foreach ($algos as $algo) {
    echo emptyOnly($algo), "|";
}
echo "\n";

$held = 0;
$cells = 0;
foreach ($subjects as $s) {
    foreach ($widths as $size) {
        foreach ($algos as $algo) {
            $cells = $cells + 1;
            if (padded($algo, $s, $size) == hash($algo, $s)) {
                $held = $held + 1;
            }
        }
    }
}
echo $held, " of ", $cells, "\n";
