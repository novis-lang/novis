--TEST--
A value bound beside the statement is stored and compared as data, exactly as SQLite3Stmt::bindValue binds one — the quote, the comment opener and the NULL included — `rule:core-classes/db-one-api` and `rule:core-classes/db-parameters`, ADR 0024 § 4
--FILE--
<?nvs
// ADR 0024 § 4's rule is that the statement text refuses `tainted` while the
// bound values accept it freely, and § 1 says why there is no escaper to reach
// for instead. What that buys is observable without any taint at all: a value
// that reads as SQL is stored verbatim and compared verbatim, which is what
// PHP's own prepared statements do too. Emulated prepares — a driver
// interpolating the value into the text — would fail the round trip below.
use Core\Db;

var $db = Db::connect("main");
$db->execute("create table t (id integer primary key, name text not null, note text)", []);

// Four spellings that would each end the literal and start something else if
// anything on the way in rendered them into the statement.
array<string> $names = [
    "o'hara",
    "he said \"hi\"",
    "x'; drop table t; --",
    "50% \\ done",
];
foreach ($names as string $name) {
    $db->execute("insert into t (name) values (?)", [$name]);
}

// Counted first, so a row a rendering swallowed fails here rather than printing
// one line short and looking plausible.
var $rows = $db->query("select id, name from t order by id", []);
echo "stored ", $rows->count(), "\n";
foreach ($rows->all() as Core\Db\Row $row) {
    echo "name ", $row->string("name") ?? "?", "\n";
}

// The other half: the bound value is compared by the engine, so the row that
// *is* the injection matches itself and the classic payload matches nothing.
var $itself = $db->query("select count(*) as n from t where name = ?", ["x'; drop table t; --"])->first();
echo "itself ", $itself?->int("n") ?? -1, "\n";
var $payload = $db->query("select count(*) as n from t where name = ?", ["' or 1=1 --"])->first();
echo "payload ", $payload?->int("n") ?? -1, "\n";

// A bound `null` is a NULL column and reads back as an absence, not as the
// four-letter text — § 6's `?T` on this side, `null` on PHP's.
$db->execute("insert into t (name, note) values (?, ?)", ["turing", null]);
var $absent = $db->query("select note from t where name = ?", ["turing"])->first();
if ($absent == null) {
    echo "note no row\n";
} else {
    echo "note ", $absent->string("note") ?? "absent", "\n";
}
--FILE nvs.toml--
# § 3: a SQLite connection's file path comes from its config block.
[capabilities.db]
connect = ["main"]

[db.main]
driver = "sqlite"
path = ":memory:"
--ORACLE--
<?php
$db = new SQLite3(':memory:');
$db->exec("create table t (id integer primary key, name text not null, note text)");

$names = [
    "o'hara",
    "he said \"hi\"",
    "x'; drop table t; --",
    "50% \\ done",
];
$insert = $db->prepare("insert into t (name) values (?)");
foreach ($names as $name) {
    $insert->reset();
    $insert->bindValue(1, $name, SQLITE3_TEXT);
    $insert->execute();
}

$result = $db->query("select id, name from t order by id");
$all = [];
while ($row = $result->fetchArray(SQLITE3_ASSOC)) {
    $all[] = $row;
}
echo "stored ", count($all), "\n";
foreach ($all as $row) {
    echo "name ", $row['name'], "\n";
}

$count = $db->prepare("select count(*) as n from t where name = ?");
$count->bindValue(1, "x'; drop table t; --", SQLITE3_TEXT);
$itself = $count->execute()->fetchArray(SQLITE3_ASSOC);
echo "itself ", $itself === false ? -1 : $itself['n'], "\n";

$count->reset();
$count->bindValue(1, "' or 1=1 --", SQLITE3_TEXT);
$payload = $count->execute()->fetchArray(SQLITE3_ASSOC);
echo "payload ", $payload === false ? -1 : $payload['n'], "\n";

$null = $db->prepare("insert into t (name, note) values (?, ?)");
$null->bindValue(1, "turing", SQLITE3_TEXT);
$null->bindValue(2, null, SQLITE3_NULL);
$null->execute();
$read = $db->prepare("select note from t where name = ?");
$read->bindValue(1, "turing", SQLITE3_TEXT);
$absent = $read->execute()->fetchArray(SQLITE3_ASSOC);
echo "note ", $absent === false ? "no row" : ($absent['note'] === null ? "absent" : $absent['note']), "\n";
