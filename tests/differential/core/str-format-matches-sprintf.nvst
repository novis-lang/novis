--TEST--
Core\Str::format answers what sprintf answers, over every conversion it keeps
--FILE--
<?nvs
echo Core\Str::format("%s has %d", "fox", 2), ";";
echo Core\Str::format("%5s|%-5s", "ab", "ab"), ";";
echo Core\Str::format("%05d|%+d|%+d", 42, 42, -42), ";";
echo Core\Str::format("%.3f|%.0f|%f", 3.14159, 2.5, 1.5), ";";
echo Core\Str::format("%e|%e", 1234.5, 0.000123), ";";
echo Core\Str::format("%g|%g|%g", 0.0001, 0.00001, 123456789.0), ";";
echo Core\Str::format("%x|%X|%o|%b", 255, 255, 8, 5), ";";
echo Core\Str::format("%u", -1), ";";
echo Core\Str::format('%1$s-%1$s-%2$s', "a", "b"), ";";
echo Core\Str::format("%'*8s", "hi"), ";";
echo Core\Str::format("%10.3f|%-8.2f|%08.3f", 3.14159, 3.14159, -3.14159), ";";
echo Core\Str::format("%%|%.2s", "abcdef"), "\n";
--ORACLE--
<?php
echo sprintf("%s has %d", "fox", 2), ";";
echo sprintf("%5s|%-5s", "ab", "ab"), ";";
echo sprintf("%05d|%+d|%+d", 42, 42, -42), ";";
echo sprintf("%.3f|%.0f|%f", 3.14159, 2.5, 1.5), ";";
echo sprintf("%e|%e", 1234.5, 0.000123), ";";
echo sprintf("%g|%g|%g", 0.0001, 0.00001, 123456789.0), ";";
echo sprintf("%x|%X|%o|%b", 255, 255, 8, 5), ";";
echo sprintf("%u", -1), ";";
echo sprintf('%1$s-%1$s-%2$s', "a", "b"), ";";
echo sprintf("%'*8s", "hi"), ";";
echo sprintf("%10.3f|%-8.2f|%08.3f", 3.14159, 3.14159, -3.14159), ";";
echo sprintf("%%|%.2s", "abcdef"), "\n";
