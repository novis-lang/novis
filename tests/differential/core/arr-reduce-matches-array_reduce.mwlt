--TEST--
Core\Arr::reduce folds what array_reduce folds, the argument order, the walk direction and the untouched empty seed included
--FILE--
<?mwl
// Spec § 2's `array_reduce` row. Both members take `($carry, $value)` in that
// order and walk left to right, so every fold below is the same program twice —
// what MWL adds is a third parameter PHP's callback cannot declare, and
// `arr-reduce-offers-the-key-where-array_reduce-offers-two-arguments` owns that.
//
// `$initial` is a required argument here and an optional one there
// (`mwl_core_arr_reduce`'s doc comment, "`U` is bound by `$initial`"): the seed
// is what binds the fold's type, so there is nothing for it to default to. Every
// row therefore passes one on both sides, which is the only shape the two share.
array<int> $nums = [3, 8, 5];

// The two folds every language writes first, from each operation's identity.
echo Core\Arr::reduce($nums, fn (int $c, int $v): int => $c + $v, 0), " ", Core\Arr::reduce($nums, fn (int $c, int $v): int => $c * $v, 1), "\n";

// A non-commutative operation, which is the row that pins *which argument is
// which*. An implementation that handed the callback `($value, $carry)` sums and
// multiplies correctly above and answers 9 rather than -15 here.
echo Core\Arr::reduce($nums, fn (int $c, int $v): int => $c - $v, 0), "\n";

// The same question asked twice more, and between them they leave the two
// arguments no room: a callback returning only its value answers the last entry,
// and one returning only its carry answers the seed with no entry in it at all.
echo Core\Arr::reduce($nums, fn (int $c, int $v): int => $v, 0), " ", Core\Arr::reduce($nums, fn (int $c, int $v): int => $c, 99), "\n";

// The nesting, spelled out. A right fold over the same callback prints
// `(3 (8 (5 s)))`; only a left fold prints this.
echo Core\Arr::reduce($nums, fn (string $c, int $v): string => "(" . $c . " " . $v . ")", "s"), "\n";

// The seed's type is the fold's type, so an `array<int>` folds into a `string`
// and nothing about the elements decides it.
echo Core\Arr::reduce($nums, fn (string $c, int $v): string => $c . $v . ",", ""), "\n";

// The empty subject: the seed comes back unchanged and the callback is never
// reached, which is the identity a fold needs and the reason this member has no
// empty case to throw on. Asserted for two seed types, because a member that
// invented a zero would still print `0` for the first.
array<int> $empty = [];
echo Core\Arr::reduce($empty, fn (int $c, int $v): int => $c + $v, 42), " ", Core\Arr::reduce($empty, fn (string $c, int $v): string => $c . $v, "seed"), "\n";

// One entry, where exactly one call is made: the bound between "the seed" above
// and every row with a walk in it.
array<int> $one = [7];
echo Core\Arr::reduce($one, fn (string $c, int $v): string => "(" . $c . " " . $v . ")", "s"), "\n";

// A map. `array_reduce` never offers its callback a key, and a two-parameter
// callback here never receives one either, so the two fold a map identically —
// in insertion order, which the subtraction below is what asserts.
array<int> $map = ["b" => 8, "a" => 2, "c" => 9];
echo Core\Arr::reduce($map, fn (int $c, int $v): int => $c + $v, 0), " ", Core\Arr::reduce($map, fn (int $c, int $v): int => $c - $v, 0), "\n";

// A gapped list, where the walk is over the entries that are live and the two
// removed ones contribute nothing to either the sum or the order.
array<int> $gapped = [10, 20, 30, 40];
unset($gapped[0]);
unset($gapped[2]);
echo Core\Arr::reduce($gapped, fn (string $c, int $v): string => $c . $v . ",", ""), "\n";

// The subject is a value and no fold touched it.
echo Core\Arr::reduce($nums, fn (string $c, int $v): string => $c . $v, ""), " ", Core\Arr::count($nums), "\n";
--ORACLE--
<?php
$nums = [3, 8, 5];

echo array_reduce($nums, fn ($c, $v) => $c + $v, 0), " ", array_reduce($nums, fn ($c, $v) => $c * $v, 1), "\n";

echo array_reduce($nums, fn ($c, $v) => $c - $v, 0), "\n";

echo array_reduce($nums, fn ($c, $v) => $v, 0), " ", array_reduce($nums, fn ($c, $v) => $c, 99), "\n";

echo array_reduce($nums, fn ($c, $v) => "(" . $c . " " . $v . ")", "s"), "\n";

echo array_reduce($nums, fn ($c, $v) => $c . $v . ",", ""), "\n";

$empty = [];
echo array_reduce($empty, fn ($c, $v) => $c + $v, 42), " ", array_reduce($empty, fn ($c, $v) => $c . $v, "seed"), "\n";

$one = [7];
echo array_reduce($one, fn ($c, $v) => "(" . $c . " " . $v . ")", "s"), "\n";

$map = ["b" => 8, "a" => 2, "c" => 9];
echo array_reduce($map, fn ($c, $v) => $c + $v, 0), " ", array_reduce($map, fn ($c, $v) => $c - $v, 0), "\n";

$gapped = [10, 20, 30, 40];
unset($gapped[0]);
unset($gapped[2]);
echo array_reduce($gapped, fn ($c, $v) => $c . $v . ",", ""), "\n";

echo array_reduce($nums, fn ($c, $v) => $c . $v, ""), " ", count($nums), "\n";
