--TEST--
Core\Csv::parse reads a record's fields exactly as str_getcsv does — a quoted separator, an embedded LF and CRLF, a doubled quote, the empty field — and turns the same two dialect knobs, spec § 12's second table
--FILE--
<?nvs
// `str_getcsv` parses one record where `Core\Csv::parse` parses a whole
// document, so every subject below is a single record with no terminator on
// it: what this case compares is the *field* grammar, and the record-separator
// half is the neighbouring `csv-parse-of-an-empty-document-diverges-from-str_getcsv`
// case's subject because that is where the two stop agreeing.
//
// PHP's `$escape` is spelled `""` at every call here. That is RFC 4180's
// dialect and it is the default `crates/nvs-stdlib/src/csv.rs`'s module doc
// records for Novis, so both sides are being asked the same question rather
// than PHP being asked about the `\` it spent a major version deprecating. That
// byte is a divergence rather than an agreement and it has its own case,
// `csv-escape-consumes-the-byte-str_getcsv-only-stops-reading-at`.
final class Show {
    // A parsed field can hold a CR or an LF, and the terminal is a sink that
    // would render those itself (`rule:tooling/terminal-output-is-a-sink`), so both sides spell them out.
    public static function of(array<string> $row): string {
        var $out = "";
        foreach ($row as string $field) {
            $out = $out . "[" . Core\Str::replaceAll($field, ["\r" => "<CR>", "\n" => "<LF>"]) . "]";
        }
        return $out;
    }
}

// One record per entry, and each entry is a corner of RFC 4180's grammar: a
// quoted field holding the separator, a doubled quote inside one, a bare LF and
// a bare CRLF inside one, an empty field in the middle and at both ends, an
// explicitly empty quoted field, and a lone quote in a field that was never
// quoted at all.
array<string> $records = [
    "a,b,c",
    "\"a,b\",c",
    "\"a\"\"b\",c",
    "\"one\ntwo\",x",
    "\"one\r\ntwo\",x",
    "a,,c",
    ",a,",
    "\"\",a",
    "a,\"b\"",
    "a\"b,c",
];

foreach ($records as string $record) {
    var $rows = Core\Csv::parse($record);
    echo Show::of($rows["0"]), "\n";
}

// The separator is one byte and it is the caller's, on both sides. A `,` inside
// a semicolon-separated record is an ordinary byte and not a field boundary,
// which is the whole point of turning the knob.
array<string> $semi = ["x;y;z", "\"a;b\";c", "a,b;c"];
foreach ($semi as string $record) {
    var $semiRows = Core\Csv::parse($record, {separator: ";"});
    echo Show::of($semiRows["0"]), "\n";
}
--ORACLE--
<?php
function show(array $row): string {
    $out = "";
    foreach ($row as $field) {
        $out = $out . "[" . strtr($field, ["\r" => "<CR>", "\n" => "<LF>"]) . "]";
    }
    return $out;
}

$records = [
    "a,b,c",
    "\"a,b\",c",
    "\"a\"\"b\",c",
    "\"one\ntwo\",x",
    "\"one\r\ntwo\",x",
    "a,,c",
    ",a,",
    "\"\",a",
    "a,\"b\"",
    "a\"b,c",
];

foreach ($records as $record) {
    echo show(str_getcsv($record, ",", "\"", "")), "\n";
}

$semi = ["x;y;z", "\"a;b\";c", "a,b;c"];
foreach ($semi as $record) {
    echo show(str_getcsv($record, ";", "\"", "")), "\n";
}
