--TEST--
Core\Str::padStart matches str_pad with STR_PAD_LEFT, oversize input included
--FILE--
<?mwl
echo Core\Str::padStart("7", 3, "0"), "\n";
echo Core\Str::padStart("1234", 3, "0"), "\n";
echo Core\Str::padStart("", 4, "-"), "\n";
echo Core\Str::padStart("ab", 5, "xy"), "\n";
--ORACLE--
<?php
echo str_pad("7", 3, "0", STR_PAD_LEFT), "\n";
echo str_pad("1234", 3, "0", STR_PAD_LEFT), "\n";
echo str_pad("", 4, "-", STR_PAD_LEFT), "\n";
echo str_pad("ab", 5, "xy", STR_PAD_LEFT), "\n";
