--TEST--
Core\Arr::underlay is PHP's `$a + $b` exactly, over string keys, integer keys and a chain of three
--FILE--
<?mwl
array<int> $a = ["x" => 1, "y" => 2];
array<int> $b = ["y" => 9, "z" => 3];
echo Core\Json::encode(Core\Arr::underlay($a, $b)), ";";

array<string> $l = [0 => "zero", 1 => "one"];
array<string> $r = [1 => "ONE", 2 => "two"];
echo Core\Json::encode(Core\Arr::underlay($l, $r)), ";";

array<int> $c = ["x" => 7];
echo Core\Json::encode(Core\Arr::underlay($a, $b, $c)), ";";

array<int> $empty = [];
echo Core\Json::encode(Core\Arr::underlay($empty, $a)), "\n";
--ORACLE--
<?php
$a = ["x" => 1, "y" => 2];
$b = ["y" => 9, "z" => 3];
echo json_encode($a + $b), ";";

$l = [0 => "zero", 1 => "one"];
$r = [1 => "ONE", 2 => "two"];
echo json_encode($l + $r), ";";

$c = ["x" => 7];
echo json_encode($a + $b + $c), ";";

$empty = [];
echo json_encode($empty + $a), "\n";
