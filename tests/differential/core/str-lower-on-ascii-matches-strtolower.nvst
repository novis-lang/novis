--TEST--
Core\Str::lower maps the same letters strtolower maps over ASCII, and stops at the same two bytes on either side of the band
--FILE--
<?nvs
// Spec § 1's `lower` against the half of its twin that is defined over ASCII.
// `str-upper-diverges-from-strtoupper` owns the other half — past ASCII the two
// part company, because PHP's byte-wise function has no case table and Novis's
// member is Unicode-aware (`rule:types/string-is-utf8`). What is left, and what this case is,
// is that over the band where PHP *does* map letters the two agree exactly,
// including at the two bytes on either side of it: `@` and `[` bracket `A`-`Z`
// in ASCII, and a member built from an arithmetic rather than a table gets one
// of them wrong while every ordinary word still looks right.
string $band = "@AZ[`az{";
echo Core\Str::lower($band), "\n";

// The ordinary rows: mixed case, and the characters that have no case at all
// passing through untouched.
echo Core\Str::lower("Hello, World!"), "|", Core\Str::lower("MiXeD 123 -_-"), "\n";

// Already-lower text is unchanged, which makes the member idempotent — asserted
// as the equality rather than read off the two spellings, so a member that
// changed anything on the second pass fails here whatever it printed.
string $twice = Core\Str::lower(Core\Str::lower("ALREADY"));
echo $twice, "|", (Core\Str::lower("already") == "already") as string, "\n";

// Lowering what was uppered is the round trip PHP callers write for a caseless
// compare, and over ASCII both languages take the same route.
echo Core\Str::lower(Core\Str::upper("Caseless Compare")), "\n";

// The empty string has no letters to map and stays empty rather than becoming
// anything else.
echo "[", Core\Str::lower(""), "]\n";
--ORACLE--
<?php
$band = "@AZ[`az{";
echo strtolower($band), "\n";

echo strtolower("Hello, World!"), "|", strtolower("MiXeD 123 -_-"), "\n";

$twice = strtolower(strtolower("ALREADY"));
echo $twice, "|", (string) (strtolower("already") == "already"), "\n";

echo strtolower(strtoupper("Caseless Compare")), "\n";

echo "[", strtolower(""), "]\n";
