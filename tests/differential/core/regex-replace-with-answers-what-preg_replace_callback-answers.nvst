--TEST--
Core\Regex::replaceWith substitutes what preg_replace_callback substitutes — the same matches, the same groups reaching the callback, and the callback's answer inserted literally on both sides
--FILE--
<?nvs
// Spec § 5's `replaceWith` row against its PHP twin. The conformance cases
// beside it pin what one callback is handed and how often; this asks whether
// PCRE would have called it over the same matches and pasted its answers in
// the same places.
//
// The callback takes a `Match` where PHP's takes a positional array, so the
// two spell the *reading* of a group differently — `$m->group("d")` against
// `$m['d']` — and the comparison is over what came back, not over how it was
// asked for. PHP's callback is given `PREG_UNMATCHED_AS_NULL` for the reason
// `regex-match-groups-is-preg_match-s-matches-under-unmatched-as-null` argues:
// without it a group that did not participate is `""`, which is also what a
// group that participated and captured nothing is.
//
// No row here puts a zero-width match directly after a non-empty one — the
// open divergence `regex-match-all-reports-the-sets-preg_match_all-reports-in-
// set-order` names, which belongs to the match iteration all four of § 5's
// iterating members share rather than to this one.

// The match's own text, wrapped, which is the callback that makes the member's
// answer a function of the match sequence alone.
echo Core\Regex::replaceWith("a1b22c", "\\d+", fn(Core\Regex\Match $m) => "<" . $m->text() . ">"), "\n";
echo Core\Regex::replaceWith("one two three", "\\w+", fn(Core\Regex\Match $m) => Core\Str::upper($m->text())), "\n";
echo Core\Regex::replaceWith("no digits here", "\\d", fn(Core\Regex\Match $m) => "!"), "\n";

// A computed answer, which is the whole reason the member exists: a template
// cannot add one to a number, and `replace`'s grammar has no way to spell it.
echo Core\Regex::replaceWith("a1b22c333", "\\d+", fn(Core\Regex\Match $m) => (($m->text() as int) + 1) as string), "\n";
echo Core\Regex::replaceWith("one two three", "\\w+", fn(Core\Regex\Match $m) => Core\Str::length($m->text()) as string), "\n";

// The groups reach the callback by name and by number alike, and a group that
// did not participate is absent rather than empty.
echo Core\Regex::replaceWith("2026-08-24", "(?<y>\\d{4})-(?<m>\\d{2})-(?<d>\\d{2})",
    fn(Core\Regex\Match $m) => ($m->group("d") ?? "?") . "." . ($m->group("m") ?? "?") . "." . ($m->group(1) ?? "?")), "\n";
echo Core\Regex::replaceWith("b ab", "(a)?(b)",
    fn(Core\Regex\Match $m) => "[" . ($m->group(1) ?? "-") . ($m->group(2) ?? "-") . "]"), "\n";

// What the callback answers goes in literally on both sides — `$1` is two
// characters, not a group reference, because the callback already held the
// groups and a second expansion pass could only corrupt text it chose.
echo Core\Regex::replaceWith("x1y", "\\d", fn(Core\Regex\Match $m) => "$1"), "\n";
echo Core\Regex::replaceWith("x1y", "\\d", fn(Core\Regex\Match $m) => "\\0"), "\n";

// `limit` counts replacements on both sides, and the callback is never called
// for a match beyond it — `0` performs none and leaves the subject alone.
echo Core\Regex::replaceWith("aaa", "a", fn(Core\Regex\Match $m) => "b", {limit: 0}), "\n";
echo Core\Regex::replaceWith("aaa", "a", fn(Core\Regex\Match $m) => "b", {limit: 1}), "\n";
echo Core\Regex::replaceWith("aaa", "a", fn(Core\Regex\Match $m) => "b", {limit: 2}), "\n";
echo Core\Regex::replaceWith("aaa", "a", fn(Core\Regex\Match $m) => "b", {limit: 9}), "\n";

// A look-behind is `rule:core-classes/regex-two-tiers`'s backtracking tier; PCRE has one engine and
// reads the same pattern, so agreement here is agreement across both of Novis's.
echo Core\Regex::replaceWith("aXbXc", "(?<=a)X", fn(Core\Regex\Match $m) => "-"), "\n";
--ORACLE--
<?php
echo preg_replace_callback('/\d+/', fn($m) => "<" . $m[0] . ">", 'a1b22c'), "\n";
echo preg_replace_callback('/\w+/', fn($m) => strtoupper($m[0]), 'one two three'), "\n";
echo preg_replace_callback('/\d/', fn($m) => "!", 'no digits here'), "\n";

echo preg_replace_callback('/\d+/', fn($m) => (string) (((int) $m[0]) + 1), 'a1b22c333'), "\n";
echo preg_replace_callback('/\w+/', fn($m) => (string) strlen($m[0]), 'one two three'), "\n";

$count = null;
echo preg_replace_callback(
    '/(?<y>\d{4})-(?<m>\d{2})-(?<d>\d{2})/',
    fn($m) => ($m['d'] ?? "?") . "." . ($m['m'] ?? "?") . "." . ($m[1] ?? "?"),
    '2026-08-24',
    -1,
    $count,
    PREG_UNMATCHED_AS_NULL
), "\n";
echo preg_replace_callback(
    '/(a)?(b)/',
    fn($m) => "[" . ($m[1] ?? "-") . ($m[2] ?? "-") . "]",
    'b ab',
    -1,
    $count,
    PREG_UNMATCHED_AS_NULL
), "\n";

echo preg_replace_callback('/\d/', fn($m) => '$1', 'x1y'), "\n";
echo preg_replace_callback('/\d/', fn($m) => '\\0', 'x1y'), "\n";

echo preg_replace_callback('/a/', fn($m) => "b", 'aaa', 0), "\n";
echo preg_replace_callback('/a/', fn($m) => "b", 'aaa', 1), "\n";
echo preg_replace_callback('/a/', fn($m) => "b", 'aaa', 2), "\n";
echo preg_replace_callback('/a/', fn($m) => "b", 'aaa', 9), "\n";

echo preg_replace_callback('/(?<=a)X/', fn($m) => "-", 'aXbXc'), "\n";
