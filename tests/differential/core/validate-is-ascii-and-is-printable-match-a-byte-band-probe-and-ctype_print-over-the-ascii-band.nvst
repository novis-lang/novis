--TEST--
Core\Validate::isAscii and ::isPrintable answer over the whole 7-bit band what a byte-band regex and ctype_print answer, so the printed set is exactly 0x20 to 0x7E on both sides and neither NUL nor DEL is in it — spec § 12
--FILE--
<?nvs
// § 12's roster keeps these two where the rest of `ctype_*` is dropped (§ 1),
// so `ctype_print` is the twin for one of them and there is none at all for
// the other — the encoding question is a byte-band regex in PHP. Both answer
// `bool`, and `echo` renders `false` as nothing in either language, so a row
// that answered nothing and a row that failed to print would look the same;
// `yn` is what makes every answer a visible character.
final class Show {
    public static function yn(bool $b): string {
        if ($b) {
            return "y";
        }
        return "n";
    }
}

// The sweep is what a handful of rows cannot answer: whether the *set* each
// member accepts is the one the other implementation accepts, rather than
// whether it agrees about a space and a tab. Every code point below `U+0080`
// is asked, NUL and DEL included, and the two lines are read as bands.
string $ascii = "";
string $printable = "";
for (int $b = 0; $b < 128; $b = $b + 1) {
    var $c = Core\Str::fromCodePoint($b as uint);
    $ascii = $ascii . Show::yn(Core\Validate::isAscii($c));
    $printable = $printable . Show::yn(Core\Validate::isPrintable($c));
}
echo $ascii, "\n", $printable, "\n";

// A member answering per character could still disagree over a *string*, so
// the same two questions are asked of texts that mix the bands: one control
// byte anywhere is what decides `isPrintable`, wherever it sits.
array<string> $texts = ["hello world", "a\tb", "x\ny", "~!@#", "0123", "\x7fend"];
foreach ($texts as string $text) {
    echo Show::yn(Core\Validate::isAscii($text)), Show::yn(Core\Validate::isPrintable($text));
}
echo "\n";

// `isAscii` alone, over the subjects `ctype_print` cannot be asked about at
// all: the empty string, and text whose printable characters are not ASCII.
// Both implementations are scanning bytes here, so they agree on all four.
array<string> $wide = ["", "plain", "héllo", "日本"];
foreach ($wide as string $subject) {
    echo Show::yn(Core\Validate::isAscii($subject));
}
echo "\n";
--ORACLE--
<?php
function yn(bool $b): string {
    if ($b) {
        return "y";
    }
    return "n";
}

// `ctype_print` is byte-wise and locale-bound; under the CLI's default `C`
// locale its printable set is `0x20` to `0x7E`, which is the band this case
// asks about. The encoding question has no `ctype_*` member at all — the
// nearest PHP has is the byte-band regex below, under `/D` so that a trailing
// newline cannot pass as the end of the subject.
$ascii = '';
$printable = '';
for ($b = 0; $b < 128; $b++) {
    $c = chr($b);
    $ascii .= yn(preg_match('/^[\x00-\x7F]*$/D', $c) === 1);
    $printable .= yn(ctype_print($c));
}
echo $ascii, "\n", $printable, "\n";

$texts = ["hello world", "a\tb", "x\ny", "~!@#", "0123", "\x7fend"];
foreach ($texts as $text) {
    echo yn(preg_match('/^[\x00-\x7F]*$/D', $text) === 1), yn(ctype_print($text));
}
echo "\n";

$wide = ["", "plain", "héllo", "日本"];
foreach ($wide as $subject) {
    echo yn(preg_match('/^[\x00-\x7F]*$/D', $subject) === 1);
}
echo "\n";
