--TEST--
Core\Math::min and max answer what PHP's two-argument min and max answer wherever the two arguments share one ordered type, argument order and the nesting of the variadic form included
--FILE--
<?nvs
// Spec § 3's `min`/`max` rows, in the two-argument form. PHP's variadic
// `min(1, 2, 3)` has no member at all (ADR 0063 R17): the two-argument form
// nests, and the array form is `Core\Arr::min`, so those two are the whole
// overlap between the languages and both are asserted below.
//
// The two members do not ask the same question. PHP compares with `<`, the
// loose comparison, so what it orders depends on how a value is *written*;
// `Core\Math::min` orders by `nvs_stdlib::ordering::compare_values`, the same
// total order `Core\Arr::min` walks an array with. Those two coincide exactly
// where both arguments share one ordered type and neither string is a numeral,
// which is every row here.
// `math-min-and-max-diverge-from-php-over-a-tie-a-numeral-string-or-an-unordered-pair`
// is where they part.
//
// Both members answer `T`, never `?T`: with two arguments there is no empty
// subject, so absence cannot arise and no `none` rendering is needed — unlike
// `Core\Arr::min`, whose empty-subject row is the other member's divergence.

final class Show {
    // `Core\Arr::min` answers `?T` where `Core\Math::min` answers `T`, so the
    // agreement row at the foot needs the guard the array member's absence
    // spelling requires (ADR 0063 R5).
    public static function num(?int $found): string {
        if ($found == null) {
            return "none";
        }
        // The checker does not carry the `== null` guard into the binding's
        // type (E0403), so the conversion — total in this branch — is what
        // states the narrowing.
        return $found as string;
    }
}

// The ordinary pair, and the same pair with its arguments swapped. A member
// that answered its first argument, or its second, prints one of these
// correctly and never both.
echo Core\Math::min(3, 5), " ", Core\Math::max(3, 5), " ", Core\Math::min(5, 3), " ", Core\Math::max(5, 3), "\n";

// Zero and a negative, the row a member comparing magnitudes rather than
// values fails.
echo Core\Math::min(-2, 0), " ", Core\Math::max(-2, 0), "\n";

// Two equal values, where `min` and `max` must agree with each other. Which of
// two *indistinguishable* equal values is answered cannot be observed; the
// tie rule itself is the other case's first row, where the two are told apart.
echo Core\Math::min(4, 4), " ", Core\Math::max(4, 4), "\n";

// Strings, where PHP's `<` falls back to `strcmp` and Novis's ordering is
// bytewise: the same answer, as long as neither operand is a numeral.
echo Core\Math::min("pear", "apple"), " ", Core\Math::max("pear", "apple"), "\n";

// Case is part of the byte sequence on both sides, so an upper-case initial
// orders below every lower-case one.
echo Core\Math::min("Ann", "ann"), " ", Core\Math::max("Ann", "ann"), "\n";

// A prefix against its extension, the bound of a bytewise comparison: the
// shorter string is the smaller one, and length alone does not decide it.
echo Core\Math::min("abc", "ab"), " ", Core\Math::max("abc", "ab"), "\n";

// Floats, where Novis's `f64::total_cmp` and PHP's `<` agree on every pair that
// is neither a `NaN` nor a signed zero — the signed zero being the other
// case's second row.
echo Core\Math::min(2.5, 0.5), " ", Core\Math::max(2.5, 0.5), "\n";

// The one pair of representations Novis's ordering lets cross, and the one PHP
// compares numerically rather than by spelling: an `int` against a `float`.
// Both parameters and the return are one `CoreTy::Var("T")`, so `T` binds to
// the first argument's type and the literal spelling `Core\Math::min(2, 1.5)`
// is `E0401` — the union is declared on the bindings, which is what lets the
// crossing be asked at all. The answer keeps its own type, which `echo` shows
// by rendering the `float` with its point and the `int` without.
int|float $whole = 2;
int|float $fraction = 1.5;
echo Core\Math::min($whole, $fraction), " ", Core\Math::max($whole, $fraction), "\n";

// The variadic form, which is where the member's absence is felt: PHP's
// `min(3, 1, 4)` is written here as a nest, and the two must answer the same
// thing for the missing arity to be a spelling difference rather than a
// semantic one.
echo Core\Math::min(Core\Math::min(3, 1), 4), " ", Core\Math::max(Core\Math::max(3, 1), 4), "\n";

// The invariant that ties this member to the array one: `Math::min($a, $b)`
// and `Arr::min([$a, $b])` order by the same comparison by construction, so a
// member that grew its own ordering answers plausibly on every row above and
// fails here.
array<int> $pair = [3, 5];
echo Show::num(Core\Arr::min($pair)), Core\Math::min(3, 5), " ", Show::num(Core\Arr::max($pair)), Core\Math::max(3, 5), "\n";

// The two properties asserted by *counting* rather than read off a line, over
// every ordered pair drawn from one table — 64 of them, repeats and the
// diagonal included. Symmetry (`min($x, $y)` is `min($y, $x)`) catches a
// member that consults its arguments positionally; consistency
// (`min($x, $y) <= max($x, $y)`) catches one whose two halves disagree about
// which direction is smaller. A member answering plausibly row by row above
// still fails a count.
array<int> $table = [3, 1, 4, 1, 5, 9, 2, 6];
int $symmetric = 0;
int $consistent = 0;
foreach ($table as int $x) {
    foreach ($table as int $y) {
        if (Core\Math::min($x, $y) == Core\Math::min($y, $x)) {
            if (Core\Math::max($x, $y) == Core\Math::max($y, $x)) {
                $symmetric = $symmetric + 1;
            }
        }
        if (Core\Math::min($x, $y) <= Core\Math::max($x, $y)) {
            $consistent = $consistent + 1;
        }
    }
}
echo $symmetric, " ", $consistent, "\n";
--ORACLE--
<?php
function show(mixed $found): string {
    if ($found === null) {
        return "none";
    }
    return (string) $found;
}

echo min(3, 5), " ", max(3, 5), " ", min(5, 3), " ", max(5, 3), "\n";

echo min(-2, 0), " ", max(-2, 0), "\n";

echo min(4, 4), " ", max(4, 4), "\n";

echo min("pear", "apple"), " ", max("pear", "apple"), "\n";

echo min("Ann", "ann"), " ", max("Ann", "ann"), "\n";

echo min("abc", "ab"), " ", max("abc", "ab"), "\n";

echo min(2.5, 0.5), " ", max(2.5, 0.5), "\n";

$whole = 2;
$fraction = 1.5;
echo min($whole, $fraction), " ", max($whole, $fraction), "\n";

echo min(min(3, 1), 4), " ", max(max(3, 1), 4), "\n";

$pair = [3, 5];
echo show(min($pair)), min(3, 5), " ", show(max($pair)), max(3, 5), "\n";

$table = [3, 1, 4, 1, 5, 9, 2, 6];
$symmetric = 0;
$consistent = 0;
foreach ($table as $x) {
    foreach ($table as $y) {
        if (min($x, $y) == min($y, $x)) {
            if (max($x, $y) == max($y, $x)) {
                $symmetric = $symmetric + 1;
            }
        }
        if (min($x, $y) <= max($x, $y)) {
            $consistent = $consistent + 1;
        }
    }
}
echo $symmetric, " ", $consistent, "\n";
