--TEST--
Core\Str::codePoints and Core\Str::fromCodePoint answer what str_split+ord and chr answer over the whole 0..127 table, both directions round-trip on every code point, and both members are injective there
--FILE--
<?mwl
// Spec § 1's `codePoints` and `fromCodePoint` rows. The twins the spec names
// are `mb_str_split`/`mb_ord` and `chr`/`mb_chr`, and the `mb_*` half is not
// callable on the Windows leg at all — but inside ASCII it is not needed,
// because a code point below 128 is one byte and the byte-wise half answers
// the same question: `str_split` plus `array_map("ord", …)` is `codePoints`,
// and `chr` is `fromCodePoint`. That coincidence is the whole reason this
// file is an oracle rather than a frozen expectation, and it ends at 128 —
// where the two members part from `chr` is the companion case,
// `str-code-points-and-from-code-point-past-ascii-diverge-from-chr`.
//
// Nothing below echoes a code point as text. Half of 0..127 is a control
// character, so every rendering here goes through `Core\Encoding::toHex`
// (PHP's `bin2hex`), which is also what makes the byte-level claim visible
// rather than implied.

// The whole table, sixteen code points to a line, as the bytes each one
// encodes to. This is the only place the answers themselves are printed; the
// rest of the file asserts properties, because a row of answers is the
// weakest thing a sweep can say. Note the first line begins `000102…`: a NUL
// is an ordinary code point here and the string that holds it is an ordinary
// string, MWL text being a counted buffer rather than a C string.
int $base = 0;
for (; $base <= 112; $base = $base + 16) {
    string $line = "";
    int $off = 0;
    for (; $off <= 15; $off = $off + 1) {
        $line = $line . Core\Str::fromCodePoint(($base + $off) as uint);
    }
    echo Core\Encoding::toHex($line as bytes), "\n";
}

// The round trip, one code point at a time, counted over all 128 rather than
// read off any single row.
//
// * **`codePoints(fromCodePoint($cp))` is exactly `[$cp]`** — one element,
//   and that element is the code point that went in. Both halves are counted
//   separately so a member answering the right *number* of the wrong values
//   still fails one of them.
// * **One byte each.** `fromCodePoint` encodes every ASCII code point to a
//   single byte, which is the claim that stops holding at 128 — U+0080 is
//   two bytes where `chr(128)` is still one — and stating it here is what
//   makes the companion file a boundary rather than a surprise.
int $cp = 0;
int $one = 0;
int $same = 0;
int $byte = 0;
int $cells = 0;
for (; $cp <= 127; $cp = $cp + 1) {
    uint $want = $cp as uint;
    string $made = Core\Str::fromCodePoint($want);
    array<uint> $points = Core\Str::codePoints($made);
    $cells = $cells + 1;
    if (Core\Arr::count($points) == 1) {
        $one = $one + 1;
    }
    if ($points["0"] == $want) {
        $same = $same + 1;
    }
    if (Core\Str::length(Core\Encoding::toHex($made as bytes)) == 2) {
        $byte = $byte + 1;
    }
}
echo $one, " ", $same, " ", $byte, " of ", $cells, "\n";

// **`fromCodePoint` is injective over the table**: 128 code points give 128
// distinct strings. A member that clamped, wrapped or truncated anywhere in
// the range answers every count above correctly on the rows it did not touch
// and fails this one, since two inputs would have collided. `chr` is
// injective here too — it stops being so at 256, where it wraps, and
// `fromCodePoint` never does at all.
array<string> $all = [];
int $each = 0;
for (; $each <= 127; $each = $each + 1) {
    $all = Core\Arr::append($all, Core\Str::fromCodePoint($each as uint));
}
echo Core\Arr::count($all), " ", Core\Arr::count(Core\Arr::unique($all)), "\n";

// Eleven subjects: the empty one, one character, a word, a sentence with
// punctuation, digits and a space, a subject that is mostly whitespace, one
// that is nothing but symbols, a lone tab, a bare CRLF, and a CRLF with text
// on both sides.
array<string> $rows = ["", "a", "Hi!", "abcdef", "Hello, World!", "12 34", "  x  ", "!@#-%^&*()", "\t", "\r\n", "a\r\nb"];

// How many code points each subject holds, bracketed so the empty subject is
// a cell rather than a gap. **This counts with `Core\Arr::count` over
// `codePoints` and not with `Core\Str::length`**, and the last two rows are
// why: `Core\Str::length` counts grapheme clusters
// (`mwl_stdlib::granularity::DEFAULT`), and CR followed by LF is *one*
// cluster and *two* code points. That pair is the one place inside ASCII
// where the class default and this member's unit part company, which is
// exactly why the member exists (`mwl_core_str_code_points`'s doc comment).
foreach ($rows as string $row) {
    echo "[", Core\Arr::count(Core\Str::codePoints($row)), "]";
}
echo "\n";

// The scalar values themselves for three of those rows, rendered through
// `Core\Json::encode` because there is no other spelling that renders an
// `array<uint>` in one piece. PHP's `json_encode` over the same list is
// byte-identical, which is what makes this an assertion rather than a dump.
echo Core\Json::encode(Core\Str::codePoints($rows["2"])), "\n";
echo Core\Json::encode(Core\Str::codePoints($rows["8"])), "\n";
echo Core\Json::encode(Core\Str::codePoints($rows["10"])), "\n";

// The round trip the other way, over the same eleven subjects and counted
// twice, because the two members named here compose two different ways:
//
// * **Through the array member.** `fromCodePoints(codePoints($s))` is `$s`,
//   which is the pair's own stated inverse relationship
//   (`mwl_core_str_from_code_points`'s doc comment).
// * **One code point at a time.** Concatenating `fromCodePoint` over each
//   element of `codePoints($s)` reproduces `$s` as well, so the array member
//   is a fused spelling of the singular one and not a second answer. This is
//   the composition that ties the two members this case is named for
//   directly to each other, with nothing in between.
//
// The empty subject is in the table on purpose: it is the bound at the
// bottom of both members, `codePoints("")` giving no elements and the way
// back giving `""`. PHP's `str_split("")` has answered `[]` rather than
// `[""]` since 8.2, so the two sides agree on that cell too.
int $back = 0;
int $piece = 0;
int $subjects = 0;
foreach ($rows as string $subject) {
    $subjects = $subjects + 1;
    if (Core\Str::fromCodePoints(Core\Str::codePoints($subject)) == $subject) {
        $back = $back + 1;
    }
    string $out = "";
    foreach (Core\Str::codePoints($subject) as uint $point) {
        $out = $out . Core\Str::fromCodePoint($point);
    }
    if ($out == $subject) {
        $piece = $piece + 1;
    }
}
echo $back, " ", $piece, " of ", $subjects, "\n";
--ORACLE--
<?php
for ($base = 0; $base <= 112; $base = $base + 16) {
    $line = "";
    for ($off = 0; $off <= 15; $off = $off + 1) {
        $line = $line . chr($base + $off);
    }
    echo bin2hex($line), "\n";
}

$one = 0;
$same = 0;
$byte = 0;
$cells = 0;
for ($cp = 0; $cp <= 127; $cp = $cp + 1) {
    $made = chr($cp);
    $points = array_map("ord", str_split($made));
    $cells = $cells + 1;
    if (count($points) == 1) {
        $one = $one + 1;
    }
    if ($points[0] === $cp) {
        $same = $same + 1;
    }
    if (strlen(bin2hex($made)) == 2) {
        $byte = $byte + 1;
    }
}
echo $one, " ", $same, " ", $byte, " of ", $cells, "\n";

$all = [];
for ($each = 0; $each <= 127; $each = $each + 1) {
    $all[] = chr($each);
}
echo count($all), " ", count(array_unique($all)), "\n";

$rows = ["", "a", "Hi!", "abcdef", "Hello, World!", "12 34", "  x  ", "!@#-%^&*()", "\t", "\r\n", "a\r\nb"];

foreach ($rows as $row) {
    echo "[", count(array_map("ord", str_split($row))), "]";
}
echo "\n";

echo json_encode(array_map("ord", str_split($rows[2]))), "\n";
echo json_encode(array_map("ord", str_split($rows[8]))), "\n";
echo json_encode(array_map("ord", str_split($rows[10]))), "\n";

$back = 0;
$piece = 0;
$subjects = 0;
foreach ($rows as $subject) {
    $subjects = $subjects + 1;
    if (implode("", array_map("chr", array_map("ord", str_split($subject)))) === $subject) {
        $back = $back + 1;
    }
    $out = "";
    foreach (array_map("ord", str_split($subject)) as $point) {
        $out = $out . chr($point);
    }
    if ($out === $subject) {
        $piece = $piece + 1;
    }
}
echo $back, " ", $piece, " of ", $subjects, "\n";
