--TEST--
Core\Math::toRadians and ::toDegrees answer what PHP's deg2rad and rad2deg answer, down to the ulp that decides which angles survive a round trip exactly
--FILE--
<?nvs
// Spec § 3's `toRadians` and `toDegrees` rows. Neither member guards its
// argument — every `float` is an angle — so what is worth asking of the pair
// is not where it stops but *how it multiplies*, because there are two
// spellings of the same conversion and they part by one ulp:
//
//   ($degrees / 180.0) * PI     two roundings, PHP's own expression
//   $degrees * (PI / 180.0)     one rounded constant, then one multiply
//
// The second is the more accurate of the two — over the 3,600 tenths of a
// degree in a turn it is closer to the true value 851 times against 118 — and
// Novis used it until this case was written. The ulp is invisible in a rendered
// float, which prints 14 significant digits on both sides, so every line
// below that echoes a number agrees under either spelling. It becomes visible
// through `==`, which is exact over `float` (ADR 0090): a round trip lands
// back on the angle it started from under PHP's spelling and one ulp short of
// it under the other. So the counted round trip is the whole point of this
// case, and the rendered tables are what say the two members are otherwise
// the same conversion. `nvs_stdlib::math`'s own doc comment records why the
// accuracy was the thing spent.

final class Show {
    // A `bool` has no rendering of its own: `bool as string` prints `false`
    // as nothing at all and `bool as int` does not lower.
    public static function yn(bool $answer): string {
        if ($answer) {
            return "y";
        }
        return "n";
    }

    // The three classes an `f64` answer falls into, so an overflow or a
    // domain answer is named rather than counted.
    public static function kind(float $value): string {
        if (Core\Math::isNan($value)) {
            return "nan";
        }
        if (Core\Math::isFinite($value)) {
            return "finite";
        }
        return "infinite";
    }
}

// The whole-turn angles plus a handful that are not multiples of anything,
// rendered. This is the agreement half: at 14 significant digits the two
// spellings of the conversion are indistinguishable, so a member that had
// picked the wrong constant entirely — degrees per radian, or PI/360 — fails
// here while the round trip below still counted something plausible.
array<float> $angles = [0.0, 1.0, 15.0, 30.0, 45.0, 60.0, 90.0, 120.0, 135.0, 180.0, 210.0, 240.0, 270.0, 315.0, 360.0, -45.0, -90.0, 0.5, 1.5, 7.25, 123.456, 1.0e8];
foreach ($angles as float $angle) {
    echo Core\Math::toRadians($angle), " ";
}
echo "|\n";

// The same table the other way, so the inverse is pinned at the same points
// rather than only through the round trip.
foreach ($angles as float $turn) {
    echo Core\Math::toDegrees($turn), " ";
}
echo "|\n";

// The round trip, counted. Nineteen of these twenty-two angles come back
// bit-identical and three do not, and *which* three is decided by the one ulp
// the two spellings differ by: under `$degrees * (PI / 180.0)` the count is
// six lower, because 15, 30, 60, 120, 210 and 240 stop coming back and
// 100000000 starts. A case that only rendered the table could not see any of
// that. Counting rather than printing each answer is what makes a single
// misplaced angle move the line.
int $exact = 0;
int $rows = 0;
foreach ($angles as float $degrees) {
    $rows = $rows + 1;
    if (Core\Math::toDegrees(Core\Math::toRadians($degrees)) == $degrees) {
        $exact = $exact + 1;
    }
}
echo $exact, " of ", $rows, "\n";

// And the round trip started from the other end. A conversion pair can be
// exact one way round and not the other, so this is its own count.
array<float> $radians = [0.0, 1.0, 2.0, 3.5, 0.001, 100.0, -1.0, 0.25, 6.0, 0.5];
int $back = 0;
int $turns = 0;
foreach ($radians as float $radian) {
    $turns = $turns + 1;
    if (Core\Math::toRadians(Core\Math::toDegrees($radian)) == $radian) {
        $back = $back + 1;
    }
}
echo $back, " of ", $turns, "\n";

// The three angles whose answer is a named constant exactly, which is what
// says the conversion is not merely close. A half turn is PI, a whole turn is
// TAU — PHP spells that `M_PI * 2` — and PI radians is 180 degrees on the
// nose. These hold under either spelling, because 180.0 and 360.0 divide
// exactly; they are here to bound the count above, not to duplicate it.
echo Show::yn(Core\Math::toRadians(180.0) == Core\Math::PI), " ", Show::yn(Core\Math::toRadians(360.0) == Core\Math::TAU), " ", Show::yn(Core\Math::toDegrees(Core\Math::PI) == 180.0), "\n";

// Neither member has a guard, so a non-finite argument is carried through
// rather than refused: an infinity keeps its sign and a `NaN` stays one.
float $huge = Core\Math::INFINITY;
float $nan = Core\Math::NAN;
float $tiny = 0.0 - $huge;
echo Show::kind(Core\Math::toRadians($huge)), " ", Show::kind(Core\Math::toRadians($tiny)), " ", Show::kind(Core\Math::toRadians($nan)), " ", Show::kind(Core\Math::toDegrees($huge)), " ", Show::kind(Core\Math::toDegrees($tiny)), " ", Show::kind(Core\Math::toDegrees($nan)), "\n";
echo Show::yn(Core\Math::toRadians($huge) == $huge), " ", Show::yn(Core\Math::toRadians($tiny) == $tiny), " ", Show::yn(Core\Math::toDegrees($huge) == $huge), " ", Show::yn(Core\Math::toDegrees($tiny) == $tiny), "\n";

// The bound the pair actually has, asserted on both sides of itself: scaling
// down by 180 leaves the largest finite float finite, and scaling up by 180
// does not. So `toDegrees` overflows where `toRadians` cannot, and the
// smallest positive normal survives one direction and underflows the other.
echo Show::kind(Core\Math::toRadians(Core\Math::FLOAT_MAX)), " ", Show::kind(Core\Math::toDegrees(Core\Math::FLOAT_MAX)), " ", Show::kind(Core\Math::toRadians(Core\Math::FLOAT_MIN)), " ", Show::kind(Core\Math::toDegrees(Core\Math::FLOAT_MIN)), "\n";
echo Core\Math::toRadians(Core\Math::FLOAT_MIN), " ", Core\Math::toDegrees(Core\Math::FLOAT_MIN), "\n";
--ORACLE--
<?php
function yn(bool $answer): string {
    if ($answer) {
        return "y";
    }
    return "n";
}

function kind(float $value): string {
    if (is_nan($value)) {
        return "nan";
    }
    if (is_finite($value)) {
        return "finite";
    }
    return "infinite";
}

$angles = [0.0, 1.0, 15.0, 30.0, 45.0, 60.0, 90.0, 120.0, 135.0, 180.0, 210.0, 240.0, 270.0, 315.0, 360.0, -45.0, -90.0, 0.5, 1.5, 7.25, 123.456, 1.0e8];
foreach ($angles as $angle) {
    echo deg2rad($angle), " ";
}
echo "|\n";

foreach ($angles as $turn) {
    echo rad2deg($turn), " ";
}
echo "|\n";

$exact = 0;
$rows = 0;
foreach ($angles as $degrees) {
    $rows = $rows + 1;
    if (rad2deg(deg2rad($degrees)) == $degrees) {
        $exact = $exact + 1;
    }
}
echo $exact, " of ", $rows, "\n";

$radians = [0.0, 1.0, 2.0, 3.5, 0.001, 100.0, -1.0, 0.25, 6.0, 0.5];
$back = 0;
$turns = 0;
foreach ($radians as $radian) {
    $turns = $turns + 1;
    if (deg2rad(rad2deg($radian)) == $radian) {
        $back = $back + 1;
    }
}
echo $back, " of ", $turns, "\n";

echo yn(deg2rad(180.0) == M_PI), " ", yn(deg2rad(360.0) == M_PI * 2), " ", yn(rad2deg(M_PI) == 180.0), "\n";

$huge = INF;
$nan = NAN;
$tiny = 0.0 - $huge;
echo kind(deg2rad($huge)), " ", kind(deg2rad($tiny)), " ", kind(deg2rad($nan)), " ", kind(rad2deg($huge)), " ", kind(rad2deg($tiny)), " ", kind(rad2deg($nan)), "\n";
echo yn(deg2rad($huge) == $huge), " ", yn(deg2rad($tiny) == $tiny), " ", yn(rad2deg($huge) == $huge), " ", yn(rad2deg($tiny) == $tiny), "\n";

echo kind(deg2rad(PHP_FLOAT_MAX)), " ", kind(rad2deg(PHP_FLOAT_MAX)), " ", kind(deg2rad(PHP_FLOAT_MIN)), " ", kind(rad2deg(PHP_FLOAT_MIN)), "\n";
echo deg2rad(PHP_FLOAT_MIN), " ", rad2deg(PHP_FLOAT_MIN), "\n";
