--TEST--
A Core\Serialize round-trip shares nothing with its source where clone shares everything one level down, and PHP's serialize/unserialize pair draws the line in the same place
--FILE--
<?nvs
// The two copies ADR 0023 distinguishes, asked the same question in one
// program: `clone` is the language's shallow copy (§ 1) and the graph copy
// shares no mutable heap state with its source (§ 2). Asserting them together
// is what makes the second one mean something — a "deep copy" that was really
// shallow prints the same as `clone` on its own line and is only caught beside
// it.
final class Tag {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }
}

final class Note {
    public string $title;
    public Tag $tag;

    public function constructor(string $title, Tag $tag) {
        $this->title = $title;
        $this->tag = $tag;
    }
}

var $original = new Note("first", new Tag("red"));
var $shallow = clone $original;
var $deep = Core\Serialize::decode(Core\Serialize::encode($original)) as Note;

// The clone's own property is its own; the object it points at is not.
$shallow->title = "second";
$shallow->tag->text = "blue";
echo $original->title, ",", $shallow->title, "|", $original->tag->text, ",", $shallow->tag->text, "\n";

// The decoded graph reaches a different Tag, so the same write stops at the
// boundary — including for the clone, which is still sharing with the source.
$deep->tag->text = "green";
echo $original->tag->text, ",", $shallow->tag->text, ",", $deep->tag->text, "\n";

// And back the other way: a write on this side does not reach the copy.
$original->tag->text = "black";
echo $shallow->tag->text, ",", $deep->tag->text, "\n";
--ORACLE--
<?php
class Tag {
    public string $text;

    public function __construct(string $text) {
        $this->text = $text;
    }
}

class Note {
    public string $title;
    public Tag $tag;

    public function __construct(string $title, Tag $tag) {
        $this->title = $title;
        $this->tag = $tag;
    }
}

$original = new Note("first", new Tag("red"));
$shallow = clone $original;
$deep = unserialize(serialize($original));

$shallow->title = "second";
$shallow->tag->text = "blue";
echo $original->title, ",", $shallow->title, "|", $original->tag->text, ",", $shallow->tag->text, "\n";

$deep->tag->text = "green";
echo $original->tag->text, ",", $shallow->tag->text, ",", $deep->tag->text, "\n";

$original->tag->text = "black";
echo $shallow->tag->text, ",", $deep->tag->text, "\n";
