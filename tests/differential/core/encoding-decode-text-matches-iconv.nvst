--TEST--
Core\Encoding::decodeText agrees with iconv() over every encoding both of them carry — spec § 7
--FILE--
<?nvs
// `Core\Encoding::decodeText(bytes $b, Charset $charset): string` is
// `iconv($charset, "UTF-8", $b)` with the target encoding gone: a Novis
// `string` is guaranteed-valid UTF-8 (`rule:types/string-is-utf8`), so the "to" half of
// `iconv`'s pair is a fact about the return type rather than an argument. The
// octets go in as hex on both sides — `Core\Encoding::fromHex` and `hex2bin`
// — because a `.nvst` file is UTF-8 and the subject of this member is not.

// The four schemes this module decodes itself, against the ones iconv names
// the same way. `héllo ☃` carries a two- and a three-byte sequence, so the
// UTF-8 row is a validation rather than an ASCII round-trip in disguise.
echo Core\Encoding::decodeText(Core\Encoding::fromHex("68c3a96c6c6f20e29883"), Core\Charset::Utf8), "\n";
echo Core\Encoding::decodeText(Core\Encoding::fromHex("68e96c6c6f"), Core\Charset::Latin1), "\n";
echo Core\Encoding::decodeText(Core\Encoding::fromHex("706c61696e"), Core\Charset::Ascii), "\n";

// Both UTF-16 orders over the same three characters, so a decoder reading the
// wrong end answers a different string rather than the same one.
echo Core\Encoding::decodeText(Core\Encoding::fromHex("6100e9000326"), Core\Charset::Utf16Le), "\n";
echo Core\Encoding::decodeText(Core\Encoding::fromHex("006100e92603"), Core\Charset::Utf16Be), "\n";

// The legacy single-byte tables, Cyrillic in both of the two encodings a
// ported program actually meets — the same six characters from two different
// octet sequences is what makes them a table rather than an offset.
echo Core\Encoding::decodeText(Core\Encoding::fromHex("be6c75bb"), Core\Charset::Iso88592), "\n";
echo Core\Encoding::decodeText(Core\Encoding::fromHex("d0d2c9d7c5d4"), Core\Charset::Koi8R), "\n";
echo Core\Encoding::decodeText(Core\Encoding::fromHex("eff0e8e2e5f2"), Core\Charset::Windows1251), "\n";

// `0x80` read two ways, which is the whole reason `Latin1` is its own case
// here rather than the WHATWG index's fold of the two: windows-1252 has the
// euro sign there and ISO-8859-1 has the C1 control, and reading the second as
// the first would answer a different string. The Latin-1 row is written as hex
// on the way out because a C1 control has no visible spelling.
echo Core\Encoding::decodeText(Core\Encoding::fromHex("80206f6b"), Core\Charset::Windows1252), "\n";
echo Core\Encoding::toHex(Core\Encoding::encodeText(Core\Encoding::decodeText(Core\Encoding::fromHex("8081"), Core\Charset::Latin1), Core\Charset::Utf8)), "\n";

// The two multi-byte Japanese tables, whose characters are not a function of
// the octets at all but of an index both implementations have to agree on.
echo Core\Encoding::decodeText(Core\Encoding::fromHex("82a08341889f"), Core\Charset::ShiftJis), "\n";
echo Core\Encoding::decodeText(Core\Encoding::fromHex("a4a2a5a2b0a1"), Core\Charset::EucJp), "\n";

// Counted rather than read off the lines above: every one of these charsets is
// ASCII-transparent, so a table that quietly stopped being consulted fails
// here even where its own row still looks plausible. Written out one charset
// at a time because a `Core\Charset` case cannot yet be held in a binding of
// its own type.
uint $ascii = 0;
if (Core\Encoding::decodeText(Core\Encoding::fromHex("6f6b"), Core\Charset::Ascii) == "ok") { $ascii = $ascii + 1; }
if (Core\Encoding::decodeText(Core\Encoding::fromHex("6f6b"), Core\Charset::Latin1) == "ok") { $ascii = $ascii + 1; }
if (Core\Encoding::decodeText(Core\Encoding::fromHex("6f6b"), Core\Charset::Iso88592) == "ok") { $ascii = $ascii + 1; }
if (Core\Encoding::decodeText(Core\Encoding::fromHex("6f6b"), Core\Charset::Koi8R) == "ok") { $ascii = $ascii + 1; }
if (Core\Encoding::decodeText(Core\Encoding::fromHex("6f6b"), Core\Charset::Windows1251) == "ok") { $ascii = $ascii + 1; }
if (Core\Encoding::decodeText(Core\Encoding::fromHex("6f6b"), Core\Charset::Windows1252) == "ok") { $ascii = $ascii + 1; }
if (Core\Encoding::decodeText(Core\Encoding::fromHex("6f6b"), Core\Charset::ShiftJis) == "ok") { $ascii = $ascii + 1; }
if (Core\Encoding::decodeText(Core\Encoding::fromHex("6f6b"), Core\Charset::EucJp) == "ok") { $ascii = $ascii + 1; }
echo "ascii=", $ascii, "/8\n";
--ORACLE--
<?php
echo iconv("UTF-8", "UTF-8", hex2bin("68c3a96c6c6f20e29883")), "\n";
echo iconv("ISO-8859-1", "UTF-8", hex2bin("68e96c6c6f")), "\n";
echo iconv("ASCII", "UTF-8", hex2bin("706c61696e")), "\n";

echo iconv("UTF-16LE", "UTF-8", hex2bin("6100e9000326")), "\n";
echo iconv("UTF-16BE", "UTF-8", hex2bin("006100e92603")), "\n";

echo iconv("ISO-8859-2", "UTF-8", hex2bin("be6c75bb")), "\n";
echo iconv("KOI8-R", "UTF-8", hex2bin("d0d2c9d7c5d4")), "\n";
echo iconv("WINDOWS-1251", "UTF-8", hex2bin("eff0e8e2e5f2")), "\n";

echo iconv("WINDOWS-1252", "UTF-8", hex2bin("80206f6b")), "\n";
echo bin2hex(iconv("ISO-8859-1", "UTF-8", hex2bin("8081"))), "\n";

echo iconv("SHIFT_JIS", "UTF-8", hex2bin("82a08341889f")), "\n";
echo iconv("EUC-JP", "UTF-8", hex2bin("a4a2a5a2b0a1")), "\n";

$sets = ["ASCII", "ISO-8859-1", "ISO-8859-2", "KOI8-R", "WINDOWS-1251", "WINDOWS-1252", "SHIFT_JIS", "EUC-JP"];
$ascii = 0;
foreach ($sets as $set) {
    if (iconv($set, "UTF-8", hex2bin("6f6b")) === "ok") { $ascii++; }
}
echo "ascii=$ascii/8\n";
