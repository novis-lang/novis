--TEST--
Core\Time::fromIso agrees with strtotime() over every ISO-8601 timestamp that carries its own offset — spec § 4
--FILE--
<?nvs
// `Core\Time::fromIso(string): Instant` is the half of `strtotime` that reads
// a timestamp naming its own instant, so no zone is passed and none is read
// from ambient state: the offset is in the text or the call is refused. Every
// row below is one `strtotime` and one `fromIso` over the same bytes.
final class Iso {
    public static function seconds(string $text): int {
        return Core\Time::fromIso($text)->toEpochSeconds();
    }
}

echo Iso::seconds("2024-02-29T13:45:07Z"), "\n";
echo Iso::seconds("2024-02-29T13:45:07+02:00"), "\n";
echo Iso::seconds("2024-02-29T13:45:07-05:00"), "\n";

// A subsecond component is read and then dropped by the *view*, not by the
// parse: `toEpochSeconds` truncates towards the epoch exactly as `strtotime`'s
// own integer does, and `toEpochMillis` is where the rest of it is.
echo Iso::seconds("2024-02-29T13:45:07.500Z"), "\n";
echo Core\Time::fromIso("2024-02-29T13:45:07.500Z")->toEpochMillis(), "\n";

// Before the epoch, and at the last second a 32-bit `time_t` held.
echo Iso::seconds("1960-06-15T23:59:59Z"), "\n";
echo Iso::seconds("2038-01-19T03:14:07+00:00"), "\n";

// The three spellings ISO-8601 admits beside the canonical one, each of which
// PHP also reads: a lower-case designator, the basic format with no
// separators, and a space where the `T` goes.
echo Iso::seconds("2024-02-29t13:45:07z"), "\n";
echo Iso::seconds("20240229T134507Z"), "\n";
echo Iso::seconds("2024-02-29 13:45:07+00:00"), "\n";
--ORACLE--
<?php
date_default_timezone_set("UTC");
echo strtotime("2024-02-29T13:45:07Z"), "\n";
echo strtotime("2024-02-29T13:45:07+02:00"), "\n";
echo strtotime("2024-02-29T13:45:07-05:00"), "\n";
echo strtotime("2024-02-29T13:45:07.500Z"), "\n";
echo strtotime("2024-02-29T13:45:07.500Z") * 1000 + 500, "\n";
echo strtotime("1960-06-15T23:59:59Z"), "\n";
echo strtotime("2038-01-19T03:14:07+00:00"), "\n";
echo strtotime("2024-02-29t13:45:07z"), "\n";
echo strtotime("20240229T134507Z"), "\n";
echo strtotime("2024-02-29 13:45:07+00:00"), "\n";
