--TEST--
Core\Arr::padStart reaches the same total from the front as array_pad with a negative size, so a member name selects what a sign selects in PHP
--FILE--
<?mwl
// Spec § 2's `array_pad` row, negative half. `$size` is a `uint` here, so PHP's
// "a negative length pads on the left" overload has no spelling at all — the
// direction is the member's name instead. The claim this case makes is that the
// two selectors pick the same answer: `padStart($a, $n, $v)` against
// `array_pad($a, -$n, $v)`, at every width on both sides of the subject's count.
//
// The magnitude is what `$size` means in both languages: PHP's `-5` asks for a
// *total* of five entries, not five added ones, which is the reading that makes
// the two members a translation of one function rather than of two.
//
// A list subject, for the reason `arr-pad-end-matches-array_pad` states: MWL's
// result is always a list and PHP's keeps the string keys, so only a list makes
// the two rules coincide. `arr-pad-on-string-keys-diverges-from-array_pad` is
// where they part.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $subject = [10, 20, 30, 40];
array<int> $sizes = [0, 1, 3, 4, 5, 7, 9];

foreach ($sizes as int $n) {
    echo Render::of(Core\Arr::padStart($subject, $n as uint, 7)), "\n";
}

array<int> $empty = [];
echo Render::of(Core\Arr::padStart($empty, 0, 7)), "|", Render::of(Core\Arr::padStart($empty, 3, 7)), "|\n";

// The two members over one subject at one size: between them they name every
// entry of the wider array, and the pads sit at opposite ends. PHP says the
// same with one function and two signs.
echo Render::of(Core\Arr::padStart($subject, 6, 7)), "|", Render::of(Core\Arr::padEnd($subject, 6, 7)), "|\n";

// Padding the front of an already-padded front is still one list, and the
// second call's pads land in front of the first call's.
echo Render::of(Core\Arr::padStart(Core\Arr::padStart($subject, 5, 7), 6, 8)), "\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$subject = [10, 20, 30, 40];
$sizes = [0, 1, 3, 4, 5, 7, 9];

foreach ($sizes as $n) {
    echo render(array_pad($subject, -$n, 7)), "\n";
}

$empty = [];
echo render(array_pad($empty, -0, 7)), "|", render(array_pad($empty, -3, 7)), "|\n";

echo render(array_pad($subject, -6, 7)), "|", render(array_pad($subject, 6, 7)), "|\n";

echo render(array_pad(array_pad($subject, -5, 7), -6, 8)), "\n";
