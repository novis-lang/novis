--TEST--
on ASCII, Core\Str::length and strlen agree — the whole ADR 0009 § 2 question disappears
--FILE--
<?mwl
echo Core\Str::length(""), "\n";
echo Core\Str::length("a"), "\n";
echo Core\Str::length("hello world"), "\n";
echo Core\Str::length("0123456789"), "\n";
--ORACLE--
<?php
echo strlen(""), "\n";
echo strlen("a"), "\n";
echo strlen("hello world"), "\n";
echo strlen("0123456789"), "\n";
