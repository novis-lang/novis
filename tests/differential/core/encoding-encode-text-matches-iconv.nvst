--TEST--
Core\Encoding::encodeText agrees with iconv() over every encoding both of them carry — spec § 7
--FILE--
<?nvs
// `Core\Encoding::encodeText(string $s, Charset $charset): bytes` is
// `iconv("UTF-8", $charset, $s)` with the source encoding gone: a Novis
// `string` is guaranteed-valid UTF-8 (`rule:types/string-is-utf8`), so the "from" half of
// `iconv`'s pair is a fact about the type rather than an argument, and the
// charset is a `Core\Charset` case rather than a label string PHP parses at
// run time. The answer is `bytes` either way, and the oracle below writes
// each row both ways, so the two spellings are the assertion. `bin2hex` and
// `Core\Encoding::toHex` are what make the octets readable at all.

// The four schemes this module encodes itself (`nvs_stdlib::encoding`'s own
// module doc says which and why), against the ones iconv names the same way.
// UTF-8 is the identity, and `héllo ☃` carries a two- and a three-byte
// sequence so that it is not an ASCII round-trip in disguise.
echo Core\Encoding::toHex(Core\Encoding::encodeText("héllo ☃", Core\Charset::Utf8)), "\n";
echo Core\Encoding::toHex(Core\Encoding::encodeText("héllo", Core\Charset::Latin1)), "\n";
echo Core\Encoding::toHex(Core\Encoding::encodeText("plain", Core\Charset::Ascii)), "\n";

// Both UTF-16 orders, written with no byte-order mark by either implementation
// — `Utf16Le`/`Utf16Be` name the order, so a mark would be a second statement
// of it. The snowman is above the basic plane's single-unit range only in the
// sense that it is three bytes in UTF-8; `aé☃` is three characters and six
// UTF-16 octets, which is what tells the two orders apart on the wire.
echo Core\Encoding::toHex(Core\Encoding::encodeText("aé☃", Core\Charset::Utf16Le)), "\n";
echo Core\Encoding::toHex(Core\Encoding::encodeText("aé☃", Core\Charset::Utf16Be)), "\n";

// The legacy single-byte tables, one per script that has more than one
// spelling in the wild: Central European, and Cyrillic in both of the two
// encodings a ported program actually meets.
echo Core\Encoding::toHex(Core\Encoding::encodeText("žluť", Core\Charset::Iso88592)), "\n";
echo Core\Encoding::toHex(Core\Encoding::encodeText("привет", Core\Charset::Koi8R)), "\n";
echo Core\Encoding::toHex(Core\Encoding::encodeText("привет", Core\Charset::Windows1251)), "\n";

// windows-1252 over `0x80`, the octet that is the whole reason `Latin1` is its
// own case here rather than the standard's fold of the two: the euro sign has
// a spelling in this charset and no spelling at all in ISO-8859-1.
echo Core\Encoding::toHex(Core\Encoding::encodeText("€ ok", Core\Charset::Windows1252)), "\n";

// The two multi-byte Japanese tables, whose octets are not a function of the
// code point at all but of an index both implementations have to agree on.
echo Core\Encoding::toHex(Core\Encoding::encodeText("あア亜", Core\Charset::ShiftJis)), "\n";
echo Core\Encoding::toHex(Core\Encoding::encodeText("あア亜", Core\Charset::EucJp)), "\n";

// Counted rather than read off the lines above: every one of these charsets is
// ASCII-transparent, so a table that quietly stopped being consulted — or that
// grew a byte-order mark, or a shift sequence — fails here even where its own
// row still looks plausible. Written out one charset at a time because a
// `Core\Charset` case cannot yet be held in a binding of its own type.
uint $ascii = 0;
if (Core\Encoding::toHex(Core\Encoding::encodeText("ok", Core\Charset::Ascii)) == "6f6b") { $ascii = $ascii + 1; }
if (Core\Encoding::toHex(Core\Encoding::encodeText("ok", Core\Charset::Latin1)) == "6f6b") { $ascii = $ascii + 1; }
if (Core\Encoding::toHex(Core\Encoding::encodeText("ok", Core\Charset::Iso88592)) == "6f6b") { $ascii = $ascii + 1; }
if (Core\Encoding::toHex(Core\Encoding::encodeText("ok", Core\Charset::Koi8R)) == "6f6b") { $ascii = $ascii + 1; }
if (Core\Encoding::toHex(Core\Encoding::encodeText("ok", Core\Charset::Windows1251)) == "6f6b") { $ascii = $ascii + 1; }
if (Core\Encoding::toHex(Core\Encoding::encodeText("ok", Core\Charset::Windows1252)) == "6f6b") { $ascii = $ascii + 1; }
if (Core\Encoding::toHex(Core\Encoding::encodeText("ok", Core\Charset::ShiftJis)) == "6f6b") { $ascii = $ascii + 1; }
if (Core\Encoding::toHex(Core\Encoding::encodeText("ok", Core\Charset::EucJp)) == "6f6b") { $ascii = $ascii + 1; }
echo "ascii=", $ascii, "/8\n";
--ORACLE--
<?php
echo bin2hex(iconv("UTF-8", "UTF-8", "héllo ☃")), "\n";
echo bin2hex(iconv("UTF-8", "ISO-8859-1", "héllo")), "\n";
echo bin2hex(iconv("UTF-8", "ASCII", "plain")), "\n";

echo bin2hex(iconv("UTF-8", "UTF-16LE", "aé☃")), "\n";
echo bin2hex(iconv("UTF-8", "UTF-16BE", "aé☃")), "\n";

echo bin2hex(iconv("UTF-8", "ISO-8859-2", "žluť")), "\n";
echo bin2hex(iconv("UTF-8", "KOI8-R", "привет")), "\n";
echo bin2hex(iconv("UTF-8", "WINDOWS-1251", "привет")), "\n";

echo bin2hex(iconv("UTF-8", "WINDOWS-1252", "€ ok")), "\n";

echo bin2hex(iconv("UTF-8", "SHIFT_JIS", "あア亜")), "\n";
echo bin2hex(iconv("UTF-8", "EUC-JP", "あア亜")), "\n";

$sets = ["ASCII", "ISO-8859-1", "ISO-8859-2", "KOI8-R", "WINDOWS-1251", "WINDOWS-1252", "SHIFT_JIS", "EUC-JP"];
$ascii = 0;
foreach ($sets as $set) {
    if (bin2hex(iconv("UTF-8", $set, "ok")) === "6f6b") { $ascii++; }
}
echo "ascii=$ascii/8\n";
