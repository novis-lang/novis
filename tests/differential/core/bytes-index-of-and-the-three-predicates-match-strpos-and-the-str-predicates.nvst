--TEST--
`Core\Bytes::indexOf` reports the offset `strpos` reports and absence as `null` where `strpos` answers `false`, and `contains`/`startsWith`/`endsWith` answer their PHP twins over the same needles (spec § 7, `rule:core-api/shape-rules` R5)
--FILE--
<?nvs
// The magic-byte sniffing case: § 7 says the three predicates are "what
// magic-byte sniffing needs", so the subjects here are file headers and the
// needles are the signatures a sniffer looks for — present at the front,
// present inside, present at the end, and absent.
//
// The signature difference § 7 names is on `indexOf`: it has no
// `caseInsensitive` option, because case is a property of text and not of
// octets. What it shares with `Core\Str::indexOf` is the `?uint` answer, and
// that is the half PHP is the oracle for — `strpos` answers `false`, which is
// `== 0` in the language this file compares against, and the entire reason
// spec § 7 does not spell absence that way.
final class Show {
    public static function place(?uint $v): string {
        if ($v == null) {
            return "<none>";
        }
        return $v as string;
    }

    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

// A PNG header, a GIF89a header, a buffer of repeated octets where a needle
// occurs many times and overlaps itself, a buffer that is one octet long, and
// the empty buffer.
array<string> $haystacks = ["89504e470d0a1a0a", "474946383961", "aaaaaa", "0a", ""];

// The PNG signature's first octet, its two-octet head, the `0a` that ends it
// and also appears inside it, an overlapping pair, and a needle present in
// nothing here.
array<string> $needles = ["89", "8950", "0a", "aaaa", "ff"];

echo "indexOf:";
foreach ($haystacks as string $haystack) {
    foreach ($needles as string $needle) {
        echo Show::place(Core\Bytes::indexOf(
            Core\Encoding::fromHex($haystack),
            Core\Encoding::fromHex($needle)
        )), "|";
    }
}
echo "\n";

echo "contains:";
foreach ($haystacks as string $haystack) {
    foreach ($needles as string $needle) {
        echo Show::flag(Core\Bytes::contains(
            Core\Encoding::fromHex($haystack),
            Core\Encoding::fromHex($needle)
        )), "|";
    }
}
echo "\n";

echo "startsWith:";
foreach ($haystacks as string $haystack) {
    foreach ($needles as string $needle) {
        echo Show::flag(Core\Bytes::startsWith(
            Core\Encoding::fromHex($haystack),
            Core\Encoding::fromHex($needle)
        )), "|";
    }
}
echo "\n";

echo "endsWith:";
foreach ($haystacks as string $haystack) {
    foreach ($needles as string $needle) {
        echo Show::flag(Core\Bytes::endsWith(
            Core\Encoding::fromHex($haystack),
            Core\Encoding::fromHex($needle)
        )), "|";
    }
}
echo "\n";

// The four members agree about *whether* the needle is there, which is the
// claim that survives a member growing its own search: `contains` is
// `indexOf` answering something, `startsWith` is it answering zero, and
// `endsWith` is the window at the tail. Counted over every pair.
int $held = 0;
int $cells = 0;
foreach ($haystacks as string $haystack) {
    foreach ($needles as string $needle) {
        bytes $subject = Core\Encoding::fromHex($haystack);
        bytes $sought = Core\Encoding::fromHex($needle);
        $cells = $cells + 3;
        if (Core\Bytes::contains($subject, $sought) == (Core\Bytes::indexOf($subject, $sought) != null)) {
            $held = $held + 1;
        }
        if (Core\Bytes::startsWith($subject, $sought) == (Core\Bytes::indexOf($subject, $sought) == 0)) {
            $held = $held + 1;
        }
        if (Core\Bytes::endsWith($subject, $sought)
            == (Core\Bytes::compare(
                Core\Bytes::slice(
                    $subject,
                    Core\Bytes::length($subject) as int - Core\Bytes::length($sought) as int,
                    null
                ),
                $sought
            ) == 0)) {
            $held = $held + 1;
        }
    }
}
echo $held, " of ", $cells, "\n";
--ORACLE--
<?php
function place($v) {
    if ($v === false) {
        return "<none>";
    }
    return (string) $v;
}

function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

$haystacks = ["89504e470d0a1a0a", "474946383961", "aaaaaa", "0a", ""];
$needles = ["89", "8950", "0a", "aaaa", "ff"];

echo "indexOf:";
foreach ($haystacks as $haystack) {
    foreach ($needles as $needle) {
        echo place(strpos(hex2bin($haystack), hex2bin($needle))), "|";
    }
}
echo "\n";

echo "contains:";
foreach ($haystacks as $haystack) {
    foreach ($needles as $needle) {
        echo flag(str_contains(hex2bin($haystack), hex2bin($needle))), "|";
    }
}
echo "\n";

echo "startsWith:";
foreach ($haystacks as $haystack) {
    foreach ($needles as $needle) {
        echo flag(str_starts_with(hex2bin($haystack), hex2bin($needle))), "|";
    }
}
echo "\n";

echo "endsWith:";
foreach ($haystacks as $haystack) {
    foreach ($needles as $needle) {
        echo flag(str_ends_with(hex2bin($haystack), hex2bin($needle))), "|";
    }
}
echo "\n";

$held = 0;
$cells = 0;
foreach ($haystacks as $haystack) {
    foreach ($needles as $needle) {
        $subject = hex2bin($haystack);
        $sought = hex2bin($needle);
        $cells = $cells + 3;
        if (str_contains($subject, $sought) === (strpos($subject, $sought) !== false)) {
            $held = $held + 1;
        }
        if (str_starts_with($subject, $sought) === (strpos($subject, $sought) === 0)) {
            $held = $held + 1;
        }
        if (str_ends_with($subject, $sought)
            === (substr($subject, strlen($subject) - strlen($sought)) === $sought)) {
            $held = $held + 1;
        }
    }
}
echo $held, " of ", $cells, "\n";
