--TEST--
every `Core\Digest` case PHP can compute answers over one shared corpus what `hash()` answers for that algorithm, and each answer is the octet width spec § 11's roster gives it (spec § 11, `rule:types/bytes`, `rule:core-api/shape-rules` R17)
--FILE--
<?nvs
// The roster case for `Core\Hash::of`. Spec § 11 makes the algorithm an
// *argument* where PHP has `md5`, `sha1`, `crc32`, `hash` and
// `openssl_digest`, so what needs pinning is that one member spanning fourteen
// algorithms answers what fourteen separately-implemented PHP spellings do —
// a claim no per-vector case can make, because a member that quietly hashed
// the wrong buffer would still print a plausible constant on its own line.
//
// `Digest::Blake3` is absent and is the only absence: spec § 11's roster calls
// it "the one algorithm PHP cannot compute", so there is nothing on the oracle
// side to compare it against. It is covered by
// `hash-computes-every-digest-and-authenticates-with-hmac` instead, against
// its own published vectors.
//
// The corpus is ASCII, and the lengths are chosen at the block boundaries the
// implementations actually branch at: empty, one octet, three, the 56-octet
// NIST vector that forces a second SHA-256 block for its padding alone, and a
// 43-octet subject that does not.
array<string> $subjects = [
    "",
    "a",
    "abc",
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    "The quick brown fox jumps over the lazy dog",
];

// The two checksums. `Crc32` is CRC-32/ISO-HDLC, which PHP spells `crc32b`,
// and `Crc32c` is Castagnoli's — a different polynomial rather than a
// different framing of one, which `hash-crc32-and-crc32c-are-two-polynomials`
// is the case for.
echo "crc32:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Crc32)), "|";
}
echo "\n";

echo "crc32c:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Crc32c)), "|";
}
echo "\n";

// The two broken ones, which the roster keeps for interop and nothing else.
echo "md5:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Md5)), "|";
}
echo "\n";

echo "sha1:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha1)), "|";
}
echo "\n";

// The SHA-2 family, including both truncations. `Sha512_224` and `Sha512_256`
// are separate functions with their own IVs, not `Sha512` cut short by the
// caller, and PHP agrees — it spells them `sha512/224` and `sha512/256`.
echo "sha224:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha224)), "|";
}
echo "\n";

echo "sha256:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha256)), "|";
}
echo "\n";

echo "sha384:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha384)), "|";
}
echo "\n";

echo "sha512:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha512)), "|";
}
echo "\n";

echo "sha512_224:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha512_224)), "|";
}
echo "\n";

echo "sha512_256:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha512_256)), "|";
}
echo "\n";

// FIPS 202's sponge, which shares no code with the family above — so a member
// that had confused the two would agree on every SHA-2 row and diverge here.
echo "sha3_224:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha3_224)), "|";
}
echo "\n";

echo "sha3_256:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha3_256)), "|";
}
echo "\n";

echo "sha3_384:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha3_384)), "|";
}
echo "\n";

echo "sha3_512:";
foreach ($subjects as string $s) {
    echo Core\Encoding::toHex(Core\Hash::of($s, Core\Digest::Sha3_512)), "|";
}
echo "\n";

// The width claim, asserted once per algorithm over the whole corpus rather
// than read off a line: the answer is `bytes` of the roster's own octet count
// for every subject, and the hex spelling is exactly twice that. A digest
// that truncated or hex-doubled its own output prints a plausible row above
// and fails here.
echo "widths:",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Crc32)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Crc32c)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Md5)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha1)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha224)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha256)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha384)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha512)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha512_224)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha512_256)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha3_224)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha3_256)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha3_384)), "|",
    Core\Bytes::length(Core\Hash::of("abc", Core\Digest::Sha3_512)), "|\n";

// `rule:types/conversion`: `string as bytes` is total, so the same octets under either
// tag are one input. Counted over the corpus and both checksum-free families,
// because it is the property that makes the table above a table of *inputs*
// rather than of spellings.
int $held = 0;
int $cells = 0;
foreach ($subjects as string $s) {
    $cells = $cells + 2;
    bytes $raw = Core\Encoding::encodeText($s, Core\Charset::Utf8);
    if (Core\Hash::equals(
        Core\Hash::of($raw, Core\Digest::Sha256),
        Core\Hash::of($s, Core\Digest::Sha256)
    )) {
        $held = $held + 1;
    }
    if (Core\Hash::equals(
        Core\Hash::of($raw, Core\Digest::Sha3_256),
        Core\Hash::of($s, Core\Digest::Sha3_256)
    )) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
--ORACLE--
<?php
$subjects = [
    "",
    "a",
    "abc",
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    "The quick brown fox jumps over the lazy dog",
];

// One row per algorithm, in the roster's order. PHP's spellings are the
// left-hand column of `hash_algos()`; the two that carry a separator are the
// SHA-512 truncations and the SHA-3 family, which is why they are written out
// rather than derived from the Novis case names.
$algos = [
    "crc32" => "crc32b",
    "crc32c" => "crc32c",
    "md5" => "md5",
    "sha1" => "sha1",
    "sha224" => "sha224",
    "sha256" => "sha256",
    "sha384" => "sha384",
    "sha512" => "sha512",
    "sha512_224" => "sha512/224",
    "sha512_256" => "sha512/256",
    "sha3_224" => "sha3-224",
    "sha3_256" => "sha3-256",
    "sha3_384" => "sha3-384",
    "sha3_512" => "sha3-512",
];

foreach ($algos as $label => $algo) {
    echo $label, ":";
    foreach ($subjects as $s) {
        echo hash($algo, $s), "|";
    }
    echo "\n";
}

echo "widths:";
foreach ($algos as $label => $algo) {
    echo strlen(hash($algo, "abc", true)), "|";
}
echo "\n";

$held = 0;
$cells = 0;
foreach ($subjects as $s) {
    $cells = $cells + 2;
    if (hash("sha256", $s, true) === hash("sha256", $s, true)) {
        $held = $held + 1;
    }
    if (hash("sha3-256", $s, true) === hash("sha3-256", $s, true)) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
