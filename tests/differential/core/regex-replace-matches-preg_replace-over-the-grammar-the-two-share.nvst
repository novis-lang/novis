--TEST--
Core\Regex::replace expands the same replacement template as preg_replace wherever the two grammars overlap, and counts replacements the same way under a limit
--FILE--
<?nvs
// Spec § 5's `replace` row against its PHP twin. The conformance case
// `regex-replace-reads-its-own-replacement-grammar` pins what the template
// means; this asks whether PCRE's substitution agrees, which is a different
// claim — `crates/nvs-stdlib/src/regex.rs` rewrites the template into PHP's
// reading before either engine expands it.
//
// The two grammars overlap but are not equal, and the rows below are the
// overlap on purpose. `\1` is a group reference in PHP and stays literal here
// (a Novis string literal already spells `\1` as an escape), and `$$` is one
// dollar here and two in PHP; both divergences are the conformance case's, and
// a row for either would be measuring a decision rather than an agreement.
// What is left is `$0`, `$n`, `${n}`, a reference naming no group, the
// boundary between `$10` and `${1}0`, a bare `$` reading at most two digits
// and a `$` that starts no reference — every one of which PHP also answers.
array<array<string>> $rows = [
    ["2026-08-24", "(\\d+)-(\\d+)-(\\d+)", "[$0] $3-$2-$1"],
    ["2026-08", "(?<y>\\d{4})-(?<m>\\d{2})", "${2}-${1}"],
    ["7", "(\\d)", "$9"],
    ["7", "(\\d)", "$10"],
    ["7", "(\\d)", "${1}0"],
    ["b", "(a)?(b)", "[$1][$2]"],
    ["ab", "(a)(z*)(b)", "[$1][$2][$3]"],
    ["abc", "x*", "-"],
    ["", "a*", "-"],
    ["aa", "(a)\\1", "<$0>"],
    ["a b  c", "\\s+", "_"],
    ["abcabc", "b", "B"],
    ["xAx", "a", "-"],
    ["aXbXc", "(?<=a)X", "-"],
    ['1 2', '(\d)', '[$1st]'],
    ['7', '(\d)', '$123'],
    ['7', '(\d)', '$a $'],
    ['aa', '(a)(?=\1)', '[$1st]'],
];

// Each row on its own line, bracketed, so a replacement that answered the
// empty string is distinguishable from one that answered nothing at all.
foreach ($rows as array<string> $row) {
    echo "[", Core\Regex::replace($row["0"], $row["1"], $row["2"]), "]\n";
}

// `limit` counts *replacements* on both sides — not matches examined and not
// characters consumed — which is the reading a zero-width pattern separates
// from the other two: with a limit of two, `x*` replaces at the front and
// after the first character and leaves the rest of the subject alone.
echo "[", Core\Regex::replace("aaaa", "a", "b", {limit: 0}), "]",
     "[", Core\Regex::replace("abc", "x*", "-", {limit: 0}), "]\n";
echo "[", Core\Regex::replace("aaaa", "a", "b", {limit: 1}), "]",
     "[", Core\Regex::replace("abc", "x*", "-", {limit: 1}), "]\n";
echo "[", Core\Regex::replace("aaaa", "a", "b", {limit: 2}), "]",
     "[", Core\Regex::replace("abc", "x*", "-", {limit: 2}), "]\n";
echo "[", Core\Regex::replace("aaaa", "a", "b", {limit: 3}), "]",
     "[", Core\Regex::replace("abc", "x*", "-", {limit: 3}), "]\n";
echo "[", Core\Regex::replace("aaaa", "a", "b", {limit: 9}), "]",
     "[", Core\Regex::replace("abc", "x*", "-", {limit: 9}), "]\n";
--ORACLE--
<?php
// Single-quoted throughout: `"$9"` and `"${1}"` are interpolation in a PHP
// double-quoted string, which would rewrite the template before preg_replace
// ever saw it.
$rows = [
    ['2026-08-24', '(\\d+)-(\\d+)-(\\d+)', '[$0] $3-$2-$1'],
    ['2026-08', '(?<y>\\d{4})-(?<m>\\d{2})', '${2}-${1}'],
    ['7', '(\\d)', '$9'],
    ['7', '(\\d)', '$10'],
    ['7', '(\\d)', '${1}0'],
    ['b', '(a)?(b)', '[$1][$2]'],
    ['ab', '(a)(z*)(b)', '[$1][$2][$3]'],
    ['abc', 'x*', '-'],
    ['', 'a*', '-'],
    ['aa', '(a)\\1', '<$0>'],
    ['a b  c', '\\s+', '_'],
    ['abcabc', 'b', 'B'],
    ['xAx', 'a', '-'],
    ['aXbXc', '(?<=a)X', '-'],
    ['1 2', '(\d)', '[$1st]'],
    ['7', '(\d)', '$123'],
    ['7', '(\d)', '$a $'],
    ['aa', '(a)(?=\1)', '[$1st]'],
];

foreach ($rows as $row) {
    echo "[", preg_replace("/" . $row[1] . "/", $row[2], $row[0]), "]\n";
}

foreach ([0, 1, 2, 3, 9] as $n) {
    echo "[", preg_replace("/a/", "b", "aaaa", $n), "]",
         "[", preg_replace("/x*/", "-", "abc", $n), "]\n";
}
