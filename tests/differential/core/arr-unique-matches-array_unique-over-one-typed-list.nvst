--TEST--
Core\Arr::unique answers what array_unique answers wherever a subject's values are one type, keys and holes included
--FILE--
<?nvs
// Spec § 2's `array_unique` row. The two members do not ask the same question:
// Novis compares by strict identity, `array_unique` defaults to `SORT_STRING` and
// compares the *spellings*. Those two answers coincide exactly where distinct
// values have distinct spellings, which is every subject in this case — one
// type throughout. `arr-unique-on-mixed-types-diverges-from-array_unique` is
// where they part.
//
// `rule:types/preserve-keys` has nothing to say here, unusually for a `Core\Arr` member:
// neither language renumbers what survives, so the entry kept carries the key
// its first occurrence had and the result is a list with holes in it. That
// makes the keys the assertion rather than a detail beside it, which is why
// every row here renders `key=value;` rather than the values alone.
final class Render {
    public static function ints(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }

    public static function strings(array<string> $a): string {
        var $out = "";
        foreach ($a as string $k => string $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

// The keys the two dropped entries leave behind are the whole claim: 2 and 4
// are gone and nothing moved up to fill them.
array<int> $dupes = [1, 2, 1, 3, 2];
echo Render::ints(Core\Arr::unique($dupes)), "\n";

// Case is part of a spelling on both sides, so four names survive as four.
array<string> $names = ["Ann", "ann", "Bob", "BOB"];
echo Render::strings(Core\Arr::unique($names)), "\n";

// The three lengths at which a survivor set can look right for the wrong
// reason: nothing to compare, one entry, and every entry equal to the first.
array<int> $empty = [];
array<int> $one = [7];
array<string> $same = ["z", "z", "z"];
echo Render::ints(Core\Arr::unique($empty)), "|", Render::ints(Core\Arr::unique($one)), "|", Render::strings(Core\Arr::unique($same)), "|\n";

// A map, where a member that renumbered would be caught immediately: both
// languages keep the string key of the entry that survived and drop the later
// duplicate's key with it.
array<int> $map = ["x" => 1, "y" => 2, "z" => 1];
echo Render::ints(Core\Arr::unique($map)), "\n";

// Both kinds of key in one subject, and the surviving 1 is the one under the
// integer key. Neither language asks what type a key is here, which is what
// `rule:types/preserve-keys` requires of Novis and what array_unique happens to do anyway.
array<int> $mixedKeys = ["5" => 1, "x" => 1, "7" => 2];
echo Render::ints(Core\Arr::unique($mixedKeys)), "\n";

// Idempotent on both sides — a second pass finds nothing left to drop, keys
// included, which a member that renumbered on the way out would fail.
echo Render::ints(Core\Arr::unique(Core\Arr::unique($dupes))), "\n";

// The subject is a value and is not touched by any of it.
echo Render::ints($dupes), "\n";
--ORACLE--
<?php
function ints(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$dupes = [1, 2, 1, 3, 2];
echo ints(array_unique($dupes)), "\n";

$names = ["Ann", "ann", "Bob", "BOB"];
echo ints(array_unique($names)), "\n";

$empty = [];
$one = [7];
$same = ["z", "z", "z"];
echo ints(array_unique($empty)), "|", ints(array_unique($one)), "|", ints(array_unique($same)), "|\n";

$map = ["x" => 1, "y" => 2, "z" => 1];
echo ints(array_unique($map)), "\n";

$mixedKeys = ["5" => 1, "x" => 1, "7" => 2];
echo ints(array_unique($mixedKeys)), "\n";

echo ints(array_unique(array_unique($dupes))), "\n";

echo ints($dupes), "\n";
