--TEST--
Core\Str::replace replaces every occurrence, as str_replace does
--FILE--
<?nvs
echo Core\Str::replace("a-b-c", "-", "+"), "\n";
echo Core\Str::replace("aaa", "a", "bb"), "\n";
echo Core\Str::replace("abc", "z", "!"), "\n";
echo Core\Str::replace("", "a", "b"), "\n";
--ORACLE--
<?php
echo str_replace("-", "+", "a-b-c"), "\n";
echo str_replace("a", "bb", "aaa"), "\n";
echo str_replace("z", "!", "abc"), "\n";
echo str_replace("a", "b", ""), "\n";
