--TEST--
Core\Str::padEnd matches PHP's str_pad with STR_PAD_RIGHT, truncation rule included
--FILE--
<?nvs
echo "[", Core\Str::padEnd("7", 4, "."), "]\n";
echo "[", Core\Str::padEnd("toolong", 3, "."), "]\n";
echo "[", Core\Str::padEnd("ab", 7, "xy"), "]\n";
echo "[", Core\Str::padEnd("", 3, "-"), "]\n";
echo "[", Core\Str::padEnd("ab", 2, "-"), "]\n";
--ORACLE--
<?php
echo "[", str_pad("7", 4, ".", STR_PAD_RIGHT), "]\n";
echo "[", str_pad("toolong", 3, ".", STR_PAD_RIGHT), "]\n";
echo "[", str_pad("ab", 7, "xy", STR_PAD_RIGHT), "]\n";
echo "[", str_pad("", 3, "-", STR_PAD_RIGHT), "]\n";
echo "[", str_pad("ab", 2, "-", STR_PAD_RIGHT), "]\n";
