--TEST--
Core\Arr::values drops the keys and renumbers, exactly as PHP's array_values does
--FILE--
<?mwl
array<string> $map = ["c" => "third", "a" => "first", "b" => "second"];

echo Core\Str::join(Core\Arr::values($map), ","), "\n";

foreach (Core\Arr::values($map) as string $index => string $value) {
    echo $index, ":", $value, "\n";
}

echo Core\Arr::count(Core\Arr::values($map)), "\n";
--ORACLE--
<?php
$map = ["c" => "third", "a" => "first", "b" => "second"];

echo implode(",", array_values($map)), "\n";

foreach (array_values($map) as $index => $value) {
    echo $index, ":", $value, "\n";
}

echo count(array_values($map)), "\n";
