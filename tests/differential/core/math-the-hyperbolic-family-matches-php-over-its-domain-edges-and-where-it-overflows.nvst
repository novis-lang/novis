--TEST--
Core\Math::sinh, cosh, tanh, asinh, acosh and atanh answer what PHP's six functions of the same names answer, including outside acosh's and atanh's domains, at the pole atanh has at one, and at the magnitude where sinh and cosh overflow while tanh saturates
--FILE--
<?nvs
// Spec § 3's six hyperbolic rows. Each is one PHP function with the same
// name and one argument, so the ordinary rows are not the question — the
// roster case every-math-member-with-a-php-twin-agrees already asks all six
// the shallow question over a shared in-domain corpus, and says so.
//
// This case is the edges that roster deliberately leaves out, and they are
// where the two languages could still part. Three of the six have a boundary
// the other three do not: `acosh` is undefined below one, `atanh` is
// undefined outside the closed unit interval and infinite at each end of it,
// and `sinh`/`cosh` overflow at an argument `tanh` merely saturates at. What
// makes each of those a real question here rather than a formality is that
// this module refuses a domain error elsewhere — `Core\Math::sqrt` of a
// negative, `log` of a zero — so a reader may reasonably expect a throw, and
// the answer both languages give is IEEE's value instead.

final class Show {
    // `NAN` coerced to a string is a warning in PHP 8.4 and later, so neither
    // side renders one: a value that is not equal to itself is the only `NAN`
    // there is, and the sentinel is what both languages print instead. `INF`
    // and `-INF` render through the ordinary conversion, which already agrees
    // across the two languages, because an infinity here is an *answer* —
    // `atanh(1.0)` is the pole — and folding it to a word would hide which
    // rows below are values and which are limits.
    public static function real(float $value): string {
        if (Core\Math::isNan($value)) {
            return "nan";
        }
        return $value as string;
    }
}

float $nan = Core\Math::NAN;
float $huge = Core\Math::INFINITY;

// The three forward members at zero, in both its signs. `sinh` and `tanh` are
// odd, so each keeps the sign of a zero; `cosh` is even and answers one, which
// is the row that says the three are not one function with a sign fixed up.
echo Core\Math::sinh(0.0), " ", Core\Math::sinh(-0.0), " ", Core\Math::cosh(0.0), " ", Core\Math::cosh(-0.0), " ", Core\Math::tanh(0.0), " ", Core\Math::tanh(-0.0), "\n";

// The three inverse members at the point each is zero: `asinh` and `atanh` at
// zero, `acosh` at one, which is the left end of its domain and the one place
// it is defined without being a value the naive `log($x + sqrt($x * $x - 1))`
// spelling can reach without cancellation.
echo Core\Math::asinh(0.0), " ", Core\Math::asinh(-0.0), " ", Core\Math::acosh(1.0), " ", Core\Math::atanh(0.0), " ", Core\Math::atanh(-0.0), "\n";

// One ordinary argument through all six, in both signs where the member takes
// one — the control that says each is the function it is named for before the
// edges below are read.
echo Core\Math::sinh(1.0), " ", Core\Math::cosh(1.0), " ", Core\Math::tanh(1.0), " ", Core\Math::sinh(-1.0), " ", Core\Math::cosh(-1.0), " ", Core\Math::tanh(-1.0), "\n";
echo Core\Math::asinh(1.0), " ", Core\Math::asinh(-1.0), " ", Core\Math::acosh(2.0), " ", Core\Math::atanh(0.5), " ", Core\Math::atanh(-0.5), "\n";

// `acosh` below one: undefined, and the answer is a `NAN` rather than a throw
// — including at the value just under the boundary, which is the row that says
// the refusal is the domain and not a sign test. `acosh` is also the one
// member here that is not odd, so a negative argument is outside its domain
// twice over and still answers the same way.
echo Show::real(Core\Math::acosh(0.5)), " ", Show::real(Core\Math::acosh(0.0)), " ", Show::real(Core\Math::acosh(-1.0)), " ", Show::real(Core\Math::acosh(-2.0)), "\n";

// `atanh` at and past each end of the unit interval. Exactly at `1.0` and
// `-1.0` the function has a pole and the answer is a signed infinity — a
// *value*, not an error — while past the ends it is a `NAN`. A member testing
// `abs($x) >= 1.0` for its domain answers `NAN` at the poles and fails the
// first two of these while printing the last two correctly.
echo Show::real(Core\Math::atanh(1.0)), " ", Show::real(Core\Math::atanh(-1.0)), " ", Show::real(Core\Math::atanh(1.5)), " ", Show::real(Core\Math::atanh(-1.5)), "\n";

// The magnitude where the exponential inside `sinh` and `cosh` leaves the
// range: both overflow to an infinity of their own parity's sign, where
// `tanh` — a ratio of two values that overflow together — saturates at one
// instead. That difference in behaviour at one argument is the whole reason
// `tanh` is its own member rather than a call site's quotient.
echo Core\Math::sinh(1000.0), " ", Core\Math::sinh(-1000.0), " ", Core\Math::cosh(1000.0), " ", Core\Math::cosh(-1000.0), " ", Core\Math::tanh(1000.0), " ", Core\Math::tanh(-1000.0), "\n";

// The specials through all six. An infinite argument is a limit each member
// has: `cosh` and `acosh` are even-signed and answer `INF` either way, the odd
// ones keep the sign, and `atanh` of an infinity is outside its domain even
// though its pole is finite.
echo Core\Math::sinh($huge), " ", Core\Math::cosh(0.0 - $huge), " ", Core\Math::tanh($huge), " ", Core\Math::asinh(0.0 - $huge), " ", Core\Math::acosh($huge), " ", Show::real(Core\Math::atanh($huge)), "\n";
echo Show::real(Core\Math::sinh($nan)), " ", Show::real(Core\Math::cosh($nan)), " ", Show::real(Core\Math::tanh($nan)), " ", Show::real(Core\Math::asinh($nan)), " ", Show::real(Core\Math::acosh($nan)), " ", Show::real(Core\Math::atanh($nan)), "\n";

// Four properties over one table, asserted by *counting* so that a member
// answering plausibly row by row above still fails here. The table spans both
// signs, both zeros, a magnitude inside the unit interval, one outside it and
// one past the overflow point.
//
//  - the parity of each forward member: `sinh` and `tanh` are odd, `cosh` is
//    even, on every row including the overflowing ones;
//  - the Pythagorean identity `cosh² - sinh² == 1`, which is not a float
//    identity everywhere and is not expected to hold on every row — what is
//    asserted is that both languages lose it on the *same* rows;
//  - `tanh` is `sinh / cosh`, by the same standard;
//  - `asinh` inverts `sinh` — the round trip that ties an inverse member to
//    its forward one rather than each to itself.
//
// The row total is printed beside the four counts, so a sweep that silently
// stopped short cannot agree with itself.
array<float> $table = [-1000.0, -2.0, -0.5, -0.0, 0.0, 0.5, 2.0, 1000.0];
int $parity = 0;
int $identity = 0;
int $ratio = 0;
int $roundTrip = 0;
int $rows = 0;
foreach ($table as float $x) {
    $rows = $rows + 1;
    var $s = Core\Math::sinh($x);
    var $c = Core\Math::cosh($x);
    var $t = Core\Math::tanh($x);
    if ($s == 0.0 - Core\Math::sinh(0.0 - $x) && $c == Core\Math::cosh(0.0 - $x) && $t == 0.0 - Core\Math::tanh(0.0 - $x)) {
        $parity = $parity + 1;
    }
    if ($c * $c - $s * $s == 1.0) {
        $identity = $identity + 1;
    }
    if ($t == Core\Math::fdiv($s, $c)) {
        $ratio = $ratio + 1;
    }
    if (Core\Math::asinh($s) == $x) {
        $roundTrip = $roundTrip + 1;
    }
}
echo $parity, " ", $identity, " ", $ratio, " ", $roundTrip, " ", $rows, "\n";
--ORACLE--
<?php
function real(float $value): string {
    if (is_nan($value)) {
        return "nan";
    }
    return (string) $value;
}

$nan = NAN;
$huge = INF;

echo sinh(0.0), " ", sinh(-0.0), " ", cosh(0.0), " ", cosh(-0.0), " ", tanh(0.0), " ", tanh(-0.0), "\n";

echo asinh(0.0), " ", asinh(-0.0), " ", acosh(1.0), " ", atanh(0.0), " ", atanh(-0.0), "\n";

echo sinh(1.0), " ", cosh(1.0), " ", tanh(1.0), " ", sinh(-1.0), " ", cosh(-1.0), " ", tanh(-1.0), "\n";
echo asinh(1.0), " ", asinh(-1.0), " ", acosh(2.0), " ", atanh(0.5), " ", atanh(-0.5), "\n";

echo real(acosh(0.5)), " ", real(acosh(0.0)), " ", real(acosh(-1.0)), " ", real(acosh(-2.0)), "\n";

echo real(atanh(1.0)), " ", real(atanh(-1.0)), " ", real(atanh(1.5)), " ", real(atanh(-1.5)), "\n";

echo sinh(1000.0), " ", sinh(-1000.0), " ", cosh(1000.0), " ", cosh(-1000.0), " ", tanh(1000.0), " ", tanh(-1000.0), "\n";

echo sinh($huge), " ", cosh(0.0 - $huge), " ", tanh($huge), " ", asinh(0.0 - $huge), " ", acosh($huge), " ", real(atanh($huge)), "\n";
echo real(sinh($nan)), " ", real(cosh($nan)), " ", real(tanh($nan)), " ", real(asinh($nan)), " ", real(acosh($nan)), " ", real(atanh($nan)), "\n";

$table = [-1000.0, -2.0, -0.5, -0.0, 0.0, 0.5, 2.0, 1000.0];
$parity = 0;
$identity = 0;
$ratio = 0;
$roundTrip = 0;
$rows = 0;
foreach ($table as $x) {
    $rows = $rows + 1;
    $s = sinh($x);
    $c = cosh($x);
    $t = tanh($x);
    if ($s == 0.0 - sinh(0.0 - $x) && $c == cosh(0.0 - $x) && $t == 0.0 - tanh(0.0 - $x)) {
        $parity = $parity + 1;
    }
    if ($c * $c - $s * $s == 1.0) {
        $identity = $identity + 1;
    }
    if ($t == fdiv($s, $c)) {
        $ratio = $ratio + 1;
    }
    if (asinh($s) == $x) {
        $roundTrip = $roundTrip + 1;
    }
}
echo $parity, " ", $identity, " ", $ratio, " ", $roundTrip, " ", $rows, "\n";
