--TEST--
Core\Arr::sort with `{order: Core\Order::Desc}` produces what PHP's rsort produces
--FILE--
<?nvs
array<int> $nums = [3, 1, 2, 9, 5];
foreach (Core\Arr::sort($nums, {order: Core\Order::Desc}) as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
foreach (Core\Arr::sort($nums) as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
--ORACLE--
<?php
$nums = [3, 1, 2, 9, 5];
$desc = $nums;
rsort($desc);
foreach ($desc as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
$asc = $nums;
sort($asc);
foreach ($asc as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
