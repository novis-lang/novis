--TEST--
Core\Str::split matches PHP's explode, empty fields included
--FILE--
<?mwl
echo Core\Str::join(Core\Str::split("a,b,c", ","), "|"), "\n";
echo Core\Str::join(Core\Str::split("a,b,,c", ","), "|"), "\n";
echo Core\Str::join(Core\Str::split(",lead", ","), "|"), "\n";
echo Core\Str::join(Core\Str::split("trail,", ","), "|"), "\n";
echo Core\Str::join(Core\Str::split("nosep", ","), "|"), "\n";
echo Core\Arr::count(Core\Str::split("a,b,,c", ",")), "\n";
--ORACLE--
<?php
echo implode("|", explode(",", "a,b,c")), "\n";
echo implode("|", explode(",", "a,b,,c")), "\n";
echo implode("|", explode(",", ",lead")), "\n";
echo implode("|", explode(",", "trail,")), "\n";
echo implode("|", explode(",", "nosep")), "\n";
echo count(explode(",", "a,b,,c")), "\n";
