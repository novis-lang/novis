--TEST--
Core\Arr::prepend puts its values in front in written order exactly as array_unshift does, on the list subjects where the two key rules coincide
--FILE--
<?mwl
// Spec § 2's front end against its PHP twin, on the subjects where they agree.
// `prepend` renumbers every key because an entry put in *front* of an existing
// one has no non-arbitrary key to keep — `"0"` is the only candidate and the
// subject may already hold it. `array_unshift` renumbers the integer keys and
// keeps the string ones, so the two part the moment a string key is present;
// `arr-prepend-and-without-first-diverge-from-array_unshift-and-array_shift`
// is where that is pinned. Over a list, and over a *gapped* list whose keys
// are all integers, the two rules answer the same thing — and what is left to
// compare is the order the trailing values land in, which is the half PHP
// documents as surprising.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $list = [10, 20, 30];
array<int> $empty = [];

// Written order, not reversed: `prepend($a, 7, 8)` puts 7 before 8 before the
// subject, which is `array_unshift`'s own answer and not the one a
// push-them-one-at-a-time reading would give.
echo Render::of(Core\Arr::prepend($list, 7, 8)), "\n";
echo Render::of(Core\Arr::prepend($list, 7)), "\n";
echo Render::of(Core\Arr::prepend($empty, 7, 8)), "\n";

// A gapped list: every key is an integer, so `array_unshift` renumbers all of
// them and lands on MWL's answer — the agreement here is the whole reason this
// case can claim the divergence is about key *types* and not about gaps.
array<int> $gapped = [10, 20, 30, 40];
unset($gapped["1"]);
echo Render::of(Core\Arr::prepend($gapped, 7)), "\n";
echo Render::of(Core\Arr::prepend($gapped, 7, 8, 9)), "\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

function unshifted(array $a, ...$values): array {
    array_unshift($a, ...$values);
    return $a;
}

$list = [10, 20, 30];
$empty = [];

echo render(unshifted($list, 7, 8)), "\n";
echo render(unshifted($list, 7)), "\n";
echo render(unshifted($empty, 7, 8)), "\n";

$gapped = [10, 20, 30, 40];
unset($gapped[1]);
echo render(unshifted($gapped, 7)), "\n";
echo render(unshifted($gapped, 7, 8, 9)), "\n";
