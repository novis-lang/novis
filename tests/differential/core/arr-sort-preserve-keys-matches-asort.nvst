--TEST--
Core\Arr::sort with `{preserveKeys: true}` produces what PHP's asort and arsort produce
--FILE--
<?nvs
array<int> $scores = ["carol" => 3, "alice" => 1, "bob" => 2];

foreach (Core\Arr::sort($scores, {preserveKeys: true}) as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";

foreach (Core\Arr::sort($scores, {preserveKeys: true, order: Core\Order::Desc}) as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
--ORACLE--
<?php
$scores = ["carol" => 3, "alice" => 1, "bob" => 2];

$up = $scores;
asort($up);
foreach ($up as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";

$down = $scores;
arsort($down);
foreach ($down as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
