--TEST--
Core\Str::trimStart and ::trimEnd take from the end ltrim and rtrim take from, and each leaves the other end alone
--FILE--
<?nvs
// Spec § 1's one-ended trims against their twins. The claim worth pinning is
// not that whitespace disappears — `str-trim-matches-trim` already asserts that
// for the two-ended member — but that each of these takes from *one* end: a
// member that trimmed both would print the same thing on a subject padded at
// one end only, which is how a swapped pair survives a careless case. Every row
// below is therefore padded at both ends and the two members are printed side
// by side, so the surviving padding is what is being read.
final class Show {
    // Both languages print the result between markers, because what is being
    // compared is where the text now starts and ends and an unmarked line hides
    // exactly that.
    public static function marked(string $s): string {
        return "[" . $s . "]";
    }
}

// Spaces, tabs and newlines — characters both defaults name. Novis's default is
// not spelled as a byte list and PHP's is, so this row is the agreement between
// the two spellings over the set they share.
string $padded = " \t\n hello \n\t ";
echo Show::marked(Core\Str::trimStart($padded)), Show::marked(Core\Str::trimEnd($padded)), "\n";

// The carriage return is in both defaults too, and it is asked about by
// *length* rather than by printing: a lone `\r` does not survive the runner's
// capture of PHP's stdout, so a differential case can assert that it was
// consumed but never that it is still there.
echo Core\Str::length(Core\Str::trimStart("\r\rx")), Core\Str::length(Core\Str::trimEnd("x\r\r")), "\n";

// A subject padded at one end only: the member that owns that end changes it
// and the other member answers the subject unchanged, which is the row a
// swapped pair fails.
string $left = "   left";
string $right = "right   ";
echo Show::marked(Core\Str::trimStart($left)), Show::marked(Core\Str::trimEnd($left)), "\n";
echo Show::marked(Core\Str::trimStart($right)), Show::marked(Core\Str::trimEnd($right)), "\n";

// Interior whitespace is never touched by either, however much of it there is.
string $interior = "  a  b  ";
echo Show::marked(Core\Str::trimStart($interior)), Show::marked(Core\Str::trimEnd($interior)), "\n";

// `{characters}` is a *set* rather than a prefix: order does not matter, every
// listed character is taken however many times it occurs, and the scan stops at
// the first character the set does not name.
string $wrapped = "xyxyCOREyxyx";
echo Show::marked(Core\Str::trimStart($wrapped, {characters: "xy"})),
     Show::marked(Core\Str::trimEnd($wrapped, {characters: "yx"})), "\n";

// A set that names nothing in the subject takes nothing, and a set that names
// everything in it takes all of it — the two bounds of the same scan.
echo Show::marked(Core\Str::trimStart($wrapped, {characters: "q"})),
     Show::marked(Core\Str::trimEnd("xxxx", {characters: "x"})), "\n";

// Whitespace all the way through: one end's trim consumes the whole subject, so
// both members answer the empty string rather than a single remaining space.
string $blank = "   ";
echo Show::marked(Core\Str::trimStart($blank)), Show::marked(Core\Str::trimEnd($blank)), "\n";

// Nothing to trim at all.
echo Show::marked(Core\Str::trimStart("")), Show::marked(Core\Str::trimEnd("")), "\n";
--ORACLE--
<?php
function marked(string $s): string {
    return "[" . $s . "]";
}

$padded = " \t\n hello \n\t ";
echo marked(ltrim($padded)), marked(rtrim($padded)), "\n";

echo strlen(ltrim("\r\rx")), strlen(rtrim("x\r\r")), "\n";

$left = "   left";
$right = "right   ";
echo marked(ltrim($left)), marked(rtrim($left)), "\n";
echo marked(ltrim($right)), marked(rtrim($right)), "\n";

$interior = "  a  b  ";
echo marked(ltrim($interior)), marked(rtrim($interior)), "\n";

$wrapped = "xyxyCOREyxyx";
echo marked(ltrim($wrapped, "xy")), marked(rtrim($wrapped, "yx")), "\n";

echo marked(ltrim($wrapped, "q")), marked(rtrim("xxxx", "x")), "\n";

$blank = "   ";
echo marked(ltrim($blank)), marked(rtrim($blank)), "\n";

echo marked(ltrim("")), marked(rtrim("")), "\n";
