--TEST--
Core\Arr::first and last answer what reset and end answer, without PHP's internal array pointer (ADR 0063 R5)
--FILE--
<?mwl
// ADR 0063 R5: the empty array answers `null` rather than throwing, because
// asking a possibly-empty array for its first entry is not a failure. PHP's
// `reset`/`end` answer `false` for the same case, so — as in
// `str-index-of-matches-strpos` — both sides render absence as `none` and what
// is compared below is the entry, never the representation.
class Show {
    public static function value(?int $found): string {
        if ($found == null) {
            return "none";
        }
        return $found as string;
    }
}

// PHP's three spellings of `first` all move or read an internal array pointer
// and MWL has none (spec § 2), so every row here reads the ends of a *value*:
// no call below depends on where a previous one left a cursor, which is what
// makes the two comparable at all.
array<int> $list = [10, 20, 30];
echo Show::value(Core\Arr::first($list)), " ", Show::value(Core\Arr::last($list)), "\n";
echo Show::value(Core\Arr::first($list)), " ", Show::value(Core\Arr::last($list)), "\n";

// Insertion order, not key order: a map's ends are the entries written first
// and last, and unsetting either end moves them.
array<int> $map = ["y" => 2, "x" => 1];
echo Show::value(Core\Arr::first($map)), " ", Show::value(Core\Arr::last($map)), "\n";

array<int> $gapped = [10, 20, 30, 40];
unset($gapped[0]);
unset($gapped[3]);
echo Show::value(Core\Arr::first($gapped)), " ", Show::value(Core\Arr::last($gapped)), "\n";

// The two ends meet in a one-entry array and are both absent in an empty one.
array<int> $one = [7];
echo Show::value(Core\Arr::first($one)), " ", Show::value(Core\Arr::last($one)), "\n";

array<int> $empty = [];
echo Show::value(Core\Arr::first($empty)), " ", Show::value(Core\Arr::last($empty)), "\n";
--ORACLE--
<?php
function show(int|false $found): string {
    if ($found === false) {
        return "none";
    }
    return (string) $found;
}

$list = [10, 20, 30];
echo show(reset($list)), " ", show(end($list)), "\n";
echo show(reset($list)), " ", show(end($list)), "\n";

$map = ["y" => 2, "x" => 1];
echo show(reset($map)), " ", show(end($map)), "\n";

$gapped = [10, 20, 30, 40];
unset($gapped[0]);
unset($gapped[3]);
echo show(reset($gapped)), " ", show(end($gapped)), "\n";

$one = [7];
echo show(reset($one)), " ", show(end($one)), "\n";

$empty = [];
echo show(reset($empty)), " ", show(end($empty)), "\n";
