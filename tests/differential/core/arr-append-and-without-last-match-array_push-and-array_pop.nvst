--TEST--
Core\Arr::append and ::withoutLast answer what array_push and array_pop leave behind, keys included, whatever the subject's keys were
--FILE--
<?mwl
// Spec § 2's two *back* ends against their PHP twins. Both twins mutate and
// one of them also returns — ADR 0063 R3 makes nothing mutate, so the spec
// splits `array_pop` into `Core\Arr::last` for the element and
// `::withoutLast` for the remainder, and the oracle here copies the subject
// before calling either.
//
// This is the half of the family where MWL and PHP agree *and had no reason
// to*: ADR 0069 § 3 refuses any rule that asks what type a key is, which is
// exactly what `array_unshift` and `array_shift` do — see
// `arr-prepend-and-without-first-diverge-from-array_unshift-and-array_shift`.
// The back end escapes it because neither operation has to invent or reassign
// a key: appending takes the next free integer whatever the existing keys look
// like, and removing the last entry leaves the others where they were. So the
// agreement is over the *whole* key table, and the subjects below are chosen
// to make that the claim: a list, a map with no integer key at all, and one
// carrying both kinds.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $list = [10, 20, 30];
array<int> $map = ["x" => 1, "y" => 2];
array<int> $mixed = ["5" => 1, "x" => 2, "9" => 3];
array<int> $empty = [];

// `append` keeps every key of the subject and lands each added value under the
// next free integer key — which over `$mixed` means 10 and 11, one past the
// largest integer key present, and over `$map` means 0, because a subject with
// no integer key has none used.
echo Render::of(Core\Arr::append($list, 7, 8)), "\n";
echo Render::of(Core\Arr::append($map, 7, 8)), "\n";
echo Render::of(Core\Arr::append($mixed, 7, 8)), "\n";
echo Render::of(Core\Arr::append($empty, 7)), "\n";

// A call with no trailing values at all is the subject, entry for entry —
// `array_push` with no values is the same no-op, and in particular neither
// renumbers anything on the way through.
echo Render::of(Core\Arr::append($list)), "\n";

// `withoutLast` drops one entry and renumbers nothing, which is `array_pop`'s
// own behaviour rather than a coincidence: it too leaves the survivors' keys
// alone. An empty subject yields an empty array rather than PHP's `null` and a
// warning, and the oracle's copy makes that difference invisible here — it is
// `Core\Arr::last`'s question, not this one's.
echo Render::of(Core\Arr::withoutLast($list)), "\n";
echo Render::of(Core\Arr::withoutLast($map)), "\n";
echo Render::of(Core\Arr::withoutLast($mixed)), "\n";
echo Render::of(Core\Arr::withoutLast($empty)), "\n";

// The two composed, which is where the *next free integer key* shows even
// though neither member prints it: popping the last entry of a three-entry
// list frees key 2, and appending afterwards reuses it on both sides. Over a
// subject whose integer keys have gaps the two part, and
// `arr-append-derives-the-next-free-key-where-php-remembers-it` is where that
// is pinned — it is the only row of this family that does.
echo Render::of(Core\Arr::append(Core\Arr::withoutLast($list), 9)), "\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

function pushed(array $a, ...$values): array {
    array_push($a, ...$values);
    return $a;
}

function popped(array $a): array {
    array_pop($a);
    return $a;
}

$list = [10, 20, 30];
$map = ["x" => 1, "y" => 2];
$mixed = [5 => 1, "x" => 2, 9 => 3];
$empty = [];

echo render(pushed($list, 7, 8)), "\n";
echo render(pushed($map, 7, 8)), "\n";
echo render(pushed($mixed, 7, 8)), "\n";
echo render(pushed($empty, 7)), "\n";

echo render(pushed($list)), "\n";

echo render(popped($list)), "\n";
echo render(popped($map)), "\n";
echo render(popped($mixed)), "\n";
echo render(popped($empty)), "\n";

echo render(pushed(popped($list), 9)), "\n";
