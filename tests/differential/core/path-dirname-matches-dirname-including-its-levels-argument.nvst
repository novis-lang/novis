--TEST--
Core\Path::dirname answers PHP's dirname at every boundary, and `{levels}` is its second argument, from docs/spec/01-core-library.md § 8
--FILE--
<?mwl
final class Norm {
    // Every answer here is a path, so it carries Core\Path::SEPARATOR, which
    // is `\` on the Windows leg and `/` on the WSL one. The oracle rewrites
    // its own the same way, so a row reads identically on both legs.
    public static function of(string $path): string {
        return Core\Str::replace($path, Core\Path::SEPARATOR, "/");
    }
}

// The plain reading: one component dropped, a trailing separator ignored
// however many there are — `parse` drops an empty component, so `/var/log/`
// has already lost its trailing slash before a level is counted.
echo "[", Norm::of(Core\Path::dirname("/var/log/syslog.txt")), "]\n";
echo "[", Norm::of(Core\Path::dirname("/var/log/")), "]\n";
echo "[", Norm::of(Core\Path::dirname("/var/log//")), "]\n";
echo "[", Norm::of(Core\Path::dirname("var/log/syslog.txt")), "]\n";

// The two answers that are not a component at all: `.` where a relative path
// runs out of them, and the root where an absolute one does. Both are paths a
// program can use, which is the property `render` is written around.
echo "[", Norm::of(Core\Path::dirname("syslog.txt")), "]\n";
echo "[", Norm::of(Core\Path::dirname("/")), "]\n";

// `.` and `..` are ordinary components to both, so neither is looked through.
echo "[", Norm::of(Core\Path::dirname(".")), "]\n";
echo "[", Norm::of(Core\Path::dirname("..")), "]\n";

// `{levels}` is PHP's second argument: the last level that still leaves a
// component, the first one that does not, and one far past the end — where
// both stop at the root rather than failing, exactly as walking up one level
// at a time would.
echo "[", Norm::of(Core\Path::dirname("/var/log/syslog.txt", {levels: 2})), "]\n";
echo "[", Norm::of(Core\Path::dirname("/var/log/syslog.txt", {levels: 3})), "]\n";
echo "[", Norm::of(Core\Path::dirname("/var/log/syslog.txt", {levels: 9})), "]\n";
echo "[", Norm::of(Core\Path::dirname("var/log", {levels: 5})), "]\n";

// The two rows PHP cannot be asked are pinned in the conformance suite
// instead, both in path-decomposes-a-path-without-touching-the-disk.mwlt and
// path-normalize-has-a-normal-form-and-join-never-replaces-its-base.mwlt:
// `dirname('')` is `.` here and `''` there, and `{levels: 0}` is the path
// itself here and a ValueError there.
--ORACLE--
<?php
function norm(string $path): string { return str_replace("\\", "/", $path); }

echo "[", norm(dirname("/var/log/syslog.txt")), "]\n";
echo "[", norm(dirname("/var/log/")), "]\n";
echo "[", norm(dirname("/var/log//")), "]\n";
echo "[", norm(dirname("var/log/syslog.txt")), "]\n";
echo "[", norm(dirname("syslog.txt")), "]\n";
echo "[", norm(dirname("/")), "]\n";
echo "[", norm(dirname(".")), "]\n";
echo "[", norm(dirname("..")), "]\n";
echo "[", norm(dirname("/var/log/syslog.txt", 2)), "]\n";
echo "[", norm(dirname("/var/log/syslog.txt", 3)), "]\n";
echo "[", norm(dirname("/var/log/syslog.txt", 9)), "]\n";
echo "[", norm(dirname("var/log", 5)), "]\n";
