--TEST--
`Core\Encoding::toBase64` and `::fromBase64` answer what `base64_encode` and `base64_decode` answer over RFC 4648's own vectors, at every padding remainder and over the octets that reach the last two alphabet entries (spec § 7, ADR 0009 § 1)
--FILE--
<?nvs
// Spec § 7 sites base64 on the `bytes`↔`string` boundary, so what is being
// compared is a total function in one direction and a failable one in the
// other. PHP is the oracle for the alphabet, the padding and the grouping;
// what it is *not* the oracle for is malformed input, where `base64_decode`
// skips what it cannot read and Novis refuses — that divergence has no row
// here, and every subject below is well-formed on both sides.
final class Show {
    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

// RFC 4648 § 10's vectors, which walk the three padding remainders twice
// over, plus the two subjects that reach `+` and `/` — the alphabet entries a
// URL-safe variant has to move and a hand-written encoder most often gets
// wrong — and a leading zero octet, where a group is significant but prints
// as `A`.
array<string> $inputs = [
    "",
    "66",
    "666f",
    "666f6f",
    "666f6f62",
    "666f6f6261",
    "666f6f626172",
    "00",
    "0000ff",
    "fbff",
    "fffefd",
    "03ef",
];

echo "encode:";
foreach ($inputs as string $hex) {
    echo "[", Core\Encoding::toBase64(Core\Encoding::fromHex($hex)), "]";
}
echo "\n";

// The other direction, over text the encoder above produced, so the pairing is
// asserted through the oracle rather than only within Novis.
echo "decode:";
foreach ($inputs as string $hex) {
    string $encoded = Core\Encoding::toBase64(Core\Encoding::fromHex($hex));
    echo "[", Core\Encoding::toHex(Core\Encoding::fromBase64($encoded)), "]";
}
echo "\n";

// Decoding text this file wrote out rather than encoded, so the padding is
// read rather than merely reproduced: one group, two groups, and both
// remainders spelled with their `=`.
array<string> $texts = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy", "//79", "++8="];
echo "read:";
foreach ($texts as string $text) {
    echo "[", Core\Encoding::toHex(Core\Encoding::fromBase64($text)), "]";
}
echo "\n";

// The width rule: four characters per three octets, rounded up and padded to
// the group. Asserted as a count over the corpus, because a single row of
// text cannot distinguish "padded correctly" from "padded to the length this
// subject happens to need".
int $held = 0;
int $cells = 0;
foreach ($inputs as string $hex) {
    $cells = $cells + 2;
    bytes $raw = Core\Encoding::fromHex($hex);
    string $spelling = Core\Encoding::toBase64($raw);
    if (Core\Str::length($spelling) as int == Core\Math::intDiv(Core\Bytes::length($raw) as int + 2, 3) * 4) {
        $held = $held + 1;
    }
    if (Core\Bytes::compare(Core\Encoding::fromBase64($spelling), $raw) == 0) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";

// Text in, text out: the member takes `bytes`, so encoding a string is
// `encodeText` first — which is the whole reason § 7 keeps the two classes
// beside each other rather than giving `Core\Str` a `toBase64`.
echo Show::flag(Core\Encoding::toBase64(Core\Encoding::encodeText("Hello, world", Core\Charset::Utf8)) == "SGVsbG8sIHdvcmxk"), "\n";
--ORACLE--
<?php
function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

$inputs = [
    "",
    "66",
    "666f",
    "666f6f",
    "666f6f62",
    "666f6f6261",
    "666f6f626172",
    "00",
    "0000ff",
    "fbff",
    "fffefd",
    "03ef",
];

echo "encode:";
foreach ($inputs as $hex) {
    echo "[", base64_encode(hex2bin($hex)), "]";
}
echo "\n";

echo "decode:";
foreach ($inputs as $hex) {
    $encoded = base64_encode(hex2bin($hex));
    echo "[", bin2hex(base64_decode($encoded)), "]";
}
echo "\n";

$texts = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy", "//79", "++8="];
echo "read:";
foreach ($texts as $text) {
    echo "[", bin2hex(base64_decode($text)), "]";
}
echo "\n";

$held = 0;
$cells = 0;
foreach ($inputs as $hex) {
    $cells = $cells + 2;
    $raw = hex2bin($hex);
    $encoded = base64_encode($raw);
    if (strlen($encoded) === intdiv(strlen($raw) + 2, 3) * 4) {
        $held = $held + 1;
    }
    if (base64_decode($encoded) === $raw) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";

echo flag(base64_encode("Hello, world") === "SGVsbG8sIHdvcmxk"), "\n";
