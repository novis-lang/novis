--TEST--
Core\Db::executeMany prepares once and runs one execution per set, summing the counts a hand-written SQLite3Stmt loop sums — and it is not a transaction, so a set that fails leaves the sets before it written — ADR 0067 §§ 1, 4
--FILE--
<?nvs
// § 4's batch is the member PHP has no name for: the twin is the loop every
// codebase writes around one prepared statement. Both sides prepare once —
// § 1's cache is what makes the Novis half do so without a `prepare` step —
// and both sum what each execution changed.
use Core\Db;

var $db = Db::connect("main");
$db->execute("create table t (id integer primary key, name text not null)", []);

array<array<string>> $sets = [["ada"], ["grace"], ["alan"]];
echo "batched ", $db->executeMany("insert into t (name) values (?)", $sets), "\n";

// A batch whose sets change different numbers of rows: the answer is the sum
// and not the number of sets, which a member counting executions would also
// print correctly for the batch above.
array<array<string>> $renames = [["ada", "ada lovelace"], ["nobody", "no one"]];
echo "renamed ", $db->executeMany("update t set name = ? where name = ?", $renames), "\n";

// § 4's other rule: this is not a transaction, on any of the five drivers. The
// second set violates the column's `not null`, and what the first set wrote is
// still there afterwards — exactly as the loop's earlier iterations are.
array<array<mixed>> $bad = [["edsger"], [null], ["barbara"]];
try {
    $db->executeMany("insert into t (name) values (?)", $bad);
    echo "batch kept going\n";
} catch (RuntimeError $failed) {
    echo "batch stopped\n";
}
echo "after ", $db->query("select count(*) as n from t", [])->first()?->int("n") ?? -1, "\n";
foreach ($db->query("select name from t order by id", [])->all() as Core\Db\Row $row) {
    echo "name ", $row->string("name") ?? "?", "\n";
}
--FILE nvs.toml--
# § 3: a SQLite connection's file path comes from its config block.
[capabilities.db]
connect = ["main"]

[db.main]
driver = "sqlite"
path = ":memory:"
--ORACLE--
<?php
$db = new SQLite3(':memory:');
$db->enableExceptions(true);
$db->exec("create table t (id integer primary key, name text not null)");

function executeMany(SQLite3 $db, string $sql, array $sets): int {
    // One prepare, one execution per set, the counts summed.
    $stmt = $db->prepare($sql);
    $total = 0;
    foreach ($sets as $set) {
        $stmt->reset();
        foreach ($set as $i => $value) {
            $stmt->bindValue($i + 1, $value, $value === null ? SQLITE3_NULL : SQLITE3_TEXT);
        }
        $stmt->execute();
        $total += $db->changes();
    }
    return $total;
}

echo "batched ", executeMany($db, "insert into t (name) values (?)", [["ada"], ["grace"], ["alan"]]), "\n";
echo "renamed ", executeMany($db, "update t set name = ? where name = ?", [["ada", "ada lovelace"], ["nobody", "no one"]]), "\n";

try {
    executeMany($db, "insert into t (name) values (?)", [["edsger"], [null], ["barbara"]]);
    echo "batch kept going\n";
} catch (Exception $failed) {
    echo "batch stopped\n";
}
$after = $db->query("select count(*) as n from t")->fetchArray(SQLITE3_ASSOC);
echo "after ", $after === false ? -1 : $after['n'], "\n";
$result = $db->query("select name from t order by id");
while ($row = $result->fetchArray(SQLITE3_ASSOC)) {
    echo "name ", $row['name'], "\n";
}
