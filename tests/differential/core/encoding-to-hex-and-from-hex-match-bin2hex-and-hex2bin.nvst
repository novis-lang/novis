--TEST--
`Core\Encoding::toHex` and `::fromHex` answer what `bin2hex` and `hex2bin` answer over every octet value at both nibble positions, in the same lower-case alphabet, and the pair round-trips a buffer holding all 256 octets (spec § 7, ADR 0009 § 1)
--FILE--
<?nvs
// Hex is the spelling every other case in this directory renders `bytes`
// through, so it is the one member pair whose agreement with PHP the rest of
// them quietly assume. That is the argument for a file: if `toHex` had its
// own alphabet or its own nibble order, a dozen digest cases would agree with
// PHP about nothing and still pass, because both halves would be reading the
// same wrong spelling.
final class Show {
    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

// The empty buffer, one octet at each end of the range, a buffer whose octets
// are the same nibble twice, and a subject where the two nibbles differ — so
// a transposed pair prints differently rather than symmetrically.
array<string> $inputs = ["", "00", "ff", "0f", "f0", "1234567890abcdef", "0001027f8081fe"];

echo "hex:";
foreach ($inputs as string $hex) {
    echo "[", Core\Encoding::toHex(Core\Encoding::fromHex($hex)), "]";
}
echo "\n";

// The alphabet is lower case on both sides, which is a choice rather than a
// necessity — `bin2hex` made it first and every stored digest in every
// database since has inherited it.
echo "case:", Show::flag(Core\Encoding::toHex(Core\Encoding::fromHex("abcdef")) == "abcdef"), "|",
    Show::flag(Core\Encoding::toHex(Core\Encoding::fromHex("abcdef")) == "ABCDEF"), "\n";

// Every octet value, at both nibble positions, in one buffer: 256 octets
// built by walking the range rather than by writing them out, so the row is
// the whole domain and not a sample of it.
string $all = "";
uint $value = 0;
while ($value < 256) {
    $all = $all . Core\Str::padStart(Core\Math::toBase($value as int, 16), 2, "0");
    $value = $value + 1;
}
bytes $every = Core\Encoding::fromHex($all);
echo "width:", Core\Bytes::length($every), "|", Core\Str::length(Core\Encoding::toHex($every)), "\n";
echo "digest:", Core\Encoding::toHex(Core\Hash::of($every, Core\Digest::Sha256)), "\n";

// Two octets per character each way, and the round trip is the identity —
// counted over the corpus plus the full-domain buffer.
int $held = 0;
int $cells = 0;
array<string> $subjects = ["", "00", "ff", "0f", "f0", "1234567890abcdef", "0001027f8081fe", $all];
foreach ($subjects as string $hex) {
    $cells = $cells + 2;
    bytes $raw = Core\Encoding::fromHex($hex);
    if (Core\Str::length(Core\Encoding::toHex($raw)) as int == Core\Bytes::length($raw) as int * 2) {
        $held = $held + 1;
    }
    if (Core\Encoding::toHex($raw) == $hex) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
--ORACLE--
<?php
function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

$inputs = ["", "00", "ff", "0f", "f0", "1234567890abcdef", "0001027f8081fe"];

echo "hex:";
foreach ($inputs as $hex) {
    echo "[", bin2hex(hex2bin($hex)), "]";
}
echo "\n";

echo "case:", flag(bin2hex(hex2bin("abcdef")) === "abcdef"), "|",
    flag(bin2hex(hex2bin("abcdef")) === "ABCDEF"), "\n";

$all = "";
for ($value = 0; $value < 256; $value++) {
    $all = $all . str_pad(base_convert((string) $value, 10, 16), 2, "0", STR_PAD_LEFT);
}
$every = hex2bin($all);
echo "width:", strlen($every), "|", strlen(bin2hex($every)), "\n";
echo "digest:", hash("sha256", $every), "\n";

$held = 0;
$cells = 0;
$subjects = ["", "00", "ff", "0f", "f0", "1234567890abcdef", "0001027f8081fe", $all];
foreach ($subjects as $hex) {
    $cells = $cells + 2;
    $raw = hex2bin($hex);
    if (strlen(bin2hex($raw)) === strlen($raw) * 2) {
        $held = $held + 1;
    }
    if (bin2hex($raw) === $hex) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
