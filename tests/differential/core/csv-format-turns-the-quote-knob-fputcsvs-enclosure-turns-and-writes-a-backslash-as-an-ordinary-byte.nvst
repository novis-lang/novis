--TEST--
Core\Csv::format's {quote:} knob writes what fputcsv's enclosure argument writes — the chosen byte encloses, and it is the byte that doubles inside — and a backslash is an ordinary field byte to both, because the dialect this writer has is the one PHP spells with an empty $escape
--FILE--
<?nvs
// The neighbouring `csv-format-writes-the-records-fputcsv-writes` turns the
// separator and header knobs; this one turns the third, which is the knob that
// changes *two* rules at once — which byte encloses a field, and which byte
// has to be doubled inside one. A writer that quoted with the new byte and
// went on doubling `"` would still look right on a row holding neither.
//
// PHP's `$escape` is `""` on both sides of every row below, which is the
// dialect `Core\Csv` has: the writer takes no `escape` option at all
// (`csv.rs:292`), because doubling is the only spelling of an inner quote it
// writes. So a backslash here is an ordinary byte, and these rows are what
// says so rather than a comment claiming it.
final class Show {
    public static function of(string $document): string {
        return "[" . Core\Str::replaceAll($document, ["\r" => "<CR>", "\n" => "<LF>"]) . "]";
    }
}

// The chosen quote byte encloses and doubles; the default one is now an
// ordinary byte and is written bare, which is the half a writer that only
// swapped the enclosing byte would get wrong.
array<array<string>> $both = [["a'b", "c\"d"]];
echo Show::of(Core\Csv::format($both, {quote: "'"})), "\n";

// The separator still forces the quote under the new dialect, and a field
// holding both bytes is enclosed by one and doubles the other.
array<array<string>> $mixed = [["x,y", "z'w"]];
echo Show::of(Core\Csv::format($mixed, {quote: "'"})), "\n";

// Under the default dialect the two bytes swap roles, so the same two fields
// are written the other way around.
echo Show::of(Core\Csv::format($both)), "\n";
echo Show::of(Core\Csv::format($mixed)), "\n";

// A field that is nothing but the quote byte, which is the shortest document
// in which the doubling is visible at all.
array<array<string>> $alone = [["\"", "'"]];
echo Show::of(Core\Csv::format($alone)), "\n";
echo Show::of(Core\Csv::format($alone, {quote: "'"})), "\n";

// The backslash: an ordinary byte, so it neither forces a quote nor protects
// the one after it from being doubled.
array<array<string>> $slashes = [["c\\d"], ["a\\\"b"], ["\\"]];
echo Show::of(Core\Csv::format($slashes)), "\n";
--ORACLE--
<?php
function show(string $document): string {
    return "[" . strtr($document, ["\r" => "<CR>", "\n" => "<LF>"]) . "]";
}

// `$escape` is `""` everywhere, which is the dialect Novis has and the one PHP
// 8.5 defaults to; `$eol` is the `LF` this writer terminates every record with.
function writeCsv(array $rows, string $enclosure = "\""): string {
    $handle = fopen("php://memory", "r+");
    foreach ($rows as $row) {
        fputcsv($handle, $row, ",", $enclosure, "", "\n");
    }
    rewind($handle);
    $out = stream_get_contents($handle);
    fclose($handle);
    return $out;
}

$both = [["a'b", "c\"d"]];
echo show(writeCsv($both, "'")), "\n";

$mixed = [["x,y", "z'w"]];
echo show(writeCsv($mixed, "'")), "\n";

echo show(writeCsv($both)), "\n";
echo show(writeCsv($mixed)), "\n";

$alone = [["\"", "'"]];
echo show(writeCsv($alone)), "\n";
echo show(writeCsv($alone, "'")), "\n";

$slashes = [["c\\d"], ["a\\\"b"], ["\\"]];
echo show(writeCsv($slashes)), "\n";
