--TEST--
Core\Json::encode's escapeUnicode option is json_encode's default escaping exactly — the \uXXXX for every non-ASCII code point in a value and in a key alike, an astral one as its surrogate pair, and no change to any escape JSON already required, spec § 6
--FILE--
<?nvs
// `{escapeUnicode: true}` is one of the two flags of `json_encode`'s fifteen
// that survived into spec § 6 (`json.rs:192`), and it is the one whose sense is
// *inverted*: escaping non-ASCII is PHP's default and Novis's opt-in, so the
// oracle here passes no flags at all. Nothing below holds a `/`, which is the
// other half of PHP's default that has no Novis spelling and is pinned in
// `json-encode-writes-the-slash-bare-and-indents-two-spaces-where-json_encode-escapes-it-and-indents-four`.
//
// The unescaped default is `json-encode-matches-json_encode-over-the-scalars-the-escapes-and-the-two-array-shapes`'s,
// so what this case adds is the post-pass itself: `escape_non_ascii` rewrites
// the finished document rather than formatting through it (`json.rs:28`), and
// what that has to get right is which parts of a document a non-ASCII byte can
// occur in.

// One code point per UTF-8 length, and the boundary the escaping is defined
// at: 0x7f is ASCII and stays the byte it is, 0x80 is the first one escaped.
echo Core\Json::encode("caf\u{e9}", {escapeUnicode: true}), "\n";
echo Core\Json::encode("\u{80}", {escapeUnicode: true}), "\n";
echo Core\Json::encode("\u{7ff}", {escapeUnicode: true}), "\n";
echo Core\Json::encode("\u{65e5}\u{672c}\u{8a9e}", {escapeUnicode: true}), "\n";
echo Core\Json::encode("\u{ffff}", {escapeUnicode: true}), "\n";

// Past the BMP there is no single `\uXXXX`, so both writers spell an astral
// code point as the UTF-16 surrogate pair — the one place this escaping is not
// a per-code-point substitution.
echo Core\Json::encode("\u{10000}", {escapeUnicode: true}), "\n";
echo Core\Json::encode("\u{1f600}", {escapeUnicode: true}), "\n";
echo Core\Json::encode("\u{10ffff}", {escapeUnicode: true}), "\n";

// A code point that decomposes is two code points and gets two escapes, not
// one: the option escapes what the string holds and normalizes nothing.
echo Core\Json::encode("e\u{301}", {escapeUnicode: true}), "\n";

// The escapes JSON already required are unchanged by the option — it adds a
// band, it does not re-spell one. A quote, a backslash and a control byte come
// out of the writer, not out of the post-pass.
echo Core\Json::encode("\"\\\u{9}\u{a}\u{1f}\u{e9}", {escapeUnicode: true}), "\n";

// Non-ASCII occurs in three places in a document and the post-pass has to
// reach all of them: a string value, an object key, and a string nested inside
// an array inside another object.
echo Core\Json::encode(["caf\u{e9}" => "\u{fc}ber"], {escapeUnicode: true}), "\n";
echo Core\Json::encode(["\u{1f600}"], {escapeUnicode: true}), "\n";
echo Core\Json::encode(["a" => ["\u{e9}", "b"], "\u{df}" => ["c"]], {escapeUnicode: true}), "\n";

// And a document with nothing to escape is the same document under either
// setting, which is what says the post-pass never touches a structural byte,
// a number or a keyword.
echo Core\Json::encode(["n" => 1, "t" => true, "s" => "ascii"], {escapeUnicode: true}), "\n";

// The two options compose. A scalar is the subject that says so here because
// it has no layout for `pretty` to choose, and so it is the one subject whose
// pretty spelling `JSON_PRETTY_PRINT` agrees with byte for byte — the indent
// widths do not, which is
// `json-encode-writes-the-slash-bare-and-indents-two-spaces-where-json_encode-escapes-it-and-indents-four`'s.
echo Core\Json::encode("caf\u{e9}", {pretty: true, escapeUnicode: true}), "\n";
--ORACLE--
<?php
echo json_encode("caf\u{e9}"), "\n";
echo json_encode("\u{80}"), "\n";
echo json_encode("\u{7ff}"), "\n";
echo json_encode("\u{65e5}\u{672c}\u{8a9e}"), "\n";
echo json_encode("\u{ffff}"), "\n";

echo json_encode("\u{10000}"), "\n";
echo json_encode("\u{1f600}"), "\n";
echo json_encode("\u{10ffff}"), "\n";

echo json_encode("e\u{301}"), "\n";

echo json_encode("\"\\\u{9}\u{a}\u{1f}\u{e9}"), "\n";

echo json_encode(["caf\u{e9}" => "\u{fc}ber"]), "\n";
echo json_encode(["\u{1f600}"]), "\n";
echo json_encode(["a" => ["\u{e9}", "b"], "\u{df}" => ["c"]]), "\n";

echo json_encode(["n" => 1, "t" => true, "s" => "ascii"]), "\n";

echo json_encode("caf\u{e9}", JSON_PRETTY_PRINT), "\n";
