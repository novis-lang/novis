--TEST--
Core\Str::countOf matches substr_count, counting non-overlapping occurrences where lastIndexOf's scan overlaps (ADR 0063 R20)
--FILE--
<?mwl
// A count partitions the subject where a position search does not, so
// `countOf("aaa", "aa")` is 1 while `lastIndexOf("aaa", "aa")` is 1 *because*
// it found the occurrence at 1 that this member has already consumed the "a"
// of. `substr_count` draws the line in the same place, which is the row that
// makes this a twin rather than a coincidence.
echo Core\Str::countOf("aaa", "aa"), "\n";
echo Core\Str::countOf("aaaa", "aa"), "\n";
echo Core\Str::countOf("aaaaa", "aa"), "\n";

// The ordinary rows, and the two ends: a needle that is not there at all, and
// one that is the whole subject.
echo Core\Str::countOf("banana", "a"), "\n";
echo Core\Str::countOf("banana", "na"), "\n";
echo Core\Str::countOf("banana", "z"), "\n";
echo Core\Str::countOf("banana", "banana"), "\n";
echo Core\Str::countOf("", "a"), "\n";

// There is no {caseInsensitive} here, because PHP has no `substr_icount` for
// it to replace: the member counts what it is given, case and all.
echo Core\Str::countOf("aAaA", "a"), "\n";
echo Core\Str::countOf("aAaA", "A"), "\n";
echo Core\Str::countOf("aAaA", "aA"), "\n";
--ORACLE--
<?php
echo substr_count("aaa", "aa"), "\n";
echo substr_count("aaaa", "aa"), "\n";
echo substr_count("aaaaa", "aa"), "\n";

echo substr_count("banana", "a"), "\n";
echo substr_count("banana", "na"), "\n";
echo substr_count("banana", "z"), "\n";
echo substr_count("banana", "banana"), "\n";
echo substr_count("", "a"), "\n";

echo substr_count("aAaA", "a"), "\n";
echo substr_count("aAaA", "A"), "\n";
echo substr_count("aAaA", "aA"), "\n";
