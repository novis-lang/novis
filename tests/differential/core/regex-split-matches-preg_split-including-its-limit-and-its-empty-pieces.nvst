--TEST--
Core\Regex::split cuts a subject where preg_split cuts it, including the empty pieces at both ends, the piece a limit leaves whole, and the captured delimiter neither of them keeps
--FILE--
<?nvs
// Spec § 5's `split` row against its PHP twin. The conformance cases beside
// this one count the pieces and put them back with `Core\Str::join`; neither
// asks whether PCRE would have cut in the same places, and the places are the
// interesting part — a separator matching at the very front or the very back
// of the subject, two separators with nothing between them, and a zero-width
// separator that has to advance a position it did not consume.
//
// Both sides render the pieces joined by a character no row contains, then the
// count in parentheses. The count is what makes an empty piece visible: `a||b`
// and `a|b` are two pieces apart, and `echo` alone renders the difference as
// one extra separator that reads like a typo.
final class Render {
    public static function of(array<string> $pieces): string {
        return Core\Str::join($pieces, "|") . " (" . (Core\Arr::count($pieces) as string) . ")";
    }
}

array<array<string>> $rows = [
    ["The Quick,  brown FOX", "[,\\s]+"],
    ["a1b2c3d", "\\d"],
    [",a,,b,", ","],
    ["nothing to split here", "\\d+"],
    ["aXbXXc", "X+"],
    ["", ","],
    ["", "x*"],
    ["a,b", "(,)"],
    ["abc", "x*"],
    ["a-b_c", "[-_]"],
    ["aaa", "a"],
    ["one", "^"],
];

foreach ($rows as array<string> $row) {
    echo Render::of(Core\Regex::split($row["0"], $row["1"])), "\n";
}

// `limit` bounds the number of *pieces*, not the number of cuts, so the last
// piece keeps every separator the limit stopped short of. PHP's `-1` and `0`
// both mean "no limit"; `Core\Regex`'s option is a `uint` and spells that by
// omission, so the sweep starts at one and the omitted form is the row above.
echo Render::of(Core\Regex::split("a1b2c3d", "\\d", {limit: 1})), "\n";
echo Render::of(Core\Regex::split("a1b2c3d", "\\d", {limit: 2})), "\n";
echo Render::of(Core\Regex::split("a1b2c3d", "\\d", {limit: 3})), "\n";
echo Render::of(Core\Regex::split("a1b2c3d", "\\d", {limit: 9})), "\n";

// `{keepEmpty: false}` is `PREG_SPLIT_NO_EMPTY` — the same pieces with the
// empty ones dropped, wherever they fell.
echo Render::of(Core\Regex::split(",a,,b,", ",", {keepEmpty: false})), "\n";
echo Render::of(Core\Regex::split("abc", "x*", {keepEmpty: false})), "\n";
echo Render::of(Core\Regex::split("", ",", {keepEmpty: false})), "\n";

// The two options *together* are not here, and neither is a `limit` of zero or
// below: those are where the member parts from `preg_split` by decision, and
// `nvs_core_regex_split`'s doc comment owns the reason — `limit` counts the
// pieces the split produced rather than the ones that survived the flag, and
// it is `Core\Str::split`'s reading of the word rather than `preg_split`'s.
// The divergence case beside this one pins every row of that.
--ORACLE--
<?php
function render(array $pieces): string {
    return implode("|", $pieces) . " (" . count($pieces) . ")";
}

$rows = [
    ['The Quick,  brown FOX', '[,\\s]+'],
    ['a1b2c3d', '\\d'],
    [',a,,b,', ','],
    ['nothing to split here', '\\d+'],
    ['aXbXXc', 'X+'],
    ['', ','],
    ['', 'x*'],
    ['a,b', '(,)'],
    ['abc', 'x*'],
    ['a-b_c', '[-_]'],
    ['aaa', 'a'],
    ['one', '^'],
];

foreach ($rows as $row) {
    echo render(preg_split("/" . $row[1] . "/", $row[0])), "\n";
}

foreach ([1, 2, 3, 9] as $limit) {
    echo render(preg_split('/\d/', 'a1b2c3d', $limit)), "\n";
}

echo render(preg_split('/,/', ',a,,b,', -1, PREG_SPLIT_NO_EMPTY)), "\n";
echo render(preg_split('/x*/', 'abc', -1, PREG_SPLIT_NO_EMPTY)), "\n";
echo render(preg_split('/,/', '', -1, PREG_SPLIT_NO_EMPTY)), "\n";
