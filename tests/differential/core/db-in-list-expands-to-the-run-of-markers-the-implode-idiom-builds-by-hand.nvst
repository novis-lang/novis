--TEST--
Core\Db::inList binds a run of values at one placeholder, answering what PHP's implode-of-question-marks idiom answers over IN and NOT IN — and refusing the empty list the idiom builds a syntax error out of — `rule:core-classes/db-parameters`
--FILE--
<?nvs
// § 5's marker is the explicit form of the idiom every PHP codebase writes by
// hand: build as many `?` as there are values, glue them with commas, then bind
// them in the same order. The rows have to agree — and what does not have a twin
// is the arity, which `nvs_db::sql::rewrite` counts into § 1's cache key while
// the idiom's SQL text is a new statement every time the list changes length.
use Core\Db;

var $db = Db::connect("main");
$db->execute("create table t (id integer primary key, name text not null)", []);
array<string> $names = ["ada", "grace", "alan", "edsger", "barbara"];
foreach ($names as string $name) {
    $db->execute("insert into t (name) values (?)", [$name]);
}

// One argument, several markers: the statement is written `in ?` and the
// expansion is the rewriter's, so the program never builds SQL from a count.
array<int> $ids = [2, 3, 5];
var $chosen = $db->query("select name from t where id in ? order by id", [Db::inList($ids)]);
echo "chosen ", $chosen->count(), "\n";
foreach ($chosen->all() as Core\Db\Row $row) {
    echo "name ", $row->string("name") ?? "?", "\n";
}

// The complement, on the same marker: `NOT IN` is where an empty list would mean
// the opposite of what it means above, which is the whole reason for the
// refusal below.
var $rest = $db->query("select name from t where id not in ? order by id", [Db::inList($ids)]);
echo "rest ", $rest->count(), "\n";
foreach ($rest->all() as Core\Db\Row $row) {
    echo "name ", $row->string("name") ?? "?", "\n";
}

// A shorter list is the same statement text with a different arity, so nothing
// the program wrote changes between the two calls.
array<int> $one = [4];
var $single = $db->query("select name from t where id in ? order by id", [Db::inList($one)]);
echo "single ", $single->count(), "\n";
foreach ($single->all() as Core\Db\Row $row) {
    echo "name ", $row->string("name") ?? "?", "\n";
}

// What has no twin here is `inList([])`, which throws: SQLite accepts the `in ()`
// the idiom builds and reads it as "match nothing" while reading `not in ()` as
// "match everything", which is exactly the ambiguity § 5 refuses to pick a side
// of. `db-in-list-refuses-an-empty-list` pins the refusal.
--FILE nvs.toml--
# § 3: a SQLite connection's file path comes from its config block.
[capabilities.db]
connect = ["main"]

[db.main]
driver = "sqlite"
path = ":memory:"
--ORACLE--
<?php
$db = new SQLite3(':memory:');
$db->exec("create table t (id integer primary key, name text not null)");
$insert = $db->prepare("insert into t (name) values (?)");
foreach (["ada", "grace", "alan", "edsger", "barbara"] as $name) {
    $insert->reset();
    $insert->bindValue(1, $name, SQLITE3_TEXT);
    $insert->execute();
}

function inList(SQLite3 $db, string $sql, array $ids, string $label): void {
    // The idiom: the SQL text is a function of the list's length.
    $markers = implode(',', array_fill(0, count($ids), '?'));
    $stmt = $db->prepare(str_replace('?list?', '(' . $markers . ')', $sql));
    foreach ($ids as $i => $id) {
        $stmt->bindValue($i + 1, $id, SQLITE3_INTEGER);
    }
    $result = $stmt->execute();
    $rows = [];
    while ($row = $result->fetchArray(SQLITE3_ASSOC)) {
        $rows[] = $row;
    }
    echo $label, " ", count($rows), "\n";
    foreach ($rows as $row) {
        echo "name ", $row['name'], "\n";
    }
}

$ids = [2, 3, 5];
inList($db, "select name from t where id in ?list? order by id", $ids, "chosen");
inList($db, "select name from t where id not in ?list? order by id", $ids, "rest");
inList($db, "select name from t where id in ?list? order by id", [4], "single");
