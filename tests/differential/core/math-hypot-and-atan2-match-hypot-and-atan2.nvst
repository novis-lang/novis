--TEST--
Core\Math::hypot answers what PHP's hypot does including where the naive sqrt of two squares overflows, and Core\Math::atan2 keeps PHP's y-then-x argument order and its signed-zero quadrants
--FILE--
<?nvs
// Spec § 3's `hypot` and `atan2` rows. Both are one PHP function each with
// the same name and the same argument order, so the whole question is whether
// the answers agree — and the two places they could stop agreeing are the
// ones neither member guards: the magnitudes where an intermediate square
// overflows, and the signs of a zero, which is the only input where `atan2`
// carries information that `$y == 0.0` cannot see.

final class Show {
    // `NAN` coerced to a string is a warning in PHP 8.4 and later, so neither
    // side renders one: a value that is not equal to itself is the only `NAN`
    // there is, and the sentinel is what both languages print instead.
    public static function real(float $value): string {
        if ($value == $value) {
            return $value as string;
        }
        return "nan";
    }
}

float $huge = Core\Math::INFINITY;
float $nan = Core\Math::NAN;

// The two Pythagorean triples and the unit diagonal. A sign on either leg is
// squared away, so all four sign combinations of `(3, 4)` answer `5` — the
// rows that say neither member is reading a sign it should not.
echo Core\Math::hypot(3.0, 4.0), " ", Core\Math::hypot(-3.0, 4.0), " ", Core\Math::hypot(3.0, -4.0), " ", Core\Math::hypot(-3.0, -4.0), "\n";
echo Core\Math::hypot(5.0, 12.0), " ", Core\Math::hypot(1.0, 1.0), " ", Core\Math::hypot(0.0, 0.0), " ", Core\Math::hypot(-0.0, -0.0), "\n";

// A leg of zero is the other leg's magnitude, in either position and either
// sign — which is what makes `hypot` a usable absolute value and is the row a
// member computing `sqrt($a * $a + $b * $b)` also passes.
echo Core\Math::hypot(0.0, -7.0), " ", Core\Math::hypot(-7.0, 0.0), "\n";

// The magnitude the naive form cannot reach. `1.0e200 * 1.0e200` overflows to
// an infinity, so `sqrt($a * $a + $b * $b)` answers `INF` where `hypot`
// answers the value — that is the whole reason this member exists rather than
// being spelled out at the call site, and both languages get it right. The
// sweep at the foot counts how many rows the two forms part on.
echo Core\Math::hypot(1.0e200, 1.0e200), " ", Core\Math::sqrt(1.0e200 * 1.0e200 + 1.0e200 * 1.0e200), "\n";

// An infinite leg is infinite whatever the other leg is — including a `NAN`,
// which IEEE says `hypot` swallows rather than propagates. Two `NAN`s with no
// infinity beside them stay `NAN`.
echo Core\Math::hypot($huge, 1.0), " ", Core\Math::hypot(1.0, $huge), " ", Core\Math::hypot($huge, $nan), "\n";
echo Show::real(Core\Math::hypot($nan, 1.0)), " ", Show::real(Core\Math::hypot(1.0, $nan)), "\n";

// The four quadrants, `$y` first. The magnitudes are all `1`, so what the
// four answers differ in is only the quadrant — and a member that took `$x`
// first would answer this line with the first and third entries swapped in
// sign while still looking like four plausible angles.
echo Core\Math::atan2(1.0, 1.0), " ", Core\Math::atan2(1.0, -1.0), " ", Core\Math::atan2(-1.0, -1.0), " ", Core\Math::atan2(-1.0, 1.0), "\n";

// The order again, asserted where the two spellings are not each other's
// negation: `atan2(1, 2)` and `atan2(2, 1)` are different angles, and their
// sum is a right angle.
echo Core\Math::atan2(1.0, 2.0), " ", Core\Math::atan2(2.0, 1.0), " ", Core\Math::atan2(1.0, 2.0) + Core\Math::atan2(2.0, 1.0), "\n";

// The axes, where one argument is zero and the answer is a quarter turn or a
// half turn rather than something a ratio could produce.
echo Core\Math::atan2(1.0, 0.0), " ", Core\Math::atan2(-1.0, 0.0), " ", Core\Math::atan2(0.0, 1.0), " ", Core\Math::atan2(0.0, -1.0), "\n";

// The four signed zeros — the only inputs where `atan2` reads a sign that
// `== 0.0` cannot see. `(-0.0, -0.0)` is `-PI` and `(0.0, -0.0)` is `PI`; a
// member normalizing a zero away would answer `0` to all four.
echo Core\Math::atan2(0.0, 0.0), " ", Core\Math::atan2(-0.0, 0.0), " ", Core\Math::atan2(0.0, -0.0), " ", Core\Math::atan2(-0.0, -0.0), "\n";

// The infinite quadrants, where both legs are infinite and the answer is the
// diagonal of whichever quadrant they name, and the `NAN` that propagates
// because no infinity is present to decide it.
echo Core\Math::atan2($huge, $huge), " ", Core\Math::atan2($huge, 0.0 - $huge), " ", Core\Math::atan2(0.0 - $huge, $huge), " ", Core\Math::atan2($huge, 1.0), "\n";
echo Show::real(Core\Math::atan2($nan, 1.0)), " ", Show::real(Core\Math::atan2(1.0, $nan)), "\n";

// Three properties over every ordered pair drawn from one table, asserted by
// *counting* so that a member answering plausibly row by row above still
// fails here. The table spans both signs, a zero, and a magnitude whose
// square overflows.
//
//  - symmetry: `hypot($x, $y)` is `hypot($y, $x)`, which must hold on every
//    row, overflow included;
//  - the naive form: `sqrt($x * $x + $y * $y)`, which holds on most rows and
//    not on the ones that overflow or lose bits — which rows those are does
//    not matter, only that both languages part from it on the same ones;
//  - the polar round trip: rebuilding `$x` from the angle and the magnitude,
//    which is not a `float` identity and is not expected to hold everywhere.
//
// All three counts are printed beside the row total, so a sweep that silently
// stopped short cannot agree with itself.
array<float> $legs = [0.0, 1.0, -1.0, 3.0, -4.0, 0.5, 1.0e200, -1.0e200];
int $symmetric = 0;
int $naive = 0;
int $polar = 0;
int $pairs = 0;
foreach ($legs as float $x) {
    foreach ($legs as float $y) {
        $pairs = $pairs + 1;
        if (Core\Math::hypot($x, $y) == Core\Math::hypot($y, $x)) {
            $symmetric = $symmetric + 1;
        }
        if (Core\Math::hypot($x, $y) == Core\Math::sqrt($x * $x + $y * $y)) {
            $naive = $naive + 1;
        }
        if (Core\Math::hypot($x, $y) * Core\Math::cos(Core\Math::atan2($y, $x)) == $x) {
            $polar = $polar + 1;
        }
    }
}
echo $symmetric, " ", $naive, " ", $polar, " ", $pairs, "\n";
--ORACLE--
<?php
function real(float $value): string {
    if ($value == $value) {
        return (string) $value;
    }
    return "nan";
}

$huge = INF;
$nan = NAN;

echo hypot(3.0, 4.0), " ", hypot(-3.0, 4.0), " ", hypot(3.0, -4.0), " ", hypot(-3.0, -4.0), "\n";
echo hypot(5.0, 12.0), " ", hypot(1.0, 1.0), " ", hypot(0.0, 0.0), " ", hypot(-0.0, -0.0), "\n";

echo hypot(0.0, -7.0), " ", hypot(-7.0, 0.0), "\n";

echo hypot(1.0e200, 1.0e200), " ", sqrt(1.0e200 * 1.0e200 + 1.0e200 * 1.0e200), "\n";

echo hypot($huge, 1.0), " ", hypot(1.0, $huge), " ", hypot($huge, $nan), "\n";
echo real(hypot($nan, 1.0)), " ", real(hypot(1.0, $nan)), "\n";

echo atan2(1.0, 1.0), " ", atan2(1.0, -1.0), " ", atan2(-1.0, -1.0), " ", atan2(-1.0, 1.0), "\n";

echo atan2(1.0, 2.0), " ", atan2(2.0, 1.0), " ", atan2(1.0, 2.0) + atan2(2.0, 1.0), "\n";

echo atan2(1.0, 0.0), " ", atan2(-1.0, 0.0), " ", atan2(0.0, 1.0), " ", atan2(0.0, -1.0), "\n";

echo atan2(0.0, 0.0), " ", atan2(-0.0, 0.0), " ", atan2(0.0, -0.0), " ", atan2(-0.0, -0.0), "\n";

echo atan2($huge, $huge), " ", atan2($huge, 0.0 - $huge), " ", atan2(0.0 - $huge, $huge), " ", atan2($huge, 1.0), "\n";
echo real(atan2($nan, 1.0)), " ", real(atan2(1.0, $nan)), "\n";

$legs = [0.0, 1.0, -1.0, 3.0, -4.0, 0.5, 1.0e200, -1.0e200];
$symmetric = 0;
$naive = 0;
$polar = 0;
$pairs = 0;
foreach ($legs as $x) {
    foreach ($legs as $y) {
        $pairs = $pairs + 1;
        if (hypot($x, $y) == hypot($y, $x)) {
            $symmetric = $symmetric + 1;
        }
        if (hypot($x, $y) == sqrt($x * $x + $y * $y)) {
            $naive = $naive + 1;
        }
        if (hypot($x, $y) * cos(atan2($y, $x)) == $x) {
            $polar = $polar + 1;
        }
    }
}
echo $symmetric, " ", $naive, " ", $polar, " ", $pairs, "\n";
