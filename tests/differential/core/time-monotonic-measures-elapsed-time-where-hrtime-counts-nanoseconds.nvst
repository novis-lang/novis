--TEST--
Core\Time::monotonic agrees with hrtime(true) on every property a measuring clock can be held to — spec § 4
--FILE--
<?nvs
// `Core\Time::monotonic(): Duration` is `hrtime(true)`'s replacement, and like
// it has no value a case could pin: the reading means nothing except against
// another reading of the same clock, and the two implementations do not even
// share an origin — Novis fixes one at the first call, PHP hands back the
// operating system's own. So every row is a property of the *difference*, or of
// one reading's own scales, computed on each side from that side's own clock.
var $first = Core\Time::monotonic();

// One reading is one point, so its nanoseconds, microseconds and milliseconds
// are one number scaled and not three readings of the clock. PHP asks the same
// question of its own two spellings, `hrtime()`'s [seconds, nanoseconds] pair
// against the nanosecond count `hrtime(true)` hands back.
int $nanos = $first->toNanoseconds();
echo "microsAgree=", Core\Math::intDiv($nanos, 1000) == $first->toMicroseconds() ? "yes" : "no", "\n";
echo "millisAgree=", Core\Math::intDiv($nanos, 1000000) == $first->toMilliseconds() ? "yes" : "no", "\n";
echo "secondsAgree=", Core\Math::intDiv($nanos, 1000000000) == $first->toSeconds() ? "yes" : "no", "\n";

// It is not a wall clock, which is the distinction the member exists to draw:
// whatever origin either implementation chose, the count since it is nowhere
// near the count since 1970.
echo "notAWallClock=", $first->toSeconds() < Core\Time::now()->toEpochSeconds() ? "yes" : "no", "\n";

// The ordering, which is the one thing `Core\Time::now` cannot promise: a
// monotonic clock never steps backwards, so a later reading is never behind an
// earlier one and the difference between them is never negative.
int $sum = 0;
int $i = 0;
while ($i < 200000) {
    $sum = $sum + $i;
    $i = $i + 1;
}
var $second = Core\Time::monotonic();
echo "nonDecreasing=", $second->compareTo($first) >= 0 ? "yes" : "no", "\n";
echo "elapsedNonNegative=", $second->minus($first)->toNanoseconds() >= 0 ? "yes" : "no", "\n";

// The work between the two readings took some time, and not five seconds of it.
echo "advancedAcrossWork=", $second->minus($first)->toNanoseconds() > 0 ? "yes" : "no", "\n";
echo "underFiveSeconds=", $second->minus($first)->toSeconds() < 5 ? "yes" : "no", "\n";
echo "sumIsWhatItWas=", $sum == 19999900000 ? "yes" : "no", "\n";
--ORACLE--
<?php
$first = hrtime(true);

// PHP's own two spellings of one reading: `hrtime()` hands back a
// [seconds, nanoseconds] pair where `hrtime(true)` hands back the nanoseconds.
$pair = hrtime();
$nanos = $pair[0] * 1000000000 + $pair[1];
echo "microsAgree=", intdiv($nanos, 1000) === $pair[0] * 1000000 + intdiv($pair[1], 1000) ? "yes" : "no", "\n";
echo "millisAgree=", intdiv($nanos, 1000000) === $pair[0] * 1000 + intdiv($pair[1], 1000000) ? "yes" : "no", "\n";
echo "secondsAgree=", intdiv($nanos, 1000000000) === $pair[0] ? "yes" : "no", "\n";

echo "notAWallClock=", intdiv($first, 1000000000) < time() ? "yes" : "no", "\n";

$sum = 0;
$i = 0;
while ($i < 200000) {
    $sum = $sum + $i;
    $i = $i + 1;
}
$second = hrtime(true);
echo "nonDecreasing=", $second >= $first ? "yes" : "no", "\n";
echo "elapsedNonNegative=", $second - $first >= 0 ? "yes" : "no", "\n";

echo "advancedAcrossWork=", $second - $first > 0 ? "yes" : "no", "\n";
echo "underFiveSeconds=", intdiv($second - $first, 1000000000) < 5 ? "yes" : "no", "\n";
echo "sumIsWhatItWas=", $sum === 19999900000 ? "yes" : "no", "\n";
