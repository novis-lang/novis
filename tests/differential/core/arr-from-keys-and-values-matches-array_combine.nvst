--TEST--
Core\Arr::fromKeysAndValues pairs what array_combine pairs and refuses the same unequal lengths, on either side of the pair
--FILE--
<?nvs
// Spec § 2's `fromKeysAndValues` against its twin. Two claims share this case
// because they are one member's two halves: what it does with a pair it
// accepts, and where it stops accepting. The second half is the interesting
// one — R4 makes the length mismatch a throw, and PHP 8 made the same call a
// `ValueError`, so the two languages agree on the *bound* as well as on the
// arithmetic inside it. Both sides print a word rather than a message, because
// the wording is each implementation's own.
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

// Paired in order, and the keys array's *own* keys are ignored on both sides,
// so a map of keys and a list of keys build the same result.
array<int|string> $names = ["p" => "ann", "q" => "bob"];
array<int> $scores = ["m" => 3, "n" => 8];
echo Render::of(Core\Arr::fromKeysAndValues($names, $scores)), "\n";

// A key given twice keeps its first position and takes its last value — the
// same disagreeing pair `flip` states, asserted here against the count so that
// a member producing three entries fails on the number rather than only on the
// reading.
array<int|string> $repeat = ["a", "b", "a"];
array<int> $three = [1, 2, 3];
echo Core\Arr::count(Core\Arr::fromKeysAndValues($repeat, $three)), "|",
     Render::of(Core\Arr::fromKeysAndValues($repeat, $three)), "\n";

// `1` and `"1"` are one key, so two pairs collapse to one entry and the later
// value is the one that survives.
array<int|string> $spellings = ["1", 1];
array<int> $two = [10, 20];
echo Core\Arr::count(Core\Arr::fromKeysAndValues($spellings, $two)), "|",
     Render::of(Core\Arr::fromKeysAndValues($spellings, $two)), "\n";

// Two empty arrays are an accepted pair — equal lengths — and build nothing.
array<int|string> $noKeys = [];
array<int> $noValues = [];
echo "[", Render::of(Core\Arr::fromKeysAndValues($noKeys, $noValues)), "]\n";

// The bound, from both sides and with one of them empty. A member that checked
// only `count($keys) > count($values)` passes the first row and fails the
// second, which is why all three are here.
array<int|string> $twoKeys = ["a", "b"];
array<int> $oneValue = [1];
try { Core\Arr::fromKeysAndValues($twoKeys, $oneValue); echo "accepted "; }
catch (Throwable $more) { echo "refused "; }
try { Core\Arr::fromKeysAndValues($oneValue, $twoKeys); echo "accepted "; }
catch (Throwable $fewer) { echo "refused "; }
try { Core\Arr::fromKeysAndValues($twoKeys, $noValues); echo "accepted\n"; }
catch (Throwable $none) { echo "refused\n"; }
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$names = ["p" => "ann", "q" => "bob"];
$scores = ["m" => 3, "n" => 8];
echo render(array_combine($names, $scores)), "\n";

$repeat = ["a", "b", "a"];
$three = [1, 2, 3];
echo count(array_combine($repeat, $three)), "|", render(array_combine($repeat, $three)), "\n";

$spellings = ["1", 1];
$two = [10, 20];
echo count(array_combine($spellings, $two)), "|", render(array_combine($spellings, $two)), "\n";

$noKeys = [];
$noValues = [];
echo "[", render(array_combine($noKeys, $noValues)), "]\n";

$twoKeys = ["a", "b"];
$oneValue = [1];
try { array_combine($twoKeys, $oneValue); echo "accepted "; }
catch (ValueError $more) { echo "refused "; }
try { array_combine($oneValue, $twoKeys); echo "accepted "; }
catch (ValueError $fewer) { echo "refused "; }
try { array_combine($twoKeys, $noValues); echo "accepted\n"; }
catch (ValueError $none) { echo "refused\n"; }
