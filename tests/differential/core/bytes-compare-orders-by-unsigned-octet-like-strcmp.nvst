--TEST--
`Core\Bytes::compare` orders two buffers by unsigned octet value and then by length, which is the order `strcmp` puts them in — including the `0x7f`/`0x80` pair a signed comparison inverts — and the ordering is antisymmetric over every pair (spec § 7, `rule:core-api/shape-rules` R5)
--FILE--
<?nvs
// § 7's third departure from `Core\Str`: `compare` answers an ordering `int`
// rather than the text member's, because there is no collation to apply to
// octets. So the only question left is *which* order, and it has exactly one
// wrong answer that looks right: comparing octets as signed bytes, which puts
// `0x80` before `0x00` and is invisible on any ASCII subject. PHP's `strcmp`
// compares unsigned, so the pair below is the whole reason this file exists.
final class Show {
    // The magnitude is not part of the claim on either side — PHP's own
    // `strcmp` answered a difference rather than an ordering until 8.2 — so
    // both halves take the sign.
    public static function sign(int $n): string {
        if ($n < 0) {
            return "-";
        }
        if ($n > 0) {
            return "+";
        }
        return "0";
    }

    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

// The empty buffer, a prefix and its extension, the two octets either side of
// the signed boundary, the top of the range, and two buffers that agree on
// their first octet and part company on their second.
array<string> $buffers = ["", "00", "0000", "7f", "80", "ff", "0102", "0103"];

echo "compare:";
foreach ($buffers as string $left) {
    foreach ($buffers as string $right) {
        echo Show::sign(Core\Bytes::compare(
            Core\Encoding::fromHex($left),
            Core\Encoding::fromHex($right)
        )), "|";
    }
}
echo "\n";

// The pair that names the bug, on its own line so a reader does not have to
// find it in the matrix above: `7f` sorts before `80`, which is false of a
// signed comparison and true of every octet-ordered one.
echo "signed:", Show::sign(Core\Bytes::compare(
    Core\Encoding::fromHex("7f"),
    Core\Encoding::fromHex("80")
)), "|", Show::sign(Core\Bytes::compare(
    Core\Encoding::fromHex("80"),
    Core\Encoding::fromHex("ff")
)), "\n";

// The ordering's own laws, over every pair: a buffer equals itself, and
// swapping the operands flips the sign. A member that answered a *difference*
// of lengths, or that stopped at the shorter buffer, breaks the second.
int $held = 0;
int $cells = 0;
foreach ($buffers as string $left) {
    $cells = $cells + 1;
    if (Core\Bytes::compare(Core\Encoding::fromHex($left), Core\Encoding::fromHex($left)) == 0) {
        $held = $held + 1;
    }
    foreach ($buffers as string $right) {
        $cells = $cells + 1;
        bytes $a = Core\Encoding::fromHex($left);
        bytes $b = Core\Encoding::fromHex($right);
        if (Show::sign(Core\Bytes::compare($a, $b)) == Show::sign(0 - Core\Bytes::compare($b, $a))) {
            $held = $held + 1;
        }
    }
}
echo $held, " of ", $cells, "\n";

// A prefix sorts before its extension, which is the length half of the order
// and the one place two buffers cannot be told apart octet by octet.
echo Show::flag(Core\Bytes::compare(
    Core\Encoding::fromHex("0102"),
    Core\Encoding::fromHex("010200")
) < 0), "\n";
--ORACLE--
<?php
function sign($n) {
    if ($n < 0) {
        return "-";
    }
    if ($n > 0) {
        return "+";
    }
    return "0";
}

function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

$buffers = ["", "00", "0000", "7f", "80", "ff", "0102", "0103"];

echo "compare:";
foreach ($buffers as $left) {
    foreach ($buffers as $right) {
        echo sign(strcmp(hex2bin($left), hex2bin($right))), "|";
    }
}
echo "\n";

echo "signed:", sign(strcmp(hex2bin("7f"), hex2bin("80"))), "|",
    sign(strcmp(hex2bin("80"), hex2bin("ff"))), "\n";

$held = 0;
$cells = 0;
foreach ($buffers as $left) {
    $cells = $cells + 1;
    if (strcmp(hex2bin($left), hex2bin($left)) === 0) {
        $held = $held + 1;
    }
    foreach ($buffers as $right) {
        $cells = $cells + 1;
        $a = hex2bin($left);
        $b = hex2bin($right);
        if (sign(strcmp($a, $b)) === sign(0 - strcmp($b, $a))) {
            $held = $held + 1;
        }
    }
}
echo $held, " of ", $cells, "\n";

echo flag(strcmp(hex2bin("0102"), hex2bin("010200")) < 0), "\n";
