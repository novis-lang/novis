--TEST--
Core\Str::lines cuts at all three terminators and drops only the final empty piece, as the split PHP callers write by hand does
--FILE--
<?nvs
// Spec § 1's `lines`. Its **Replaces** column names `explode(PHP_EOL, …)`, which
// is the twin only on a host whose line ending happens to match the text's —
// the member consults no platform ending at all and cuts at `\n`, `\r\n` and a
// lone `\r` alike, so the oracle is the split a portable PHP caller writes
// instead. Two rules are being asserted together and they pull in opposite
// directions: every interior empty line survives, and the single empty piece a
// *trailing* terminator would produce does not. A member that dropped every
// empty piece passes the first four rows below and fails the fifth.
final class Render {
    public static function of(array<string> $parts): string {
        var $out = "";
        foreach ($parts as string $p) {
            $out = $out . "<" . $p . ">";
        }
        return $out;
    }
}

// The three terminators, each on its own subject and each cutting once. The
// carriage returns are consumed by the split, so nothing that reaches stdout
// carries one — which is what lets a `\r` subject be compared against PHP at
// all.
echo Render::of(Core\Str::lines("a\nb")), Render::of(Core\Str::lines("a\r\nb")), Render::of(Core\Str::lines("a\rb")), "\n";

// Mixed in one subject: the `\r\n` is one terminator rather than two, which the
// count says and the rendering alone would not.
string $mixed = "one\ntwo\r\nthree\rfour";
echo Core\Arr::count(Core\Str::lines($mixed)), "|", Render::of(Core\Str::lines($mixed)), "\n";

// An interior empty line is a piece, and so is a leading one — the two rows a
// member that filtered empties would lose.
echo Render::of(Core\Str::lines("a\n\nb")), Render::of(Core\Str::lines("\na")), "\n";

// The trailing terminator, which produces no final empty piece — and the second
// one, which produces exactly one, because only the last terminator is the
// text's own ending and the one before it ended an empty line.
echo Core\Arr::count(Core\Str::lines("a\n")), "|", Render::of(Core\Str::lines("a\n")), "|",
     Core\Arr::count(Core\Str::lines("a\n\n")), "|", Render::of(Core\Str::lines("a\n\n")), "\n";

// A subject with no terminator at all is one line, and the empty subject is no
// lines at all rather than one empty line — the reading `preg_split` does not
// take on its own, which is why the oracle's helper says it in a branch.
echo Core\Arr::count(Core\Str::lines("solo")), "|", Core\Arr::count(Core\Str::lines("")), "|",
     Render::of(Core\Str::lines("")), "\n";
--ORACLE--
<?php
function lines(string $s): array {
    if ($s === "") {
        return [];
    }
    $parts = preg_split('/\r\n|\n|\r/', $s);
    if (count($parts) > 1 && $parts[count($parts) - 1] === "") {
        array_pop($parts);
    }
    return $parts;
}

function render(array $parts): string {
    $out = "";
    foreach ($parts as $p) {
        $out = $out . "<" . $p . ">";
    }
    return $out;
}

echo render(lines("a\nb")), render(lines("a\r\nb")), render(lines("a\rb")), "\n";

$mixed = "one\ntwo\r\nthree\rfour";
echo count(lines($mixed)), "|", render(lines($mixed)), "\n";

echo render(lines("a\n\nb")), render(lines("\na")), "\n";

echo count(lines("a\n")), "|", render(lines("a\n")), "|",
     count(lines("a\n\n")), "|", render(lines("a\n\n")), "\n";

echo count(lines("solo")), "|", count(lines("")), "|", render(lines("")), "\n";
