--TEST--
Core\Str::wrap breaks an ASCII subject exactly where wordwrap does across a table of widths, both break options and both cutting readings, every line it produces is within the width once long words may be cut, and both languages refuse an empty break and a zero width that has to cut
--FILE--
<?mwl
// Spec § 1's `wrap` row. One member replaces `wordwrap` whole: PHP's third
// and fourth arguments are this member's two options, and `mwl_stdlib::str`'s
// `wrapped` says the algorithm is PHP's own, unit for unit. The subjects here
// are ASCII on purpose — the width counts grapheme clusters
// (`mwl_stdlib::granularity::DEFAULT`) where `wordwrap` counts bytes, and
// inside ASCII those are the same count, so the whole table below agrees and
// the companion divergence case is where they part.

// Eight subjects, each a shape `wordwrap`'s algorithm decides differently:
// nothing, one character, a word longer than any width here, a sentence that
// breaks cleanly, a long word with text on either side, runs of consecutive
// spaces, a subject that already contains the break string, and one whose
// last word lands exactly on a boundary.
array<string> $subjects = [
    "",
    "a",
    "woooooooooooooooord",
    "The quick brown fox jumped over the lazy dog",
    "A very long woooooooooooooord. and then some",
    "two  spaces   and    more",
    "already|wrapped and then a good deal more text",
    "abc def ghi",
];

// Widths from one to past the longest subject. Zero is a width in its own
// right — without cutting it means "break at every space", which is an
// answer rather than a refusal, and it is the argument the member and PHP
// each refuse only in combination with cutting.
array<int> $widths = [0, 1, 3, 5, 8, 11, 20, 60];

// The break string is `|` rather than the default newline so a cell stays on
// one line and a run of them is readable; the default is pinned on its own
// below. One of the subjects contains a `|` already, which is how the rule
// that a break present in the subject *resets the line* gets asserted — a
// member measuring the whole subject as one line disagrees there and nowhere
// else.
foreach ($subjects as string $subject) {
    foreach ($widths as int $width) {
        echo "[", Core\Str::wrap($subject, $width as uint, {breakWith: "|"}), "]";
    }
    echo "\n";
}

// The same table with long words cut. A zero width cannot cut, so the sweep
// starts one in: `$widths` is reused with its first entry skipped rather than
// written out again, so the two halves cannot drift apart.
foreach ($subjects as string $one) {
    foreach ($widths as int $wide) {
        if ($wide != 0) {
            echo "[", Core\Str::wrap($one, $wide as uint, {breakWith: "|", cutLongWords: true}), "]";
        }
    }
    echo "\n";
}

// The invariant that makes cutting mean something, counted rather than read
// off a line: with `cutLongWords` every line of the answer is within the
// width, on every cell of the table above. A member that cut one character
// late, or that left the tail of a long word uncut, prints plausibly in most
// cells and fails this count. Without cutting the same count is lower,
// because a word longer than the width is kept whole — the two numbers
// together are what say the option does what it is named for.
int $within = 0;
int $whole = 0;
int $lines = 0;
foreach ($subjects as string $text) {
    foreach ($widths as int $span) {
        if ($span != 0) {
            foreach (Core\Str::split(Core\Str::wrap($text, $span as uint, {breakWith: "|", cutLongWords: true}), "|") as string $line) {
                $lines = $lines + 1;
                if (Core\Str::length($line) <= $span as uint) {
                    $within = $within + 1;
                }
            }
            foreach (Core\Str::split(Core\Str::wrap($text, $span as uint, {breakWith: "|"}), "|") as string $kept) {
                if (Core\Str::length($kept) <= $span as uint) {
                    $whole = $whole + 1;
                }
            }
        }
    }
}
echo "cut: ", $within, " of ", $lines, ", uncut within: ", $whole, "\n";

// The default break is a newline, which is `wordwrap`'s default too. Printed
// between sentinels because a break at the end of a line is otherwise
// invisible.
echo "<", Core\Str::wrap("The quick brown fox jumped over the lazy dog", 15), ">\n";
echo "<", Core\Str::wrap("abc def ghi", 3), ">\n";

// A break string of more than one character, which shifts every measurement
// after it if the member measured the break as part of the line rather than
// as the end of one.
echo "<", Core\Str::wrap("The quick brown fox jumped over the lazy dog", 10, {breakWith: "<br/>"}), ">\n";

// The two arguments both languages refuse rather than answer. An empty break
// would drop the wrapping silently, and a zero width that must cut asks for a
// break before and after every character, which does not terminate; PHP
// raises `ValueError` for each and `mwl_stdlib::str` a catchable
// `Fault::thrown`, so what is pinned is that the boundary is refused on both
// sides and not what either diagnostic says.
try {
    Core\Str::wrap("abc def", 3, {breakWith: ""});
} catch (Throwable $empty) {
    echo "refused: empty break\n";
}
try {
    Core\Str::wrap("abc def", 0, {cutLongWords: true});
} catch (Throwable $zero) {
    echo "refused: zero width cutting\n";
}
--ORACLE--
<?php
$subjects = [
    "",
    "a",
    "woooooooooooooooord",
    "The quick brown fox jumped over the lazy dog",
    "A very long woooooooooooooord. and then some",
    "two  spaces   and    more",
    "already|wrapped and then a good deal more text",
    "abc def ghi",
];
$widths = [0, 1, 3, 5, 8, 11, 20, 60];

foreach ($subjects as $subject) {
    foreach ($widths as $width) {
        echo "[", wordwrap($subject, $width, "|"), "]";
    }
    echo "\n";
}

foreach ($subjects as $one) {
    foreach ($widths as $wide) {
        if ($wide != 0) {
            echo "[", wordwrap($one, $wide, "|", true), "]";
        }
    }
    echo "\n";
}

$within = 0;
$whole = 0;
$lines = 0;
foreach ($subjects as $text) {
    foreach ($widths as $span) {
        if ($span != 0) {
            foreach (explode("|", wordwrap($text, $span, "|", true)) as $line) {
                $lines = $lines + 1;
                if (strlen($line) <= $span) {
                    $within = $within + 1;
                }
            }
            foreach (explode("|", wordwrap($text, $span, "|")) as $kept) {
                if (strlen($kept) <= $span) {
                    $whole = $whole + 1;
                }
            }
        }
    }
}
echo "cut: ", $within, " of ", $lines, ", uncut within: ", $whole, "\n";

echo "<", wordwrap("The quick brown fox jumped over the lazy dog", 15), ">\n";
echo "<", wordwrap("abc def ghi", 3), ">\n";

echo "<", wordwrap("The quick brown fox jumped over the lazy dog", 10, "<br/>"), ">\n";

try {
    wordwrap("abc def", 3, "");
} catch (ValueError $empty) {
    echo "refused: empty break\n";
}
try {
    wordwrap("abc def", 0, "\n", true);
} catch (ValueError $zero) {
    echo "refused: zero width cutting\n";
}
