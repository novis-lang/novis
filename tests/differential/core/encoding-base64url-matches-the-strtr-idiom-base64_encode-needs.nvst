--TEST--
`Core\Encoding::toBase64Url` and `::fromBase64Url` answer what PHP reaches `strtr(base64_encode(…), "+/", "-_")` for, over the octets that produce both moved characters, and the pair round-trips every subject (spec § 7, RFC 4648 § 5)
--FILE--
<?nvs
// Spec § 7 gives the URL-safe alphabet its own member pair and names the PHP
// it replaces: an idiom, not a function. That is the whole reason this case
// is worth a file — an idiom is written out at each call site, so what is
// being pinned is that Novis's member agrees with the *spelling PHP
// programmers actually use*, including its treatment of the padding, rather
// than with some other reading of RFC 4648 § 5.
//
// The two alphabets differ in exactly two entries, so a subject that reaches
// neither cannot tell the members apart: every third input below is chosen to
// produce `+` or `/` under the standard alphabet.
final class Show {
    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

// The RFC 4648 vectors again for the shared part of the alphabet, then the
// three subjects that reach index 62 and 63 — `fbff` gives `+/`, `fffefd`
// gives `//79`, `03ef` gives `A+8` — at all three padding remainders.
array<string> $inputs = [
    "",
    "66",
    "666f",
    "666f6f",
    "666f6f6261",
    "fbff",
    "fffefd",
    "03ef",
    "ffffff",
    "fbf0",
];

echo "encode:";
foreach ($inputs as string $hex) {
    echo "[", Core\Encoding::toBase64Url(Core\Encoding::fromHex($hex)), "]";
}
echo "\n";

echo "decode:";
foreach ($inputs as string $hex) {
    string $encoded = Core\Encoding::toBase64Url(Core\Encoding::fromHex($hex));
    echo "[", Core\Encoding::toHex(Core\Encoding::fromBase64Url($encoded)), "]";
}
echo "\n";

// Neither moved character survives into the output, over the whole corpus:
// the property that makes the spelling URL-safe, asserted by counting rather
// than by reading the row above for a `+` that is not there.
int $held = 0;
int $cells = 0;
foreach ($inputs as string $hex) {
    $cells = $cells + 3;
    bytes $raw = Core\Encoding::fromHex($hex);
    string $url = Core\Encoding::toBase64Url($raw);
    if (!Core\Str::contains($url, "+")) {
        $held = $held + 1;
    }
    if (!Core\Str::contains($url, "/")) {
        $held = $held + 1;
    }
    if (Core\Bytes::compare(Core\Encoding::fromBase64Url($url), $raw) == 0) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";

// The two alphabets agree wherever neither moved entry is reached, which is
// what makes the pair a *variant* rather than a second encoding.
echo Show::flag(
    Core\Encoding::toBase64Url(Core\Encoding::encodeText("Hello, world", Core\Charset::Utf8))
    == "SGVsbG8sIHdvcmxk"
), "\n";
--ORACLE--
<?php
function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

// The idiom, both ways. The `=` is dropped on the way out and restored on the
// way in: RFC 4648 § 5 makes the padding optional for this alphabet, and a
// URL-safe spelling that kept it would carry a character that has to be
// percent-encoded in a query string, which is the point of the variant.
function toBase64Url($b) {
    return rtrim(strtr(base64_encode($b), "+/", "-_"), "=");
}

function fromBase64Url($s) {
    return base64_decode(strtr($s, "-_", "+/"));
}

$inputs = [
    "",
    "66",
    "666f",
    "666f6f",
    "666f6f6261",
    "fbff",
    "fffefd",
    "03ef",
    "ffffff",
    "fbf0",
];

echo "encode:";
foreach ($inputs as $hex) {
    echo "[", toBase64Url(hex2bin($hex)), "]";
}
echo "\n";

echo "decode:";
foreach ($inputs as $hex) {
    $encoded = toBase64Url(hex2bin($hex));
    echo "[", bin2hex(fromBase64Url($encoded)), "]";
}
echo "\n";

$held = 0;
$cells = 0;
foreach ($inputs as $hex) {
    $cells = $cells + 3;
    $raw = hex2bin($hex);
    $url = toBase64Url($raw);
    if (!str_contains($url, "+")) {
        $held = $held + 1;
    }
    if (!str_contains($url, "/")) {
        $held = $held + 1;
    }
    if (fromBase64Url($url) === $raw) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";

echo flag(toBase64Url("Hello, world") === "SGVsbG8sIHdvcmxk"), "\n";
