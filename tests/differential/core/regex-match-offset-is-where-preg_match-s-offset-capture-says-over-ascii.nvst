--TEST--
Core\Regex\Match::offset is the position PREG_OFFSET_CAPTURE reports and the from option is preg_match's own start argument, over an ASCII subject where a grapheme index and a byte index coincide
--FILE--
<?nvs
// Spec § 5's `offset` row and `match`'s `{from?: int}`, against the two halves
// of `preg_match` that answer the same questions: `PREG_OFFSET_CAPTURE` for
// where a match landed, and the fifth argument for where the search began.
//
// **Every subject here is ASCII**, and that is the case's precondition rather
// than a convenience. `offset` is a `crate::granularity::DEFAULT`-unit index —
// a grapheme index, ADR 0009 § 2 — where `PREG_OFFSET_CAPTURE` reports a byte
// count, so the two are the same number only while the subject has one byte
// per cluster. `regex-match-offset-is-a-grapheme-index-from-zero-to-the-
// subject-length` is the conformance case that owns the other side of that,
// and no oracle can be written for it: PHP has no grapheme-indexed match.
array<array<string>> $rows = [
    ["hello world", "world"],
    ["hello", "^h"],
    ["hello", "o$"],
    ["abc", "z"],
    ["aaa", "a*"],
    ["", "a*"],
    ["xyz", "y"],
    ["a1b2", "\\d"],
    ["foobar", "(?<=foo)bar"],
    ["  x", "\\S"],
    ["abcabc", "c"],
];

foreach ($rows as array<string> $row) {
    var $found = Core\Regex::match($row["0"], $row["1"]);
    if ($found == null) {
        echo "none|";
    } else {
        echo $found->offset() as string, ":", $found->text(), "|";
    }
}
echo "\n";

// `from` moves the start of the search without moving the origin the offset is
// counted from, which is the pair of claims a sweep over one subject separates:
// a member reporting an offset relative to `from` prints a different second
// number on every row but the first.
array<int> $starts = [0, 1, 2, 3, 4, 5, 6];
foreach ($starts as int $start) {
    var $later = Core\Regex::match("a1b2c3", "\\d", {from: $start});
    if ($later == null) {
        echo "none|";
    } else {
        echo $later->offset() as string, ":", $later->text(), "|";
    }
}
echo "\n";

// An anchor is anchored to the subject, not to `from` — PCRE's reading, and
// the one that makes `from` a *resumption* rather than a substring search.
array<int> $anchors = [0, 1, 2];
foreach ($anchors as int $anchored) {
    var $head = Core\Regex::match("aab", "^a", {from: $anchored});
    if ($head == null) {
        echo "none|";
    } else {
        echo $head->offset() as string, ":", $head->text(), "|";
    }
}
echo "\n";

// Every match in a subject carries its own offset, and the sequence of them is
// what `matchAll` reports — the same numbers PHP hands back when the same flag
// rides on `preg_match_all`.
foreach (Core\Regex::matchAll("a1b22c333", "\\d+") as Core\Regex\Match $one) {
    echo $one->offset() as string, ":", $one->text(), "|";
}
echo "\n";
foreach (Core\Regex::matchAll("one two three", "\\w+") as Core\Regex\Match $word) {
    echo $word->offset() as string, ":", $word->text(), "|";
}
echo "\n";
--ORACLE--
<?php
$rows = [
    ['hello world', 'world'],
    ['hello', '^h'],
    ['hello', 'o$'],
    ['abc', 'z'],
    ['aaa', 'a*'],
    ['', 'a*'],
    ['xyz', 'y'],
    ['a1b2', '\\d'],
    ['foobar', '(?<=foo)bar'],
    ['  x', '\\S'],
    ['abcabc', 'c'],
];

foreach ($rows as $row) {
    $found = [];
    if (preg_match("/" . $row[1] . "/", $row[0], $found, PREG_OFFSET_CAPTURE) === 1) {
        echo $found[0][1], ":", $found[0][0], "|";
    } else {
        echo "none|";
    }
}
echo "\n";

foreach ([0, 1, 2, 3, 4, 5, 6] as $start) {
    $later = [];
    if (preg_match('/\d/', 'a1b2c3', $later, PREG_OFFSET_CAPTURE, $start) === 1) {
        echo $later[0][1], ":", $later[0][0], "|";
    } else {
        echo "none|";
    }
}
echo "\n";

foreach ([0, 1, 2] as $anchored) {
    $head = [];
    if (preg_match('/^a/', 'aab', $head, PREG_OFFSET_CAPTURE, $anchored) === 1) {
        echo $head[0][1], ":", $head[0][0], "|";
    } else {
        echo "none|";
    }
}
echo "\n";

$digits = [];
preg_match_all('/\d+/', 'a1b22c333', $digits, PREG_SET_ORDER | PREG_OFFSET_CAPTURE);
foreach ($digits as $one) {
    echo $one[0][1], ":", $one[0][0], "|";
}
echo "\n";

$words = [];
preg_match_all('/\w+/', 'one two three', $words, PREG_SET_ORDER | PREG_OFFSET_CAPTURE);
foreach ($words as $word) {
    echo $word[0][1], ":", $word[0][0], "|";
}
echo "\n";
