--TEST--
Core\Arr::fill builds what array_fill builds when array_fill is given the start index MWL does not take
--FILE--
<?mwl
final class Render {
    public static function keys(array<mixed> $a): string {
        return Core\Str::join(Core\Arr::keys($a), ",");
    }
}

// The whole of the agreeing half, asserted as a sweep rather than as one row:
// for every count from none to five, the entry count and the key set are what
// `array_fill(0, $n, "v")` produces. A member that was one entry short, or
// that started at one, prints plausibly on any single row and fails here.
foreach (Core\Arr::range(0, 5) as int $n) {
    echo $n, ":", Core\Arr::count(Core\Arr::fill($n as uint, "v")), ":",
         Render::keys(Core\Arr::fill($n as uint, "v")), ";";
}
echo "\n";

// A count of zero is an empty array on both sides rather than a throw, which
// is what lets a computed count through unguarded.
echo Core\Arr::count(Core\Arr::fill(0, "v")), "\n";

// And the result is a list under both languages' reading of the word: keys
// `0, 1, …` with no hole, which is exactly what dropping PHP's start index
// buys — `array_fill(5, 3, "v")` is a non-list, and the case named in
// `arr-fill-has-no-start-index-where-array_fill-does` owns that half.
echo Core\Arr::isList(Core\Arr::fill(3, "v")) as string, ".", Core\Str::join(Core\Arr::fill(3, "v"), ","), "\n";
--ORACLE--
<?php
foreach (range(0, 5) as $n) {
    echo $n, ":", count(array_fill(0, $n, "v")), ":",
         implode(",", array_keys(array_fill(0, $n, "v"))), ";";
}
echo "\n";

echo count(array_fill(0, 0, "v")), "\n";

echo (string) array_is_list(array_fill(0, 3, "v")), ".", implode(",", array_fill(0, 3, "v")), "\n";
