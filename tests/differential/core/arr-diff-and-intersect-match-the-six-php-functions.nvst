--TEST--
Core\Arr::diff and ::intersect under each SetOn case match array_diff, array_diff_key and array_diff_assoc and their intersect siblings
--FILE--
<?nvs
// Only the rows where PHP's string-cast comparison cannot differ from strict
// identity: every value here is an `int` and every key a distinct name. The
// rows where the two *do* differ are a divergence rather than a match, and
// `tests/conformance/core` pins those instead.
array<int> $a = ["x" => 1, "y" => 2, "z" => 3];
array<int> $b = ["p" => 2, "z" => 9];

echo Core\Json::encode(Core\Arr::diff($a, $b)), ";";
echo Core\Json::encode(Core\Arr::intersect($a, $b)), ";";
echo Core\Json::encode(Core\Arr::diff($a, $b, {on: Core\SetOn::Keys})), ";";
echo Core\Json::encode(Core\Arr::intersect($a, $b, {on: Core\SetOn::Keys})), ";";
echo Core\Json::encode(Core\Arr::diff($a, $b, {on: Core\SetOn::Both})), ";";
echo Core\Json::encode(Core\Arr::intersect($a, $b, {on: Core\SetOn::Both})), ";";

array<int> $empty = [];
echo Core\Json::encode(Core\Arr::diff($a, $empty)), ";";
echo Core\Json::encode(Core\Arr::intersect($a, $empty)), "\n";
--ORACLE--
<?php
$a = ["x" => 1, "y" => 2, "z" => 3];
$b = ["p" => 2, "z" => 9];

echo json_encode(array_diff($a, $b)), ";";
echo json_encode(array_intersect($a, $b)), ";";
echo json_encode(array_diff_key($a, $b)), ";";
echo json_encode(array_intersect_key($a, $b)), ";";
echo json_encode(array_diff_assoc($a, $b)), ";";
echo json_encode(array_intersect_assoc($a, $b)), ";";

$empty = [];
echo json_encode(array_diff($a, $empty)), ";";
echo json_encode(array_intersect($a, $empty)), "\n";
