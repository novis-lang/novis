--TEST--
Core\Str::indexOf answers every position strpos does, once absence is rendered the same on both sides (ADR 0063 R5, R8)
--FILE--
<?nvs
// ADR 0063 R5: `indexOf` answers `?uint`, so absence is `null` and a match at
// the front is `0`. PHP cannot tell those two apart — `strpos` answers `false`
// and `false == 0` is true — which is the bug family this member exists to
// remove. Rendering absence as `none` on both sides is what makes the two
// comparable at all, and that rendering is half of what this case pins: what is
// compared below is the position, never the representation.
final class Show {
    public static function render(?uint $found): string {
        if ($found == null) {
            return "none";
        }
        return $found as string;
    }
}

// The subject is ASCII throughout. ADR 0009 § 2 makes an Novis position a
// grapheme index where `strpos` reports a byte offset, so only an ASCII subject
// asks about the search rather than about the unit — `str-length-diverges-from-strlen`
// is where the unit itself is pinned.
echo Show::render(Core\Str::indexOf("haystack", "h")), "\n";
echo Show::render(Core\Str::indexOf("haystack", "st")), "\n";
echo Show::render(Core\Str::indexOf("haystack", "k")), "\n";
echo Show::render(Core\Str::indexOf("haystack", "zz")), "\n";
echo Show::render(Core\Str::indexOf("haystack", "haystack")), "\n";
echo Show::render(Core\Str::indexOf("", "a")), "\n";

// `from` is a position, so ADR 0063 R8's sign rule applies: a negative one
// counts back from the end and the scan runs forward from there.
echo Show::render(Core\Str::indexOf("haystack", "a", {from: 2})), "\n";
echo Show::render(Core\Str::indexOf("haystack", "st", {from: 3})), "\n";
echo Show::render(Core\Str::indexOf("haystack", "st", {from: 4})), "\n";
echo Show::render(Core\Str::indexOf("haystack", "st", {from: -6})), "\n";
echo Show::render(Core\Str::indexOf("haystack", "st", {from: -3})), "\n";

// An empty needle is found at the offset the scan starts from, the one just
// past the end included — the row that separates "found at 0" from "not found"
// most sharply, because only one of the two sides can state it.
echo Show::render(Core\Str::indexOf("haystack", "")), "\n";
echo Show::render(Core\Str::indexOf("haystack", "", {from: 3})), "\n";
echo Show::render(Core\Str::indexOf("haystack", "", {from: 8})), "\n";
echo Show::render(Core\Str::indexOf("haystack", "a", {from: 8})), "\n";
echo Show::render(Core\Str::indexOf("", "")), "\n";
--ORACLE--
<?php
function render(int|false $found): string {
    if ($found === false) {
        return "none";
    }
    return (string) $found;
}

echo render(strpos("haystack", "h")), "\n";
echo render(strpos("haystack", "st")), "\n";
echo render(strpos("haystack", "k")), "\n";
echo render(strpos("haystack", "zz")), "\n";
echo render(strpos("haystack", "haystack")), "\n";
echo render(strpos("", "a")), "\n";

echo render(strpos("haystack", "a", 2)), "\n";
echo render(strpos("haystack", "st", 3)), "\n";
echo render(strpos("haystack", "st", 4)), "\n";
echo render(strpos("haystack", "st", -6)), "\n";
echo render(strpos("haystack", "st", -3)), "\n";

echo render(strpos("haystack", "")), "\n";
echo render(strpos("haystack", "", 3)), "\n";
echo render(strpos("haystack", "", 8)), "\n";
echo render(strpos("haystack", "a", 8)), "\n";
echo render(strpos("", "")), "\n";
