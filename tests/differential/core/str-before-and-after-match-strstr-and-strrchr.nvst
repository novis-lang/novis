--TEST--
Core\Str::before and ::after cut at the occurrence strstr and strrchr cut at, they both exclude the needle where strstr keeps it, an absent needle is null where all three PHP functions answer false, and strrchr stops being the twin past a one-character needle (spec § 1 Extraction, ADR 0063 R5)
--FILE--
<?mwl
// Spec § 1's *Extraction* prose owns every rule this pins: both members
// exclude the needle, `{last: true}` is all `strrchr` added, and a needle
// that does not occur is `null` where `strstr`, `stristr` and `strrchr` are
// all `false`. That last one is a difference in how "no answer" is spelled
// and not a difference in the cut, so both sides fold it to one sentinel and
// what the tables compare is where the subject was divided.
//
// The subjects are ASCII on purpose. `Core\Str::slice` and the `indexOf`
// this file ports `stristr` through both count grapheme clusters where
// `substr` and `strpos` count bytes (`mwl_stdlib::granularity::DEFAULT`);
// inside ASCII the units coincide, and `str-slice-and-replace-range-count-
// graphemes-where-substr-counts-bytes` is where they do not.
final class Show {
    // Both members answer `?string` and PHP's three answer `false`, so one
    // sentinel per side makes a missing cut comparable to a present one. A
    // `?string` does not narrow into a `string` return position on its own —
    // `as string` after the null test is the spelling that checks.
    public static function orNone(?string $v): string {
        if ($v == null) {
            return "<none>";
        }
        return $v as string;
    }

    // `strrchr` written in MWL, so the third table can print it beside the
    // real `{last: true}` answer. It cuts at the last occurrence of the
    // needle's *first character* and keeps that character, which is why it
    // stops being `after`'s twin the moment the needle is longer than one
    // character; an empty needle is its own refusal there, mirrored here.
    public static function likeStrrchr(string $s, string $needle): string {
        if ($needle == "") {
            return "<none>";
        }
        string $head = Core\Str::slice($needle, 0, 1);
        ?string $tail = Core\Str::after($s, $head, {last: true});
        if ($tail == null) {
            return "<none>";
        }
        return Core\Str::join([$head, $tail as string], "");
    }

    // `stristr` has no twin at all: neither member declares a
    // `caseInsensitive` option, because the spec gives this pair one option
    // and it is `{last}`. The port is `indexOf`'s own option plus a `slice`,
    // and this is it — needle-inclusive, which is `stristr`'s shape rather
    // than `after`'s.
    public static function likeStristr(string $s, string $needle): string {
        ?uint $at = Core\Str::indexOf($s, $needle, {caseInsensitive: true});
        if ($at == null) {
            return "<none>";
        }
        return Core\Str::slice($s, ($at as uint) as int);
    }

    // The other half of the same port, `stristr($h, $n, true)`.
    public static function likeStristrPrefix(string $s, string $needle): string {
        ?uint $upto = Core\Str::indexOf($s, $needle, {caseInsensitive: true});
        if ($upto == null) {
            return "<none>";
        }
        return Core\Str::slice($s, 0, ($upto as uint) as int);
    }
}

array<string> $subjects = ["a::b::c", "banana", "abc", "", "aaa"];

// A needle that occurs many times, one that occurs many times as a single
// character, one that overlaps itself, one that is the whole subject, one
// that is absent, and the empty needle — which every PHP function in this
// family treats as a match at the very start.
array<string> $needles = ["::", "a", "an", "abc", "z", ""];

// The first-occurrence table. Each cell is the pair, because the claim is
// that the two members divide the subject at *one* point: a member that took
// a different occurrence from its partner prints a plausible half and an
// implausible pair.
foreach ($subjects as string $subject) {
    foreach ($needles as string $needle) {
        echo "[", Show::orNone(Core\Str::before($subject, $needle)), "|", Show::orNone(Core\Str::after($subject, $needle)), "]";
    }
    echo "\n";
}

// The `{last: true}` table over one-character needles, which is the whole of
// what `strrchr` covers. The PHP side reads `strrchr` itself here and strips
// the character it keeps, so this is the twin compared as a twin rather than
// through a substitute.
array<string> $marks = [":", "a", "n", "z"];
foreach ($subjects as string $host) {
    foreach ($marks as string $mark) {
        echo "[", Show::orNone(Core\Str::before($host, $mark, {last: true})), "|", Show::orNone(Core\Str::after($host, $mark, {last: true})), "]";
    }
    echo "\n";
}

// The same option over needles `strrchr` cannot express. The left cell is
// `{last: true}` against `strrpos`, which is the honest port; the right cell
// is `strrchr`'s own answer on both sides. The two cells disagreeing is the
// finding: `strrchr` reads only the needle's first character, so it is the
// twin at one character and a different function past that, and at the empty
// needle it fails outright where `strrpos` answers the subject's length.
array<string> $tokens = ["::", "an", "aa", "abc", ""];
foreach ($subjects as string $text) {
    foreach ($tokens as string $token) {
        echo "[", Show::orNone(Core\Str::before($text, $token, {last: true})), "|", Show::orNone(Core\Str::after($text, $token, {last: true})), "|", Show::likeStrrchr($text, $token), "]";
    }
    echo "\n";
}

// The invariance the excluded needle buys, counted rather than read off a
// row: for every cell where the needle occurs at all, the two halves rejoined
// *with the needle between them* are the subject again. This is the claim
// that says the pair names one cut and not two that usually agree — a member
// that kept the needle, or that took the other occurrence, fails here while
// both tables above still print something reasonable. PHP's `strstr` pair
// holds it too, once the needle `strstr` keeps is stripped back off.
int $held = 0;
int $cells = 0;
foreach ($subjects as string $whole) {
    foreach ($needles as string $cut) {
        ?string $head = Core\Str::before($whole, $cut);
        if ($head != null) {
            $cells = $cells + 1;
            ?string $tail = Core\Str::after($whole, $cut);
            if (Core\Str::join([$head as string, $tail as string], $cut) == $whole) {
                $held = $held + 1;
            }
        }
    }
}
echo $held, " of ", $cells, "\n";

// The same count under `{last: true}`, where the occurrence moves but the
// partition does not. Overlapping occurrences are why this is worth counting
// separately: `"aa"` in `"aaa"` has a last occurrence one character in, and a
// scan that stepped over a whole match instead of a single character would
// answer the first one and still rejoin to the subject on every other row.
int $lastHeld = 0;
int $lastCells = 0;
foreach ($subjects as string $body) {
    foreach ($needles as string $edge) {
        ?string $prefix = Core\Str::before($body, $edge, {last: true});
        if ($prefix != null) {
            $lastCells = $lastCells + 1;
            ?string $suffix = Core\Str::after($body, $edge, {last: true});
            if (Core\Str::join([$prefix as string, $suffix as string], $edge) == $body) {
                $lastHeld = $lastHeld + 1;
            }
        }
    }
}
echo $lastHeld, " of ", $lastCells, "\n";

// The case-insensitive rows, which are the port and not the member: what
// `stristr` returns is what `indexOf`'s option plus a `slice` returns, and
// absence stays `null` on the way through.
echo "[", Show::likeStristr("Hello WORLD", "world"), "|", Show::likeStristrPrefix("Hello WORLD", "world"), "]\n";
echo "[", Show::likeStristr("Hello WORLD", "HELLO"), "|", Show::likeStristrPrefix("Hello WORLD", "HELLO"), "]\n";
echo "[", Show::likeStristr("Hello WORLD", "xyz"), "|", Show::likeStristrPrefix("Hello WORLD", "xyz"), "]\n";
echo "[", Show::likeStristr("aAaA", "Aa"), "|", Show::likeStristrPrefix("aAaA", "Aa"), "]\n";
--ORACLE--
<?php
function orNone($v) {
    if ($v === false) {
        return "<none>";
    }
    return $v;
}

function phpAfter($h, $n) {
    $found = strstr($h, $n);
    if ($found === false) {
        return "<none>";
    }
    return substr($found, strlen($n));
}

function phpLastBefore($h, $c) {
    $found = strrchr($h, $c);
    if ($found === false) {
        return "<none>";
    }
    return substr($h, 0, strlen($h) - strlen($found));
}

function phpLastAfter($h, $c) {
    $found = strrchr($h, $c);
    if ($found === false) {
        return "<none>";
    }
    return substr($found, strlen($c));
}

function phpRposBefore($h, $n) {
    $at = strrpos($h, $n);
    if ($at === false) {
        return "<none>";
    }
    return substr($h, 0, $at);
}

function phpRposAfter($h, $n) {
    $at = strrpos($h, $n);
    if ($at === false) {
        return "<none>";
    }
    return substr($h, $at + strlen($n));
}

$subjects = ["a::b::c", "banana", "abc", "", "aaa"];

$needles = ["::", "a", "an", "abc", "z", ""];

foreach ($subjects as $subject) {
    foreach ($needles as $needle) {
        echo "[", orNone(strstr($subject, $needle, true)), "|", phpAfter($subject, $needle), "]";
    }
    echo "\n";
}

$marks = [":", "a", "n", "z"];
foreach ($subjects as $host) {
    foreach ($marks as $mark) {
        echo "[", phpLastBefore($host, $mark), "|", phpLastAfter($host, $mark), "]";
    }
    echo "\n";
}

$tokens = ["::", "an", "aa", "abc", ""];
foreach ($subjects as $text) {
    foreach ($tokens as $token) {
        echo "[", phpRposBefore($text, $token), "|", phpRposAfter($text, $token), "|", orNone(strrchr($text, $token)), "]";
    }
    echo "\n";
}

$held = 0;
$cells = 0;
foreach ($subjects as $whole) {
    foreach ($needles as $cut) {
        $head = strstr($whole, $cut, true);
        if ($head !== false) {
            $cells = $cells + 1;
            $tail = phpAfter($whole, $cut);
            if (implode($cut, [$head, $tail]) === $whole) {
                $held = $held + 1;
            }
        }
    }
}
echo $held, " of ", $cells, "\n";

$lastHeld = 0;
$lastCells = 0;
foreach ($subjects as $body) {
    foreach ($needles as $edge) {
        $prefix = phpRposBefore($body, $edge);
        if (strrpos($body, $edge) !== false) {
            $lastCells = $lastCells + 1;
            $suffix = phpRposAfter($body, $edge);
            if (implode($edge, [$prefix, $suffix]) === $body) {
                $lastHeld = $lastHeld + 1;
            }
        }
    }
}
echo $lastHeld, " of ", $lastCells, "\n";

echo "[", orNone(stristr("Hello WORLD", "world")), "|", orNone(stristr("Hello WORLD", "world", true)), "]\n";
echo "[", orNone(stristr("Hello WORLD", "HELLO")), "|", orNone(stristr("Hello WORLD", "HELLO", true)), "]\n";
echo "[", orNone(stristr("Hello WORLD", "xyz")), "|", orNone(stristr("Hello WORLD", "xyz", true)), "]\n";
echo "[", orNone(stristr("aAaA", "Aa")), "|", orNone(stristr("aAaA", "Aa", true)), "]\n";
