--TEST--
Re-encoding a decoded value renders exactly what the source rendered, over a graph mixing objects, arrays and nesting — the invariance PHP's serialize/unserialize pair holds too
--FILE--
<?nvs
// The graph copy is the same operation whichever side of the boundary its
// subject came from, so a value that has already been round-tripped is not a
// degraded one: the second copy has to render what the first did and what the
// source did. Asserting the three renderings *agree* is what catches a copy
// that loses a key or an order on the second pass while looking right on the
// first — a member answering plausibly line by line still fails here.
final class Row {
    public string $label;
    public array<int> $counts;

    public function constructor(string $label, array<int> $counts) {
        $this->label = $label;
        $this->counts = $counts;
    }
}

final class Sheet {
    public array<Row> $rows;
    public Row $header;

    public function constructor(Row $header, array<Row> $rows) {
        $this->header = $header;
        $this->rows = $rows;
    }
}

final class Render {
    public static function of(Sheet $s): string {
        var $out = Render::row($s->header) . "|";
        foreach ($s->rows as string $k => Row $r) {
            $out = $out . $k . ":" . Render::row($r) . ";";
        }
        return $out;
    }

    public static function row(Row $r): string {
        var $out = $r->label . "(";
        foreach ($r->counts as string $k => int $v) {
            $out = $out . $k . "=" . $v . ",";
        }
        return $out . ")";
    }
}

array<int> $gapped = [1, 2, 3];
unset($gapped[1]);
$gapped["late"] = 4;

var $sheet = new Sheet(
    new Row("head", $gapped),
    [new Row("a", [7]), new Row("b", ["k" => 8])],
);

var $once = Core\Serialize::decode(Core\Serialize::encode($sheet)) as Sheet;
var $twice = Core\Serialize::decode(Core\Serialize::encode($once)) as Sheet;

echo Render::of($sheet), "\n";
echo Render::of($once), "\n";
echo Render::of($twice), "\n";
--ORACLE--
<?php
class Row {
    public string $label;
    public array $counts;

    public function __construct(string $label, array $counts) {
        $this->label = $label;
        $this->counts = $counts;
    }
}

class Sheet {
    public array $rows;
    public Row $header;

    public function __construct(Row $header, array $rows) {
        $this->header = $header;
        $this->rows = $rows;
    }
}

function render_row($r) {
    $out = $r->label . "(";
    foreach ($r->counts as $k => $v) {
        $out = $out . $k . "=" . $v . ",";
    }
    return $out . ")";
}

function render_sheet($s) {
    $out = render_row($s->header) . "|";
    foreach ($s->rows as $k => $r) {
        $out = $out . $k . ":" . render_row($r) . ";";
    }
    return $out;
}

$gapped = [1, 2, 3];
unset($gapped[1]);
$gapped["late"] = 4;

$sheet = new Sheet(
    new Row("head", $gapped),
    [new Row("a", [7]), new Row("b", ["k" => 8])],
);

$once = unserialize(serialize($sheet));
$twice = unserialize(serialize($once));

echo render_sheet($sheet), "\n";
echo render_sheet($once), "\n";
echo render_sheet($twice), "\n";
