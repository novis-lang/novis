--TEST--
`break` and `continue` in a while loop end up where PHP's do
--FILE--
<?mwl
var $i = 0;
var $sum = 0;
while ($i < 100) {
    $i = $i + 1;
    if ($i == 3) {
        continue;
    }
    if ($i == 6) {
        break;
    }
    $sum = $sum + $i;
}
echo "sum=", $sum, " stopped at ", $i, "\n";

var $outer = 0;
var $inner = 0;
while ($outer < 3) {
    $outer = $outer + 1;
    var $j = 0;
    while ($j < 10) {
        $j = $j + 1;
        if ($j > 2) {
            break;
        }
        $inner = $inner + 1;
    }
}
echo "inner=", $inner, "\n";
--ORACLE--
<?php
$i = 0;
$sum = 0;
while ($i < 100) {
    $i = $i + 1;
    if ($i === 3) {
        continue;
    }
    if ($i === 6) {
        break;
    }
    $sum = $sum + $i;
}
echo "sum=", $sum, " stopped at ", $i, "\n";

$outer = 0;
$inner = 0;
while ($outer < 3) {
    $outer = $outer + 1;
    $j = 0;
    while ($j < 10) {
        $j = $j + 1;
        if ($j > 2) {
            break;
        }
        $inner = $inner + 1;
    }
}
echo "inner=", $inner, "\n";
