--TEST--
every Core\Str member the spec gives a PHP twin answers what that twin answers over one shared ASCII corpus, and the ten identities the members hold jointly hold in PHP too (spec § 1, `rule:core-api/shape-rules` R5, `rule:types/string-is-utf8`)
--FILE--
<?nvs
// The roster case for `Core\Str`. Every other file under
// tests/differential/core/str-*.nvst asks one member a deep question; this one
// asks *every* member the spec gives a PHP twin the same shallow question over
// one shared corpus, so a member that is added, renamed, given a second option
// or quietly re-based on a different unit shows up here rather than having to
// be noticed. The claim is coverage in one place, and it is the claim no
// per-member file can make.
//
// The corpus is ASCII throughout and holds no `\r`. That is not a weakening:
// `rule:types/string-is-utf8` counts grapheme clusters where PHP's byte functions count
// bytes, so outside ASCII a good half of this roster is *supposed* to
// disagree, and the files named `…-diverges-…` are where each of those is
// pinned instead. Inside ASCII the units coincide, which is exactly the region
// where PHP is the authority this file defers to.
//
// Two members are absent, both on purpose. `Core\Str::normalize` has no twin
// outside `intl`. `Core\Str::fold` is compared against `strtolower`, which is
// its ASCII restriction — `mb_convert_case` is not callable on this leg at
// all, because the `php` on the Windows PATH ships no `mbstring`.
final class Show {
    // `?string` answers become `<none>` on both sides, because PHP's twins
    // spell absence `false` and the difference is in how "no answer" is
    // written rather than in the answer. Same rule as `str-before-and-after`.
    public static function orNone(?string $v): string {
        if ($v == null) {
            return "<none>";
        }
        return $v as string;
    }

    // The same fold for `?uint`, where PHP's `strpos` family answers `false`
    // and `false == 0` is the bug family `?uint` exists to remove.
    public static function place(?uint $v): string {
        if ($v == null) {
            return "<none>";
        }
        return $v as string;
    }

    // `bool as string` is `1`/`` in both languages, and an empty cell between
    // two separators is unreadable in a table this wide.
    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }

    // `at` throws on an empty subject where `$s[0]` is a warning plus `""`;
    // the guard is the comparable part, so both sides carry it.
    public static function first(string $s): string {
        if (Core\Str::isEmpty($s)) {
            return "<none>";
        }
        return Core\Str::at($s, 0);
    }

    // `codePoints` answers numbers, so it needs its own rendering before it
    // can sit in a joined row beside the members that answer text.
    public static function points(string $s): string {
        string $out = "";
        foreach (Core\Str::codePoints($s) as uint $cp) {
            $out = $out . ($cp as string) . ";";
        }
        return $out;
    }
}

// The empty subject, a single character, a word, a sentence with the only
// interior spaces in the corpus, a subject that is all padding, one built for
// `split` to find empty fields in, one whose needle overlaps itself, and one
// mixing both cases so the four case members have something to move.
array<string> $subjects = ["", "a", "abc", "Hello World", "  spaced  ", "a,b,,c", "banana", "AbC-dEf"];

// A needle that occurs many times, one that occurs twice as a longer run, one
// that is absent everywhere, and the space — which is present in two subjects
// and absent in six, so every needle row has both kinds of cell. The empty
// needle is deliberately not here: `Core\Str::countOf` refuses it outright
// (`str-each-refusal-names-the-index-or-the-option-it-stopped-at`), so it
// cannot be a *shared* needle, and `str-index-of-matches-strpos` is where it
// is asked of the members that do accept it.
array<string> $needles = ["a", "an", "z", " "];

// ---------------------------------------------------------------------------
// One argument, the whole subject. One row per member, one cell per subject.
// ---------------------------------------------------------------------------

echo "length:";
foreach ($subjects as string $s) {
    echo Core\Str::length($s), "|";
}
echo "\n";

echo "isEmpty:";
foreach ($subjects as string $s) {
    echo Show::flag(Core\Str::isEmpty($s)), "|";
}
echo "\n";

echo "lower:";
foreach ($subjects as string $s) {
    echo Core\Str::lower($s), "|";
}
echo "\n";

echo "upper:";
foreach ($subjects as string $s) {
    echo Core\Str::upper($s), "|";
}
echo "\n";

echo "fold:";
foreach ($subjects as string $s) {
    echo Core\Str::fold($s), "|";
}
echo "\n";

echo "upperFirst:";
foreach ($subjects as string $s) {
    echo Core\Str::upperFirst($s), "|";
}
echo "\n";

echo "lowerFirst:";
foreach ($subjects as string $s) {
    echo Core\Str::lowerFirst($s), "|";
}
echo "\n";

echo "reverse:";
foreach ($subjects as string $s) {
    echo Core\Str::reverse($s), "|";
}
echo "\n";

echo "trim:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::trim($s), "]";
}
echo "\n";

echo "trimStart:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::trimStart($s), "]";
}
echo "\n";

echo "trimEnd:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::trimEnd($s), "]";
}
echo "\n";

// The `characters` option against PHP's charlist argument. No `a..z` range is
// written on either side: PHP interprets one and Novis does not, which is a
// divergence the spec names and not something this file is entitled to ask.
echo "trimChars:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::trim($s, {characters: "ac "}), "]";
}
echo "\n";

echo "graphemes:";
foreach ($subjects as string $s) {
    echo Core\Str::join(Core\Str::graphemes($s), "."), "|";
}
echo "\n";

echo "codePoints:";
foreach ($subjects as string $s) {
    echo Show::points($s), "|";
}
echo "\n";

echo "at0:";
foreach ($subjects as string $s) {
    echo Show::first($s), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// Subject and needle. One row per member, one cell per (subject, needle) pair.
// ---------------------------------------------------------------------------

echo "contains:";
foreach ($subjects as string $s) {
    foreach ($needles as string $needle) {
        echo Show::flag(Core\Str::contains($s, $needle)), "|";
    }
}
echo "\n";

echo "startsWith:";
foreach ($subjects as string $s) {
    foreach ($needles as string $needle) {
        echo Show::flag(Core\Str::startsWith($s, $needle)), "|";
    }
}
echo "\n";

echo "endsWith:";
foreach ($subjects as string $s) {
    foreach ($needles as string $needle) {
        echo Show::flag(Core\Str::endsWith($s, $needle)), "|";
    }
}
echo "\n";

echo "indexOf:";
foreach ($subjects as string $s) {
    foreach ($needles as string $needle) {
        echo Show::place(Core\Str::indexOf($s, $needle)), "|";
    }
}
echo "\n";

echo "indexOfCase:";
foreach ($subjects as string $s) {
    foreach ($needles as string $needle) {
        echo Show::place(Core\Str::indexOf($s, $needle, {caseInsensitive: true})), "|";
    }
}
echo "\n";

echo "lastIndexOf:";
foreach ($subjects as string $s) {
    foreach ($needles as string $needle) {
        echo Show::place(Core\Str::lastIndexOf($s, $needle)), "|";
    }
}
echo "\n";

echo "countOf:";
foreach ($subjects as string $s) {
    foreach ($needles as string $needle) {
        echo Core\Str::countOf($s, $needle), "|";
    }
}
echo "\n";

echo "before:";
foreach ($subjects as string $s) {
    foreach ($needles as string $needle) {
        echo "[", Show::orNone(Core\Str::before($s, $needle)), "]";
    }
}
echo "\n";

echo "after:";
foreach ($subjects as string $s) {
    foreach ($needles as string $needle) {
        echo "[", Show::orNone(Core\Str::after($s, $needle)), "]";
    }
}
echo "\n";

echo "split:";
foreach ($subjects as string $s) {
    foreach ($needles as string $needle) {
        echo "[", Core\Str::join(Core\Str::split($s, $needle), "."), "]";
    }
}
echo "\n";

echo "splitLimit:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::join(Core\Str::split($s, ",", {limit: 2}), "."), "]";
}
echo "\n";

// `compare` already answers -1/0/1 where PHP's four functions disagree about
// the magnitude; the oracle takes the sign, which is
// `str-compare-matches-strcmp…`'s finding applied rather than re-derived.
echo "compare:";
foreach ($subjects as string $s) {
    echo Core\Str::compare($s, "banana"), "|";
}
echo "\n";

echo "compareCase:";
foreach ($subjects as string $s) {
    echo Core\Str::compare($s, "BANANA", {caseInsensitive: true}), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// Subject and a number, or a template. Positions are ASCII, so a grapheme
// index and a byte offset are the same index.
// ---------------------------------------------------------------------------

echo "slice:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::slice($s, 1, 3), "]";
}
echo "\n";

echo "sliceTail:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::slice($s, -3, null), "]";
}
echo "\n";

echo "replaceRange:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::replaceRange($s, 1, 2, "<>"), "]";
}
echo "\n";

echo "chunk:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::join(Core\Str::chunk($s, 3), "."), "]";
}
echo "\n";

echo "padStart:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::padStart($s, 8, "*"), "]";
}
echo "\n";

echo "padEnd:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::padEnd($s, 8, "*"), "]";
}
echo "\n";

echo "repeat:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::repeat($s, 2), "]";
}
echo "\n";

echo "wrap:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::wrap($s, 4, {breakWith: "/", cutLongWords: false}), "]";
}
echo "\n";

echo "wrapCut:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::wrap($s, 4, {breakWith: "/", cutLongWords: true}), "]";
}
echo "\n";

echo "replace:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::replace($s, "a", "X"), "]";
}
echo "\n";

echo "replaceCase:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::replace($s, "A", "X", {caseInsensitive: true}), "]";
}
echo "\n";

// `replaceAll` is `strtr`'s single-pass longest-match reading, not
// `str_replace`'s cascade — which is why the twin here is `strtr` and why
// `str-replace-all-matches-strtr-where-str_replace-cascades` exists.
echo "replaceAll:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::replaceAll($s, ["a" => "1", "b" => "2"]), "]";
}
echo "\n";

echo "format:";
foreach ($subjects as string $s) {
    echo "[", Core\Str::format("<%s:%d>", $s, Core\Str::length($s) as int), "]";
}
echo "\n";

// ---------------------------------------------------------------------------
// The members whose subject is not a `string`, and the one whose input is a
// break table rather than a corpus row.
// ---------------------------------------------------------------------------

echo "join:", Core\Str::join(["x", "y", "z"], "-"), "|", Core\Str::join([], "-"), "|", Core\Str::join(["solo"], "-"), "|\n";

array<uint> $scalars = [65, 97, 48, 32, 126];
echo "fromCodePoint:";
foreach ($scalars as uint $point) {
    echo Core\Str::fromCodePoint($point), "|";
}
echo "\n";

echo "fromCodePoints:", Core\Str::fromCodePoints($scalars), "|", Core\Str::fromCodePoints([]), "|\n";

// `lines` is the one member whose twin has to be written out: it splits `\n`,
// `\r\n` and a lone `\r` alike on every platform where `explode` splits one
// separator, and it drops a single trailing terminator where `explode` leaves
// a final empty field. Both of those are spec § 1 rules rather than accidents,
// so the oracle carries the same fold and what the row compares is the split.
array<string> $documents = ["", "a", "a\nb", "a\nb\n", "a\n\nb", "\n", "a\r\nb", "a\rb"];
echo "lines:";
foreach ($documents as string $document) {
    echo "[", Core\Str::join(Core\Str::lines($document), "."), "]";
}
echo "\n";

// ---------------------------------------------------------------------------
// The joint claim. Each identity names two or three members and says they
// measure the same subject in the same unit; PHP's twins hold every one of
// them too, which is what makes the count comparable rather than merely
// internal. A member that grew its own unit still prints a plausible row
// above and fails here, which is the whole reason this block is counted
// rather than read off the tables.
// ---------------------------------------------------------------------------

int $held = 0;
int $cells = 0;
foreach ($subjects as string $s) {
    $cells = $cells + 10;

    // `length` counts what `graphemes` partitions.
    if (Core\Str::length($s) as int == Core\Arr::count(Core\Str::graphemes($s)) as int) {
        $held = $held + 1;
    }
    // `chunk` at size 1 is that partition, and `join` puts it back.
    if (Core\Str::join(Core\Str::chunk($s, 1), "") == $s) {
        $held = $held + 1;
    }
    // `reverse` is its own inverse.
    if (Core\Str::reverse(Core\Str::reverse($s)) == $s) {
        $held = $held + 1;
    }
    // `lower` loses nothing `upper` then needs.
    if (Core\Str::upper(Core\Str::lower($s)) == Core\Str::upper($s)) {
        $held = $held + 1;
    }
    // `slice` from the front with no length is the subject.
    if (Core\Str::slice($s, 0, null) == $s) {
        $held = $held + 1;
    }
    // `trim` is its two one-sided halves composed.
    if (Core\Str::trim($s) == Core\Str::trimStart(Core\Str::trimEnd($s))) {
        $held = $held + 1;
    }
    // Padding to the width already held is a no-op, which is the claim that
    // `padStart` counts the shortfall in the unit `length` reports.
    if (Core\Str::padStart($s, Core\Str::length($s)) == $s) {
        $held = $held + 1;
    }
    // `split` and `join` on one separator are inverse.
    if (Core\Str::join(Core\Str::split($s, ","), ",") == $s) {
        $held = $held + 1;
    }
    // An empty range replaced by nothing changes nothing.
    if (Core\Str::replaceRange($s, 0, 0, "") == $s) {
        $held = $held + 1;
    }
    // `fromCodePoints` inverts `codePoints`.
    if (Core\Str::fromCodePoints(Core\Str::codePoints($s)) == $s) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
--ORACLE--
<?php
function orNone($v) {
    if ($v === false) {
        return "<none>";
    }
    return $v;
}

function place($v) {
    if ($v === false) {
        return "<none>";
    }
    return (string) $v;
}

function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

function first($s) {
    if ($s === "") {
        return "<none>";
    }
    return $s[0];
}

function points($s) {
    $out = "";
    foreach (str_split($s) as $ch) {
        $out = $out . ord($ch) . ";";
    }
    return $out;
}

function sign($n) {
    if ($n < 0) {
        return -1;
    }
    if ($n > 0) {
        return 1;
    }
    return 0;
}

// `strstr` keeps the needle where `Core\Str::after` excludes it, so the twin
// is `strstr` with the needle stripped back off.
function phpAfter($s, $needle) {
    $found = strstr($s, $needle);
    if ($found === false) {
        return "<none>";
    }
    return substr($found, strlen($needle));
}

// Spec § 1's `lines`, written out: every break spelling, and no final empty
// field from a trailing terminator.
function phpLines($s) {
    if ($s === "") {
        return [];
    }
    $parts = preg_split("/\r\n|\r|\n/", $s);
    if ($parts[count($parts) - 1] === "") {
        array_pop($parts);
    }
    return $parts;
}

$subjects = ["", "a", "abc", "Hello World", "  spaced  ", "a,b,,c", "banana", "AbC-dEf"];

$needles = ["a", "an", "z", " "];

echo "length:";
foreach ($subjects as $s) {
    echo strlen($s), "|";
}
echo "\n";

echo "isEmpty:";
foreach ($subjects as $s) {
    echo flag($s === ""), "|";
}
echo "\n";

echo "lower:";
foreach ($subjects as $s) {
    echo strtolower($s), "|";
}
echo "\n";

echo "upper:";
foreach ($subjects as $s) {
    echo strtoupper($s), "|";
}
echo "\n";

echo "fold:";
foreach ($subjects as $s) {
    echo strtolower($s), "|";
}
echo "\n";

echo "upperFirst:";
foreach ($subjects as $s) {
    echo ucfirst($s), "|";
}
echo "\n";

echo "lowerFirst:";
foreach ($subjects as $s) {
    echo lcfirst($s), "|";
}
echo "\n";

echo "reverse:";
foreach ($subjects as $s) {
    echo strrev($s), "|";
}
echo "\n";

echo "trim:";
foreach ($subjects as $s) {
    echo "[", trim($s), "]";
}
echo "\n";

echo "trimStart:";
foreach ($subjects as $s) {
    echo "[", ltrim($s), "]";
}
echo "\n";

echo "trimEnd:";
foreach ($subjects as $s) {
    echo "[", rtrim($s), "]";
}
echo "\n";

echo "trimChars:";
foreach ($subjects as $s) {
    echo "[", trim($s, "ac "), "]";
}
echo "\n";

echo "graphemes:";
foreach ($subjects as $s) {
    echo implode(".", str_split($s)), "|";
}
echo "\n";

echo "codePoints:";
foreach ($subjects as $s) {
    echo points($s), "|";
}
echo "\n";

echo "at0:";
foreach ($subjects as $s) {
    echo first($s), "|";
}
echo "\n";

echo "contains:";
foreach ($subjects as $s) {
    foreach ($needles as $needle) {
        echo flag(str_contains($s, $needle)), "|";
    }
}
echo "\n";

echo "startsWith:";
foreach ($subjects as $s) {
    foreach ($needles as $needle) {
        echo flag(str_starts_with($s, $needle)), "|";
    }
}
echo "\n";

echo "endsWith:";
foreach ($subjects as $s) {
    foreach ($needles as $needle) {
        echo flag(str_ends_with($s, $needle)), "|";
    }
}
echo "\n";

echo "indexOf:";
foreach ($subjects as $s) {
    foreach ($needles as $needle) {
        echo place(strpos($s, $needle)), "|";
    }
}
echo "\n";

echo "indexOfCase:";
foreach ($subjects as $s) {
    foreach ($needles as $needle) {
        echo place(stripos($s, $needle)), "|";
    }
}
echo "\n";

echo "lastIndexOf:";
foreach ($subjects as $s) {
    foreach ($needles as $needle) {
        echo place(strrpos($s, $needle)), "|";
    }
}
echo "\n";

echo "countOf:";
foreach ($subjects as $s) {
    foreach ($needles as $needle) {
        echo substr_count($s, $needle), "|";
    }
}
echo "\n";

echo "before:";
foreach ($subjects as $s) {
    foreach ($needles as $needle) {
        echo "[", orNone(strstr($s, $needle, true)), "]";
    }
}
echo "\n";

echo "after:";
foreach ($subjects as $s) {
    foreach ($needles as $needle) {
        echo "[", phpAfter($s, $needle), "]";
    }
}
echo "\n";

echo "split:";
foreach ($subjects as $s) {
    foreach ($needles as $needle) {
        echo "[", implode(".", explode($needle, $s)), "]";
    }
}
echo "\n";

echo "splitLimit:";
foreach ($subjects as $s) {
    echo "[", implode(".", explode(",", $s, 2)), "]";
}
echo "\n";

echo "compare:";
foreach ($subjects as $s) {
    echo sign(strcmp($s, "banana")), "|";
}
echo "\n";

echo "compareCase:";
foreach ($subjects as $s) {
    echo sign(strcasecmp($s, "BANANA")), "|";
}
echo "\n";

echo "slice:";
foreach ($subjects as $s) {
    echo "[", substr($s, 1, 3), "]";
}
echo "\n";

echo "sliceTail:";
foreach ($subjects as $s) {
    echo "[", substr($s, -3), "]";
}
echo "\n";

echo "replaceRange:";
foreach ($subjects as $s) {
    echo "[", substr_replace($s, "<>", 1, 2), "]";
}
echo "\n";

echo "chunk:";
foreach ($subjects as $s) {
    echo "[", implode(".", str_split($s, 3)), "]";
}
echo "\n";

echo "padStart:";
foreach ($subjects as $s) {
    echo "[", str_pad($s, 8, "*", STR_PAD_LEFT), "]";
}
echo "\n";

echo "padEnd:";
foreach ($subjects as $s) {
    echo "[", str_pad($s, 8, "*", STR_PAD_RIGHT), "]";
}
echo "\n";

echo "repeat:";
foreach ($subjects as $s) {
    echo "[", str_repeat($s, 2), "]";
}
echo "\n";

echo "wrap:";
foreach ($subjects as $s) {
    echo "[", wordwrap($s, 4, "/", false), "]";
}
echo "\n";

echo "wrapCut:";
foreach ($subjects as $s) {
    echo "[", wordwrap($s, 4, "/", true), "]";
}
echo "\n";

echo "replace:";
foreach ($subjects as $s) {
    echo "[", str_replace("a", "X", $s), "]";
}
echo "\n";

echo "replaceCase:";
foreach ($subjects as $s) {
    echo "[", str_ireplace("A", "X", $s), "]";
}
echo "\n";

echo "replaceAll:";
foreach ($subjects as $s) {
    echo "[", strtr($s, ["a" => "1", "b" => "2"]), "]";
}
echo "\n";

echo "format:";
foreach ($subjects as $s) {
    echo "[", sprintf("<%s:%d>", $s, strlen($s)), "]";
}
echo "\n";

echo "join:", implode("-", ["x", "y", "z"]), "|", implode("-", []), "|", implode("-", ["solo"]), "|\n";

$scalars = [65, 97, 48, 32, 126];
echo "fromCodePoint:";
foreach ($scalars as $point) {
    echo chr($point), "|";
}
echo "\n";

echo "fromCodePoints:", implode("", array_map("chr", $scalars)), "|", implode("", array_map("chr", [])), "|\n";

$documents = ["", "a", "a\nb", "a\nb\n", "a\n\nb", "\n", "a\r\nb", "a\rb"];
echo "lines:";
foreach ($documents as $document) {
    echo "[", implode(".", phpLines($document)), "]";
}
echo "\n";

$held = 0;
$cells = 0;
foreach ($subjects as $s) {
    $cells = $cells + 10;

    if (strlen($s) === count(str_split($s))) {
        $held = $held + 1;
    }
    if (implode("", str_split($s, 1)) === $s) {
        $held = $held + 1;
    }
    if (strrev(strrev($s)) === $s) {
        $held = $held + 1;
    }
    if (strtoupper(strtolower($s)) === strtoupper($s)) {
        $held = $held + 1;
    }
    if (substr($s, 0) === $s) {
        $held = $held + 1;
    }
    if (trim($s) === ltrim(rtrim($s))) {
        $held = $held + 1;
    }
    if (str_pad($s, strlen($s), " ", STR_PAD_LEFT) === $s) {
        $held = $held + 1;
    }
    if (implode(",", explode(",", $s)) === $s) {
        $held = $held + 1;
    }
    if (substr_replace($s, "", 0, 0) === $s) {
        $held = $held + 1;
    }
    if (implode("", array_map("chr", array_map("ord", str_split($s)))) === $s) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
