--TEST--
Which string keys collapse to integer keys is decided exactly as PHP decides it
--FILE--
<?mwl
array<int> $a = ["10" => 1, 10 => 2, "x" => 3];
foreach ($a as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";

array<int> $b = ["01" => 1, "1" => 2, " 1" => 3];
foreach ($b as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
echo Core\Arr::count($a), "|", Core\Arr::count($b), "\n";
--ORACLE--
<?php
$a = ["10" => 1, 10 => 2, "x" => 3];
foreach ($a as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";

$b = ["01" => 1, "1" => 2, " 1" => 3];
foreach ($b as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
echo count($a), "|", count($b), "\n";
