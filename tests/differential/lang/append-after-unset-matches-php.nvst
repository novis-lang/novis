--TEST--
Appending after an `unset` continues from the highest integer key ever used, exactly as PHP does
--FILE--
<?nvs
array<int> $a = [10, 20, 30];
unset($a[2]);
$a[] = 40;
foreach ($a as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";

array<int> $b = [1, 2, 3];
unset($b[1]);
$b[] = 9;
foreach ($b as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
--ORACLE--
<?php
$a = [10, 20, 30];
unset($a[2]);
$a[] = 40;
foreach ($a as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";

$b = [1, 2, 3];
unset($b[1]);
$b[] = 9;
foreach ($b as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
