--TEST--
`as` renders the same text PHP's legacy cast does, on the rows where both succeed
--FILE--
<?mwl
echo "42" as int, "\n";
echo "-7" as int, "\n";
echo 3.0 as int, "\n";
echo 42 as float, "\n";
echo "3.5" as float, "\n";
echo 1 as string, "|", (-7) as string, "|", 1.5 as string, "|\n";
echo true as string, "|", false as string, "|\n";
--ORACLE--
<?php
echo (int)"42", "\n";
echo (int)"-7", "\n";
echo (int)3.0, "\n";
echo (float)42, "\n";
echo (float)"3.5", "\n";
echo (string)1, "|", (string)(-7), "|", (string)1.5, "|\n";
echo (string)true, "|", (string)false, "|\n";
