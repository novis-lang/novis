--TEST--
PHP's simple interpolation syntax inside a double-quoted string — `$a[0]`, `$a[bareword]` and `$a[$k]`, plus one-level `$o->prop` — renders exactly what PHP renders
--FILE--
<?mwl
array<int> $n = [10, 20, 30];
echo "n0=$n[0] n2=$n[2]\n";

array<string> $row = ["name" => "ann", "city" => "graz"];
echo "who=$row[name] where=$row[city]\n";

string $k = "name";
echo "byvar=$row[$k]\n";

class Person {
    public string $name;

    public function constructor(string $name) {
        $this->name = $name;
    }
}

var $p = new Person("bob");
echo "p=$p->name.\n";
echo "braced={$row["city"]} and {$p->name}\n";
--ORACLE--
<?php
$n = [10, 20, 30];
echo "n0=$n[0] n2=$n[2]\n";

$row = ["name" => "ann", "city" => "graz"];
echo "who=$row[name] where=$row[city]\n";

$k = "name";
echo "byvar=$row[$k]\n";

class Person {
    public string $name;

    public function __construct(string $name) {
        $this->name = $name;
    }
}

$p = new Person("bob");
echo "p=$p->name.\n";
echo "braced={$row["city"]} and {$p->name}\n";
