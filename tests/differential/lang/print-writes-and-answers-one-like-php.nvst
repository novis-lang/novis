--TEST--
`print` writes its one operand exactly as `echo` does and answers PHP's `1`, in statement and value position alike — ADR 0049 § 1 keeps the keyword
--FILE--
<?nvs
// Statement position: the answer is simply unread.
print "hello\n";

// Value position is what `print` exists for — `echo` has no value at all.
int $r = print "world\n";
echo $r, "\n";

// The operand is one expression, not `echo`'s comma list, so a multi-part
// line is built with `.` first.
int $n = 41;
echo print "n=" . $n . "\n", "\n";

// The two idioms the value is there for: a guarded write, and a write whose
// answer is compared.
bool $yes = true;
if ($yes && (print "guarded\n") == 1) {
    echo "both\n";
}
bool $no = false;
if ($no && (print "unreachable\n") == 1) {
    echo "unreachable\n";
}

// A refcounted operand goes through the same conversion `echo` uses.
string $s = "tail";
print $s;
print "\n";
--ORACLE--
<?php
print "hello\n";

$r = print "world\n";
echo $r, "\n";

$n = 41;
echo print "n=" . $n . "\n", "\n";

$yes = true;
if ($yes && (print "guarded\n") == 1) {
    echo "both\n";
}
$no = false;
if ($no && (print "unreachable\n") == 1) {
    echo "unreachable\n";
}

$s = "tail";
print $s;
print "\n";
