--TEST--
Unsetting keys the running `foreach` has not reached yet leaves that loop's sequence alone, exactly as PHP does
--FILE--
<?nvs
array<int> $a = [1, 2, 3, 4];
foreach ($a as string $k => int $v) {
    if ($v == 2) {
        unset($a[2]);
        unset($a[3]);
    }
    echo $k, ":", $v, ";";
}
echo "\n";
foreach ($a as string $k => int $v) {
    echo $k, ":", $v, ";";
}
echo "\n";
--ORACLE--
<?php
$a = [1, 2, 3, 4];
foreach ($a as $k => $v) {
    if ($v == 2) {
        unset($a[2]);
        unset($a[3]);
    }
    echo $k, ":", $v, ";";
}
echo "\n";
foreach ($a as $k => $v) {
    echo $k, ":", $v, ";";
}
echo "\n";
