--TEST--
`isset(...)` agrees with PHP on every operand shape: a null test, an absent key answering `false` rather than throwing, a stored `null` answering `false` too, and a left-to-right conjunction that short-circuits — `rule:classes/unset-is-refused-on-a-property`, ADR 0007 § 7 row 11
--FILE--
<?nvs
// `rule:classes/unset-is-refused-on-a-property`: `isset($x)` is `$x != null`, and nothing else. A
// non-nullable binding can never be `null`, so it is always `true`.
?string $a = null;
?string $b = "x";
string $s = "plain";
echo isset($a) ? "y" : "n", isset($b) ? "y" : "n", isset($s) ? "y" : "n", "\n";

// ADR 0007 § 7 row 11's throw is off under an `isset`, exactly as it is
// under a `??`: an absent key is what this construct exists to ask about.
array<string> $arr = ["k" => "v"];
echo isset($arr["k"]) ? "y" : "n", isset($arr["nope"]) ? "y" : "n", "\n";

// A stored `null` is not an absent key, and `isset` cannot tell them apart —
// both answer `false`, which is the whole difference from "the key exists".
array<?string> $holes = ["here" => "v", "empty" => null];
echo isset($holes["here"]) ? "y" : "n", isset($holes["empty"]) ? "y" : "n", "\n";

// Every level of the chain is guarded, not just the outermost one.
array<array<string>> $grid = ["r" => ["c" => "v"]];
echo isset($grid["r"]["c"]) ? "y" : "n",
    isset($grid["r"]["z"]) ? "y" : "n",
    isset($grid["q"]["c"]) ? "y" : "n", "\n";

// An untested nullable array needs no `!= null` first — the same position
// `??` already gives one.
?array<string> $maybe = null;
echo isset($maybe["k"]) ? "y" : "n", "\n";

// A property: nullable reflects what was last assigned, non-nullable is
// always `true` (`rule:classes/definite-property-initialization` makes it definitely initialised).
final class Box {
    public ?string $tag;
    public string $name = "boxy";
    public function constructor() {
        $this->tag = null;
    }
}
Box $box = new Box();
echo isset($box->tag) ? "y" : "n", isset($box->name) ? "y" : "n";
$box->tag = "here";
echo isset($box->tag) ? "y" : "n", "\n";

// The conjunction, and its short-circuit. The second row's subscript runs
// and the first row's does not, which is the observable half.
echo isset($a, $b) ? "y" : "n", isset($b, $s) ? "y" : "n",
    isset($b, $s, $a) ? "y" : "n", "\n";
int $i = 0;
echo isset($a, $arr[$i++ as string]) ? "y" : "n", " ", $i, "\n";
int $j = 0;
echo isset($b, $arr[$j++ as string]) ? "y" : "n", " ", $j, "\n";
--ORACLE--
<?php
$a = null;
$b = "x";
$s = "plain";
echo isset($a) ? "y" : "n", isset($b) ? "y" : "n", isset($s) ? "y" : "n", "\n";

$arr = ["k" => "v"];
echo isset($arr["k"]) ? "y" : "n", isset($arr["nope"]) ? "y" : "n", "\n";

$holes = ["here" => "v", "empty" => null];
echo isset($holes["here"]) ? "y" : "n", isset($holes["empty"]) ? "y" : "n", "\n";

$grid = ["r" => ["c" => "v"]];
echo isset($grid["r"]["c"]) ? "y" : "n",
    isset($grid["r"]["z"]) ? "y" : "n",
    isset($grid["q"]["c"]) ? "y" : "n", "\n";

$maybe = null;
echo isset($maybe["k"]) ? "y" : "n", "\n";

class Box {
    public $tag;
    public $name = "boxy";
    public function __construct() {
        $this->tag = null;
    }
}
$box = new Box();
echo isset($box->tag) ? "y" : "n", isset($box->name) ? "y" : "n";
$box->tag = "here";
echo isset($box->tag) ? "y" : "n", "\n";

echo isset($a, $b) ? "y" : "n", isset($b, $s) ? "y" : "n",
    isset($b, $s, $a) ? "y" : "n", "\n";
$i = 0;
echo isset($a, $arr[$i++]) ? "y" : "n", " ", $i, "\n";
$j = 0;
echo isset($b, $arr[$j++]) ? "y" : "n", " ", $j, "\n";
