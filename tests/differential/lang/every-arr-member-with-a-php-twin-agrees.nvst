--TEST--
every Core\Arr member the spec gives a PHP twin answers what that twin answers over one shared corpus of lists and one map, and the eight identities the members hold jointly hold in PHP too (spec § 2, ADR 0063 R3, R5)
--FILE--
<?nvs
// The roster case for `Core\Arr`, and the sibling of
// `every-str-member-with-a-php-twin-agrees`. Every file under
// tests/differential/core/arr-*.nvst asks one member a deep question; this one
// asks *every* member the spec gives a PHP twin the same shallow question over
// one shared corpus, so a member that is added, renamed, given a second option
// or quietly re-based on a different comparison shows up here rather than
// having to be noticed.
//
// Two constraints make the comparison honest, and both are chosen rather than
// stumbled into.
//
// **Every subject is a list of one type.** Spec § 2's divergence column is
// mostly about *keys* — `withoutFirst` keeps the keys that survive where
// `array_shift` renumbers, `padStart` always answers a list where `array_pad`
// renumbers only integer keys — and about PHP's loose comparisons, where
// `contains`, `unique`, `diff` and `intersect` are strict. A single-typed list
// is the region where neither difference can arise, so what this file compares
// is the operation. The `…-diverges-…` files are where each key rule and each
// comparison rule is pinned on its own.
//
// **Rows render values, not pairs, unless the member's contract is its keys.**
// The pair-rendered rows below are exactly the members whose keys PHP's twin
// also produces: `map`, `filter`, `countBy`, `flip`, `fillKeys`,
// `fromKeysAndValues`, `overlay`, `underlay` and `sortByKey`.
//
// Four members are absent and each for a stated reason: `flattenDeep`'s twin
// is a recursive iterator rather than a function, `from`'s subject is an
// `Iterable`, `groupBy` has no twin at all, and `column`/`overlayDeep` need a
// nested subject that would smuggle the key rules back in.
final class Render {
    public static function ints(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $v . ",";
        }
        return $out;
    }

    public static function texts(array<string> $a): string {
        var $out = "";
        foreach ($a as string $k => string $v) {
            $out = $out . $v . ",";
        }
        return $out;
    }

    public static function pairsInt(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }

    public static function pairsText(array<string> $a): string {
        var $out = "";
        foreach ($a as string $k => string $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }

    public static function counts(array<uint> $a): string {
        var $out = "";
        foreach ($a as string $k => uint $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }

    public static function nested(array<array<int>> $a): string {
        var $out = "";
        foreach ($a as string $k => array<int> $inner) {
            $out = $out . "(" . Render::ints($inner) . ")";
        }
        return $out;
    }
}

final class Show {
    // `?T` against PHP's `false`-or-warning: `first`, `last`, `min`, `max` all
    // answer `null` over an empty subject where their twins are `false` or a
    // `ValueError`, which is a difference in how "no answer" is spelled and not
    // in the answer. Both sides fold it to one sentinel.
    public static function orNoneInt(?int $v): string {
        if ($v == null) {
            return "<none>";
        }
        return $v as string;
    }

    public static function orNoneText(?string $v): string {
        if ($v == null) {
            return "<none>";
        }
        return $v as string;
    }

    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }
}

// The empty list, a singleton, a list that is out of order, one with a repeat
// so `unique` and `countBy` have something to collapse, and one holding a
// negative and a zero so `sum`, `product`, `min` and `max` are not all decided
// by the same cell.
array<array<int>> $lists = [[], [5], [3, 1, 2], [4, 4, 2, 4], [10, -2, 7, 0]];

// The same shapes over `string`, because half the members order or compare
// their entries and two `string`s compare bytewise in both languages.
array<array<string>> $wordLists = [[], ["b"], ["pear", "apple", "fig"], ["pear", "apple", "fig", "apple"]];

// One map, string-keyed and non-numeral, for the members whose contract is the
// key. Non-numeral on purpose: `sortByKey` compares keys bytewise where
// `ksort`'s default is `SORT_REGULAR`, and `arr-sort-by-key-on-numeral-keys-
// diverges-from-ksort` is where that is pinned.
array<int> $map = ["ann" => 3, "bob" => 8, "cy" => 5];
array<int> $layer = ["bob" => 9, "dee" => 1];

// The second operands, declared rather than written inline: a bare `[99]` in
// argument position is `array<mixed>` and does not narrow into an
// `array<int>` parameter, which is `E0401` at the literal (`rule:types/grammar`).
array<int> $splice = [99];
array<int> $against = [4, 2];
array<int> $tail = [7, 8];
array<string> $twoKeys = ["a", "b"];
array<int> $twoValues = [1, 2];

// ---------------------------------------------------------------------------
// Questions about the subject itself.
// ---------------------------------------------------------------------------

echo "count:";
foreach ($lists as array<int> $a) {
    echo Core\Arr::count($a), "|";
}
echo "\n";

echo "isEmpty:";
foreach ($lists as array<int> $a) {
    echo Show::flag(Core\Arr::isEmpty($a)), "|";
}
echo "\n";

echo "isList:";
foreach ($lists as array<int> $a) {
    echo Show::flag(Core\Arr::isList($a)), "|";
}
echo "\n";

echo "hasKey:";
foreach ($lists as array<int> $a) {
    echo Show::flag(Core\Arr::hasKey($a, 0)), Show::flag(Core\Arr::hasKey($a, 2)), "|";
}
echo "\n";

echo "contains:";
foreach ($lists as array<int> $a) {
    echo Show::flag(Core\Arr::contains($a, 4)), Show::flag(Core\Arr::contains($a, 99)), "|";
}
echo "\n";

echo "keyOf:";
foreach ($lists as array<int> $a) {
    echo Show::orNoneText(Core\Arr::keyOf($a, 4)), ",", Show::orNoneText(Core\Arr::keyOf($a, 99)), "|";
}
echo "\n";

echo "keys:";
foreach ($lists as array<int> $a) {
    echo Render::texts(Core\Arr::keys($a)), "|";
}
echo "\n";

echo "values:";
foreach ($lists as array<int> $a) {
    echo Render::ints(Core\Arr::values($a)), "|";
}
echo "\n";

echo "first:";
foreach ($lists as array<int> $a) {
    echo Show::orNoneInt(Core\Arr::first($a)), "|";
}
echo "\n";

echo "last:";
foreach ($lists as array<int> $a) {
    echo Show::orNoneInt(Core\Arr::last($a)), "|";
}
echo "\n";

echo "firstKey:";
foreach ($lists as array<int> $a) {
    echo Show::orNoneText(Core\Arr::firstKey($a)), "|";
}
echo "\n";

echo "lastKey:";
foreach ($lists as array<int> $a) {
    echo Show::orNoneText(Core\Arr::lastKey($a)), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// Members that answer a rearranged subject. Values, per the header.
// ---------------------------------------------------------------------------

echo "slice:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::slice($a, 1, 2)), "]";
}
echo "\n";

echo "sliceTail:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::slice($a, -2, null)), "]";
}
echo "\n";

echo "replaceRange:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::replaceRange($a, 1, 2, $splice)), "]";
}
echo "\n";

echo "chunk:";
foreach ($lists as array<int> $a) {
    echo "[", Render::nested(Core\Arr::chunk($a, 2)), "]";
}
echo "\n";

echo "append:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::append($a, 42)), "]";
}
echo "\n";

echo "prepend:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::prepend($a, 42)), "]";
}
echo "\n";

echo "withoutFirst:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::withoutFirst($a)), "]";
}
echo "\n";

echo "withoutLast:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::withoutLast($a)), "]";
}
echo "\n";

echo "padStart:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::padStart($a, 5, 0)), "]";
}
echo "\n";

echo "padEnd:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::padEnd($a, 5, 0)), "]";
}
echo "\n";

echo "reverse:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::reverse($a)), "]";
}
echo "\n";

echo "unique:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::unique($a)), "]";
}
echo "\n";

echo "sort:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::sort($a)), "]";
}
echo "\n";

echo "sortWords:";
foreach ($wordLists as array<string> $w) {
    echo "[", Render::texts(Core\Arr::sort($w)), "]";
}
echo "\n";

echo "sortBy:";
foreach ($wordLists as array<string> $w) {
    echo "[", Render::texts(Core\Arr::sort($w, {by: fn(string $s): int => Core\Str::length($s) as int})), "]";
}
echo "\n";

echo "diff:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::diff($a, $against)), "]";
}
echo "\n";

echo "intersect:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::intersect($a, $against)), "]";
}
echo "\n";

echo "appendAll:";
foreach ($lists as array<int> $a) {
    echo "[", Render::ints(Core\Arr::appendAll($a, $tail)), "]";
}
echo "\n";

echo "flatten:";
array<array<int>> $nested = [[1, 2], [3], [], [4, 5, 6]];
echo "[", Render::ints(Core\Arr::flatten($nested)), "]\n";

// ---------------------------------------------------------------------------
// Members that answer a number, or one entry.
// ---------------------------------------------------------------------------

echo "sum:";
foreach ($lists as array<int> $a) {
    echo Core\Arr::sum($a), "|";
}
echo "\n";

echo "product:";
foreach ($lists as array<int> $a) {
    echo Core\Arr::product($a), "|";
}
echo "\n";

echo "min:";
foreach ($lists as array<int> $a) {
    echo Show::orNoneInt(Core\Arr::min($a)), "|";
}
echo "\n";

echo "max:";
foreach ($lists as array<int> $a) {
    echo Show::orNoneInt(Core\Arr::max($a)), "|";
}
echo "\n";

echo "reduce:";
foreach ($lists as array<int> $a) {
    echo Core\Arr::reduce($a, fn(int $acc, int $n) => $acc + $n, 100), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// Members that take a callback. PHP's four newest array functions —
// `array_find`, `array_find_key`, `array_any`, `array_all` — are the twins,
// which is why this block needs 8.4 or later on the oracle leg.
// ---------------------------------------------------------------------------

echo "find:";
foreach ($lists as array<int> $a) {
    echo Show::orNoneInt(Core\Arr::find($a, fn(int $n) => $n > 3)), "|";
}
echo "\n";

echo "findKey:";
foreach ($lists as array<int> $a) {
    echo Show::orNoneText(Core\Arr::findKey($a, fn(int $n) => $n > 3)), "|";
}
echo "\n";

echo "any:";
foreach ($lists as array<int> $a) {
    echo Show::flag(Core\Arr::any($a, fn(int $n) => $n > 3)), "|";
}
echo "\n";

echo "all:";
foreach ($lists as array<int> $a) {
    echo Show::flag(Core\Arr::all($a, fn(int $n) => $n > 3)), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// The pair-rendered rows: the members whose keys PHP's twin also produces.
// ---------------------------------------------------------------------------

echo "map:", Render::pairsInt(Core\Arr::map($map, fn(int $n) => $n * 10)), "\n";
echo "filter:", Render::pairsInt(Core\Arr::filter($map, fn(int $n) => $n > 4)), "\n";
echo "overlay:", Render::pairsInt(Core\Arr::overlay($map, $layer)), "\n";
echo "underlay:", Render::pairsInt(Core\Arr::underlay($map, $layer)), "\n";
echo "sortByKey:", Render::pairsInt(Core\Arr::sortByKey($map)), "\n";
echo "flip:", Render::pairsText(Core\Arr::flip(["x", "y", "z"])), "\n";
echo "fillKeys:", Render::pairsInt(Core\Arr::fillKeys(["a", "b"], 0)), "\n";
echo "fromKeysAndValues:", Render::pairsInt(Core\Arr::fromKeysAndValues($twoKeys, $twoValues)), "\n";

echo "countBy:";
foreach ($wordLists as array<string> $w) {
    echo "[", Render::counts(Core\Arr::countBy($w)), "]";
}
echo "\n";

// ---------------------------------------------------------------------------
// The two producers, which have no subject to sweep.
// ---------------------------------------------------------------------------

echo "fill:", Render::ints(Core\Arr::fill(3, 7)), "|", Render::ints(Core\Arr::fill(0, 7)), "|\n";
echo "range:", Render::ints(Core\Arr::range(1, 5)), "|", Render::ints(Core\Arr::range(5, 1)), "|", Render::ints(Core\Arr::range(1, 9, {step: 3})), "|\n";

// ---------------------------------------------------------------------------
// The joint claim. Each identity names two or three members and says they
// agree about the same subject; PHP's twins hold every one of them too, which
// is what makes the count comparable rather than merely internal. A member
// that grew its own comparison still prints a plausible row above and fails
// here, which is why this block is counted rather than read off the tables.
// ---------------------------------------------------------------------------

int $held = 0;
int $cells = 0;
foreach ($lists as array<int> $a) {
    $cells = $cells + 8;

    // `count` is what `keys` and `values` both produce.
    if (Core\Arr::count(Core\Arr::keys($a)) as int == Core\Arr::count(Core\Arr::values($a)) as int) {
        $held = $held + 1;
    }
    // `isEmpty` is `count` at zero, said once.
    if (Show::flag(Core\Arr::isEmpty($a)) == Show::flag(Core\Arr::count($a) as int == 0)) {
        $held = $held + 1;
    }
    // `reverse` is its own inverse.
    if (Render::ints(Core\Arr::reverse(Core\Arr::reverse($a))) == Render::ints($a)) {
        $held = $held + 1;
    }
    // `first` and `last` name the two ends `reverse` swaps.
    if (Show::orNoneInt(Core\Arr::first($a)) == Show::orNoneInt(Core\Arr::last(Core\Arr::reverse($a)))) {
        $held = $held + 1;
    }
    // `withoutFirst` and `prepend` undo each other at the front.
    if (Render::ints(Core\Arr::withoutFirst(Core\Arr::prepend($a, 42))) == Render::ints($a)) {
        $held = $held + 1;
    }
    // `withoutLast` and `append` undo each other at the back.
    if (Render::ints(Core\Arr::withoutLast(Core\Arr::append($a, 42))) == Render::ints($a)) {
        $held = $held + 1;
    }
    // Slicing from the front with no length is the subject.
    if (Render::ints(Core\Arr::slice($a, 0, null)) == Render::ints($a)) {
        $held = $held + 1;
    }
    // `sort` moves entries and keeps every one of them, so the sum survives.
    if (Core\Arr::sum(Core\Arr::sort($a)) == Core\Arr::sum($a)) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
--ORACLE--
<?php
function renderInts(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $v . ",";
    }
    return $out;
}

function renderPairs(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

function renderNested(array $a): string {
    $out = "";
    foreach ($a as $inner) {
        $out = $out . "(" . renderInts($inner) . ")";
    }
    return $out;
}

function orNone($v) {
    if ($v === null) {
        return "<none>";
    }
    if ($v === false) {
        return "<none>";
    }
    return (string) $v;
}

function flag($v) {
    if ($v) {
        return "T";
    }
    return "F";
}

// `Core\Arr::replaceRange` is `array_splice` made pure: ADR 0063 R3 refuses a
// by-reference parameter, so the twin is the splice applied to a copy.
function phpReplaceRange(array $a, int $offset, ?int $length, array $replacement): array {
    $copy = $a;
    array_splice($copy, $offset, $length, $replacement);
    return $copy;
}

function phpWithoutFirst(array $a): array {
    return array_slice($a, 1);
}

function phpWithoutLast(array $a): array {
    if (count($a) === 0) {
        return [];
    }
    return array_slice($a, 0, -1);
}

function phpAppend(array $a, $v): array {
    $copy = $a;
    array_push($copy, $v);
    return $copy;
}

function phpPrepend(array $a, $v): array {
    $copy = $a;
    array_unshift($copy, $v);
    return $copy;
}

function phpSort(array $a): array {
    sort($a);
    return $a;
}

function phpSortBy(array $a, $by): array {
    usort($a, fn($l, $r) => $by($l) <=> $by($r));
    return $a;
}

function phpSortByKey(array $a): array {
    ksort($a);
    return $a;
}

// `min`/`max` over an empty subject are a `ValueError` where the members
// answer `null`; the guard is the comparable part.
function phpMin(array $a) {
    if (count($a) === 0) {
        return null;
    }
    return min($a);
}

function phpMax(array $a) {
    if (count($a) === 0) {
        return null;
    }
    return max($a);
}

function phpFirst(array $a) {
    if (count($a) === 0) {
        return null;
    }
    return $a[array_key_first($a)];
}

function phpLast(array $a) {
    if (count($a) === 0) {
        return null;
    }
    return $a[array_key_last($a)];
}

$lists = [[], [5], [3, 1, 2], [4, 4, 2, 4], [10, -2, 7, 0]];

$wordLists = [[], ["b"], ["pear", "apple", "fig"], ["pear", "apple", "fig", "apple"]];

$map = ["ann" => 3, "bob" => 8, "cy" => 5];
$layer = ["bob" => 9, "dee" => 1];

echo "count:";
foreach ($lists as $a) {
    echo count($a), "|";
}
echo "\n";

echo "isEmpty:";
foreach ($lists as $a) {
    echo flag(count($a) === 0), "|";
}
echo "\n";

echo "isList:";
foreach ($lists as $a) {
    echo flag(array_is_list($a)), "|";
}
echo "\n";

echo "hasKey:";
foreach ($lists as $a) {
    echo flag(array_key_exists(0, $a)), flag(array_key_exists(2, $a)), "|";
}
echo "\n";

echo "contains:";
foreach ($lists as $a) {
    echo flag(in_array(4, $a, true)), flag(in_array(99, $a, true)), "|";
}
echo "\n";

echo "keyOf:";
foreach ($lists as $a) {
    echo orNone(array_search(4, $a, true)), ",", orNone(array_search(99, $a, true)), "|";
}
echo "\n";

echo "keys:";
foreach ($lists as $a) {
    echo renderInts(array_keys($a)), "|";
}
echo "\n";

echo "values:";
foreach ($lists as $a) {
    echo renderInts(array_values($a)), "|";
}
echo "\n";

echo "first:";
foreach ($lists as $a) {
    echo orNone(phpFirst($a)), "|";
}
echo "\n";

echo "last:";
foreach ($lists as $a) {
    echo orNone(phpLast($a)), "|";
}
echo "\n";

echo "firstKey:";
foreach ($lists as $a) {
    echo orNone(array_key_first($a)), "|";
}
echo "\n";

echo "lastKey:";
foreach ($lists as $a) {
    echo orNone(array_key_last($a)), "|";
}
echo "\n";

echo "slice:";
foreach ($lists as $a) {
    echo "[", renderInts(array_slice($a, 1, 2)), "]";
}
echo "\n";

echo "sliceTail:";
foreach ($lists as $a) {
    echo "[", renderInts(array_slice($a, -2)), "]";
}
echo "\n";

echo "replaceRange:";
foreach ($lists as $a) {
    echo "[", renderInts(phpReplaceRange($a, 1, 2, [99])), "]";
}
echo "\n";

echo "chunk:";
foreach ($lists as $a) {
    echo "[", renderNested(array_chunk($a, 2)), "]";
}
echo "\n";

echo "append:";
foreach ($lists as $a) {
    echo "[", renderInts(phpAppend($a, 42)), "]";
}
echo "\n";

echo "prepend:";
foreach ($lists as $a) {
    echo "[", renderInts(phpPrepend($a, 42)), "]";
}
echo "\n";

echo "withoutFirst:";
foreach ($lists as $a) {
    echo "[", renderInts(phpWithoutFirst($a)), "]";
}
echo "\n";

echo "withoutLast:";
foreach ($lists as $a) {
    echo "[", renderInts(phpWithoutLast($a)), "]";
}
echo "\n";

echo "padStart:";
foreach ($lists as $a) {
    echo "[", renderInts(array_pad($a, -5, 0)), "]";
}
echo "\n";

echo "padEnd:";
foreach ($lists as $a) {
    echo "[", renderInts(array_pad($a, 5, 0)), "]";
}
echo "\n";

echo "reverse:";
foreach ($lists as $a) {
    echo "[", renderInts(array_reverse($a)), "]";
}
echo "\n";

echo "unique:";
foreach ($lists as $a) {
    echo "[", renderInts(array_unique($a, SORT_REGULAR)), "]";
}
echo "\n";

echo "sort:";
foreach ($lists as $a) {
    echo "[", renderInts(phpSort($a)), "]";
}
echo "\n";

echo "sortWords:";
foreach ($wordLists as $w) {
    echo "[", renderInts(phpSort($w)), "]";
}
echo "\n";

echo "sortBy:";
foreach ($wordLists as $w) {
    echo "[", renderInts(phpSortBy($w, fn($s) => strlen($s))), "]";
}
echo "\n";

echo "diff:";
foreach ($lists as $a) {
    echo "[", renderInts(array_diff($a, [4, 2])), "]";
}
echo "\n";

echo "intersect:";
foreach ($lists as $a) {
    echo "[", renderInts(array_intersect($a, [4, 2])), "]";
}
echo "\n";

echo "appendAll:";
foreach ($lists as $a) {
    echo "[", renderInts(array_merge($a, [7, 8])), "]";
}
echo "\n";

echo "flatten:";
$nested = [[1, 2], [3], [], [4, 5, 6]];
echo "[", renderInts(array_merge(...$nested)), "]\n";

echo "sum:";
foreach ($lists as $a) {
    echo array_sum($a), "|";
}
echo "\n";

echo "product:";
foreach ($lists as $a) {
    echo array_product($a), "|";
}
echo "\n";

echo "min:";
foreach ($lists as $a) {
    echo orNone(phpMin($a)), "|";
}
echo "\n";

echo "max:";
foreach ($lists as $a) {
    echo orNone(phpMax($a)), "|";
}
echo "\n";

echo "reduce:";
foreach ($lists as $a) {
    echo array_reduce($a, fn($acc, $n) => $acc + $n, 100), "|";
}
echo "\n";

echo "find:";
foreach ($lists as $a) {
    echo orNone(array_find($a, fn($n) => $n > 3)), "|";
}
echo "\n";

echo "findKey:";
foreach ($lists as $a) {
    echo orNone(array_find_key($a, fn($n) => $n > 3)), "|";
}
echo "\n";

echo "any:";
foreach ($lists as $a) {
    echo flag(array_any($a, fn($n) => $n > 3)), "|";
}
echo "\n";

echo "all:";
foreach ($lists as $a) {
    echo flag(array_all($a, fn($n) => $n > 3)), "|";
}
echo "\n";

echo "map:", renderPairs(array_map(fn($n) => $n * 10, $map)), "\n";
echo "filter:", renderPairs(array_filter($map, fn($n) => $n > 4)), "\n";
echo "overlay:", renderPairs(array_replace($map, $layer)), "\n";
echo "underlay:", renderPairs($map + $layer), "\n";
echo "sortByKey:", renderPairs(phpSortByKey($map)), "\n";
echo "flip:", renderPairs(array_flip(["x", "y", "z"])), "\n";
echo "fillKeys:", renderPairs(array_fill_keys(["a", "b"], 0)), "\n";
echo "fromKeysAndValues:", renderPairs(array_combine(["a", "b"], [1, 2])), "\n";

echo "countBy:";
foreach ($wordLists as $w) {
    echo "[", renderPairs(array_count_values($w)), "]";
}
echo "\n";

echo "fill:", renderInts(array_fill(0, 3, 7)), "|", renderInts(array_fill(0, 0, 7)), "|\n";
echo "range:", renderInts(range(1, 5)), "|", renderInts(range(5, 1)), "|", renderInts(range(1, 9, 3)), "|\n";

$held = 0;
$cells = 0;
foreach ($lists as $a) {
    $cells = $cells + 8;

    if (count(array_keys($a)) === count(array_values($a))) {
        $held = $held + 1;
    }
    if (flag(count($a) === 0) === flag(count($a) === 0)) {
        $held = $held + 1;
    }
    if (renderInts(array_reverse(array_reverse($a))) === renderInts($a)) {
        $held = $held + 1;
    }
    if (orNone(phpFirst($a)) === orNone(phpLast(array_reverse($a)))) {
        $held = $held + 1;
    }
    if (renderInts(phpWithoutFirst(phpPrepend($a, 42))) === renderInts($a)) {
        $held = $held + 1;
    }
    if (renderInts(phpWithoutLast(phpAppend($a, 42))) === renderInts($a)) {
        $held = $held + 1;
    }
    if (renderInts(array_slice($a, 0)) === renderInts($a)) {
        $held = $held + 1;
    }
    if (array_sum(phpSort($a)) === array_sum($a)) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";
