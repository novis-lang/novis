--TEST--
`$a[8]` reaches the same entry PHP's does, and `"08"` stays a separate key in both
--FILE--
<?nvs
class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $a = [];
$a[8] = 80;
echo $a["8"], "\n";
echo Render::of($a), "\n";

$a["8"] = 88;
echo Render::of($a), "\n";

$a["08"] = 8;
echo Render::of($a), "\n";
echo Core\Arr::count($a), "\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$a = [];
$a[8] = 80;
echo $a["8"], "\n";
echo render($a), "\n";

$a["8"] = 88;
echo render($a), "\n";

$a["08"] = 8;
echo render($a), "\n";
echo count($a), "\n";
