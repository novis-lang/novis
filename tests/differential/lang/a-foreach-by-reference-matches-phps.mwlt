--TEST--
`foreach (… as &$v)` agrees with PHP on what the array holds afterwards: the separation a copy forces, an entry the body appends, an exit through `break` or a throw, and a nested row
--FILE--
<?mwl
final class Walk {
    public static function bump(inout int $n): void {
        $n = $n + 100;
    }
}

array<int> $written = [1, 2, 3];
array<int> $copy = $written;
foreach ($written as inout int $w) {
    $w = $w * 2;
}
echo Core\Json::encode($written), " ", Core\Json::encode($copy), "\n";

array<int> $mixed = ["k" => 1, 2, "3" => 5];
foreach ($mixed as inout int $m) {
    $m = $m + 10;
}
echo Core\Json::encode($mixed), "\n";

array<int> $grown = [1];
foreach ($grown as inout int $g) {
    if ($g == 1) {
        $grown["1"] = 2;
    }
    $g = $g * 100;
}
echo Core\Json::encode($grown), "\n";

array<int> $stopped = [1, 2, 3, 4];
foreach ($stopped as inout int $s) {
    if ($s == 3) {
        break;
    }
    $s = 0;
}
echo Core\Json::encode($stopped), "\n";

array<string> $thrown = ["a", "b"];
try {
    foreach ($thrown as inout string $t) {
        $t = "z";
        throw new RuntimeError("stop");
    }
} catch (Throwable $stop) {
    echo "caught\n";
}
echo Core\Json::encode($thrown), "\n";

array<array<int>> $grid = [[1, 2], [3, 4]];
foreach ($grid as inout array<int> $row) {
    foreach ($row as inout int $cell) {
        $cell = $cell * 10;
    }
}
echo Core\Json::encode($grid), "\n";

array<int> $bumped = [3, 4];
foreach ($bumped as inout int $b) {
    Walk::bump(inout $b);
}
echo Core\Json::encode($bumped), "\n";
--ORACLE--
<?php
function bump(int &$n): void {
    $n = $n + 100;
}

$written = [1, 2, 3];
$copy = $written;
foreach ($written as &$w) {
    $w = $w * 2;
}
unset($w);
echo json_encode($written), " ", json_encode($copy), "\n";

$mixed = ["k" => 1, 2, "3" => 5];
foreach ($mixed as &$m) {
    $m = $m + 10;
}
unset($m);
echo json_encode($mixed), "\n";

$grown = [1];
foreach ($grown as &$g) {
    if ($g === 1) {
        $grown[1] = 2;
    }
    $g = $g * 100;
}
unset($g);
echo json_encode($grown), "\n";

$stopped = [1, 2, 3, 4];
foreach ($stopped as &$s) {
    if ($s === 3) {
        break;
    }
    $s = 0;
}
unset($s);
echo json_encode($stopped), "\n";

$thrown = ["a", "b"];
try {
    foreach ($thrown as &$t) {
        $t = "z";
        throw new RuntimeException("stop");
    }
} catch (Throwable $stop) {
    echo "caught\n";
}
unset($t);
echo json_encode($thrown), "\n";

$grid = [[1, 2], [3, 4]];
foreach ($grid as &$row) {
    foreach ($row as &$cell) {
        $cell = $cell * 10;
    }
    unset($cell);
}
unset($row);
echo json_encode($grid), "\n";

$bumped = [3, 4];
foreach ($bumped as &$b) {
    bump($b);
}
unset($b);
echo json_encode($bumped), "\n";
