--TEST--
integer +, -, *, % and their precedence agree with PHP
--FILE--
<?nvs
echo 2 + 3 * 4, "\n";
echo (2 + 3) * 4, "\n";
echo 10 - 4 - 3, "\n";
echo 17 % 5, "\n";
echo -17 % 5, "\n";
echo 17 % -5, "\n";
echo 0 - 9, "\n";
--ORACLE--
<?php
echo 2 + 3 * 4, "\n";
echo (2 + 3) * 4, "\n";
echo 10 - 4 - 3, "\n";
echo 17 % 5, "\n";
echo -17 % 5, "\n";
echo 17 % -5, "\n";
echo 0 - 9, "\n";
