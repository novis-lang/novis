--TEST--
An append after a negative integer key continues from it, and a lower key added later does not move it back — PHP 8's rule
--FILE--
<?nvs
array<string> $n = [];
$n[-5] = "m";
$n[] = "n";
$n[-9] = "o";
$n[] = "p";
foreach ($n as string $k => string $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
--ORACLE--
<?php
$n = [];
$n[-5] = "m";
$n[] = "n";
$n[-9] = "o";
$n[] = "p";
foreach ($n as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
