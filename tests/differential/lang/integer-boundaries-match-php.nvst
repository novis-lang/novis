--TEST--
`int` at its two extremes prints what PHP prints, and arithmetic near them stays integral
--FILE--
<?nvs
int $max = 9223372036854775807;
int $min = 0 - 9223372036854775807;
echo $max, "\n";
echo $min, "\n";
echo $max - 1, "\n";
echo $min + 1, "\n";
echo $max as string, "\n";
--ORACLE--
<?php
$max = 9223372036854775807;
$min = 0 - 9223372036854775807;
echo $max, "\n";
echo $min, "\n";
echo $max - 1, "\n";
echo $min + 1, "\n";
echo (string) $max, "\n";
