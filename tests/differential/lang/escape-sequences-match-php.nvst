--TEST--
double- and single-quoted escapes render identically to PHP's
--FILE--
<?nvs
string $who = "world";

echo "tab[\t]end\n";
echo "quote[\"]end\n";
echo "backslash[\\]end\n";
echo "dollar[\$who]end\n";
echo 'single[$who]end', "\n";
echo 'single[\t]end', "\n";
echo "interpolated[$who]end\n";
echo "braced[{$who}]end\n";
--ORACLE--
<?php
$who = "world";

echo "tab[\t]end\n";
echo "quote[\"]end\n";
echo "backslash[\\]end\n";
echo "dollar[\$who]end\n";
echo 'single[$who]end', "\n";
echo 'single[\t]end', "\n";
echo "interpolated[$who]end\n";
echo "braced[{$who}]end\n";
