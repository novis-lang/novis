--TEST--
`.` renders an int, a float and a bool operand exactly as PHP's `.` does
--FILE--
<?mwl
echo "n=" . 5 . "!", "\n";
echo 1 . 2, "\n";
echo "f=" . 1.5, "\n";
echo "whole=" . 2.0, "\n";
echo "neg=" . (0 - 7), "\n";
echo "t=" . true . "|f=" . false . "|", "\n";
--ORACLE--
<?php
echo "n=" . 5 . "!", "\n";
echo 1 . 2, "\n";
echo "f=" . 1.5, "\n";
echo "whole=" . 2.0, "\n";
echo "neg=" . (0 - 7), "\n";
echo "t=" . true . "|f=" . false . "|", "\n";
