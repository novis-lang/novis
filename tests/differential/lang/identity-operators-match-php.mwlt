--TEST--
`===` and `!==` fall the same way in MWL and PHP over scalars of one type
--FILE--
<?mwl
echo (1 === 1) as string, "|", (1 === 2) as string, "|\n";
echo (1 !== 2) as string, "|", (1 !== 1) as string, "|\n";
echo ("a" === "a") as string, "|", ("a" === "b") as string, "|\n";
echo ("a" !== "b") as string, "|", ("" === "") as string, "|\n";
echo (1.5 === 1.5) as string, "|", (1.5 === 2.5) as string, "|\n";
echo (true === true) as string, "|", (true === false) as string, "|\n";
--ORACLE--
<?php
echo (string)(1 === 1), "|", (string)(1 === 2), "|\n";
echo (string)(1 !== 2), "|", (string)(1 !== 1), "|\n";
echo (string)("a" === "a"), "|", (string)("a" === "b"), "|\n";
echo (string)("a" !== "b"), "|", (string)("" === ""), "|\n";
echo (string)(1.5 === 1.5), "|", (string)(1.5 === 2.5), "|\n";
echo (string)(true === true), "|", (string)(true === false), "|\n";
