--TEST--
`$a[] = $v` picks the same next index PHP's does, keyed entries included
--FILE--
<?nvs
class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $a = [];
$a[] = 10;
$a[] = 20;
echo Render::of($a), "\n";

array<int> $c = ["x" => 1];
$c[] = 2;
$c[] = 3;
echo Render::of($c), "\n";

echo Render::of([1, "k" => 2, 3]), "\n";
echo Render::of(["k" => 1, 2, "j" => 3, 4]), "\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$a = [];
$a[] = 10;
$a[] = 20;
echo render($a), "\n";

$c = ["x" => 1];
$c[] = 2;
$c[] = 3;
echo render($c), "\n";

echo render([1, "k" => 2, 3]), "\n";
echo render(["k" => 1, 2, "j" => 3, 4]), "\n";
