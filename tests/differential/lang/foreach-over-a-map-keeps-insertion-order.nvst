--TEST--
foreach over a string-keyed array visits keys in insertion order, as PHP does
--FILE--
<?nvs
array<int> $ages = ["ann" => 31, "bob" => 24, "cy" => 45];

foreach ($ages as string $name => int $age) {
    echo $name, "=", $age, "\n";
}

unset($ages["ann"]);
$ages["ann"] = 32;

foreach ($ages as string $name => int $age) {
    echo $name, "=", $age, "\n";
}
--ORACLE--
<?php
$ages = ["ann" => 31, "bob" => 24, "cy" => 45];

foreach ($ages as $name => $age) {
    echo $name, "=", $age, "\n";
}

unset($ages["ann"]);
$ages["ann"] = 32;

foreach ($ages as $name => $age) {
    echo $name, "=", $age, "\n";
}
