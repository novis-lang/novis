--TEST--
an if/else-if/else chain picks the same branch PHP's does over the same integers
--FILE--
<?mwl
class Classify {
    public static function of(int $n): string {
        if ($n < 0) {
            return "negative";
        } else if ($n == 0) {
            return "zero";
        } else if ($n < 10) {
            return "small";
        } else {
            return "large";
        }
    }
}

array<int> $samples = [-5, 0, 1, 9, 10, 4000];
foreach ($samples as int $n) {
    echo $n, " is ", Classify::of($n), "\n";
}
--ORACLE--
<?php
function classify(int $n): string {
    if ($n < 0) {
        return "negative";
    } else if ($n === 0) {
        return "zero";
    } else if ($n < 10) {
        return "small";
    } else {
        return "large";
    }
}

$samples = [-5, 0, 1, 9, 10, 4000];
foreach ($samples as $n) {
    echo $n, " is ", classify($n), "\n";
}
