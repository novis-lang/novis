--TEST--
`[...$a]` renumbers an integer-looking key and preserves every other one, exactly as PHP does — ADR 0007 § 5
--FILE--
<?nvs
// Two lists concatenate: every key of both is integer-looking, so every
// entry is appended under the destination's own counter.
array<string> $a = ["x", "y"];
array<string> $b = ["p", "q"];
echo Core\Json::encode([...$a, ...$b]), "\n";

// A string key is preserved in place, so a later spread overwrites rather
// than appending — and a written-out `key =>` element beside a spread is the
// same write.
array<string> $m = ["one" => "1", "two" => "2"];
echo Core\Json::encode([...$m, "three" => "3"]), "\n";
echo Core\Json::encode([...$m, "one" => "9"]), "\n";
echo Core\Json::encode([...$m, ...$m]), "\n";

// A keyless element beside a spread continues from the entries the spread
// contributed, which is PHP's "next free integer key" and not a count of the
// elements written out in the source.
echo Core\Json::encode(["head", ...$a, "tail"]), "\n";
echo Core\Json::encode([...$a, "k" => "v", "tail"]), "\n";

// Which key is "integer-looking" is the canonical decimal reading, so `"08"`
// survives where `"8"` does not, and a negative key is one too.
array<string> $pad = ["08" => "p", "8" => "e"];
echo Core\Json::encode([...$pad]), "\n";
array<string> $neg = ["-5" => "n"];
echo Core\Json::encode([...$neg]), "\n";
array<string> $big = ["9223372036854775807" => "m"];
echo Core\Json::encode([...$big]), "\n";

// A mixed subject gives both behaviours in one copy, which is the whole rule
// asserted at once.
array<int> $mix = ["a" => 1, "0" => 2, "b" => 3];
echo Core\Json::encode([...$mix, ...$mix]), "\n";

// Nothing to copy, and a copy into nothing.
echo Core\Json::encode([...[]]), "\n";

// The renumbering is an append, so it refuses where an append refuses: the
// literal's own explicit key has already taken the last integer index.
try {
    array<string> $full = ["9223372036854775807" => "z", ...$a];
    echo Core\Json::encode($full), "\n";
} catch (Throwable $occupied) {
    echo "refused: ", $occupied->message, "\n";
}
--ORACLE--
<?php
$a = ["x", "y"];
$b = ["p", "q"];
echo json_encode([...$a, ...$b]), "\n";

$m = ["one" => "1", "two" => "2"];
echo json_encode([...$m, "three" => "3"]), "\n";
echo json_encode([...$m, "one" => "9"]), "\n";
echo json_encode([...$m, ...$m]), "\n";

echo json_encode(["head", ...$a, "tail"]), "\n";
echo json_encode([...$a, "k" => "v", "tail"]), "\n";

$pad = ["08" => "p", "8" => "e"];
echo json_encode([...$pad]), "\n";
$neg = ["-5" => "n"];
echo json_encode([...$neg]), "\n";
$big = ["9223372036854775807" => "m"];
echo json_encode([...$big]), "\n";

$mix = ["a" => 1, "0" => 2, "b" => 3];
echo json_encode([...$mix, ...$mix]), "\n";

echo json_encode([...[]]), "\n";

try {
    $full = [9223372036854775807 => "z", ...$a];
    echo json_encode($full), "\n";
} catch (Throwable $occupied) {
    echo "refused: ", $occupied->getMessage(), "\n";
}
