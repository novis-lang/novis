--TEST--
Indexing an array of arrays, and copying an inner row out, agree with PHP
--FILE--
<?mwl
array<array<int>> $grid = [[1, 2], [3, 4]];
echo $grid[0][0], "|", $grid[0][1], "|", $grid[1][0], "|", $grid[1][1], "|\n";

array<int> $row = $grid[1];
echo $row[0], "|", $row[1], "|\n";

$row[0] = 99;
echo $grid[1][0], "|", $row[0], "|\n";
--ORACLE--
<?php
$grid = [[1, 2], [3, 4]];
echo $grid[0][0], "|", $grid[0][1], "|", $grid[1][0], "|", $grid[1][1], "|\n";

$row = $grid[1];
echo $row[0], "|", $row[1], "|\n";

$row[0] = 99;
echo $grid[1][0], "|", $row[0], "|\n";
