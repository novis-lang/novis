--TEST--
a `&$x` argument's copy-back lands at the call, exactly as PHP's does: a read sequenced after the call in the same statement sees the write, in a concatenation, a nested call, a condition, an array literal, a `while` header and through a property holder — ADR README § *Decisions taken at project start*, lowered by `mwl_ir::lower::Lowering::pending_refs`
--FILE--
<?mwl
final class Adder {
    public static function bump(int &$slot): int {
        $slot = $slot + 1;

        return $slot;
    }

    public static function sum(int $a, int $b): int {
        return $a + $b;
    }
}

final class Box {
    public string $tag = "a";

    public static function grow(string &$cell, string $piece): string {
        $cell = $cell . $piece;

        return $cell;
    }
}

// Every read below is sequenced to the *right* of the call it observes. A read
// to its left is deliberately absent: PHP's own manual leaves an expression's
// operand order undefined, and `$n + Adder::bump($n)` is where the two answer
// differently — PHP reads the left operand at the `ADD`, after the call, while
// MWL evaluates a binary operator's operands strictly left to right. That is
// not a divergence to pin, and `mwl_ir::lower::Lowering::pending_refs` is where
// it is written down.
int $n = 5;
echo Adder::bump($n), " ", $n, "\n";

// The concatenation the rule's own doc comment names.
int $d = 5;
echo Adder::bump($d) . " then " . $d, "\n";

// Two calls in one statement: the second stages the holder afresh, so it reads
// what the first wrote back.
int $m = 5;
echo Adder::bump($m), " ", Adder::bump($m), " ", $m, "\n";

// Calls nest, and the inner copy-back lands at the inner call: the outer call's
// second argument reads 6, not the 5 the statement started with.
int $k = 5;
echo Adder::sum(Adder::bump($k), $k), "\n";

// A condition is an expression position, not a statement boundary.
int $c = 5;
if (Adder::bump($c) == 6) {
    echo $c, "\n";
}

// So is an array-literal element, and the element to its right sees the write
// while the literal is still being built.
int $e = 5;
array<int> $xs = [Adder::bump($e), $e];
echo $xs["0"], " ", $xs["1"], "\n";

// A `while` header runs its call once per iteration, so the loop terminates on
// the callee's writes rather than on anything the body does.
int $w = 0;
int $steps = 0;
while (Adder::bump($w) < 4) {
    $steps = $steps + $w;
}
echo $w, " ", $steps, "\n";

// The second holder kind: the copy-back re-points a property of the receiver
// the argument was read through.
var $b = new Box();
echo Box::grow($b->tag, "z"), " ", $b->tag, "\n";
--ORACLE--
<?php
final class Adder {
    public static function bump(int &$slot): int {
        $slot = $slot + 1;

        return $slot;
    }

    public static function sum(int $a, int $b): int {
        return $a + $b;
    }
}

final class Box {
    public string $tag = "a";

    public static function grow(string &$cell, string $piece): string {
        $cell = $cell . $piece;

        return $cell;
    }
}

$n = 5;
echo Adder::bump($n), " ", $n, "\n";

$d = 5;
echo Adder::bump($d) . " then " . $d, "\n";

$m = 5;
echo Adder::bump($m), " ", Adder::bump($m), " ", $m, "\n";

$k = 5;
echo Adder::sum(Adder::bump($k), $k), "\n";

$c = 5;
if (Adder::bump($c) == 6) {
    echo $c, "\n";
}

$e = 5;
$xs = [Adder::bump($e), $e];
echo $xs[0], " ", $xs[1], "\n";

$w = 0;
$steps = 0;
while (Adder::bump($w) < 4) {
    $steps = $steps + $w;
}
echo $w, " ", $steps, "\n";

$b = new Box();
echo Box::grow($b->tag, "z"), " ", $b->tag, "\n";
