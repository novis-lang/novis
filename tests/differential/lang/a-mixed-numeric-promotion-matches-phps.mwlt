--TEST--
A mixed `int`/`uint`/`float` operand pair produces PHP's own value and PHP's own ordering — ADR 0007 § 4
--FILE--
<?mwl
// `bool as string` renders `false` as the empty string, so a predicate is
// rendered through a branch rather than a conversion (the playbook owns that
// trap). A case is top-level statements, so the helper is a static method.
final class Show {
    public static function yn(bool $b): string {
        if ($b) {
            return "y";
        }
        return "n";
    }
}

int $n = 3;
uint $u = 4;
float $f = 2.5;
float $six = 6.0;

echo "int+float=", $n + $f, "\n";
echo "float+int=", $f + $n, "\n";
echo "uint+float=", $u + $f, "\n";
echo "float-int=", $f - $n, "\n";
echo "int*float=", $n * $f, "\n";
echo "float/int=", $six / $n, "\n";
echo "int/float=", $n / $f, "\n";

echo "lt=", Show::yn($n < $f), " gt=", Show::yn($n > $f), " le=", Show::yn($n <= $f), " ge=", Show::yn($n >= $f), "\n";
echo "flt=", Show::yn($f < $n), " fgt=", Show::yn($f > $n), " fle=", Show::yn($f <= $n), " fge=", Show::yn($f >= $n), "\n";
echo "ult=", Show::yn($u < $f), " uge=", Show::yn($u >= $f), "\n";

// The integer that is exactly the float: `<` and `>` are both false, and both
// inclusive forms are true.
float $three = 3.0;
echo "eq-lt=", Show::yn($n < $three), " eq-le=", Show::yn($n <= $three), " eq-ge=", Show::yn($n >= $three), " eq-gt=", Show::yn($n > $three), "\n";

// Past 2^53, where widening the integer into the float would lose the answer.
// MWL compares over the mathematical integers instead, and this line is why:
// PHP answers an ordering here, so the widening's throw must not be reached.
int $big = 9007199254740993;
echo "big-lt=", Show::yn($big < $f), " big-gt=", Show::yn($big > $f), "\n";
--ORACLE--
<?php
final class Show {
    public static function yn(bool $b): string {
        if ($b) {
            return "y";
        }
        return "n";
    }
}

$n = 3;
$u = 4;
$f = 2.5;
$six = 6.0;

echo "int+float=", $n + $f, "\n";
echo "float+int=", $f + $n, "\n";
echo "uint+float=", $u + $f, "\n";
echo "float-int=", $f - $n, "\n";
echo "int*float=", $n * $f, "\n";
echo "float/int=", $six / $n, "\n";
echo "int/float=", $n / $f, "\n";

echo "lt=", Show::yn($n < $f), " gt=", Show::yn($n > $f), " le=", Show::yn($n <= $f), " ge=", Show::yn($n >= $f), "\n";
echo "flt=", Show::yn($f < $n), " fgt=", Show::yn($f > $n), " fle=", Show::yn($f <= $n), " fge=", Show::yn($f >= $n), "\n";
echo "ult=", Show::yn($u < $f), " uge=", Show::yn($u >= $f), "\n";

$three = 3.0;
echo "eq-lt=", Show::yn($n < $three), " eq-le=", Show::yn($n <= $three), " eq-ge=", Show::yn($n >= $three), " eq-gt=", Show::yn($n > $three), "\n";

$big = 9007199254740993;
echo "big-lt=", Show::yn($big < $f), " big-gt=", Show::yn($big > $f), "\n";
