--TEST--
A `static` property has one storage, reached identically through the declaring class, a subclass, `self::` and `parent::`, and a `string` one survives being assigned from itself — ADR 0022 § 2 and `docs/adr/README.md` § *Decisions taken at project start*
--FILE--
<?mwl
class Base {
    // Every static declares its initializer: there is no constructor that
    // could give one to a storage that is not any instance's.
    public static int $total = 0;
    public static string $label = "base";

    // `self::` names the declaring class, which is what the checker resolves
    // every spelling of this storage to.
    public static function bump(): int {
        self::$total = self::$total + 1;
        return self::$total;
    }
}

// A subclass that does *not* redeclare shares the one slot — `Sub::$total`
// and `Base::$total` are the same storage, and `parent::` reaches the same
// method over it.
class Sub extends Base {
    public static function twice(): int {
        Base::bump();
        return parent::bump();
    }
}

echo Base::bump(), "\n";
echo Sub::twice(), "\n";
echo Sub::$total, "\n";

// A refcounted slot: the write releases what the slot held and retains what
// lands in it, so appending to it and then assigning it *to itself* both
// leave exactly one owner.
Base::$label = Base::$label . "!";
echo Base::$label, "\n";
Base::$label = Base::$label;
echo Base::$label, "\n";

// A write from outside any method, against the same storage the methods used.
Base::$total = Base::$total + 10;
echo Base::$total, "\n";
--ORACLE--
<?php
class Base {
    public static int $total = 0;
    public static string $label = "base";

    public static function bump(): int {
        self::$total = self::$total + 1;
        return self::$total;
    }
}

class Sub extends Base {
    public static function twice(): int {
        Base::bump();
        return parent::bump();
    }
}

echo Base::bump(), "\n";
echo Sub::twice(), "\n";
echo Sub::$total, "\n";

Base::$label = Base::$label . "!";
echo Base::$label, "\n";
Base::$label = Base::$label;
echo Base::$label, "\n";

Base::$total = Base::$total + 10;
echo Base::$total, "\n";
