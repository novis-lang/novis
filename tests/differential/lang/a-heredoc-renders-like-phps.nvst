--TEST--
a heredoc interpolates and a nowdoc does not, exactly as in PHP
--FILE--
<?nvs
string $who = "world";
int $count = 2;

string $doc = <<<TXT
hello $who
you have $count messages
TXT;
echo $doc, "\n";

string $raw = <<<'TXT'
hello $who
no \t escape here
TXT;
echo $raw, "\n";
--ORACLE--
<?php
$who = "world";
$count = 2;

$doc = <<<TXT
hello $who
you have $count messages
TXT;
echo $doc, "\n";

$raw = <<<'TXT'
hello $who
no \t escape here
TXT;
echo $raw, "\n";
