--TEST--
`f(name: v)` and `f(...$xs)` match PHP: a name fills its own parameter while evaluation stays in written order, and unpacking renumbers integer-looking keys, preserves string ones, concatenates two spreads and leaves the subject alone
--FILE--
<?nvs
final class Fmt {
    public static function line(string $body, string $prefix = "> ", string $suffix = "!"): string {
        return $prefix . $body . $suffix;
    }
    public static function tap(string $v): string {
        echo "tap:", $v, " ";
        return $v;
    }
    public static function pair(string $a, string $b): string {
        return $a . "/" . $b;
    }
}

echo Fmt::line("a"), "\n";
echo Fmt::line("a", suffix: "?"), "\n";
echo Fmt::line(suffix: "?", prefix: "* ", body: "a"), "\n";
// Written order for the side effects, parameter order for the values.
echo Fmt::pair(b: Fmt::tap("B"), a: Fmt::tap("A")), "\n";

final class Join {
    public static function all(string $sep, string ...$parts): string {
        string $out = "";
        foreach ($parts as string $p) {
            $out = $out . $p . $sep;
        }
        return $out;
    }
    // The tail as the callee actually sees it: one array, keys and all.
    public static function shape(string ...$parts): string {
        return Core\Json::encode($parts);
    }
}

array<string> $xs = ["a", "b"];
array<string> $ys = ["c"];

echo Join::all("-"), "\n";
echo Join::all("-", ...$xs), "\n";
// Two spreads concatenate, because a renumbered key continues the tail's own
// append counter rather than colliding with what is already there.
echo Join::all("-", ...$xs, ...$ys), "\n";
// A written-out argument keeps its own place; a spread only ever appends.
echo Join::all("-", "z", ...$xs), "\n";
// The subject is copied, not consumed.
echo Core\Json::encode($xs), "\n";

echo Join::shape(...$xs), "\n";
// A string key is preserved in place — PHP's unpacking calls it a named
// argument, finds no parameter of that name, and lands it in the variadic
// under the same key.
echo Join::shape(...["k" => "v"]), "\n";
echo Join::shape(...["k" => "v", "j" => "w"]), "\n";
echo Join::shape("a", ...["k" => "v"]), "\n";
// An integer-looking key is renumbered under the tail's append counter, so
// the subject's own numbering is not what arrives.
echo Join::shape(...["3" => "x", "0" => "y"]), "\n";
--ORACLE--
<?php
final class Fmt {
    public static function line(string $body, string $prefix = "> ", string $suffix = "!"): string {
        return $prefix . $body . $suffix;
    }
    public static function tap(string $v): string {
        echo "tap:", $v, " ";
        return $v;
    }
    public static function pair(string $a, string $b): string {
        return $a . "/" . $b;
    }
}

echo Fmt::line("a"), "\n";
echo Fmt::line("a", suffix: "?"), "\n";
echo Fmt::line(suffix: "?", prefix: "* ", body: "a"), "\n";
echo Fmt::pair(b: Fmt::tap("B"), a: Fmt::tap("A")), "\n";

final class Join {
    public static function all(string $sep, string ...$parts): string {
        $out = "";
        foreach ($parts as $p) {
            $out = $out . $p . $sep;
        }
        return $out;
    }
    public static function shape(string ...$parts): string {
        return json_encode($parts);
    }
}

$xs = ["a", "b"];
$ys = ["c"];

echo Join::all("-"), "\n";
echo Join::all("-", ...$xs), "\n";
echo Join::all("-", ...$xs, ...$ys), "\n";
echo Join::all("-", "z", ...$xs), "\n";
echo json_encode($xs), "\n";

echo Join::shape(...$xs), "\n";
echo Join::shape(...["k" => "v"]), "\n";
echo Join::shape(...["k" => "v", "j" => "w"]), "\n";
echo Join::shape("a", ...["k" => "v"]), "\n";
echo Join::shape(...["3" => "x", "0" => "y"]), "\n";
