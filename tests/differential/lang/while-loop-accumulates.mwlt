--TEST--
a `while` loop over integers accumulates exactly what PHP's does
--FILE--
<?mwl
class Bench {
    public static function sum(int $n): int {
        var $total = 0;
        var $i = 0;
        while ($i < $n) {
            $total = $total + $i * 2 - 1;
            $i = $i + 1;
        }
        return $total;
    }
}
echo Bench::sum(0), "\n";
echo Bench::sum(1), "\n";
echo Bench::sum(1000), "\n";
--ORACLE--
<?php
class Bench {
    public static function sum(int $n): int {
        $total = 0;
        $i = 0;
        while ($i < $n) {
            $total = $total + $i * 2 - 1;
            $i = $i + 1;
        }
        return $total;
    }
}
echo Bench::sum(0), "\n";
echo Bench::sum(1), "\n";
echo Bench::sum(1000), "\n";
