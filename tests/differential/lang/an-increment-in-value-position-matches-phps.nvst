--TEST--
`$x++` and `--$x` used as a value agree with PHP on which of the two numbers they answer, and on where the write lands — ADR 0007 §§ 4 and 5
--FILE--
<?nvs
final class Box { public int $n = 0; }
final class Twice {
    public static function of(int $n): int {
        return $n * 2;
    }
}

// ADR 0007 § 4's `± 1`: the postfix form answers what was there, the prefix
// form what was written.
int $a = 5;
echo $a++, " ", $a, " ", ++$a, " ", $a--, " ", --$a, "\n";

// Two increments of one local in one expression, so the order the operands
// are evaluated in is what the answer reports.
int $b = 0;
int $c = $b++ + $b++;
echo $c, " ", $b, "\n";

// A property and an array element are targets too, and the write goes to the
// slot rather than to a copy.
Box $box = new Box();
echo $box->n++, " ", ++$box->n, " ", $box->n, "\n";
array<int> $xs = [10, 20];
echo $xs["0"]++, " ", $xs["0"], " ", Core\Json::encode($xs), "\n";

// A conditionally evaluated operand runs the increment exactly when its own
// branch does — the falsy `&&`, the untaken ternary arm, a present `??`.
int $k = 0;
bool $no = false;
if ($no && ($k++ > 0)) {
    echo "unreachable\n";
}
int $t = 0;
int $picked = $no ? $t++ : $t--;
?int $absent = null;
int $s = 0;
int $filled = $absent ?? $s++;
int $w = 0;
int $arm = match (1) { 1 => $w++, default => 42 };
echo $k, " ", $picked, " ", $t, " ", $filled, " ", $s, " ", $arm, " ", $w, "\n";

// The counter of a `while` header, which is the one place a rebinding has to
// reach the loop's own carried value rather than the value it was entered
// with.
int $i = 0;
while ($i++ < 3) {
    echo "i=", $i, " ";
}
echo "end=", $i, "\n";

// The same rebinding one level down inside a loop body, written into another
// assignment's right-hand side.
int $acc = 0;
int $step = 0;
foreach ($xs as int $x) {
    $acc = $acc + $step++;
}
echo $acc, " ", $step, "\n";

// A call argument: the callee sees the old value and the caller keeps the new
// one.
int $p = 3;
echo Twice::of($p++), " ", $p, "\n";

// `float` increments by one whole unit, exactly as PHP's does.
float $f = 1.5;
echo $f++, " ", $f, " ", --$f, "\n";
--ORACLE--
<?php
class Box { public $n = 0; }
function twice_of($n) { return $n * 2; }

$a = 5;
echo $a++, " ", $a, " ", ++$a, " ", $a--, " ", --$a, "\n";

$b = 0;
$c = $b++ + $b++;
echo $c, " ", $b, "\n";

$box = new Box();
echo $box->n++, " ", ++$box->n, " ", $box->n, "\n";
$xs = [10, 20];
echo $xs[0]++, " ", $xs[0], " ", json_encode($xs), "\n";

$k = 0;
$no = false;
if ($no && ($k++ > 0)) {
    echo "unreachable\n";
}
$t = 0;
$picked = $no ? $t++ : $t--;
$absent = null;
$s = 0;
$filled = $absent ?? $s++;
$w = 0;
$arm = match (1) { 1 => $w++, default => 42 };
echo $k, " ", $picked, " ", $t, " ", $filled, " ", $s, " ", $arm, " ", $w, "\n";

$i = 0;
while ($i++ < 3) {
    echo "i=", $i, " ";
}
echo "end=", $i, "\n";

$acc = 0;
$step = 0;
foreach ($xs as $x) {
    $acc = $acc + $step++;
}
echo $acc, " ", $step, "\n";

$p = 3;
echo twice_of($p++), " ", $p, "\n";

$f = 1.5;
echo $f++, " ", $f, " ", --$f, "\n";
