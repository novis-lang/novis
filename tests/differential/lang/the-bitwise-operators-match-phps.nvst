--TEST--
`& | ^ ~ << >>` answer PHP's own values, including the two rules a machine shift does not give — ADR 0007 § 4
--FILE--
<?nvs
int $six = 6;
int $three = 3;
int $one = 1;
int $zero = 0;
int $big = 9223372036854775807;
int $min = 0 - $big - $one;

echo "and=", $six & $three, "\n";
echo "or=", $six | $three, "\n";
echo "xor=", $six ^ $three, "\n";
echo "not=", ~$zero, "\n";
echo "notmax=", ~$big, "\n";

// The two rules the machine does not give: an `ishl`/`sshr` masks its count to
// six bits, so `1 << 64` would be `1`, and PHP answers `0`. An arithmetic
// `>>` past the width fills with the sign bit instead.
echo "shl=", $one << $three, "\n";
echo "shl63=", $one << 63, "\n";
echo "shl64=", $one << 64, "\n";
echo "shl100=", $one << 100, "\n";
echo "shr=", $big >> $three, "\n";
echo "shrneg=", $min >> $one, "\n";
echo "shr64=", $one >> 64, "\n";
echo "shrneg64=", (0 - $one) >> 64, "\n";
echo "shr0=", $six >> $zero, "\n";

// A negative count is the one refusal, and PHP raises the same class with the
// same message for both directions.
try {
    int $bad = $one << (0 - $one);
    echo "no throw\n";
} catch (Throwable $shl) {
    echo "shlneg: ", $shl->message, "\n";
}
try {
    int $worse = $one >> (0 - $one);
    echo "no throw\n";
} catch (Throwable $shr) {
    echo "shrneg: ", $shr->message, "\n";
}
--ORACLE--
<?php
$six = 6;
$three = 3;
$one = 1;
$zero = 0;
$big = PHP_INT_MAX;
$min = 0 - $big - $one;

echo "and=", $six & $three, "\n";
echo "or=", $six | $three, "\n";
echo "xor=", $six ^ $three, "\n";
echo "not=", ~$zero, "\n";
echo "notmax=", ~$big, "\n";

echo "shl=", $one << $three, "\n";
echo "shl63=", $one << 63, "\n";
echo "shl64=", $one << 64, "\n";
echo "shl100=", $one << 100, "\n";
echo "shr=", $big >> $three, "\n";
echo "shrneg=", $min >> $one, "\n";
echo "shr64=", $one >> 64, "\n";
echo "shrneg64=", (0 - $one) >> 64, "\n";
echo "shr0=", $six >> $zero, "\n";

try {
    $bad = $one << (0 - $one);
    echo "no throw\n";
} catch (Throwable $shl) {
    echo "shlneg: ", $shl->getMessage(), "\n";
}
try {
    $worse = $one >> (0 - $one);
    echo "no throw\n";
} catch (Throwable $shr) {
    echo "shrneg: ", $shr->getMessage(), "\n";
}
