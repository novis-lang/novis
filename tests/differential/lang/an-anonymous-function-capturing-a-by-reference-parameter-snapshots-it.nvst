--TEST--
An anonymous function capturing an enclosing `inout $x` parameter snapshots the cell's value where the anonymous function is written, agrees with PHP either side of a later write to it, and still answers after the call that staged the cell returned — `rule:types/implicit-capture`
--FILE--
<?nvs
final class Snap {
    // Three anonymous functions over the same two by-reference cells: one written before
    // `$s` is rewritten and one after, so a capture that aliased the cell
    // rather than copying it would print the same line twice. `$n` is the
    // non-refcounted twin, snapshotted between its own two values.
    public static function make(
        inout string $s,
        inout int $n,
    ): array<callable(string, string): string> {
        callable(string, string): string $before =
            fn (string $acc, string $x): string => $acc . $x . $s;
        $s = $s . "-late";
        $n = $n + 1;
        callable(string, string): string $after =
            fn (string $acc, string $x): string => $acc . $x . $s;
        callable(string, string): string $counted =
            fn (string $acc, string $x): string => $acc . $x . ($n as string);
        return [$before, $after, $counted];
    }
}

string $m = "one";
int $k = 40;
array<callable(string, string): string> $held = [];
// The caller's own cells are still written back through, unchanged by the
// captures taken out of them.
$held = Snap::make(inout $m, inout $k);
echo $m, " ", $k, "\n";

// Every callable is invoked here, after the frame that staged both cells has
// returned — the whole point of the snapshot.
array<string> $seed = ["|"];
foreach ($held as callable(string, string): string $f) {
    echo Core\Arr::reduce($seed, $f, ">"), "\n";
}
--ORACLE--
<?php
function make(string &$s, int &$n): array {
    $before = fn(string $acc, string $x): string => $acc . $x . $s;
    $s = $s . "-late";
    $n = $n + 1;
    $after = fn(string $acc, string $x): string => $acc . $x . $s;
    $counted = fn(string $acc, string $x): string => $acc . $x . (string)$n;
    return [$before, $after, $counted];
}

$m = "one";
$k = 40;
$held = make($m, $k);
echo $m, " ", $k, "\n";

$seed = ["|"];
foreach ($held as $f) {
    echo array_reduce($seed, $f, ">"), "\n";
}
