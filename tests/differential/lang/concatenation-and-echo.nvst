--TEST--
`.` and a comma-separated `echo` render an int exactly as PHP does
--FILE--
<?nvs
echo "n=" . 41 . "\n";
echo "a", "b", 1, 2, "\n";
echo "" . "-" . "" . "\n";
echo 0 . "\n";
echo -7 . "\n";
--ORACLE--
<?php
echo "n=" . 41 . "\n";
echo "a", "b", 1, 2, "\n";
echo "" . "-" . "" . "\n";
echo 0 . "\n";
echo -7 . "\n";
