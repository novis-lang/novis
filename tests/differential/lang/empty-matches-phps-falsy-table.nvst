--TEST--
`empty($x)` is `!$x` over any expression, and it agrees with PHP on every row of the falsy table, on an absent element and on when the operand runs — `rule:expressions/truthy-table`, `rule:classes/unset-is-refused-on-a-property`
--FILE--
<?nvs
final class Show {
    public static function of(bool $b): string {
        if ($b) { return "T"; }
        return "F";
    }
}
final class Trace {
    public static function key(string $k): string {
        echo "[", $k, "]";
        return $k;
    }
}
enum Rank: int { Bronze = 0, Gold = 3 }
final class Bag { public int $n = 0; }

// `rule:expressions/truthy-table`'s table, negated. Only "" and "0" are falsy strings — " " and
// "0.0" are not, which is the row a hand-written `$s == ""` gets wrong.
echo "str ", Show::of(empty("")), Show::of(empty("0")), Show::of(empty("a")),
     Show::of(empty(" ")), Show::of(empty("0.0")), "\n";
echo "num ", Show::of(empty(0)), Show::of(empty(1)), Show::of(empty(0.0)),
     Show::of(empty(1.5)), "\n";
echo "nul ", Show::of(empty(null)), "\n";
echo "arr ", Show::of(empty([])), Show::of(empty([0])), "\n";

// `rule:enums/truthiness`: an object and an enum case are truthy whatever they hold, so
// `Rank::Bronze` is not empty despite being backed by `0`.
echo "obj ", Show::of(empty(new Bag())), Show::of(empty(Rank::Bronze)),
     Show::of(empty(Rank::Gold)), "\n";

string $s = "";
string $t = "x";
int $z = 0;
array<string> $rows = [];
echo "loc ", Show::of(empty($s)), Show::of(empty($t)), Show::of(empty($z)),
     Show::of(empty($rows)), "\n";

// An absent key answers `true` rather than throwing (`rule:php-migration/every-divergence-is-deliberate-and-listed` row 11's
// exception), and a present `"0"` answers `true` for the falsy-table reason
// instead — the two are indistinguishable here, exactly as they are in PHP.
$rows["k"] = "v";
$rows["zero"] = "0";
echo "elem ", Show::of(empty($rows)), Show::of(empty($rows["k"])),
     Show::of(empty($rows["zero"])), Show::of(empty($rows["nope"])), "\n";

?string $m = null;
?string $p = "x";
?array<string> $q = null;
echo "opt ", Show::of(empty($m)), Show::of(empty($p)), Show::of(empty($q["k"])), "\n";

Bag $bag = new Bag();
echo "prop ", Show::of(empty($bag->n));
$bag->n = 5;
echo Show::of(empty($bag->n)), "\n";

// The operand is evaluated, exactly once, in value position and in statement
// position alike.
echo "eval ";
echo Show::of(empty($rows[Trace::key("k")])), "\n";
echo "stmt ";
empty($rows[Trace::key("nope")]);
echo "\n";

// An ordinary `bool`, so it composes and short-circuits like any other.
if (empty($s) && !empty($t)) { echo "compose\n"; }
bool $b = empty($s);
echo "bind ", Show::of($b), "\n";

// A fresh producer nothing else names is read by the test and released.
echo "fresh ", Show::of(empty(Trace::key(""))), Show::of(empty(Trace::key("z"))), "\n";
--ORACLE--
<?php
function show_of($b) { return $b ? "T" : "F"; }
function trace_key($k) { echo "[", $k, "]"; return $k; }
enum Rank: int { case Bronze = 0; case Gold = 3; }
class Bag { public $n = 0; }

echo "str ", show_of(empty("")), show_of(empty("0")), show_of(empty("a")),
     show_of(empty(" ")), show_of(empty("0.0")), "\n";
echo "num ", show_of(empty(0)), show_of(empty(1)), show_of(empty(0.0)),
     show_of(empty(1.5)), "\n";
echo "nul ", show_of(empty(null)), "\n";
echo "arr ", show_of(empty([])), show_of(empty([0])), "\n";

echo "obj ", show_of(empty(new Bag())), show_of(empty(Rank::Bronze)),
     show_of(empty(Rank::Gold)), "\n";

$s = "";
$t = "x";
$z = 0;
$rows = [];
echo "loc ", show_of(empty($s)), show_of(empty($t)), show_of(empty($z)),
     show_of(empty($rows)), "\n";

$rows["k"] = "v";
$rows["zero"] = "0";
echo "elem ", show_of(empty($rows)), show_of(empty($rows["k"])),
     show_of(empty($rows["zero"])), show_of(empty($rows["nope"])), "\n";

$m = null;
$p = "x";
$q = null;
echo "opt ", show_of(empty($m)), show_of(empty($p)), show_of(empty($q["k"])), "\n";

$bag = new Bag();
echo "prop ", show_of(empty($bag->n));
$bag->n = 5;
echo show_of(empty($bag->n)), "\n";

echo "eval ";
echo show_of(empty($rows[trace_key("k")])), "\n";
echo "stmt ";
empty($rows[trace_key("nope")]);
echo "\n";

if (empty($s) && !empty($t)) { echo "compose\n"; }
$b = empty($s);
echo "bind ", show_of($b), "\n";

echo "fresh ", show_of(empty(trace_key(""))), show_of(empty(trace_key("z"))), "\n";
