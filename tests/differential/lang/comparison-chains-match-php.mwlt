--TEST--
`<`, `>`, `<=`, `>=`, `===` and `!==` over ints and strings render as PHP renders them
--FILE--
<?mwl
echo 1 < 2, "|", 2 < 1, "|", 2 <= 2, "|", 2 >= 3, "|\n";
echo 5 > 4, "|", 4 > 5, "|\n";
echo "a" === "a", "|", "a" === "b", "|", "a" !== "b", "|\n";
echo 3 === 3, "|", 3 !== 3, "|\n";
echo (1 < 2) as string, "|", (1 > 2) as string, "|\n";
--ORACLE--
<?php
echo 1 < 2, "|", 2 < 1, "|", 2 <= 2, "|", 2 >= 3, "|\n";
echo 5 > 4, "|", 4 > 5, "|\n";
echo "a" === "a", "|", "a" === "b", "|", "a" !== "b", "|\n";
echo 3 === 3, "|", 3 !== 3, "|\n";
echo (string) (1 < 2), "|", (string) (1 > 2), "|\n";
