--TEST--
`"{$name}s"`, `"\$name"` and a single-quoted `'$name'` all render as PHP renders them
--FILE--
<?nvs
string $name = "world";
int $count = 3;

echo "hi $name, $count times\n";
echo "brace {$name}s\n";
echo "{$count}rd\n";
echo "a $name-$count b\n";
echo "escaped: \$name\n";
echo 'single $name stays literal', "\n";
--ORACLE--
<?php
$name = "world";
$count = 3;

echo "hi $name, $count times\n";
echo "brace {$name}s\n";
echo "{$count}rd\n";
echo "a $name-$count b\n";
echo "escaped: \$name\n";
echo 'single $name stays literal', "\n";
