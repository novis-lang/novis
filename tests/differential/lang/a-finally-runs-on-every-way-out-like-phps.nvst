--TEST--
A finally block runs after normal completion, after a caught throw, before a return leaves its frame and on the way out of a loop, in the order PHP runs them
--FILE--
<?nvs
// `finally` is the one control-flow construct whose whole content is *ordering*,
// so every row here prints markers rather than a result: what is being compared
// is the sequence, and a value alone would not show whether the block ran before
// or after the exit it was attached to. Four ways out of a `try` are asked
// about, because an implementation that hooked only the throwing one is the
// plausible wrong version — the other three are the ones a program relies on
// without noticing.
final class Leaves {
    // A `return` from inside the `try`: the value is computed first, the
    // `finally` runs next, and only then does the frame answer — so the marker
    // below is printed *before* the caller prints the value it returned.
    public static function returning(): string {
        try {
            echo "try ";
            return "value";
        } finally {
            echo "finally ";
        }
    }

    // A throw that no `catch` here handles still leaves through the block, so
    // the marker is printed on the way past rather than skipped.
    public static function throwing(): string {
        try {
            echo "try ";
            throw new LogicError("boom");
        } finally {
            echo "finally ";
        }
    }
}

// Nothing went wrong: the block still runs, after the body and before whatever
// follows the statement.
try {
    echo "body ";
} finally {
    echo "finally ";
}
echo "after\n";

// A throw the sibling `catch` handles: body, handler, block — in that order,
// and the handler runs before the block rather than after it.
try {
    echo "body ";
    throw new LogicError("caught");
} catch (Throwable $e) {
    echo "caught(", $e->message, ") ";
} finally {
    echo "finally ";
}
echo "after\n";

// The `return` row, read at the call site: `finally` is printed by the callee
// before `value` is printed here.
echo Leaves::returning(), "\n";

// The throw row: the callee's block runs on the way out, and the handler here
// runs after it — the two frames' order, not one frame's.
try {
    echo Leaves::throwing(), "\n";
} catch (Throwable $out) {
    echo "outer(", $out->message, ")\n";
}

// `break` and `continue` are exits too. The block runs once per pass whichever
// of the two ended it, so the marker count is the loop's count and not the
// number of passes that fell off the end of the body.
int $i = 0;
while ($i < 4) {
    $i = $i + 1;
    try {
        if ($i == 2) {
            continue;
        }
        if ($i == 3) {
            break;
        }
        echo "pass", $i, " ";
    } finally {
        echo "f", $i, " ";
    }
}
echo "left=", $i, "\n";
--ORACLE--
<?php
class Leaves {
    public static function returning(): string {
        try {
            echo "try ";
            return "value";
        } finally {
            echo "finally ";
        }
    }

    public static function throwing(): string {
        try {
            echo "try ";
            throw new LogicException("boom");
        } finally {
            echo "finally ";
        }
    }
}

try {
    echo "body ";
} finally {
    echo "finally ";
}
echo "after\n";

try {
    echo "body ";
    throw new LogicException("caught");
} catch (Throwable $e) {
    echo "caught(", $e->getMessage(), ") ";
} finally {
    echo "finally ";
}
echo "after\n";

echo Leaves::returning(), "\n";

try {
    echo Leaves::throwing(), "\n";
} catch (Throwable $out) {
    echo "outer(", $out->getMessage(), ")\n";
}

$i = 0;
while ($i < 4) {
    $i = $i + 1;
    try {
        if ($i == 2) {
            continue;
        }
        if ($i == 3) {
            break;
        }
        echo "pass", $i, " ";
    } finally {
        echo "f", $i, " ";
    }
}
echo "left=", $i, "\n";
