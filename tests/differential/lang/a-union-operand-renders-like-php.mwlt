--TEST--
Rendering a value whose type is only known at runtime gives PHP's own answer for every scalar and for `null`
--FILE--
<?mwl
mixed $m = 5;
echo "int=", $m, "\n";
$m = 0 - 7;
echo "neg=", $m, "\n";
$m = 1.5;
echo "float=", $m, "\n";
$m = 2.0;
echo "whole=", $m, "\n";
$m = true;
echo "t=" . $m . "|";
$m = false;
echo "f=" . $m . "|\n";
$m = "text";
echo "str=", $m, "\n";
$m = "";
echo "empty=[" . $m . "]\n";
$m = null;
echo "null=[" . $m . "]\n";

// Concatenation of two runtime-tagged operands, and the explicit spelling of
// the same conversion.
mixed $left = 1;
mixed $right = 2.5;
echo "both=" . $left . $right . "\n";
echo "as=" . ($left as string) . "\n";
--ORACLE--
<?php
$m = 5;
echo "int=", $m, "\n";
$m = 0 - 7;
echo "neg=", $m, "\n";
$m = 1.5;
echo "float=", $m, "\n";
$m = 2.0;
echo "whole=", $m, "\n";
$m = true;
echo "t=" . $m . "|";
$m = false;
echo "f=" . $m . "|\n";
$m = "text";
echo "str=", $m, "\n";
$m = "";
echo "empty=[" . $m . "]\n";
$m = null;
echo "null=[" . $m . "]\n";

$left = 1;
$right = 2.5;
echo "both=" . $left . $right . "\n";
echo "as=" . (string) $left . "\n";
