--TEST--
`echo` of a comparison prints `1` or the empty string, as PHP does
--FILE--
<?mwl
echo 1 < 2, "|", 2 < 1, "|\n";
echo 2 == 2, "|", 2 != 2, "|\n";
echo 3 >= 3, "|", 3 > 3, "|\n";
--ORACLE--
<?php
echo 1 < 2, "|", 2 < 1, "|\n";
echo 2 === 2, "|", 2 !== 2, "|\n";
echo 3 >= 3, "|", 3 > 3, "|\n";
