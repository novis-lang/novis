--TEST--
Two nested `while` loops with an inner `break` produce PHP's exact sequence
--FILE--
<?nvs
int $i = 0;
int $total = 0;
while ($i < 4) {
    int $j = 0;
    while ($j < 4) {
        $total = $total + $i * $j;
        $j = $j + 1;
    }
    $i = $i + 1;
}
echo $total, "\n";

int $row = 0;
while ($row < 3) {
    int $col = 0;
    while ($col < 5) {
        if ($col > $row) {
            break;
        }
        echo $row, $col, ";";
        $col = $col + 1;
    }
    $row = $row + 1;
}
echo "\n";
--ORACLE--
<?php
$i = 0;
$total = 0;
while ($i < 4) {
    $j = 0;
    while ($j < 4) {
        $total = $total + $i * $j;
        $j = $j + 1;
    }
    $i = $i + 1;
}
echo $total, "\n";

$row = 0;
while ($row < 3) {
    $col = 0;
    while ($col < 5) {
        if ($col > $row) {
            break;
        }
        echo $row, $col, ";";
        $col = $col + 1;
    }
    $row = $row + 1;
}
echo "\n";
