--TEST--
a list's keys are strings in MWL and integers in PHP, and both print the same decimal digits
--FILE--
<?mwl
array<string> $words = ["zero", "one", "two"];

foreach ($words as string $index => string $word) {
    echo $index, ":", $word, "\n";
}

$words[3] = "three";
echo Core\Str::join($words, ","), "\n";

var $keys = "";
foreach ($words as string $index => string $word) {
    $keys = $keys . $index;
}
echo $keys, "\n";
--ORACLE--
<?php
$words = ["zero", "one", "two"];

foreach ($words as $index => $word) {
    echo $index, ":", $word, "\n";
}

$words[3] = "three";
echo implode(",", $words), "\n";

$keys = "";
foreach ($words as $index => $word) {
    $keys = $keys . $index;
}
echo $keys, "\n";
