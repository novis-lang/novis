--TEST--
`foreach` iterates the array the loop started with, matching PHP's by-value copy: writes, appends and an `unset` through the loop change nothing about what is visited
--FILE--
<?nvs
class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $scaled = [1, 2, 3];
var $seen = "";
foreach ($scaled as string $k => int $v) {
    $scaled[$k] = $v * 10;
    $seen = $seen . $v . ";";
}
echo $seen, "\n";
echo Render::of($scaled), "\n";

array<int> $grown = ["a" => 1, "b" => 2];
var $order = "";
foreach ($grown as string $k => int $v) {
    $grown["z" . $k] = $v + 100;
    $order = $order . $k . ";";
}
echo $order, "\n";
echo Render::of($grown), "\n";

array<int> $shrunk = ["p" => 1, "q" => 2, "r" => 3];
var $visited = "";
foreach ($shrunk as string $k => int $v) {
    unset($shrunk["r"]);
    $visited = $visited . $k . ";";
}
echo $visited, "\n";
echo Render::of($shrunk), "\n";
--ORACLE--
<?php
function render(array $a): string {
    $out = "";
    foreach ($a as $k => $v) {
        $out = $out . $k . "=" . $v . ";";
    }
    return $out;
}

$scaled = [1, 2, 3];
$seen = "";
foreach ($scaled as $k => $v) {
    $scaled[$k] = $v * 10;
    $seen = $seen . $v . ";";
}
echo $seen, "\n";
echo render($scaled), "\n";

$grown = ["a" => 1, "b" => 2];
$order = "";
foreach ($grown as $k => $v) {
    $grown["z" . $k] = $v + 100;
    $order = $order . $k . ";";
}
echo $order, "\n";
echo render($grown), "\n";

$shrunk = ["p" => 1, "q" => 2, "r" => 3];
$visited = "";
foreach ($shrunk as $k => $v) {
    unset($shrunk["r"]);
    $visited = $visited . $k . ";";
}
echo $visited, "\n";
echo render($shrunk), "\n";
