--TEST--
`instanceof` through a subject whose tag nothing proved answers exactly what PHP answers — every supertype for an object, and `false` for every other tag including `null` — ADR 0007 § 2
--FILE--
<?nvs
final class Ask {
    // `bool as string` renders `false` as the empty string, so a row of
    // predicates read through it silently loses its false columns.
    public static function yn(bool $b): string {
        if ($b) {
            return "y";
        }
        return "n";
    }
}

interface Named {
    public function name(): string;
}

class Animal implements Named {
    public function name(): string {
        return "animal";
    }
}

final class Dog extends Animal {
    public function name(): string {
        return "dog";
    }
}

// ADR 0007 § 2's one unchecked position is the shape PHP's own variable
// always has, so these rows are the same program in both languages.
mixed $dog = new Dog();
mixed $animal = new Animal();
echo Ask::yn($dog instanceof Dog),
    Ask::yn($dog instanceof Animal),
    Ask::yn($dog instanceof Named),
    "\n";
echo Ask::yn($animal instanceof Dog),
    Ask::yn($animal instanceof Animal),
    Ask::yn($animal instanceof Named),
    "\n";

// Every non-object tag: PHP answers `false` without a warning, and so does
// this — the whole reason a `mixed` subject keeps the run-time test that a
// declared scalar is refused for (`E0497`).
mixed $num = 7;
mixed $ratio = 1.5;
mixed $flag = true;
mixed $txt = "dog";
mixed $arr = ["k" => "v"];
mixed $nil = null;
echo Ask::yn($num instanceof Dog),
    Ask::yn($ratio instanceof Dog),
    Ask::yn($flag instanceof Dog),
    Ask::yn($txt instanceof Dog),
    Ask::yn($arr instanceof Dog),
    Ask::yn($nil instanceof Dog),
    "\n";

// A nullable class is the same two answers, reached through a declared type
// rather than through `mixed`.
?Animal $held = new Dog();
?Animal $empty = null;
echo Ask::yn($held instanceof Dog), Ask::yn($empty instanceof Dog), "\n";
--ORACLE--
<?php
function yn(bool $b): string {
    if ($b) {
        return "y";
    }
    return "n";
}

interface Named {
    public function name(): string;
}

class Animal implements Named {
    public function name(): string {
        return "animal";
    }
}

final class Dog extends Animal {
    public function name(): string {
        return "dog";
    }
}

$dog = new Dog();
$animal = new Animal();
echo yn($dog instanceof Dog),
    yn($dog instanceof Animal),
    yn($dog instanceof Named),
    "\n";
echo yn($animal instanceof Dog),
    yn($animal instanceof Animal),
    yn($animal instanceof Named),
    "\n";

$num = 7;
$ratio = 1.5;
$flag = true;
$txt = "dog";
$arr = ["k" => "v"];
$nil = null;
echo yn($num instanceof Dog),
    yn($ratio instanceof Dog),
    yn($flag instanceof Dog),
    yn($txt instanceof Dog),
    yn($arr instanceof Dog),
    yn($nil instanceof Dog),
    "\n";

$held = new Dog();
$empty = null;
echo yn($held instanceof Dog), yn($empty instanceof Dog), "\n";
