--TEST--
An assignment used as a value agrees with PHP on what it answers and on where the write lands — the target's own value, never a re-read — ADR 0007 §§ 2 and 5
--FILE--
<?mwl
final class Box { public string $name = "-"; }
final class Echoes {
    public static function of(string $s): string {
        return "(" . $s . ")";
    }
}

// ADR 0007 § 2: the answer is the value written, and the write still lands.
int $a = 0;
int $b = ($a = 2);
echo $a, " ", $b, "\n";

// Right-associative, so the inner assignment *is* the outer one's right-hand
// side rather than a second statement.
int $c = 0;
int $d = 0;
$c = $d = 7;
echo $c, " ", $d, "\n";

// A refcounted value ends up with two owners — the binding and whatever
// consumed the expression — including where the consumer is a call argument.
string $s = "";
string $t = ($s = "alpha");
echo $s, "|", $t, "|", Echoes::of($s = "beta"), "|", $s, "\n";

// A property, an element, an append and a nested element are targets in value
// position exactly as they are in statement position (ADR 0007 § 5).
Box $box = new Box();
echo ($box->name = "named"), " ", $box->name, "\n";
array<string> $xs = [];
echo ($xs["k"] = "v"), " ", ($xs[] = "app"), " ", Core\Json::encode($xs), "\n";
array<array<string>> $g = [];
echo ($g["r"]["c"] = "deep"), " ", Core\Json::encode($g), "\n";

// A compound spelling answers the value *after* the operation.
int $e = 1;
string $acc = "a";
echo ($e += 4), " ", $e, " ", ($acc .= "b"), " ", $acc, "\n";

// A conditionally evaluated operand rebinds into its own copy of the
// environment, and the edges are reconciled at the join: the skipped ones
// must leave their target alone.
int $k = 0;
bool $no = false;
if ($no && ($k = 9) > 0) {
    echo "unreachable\n";
}
int $p = 0;
int $picked = $no ? ($p = 1) : ($p = 2);
?string $absent = null;
string $fill = "";
string $filled = $absent ?? ($fill = "default");
int $w = 0;
int $arm = match (1) { 1 => ($w = 5), default => 42 };
echo $k, " ", $picked, " ", $p, " ", $filled, " ", $fill, " ", $arm, " ", $w, "\n";

// A loop's own condition: the header phi has to carry a write made there, or
// every iteration reads the pre-loop value.
int $i = 0;
while (($i = $i + 1) < 4) {
    echo "i=", $i, " ";
}
echo "end=", $i, "\n";
--ORACLE--
<?php
class Box { public $name = "-"; }
function echoes_of($s) { return "(" . $s . ")"; }

$a = 0;
$b = ($a = 2);
echo $a, " ", $b, "\n";

$c = 0;
$d = 0;
$c = $d = 7;
echo $c, " ", $d, "\n";

$s = "";
$t = ($s = "alpha");
echo $s, "|", $t, "|", echoes_of($s = "beta"), "|", $s, "\n";

$box = new Box();
echo ($box->name = "named"), " ", $box->name, "\n";
$xs = [];
echo ($xs["k"] = "v"), " ", ($xs[] = "app"), " ", json_encode($xs), "\n";
$g = [];
echo ($g["r"]["c"] = "deep"), " ", json_encode($g), "\n";

$e = 1;
$acc = "a";
echo ($e += 4), " ", $e, " ", ($acc .= "b"), " ", $acc, "\n";

$k = 0;
$no = false;
if ($no && ($k = 9) > 0) {
    echo "unreachable\n";
}
$p = 0;
$picked = $no ? ($p = 1) : ($p = 2);
$absent = null;
$fill = "";
$filled = $absent ?? ($fill = "default");
$w = 0;
$arm = match (1) { 1 => ($w = 5), default => 42 };
echo $k, " ", $picked, " ", $p, " ", $filled, " ", $fill, " ", $arm, " ", $w, "\n";

$i = 0;
while (($i = $i + 1) < 4) {
    echo "i=", $i, " ";
}
echo "end=", $i, "\n";
