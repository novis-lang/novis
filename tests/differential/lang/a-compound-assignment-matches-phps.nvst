--TEST--
Each compound assignment operator applies its own operator and stores the result, on a local and on an array element, exactly as PHP's does
--FILE--
<?nvs
// A compound assignment is two claims at once — the operator it stands for and
// the place it stores into — and only the second is interesting, because the
// first is asserted operator by operator elsewhere. So every row below is
// written over a *subscript* as well as over a local: `$a["k"] += 1` has to
// read the entry, apply the operator and write it back to the same entry, and
// an implementation that read a copy prints the local's row correctly and the
// array's row unchanged.
int $n = 10;
$n += 5;
echo $n, " ";
$n -= 3;
echo $n, " ";
$n *= 4;
echo $n, " ";
$n %= 7;
echo $n, "\n";

// The float operators, including the division that a `/=` over two integers
// could not have stored back into an `int`.
float $f = 10.0;
$f /= 4.0;
echo $f, " ";
$f **= 2;
echo $f, " ";
$f += 0.75;
echo $f, "\n";

// `.=` grows a string from the right, and the operand is appended once per
// statement rather than once per read of the target.
string $s = "a";
$s .= "b";
$s .= "cd";
echo $s, "|", Core\Str::length($s), "\n";

// The same four operators over an entry of an array, which is the half that
// says the target is written back where it was read.
array<int> $counts = ["hits" => 10, "misses" => 3];
$counts["hits"] += 5;
$counts["misses"] *= 2;
$counts["hits"] -= 1;
echo $counts["hits"], " ", $counts["misses"], "\n";

// A nested entry, where the path has to be walked once for the read and land on
// the same entry for the write — the row a copy-on-write array gets wrong if it
// copies at the wrong moment.
array<array<int>> $grid = ["row" => ["cell" => 1]];
$grid["row"]["cell"] += 41;
echo $grid["row"]["cell"], "\n";

// The modulo's sign follows its left operand, in the compound spelling exactly
// as in the plain one — `-7 % 3` is negative in both languages, and a compound
// operator that reordered its operands would print the positive answer.
int $negative = -7;
$negative %= 3;
echo $negative, " ";
int $plain = 7;
$plain %= -3;
echo $plain, "\n";
--ORACLE--
<?php
$n = 10;
$n += 5;
echo $n, " ";
$n -= 3;
echo $n, " ";
$n *= 4;
echo $n, " ";
$n %= 7;
echo $n, "\n";

$f = 10.0;
$f /= 4.0;
echo $f, " ";
$f **= 2;
echo $f, " ";
$f += 0.75;
echo $f, "\n";

$s = "a";
$s .= "b";
$s .= "cd";
echo $s, "|", strlen($s), "\n";

$counts = ["hits" => 10, "misses" => 3];
$counts["hits"] += 5;
$counts["misses"] *= 2;
$counts["hits"] -= 1;
echo $counts["hits"], " ", $counts["misses"], "\n";

$grid = ["row" => ["cell" => 1]];
$grid["row"]["cell"] += 41;
echo $grid["row"]["cell"], "\n";

$negative = -7;
$negative %= 3;
echo $negative, " ";
$plain = 7;
$plain %= -3;
echo $plain, "\n";
