--TEST--
A `foreach` inside a `foreach` over an array of arrays visits PHP's exact order
--FILE--
<?mwl
array<array<int>> $grid = ["top" => [1, 2, 3], "bottom" => [4, 5]];
int $total = 0;
foreach ($grid as string $name => array<int> $row) {
    echo $name, ":";
    foreach ($row as string $i => int $v) {
        echo $i, "=", $v, ",";
        $total = $total + $v;
    }
    echo ";";
}
echo "\n", $total, "\n";
--ORACLE--
<?php
$grid = ["top" => [1, 2, 3], "bottom" => [4, 5]];
$total = 0;
foreach ($grid as $name => $row) {
    echo $name, ":";
    foreach ($row as $i => $v) {
        echo $i, "=", $v, ",";
        $total = $total + $v;
    }
    echo ";";
}
echo "\n", $total, "\n";
