--TEST--
A do-while body runs before its condition is ever tested, and its break and continue land where PHP's do
--FILE--
<?nvs
// The one thing this loop has that `while` does not is that the body precedes
// the test, so a condition that is false from the start still runs it once —
// the row that separates the two spellings and the only reason to write this
// one. Every other row here asserts that nothing *else* about it differs from
// the `while` next door: the condition is re-evaluated each pass, `break`
// leaves without testing, and `continue` goes to the test rather than past it.
int $never = 0;
do {
    $never = $never + 1;
} while (false);
echo "once=", $never, "\n";

// The ordinary accumulation, so that the exit is the condition going false
// rather than a count baked into the body.
int $i = 0;
string $seen = "";
do {
    $seen = $seen . $i;
    $i = $i + 1;
} while ($i < 5);
echo $seen, "|", $i, "\n";

// `continue` inside it tests the condition rather than skipping it, which is
// the mistake that turns this loop into an infinite one: the counter below is
// advanced *before* the `continue`, and a `continue` that jumped over the test
// would still terminate while an implementation that jumped to the top of the
// body would not.
int $j = 0;
string $odd = "";
do {
    $j = $j + 1;
    if ($j % 2 == 0) {
        continue;
    }
    $odd = $odd . $j;
} while ($j < 7);
echo $odd, "|", $j, "\n";

// `break` leaves without testing, so the counter stops at the value that
// triggered it rather than one past it.
int $k = 0;
do {
    $k = $k + 1;
    if ($k == 3) {
        break;
    }
} while ($k < 100);
echo "broke=", $k, "\n";

// Nested, with the inner loop's condition depending on the outer's counter —
// the inner body still runs once per outer pass even where its condition was
// false before it started.
string $grid = "";
int $row = 0;
do {
    int $col = 0;
    do {
        $grid = $grid . $row . $col . " ";
        $col = $col + 1;
    } while ($col < $row);
    $row = $row + 1;
} while ($row < 3);
echo $grid, "\n";
--ORACLE--
<?php
$never = 0;
do {
    $never = $never + 1;
} while (false);
echo "once=", $never, "\n";

$i = 0;
$seen = "";
do {
    $seen = $seen . $i;
    $i = $i + 1;
} while ($i < 5);
echo $seen, "|", $i, "\n";

$j = 0;
$odd = "";
do {
    $j = $j + 1;
    if ($j % 2 == 0) {
        continue;
    }
    $odd = $odd . $j;
} while ($j < 7);
echo $odd, "|", $j, "\n";

$k = 0;
do {
    $k = $k + 1;
    if ($k == 3) {
        break;
    }
} while ($k < 100);
echo "broke=", $k, "\n";

$grid = "";
$row = 0;
do {
    $col = 0;
    do {
        $grid = $grid . $row . $col . " ";
        $col = $col + 1;
    } while ($col < $row);
    $row = $row + 1;
} while ($row < 3);
echo $grid, "\n";
