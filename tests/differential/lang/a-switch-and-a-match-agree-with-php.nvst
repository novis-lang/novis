--TEST--
Label order, fallthrough, a mid-list `default` and a `match`'s chosen arm all match PHP
--FILE--
<?nvs
var $log = "";
int $i = 0;
for ($i = 0; $i < 4; $i += 1) {
    switch ($i) {
        case 0:
            $log .= "zero ";
            break;
        default:
            $log .= "other";
        case 3:
            $log .= "(3) ";
            break;
    }
}
echo "log=", $log, "|\n";

var $seen = "before ";
switch (9) {
    case 1:
        $seen .= "one";
        break;
}
$seen .= "after";
echo "seen=", $seen, "\n";

var $picked = "";
array<string> $words = ["a", "b", "c"];
foreach ($words as string $w) {
    switch ($w) {
        case "a":
        case "c":
            $picked .= "edge(" . $w . ") ";
            break;
        default:
            $picked .= "middle(" . $w . ") ";
    }
}
echo "picked=", $picked, "|\n";

// A bare `continue` inside a `switch` is PHP's `continue 2`, not its `continue`
// — see `nvs_ir::lower::Lowering::lower_switch` for why Novis takes the meaning
// PHP's own warning points at.
var $trace = "";
int $n = 0;
for ($n = 0; $n < 4; $n += 1) {
    switch ($n) {
        case 2:
            continue;
        default:
            $trace .= "d" . $n;
    }
    $trace .= "t" . $n . " ";
}
echo "trace=", $trace, "|\n";

var $labels = "";
int $m = 0;
for ($m = 0; $m < 5; $m += 1) {
    $labels .= match ($m) {
        0, 1 => "small ",
        3 => "three ",
        default => "big ",
    };
}
echo "labels=", $labels, "|\n";
--ORACLE--
<?php
$log = "";
$i = 0;
for ($i = 0; $i < 4; $i += 1) {
    switch ($i) {
        case 0:
            $log .= "zero ";
            break;
        default:
            $log .= "other";
        case 3:
            $log .= "(3) ";
            break;
    }
}
echo "log=", $log, "|\n";

$seen = "before ";
switch (9) {
    case 1:
        $seen .= "one";
        break;
}
$seen .= "after";
echo "seen=", $seen, "\n";

$picked = "";
$words = ["a", "b", "c"];
foreach ($words as $w) {
    switch ($w) {
        case "a":
        case "c":
            $picked .= "edge(" . $w . ") ";
            break;
        default:
            $picked .= "middle(" . $w . ") ";
    }
}
echo "picked=", $picked, "|\n";

$trace = "";
$n = 0;
for ($n = 0; $n < 4; $n += 1) {
    switch ($n) {
        case 2:
            continue 2;
        default:
            $trace .= "d" . $n;
    }
    $trace .= "t" . $n . " ";
}
echo "trace=", $trace, "|\n";

$labels = "";
$m = 0;
for ($m = 0; $m < 5; $m += 1) {
    $labels .= match ($m) {
        0, 1 => "small ",
        3 => "three ",
        default => "big ",
    };
}
echo "labels=", $labels, "|\n";
