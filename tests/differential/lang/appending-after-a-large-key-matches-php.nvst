--TEST--
The next append index after an out-of-order integer key is the one PHP picks
--FILE--
<?nvs
array<int> $a = [];
$a[100] = 1;
$a[] = 2;
$a[5] = 3;
$a[] = 4;
foreach ($a as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";

array<int> $b = ["x" => 1];
$b[] = 2;
$b[] = 3;
foreach ($b as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
--ORACLE--
<?php
$a = [];
$a[100] = 1;
$a[] = 2;
$a[5] = 3;
$a[] = 4;
foreach ($a as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";

$b = ["x" => 1];
$b[] = 2;
$b[] = 3;
foreach ($b as $k => $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
