--TEST--
A `for` loop's init/condition/step order, and what its variables hold afterwards, match PHP
--FILE--
<?mwl
var $sum = 0;
var $i = 0;
for ($i = 0; $i < 5; $i += 1) {
    $sum += $i;
}
echo "sum=", $sum, " i=", $i, "\n";

var $a = 0;
var $b = 0;
var $steps = 0;
for ($a = 0, $b = 10; $a < $b; $a += 2, $b -= 1) {
    $steps += 1;
}
echo "a=", $a, " b=", $b, " steps=", $steps, "\n";

var $out = "";
var $j = 0;
for ($j = 0; $j < 6; $j += 1) {
    if ($j === 2) {
        continue;
    }
    if ($j === 5) {
        break;
    }
    $out .= ($j as string);
}
echo "out=", $out, " j=", $j, "\n";

var $log = "";
var $k = 0;
for ($k = 0; $k < 4; $k += 1) {
    try {
        if ($k === 1) {
            continue;
        }
        if ($k === 3) {
            break;
        }
        $log .= "t" . ($k as string);
    } finally {
        $log .= ".";
    }
}
echo "log=", $log, " k=", $k, "\n";
--ORACLE--
<?php
$sum = 0;
$i = 0;
for ($i = 0; $i < 5; $i += 1) {
    $sum += $i;
}
echo "sum=", $sum, " i=", $i, "\n";

$a = 0;
$b = 0;
$steps = 0;
for ($a = 0, $b = 10; $a < $b; $a += 2, $b -= 1) {
    $steps += 1;
}
echo "a=", $a, " b=", $b, " steps=", $steps, "\n";

$out = "";
$j = 0;
for ($j = 0; $j < 6; $j += 1) {
    if ($j === 2) {
        continue;
    }
    if ($j === 5) {
        break;
    }
    $out .= (string) $j;
}
echo "out=", $out, " j=", $j, "\n";

$log = "";
$k = 0;
for ($k = 0; $k < 4; $k += 1) {
    try {
        if ($k === 1) {
            continue;
        }
        if ($k === 3) {
            break;
        }
        $log .= "t" . (string) $k;
    } finally {
        $log .= ".";
    }
}
echo "log=", $log, " k=", $k, "\n";
