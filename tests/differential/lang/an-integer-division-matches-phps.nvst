--TEST--
An integer quotient answers PHP's own value and renders PHP's own way, overflow and zero divisor included — ADR 0007 § 4
--FILE--
<?nvs
int $six = 6;
int $three = 3;
int $seven = 7;
int $two = 2;
int $one = 1;
int $big = 9223372036854775807;

echo "6/3=", $six / $three, "\n";
echo "7/2=", $seven / $two, "\n";
echo "1/3=", $one / $three, "\n";
echo "-7/2=", (0 - $seven) / $two, "\n";
echo "7/-2=", $seven / (0 - $two), "\n";
echo "0/7=", (0 - 0) / $seven, "\n";
echo "big/1=", $big / $one, "\n";
echo "big/2=", $big / $two, "\n";
// The signed overflow, which is a `float` rather than a throw: PHP answers a
// value here, so the exactness test has to send it down the inexact arm.
echo "min/-1=", (0 - $big - $one) / (0 - $one), "\n";
try {
    var $bad = $six / (0 - 0);
    echo "no throw\n";
} catch (Throwable $dz) {
    echo "zero: ", $dz->message, "\n";
}
--ORACLE--
<?php
$six = 6;
$three = 3;
$seven = 7;
$two = 2;
$one = 1;
$big = PHP_INT_MAX;

echo "6/3=", $six / $three, "\n";
echo "7/2=", $seven / $two, "\n";
echo "1/3=", $one / $three, "\n";
echo "-7/2=", (0 - $seven) / $two, "\n";
echo "7/-2=", $seven / (0 - $two), "\n";
echo "0/7=", (0 - 0) / $seven, "\n";
echo "big/1=", $big / $one, "\n";
echo "big/2=", $big / $two, "\n";
echo "min/-1=", (0 - $big - $one) / (0 - $one), "\n";
try {
    $bad = $six / (0 - 0);
    echo "no throw\n";
} catch (Throwable $dz) {
    echo "zero: ", $dz->getMessage(), "\n";
}
