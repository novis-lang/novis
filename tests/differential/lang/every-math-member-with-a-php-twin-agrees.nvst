--TEST--
every Core\Math member the spec gives a PHP twin answers what that twin answers over one shared numeric corpus, and the ten identities the members hold jointly hold in PHP too (spec § 3, `rule:core-api/shape-rules` R4 and R17, `rule:classes/no-free-functions-or-constants`)
--FILE--
<?nvs
// The roster case for `Core\Math`. Every other file under
// tests/differential/core/math-*.nvst asks one member or one pair a deep
// question; this one asks *every* member the spec gives a PHP twin the same
// shallow question over one shared corpus, so a member that is added, renamed,
// given a second option or quietly re-based on a different rounding rule shows
// up here rather than having to be noticed. The claim is coverage in one
// place, and it is the claim no per-member file can make.
//
// The constraint that makes this corpus honest is that **every argument is
// inside its member's domain and every sweep is over one type**. Both halves
// of that are load-bearing. The domain, because spec § 3 hands the IEEE edges
// to their own files — a root below zero, a logarithm of zero, an exponential
// that overflows — and repeating them here would be a second home for what
// math-sqrt-exp-and-log already pins. The single type, because
// `Core\Math::min`, `max` and `clamp` declare every parameter and their return
// as one `T`, so a mixed pair is `E0401` at the second argument rather than
// the runtime refusal it reads as.
//
// Two divergences are already pinned in their own files and this one stays
// clear of both: `min`/`max` over a tie, a numeral string or an unordered pair
// (math-min-and-max-diverge-from-php-…), and `toBase`/`fromBase` over a digit
// or a base the twin silently repairs
// (math-to-base-and-from-base-refuse-what-php-silently-repairs).
//
// Three twins are written out rather than named, each for a stated reason.
// `gcd` and `lcm` replace `gmp_gcd`/`gmp_lcm`, and this leg has no `gmp`, so
// the twin is Euclid — the same helper
// math-gcd-and-lcm-match-a-hand-written-euclid uses. `truncate`'s stated twin
// is a `(int)` cast, which loses the sign of a negative zero where the member
// keeps it, so the twin is that cast's sign-preserving spelling.
//
// Deliberately absent, with the reason each time. `RoundMode::Up` and
// `RoundMode::Down` round away from and toward zero, and PHP 8.5 has no
// `PHP_ROUND_*` constant for either — the spec's *Replaces* column names four
// constants and there are four here. `Core\Math::UINT_MAX` is absent from the
// constant block for the same reason: PHP has no unsigned integer and so no
// name for its ceiling.
final class Show {
    // `bool as string` is `1`/`` in both languages, and an empty cell between
    // two separators is unreadable in a table this wide. Same fold as the
    // `Core\Str` and `Core\Arr` roster cases.
    public static function flag(bool $v): string {
        if ($v) {
            return "T";
        }
        return "F";
    }

    // A `NAN` coerced to a string is a diagnostic in PHP 8.4 and later, so
    // neither side renders one: a value not equal to itself is the only `NAN`
    // there is, and the sentinel is what both print instead. Copied from
    // math-sqrt-exp-and-log, which owns the reasoning.
    public static function real(float $value): string {
        if ($value == $value) {
            return $value as string;
        }
        return "nan";
    }
}

// ---------------------------------------------------------------------------
// The corpora. One per domain, because a member's domain is the one thing this
// file is not asking a question about.
// ---------------------------------------------------------------------------

// The general reals: both signed zeros, both signs of a half, of a quarter and
// of a whole. Every square here is exact in binary, which is what lets the
// identity block below compare with `==` rather than with a tolerance.
array<float> $reals = [0.0, -0.0, 0.5, -0.5, 1.5, -1.5, 2.5, -2.5, 3.25, -3.25, 10.0, -10.0];

// Strictly positive, for the three members whose domain excludes zero or the
// negatives: `sqrt`, `log` and `cbrt`.
array<float> $positives = [0.25, 1.0, 2.0, 8.0, 100.0];

// Radians, for the circular and hyperbolic members that accept the whole line.
array<float> $angles = [-2.0, -1.0, -0.5, 0.0, 0.5, 1.0, 2.0];

// The closed unit interval, for `asin` and `acos`; the open one for `atanh`,
// whose endpoints are the infinities; and `[1, ∞)` for `acosh`.
array<float> $unit = [-1.0, -0.5, 0.0, 0.5, 1.0];
array<float> $inner = [-0.5, -0.25, 0.0, 0.25, 0.5];
array<float> $atLeastOne = [1.0, 2.0, 8.0];

// Degrees, for the two conversions.
array<float> $degrees = [0.0, 30.0, 45.0, 90.0, 180.0, -90.0];

// Halfway values, which are the whole question `round`'s `mode` option exists
// to answer, and ordinary fractions for its `precision` option.
array<float> $halves = [0.5, 1.5, 2.5, 3.5, -0.5, -1.5, -2.5, -3.5];
array<float> $fractions = [1.2345, -1.2345, 12.5, -12.5, 1250.0];

// The integers, and the integer pairs the four integer members take.
array<int> $whole = [0, 1, -1, 7, -7, 12, 18, 100, -100];
array<array<int>> $pairs = [[7, 2], [-7, 2], [7, -2], [-7, -2], [12, 18], [100, 10], [0, 5]];

// Non-negative, for the base pair: `decbin` and its siblings read a negative
// as an unsigned 64-bit pattern, which is the divergence file's subject.
array<int> $naturals = [0, 1, 7, 10, 255, 1000];

// Quantities for `format`, whose twin is `number_format`.
array<float> $amounts = [0.0, 1.0, 1234.5678, -1234.5678, 1000000.0];

float $nan = Core\Math::NAN;
float $inf = Core\Math::INFINITY;
array<float> $specials = [$nan, $inf, -$inf, 0.0, 1.0, -1.0];

// ---------------------------------------------------------------------------
// Sign, magnitude and the three roundings to a whole number.
// ---------------------------------------------------------------------------

echo "abs:";
foreach ($reals as float $n) {
    echo Core\Math::abs($n), "|";
}
echo "\n";

echo "absInt:";
foreach ($whole as int $i) {
    echo Core\Math::abs($i), "|";
}
echo "\n";

echo "sign:";
foreach ($reals as float $n) {
    echo Core\Math::sign($n), "|";
}
echo "\n";

echo "signInt:";
foreach ($whole as int $i) {
    echo Core\Math::sign($i), "|";
}
echo "\n";

echo "ceil:";
foreach ($reals as float $n) {
    echo Core\Math::ceil($n), "|";
}
echo "\n";

echo "floor:";
foreach ($reals as float $n) {
    echo Core\Math::floor($n), "|";
}
echo "\n";

echo "truncate:";
foreach ($reals as float $n) {
    echo Core\Math::truncate($n), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// `round`: one member where PHP has a function plus four constants. The
// default is `HalfUp` at precision 0 on both sides, so the first row is
// `round($n)` against `round($n)` with nothing written down.
// ---------------------------------------------------------------------------

echo "round:";
foreach ($reals as float $n) {
    echo Core\Math::round($n, {}), "|";
}
echo "\n";

echo "roundTo2:";
foreach ($fractions as float $n) {
    echo Core\Math::round($n, {precision: 2}), "|";
}
echo "\n";

echo "roundToTens:";
foreach ($fractions as float $n) {
    echo Core\Math::round($n, {precision: -1}), "|";
}
echo "\n";

echo "halfUp:";
foreach ($halves as float $n) {
    echo Core\Math::round($n, {mode: Core\RoundMode::HalfUp}), "|";
}
echo "\n";

echo "halfDown:";
foreach ($halves as float $n) {
    echo Core\Math::round($n, {mode: Core\RoundMode::HalfDown}), "|";
}
echo "\n";

echo "halfEven:";
foreach ($halves as float $n) {
    echo Core\Math::round($n, {mode: Core\RoundMode::HalfEven}), "|";
}
echo "\n";

echo "halfOdd:";
foreach ($halves as float $n) {
    echo Core\Math::round($n, {mode: Core\RoundMode::HalfOdd}), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// The three ordering members, over one type at a time. `clamp` is the one with
// no PHP function at all: its twin is the `min(max(…))` nest the spec names.
// ---------------------------------------------------------------------------

echo "minMaxInt:";
foreach ($pairs as array<int> $p) {
    int $a = $p[0];
    int $b = $p[1];
    echo Core\Math::min($a, $b), ",", Core\Math::max($a, $b), "|";
}
echo "\n";

echo "minMaxFloat:";
foreach ($reals as float $n) {
    echo Core\Math::min($n, 1.0), ",", Core\Math::max($n, 1.0), "|";
}
echo "\n";

echo "clamp:";
foreach ($reals as float $n) {
    echo Core\Math::clamp($n, -1.0, 2.0), "|";
}
echo "\n";

echo "clampInt:";
foreach ($whole as int $i) {
    echo Core\Math::clamp($i, 0, 10), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// The four integer members. `mod` is `fmod` and takes floats, because integer
// `%` is the operator (R17) and has no member.
// ---------------------------------------------------------------------------

echo "intDiv:";
foreach ($pairs as array<int> $p) {
    echo Core\Math::intDiv($p[0], $p[1]), "|";
}
echo "\n";

echo "mod:";
foreach ($pairs as array<int> $p) {
    echo Core\Math::mod($p[0] as float, $p[1] as float), "|";
}
echo "\n";

echo "gcd:";
foreach ($pairs as array<int> $p) {
    echo Core\Math::gcd($p[0], $p[1]), "|";
}
echo "\n";

echo "lcm:";
foreach ($pairs as array<int> $p) {
    echo Core\Math::lcm($p[0], $p[1]), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// Roots, powers and logarithms. `log`'s `{base?: float}` folds `log`, `log10`
// and `log2` into one member, so it gets three rows against three functions.
// `cbrt` has no PHP function: its twin is `pow($n, 1/3)`, which is why the
// corpus for it is non-negative — `pow` answers `NAN` for a negative base
// where the member answers the real root, and that is its own file's subject.
// ---------------------------------------------------------------------------

echo "sqrt:";
foreach ($positives as float $n) {
    echo Core\Math::sqrt($n), "|";
}
echo "\n";

echo "cbrt:";
foreach ($positives as float $n) {
    echo Core\Math::cbrt($n), "|";
}
echo "\n";

echo "exp:";
foreach ($angles as float $n) {
    echo Core\Math::exp($n), "|";
}
echo "\n";

echo "log:";
foreach ($positives as float $n) {
    echo Core\Math::log($n, {}), "|";
}
echo "\n";

echo "log10:";
foreach ($positives as float $n) {
    echo Core\Math::log($n, {base: 10.0}), "|";
}
echo "\n";

echo "log2:";
foreach ($positives as float $n) {
    echo Core\Math::log($n, {base: 2.0}), "|";
}
echo "\n";

echo "hypot:";
foreach ($angles as float $n) {
    echo Core\Math::hypot($n, 1.0), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// The twelve circular and hyperbolic members, each over the domain its twin
// accepts without answering `NAN`.
// ---------------------------------------------------------------------------

echo "sin:";
foreach ($angles as float $n) {
    echo Core\Math::sin($n), "|";
}
echo "\n";

echo "cos:";
foreach ($angles as float $n) {
    echo Core\Math::cos($n), "|";
}
echo "\n";

echo "tan:";
foreach ($angles as float $n) {
    echo Core\Math::tan($n), "|";
}
echo "\n";

echo "asin:";
foreach ($unit as float $n) {
    echo Core\Math::asin($n), "|";
}
echo "\n";

echo "acos:";
foreach ($unit as float $n) {
    echo Core\Math::acos($n), "|";
}
echo "\n";

echo "atan:";
foreach ($angles as float $n) {
    echo Core\Math::atan($n), "|";
}
echo "\n";

echo "atan2:";
foreach ($angles as float $n) {
    echo Core\Math::atan2($n, 2.0), ",", Core\Math::atan2(2.0, $n), "|";
}
echo "\n";

echo "sinh:";
foreach ($angles as float $n) {
    echo Core\Math::sinh($n), "|";
}
echo "\n";

echo "cosh:";
foreach ($angles as float $n) {
    echo Core\Math::cosh($n), "|";
}
echo "\n";

echo "tanh:";
foreach ($angles as float $n) {
    echo Core\Math::tanh($n), "|";
}
echo "\n";

echo "asinh:";
foreach ($angles as float $n) {
    echo Core\Math::asinh($n), "|";
}
echo "\n";

echo "acosh:";
foreach ($atLeastOne as float $n) {
    echo Core\Math::acosh($n), "|";
}
echo "\n";

echo "atanh:";
foreach ($inner as float $n) {
    echo Core\Math::atanh($n), "|";
}
echo "\n";

echo "toRadians:";
foreach ($degrees as float $n) {
    echo Core\Math::toRadians($n), "|";
}
echo "\n";

echo "toDegrees:";
foreach ($angles as float $n) {
    echo Core\Math::toDegrees($n), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// The two predicates. `isFinite` folds `is_finite` and `is_infinite`, so its
// twin is `is_finite` alone and the negation of `is_infinite` is asserted
// beside it rather than in a second row.
// ---------------------------------------------------------------------------

echo "isNan:";
foreach ($specials as float $n) {
    echo Show::flag(Core\Math::isNan($n)), "|";
}
echo "\n";

echo "isFinite:";
foreach ($specials as float $n) {
    echo Show::flag(Core\Math::isFinite($n)), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// The base pair, over four bases: two of PHP's three fixed-base functions,
// their third, and the general `base_convert`.
// ---------------------------------------------------------------------------

echo "toBase:";
foreach ($naturals as int $i) {
    echo Core\Math::toBase($i, 2), ",", Core\Math::toBase($i, 8), ",", Core\Math::toBase($i, 16), ",", Core\Math::toBase($i, 36), "|";
}
echo "\n";

echo "fromBase:";
foreach ($naturals as int $i) {
    echo Core\Math::fromBase(Core\Math::toBase($i, 2), 2), ",", Core\Math::fromBase(Core\Math::toBase($i, 16), 16), ",", Core\Math::fromBase(Core\Math::toBase($i, 36), 36), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// `format`, whose twin is `number_format`. The separators are explicit at
// every call because Novis has no ambient locale (spec § 3) and the group
// separator defaults to empty rather than to PHP's comma, so the two defaults
// are different on purpose and every row here writes both out.
// ---------------------------------------------------------------------------

echo "format2:";
foreach ($amounts as float $n) {
    echo Core\Math::format($n, {decimals: 2}), "|";
}
echo "\n";

echo "formatGrouped:";
foreach ($amounts as float $n) {
    echo Core\Math::format($n, {decimals: 2, groupSeparator: ","}), "|";
}
echo "\n";

echo "format0:";
foreach ($amounts as float $n) {
    echo Core\Math::format($n, {decimals: 0}), "|";
}
echo "\n";

echo "formatEuropean:";
foreach ($amounts as float $n) {
    echo Core\Math::format($n, {decimals: 3, decimalSeparator: ",", groupSeparator: "."}), "|";
}
echo "\n";

echo "formatInt:";
foreach ($whole as int $i) {
    echo Core\Math::format($i, {decimals: 1}), "|";
}
echo "\n";

// ---------------------------------------------------------------------------
// The constants, which `rule:classes/no-free-functions-or-constants` moved off PHP's global namespace onto the
// class. `NAN` renders through the predicate rather than as text, for the
// reason `Show::real` states.
// ---------------------------------------------------------------------------

echo "constants:", Core\Math::PI, ",", Core\Math::TAU, ",", Core\Math::E, ",", Core\Math::EPSILON, "\n";
echo "bounds:", Core\Math::INT_MAX, ",", Core\Math::INT_MIN, ",", Core\Math::FLOAT_MAX, ",", Core\Math::FLOAT_MIN, "\n";
echo "edges:", Core\Math::INFINITY, ",", -Core\Math::INFINITY, ",", Show::flag(Core\Math::isNan(Core\Math::NAN)), "\n";

// ---------------------------------------------------------------------------
// Ten identities over the real corpus, counted rather than read off a line, so
// a member answering plausibly row by row still fails here. Each is written
// out in the same shape on both sides, so what is asserted is that the two
// languages hold the same count and not merely that Novis holds one — an
// identity Novis satisfies and PHP does not is exactly the divergence this
// file exists to catch.
// ---------------------------------------------------------------------------

int $held = 0;
int $cells = 0;
foreach ($reals as float $n) {
    $cells = $cells + 10;

    // The magnitude is the larger of a value and its negation.
    if (Core\Math::abs($n) == Core\Math::max($n, -$n)) {
        $held = $held + 1;
    }
    // The two whole-number roundings are never more than one apart.
    float $gap = Core\Math::ceil($n) - Core\Math::floor($n);
    if ($gap == 0.0 || $gap == 1.0) {
        $held = $held + 1;
    }
    // And they bracket the value.
    if (Core\Math::floor($n) <= $n) {
        $held = $held + 1;
    }
    if ($n <= Core\Math::ceil($n)) {
        $held = $held + 1;
    }
    // Truncation is odd, which is the whole of how it differs from `floor`.
    if (Core\Math::truncate($n) + Core\Math::truncate(-$n) == 0.0) {
        $held = $held + 1;
    }
    // Flooring a negation is negating a ceiling.
    if (Core\Math::floor(-$n) == -Core\Math::ceil($n)) {
        $held = $held + 1;
    }
    // The root of a square is the magnitude, exactly, for this corpus.
    if (Core\Math::sqrt($n * $n) == Core\Math::max($n, -$n)) {
        $held = $held + 1;
    }
    // A hypotenuse with one zero leg is the other leg's magnitude.
    if (Core\Math::hypot($n, 0.0) == Core\Math::max($n, -$n)) {
        $held = $held + 1;
    }
    // Splitting at zero and adding the halves back reproduces the value.
    if (Core\Math::min($n, 0.0) + Core\Math::max($n, 0.0) == $n) {
        $held = $held + 1;
    }
    // The two-argument arctangent with a unit denominator is the one-argument
    // one, which is what makes `atan2` a generalisation rather than a second
    // member.
    if (Core\Math::atan2($n, 1.0) == Core\Math::atan($n)) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";

// Four more over the integer pairs, where the identities are arithmetic rather
// than analytic and hold exactly on both sides.
int $intHeld = 0;
int $intCells = 0;
foreach ($pairs as array<int> $p) {
    int $x = $p[0];
    int $y = $p[1];
    $intCells = $intCells + 4;

    int $absA = $x;
    if ($absA < 0) {
        $absA = -$absA;
    }
    int $absB = $y;
    if ($absB < 0) {
        $absB = -$absB;
    }

    // Division and the remainder operator reconstruct the dividend.
    if (Core\Math::intDiv($x, $y) * $y + $x % $y == $x) {
        $intHeld = $intHeld + 1;
    }
    // The product of the two divisors is the product of the two numbers.
    if (Core\Math::gcd($x, $y) * Core\Math::lcm($x, $y) == $absA * $absB) {
        $intHeld = $intHeld + 1;
    }
    // And the greatest common divisor divides both.
    if ($x % Core\Math::gcd($x, $y) == 0 && $y % Core\Math::gcd($x, $y) == 0) {
        $intHeld = $intHeld + 1;
    }
    // The base pair round-trips, which is the only claim that binds the two
    // members to each other rather than each to its own twin.
    if (Core\Math::fromBase(Core\Math::toBase($absA, 16), 16) == $absA) {
        $intHeld = $intHeld + 1;
    }
}
echo $intHeld, " of ", $intCells, "\n";
--ORACLE--
<?php
function flag(bool $v): string {
    if ($v) {
        return "T";
    }
    return "F";
}

function nvs_truncate(float $n): float {
    if ($n < 0) {
        return ceil($n);
    }
    return floor($n);
}

function nvs_gcd(int $a, int $b): int {
    $a = $a < 0 ? -$a : $a;
    $b = $b < 0 ? -$b : $b;
    while ($b != 0) {
        $t = $a % $b;
        $a = $b;
        $b = $t;
    }
    return $a;
}

function nvs_lcm(int $a, int $b): int {
    $a = $a < 0 ? -$a : $a;
    $b = $b < 0 ? -$b : $b;
    if ($a == 0 || $b == 0) {
        return 0;
    }
    return intdiv($a, nvs_gcd($a, $b)) * $b;
}

$reals = [0.0, -0.0, 0.5, -0.5, 1.5, -1.5, 2.5, -2.5, 3.25, -3.25, 10.0, -10.0];
$positives = [0.25, 1.0, 2.0, 8.0, 100.0];
$angles = [-2.0, -1.0, -0.5, 0.0, 0.5, 1.0, 2.0];
$unit = [-1.0, -0.5, 0.0, 0.5, 1.0];
$inner = [-0.5, -0.25, 0.0, 0.25, 0.5];
$atLeastOne = [1.0, 2.0, 8.0];
$degrees = [0.0, 30.0, 45.0, 90.0, 180.0, -90.0];
$halves = [0.5, 1.5, 2.5, 3.5, -0.5, -1.5, -2.5, -3.5];
$fractions = [1.2345, -1.2345, 12.5, -12.5, 1250.0];
$whole = [0, 1, -1, 7, -7, 12, 18, 100, -100];
$pairs = [[7, 2], [-7, 2], [7, -2], [-7, -2], [12, 18], [100, 10], [0, 5]];
$naturals = [0, 1, 7, 10, 255, 1000];
$amounts = [0.0, 1.0, 1234.5678, -1234.5678, 1000000.0];

$nan = NAN;
$inf = INF;
$specials = [$nan, $inf, -$inf, 0.0, 1.0, -1.0];

echo "abs:";
foreach ($reals as $n) {
    echo abs($n), "|";
}
echo "\n";

echo "absInt:";
foreach ($whole as $n) {
    echo abs($n), "|";
}
echo "\n";

echo "sign:";
foreach ($reals as $n) {
    echo $n <=> 0, "|";
}
echo "\n";

echo "signInt:";
foreach ($whole as $n) {
    echo $n <=> 0, "|";
}
echo "\n";

echo "ceil:";
foreach ($reals as $n) {
    echo ceil($n), "|";
}
echo "\n";

echo "floor:";
foreach ($reals as $n) {
    echo floor($n), "|";
}
echo "\n";

echo "truncate:";
foreach ($reals as $n) {
    echo nvs_truncate($n), "|";
}
echo "\n";

echo "round:";
foreach ($reals as $n) {
    echo round($n), "|";
}
echo "\n";

echo "roundTo2:";
foreach ($fractions as $n) {
    echo round($n, 2), "|";
}
echo "\n";

echo "roundToTens:";
foreach ($fractions as $n) {
    echo round($n, -1), "|";
}
echo "\n";

echo "halfUp:";
foreach ($halves as $n) {
    echo round($n, 0, PHP_ROUND_HALF_UP), "|";
}
echo "\n";

echo "halfDown:";
foreach ($halves as $n) {
    echo round($n, 0, PHP_ROUND_HALF_DOWN), "|";
}
echo "\n";

echo "halfEven:";
foreach ($halves as $n) {
    echo round($n, 0, PHP_ROUND_HALF_EVEN), "|";
}
echo "\n";

echo "halfOdd:";
foreach ($halves as $n) {
    echo round($n, 0, PHP_ROUND_HALF_ODD), "|";
}
echo "\n";

echo "minMaxInt:";
foreach ($pairs as $p) {
    $a = $p[0];
    $b = $p[1];
    echo min($a, $b), ",", max($a, $b), "|";
}
echo "\n";

echo "minMaxFloat:";
foreach ($reals as $n) {
    echo min($n, 1.0), ",", max($n, 1.0), "|";
}
echo "\n";

echo "clamp:";
foreach ($reals as $n) {
    echo min(max($n, -1.0), 2.0), "|";
}
echo "\n";

echo "clampInt:";
foreach ($whole as $n) {
    echo min(max($n, 0), 10), "|";
}
echo "\n";

echo "intDiv:";
foreach ($pairs as $p) {
    echo intdiv($p[0], $p[1]), "|";
}
echo "\n";

echo "mod:";
foreach ($pairs as $p) {
    echo fmod((float) $p[0], (float) $p[1]), "|";
}
echo "\n";

echo "gcd:";
foreach ($pairs as $p) {
    echo nvs_gcd($p[0], $p[1]), "|";
}
echo "\n";

echo "lcm:";
foreach ($pairs as $p) {
    echo nvs_lcm($p[0], $p[1]), "|";
}
echo "\n";

echo "sqrt:";
foreach ($positives as $n) {
    echo sqrt($n), "|";
}
echo "\n";

echo "cbrt:";
foreach ($positives as $n) {
    echo pow($n, 1 / 3), "|";
}
echo "\n";

echo "exp:";
foreach ($angles as $n) {
    echo exp($n), "|";
}
echo "\n";

echo "log:";
foreach ($positives as $n) {
    echo log($n), "|";
}
echo "\n";

echo "log10:";
foreach ($positives as $n) {
    echo log10($n), "|";
}
echo "\n";

echo "log2:";
foreach ($positives as $n) {
    echo log($n, 2), "|";
}
echo "\n";

echo "hypot:";
foreach ($angles as $n) {
    echo hypot($n, 1.0), "|";
}
echo "\n";

echo "sin:";
foreach ($angles as $n) {
    echo sin($n), "|";
}
echo "\n";

echo "cos:";
foreach ($angles as $n) {
    echo cos($n), "|";
}
echo "\n";

echo "tan:";
foreach ($angles as $n) {
    echo tan($n), "|";
}
echo "\n";

echo "asin:";
foreach ($unit as $n) {
    echo asin($n), "|";
}
echo "\n";

echo "acos:";
foreach ($unit as $n) {
    echo acos($n), "|";
}
echo "\n";

echo "atan:";
foreach ($angles as $n) {
    echo atan($n), "|";
}
echo "\n";

echo "atan2:";
foreach ($angles as $n) {
    echo atan2($n, 2.0), ",", atan2(2.0, $n), "|";
}
echo "\n";

echo "sinh:";
foreach ($angles as $n) {
    echo sinh($n), "|";
}
echo "\n";

echo "cosh:";
foreach ($angles as $n) {
    echo cosh($n), "|";
}
echo "\n";

echo "tanh:";
foreach ($angles as $n) {
    echo tanh($n), "|";
}
echo "\n";

echo "asinh:";
foreach ($angles as $n) {
    echo asinh($n), "|";
}
echo "\n";

echo "acosh:";
foreach ($atLeastOne as $n) {
    echo acosh($n), "|";
}
echo "\n";

echo "atanh:";
foreach ($inner as $n) {
    echo atanh($n), "|";
}
echo "\n";

echo "toRadians:";
foreach ($degrees as $n) {
    echo deg2rad($n), "|";
}
echo "\n";

echo "toDegrees:";
foreach ($angles as $n) {
    echo rad2deg($n), "|";
}
echo "\n";

echo "isNan:";
foreach ($specials as $n) {
    echo flag(is_nan($n)), "|";
}
echo "\n";

echo "isFinite:";
foreach ($specials as $n) {
    echo flag(is_finite($n)), "|";
}
echo "\n";

echo "toBase:";
foreach ($naturals as $n) {
    echo decbin($n), ",", decoct($n), ",", dechex($n), ",", base_convert((string) $n, 10, 36), "|";
}
echo "\n";

echo "fromBase:";
foreach ($naturals as $n) {
    echo bindec(decbin($n)), ",", hexdec(dechex($n)), ",", (int) base_convert(base_convert((string) $n, 10, 36), 36, 10), "|";
}
echo "\n";

echo "format2:";
foreach ($amounts as $n) {
    echo number_format($n, 2, ".", ""), "|";
}
echo "\n";

echo "formatGrouped:";
foreach ($amounts as $n) {
    echo number_format($n, 2, ".", ","), "|";
}
echo "\n";

echo "format0:";
foreach ($amounts as $n) {
    echo number_format($n, 0, ".", ""), "|";
}
echo "\n";

echo "formatEuropean:";
foreach ($amounts as $n) {
    echo number_format($n, 3, ",", "."), "|";
}
echo "\n";

echo "formatInt:";
foreach ($whole as $n) {
    echo number_format($n, 1, ".", ""), "|";
}
echo "\n";

echo "constants:", M_PI, ",", M_PI * 2, ",", M_E, ",", PHP_FLOAT_EPSILON, "\n";
echo "bounds:", PHP_INT_MAX, ",", PHP_INT_MIN, ",", PHP_FLOAT_MAX, ",", PHP_FLOAT_MIN, "\n";
echo "edges:", INF, ",", -INF, ",", flag(is_nan(NAN)), "\n";

$held = 0;
$cells = 0;
foreach ($reals as $n) {
    $cells = $cells + 10;

    if (abs($n) == max($n, -$n)) {
        $held = $held + 1;
    }
    $gap = ceil($n) - floor($n);
    if ($gap == 0.0 || $gap == 1.0) {
        $held = $held + 1;
    }
    if (floor($n) <= $n) {
        $held = $held + 1;
    }
    if ($n <= ceil($n)) {
        $held = $held + 1;
    }
    if (nvs_truncate($n) + nvs_truncate(-$n) == 0.0) {
        $held = $held + 1;
    }
    if (floor(-$n) == -ceil($n)) {
        $held = $held + 1;
    }
    if (sqrt($n * $n) == max($n, -$n)) {
        $held = $held + 1;
    }
    if (hypot($n, 0.0) == max($n, -$n)) {
        $held = $held + 1;
    }
    if (min($n, 0.0) + max($n, 0.0) == $n) {
        $held = $held + 1;
    }
    if (atan2($n, 1.0) == atan($n)) {
        $held = $held + 1;
    }
}
echo $held, " of ", $cells, "\n";

$intHeld = 0;
$intCells = 0;
foreach ($pairs as $p) {
    $a = $p[0];
    $b = $p[1];
    $intCells = $intCells + 4;

    $absA = $a;
    if ($absA < 0) {
        $absA = -$absA;
    }
    $absB = $b;
    if ($absB < 0) {
        $absB = -$absB;
    }

    if (intdiv($a, $b) * $b + $a % $b == $a) {
        $intHeld = $intHeld + 1;
    }
    if (nvs_gcd($a, $b) * nvs_lcm($a, $b) == $absA * $absB) {
        $intHeld = $intHeld + 1;
    }
    if ($a % nvs_gcd($a, $b) == 0 && $b % nvs_gcd($a, $b) == 0) {
        $intHeld = $intHeld + 1;
    }
    if ((int) base_convert(dechex($absA), 16, 10) == $absA) {
        $intHeld = $intHeld + 1;
    }
}
echo $intHeld, " of ", $intCells, "\n";
