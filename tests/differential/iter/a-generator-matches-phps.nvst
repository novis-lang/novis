--TEST--
A generator drained by `foreach` yields the same sequence PHP's does, and is drained lazily
--FILE--
<?nvs
class Series {
    public static function squaresUpTo(int $n): Iterator<int> {
        var $i = 1;
        while ($i <= $n) {
            yield $i * $i;
            $i = $i + 1;
        }
    }
}

foreach (Series::squaresUpTo(5) as int $v) {
    echo $v, ";";
}
echo "\n";

int $sum = 0;
foreach (Series::squaresUpTo(4) as int $v) {
    $sum = $sum + $v;
}
echo $sum, "\n";

foreach (Series::squaresUpTo(0) as int $v) {
    echo "not reached";
}
echo "empty\n";
--ORACLE--
<?php
function squaresUpTo(int $n) {
    $i = 1;
    while ($i <= $n) {
        yield $i * $i;
        $i = $i + 1;
    }
}

foreach (squaresUpTo(5) as $v) {
    echo $v, ";";
}
echo "\n";

$sum = 0;
foreach (squaresUpTo(4) as $v) {
    $sum = $sum + $v;
}
echo $sum, "\n";

foreach (squaresUpTo(0) as $v) {
    echo "not reached";
}
echo "empty\n";
