--TEST--
Breaking out of a `foreach` over a generator stops its body at the `yield` it is suspended on, printing what PHP prints
--FILE--
<?mwl
class G {
    public static function noisy(int $n): Iterator<int> {
        int $i = 0;
        while ($i < $n) {
            echo "-", $i;
            yield $i;
            echo "+", $i;
            $i = $i + 1;
        }
        echo "!";
    }
}

foreach (G::noisy(5) as int $v) {
    if ($v == 2) {
        break;
    }
    echo "[", $v, "]";
}
echo "\n";
foreach (G::noisy(2) as int $v) {
    echo "[", $v, "]";
}
echo "\n";
--ORACLE--
<?php
function noisy($n) {
    $i = 0;
    while ($i < $n) {
        echo "-", $i;
        yield $i;
        echo "+", $i;
        $i = $i + 1;
    }
    echo "!";
}

foreach (noisy(5) as $v) {
    if ($v == 2) {
        break;
    }
    echo "[", $v, "]";
}
echo "\n";
foreach (noisy(2) as $v) {
    echo "[", $v, "]";
}
echo "\n";
