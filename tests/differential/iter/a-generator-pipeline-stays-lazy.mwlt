--TEST--
A two-stage generator pipeline — one generator drains another with `foreach` and re-yields — interleaves its stages exactly the way PHP's does
--FILE--
<?mwl
class Pipe {
    public static function source(int $upTo): Iterator<int> {
        int $i = 1;
        while ($i <= $upTo) {
            echo "s", $i, ";";
            yield $i;
            $i = $i + 1;
        }
        echo "s-end;";
    }

    public static function doubled(int $upTo): Iterator<int> {
        foreach (Pipe::source($upTo) as int $n) {
            echo "d", $n, ";";
            yield $n * 2;
        }
        echo "d-end;";
    }

    public static function first(int $upTo): int {
        foreach (Pipe::doubled($upTo) as int $n) {
            return $n;
        }
        return -1;
    }
}

foreach (Pipe::doubled(3) as int $n) {
    echo "<", $n, ">";
}
echo "\n";
echo Pipe::first(9), "\n";
--ORACLE--
<?php
function source(int $upTo) {
    $i = 1;
    while ($i <= $upTo) {
        echo "s", $i, ";";
        yield $i;
        $i = $i + 1;
    }
    echo "s-end;";
}

function doubled(int $upTo) {
    foreach (source($upTo) as $n) {
        echo "d", $n, ";";
        yield $n * 2;
    }
    echo "d-end;";
}

function first(int $upTo): int {
    foreach (doubled($upTo) as $n) {
        return $n;
    }
    return -1;
}

foreach (doubled(3) as $n) {
    echo "<", $n, ">";
}
echo "\n";
echo first(9), "\n";
