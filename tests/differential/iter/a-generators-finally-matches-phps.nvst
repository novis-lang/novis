--TEST--
A `finally` around a generator's whole body fires once, after the last resume falls off the end — PHP's ordering exactly
--FILE--
<?nvs
class G {
    public static function guarded(int $n): Iterator<int> {
        try {
            int $i = 0;
            while ($i < $n) {
                yield $i;
                $i = $i + 1;
            }
        } finally {
            echo "[done]";
        }
    }
}

foreach (G::guarded(3) as int $v) {
    echo $v;
}
echo "\n";
foreach (G::guarded(0) as int $v) {
    echo $v;
}
echo "\n";
--ORACLE--
<?php
function guarded($n) {
    try {
        $i = 0;
        while ($i < $n) {
            yield $i;
            $i = $i + 1;
        }
    } finally {
        echo "[done]";
    }
}

foreach (guarded(3) as $v) {
    echo $v;
}
echo "\n";
foreach (guarded(0) as $v) {
    echo $v;
}
echo "\n";
