--TEST--
Every `finally` an abandoned generator is suspended inside runs where PHP runs it, and prints what PHP prints — ADR 0053 § 4
--FILE--
<?nvs
// One shape is deliberately absent: a `finally` that *throws* on the way out
// of an abandoned generator. PHP reports that one as uncaught; Novis drops it,
// a release having no error edge to propagate on, and
// `nvs_runtime::Ctx::with_pending_set_aside` is where that difference is
// written down. It is a divergence to fix behind `rule:errors/escalation-ladder`'s ladder, not one to
// freeze here.
class G {
    public static function guarded(int $n): Iterator<int> {
        try {
            int $i = 0;
            while ($i < $n) {
                yield $i;
                $i = $i + 1;
            }
        } finally {
            echo "[f]";
        }
    }

    public static function nested(): Iterator<int> {
        try {
            try {
                yield 1;
            } finally {
                echo "[inner]";
            }
            yield 2;
        } finally {
            echo "[outer]";
        }
    }

    public static function partly(): Iterator<int> {
        yield 0;
        try {
            yield 1;
        } finally {
            echo "[g]";
        }
    }
}

foreach (G::guarded(5) as int $v) {
    echo $v;
    if ($v == 1) {
        break;
    }
}
echo "\n";

foreach (G::guarded(2) as int $v) {
    echo $v;
}
echo "\n";

Iterator<int> $idle = G::guarded(3);
echo "-";
echo "\n";

foreach (G::nested() as int $v) {
    echo $v;
    break;
}
echo "\n";

foreach (G::partly() as int $v) {
    echo $v;
    break;
}
echo "\n";

foreach (G::partly() as int $v) {
    echo $v;
    if ($v == 1) {
        break;
    }
}
echo "\n";

// The abandonment happens while an exception is in flight: the `finally` still
// runs, and the exception the `catch` binds is the one the loop body threw.
try {
    foreach (G::guarded(5) as int $v) {
        echo $v;
        throw new LogicError("boom");
    }
} catch (Throwable $e) {
    echo "caught ", $e->message, "\n";
}
--ORACLE--
<?php
function guarded(int $n) {
    try {
        $i = 0;
        while ($i < $n) {
            yield $i;
            $i = $i + 1;
        }
    } finally {
        echo "[f]";
    }
}

function nested() {
    try {
        try {
            yield 1;
        } finally {
            echo "[inner]";
        }
        yield 2;
    } finally {
        echo "[outer]";
    }
}

function partly() {
    yield 0;
    try {
        yield 1;
    } finally {
        echo "[g]";
    }
}

foreach (guarded(5) as $v) {
    echo $v;
    if ($v == 1) {
        break;
    }
}
echo "\n";

foreach (guarded(2) as $v) {
    echo $v;
}
echo "\n";

$idle = guarded(3);
echo "-";
echo "\n";

foreach (nested() as $v) {
    echo $v;
    break;
}
echo "\n";

foreach (partly() as $v) {
    echo $v;
    break;
}
echo "\n";

foreach (partly() as $v) {
    echo $v;
    if ($v == 1) {
        break;
    }
}
echo "\n";

try {
    foreach (guarded(5) as $v) {
        echo $v;
        throw new LogicException("boom");
    }
} catch (Throwable $e) {
    echo "caught ", $e->getMessage(), "\n";
}
