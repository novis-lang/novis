--TEST--
A `throw` from inside a generator body surfaces at the `foreach` that resumed it, after the values already yielded — PHP's own ordering
--FILE--
<?mwl
class Feed {
    public static function upTo(int $n): Iterator<int> {
        var $i = 0;
        while ($i < $n) {
            if ($i == 3) {
                throw new RuntimeError("bad element 3");
            }
            yield $i;
            $i = $i + 1;
        }
    }

    public static function drained(int $n): string {
        var $out = "";
        try {
            foreach (Feed::upTo($n) as int $v) {
                $out = $out . $v . ";";
            }
            $out = $out . "done";
        } catch (RuntimeError $e) {
            $out = $out . "!" . $e->message;
        } finally {
            $out = $out . "|closed";
        }
        return $out;
    }
}

echo Feed::drained(2), "\n";
echo Feed::drained(3), "\n";
echo Feed::drained(9), "\n";
--ORACLE--
<?php
function upTo(int $n) {
    $i = 0;
    while ($i < $n) {
        if ($i === 3) {
            throw new RuntimeException("bad element 3");
        }
        yield $i;
        $i = $i + 1;
    }
}

function drained(int $n): string {
    $out = "";
    try {
        foreach (upTo($n) as $v) {
            $out = $out . $v . ";";
        }
        $out = $out . "done";
    } catch (RuntimeException $e) {
        $out = $out . "!" . $e->getMessage();
    } finally {
        $out = $out . "|closed";
    }
    return $out;
}

echo drained(2), "\n";
echo drained(3), "\n";
echo drained(9), "\n";
