--TEST--
Nested `finally` blocks run innermost first, on the throwing path and the quiet one alike, in the same order PHP runs them
--FILE--
<?nvs
class Trace {
    public static function thrown(): string {
        var $log = "";
        try {
            try {
                $log = $log . "a";
                throw new RuntimeError("x");
            } finally {
                $log = $log . "b";
            }
        } catch (RuntimeError $e) {
            $log = $log . "c";
        } finally {
            $log = $log . "d";
        }
        return $log;
    }

    public static function quiet(): string {
        var $log = "";
        try {
            try {
                $log = $log . "a";
            } finally {
                $log = $log . "b";
            }
            $log = $log . "c";
        } finally {
            $log = $log . "d";
        }
        return $log;
    }

    public static function inner(): string {
        try {
            throw new RuntimeError("deep");
        } finally {
            echo "inner-finally;";
        }
    }

    public static function crossesAFrame(): string {
        var $log = "";
        try {
            $log = $log . Trace::inner();
        } catch (RuntimeError $e) {
            $log = $log . "caught";
        } finally {
            $log = $log . "!";
        }
        return $log;
    }
}

echo Trace::thrown(), "\n";
echo Trace::quiet(), "\n";
echo Trace::crossesAFrame(), "\n";
--ORACLE--
<?php
function thrown(): string {
    $log = "";
    try {
        try {
            $log = $log . "a";
            throw new RuntimeException("x");
        } finally {
            $log = $log . "b";
        }
    } catch (RuntimeException $e) {
        $log = $log . "c";
    } finally {
        $log = $log . "d";
    }
    return $log;
}

function quiet(): string {
    $log = "";
    try {
        try {
            $log = $log . "a";
        } finally {
            $log = $log . "b";
        }
        $log = $log . "c";
    } finally {
        $log = $log . "d";
    }
    return $log;
}

function inner(): string {
    try {
        throw new RuntimeException("deep");
    } finally {
        echo "inner-finally;";
    }
}

function crossesAFrame(): string {
    $log = "";
    try {
        $log = $log . inner();
    } catch (RuntimeException $e) {
        $log = $log . "caught";
    } finally {
        $log = $log . "!";
    }
    return $log;
}

echo thrown(), "\n";
echo quiet(), "\n";
echo crossesAFrame(), "\n";
