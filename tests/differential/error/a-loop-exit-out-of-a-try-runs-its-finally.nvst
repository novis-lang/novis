--TEST--
`break` and `continue` out of a protected region run its `finally` in exactly the order PHP runs it, one level and two
--FILE--
<?nvs
class Exits {
    public static function flat(): string {
        var $out = "";
        int $i = 0;
        while ($i < 5) {
            $i = $i + 1;
            try {
                if ($i == 2) {
                    continue;
                }
                if ($i == 4) {
                    break;
                }
                $out = $out . "b" . $i . ";";
            } finally {
                $out = $out . "f" . $i . ";";
            }
        }
        return $out;
    }

    public static function nested(): string {
        var $out = "";
        array<string> $items = ["a", "b", "c", "d"];
        foreach ($items as string $k => string $item) {
            try {
                try {
                    if ($item == "b") {
                        continue;
                    }
                    if ($item == "d") {
                        break;
                    }
                    $out = $out . $item . ";";
                } finally {
                    $out = $out . "in(" . $item . ");";
                }
            } finally {
                $out = $out . "out(" . $item . ");";
            }
        }
        return $out;
    }
}

echo Exits::flat(), "\n";
echo Exits::nested(), "\n";
--ORACLE--
<?php
function flat(): string {
    $out = "";
    $i = 0;
    while ($i < 5) {
        $i = $i + 1;
        try {
            if ($i == 2) {
                continue;
            }
            if ($i == 4) {
                break;
            }
            $out = $out . "b" . $i . ";";
        } finally {
            $out = $out . "f" . $i . ";";
        }
    }
    return $out;
}

function nested(): string {
    $out = "";
    $items = ["a", "b", "c", "d"];
    foreach ($items as $k => $item) {
        try {
            try {
                if ($item == "b") {
                    continue;
                }
                if ($item == "d") {
                    break;
                }
                $out = $out . $item . ";";
            } finally {
                $out = $out . "in(" . $item . ");";
            }
        } finally {
            $out = $out . "out(" . $item . ");";
        }
    }
    return $out;
}

echo flat(), "\n";
echo nested(), "\n";
