--TEST--
A `throw` from a constructor propagates out of the `new` that ran it, exactly as PHP's does, and the loop around it keeps counting
--FILE--
<?mwl
class Positive {
    public int $value;

    public function constructor(int $value) {
        if ($value <= 0) {
            throw new LogicError("not positive: " . $value);
        }
        $this->value = $value;
    }

    public function doubled(): int {
        return $this->value * 2;
    }
}

class Make {
    public static function orZero(int $n): int {
        try {
            var $p = new Positive($n);
            return $p->doubled();
        } catch (LogicError $e) {
            return 0;
        }
    }
}

echo Make::orZero(5), ";", Make::orZero(0), ";", Make::orZero(-3), ";", Make::orZero(1), "\n";

try {
    var $bad = new Positive(-1);
    echo "not reached";
} catch (LogicError $outer) {
    echo $outer->message, "\n";
}

int $made = 0;
int $failed = 0;
int $i = -2;
while ($i < 3) {
    try {
        var $one = new Positive($i);
        $made = $made + 1;
    } catch (LogicError $each) {
        $failed = $failed + 1;
    }
    $i = $i + 1;
}
echo $made, "/", $failed, "\n";
--ORACLE--
<?php
class Positive {
    public int $value;

    public function __construct(int $value) {
        if ($value <= 0) {
            throw new LogicException("not positive: " . $value);
        }
        $this->value = $value;
    }

    public function doubled(): int {
        return $this->value * 2;
    }
}

function orZero(int $n): int {
    try {
        $p = new Positive($n);
        return $p->doubled();
    } catch (LogicException $e) {
        return 0;
    }
}

echo orZero(5), ";", orZero(0), ";", orZero(-3), ";", orZero(1), "\n";

try {
    $bad = new Positive(-1);
    echo "not reached";
} catch (LogicException $outer) {
    echo $outer->getMessage(), "\n";
}

$made = 0;
$failed = 0;
$i = -2;
while ($i < 3) {
    try {
        $one = new Positive($i);
        $made = $made + 1;
    } catch (LogicException $each) {
        $failed = $failed + 1;
    }
    $i = $i + 1;
}
echo $made, "/", $failed, "\n";
