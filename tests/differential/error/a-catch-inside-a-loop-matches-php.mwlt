--TEST--
A `try`/`catch`/`finally` in a loop body ends the iteration, not the loop — the same trace PHP produces
--FILE--
<?mwl
class Attempts {
    public static function run(int $n): string {
        var $out = "";
        int $i = 0;
        while ($i < $n) {
            try {
                if ($i % 2 == 0) {
                    throw new LogicError("even");
                }
                $out = $out . $i;
            } catch (LogicError $e) {
                $out = $out . "!";
            } finally {
                $out = $out . ".";
            }
            $i = $i + 1;
        }
        return $out;
    }
}

echo Attempts::run(4), "\n";
echo Attempts::run(1), "\n";
echo Attempts::run(0), "\n";
--ORACLE--
<?php
function run($n) {
    $out = "";
    $i = 0;
    while ($i < $n) {
        try {
            if ($i % 2 == 0) {
                throw new LogicException("even");
            }
            $out = $out . $i;
        } catch (LogicException $e) {
            $out = $out . "!";
        } finally {
            $out = $out . ".";
        }
        $i = $i + 1;
    }
    return $out;
}

echo run(4), "\n";
echo run(1), "\n";
echo run(0), "\n";
