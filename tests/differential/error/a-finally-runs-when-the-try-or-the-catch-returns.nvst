--TEST--
A `return` from inside a `try`, from inside a loop's `try`, and from inside a `catch` clause each run the `finally` on the way out, exactly as PHP's do
--FILE--
<?mwl
class Fin {
    public static function straight(): string {
        try {
            return "from-try";
        } finally {
            echo "fin;";
        }
    }

    public static function fromALoop(int $stopAt): int {
        int $i = 0;
        while ($i < 5) {
            try {
                if ($i == $stopAt) {
                    return $i * 100;
                }
            } finally {
                echo "f", $i, ";";
            }
            $i = $i + 1;
        }
        return -1;
    }

    public static function afterACatch(int $n): string {
        try {
            if ($n == 0) {
                throw new RuntimeError("zero");
            }
            return "ok";
        } catch (RuntimeError $e) {
            return "caught";
        } finally {
            echo "done;";
        }
    }
}

echo Fin::straight(), "\n";
echo Fin::fromALoop(2), "\n";
echo Fin::fromALoop(9), "\n";
echo Fin::afterACatch(1), ";", Fin::afterACatch(0), "\n";
--ORACLE--
<?php
function straight(): string {
    try {
        return "from-try";
    } finally {
        echo "fin;";
    }
}

function fromALoop(int $stopAt): int {
    $i = 0;
    while ($i < 5) {
        try {
            if ($i === $stopAt) {
                return $i * 100;
            }
        } finally {
            echo "f", $i, ";";
        }
        $i = $i + 1;
    }
    return -1;
}

function afterACatch(int $n): string {
    try {
        if ($n === 0) {
            throw new RuntimeException("zero");
        }
        return "ok";
    } catch (RuntimeException $e) {
        return "caught";
    } finally {
        echo "done;";
    }
}

echo straight(), "\n";
echo fromALoop(2), "\n";
echo fromALoop(9), "\n";
echo afterACatch(1), ";", afterACatch(0), "\n";
