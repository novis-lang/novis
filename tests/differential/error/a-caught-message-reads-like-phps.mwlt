--TEST--
A caught throw's message is the string PHP's getMessage() returns, though MWL spells it as a property
--FILE--
<?mwl
class Parser {
    public static function positive(int $n): int {
        if ($n < 0) {
            throw new RuntimeError("negative: " . $n);
        }
        return $n;
    }
}

try {
    echo Parser::positive(4), "\n";
    echo Parser::positive(-1), "\n";
    echo "not reached\n";
} catch (Throwable $e) {
    echo "caught: ", $e->message, "\n";
}
echo "after\n";
--ORACLE--
<?php
function positive(int $n): int {
    if ($n < 0) {
        throw new RuntimeException("negative: " . $n);
    }
    return $n;
}

try {
    echo positive(4), "\n";
    echo positive(-1), "\n";
    echo "not reached\n";
} catch (Throwable $e) {
    echo "caught: ", $e->getMessage(), "\n";
}
echo "after\n";
