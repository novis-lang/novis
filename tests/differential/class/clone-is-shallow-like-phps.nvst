--TEST--
`clone` copies the object's own properties and shares what they point at, exactly as PHP's does
--FILE--
<?mwl
class Tag {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }
}

class Note {
    public string $title;
    public Tag $tag;

    public function constructor(string $title, Tag $tag) {
        $this->title = $title;
        $this->tag = $tag;
    }
}

var $original = new Note("first", new Tag("red"));
var $copy = clone $original;

$copy->title = "second";
echo $original->title, ",", $copy->title, "\n";

$copy->tag->text = "blue";
echo $original->tag->text, ",", $copy->tag->text, "\n";
--ORACLE--
<?php
class Tag {
    public string $text;

    public function __construct(string $text) {
        $this->text = $text;
    }
}

class Note {
    public string $title;
    public Tag $tag;

    public function __construct(string $title, Tag $tag) {
        $this->title = $title;
        $this->tag = $tag;
    }
}

$original = new Note("first", new Tag("red"));
$copy = clone $original;

$copy->title = "second";
echo $original->title, ",", $copy->title, "\n";

$copy->tag->text = "blue";
echo $original->tag->text, ",", $copy->tag->text, "\n";
