--TEST--
A call binds to the receiver's runtime class exactly as PHP's does — an override reached through a base-typed parameter, a base-typed local, a property and an array element
--FILE--
<?nvs
class Animal {
    public function sound(): string {
        return "...";
    }

    public function legs(): int {
        return 4;
    }
}

class Dog extends Animal {
    public function sound(): string {
        return "woof";
    }
}

class Bird extends Animal {
    public function sound(): string {
        return "tweet";
    }

    public function legs(): int {
        return 2;
    }
}

class Pen {
    public Animal $kept;

    public function constructor(Animal $kept) {
        $this->kept = $kept;
    }

    public function heard(): string {
        return $this->kept->sound();
    }
}

class Ask {
    public static function of(Animal $a): string {
        return $a->sound() . "/" . $a->legs();
    }
}

echo Ask::of(new Animal()), ";", Ask::of(new Dog()), ";", Ask::of(new Bird()), "\n";

Animal $held = new Dog();
echo $held->sound(), ";", $held->legs(), "\n";

echo (new Pen(new Bird()))->heard(), ";", (new Pen(new Animal()))->heard(), "\n";

array<Animal> $zoo = [new Bird(), new Dog(), new Animal()];
var $out = "";
foreach ($zoo as string $k => Animal $one) {
    $out = $out . $one->sound() . ",";
}
echo $out, "\n";
--ORACLE--
<?php
class Animal {
    public function sound(): string {
        return "...";
    }

    public function legs(): int {
        return 4;
    }
}

class Dog extends Animal {
    public function sound(): string {
        return "woof";
    }
}

class Bird extends Animal {
    public function sound(): string {
        return "tweet";
    }

    public function legs(): int {
        return 2;
    }
}

class Pen {
    public Animal $kept;

    public function __construct(Animal $kept) {
        $this->kept = $kept;
    }

    public function heard(): string {
        return $this->kept->sound();
    }
}

function ask(Animal $a): string {
    return $a->sound() . "/" . $a->legs();
}

echo ask(new Animal()), ";", ask(new Dog()), ";", ask(new Bird()), "\n";

$held = new Dog();
echo $held->sound(), ";", $held->legs(), "\n";

echo (new Pen(new Bird()))->heard(), ";", (new Pen(new Animal()))->heard(), "\n";

$zoo = [new Bird(), new Dog(), new Animal()];
$out = "";
foreach ($zoo as $k => $one) {
    $out = $out . $one->sound() . ",";
}
echo $out, "\n";
