--TEST--
An interface method with a body produces what PHP's abstract-class method produces — ADR 0043
--FILE--
<?nvs
interface Greets {
    public function name(): string;

    public function greet(): string {
        return "Hello, " . $this->name() . "!";
    }
}

class Person implements Greets {
    private string $personName;

    public function constructor(string $personName) {
        $this->personName = $personName;
    }

    public function name(): string {
        return $this->personName;
    }
}

class Robot implements Greets {
    public function name(): string {
        return "unit-7";
    }

    public function greet(): string {
        return "BEEP " . $this->name();
    }
}

echo (new Person("ada"))->greet(), "\n";
echo (new Robot())->greet(), "\n";
--ORACLE--
<?php
abstract class Greets {
    abstract public function name(): string;

    public function greet(): string {
        return "Hello, " . $this->name() . "!";
    }
}

class Person extends Greets {
    private string $personName;

    public function __construct(string $personName) {
        $this->personName = $personName;
    }

    public function name(): string {
        return $this->personName;
    }
}

class Robot extends Greets {
    public function name(): string {
        return "unit-7";
    }

    public function greet(): string {
        return "BEEP " . $this->name();
    }
}

echo (new Person("ada"))->greet(), "\n";
echo (new Robot())->greet(), "\n";
