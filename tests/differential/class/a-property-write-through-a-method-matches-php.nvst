--TEST--
A constructor, a property write and a method reading it back agree with PHP
--FILE--
<?nvs
class Counter {
    public int $n;

    public function constructor(int $n) {
        $this->n = $n;
    }

    public function bump(): int {
        $this->n = $this->n + 1;
        return $this->n;
    }

    public function times(int $by): int {
        return $this->n * $by;
    }
}

var $c = new Counter(2);
echo $c->n, ";", $c->bump(), ";", $c->bump(), ";", $c->n, "\n";
echo $c->times(3), "\n";
$c->n = 10;
echo $c->times(3), ";", $c->bump(), "\n";
--ORACLE--
<?php
class Counter {
    public int $n;

    public function __construct(int $n) {
        $this->n = $n;
    }

    public function bump(): int {
        $this->n = $this->n + 1;
        return $this->n;
    }

    public function times(int $by): int {
        return $this->n * $by;
    }
}

$c = new Counter(2);
echo $c->n, ";", $c->bump(), ";", $c->bump(), ";", $c->n, "\n";
echo $c->times(3), "\n";
$c->n = 10;
echo $c->times(3), ";", $c->bump(), "\n";
