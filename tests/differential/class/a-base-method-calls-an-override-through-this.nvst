--TEST--
The template-method shape resolves as PHP's does: a concrete base method calling `$this->m()` reaches the subclass override, while `parent::` beside it stays non-virtual
--FILE--
<?nvs
class Report {
    public function title(): string {
        return "report";
    }

    public function body(): string {
        return "empty";
    }

    public function render(): string {
        return "[" . $this->title() . "] " . $this->body();
    }
}

class Sales extends Report {
    public function title(): string {
        return "sales";
    }

    public function body(): string {
        return "10 sold";
    }
}

class Quarterly extends Sales {
    public function title(): string {
        return "q3 " . parent::title();
    }
}

echo (new Report())->render(), "\n";
echo (new Sales())->render(), "\n";
echo (new Quarterly())->render(), "\n";

Report $any = new Quarterly();
echo $any->render(), "\n";
echo $any->title(), "\n";
--ORACLE--
<?php
class Report {
    public function title(): string {
        return "report";
    }

    public function body(): string {
        return "empty";
    }

    public function render(): string {
        return "[" . $this->title() . "] " . $this->body();
    }
}

class Sales extends Report {
    public function title(): string {
        return "sales";
    }

    public function body(): string {
        return "10 sold";
    }
}

class Quarterly extends Sales {
    public function title(): string {
        return "q3 " . parent::title();
    }
}

echo (new Report())->render(), "\n";
echo (new Sales())->render(), "\n";
echo (new Quarterly())->render(), "\n";

$any = new Quarterly();
echo $any->render(), "\n";
echo $any->title(), "\n";
