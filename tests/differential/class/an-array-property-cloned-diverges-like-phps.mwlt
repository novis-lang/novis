--TEST--
A cloned object's array property is a value, so the first write to either copy leaves the other alone — PHP's shallow copy
--FILE--
<?mwl
class Holder {
    public array<int> $rows;

    public function constructor(array<int> $rows) {
        $this->rows = $rows;
    }

    public function line(): string {
        var $out = "";
        foreach ($this->rows as int $r) {
            $out = $out . $r . ";";
        }
        return $out;
    }
}

var $h = new Holder([1, 2, 3]);
var $copy = clone $h;
$copy->rows[] = 4;
$copy->rows[0] = 100;
echo $h->line(), "\n";
echo $copy->line(), "\n";
--ORACLE--
<?php
class Holder {
    public $rows;

    public function __construct($rows) {
        $this->rows = $rows;
    }

    public function line() {
        $out = "";
        foreach ($this->rows as $r) {
            $out = $out . $r . ";";
        }
        return $out;
    }
}

$h = new Holder([1, 2, 3]);
$copy = clone $h;
$copy->rows[] = 4;
$copy->rows[0] = 100;
echo $h->line(), "\n";
echo $copy->line(), "\n";
