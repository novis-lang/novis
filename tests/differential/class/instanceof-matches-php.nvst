--TEST--
`instanceof` answers for class, ancestor and interface exactly as PHP's does
--FILE--
<?mwl
interface Marks {
    public function mark(): string;
}

class Base implements Marks {
    public function mark(): string {
        return "base";
    }
}

class Middle extends Base {
}

class Leaf extends Middle {
}

class Other {
}

var $leaf = new Leaf();
var $other = new Other();

echo ($leaf instanceof Leaf) as string, "|\n";
echo ($leaf instanceof Middle) as string, "|\n";
echo ($leaf instanceof Base) as string, "|\n";
echo ($leaf instanceof Marks) as string, "|\n";
echo ($leaf instanceof Other) as string, "|\n";
echo ($other instanceof Marks) as string, "|\n";
echo $leaf->mark(), "|\n";
--ORACLE--
<?php
interface Marks {
    public function mark(): string;
}

class Base implements Marks {
    public function mark(): string {
        return "base";
    }
}

class Middle extends Base {
}

class Leaf extends Middle {
}

class Other {
}

$leaf = new Leaf();
$other = new Other();

echo (string)($leaf instanceof Leaf), "|\n";
echo (string)($leaf instanceof Middle), "|\n";
echo (string)($leaf instanceof Base), "|\n";
echo (string)($leaf instanceof Marks), "|\n";
echo (string)($leaf instanceof Other), "|\n";
echo (string)($other instanceof Marks), "|\n";
echo $leaf->mark(), "|\n";
