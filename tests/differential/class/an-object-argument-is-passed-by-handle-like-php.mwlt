--TEST--
An object handed to a method is the same object the caller holds, exactly as in PHP
--FILE--
<?mwl
class Box {
    public int $value;

    public function constructor(int $value) {
        $this->value = $value;
    }
}

class Filler {
    public static function fill(Box $box, int $with): void {
        $box->value = $with;
    }

    public static function read(Box $box): int {
        return $box->value;
    }
}

var $box = new Box(1);
echo Filler::read($box), ";";
Filler::fill($box, 42);
echo $box->value, ";", Filler::read($box), "\n";

var $other = $box;
$other->value = 7;
echo $box->value, "\n";
--ORACLE--
<?php
class Box {
    public int $value;

    public function __construct(int $value) {
        $this->value = $value;
    }
}

function fill(Box $box, int $with): void {
    $box->value = $with;
}

function readValue(Box $box): int {
    return $box->value;
}

$box = new Box(1);
echo readValue($box), ";";
fill($box, 42);
echo $box->value, ";", readValue($box), "\n";

$other = $box;
$other->value = 7;
echo $box->value, "\n";
