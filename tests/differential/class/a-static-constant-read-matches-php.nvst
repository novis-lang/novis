--TEST--
`static::NAME` binds to the called class exactly as PHP's does, and `self::NAME` to the declaring one
--FILE--
<?nvs
abstract class Base {
    public const string PATH = "base";

    public function viaStatic(): string {
        return static::PATH;
    }

    public function viaSelf(): string {
        return self::PATH;
    }

    public static function staticViaStatic(): string {
        return static::PATH;
    }
}

class Child extends Base {
    public const string PATH = "child";
}

class Leaf extends Child {}

echo (new Child())->viaStatic(), " ", (new Child())->viaSelf(), "\n";
echo Child::staticViaStatic(), " ", Leaf::staticViaStatic(), "\n";
--ORACLE--
<?php
abstract class Base {
    public const string PATH = "base";

    public function viaStatic(): string {
        return static::PATH;
    }

    public function viaSelf(): string {
        return self::PATH;
    }

    public static function staticViaStatic(): string {
        return static::PATH;
    }
}

class Child extends Base {
    public const string PATH = "child";
}

class Leaf extends Child {}

echo (new Child())->viaStatic(), " ", (new Child())->viaSelf(), "\n";
echo Child::staticViaStatic(), " ", Leaf::staticViaStatic(), "\n";
