--TEST--
`static::class` and `$obj::class` answer the same names PHP's do — through three levels, from a static and an instance method, and against a variable whose declared type is an ancestor
--FILE--
<?nvs
class Registry {
    public static function called(): string {
        return static::class;
    }

    public static function declaring(): string {
        return self::class;
    }

    public function mine(): string {
        return static::class;
    }
}

class MidRegistry extends Registry {
    // `parent` is the first `extends` link and stays a compile-time constant,
    // so it answers `Registry` however deep the receiver actually is.
    public function parentName(): string {
        return parent::class;
    }
}

class LeafRegistry extends MidRegistry {
}

echo Registry::called(), "\n";
echo MidRegistry::called(), "\n";
echo LeafRegistry::called(), "\n";
echo LeafRegistry::declaring(), "\n";

Registry $r = new LeafRegistry();
echo $r->mine(), "\n";
echo $r::class, "\n";

MidRegistry $mid = new LeafRegistry();
echo $mid->parentName(), "\n";
echo (new MidRegistry())::class, "\n";
echo ($r::class == "LeafRegistry") as string, "\n";
--ORACLE--
<?php
class Registry {
    public static function called(): string {
        return static::class;
    }

    public static function declaring(): string {
        return self::class;
    }

    public function mine(): string {
        return static::class;
    }
}

class MidRegistry extends Registry {
    // `parent` is the first `extends` link and stays a compile-time constant,
    // so it answers `Registry` however deep the receiver actually is.
    public function parentName(): string {
        return parent::class;
    }
}

class LeafRegistry extends MidRegistry {
}

echo Registry::called(), "\n";
echo MidRegistry::called(), "\n";
echo LeafRegistry::called(), "\n";
echo LeafRegistry::declaring(), "\n";

$r = new LeafRegistry();
echo $r->mine(), "\n";
echo $r::class, "\n";

$mid = new LeafRegistry();
echo $mid->parentName(), "\n";
echo (new MidRegistry())::class, "\n";
echo (string)($r::class == "LeafRegistry"), "\n";
