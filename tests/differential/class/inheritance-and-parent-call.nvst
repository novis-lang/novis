--TEST--
an override calling `parent::` produces what PHP's does, spelling aside
--FILE--
<?mwl
class Shape {
    protected string $shapeName;

    public function constructor(string $shapeName) {
        $this->shapeName = $shapeName;
    }

    public function describe(): string {
        return "a " . $this->shapeName;
    }
}

class Square extends Shape {
    private int $side;

    public function constructor(int $side) {
        parent::constructor("square");
        $this->side = $side;
    }

    public function describe(): string {
        return parent::describe() . " of side " . $this->side;
    }
}

echo (new Shape("blob"))->describe(), "\n";
echo (new Square(3))->describe(), "\n";
--ORACLE--
<?php
class Shape {
    protected string $shapeName;

    public function __construct(string $shapeName) {
        $this->shapeName = $shapeName;
    }

    public function describe(): string {
        return "a " . $this->shapeName;
    }
}

class Square extends Shape {
    private int $side;

    public function __construct(int $side) {
        parent::__construct("square");
        $this->side = $side;
    }

    public function describe(): string {
        return parent::describe() . " of side " . $this->side;
    }
}

echo (new Shape("blob"))->describe(), "\n";
echo (new Square(3))->describe(), "\n";
