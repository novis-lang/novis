--TEST--
an uncaught throw exits non-zero and reaches the floor as one ADR 0020 § 6 record, class and frames included
--FILE--
<?nvs
class Boom {
    public static function go(): int {
        throw new RuntimeError("no");
    }
}
echo "before\n";
echo Boom::go(), "\n";
--EXPECT--
before
--EXPECTF-ERROR--
{"level":"error","msg":"no","fields":{"class":"RuntimeError","backtrace":"#0 Boom::go() at case.nvs:%d\n#1 <script>() at case.nvs:%d"}}
