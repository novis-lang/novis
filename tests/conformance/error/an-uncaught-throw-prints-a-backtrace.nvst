--TEST--
an uncaught throw exits non-zero, naming the frames it unwound out of
--FILE--
<?mwl
class Boom {
    public static function go(): int {
        throw new RuntimeError("no");
    }
}
echo "before\n";
echo Boom::go(), "\n";
--EXPECT--
before
--EXPECTF-ERROR--
Uncaught Exception: no
#0 Boom::go() at case.mwl:%d
#1 <script>() at case.mwl:%d
