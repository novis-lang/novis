--TEST--
`unset()` on an object property is a compile error — ADR 0022's definite initialization has no way back
--FILE--
<?nvs
class Tag {
    public string $name;

    public function constructor(string $name) {
        $this->name = $name;
    }
}

var $t = new Tag("div");
unset($t->name);
echo "unreachable\n";
--EXPECT--

--EXPECTF-ERROR--
error[E0413]: `unset()` on `Tag::$name` is refused; a declared property can never become uninitialized again
   --> case.nvs:11:7
%A
error: aborting due to 1 error
