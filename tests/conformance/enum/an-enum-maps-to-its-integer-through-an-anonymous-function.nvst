--TEST--
`Core\Arr::map` over `array<Level>` with an anonymous function typed on the case yields `array<int>`, keys intact
--FILE--
<?nvs
enum Level {
    Low = 1,
    Mid = 5,
    High,
}

class Use {
    public static function mapped(array<Level> $ls): array<int> {
        return Core\Arr::map($ls, fn (Level $x): int => $x as int);
    }

    public static function doubled(array<Level> $ls): array<int> {
        return Core\Arr::map($ls, fn (Level $x): int => ($x as int) * 2);
    }
}

foreach (Use::mapped([Level::Mid, Level::High, Level::Low]) as string $k => int $v) {
    echo $k, ":", $v, ";";
}
echo "\n";
foreach (Use::doubled(["a" => Level::Low, "b" => Level::High]) as string $k => int $v) {
    echo $k, ":", $v, ";";
}
echo "\n";
--EXPECT--
0:5;1:6;2:1;
a:2;b:12;
