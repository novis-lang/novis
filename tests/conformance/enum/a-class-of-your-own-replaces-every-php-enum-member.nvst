--TEST--
Every PHP enum member is written as a method of the enum instead: a `match` for the case name, a static method for the case list, and the two conversions for `from` and `tryFrom` — `rule:enums/no-class-machinery`, `rule:enums/an-enum-body-takes-methods-and-constants`
--FILE--
<?nvs
// covers: lang:enums/what-an-enum-does-not-have
enum Level {
    Debug = 10,
    Info = 20,
    Warn = 30,

    // `rule:enums/no-class-machinery`: PHP's `->name` is the one member with no
    // conversion behind it, so it is a `match` in a method of the enum. The
    // match is exhaustive over the declaration, so a case added later stops
    // this method at compile time rather than at the first request that meets
    // it.
    public function name(): string {
        return match ($this) {
            Level::Debug => "debug",
            Level::Info => "info",
            Level::Warn => "warn",
        };
    }

    // PHP's `E::cases()`, as an ordinary static method returning `array<Level>`.
    public static function all(): array<Level> {
        return [Level::Debug, Level::Info, Level::Warn];
    }

    public static function parse(string $s): ?Level {
        foreach (self::all() as Level $l) {
            if ($l->name() == $s) {
                return $l;
            }
        }
        return null;
    }
}

echo Level::Info->name(), "\n";
echo Core\Arr::count(Level::all()), "\n";
echo (Level::parse("warn") ?? Level::Debug) as int, "\n";
echo (Level::parse("nope") ?? Level::Debug) as int, "\n";

// PHP's `E::A->value`, `E::from($n)` and `E::tryFrom($n)`, in that order.
echo Level::Warn as int, "\n";
echo (20 as Level) as int, "\n";
?Level $none = 99 as ?Level;
echo $none == null ? "null" : "some", "\n";
--EXPECT--
info
3
30
10
30
20
null
