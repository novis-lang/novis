--TEST--
A member that waits parks only the calling task: a sibling runs while it sleeps and resumes first, each task's own statements keep their order, and the waiting call answers its value with nothing to unwrap — `rule:concurrency/one-scheduler`, `rule:concurrency/a-child-belongs-to-the-calling-task`
--FILE--
<?nvs
// covers: lang:concurrency/no-colouring-i-o-just-waits
// The trace is a string and not `echo`. Output from a task is printed one
// whole task at a time, so `echo` would not show the order the tasks ran in.
class Trace {
    public static string $steps = "";
    public static bool $shortStarted = false;
    public static bool $shortRanWhileLongSlept = false;

    public static function note(string $what): void
    {
        Trace::$steps = Trace::$steps . $what . "\n";
    }
}

class Slow {
    // An ordinary static method. It has no `async`, and the call below
    // needs no promise.
    public static function value(): int
    {
        Core\Time::sleep(5ms);
        return 7;
    }
}

// `long` waits on `$shortDone` until `short` closes it.
// So `short` always wakes before `long`, on a fast or a slow machine.
var $shortDone = new Core\Task\Channel<int>(1);

Core\Task::all({
    long: fn(): void => {
        Trace::note("long starts");
        Core\Time::sleep(5ms);
        // `short` started while `long` slept. If the sleep stopped every task,
        // this would be `false`.
        Trace::$shortRanWhileLongSlept = Trace::$shortStarted;
        foreach ($shortDone as int $signal) {
        }
        Trace::note("long wakes");
    },
    short: fn(): void => {
        Trace::note("short starts");
        Trace::$shortStarted = true;
        Core\Time::sleep(5ms);
        Trace::note("short wakes");
        $shortDone->close();
    },
});

// Both tasks start before either one wakes, and each task's two lines keep
// their order.
echo Trace::$steps;
echo "short ran while long slept: ", Trace::$shortRanWhileLongSlept ? "yes" : "no", "\n";

// `$n` is an `int` and not a handle, so it is used in the same expression
// with no `await` and no callback.
int $n = Slow::value();
echo "a waiting call answers a value: ", $n * 2, "\n";
--EXPECT--
long starts
short starts
short wakes
long wakes
short ran while long slept: yes
a waiting call answers a value: 14
