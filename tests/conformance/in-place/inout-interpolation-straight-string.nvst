--TEST--
An `inout` string replaced by an interpolated string made from it has the new value in the method and in the caller — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Show {
    // Adds `s` at the end of `$name`.
    public static function run(inout string $name): void {
        $name = "{$name}s";
        echo $name, "\n";
    }
}

string $name = "shop";
Show::run(inout $name);
// The call writes `$name` back, so the caller's `$name` is `shops`.
echo $name, "\n";
--EXPECT--
shops
shops
