--TEST--
A string property reached through another property and replaced by a Novis function that throws after its change still has its old value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public string $text = "";

    public function constructor(string $text) {
        $this->text = $text;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(string $text) {
        $this->inner = new Inner($text);
    }
}

final class Lib {
    // Adds `$x` to the end of `$text`, then throws when `$x` is `!`.
    public static function add(string $text, string $x): string {
        $text .= $x;
        if ($x == "!") {
            throw new LogicError("bad text");
        }
        return $text;
    }
}

Box $box = new Box("ab");
try {
    // This call throws after it adds `!`, so `$box->inner->text` keeps `ab`.
    $box->inner->text = Lib::add($box->inner->text, "!");
    echo "not reached\n";
} catch (LogicError $e) {
    echo $e->message, ": ", $box->inner->text, "\n";
}
echo $box->inner->text, "\n";
--EXPECT--
bad text: ab
ab
