--TEST--
A local string replaced by an interpolated string between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Gen {
    public static function steps(): Iterator<string> {
        string $name = "ab";
        yield $name;
        // The new string starts with the old value of `$name`, so `$name` is `abc`.
        $name = "{$name}c";
        yield $name;
    }
}

// The first value is still `ab` after the generator changed `$name`.
array<string> $seen = [];
foreach (Gen::steps() as string $v) {
    $seen[] = $v;
}
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
ab,abc
