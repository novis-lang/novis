--TEST--
A string element of a property replaced by a Novis function in a loop has every piece the loop added — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $words = [];

    public function constructor() {
        $this->words["a"] = "ab";
        $this->words["b"] = "z";
    }

    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }
}

Box $box = new Box();
string $before = $box->words["a"];
for (int $i = 0; $i < 3; $i++) {
    $box->words["a"] = Box::add($box->words["a"], "c");
}
echo $box->words["a"], " and ", $box->words["b"], "\n";
// The copy made before the loop still has `ab`.
echo $before, "\n";
--EXPECT--
abccc and z
ab
