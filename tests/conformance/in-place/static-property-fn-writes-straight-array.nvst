--TEST--
A static array property replaced by a Novis function that also writes that property ends with the returned value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static array<int> $items = [];
}

final class Lib {
    // Sets the property to `7` and prints both arrays. Then it appends `$x` to `$items` and returns it.
    public static function grow(array<int> $items, int $x): array<int> {
        Store::$items = [7];
        echo "callee: ", Lib::show($items), " and ", Lib::show(Store::$items), "\n";
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Store::$items = [1, 2];
// The call sets the property to `7`. The statement then stores the returned `1,2,3` in it.
Store::$items = Lib::grow(Store::$items, 3);
echo Lib::show(Store::$items), "\n";
--EXPECT--
callee: 1,2 and 7
1,2,3
