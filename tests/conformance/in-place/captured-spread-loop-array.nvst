--TEST--
A captured array replaced by a spread of itself in a loop inside an anonymous function starts from the captured value on each call — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
// The function has its own copy of `$items`. Each call starts from `1,2`.
callable $f = fn(): string => {
    // Each pass adds 9 at the end, so three passes give `1,2,9,9,9`.
    for (int $i = 0; $i < 3; $i++) {
        $items = [...$items, 9];
    }
    return Lib::show($items);
};
echo $f(), "\n";
echo $f(), "\n";
// The variable outside the function is still `1,2`.
echo Lib::show($items), "\n";
--EXPECT--
1,2,9,9,9
1,2,9,9,9
1,2
