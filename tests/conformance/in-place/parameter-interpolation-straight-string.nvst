--TEST--
A string parameter replaced by an interpolated string changes only the method's copy — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Show {
    public static function run(string $name): void {
        // The new string is `$name` followed by `c`, so this prints `abc`.
        $name = "{$name}c";
        echo $name, "\n";
    }
}

string $name = "ab";
Show::run($name);
// The caller's `$name` is still `ab`.
echo $name, "\n";
--EXPECT--
abc
ab
