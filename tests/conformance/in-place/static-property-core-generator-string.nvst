--TEST--
A static string property replaced by an owning `Core` call between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "shop";

    public static function steps(): Iterator<string> {
        yield Store::$text;
        // `Core\Str::upper` changes every letter to upper case, so `Store::$text` is `SHOP`.
        Store::$text = Core\Str::upper(Store::$text);
        yield Store::$text;
    }
}

string $first = "";
bool $got = false;
foreach (Store::steps() as string $v) {
    if (!$got) {
        $first = $v;
        $got = true;
    }
}
// The first value is still `shop` after the generator changed the property.
echo $first, "\n";
echo Store::$text, "\n";
--EXPECT--
shop
SHOP
