--TEST--
A Novis function between two `yield`s that reads a static string property after it changes its parameter still sees the old value, and the value yielded before it stays unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "ab";
}

final class Lib {
    // Adds `$x` to the end of `$text`, then prints `Store::$text` and returns `$text`.
    public static function add(string $text, string $x): string {
        $text .= $x;
        echo "saw: ", Store::$text, "\n";
        return $text;
    }

    public static function steps(): Iterator<string> {
        yield Store::$text;
        // The property changes only when the call returns, so the call prints `ab`.
        Store::$text = Lib::add(Store::$text, "c");
        yield Store::$text;
    }
}

array<string> $seen = [];
foreach (Lib::steps() as string $v) {
    $seen[] = $v;
}
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
saw: ab
ab,abc
