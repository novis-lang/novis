--TEST--
An element of an object's array property replaced by an owning `Core` call has the new value, and a copy read before it keeps the old one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<array<int>> $rows = [];

    public function constructor(array<int> $a) {
        $this->rows["a"] = $a;
        $this->rows["b"] = [7];
    }
}

final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2]);
array<int> $before = $box->rows["a"];
// `Core\Arr::append` adds 3 to the end, so `$box->rows["a"]` is `1,2,3`.
$box->rows["a"] = Core\Arr::append($box->rows["a"], 3);
echo Lib::show($box->rows["a"]), "\n";
// `$before` was read before the change, so it is still `1,2`.
echo Lib::show($before), "\n";
// The other element is not changed, so `$box->rows["b"]` is still `7`.
echo Lib::show($box->rows["b"]), "\n";
--EXPECT--
1,2,3
1,2
7
