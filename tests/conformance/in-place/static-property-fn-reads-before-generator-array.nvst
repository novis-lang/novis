--TEST--
A Novis function between two `yield`s that reads a static array property before it changes its parameter sees the old value, and the value yielded before it stays unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static array<int> $items = [];
}

final class Lib {
    // Prints `Store::$items`, then appends `$x` to `$items` and returns it.
    public static function add(array<int> $items, int $x): array<int> {
        echo "saw: ", Lib::show(Store::$items), "\n";
        $items[] = $x;
        return $items;
    }

    public static function steps(): Iterator<array<int>> {
        Store::$items = [1, 2];
        yield Store::$items;
        Store::$items = Lib::add(Store::$items, 3);
        yield Store::$items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<array<int>> $seen = [];
foreach (Lib::steps() as array<int> $v) {
    $seen[] = $v;
}
// The first value is still `1,2` after the generator changed the property.
echo Lib::show($seen[0]), " then ", Lib::show($seen[1]), "\n";
--EXPECT--
saw: 1,2
1,2 then 1,2,3
