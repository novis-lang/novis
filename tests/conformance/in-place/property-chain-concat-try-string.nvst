--TEST--
An inner object's string property replaced through a property chain by a concatenation of itself before an error has its new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public string $text = "ab";
}

final class Box {
    public Inner $inner;

    public function constructor() {
        $this->inner = new Inner();
    }
}

Box $box = new Box();
try {
    $box->inner->text = $box->inner->text . "x";
    // The error comes after the statement, so the property is already `abx`.
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", $box->inner->text, "\n";
}
echo $box->inner->text, "\n";
--EXPECT--
stop: abx
abx
