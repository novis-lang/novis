--TEST--
A string property replaced through `$this` inside a `try` by a private method that cannot throw has the new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Note {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }

    // Adds `$x` to the end of `$text` and returns it.
    private function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }

    public function run(): void {
        try {
            // `add` adds `c`, so the `finally` prints `abc`.
            $this->text = $this->add($this->text, "c");
        } finally {
            echo "finally: ", $this->text, "\n";
        }
    }
}

var $note = new Note("ab");
$note->run();
echo $note->text, "\n";
--EXPECT--
finally: abc
abc
