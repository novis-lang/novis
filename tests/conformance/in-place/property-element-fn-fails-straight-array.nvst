--TEST--
An array element of a property replaced by a Novis function that can throw, called so it does not, has its new value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<array<int>> $rows = [];

    public function constructor() {
        $this->rows["a"] = [1, 2];
        $this->rows["b"] = [5];
    }

    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box();
array<int> $before = $box->rows["a"];
// 3 is not negative, so the call returns `1,2,3`.
$box->rows["a"] = Box::add($box->rows["a"], 3);
echo Box::show($box->rows["a"]), " and ", Box::show($box->rows["b"]), "\n";
echo Box::show($before), "\n";
--EXPECT--
1,2,3 and 5
1,2
