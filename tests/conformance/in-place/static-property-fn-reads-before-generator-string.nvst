--TEST--
A Novis function between two `yield`s that reads a static string property before it changes its parameter sees the old value, and the value yielded before it stays unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "ab";
}

final class Lib {
    // Prints `Store::$text`, then adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        echo "saw: ", Store::$text, "\n";
        $text .= $x;
        return $text;
    }

    public static function steps(): Iterator<string> {
        yield Store::$text;
        Store::$text = Lib::add(Store::$text, "c");
        yield Store::$text;
    }
}

array<string> $seen = [];
foreach (Lib::steps() as string $v) {
    $seen[] = $v;
}
// The first value is still `ab` after the generator changed the property.
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
saw: ab
ab,abc
