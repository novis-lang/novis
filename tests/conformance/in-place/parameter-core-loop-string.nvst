--TEST--
A string parameter replaced by a `Core` function in a loop changes only the method's copy — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Show {
    public static function run(string $name): void {
        // Each pass doubles `$name`, so three passes turn `a` into eight `a`s.
        foreach ([1, 2, 3] as var $i) {
            $name = Core\Str::repeat($name, 2);
        }
        echo $name, "\n";
    }
}

string $name = "a";
Show::run($name);
// The caller's `$name` is still `a`.
echo $name, "\n";
--EXPECT--
aaaaaaaa
a
