--TEST--
A captured array replaced by a `Core` function with a callback inside a `try` has the new value in the `finally` of each call, and the outer variable is unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2, 3];
callable $f = fn(): string => {
    try {
        // `Core\Arr::map` multiplies each value by 10, so the copy is `10,20,30`.
        $items = Core\Arr::map($items, fn(int $v): int => $v * 10);
    } finally {
        echo "finally: ", Lib::show($items), "\n";
    }
    return Lib::show($items);
};
echo $f(), "\n";
echo $f(), "\n";
// The variable outside the function still has `1,2,3`.
echo Lib::show($items), "\n";
--EXPECT--
finally: 10,20,30
10,20,30
finally: 10,20,30
10,20,30
1,2,3
