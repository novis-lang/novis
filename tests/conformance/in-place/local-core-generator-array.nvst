--TEST--
A generator's local array replaced by an owning `Core` call between two `yield`s yields its old value and then its new one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function steps(): Iterator<array<int>> {
        array<int> $items = [1, 2];
        yield $items;
        // `Core\Arr::append` adds 3 to the end, so `$items` is `1,2,3`.
        $items = Core\Arr::append($items, 3);
        yield $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

foreach (Lib::steps() as array<int> $items) {
    echo Lib::show($items), "\n";
}
--EXPECT--
1,2
1,2,3
