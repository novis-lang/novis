--TEST--
A string property replaced through `$this` by an owning `Core` call inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }

    public function shout(): void {
        try {
            // `Core\Str::upper` changes every letter to upper case, so `$this->text` is `SHOP`.
            $this->text = Core\Str::upper($this->text);
        } finally {
            echo "finally: ", $this->text, "\n";
        }
    }
}

var $box = new Box("shop");
string $before = $box->text;
$box->shout();
echo $box->text, "\n";
echo $before, "\n";
--EXPECT--
finally: SHOP
SHOP
shop
