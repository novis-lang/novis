--TEST--
A local string replaced by a `Core` function with a callback between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Gen {
    public static function steps(): Iterator<string> {
        string $name = "ab";
        yield $name;
        // The callback puts each `b` in angle brackets, so `$name` is `a<b>`.
        $name = Core\Regex::replaceWith($name, "b", fn(Core\Regex\Match $m): string => "<" . $m->text() . ">");
        yield $name;
    }
}

// The first value is still `ab` after the generator changed `$name`.
array<string> $seen = [];
foreach (Gen::steps() as string $v) {
    $seen[] = $v;
}
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
ab,a<b>
