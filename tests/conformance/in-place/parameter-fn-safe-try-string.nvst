--TEST--
A string parameter replaced by a Novis function that cannot throw, before an error, has its new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$s` and returns it.
    public static function add(string $s, string $x): string {
        $s .= $x;
        return $s;
    }

    public static function run(string $name): void {
        try {
            // `Lib::add` appends `c`, then the next line throws.
            $name = Lib::add($name, "c");
            throw new LogicError("stop");
        } catch (LogicError $e) {
            // The `catch` prints `abc`.
            echo $e->message, ": ", $name, "\n";
        }
        echo $name, "\n";
    }
}

string $name = "ab";
Lib::run($name);
// The caller's `$name` is still `ab`.
echo $name, "\n";
--EXPECT--
stop: abc
abc
ab
