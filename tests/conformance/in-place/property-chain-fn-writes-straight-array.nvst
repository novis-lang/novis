--TEST--
An inner object's array property replaced through a property chain by a Novis function that also writes that property ends with the returned value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(array<int> $items) {
        $this->inner = new Inner($items);
    }
}

final class Lib {
    // Sets the property to `7` and prints both arrays. Then it appends `$x` to `$items` and returns it.
    public static function grow(Box $box, array<int> $items, int $x): array<int> {
        $box->inner->items = [7];
        echo "callee: ", Lib::show($items), " and ", Lib::show($box->inner->items), "\n";
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2]);
// The call sets the property to `7`. The statement then stores the returned `1,2,3` in it.
$box->inner->items = Lib::grow($box, $box->inner->items, 3);
echo Lib::show($box->inner->items), "\n";
--EXPECT--
callee: 1,2 and 7
1,2,3
