--TEST--
A string element of a property replaced by a Novis function inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $words = [];

    public function constructor() {
        $this->words["a"] = "ab";
        $this->words["b"] = "z";
    }

    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }
}

Box $box = new Box();
string $before = $box->words["a"];
try {
    $box->words["a"] = Box::add($box->words["a"], "c");
} finally {
    echo "finally: ", $box->words["a"], " and ", $box->words["b"], "\n";
}
// The copy made before the `try` still has `ab`.
echo $before, "\n";
--EXPECT--
finally: abc and z
ab
