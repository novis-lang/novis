--TEST--
A generator's string property reached through another property and replaced by an owning `Core` call between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(string $text) {
        $this->inner = new Inner($text);
    }

    public function steps(): Iterator<string> {
        yield $this->inner->text;
        // `Core\Str::upper` changes each letter to upper case, so `$this->inner->text` is `SHOP`.
        $this->inner->text = Core\Str::upper($this->inner->text);
        yield $this->inner->text;
    }
}

var $box = new Box("shop");
string $first = "";
bool $got = false;
foreach ($box->steps() as string $v) {
    if (!$got) {
        $first = $v;
        $got = true;
    }
}
// The first value is still `shop` after the generator changed the property.
echo $first, "\n";
echo $box->inner->text, "\n";
--EXPECT--
shop
SHOP
