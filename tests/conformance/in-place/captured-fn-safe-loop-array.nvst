--TEST--
A captured array replaced in a loop inside a closure by a Novis function starts from the captured value on each call — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items` and returns the array.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1];
// Each pass appends one number to the closure's own copy.
callable $f = fn(): string => {
    array<int> $more = [2, 3, 4];
    foreach ($more as int $x) {
        $items = Lib::add($items, $x);
    }
    return Lib::show($items);
};
echo $f(), "\n";
echo $f(), "\n";
// The outer array still has `1`.
echo Lib::show($items), "\n";
--EXPECT--
1,2,3,4
1,2,3,4
1
