--TEST--
An array's array element replaced by a spread of itself has its new value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<array<int>> $rows = [];
$rows["a"] = [1, 2];
$rows["b"] = [3, 4];
array<int> $before = $rows["a"];
// The new array has the values of the element and then 9, so it is `1,2,9`.
$rows["a"] = [...$rows["a"], 9];
echo Lib::show($rows["a"]), "\n";
echo Lib::show($before), "\n";
// The other element does not change, so it is still `3,4`.
echo Lib::show($rows["b"]), "\n";
--EXPECT--
1,2,9
1,2
3,4
