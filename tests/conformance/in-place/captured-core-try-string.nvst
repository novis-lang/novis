--TEST--
A captured string replaced by an owning `Core` call before an error has the new value in the `catch` of each call, and the outer variable is unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
string $name = "shop";
callable $f = fn(): string => {
    try {
        // `Core\Str::slice` drops the first character of the copy, so the copy is `hop`.
        $name = Core\Str::slice($name, 1);
        throw new LogicError("stop");
    } catch (LogicError $e) {
        echo $e->message, ": ", $name, "\n";
    }
    return $name;
};
echo $f(), "\n";
echo $f(), "\n";
// The variable outside the function still has `shop`.
echo $name, "\n";
--EXPECT--
stop: hop
hop
stop: hop
hop
shop
