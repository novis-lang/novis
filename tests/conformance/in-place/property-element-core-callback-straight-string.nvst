--TEST--
A string element of an object's array property replaced by a `Core` function with a callback has the new value, and a copy read before it keeps the old one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $words = [];

    public function constructor(string $a) {
        $this->words["a"] = $a;
        $this->words["b"] = "cart";
    }
}

Box $box = new Box("shop");
string $before = $box->words["a"];
// `Core\Regex::replaceWith` calls the function for each `o`, so `$box->words["a"]` is `sh0p`.
$box->words["a"] = Core\Regex::replaceWith($box->words["a"], "o", fn(Core\Regex\Match $m): string => "0");
echo $box->words["a"], "\n";
// `$before` was read before the change, so it is still `shop`.
echo $before, "\n";
// The other element is not changed, so `$box->words["b"]` is still `cart`.
echo $box->words["b"], "\n";
--EXPECT--
sh0p
shop
cart
