--TEST--
A string element of an object's property replaced by a concatenation of itself has the new value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $rows = [];

    public function constructor() {
        $this->rows["a"] = "ab";
        $this->rows["b"] = "q";
    }
}

Box $box = new Box();
// The new string is the element followed by `x`, so the element is `abx`.
$box->rows["a"] = $box->rows["a"] . "x";
echo $box->rows["a"], " and ", $box->rows["b"], "\n";
--EXPECT--
abx and q
