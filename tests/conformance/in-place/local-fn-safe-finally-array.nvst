--TEST--
A local array replaced by a Novis function that changes its parameter has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items` and returns the array.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
try {
    $items = Lib::add($items, 3);
    echo "try: ", Lib::show($items), "\n";
} finally {
    // The `finally` block prints `1,2,3`.
    echo "finally: ", Lib::show($items), "\n";
}
echo Lib::show($items), "\n";
--EXPECT--
try: 1,2,3
finally: 1,2,3
1,2,3
