--TEST--
A generator's string parameter replaced by a concatenation between two `yield`s gives its new value, and the caller's string is unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Gen {
    // Gives `$name`, then adds `c` to it and gives the new value.
    public static function grow(string $name): Iterator<string> {
        yield $name;
        $name = $name . "c";
        yield $name;
    }
}

string $name = "ab";
foreach (Gen::grow($name) as string $v) {
    echo $v, "\n";
}
// The caller's `$name` is still `ab`.
echo $name, "\n";
--EXPECT--
ab
abc
ab
