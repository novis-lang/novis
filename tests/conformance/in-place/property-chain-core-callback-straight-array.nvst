--TEST--
An array property reached through another property and replaced by a `Core` function with a callback has the new value, and a copy read before it keeps the old one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(array<int> $items) {
        $this->inner = new Inner($items);
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2, 3]);
array<int> $before = $box->inner->items;
// `Core\Arr::map` multiplies each value by 10, so `$box->inner->items` is `10,20,30`.
$box->inner->items = Core\Arr::map($box->inner->items, fn(int $v): int => $v * 10);
echo Box::show($box->inner->items), "\n";
// `$before` was read before the change, so it is still `1,2,3`.
echo Box::show($before), "\n";
--EXPECT--
10,20,30
1,2,3
