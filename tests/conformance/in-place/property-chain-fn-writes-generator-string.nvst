--TEST--
A generator's inner object property replaced through a property chain by a Novis function that also writes that property yields its old string and then the returned one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public string $text = "ab";
}

final class Box {
    public Inner $inner;

    public function constructor() {
        $this->inner = new Inner();
    }
}

final class Lib {
    // Sets the property to `z` and prints both strings. Then it adds `$x` to `$text` and returns it.
    public static function grow(Box $box, string $text, string $x): string {
        $box->inner->text = "z";
        echo "callee: ", $text, " and ", $box->inner->text, "\n";
        $text .= $x;
        return $text;
    }

    public static function steps(): Iterator<string> {
        Box $box = new Box();
        yield $box->inner->text;
        $box->inner->text = Lib::grow($box, $box->inner->text, "c");
        yield $box->inner->text;
    }
}

// The first value is still `ab` after the property changed.
array<string> $seen = [];
foreach (Lib::steps() as string $v) {
    $seen[] = $v;
}
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
callee: ab and z
ab,abc
