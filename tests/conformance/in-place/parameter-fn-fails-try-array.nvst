--TEST--
A method whose array parameter is replaced by a Novis method that throws after its change still has the old value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public static function run(array<int> $items): void {
        try {
            $items = Lib::add($items, 3);
            echo Lib::show($items), "\n";
            // This call throws after its append, so `$items` keeps `1,2,3`.
            $items = Lib::add($items, -1);
            echo "not reached\n";
        } catch (LogicError $e) {
            echo $e->message, ": ", Lib::show($items), "\n";
        }
        echo Lib::show($items), "\n";
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
Lib::run($items);
// The caller's array is still `1,2`.
echo Lib::show($items), "\n";
--EXPECT--
1,2,3
negative: 1,2,3
1,2,3
1,2
