--TEST--
A method that replaces its array parameter with the result of a Novis method that can throw changes only its own copy — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    // Replaces `$items` with the result of `add`, then prints it.
    public static function run(array<int> $items): void {
        $items = Lib::add($items, 3);
        echo Lib::show($items), "\n";
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
Lib::run($items);
// The caller's array is still `1,2`.
echo Lib::show($items), "\n";
--EXPECT--
1,2,3
1,2
