--TEST--
A string property replaced through `$this` by an owning `Core` call has its new value, and a copy made before has its old one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }

    // `Core\Str::upper` changes every letter to upper case, so `$this->text` is `SHOP`.
    public function shout(): void {
        $this->text = Core\Str::upper($this->text);
    }
}

var $box = new Box("shop");
string $before = $box->text;
$box->shout();
echo $box->text, "\n";
// The copy made before the call still has `shop`.
echo $before, "\n";
--EXPECT--
SHOP
shop
