--TEST--
A captured array replaced inside a closure by a Novis function that can throw, called so it does not, starts from the captured value on each call — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
// 3 is not negative, so the call returns the closure's copy with `3` added.
callable $f = fn(): string => {
    $items = Lib::add($items, 3);
    return Lib::show($items);
};
echo $f(), "\n";
echo $f(), "\n";
// The outer array still has `1,2`.
echo Lib::show($items), "\n";
--EXPECT--
1,2,3
1,2,3
1,2
