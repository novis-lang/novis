--TEST--
An element of an object's array property replaced by an owning `Core` call in a loop has the value of the last pass — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<array<int>> $rows = [];

    public function constructor(array<int> $a) {
        $this->rows["a"] = $a;
        $this->rows["b"] = [7];
    }
}

final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2, 3, 4, 5, 6]);
array<int> $before = $box->rows["a"];
// Each pass drops the first value, so three passes leave `4,5,6`.
for (int $i = 0; $i < 3; $i++) {
    $box->rows["a"] = Core\Arr::slice($box->rows["a"], 1);
}
echo Lib::show($box->rows["a"]), "\n";
echo Lib::show($before), "\n";
// The other element is not changed, so `$box->rows["b"]` is still `7`.
echo Lib::show($box->rows["b"]), "\n";
--EXPECT--
4,5,6
1,2,3,4,5,6
7
