--TEST--
A string element replaced by a Novis function inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }
}

array<string> $words = [];
$words["a"] = "ab";
string $before = $words["a"];
try {
    $words["a"] = Lib::add($words["a"], "c");
} finally {
    echo "finally: ", $words["a"], "\n";
}
// The copy made before the `try` still has `ab`.
echo $before, "\n";
--EXPECT--
finally: abc
ab
