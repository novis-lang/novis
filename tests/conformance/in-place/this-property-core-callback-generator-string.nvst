--TEST--
A string property replaced through `$this` by a `Core` function with a callback between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }

    public function steps(): Iterator<string> {
        yield $this->text;
        // `Core\Regex::replaceWith` calls the function for each `o`, so `$this->text` is `sh0p`.
        $this->text = Core\Regex::replaceWith($this->text, "o", fn(Core\Regex\Match $m): string => "0");
        yield $this->text;
    }
}

var $box = new Box("shop");
string $first = "";
bool $got = false;
foreach ($box->steps() as string $v) {
    if (!$got) {
        $first = $v;
        $got = true;
    }
}
// The first value is still `shop` after the generator changed the property.
echo $first, "\n";
echo $box->text, "\n";
--EXPECT--
shop
sh0p
