--TEST--
A captured array replaced in a loop inside a closure by a Novis function that can throw, called so it does not, starts from the captured value on each call — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1];
// No number is negative, so each pass appends one number to the closure's copy.
callable $f = fn(): string => {
    array<int> $more = [2, 3, 4];
    foreach ($more as int $x) {
        $items = Lib::add($items, $x);
    }
    return Lib::show($items);
};
echo $f(), "\n";
echo $f(), "\n";
echo Lib::show($items), "\n";
--EXPECT--
1,2,3,4
1,2,3,4
1
