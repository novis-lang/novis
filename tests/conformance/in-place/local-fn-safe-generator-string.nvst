--TEST--
A local string replaced by a Novis function that changes its parameter between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }

    public static function steps(): Iterator<string> {
        string $name = "ab";
        yield $name;
        $name = Lib::add($name, "c");
        yield $name;
    }
}

// The first value is still `ab` after the generator changed `$name`.
array<string> $seen = [];
foreach (Lib::steps() as string $v) {
    $seen[] = $v;
}
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
ab,abc
