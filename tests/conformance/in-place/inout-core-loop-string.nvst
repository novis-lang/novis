--TEST--
An `inout` string replaced by an owning `Core` function in a loop has the value of the last pass in the method and in the caller — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Show {
    public static function run(inout string $name): void {
        // Each pass drops the first character, so this prints `pping`.
        foreach ([1, 2, 3] as var $i) {
            $name = Core\Str::slice($name, 1);
        }
        echo $name, "\n";
    }
}

string $name = "shopping";
Show::run(inout $name);
// The call writes `$name` back, so the caller's `$name` is `pping`.
echo $name, "\n";
--EXPECT--
pping
pping
