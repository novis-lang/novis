--TEST--
A local string replaced by a `Core` function inside a `try` has its new value in the `finally` block — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
string $name = "ab";
try {
    // `Core\Str::upper` returns the string in capital letters, so `$name` is `AB`.
    $name = Core\Str::upper($name);
    echo $name, "\n";
} finally {
    // The `finally` block sees the new value `AB`.
    echo "finally: ", $name, "\n";
}
echo $name, "\n";
--EXPECT--
AB
finally: AB
AB
