--TEST--
A local array replaced by a spread of itself has the new value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
array<int> $before = $items;
// `[...$items, 9]` is a new array with the values of `$items` and then `9`.
$items = [...$items, 9];
echo Lib::show($items), "\n";
// The copy made before still has `1,2`.
echo Lib::show($before), "\n";
--EXPECT--
1,2,9
1,2
