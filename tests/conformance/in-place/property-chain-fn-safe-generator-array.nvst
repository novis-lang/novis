--TEST--
An array property reached through another property and replaced by a Novis function between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public array<int> $items = [];

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(array<int> $items) {
        $this->inner = new Inner($items);
    }
}

final class Lib {
    // Appends `$x` to `$items` and returns it.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }

    public static function steps(): Iterator<array<int>> {
        Box $box = new Box([1, 2]);
        yield $box->inner->items;
        $box->inner->items = Lib::add($box->inner->items, 3);
        yield $box->inner->items;
    }
}

// The first value is still `1,2` after the generator changed `$box->inner->items`.
array<array<int>> $seen = [];
foreach (Lib::steps() as array<int> $v) {
    $seen[] = $v;
}
echo Lib::show($seen[0]), " then ", Lib::show($seen[1]), "\n";
--EXPECT--
1,2 then 1,2,3
