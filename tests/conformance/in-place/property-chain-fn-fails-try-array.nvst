--TEST--
An array property reached through another property and replaced by a Novis function that throws after its change still has its old value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public array<int> $items = [];

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(array<int> $items) {
        $this->inner = new Inner($items);
    }
}

final class Lib {
    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2]);
try {
    // This call throws after its append, so `$box->inner->items` keeps `1,2`.
    $box->inner->items = Lib::add($box->inner->items, -1);
    echo "not reached\n";
} catch (LogicError $e) {
    echo $e->message, ": ", Lib::show($box->inner->items), "\n";
}
echo Lib::show($box->inner->items), "\n";
--EXPECT--
negative: 1,2
1,2
