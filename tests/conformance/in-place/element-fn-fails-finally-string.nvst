--TEST--
A string element replaced inside a `try` by a Novis function that can throw, called so it does not, has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Adds `$x` to the end of `$text`, then throws when `$x` is `!`.
    public static function add(string $text, string $x): string {
        $text .= $x;
        if ($x == "!") {
            throw new LogicError("bad text");
        }
        return $text;
    }
}

array<string> $words = [];
$words["a"] = "ab";
string $before = $words["a"];
try {
    // `c` is not `!`, so the call returns `abc`.
    $words["a"] = Lib::add($words["a"], "c");
} finally {
    echo "finally: ", $words["a"], "\n";
}
echo $before, "\n";
--EXPECT--
finally: abc
ab
