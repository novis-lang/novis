--TEST--
A captured string replaced by a `Core` function with a callback between two `yield`s leaves the value yielded before it and the generator's variable unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Gen {
    public static function steps(): Iterator<string> {
        string $name = "shop";
        yield $name;
        // The callback changes each `o` in the function's own copy, so each call returns `sh0p`.
        callable(): string $f = fn(): string => {
            $name = Core\Regex::replaceWith($name, "o", fn(Core\Regex\Match $m): string => "0");
            return $name;
        };
        yield $f();
        yield $f();
        yield $name;
    }
}

string $first = "";
bool $kept = false;
foreach (Gen::steps() as string $v) {
    if (!$kept) {
        $first = $v;
        $kept = true;
    }
    echo $v, "\n";
}
// The first value is still `shop` after every change.
echo "first: ", $first, "\n";
--EXPECT--
shop
sh0p
sh0p
shop
first: shop
