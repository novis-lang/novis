--TEST--
A string property replaced through `$this` by an owning `Core` call between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }

    public function steps(): Iterator<string> {
        yield $this->text;
        // `Core\Str::upper` changes every letter to upper case, so `$this->text` is `SHOP`.
        $this->text = Core\Str::upper($this->text);
        yield $this->text;
    }
}

var $box = new Box("shop");
string $first = "";
bool $got = false;
foreach ($box->steps() as string $v) {
    if (!$got) {
        $first = $v;
        $got = true;
    }
}
// The first value is still `shop` after the generator changed the property.
echo $first, "\n";
echo $box->text, "\n";
--EXPECT--
shop
SHOP
