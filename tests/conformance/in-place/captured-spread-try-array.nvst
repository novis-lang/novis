--TEST--
A captured array replaced by a spread of itself before an error has the new value in the `catch` of each call — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
// The function has its own copy of `$items`. Each call starts from `1,2`.
callable $f = fn(): string => {
    try {
        // The new array has the values of `$items` and then 9, so the copy is `1,2,9`.
        $items = [...$items, 9];
        throw new LogicError("stop");
    } catch (LogicError $e) {
        echo $e->message, ": ", Lib::show($items), "\n";
    }
    return Lib::show($items);
};
echo $f(), "\n";
echo $f(), "\n";
// The variable outside the function is still `1,2`.
echo Lib::show($items), "\n";
--EXPECT--
stop: 1,2,9
1,2,9
stop: 1,2,9
1,2,9
1,2
