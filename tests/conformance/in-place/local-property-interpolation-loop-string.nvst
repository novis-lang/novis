--TEST--
An object's string property replaced in a loop by an interpolation of itself grows once per pass — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public string $text = "ab";
}

Box $box = new Box();
// Each pass adds `x`, so three passes give `abxxx`.
for (int $i = 0; $i < 3; $i++) {
    $box->text = "{$box->text}x";
}
echo $box->text, "\n";
--EXPECT--
abxxx
