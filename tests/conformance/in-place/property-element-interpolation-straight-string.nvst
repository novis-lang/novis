--TEST--
A string element of a class property replaced by an interpolation of itself has the new value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $rows = [];

    public function constructor() {
        $this->rows["a"] = "ab";
        $this->rows["b"] = "q";
    }

    public function run(): void {
        // The new string is the element followed by `x`, so the element is `abx`.
        $this->rows["a"] = "{$this->rows["a"]}x";
        echo $this->rows["a"], " and ", $this->rows["b"], "\n";
    }
}

Box $box = new Box();
$box->run();
--EXPECT--
abx and q
