--TEST--
An array property replaced through `$this` between two `yield`s by a private method that cannot throw leaves the first yielded value unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Bag {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }

    // Appends `$x` to `$items` and returns it.
    private function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    // Gives the property, then appends 3 to it and gives the new value.
    public function steps(): Iterator<array<int>> {
        yield $this->items;
        $this->items = $this->add($this->items, 3);
        yield $this->items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

var $bag = new Bag([1, 2]);
array<array<int>> $seen = [];
foreach ($bag->steps() as array<int> $step) {
    $seen[] = $step;
}
// The first value is still `1,2` after the property changed.
echo Bag::show($seen[0]), " ", Bag::show($seen[1]), " ", Bag::show($bag->items), "\n";
--EXPECT--
1,2 1,2,3 1,2,3
