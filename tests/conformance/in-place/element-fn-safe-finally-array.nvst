--TEST--
An array element replaced by a Novis function inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items` and returns it.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<array<int>> $rows = [];
$rows["a"] = [1, 2];
array<int> $before = $rows["a"];
try {
    $rows["a"] = Lib::add($rows["a"], 3);
} finally {
    echo "finally: ", Lib::show($rows["a"]), "\n";
}
// The copy made before the `try` still has `1,2`.
echo Lib::show($before), "\n";
--EXPECT--
finally: 1,2,3
1,2
