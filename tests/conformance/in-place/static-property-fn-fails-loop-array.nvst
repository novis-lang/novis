--TEST--
An array static property replaced in a loop by a Novis function that can throw, called so it does not, has every value the loop added — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static array<int> $items = [];
}

final class Lib {
    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Store::$items = [1, 2];
array<int> $before = Store::$items;
foreach ([3, 4, 5] as var $x) {
    Store::$items = Lib::add(Store::$items, $x);
}
echo Lib::show(Store::$items), "\n";
// The copy made before the loop still has `1,2`.
echo Lib::show($before), "\n";
--EXPECT--
1,2,3,4,5
1,2
