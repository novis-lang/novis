--TEST--
A local array replaced by a Novis function inside a `try` has the new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items` and returns it.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
try {
    $items = Lib::add($items, 3);
    // The error comes after the call, so `$items` is `1,2,3` in the `catch`.
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", Lib::show($items), "\n";
}
echo Lib::show($items), "\n";
--EXPECT--
stop: 1,2,3
1,2,3
