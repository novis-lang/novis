--TEST--
A class property string replaced in a loop by a concatenation that starts with it has the value of the last pass — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public function constructor(public string $text) {}

    public function run(): void {
        string $before = $this->text;
        array<string> $letters = ["x", "y", "z"];
        // Each pass adds one letter to the end, so `$this->text` is `abxyz`.
        foreach ($letters as string $x) {
            $this->text = $this->text . $x;
            echo $this->text, "\n";
        }
        echo "before: ", $before, "\n";
    }
}

Box $box = new Box("ab");
$box->run();
echo $box->text, "\n";
--EXPECT--
abx
abxy
abxyz
before: ab
abxyz
