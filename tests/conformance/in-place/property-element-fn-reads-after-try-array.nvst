--TEST--
An array element of a class property replaced by a method that reads it after its change has the new value in the `catch` of a later error — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<array<int>> $rows = [];

    public function constructor() {
        $this->rows["a"] = [1, 2];
        $this->rows["b"] = [5];
    }

    // Appends `$x` to `$items`, then prints `$this->rows["a"]` and returns `$items`.
    private function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        echo "saw: ", self::show($this->rows["a"]), "\n";
        return $items;
    }

    public function run(): void {
        try {
            // The method prints `1,2`, and the element is then `1,2,3`.
            $this->rows["a"] = $this->add($this->rows["a"], 3);
            throw new LogicError("stop");
        } catch (LogicError $e) {
            echo $e->message, ": ", self::show($this->rows["a"]), "\n";
        }
        echo self::show($this->rows["a"]), " and ", self::show($this->rows["b"]), "\n";
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box();
$box->run();
--EXPECT--
saw: 1,2
stop: 1,2,3
1,2,3 and 5
