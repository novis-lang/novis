--TEST--
A captured string replaced by a Novis function inside a closure made in a generator leaves the values yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }

    // Yields `$name`, then the closure's result twice, then `$name` again.
    public static function steps(): Iterator<string> {
        string $name = "ab";
        callable(): string $f = fn(): string => {
            $name = Lib::add($name, "c");
            return $name;
        };
        yield $name;
        yield $f();
        yield $f();
        yield $name;
    }
}

// The first value is still `ab` after the closure changed its copy.
array<string> $seen = [];
foreach (Lib::steps() as string $v) {
    $seen[] = $v;
}
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
ab,abc,abc,ab
