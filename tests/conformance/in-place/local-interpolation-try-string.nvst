--TEST--
A local string replaced by an interpolated string before an error has the new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
string $name = "shop";
try {
    // `{$name}` inserts the old value, so `$name` is `shops`.
    $name = "{$name}s";
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", $name, "\n";
}
echo $name, "\n";
--EXPECT--
stop: shops
shops
