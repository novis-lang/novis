--TEST--
A static array property replaced in a loop by a Novis function that also writes that property ends with the last returned value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static array<int> $items = [];
}

final class Lib {
    // Sets the property to `7` and prints both arrays. Then it appends `$x` to `$items` and returns it.
    public static function grow(array<int> $items, int $x): array<int> {
        Store::$items = [7];
        echo "callee: ", Lib::show($items), " and ", Lib::show(Store::$items), "\n";
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Store::$items = [1, 2];
// Each pass appends `$i`, so three passes give `1,2,3,4,5`.
for (int $i = 3; $i <= 5; $i++) {
    Store::$items = Lib::grow(Store::$items, $i);
}
echo Lib::show(Store::$items), "\n";
--EXPECT--
callee: 1,2 and 7
callee: 1,2,3 and 7
callee: 1,2,3,4 and 7
1,2,3,4,5
