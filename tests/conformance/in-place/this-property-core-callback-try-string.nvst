--TEST--
A string property replaced through `$this` by a `Core` function with a callback before an error has the new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }

    public function swap(): void {
        try {
            // `Core\Regex::replaceWith` calls the function for each `o`, so `$this->text` is `sh0p`.
            $this->text = Core\Regex::replaceWith($this->text, "o", fn(Core\Regex\Match $m): string => "0");
            throw new LogicError("stop");
        } catch (LogicError $e) {
            echo $e->message, ": ", $this->text, "\n";
        }
        echo $this->text, "\n";
    }
}

var $box = new Box("shop");
string $before = $box->text;
$box->swap();
echo $before, "\n";
--EXPECT--
stop: sh0p
sh0p
shop
