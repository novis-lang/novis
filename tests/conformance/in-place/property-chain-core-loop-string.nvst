--TEST--
A string property reached through another property and replaced by an owning `Core` call in a loop has the value of the last pass — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(string $text) {
        $this->inner = new Inner($text);
    }
}

Box $box = new Box("shopping");
string $before = $box->inner->text;
// Each pass drops the first character, so three passes leave `pping`.
for (int $i = 0; $i < 3; $i++) {
    $box->inner->text = Core\Str::slice($box->inner->text, 1);
}
echo $box->inner->text, "\n";
echo $before, "\n";
--EXPECT--
pping
shopping
