--TEST--
An array property replaced inside a `try` by a method that reads the property after its change has the new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Bag {
    public array<int> $items = [];

    public function constructor() {
        $this->items = [1, 2];
    }

    // Appends `$x` to `$items`, then prints `$this->items`.
    private function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        echo "saw: ", Bag::show($this->items), "\n";
        return $items;
    }

    public function run(): void {
        try {
            // The method prints `1,2`. The property is `1,2,3` once the call returns.
            $this->items = $this->add($this->items, 3);
        } finally {
            echo "finally: ", Bag::show($this->items), "\n";
        }
        echo Bag::show($this->items), "\n";
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Bag $bag = new Bag();
$bag->run();
--EXPECT--
saw: 1,2
finally: 1,2,3
1,2,3
