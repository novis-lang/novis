--TEST--
An array's string element replaced by an interpolation of itself has its new value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
array<string> $words = [];
$words["a"] = "ab";
$words["b"] = "cd";
string $before = $words["a"];
// The new string is the element followed by `x`, so the element is `abx`.
$words["a"] = "{$words["a"]}x";
echo $words["a"], "\n";
echo $before, "\n";
// The other element does not change, so it is still `cd`.
echo $words["b"], "\n";
--EXPECT--
abx
ab
cd
