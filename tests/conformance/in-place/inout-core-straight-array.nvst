--TEST--
An `inout` array parameter replaced by a `Core` result has the new value inside the method and in the caller after the call — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `3` to `$items` and prints it.
    public static function run(inout array<int> $items): void {
        $items = Core\Arr::append($items, 3);
        echo Lib::show($items), "\n";
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
Lib::run(inout $items);
// `inout` writes the new value back, so the caller's array is `1,2,3`.
echo Lib::show($items), "\n";
--EXPECT--
1,2,3
1,2,3
