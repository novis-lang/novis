--TEST--
A static string property replaced by a Novis function that also writes that property ends with the returned value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "ab";
}

final class Lib {
    // Sets the property to `z` and prints both strings. Then it adds `$x` to `$text` and returns it.
    public static function grow(string $text, string $x): string {
        Store::$text = "z";
        echo "callee: ", $text, " and ", Store::$text, "\n";
        $text .= $x;
        return $text;
    }
}

// The call sets the property to `z`. The statement then stores the returned `abc` in it.
Store::$text = Lib::grow(Store::$text, "c");
echo Store::$text, "\n";
--EXPECT--
callee: ab and z
abc
