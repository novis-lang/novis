--TEST--
A generator's array property reached through another property and replaced by a `Core` function with a callback between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(array<int> $items) {
        $this->inner = new Inner($items);
    }

    public function steps(): Iterator<array<int>> {
        yield $this->inner->items;
        // `Core\Arr::map` multiplies each value by 10, so `$this->inner->items` is `10,20,30`.
        $this->inner->items = Core\Arr::map($this->inner->items, fn(int $v): int => $v * 10);
        yield $this->inner->items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

var $box = new Box([1, 2, 3]);
array<int> $first = [];
bool $got = false;
foreach ($box->steps() as array<int> $v) {
    if (!$got) {
        $first = $v;
        $got = true;
    }
}
// The first value is still `1,2,3` after the generator changed the property.
echo Box::show($first), "\n";
echo Box::show($box->inner->items), "\n";
--EXPECT--
1,2,3
10,20,30
