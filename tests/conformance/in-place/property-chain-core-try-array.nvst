--TEST--
An array property reached through another property and replaced by an owning `Core` call inside a `try` has its new value in the `catch` of a later error — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(array<int> $items) {
        $this->inner = new Inner($items);
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2]);
try {
    // `Core\Arr::append` adds 3, so `$box->inner->items` is `1,2,3` before the error.
    $box->inner->items = Core\Arr::append($box->inner->items, 3);
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", Box::show($box->inner->items), "\n";
}
echo Box::show($box->inner->items), "\n";
--EXPECT--
stop: 1,2,3
1,2,3
