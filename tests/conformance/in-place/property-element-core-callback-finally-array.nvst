--TEST--
An element of an object's array property replaced by a `Core` function with a callback inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<array<int>> $rows = [];

    public function constructor(array<int> $a) {
        $this->rows["a"] = $a;
        $this->rows["b"] = [7];
    }
}

final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2, 3]);
try {
    // `Core\Arr::map` multiplies each value by 10, so `$box->rows["a"]` is `10,20,30`.
    $box->rows["a"] = Core\Arr::map($box->rows["a"], fn(int $v): int => $v * 10);
} finally {
    echo "finally: ", Lib::show($box->rows["a"]), "\n";
}
echo Lib::show($box->rows["a"]), " ", Lib::show($box->rows["b"]), "\n";
--EXPECT--
finally: 10,20,30
10,20,30 7
