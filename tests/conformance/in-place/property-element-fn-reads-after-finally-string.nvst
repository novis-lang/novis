--TEST--
A method inside a `try` that reads a string element of a class property after it changes its parameter still sees the old value, and the `finally` sees the new one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $rows = [];

    public function constructor() {
        $this->rows["a"] = "ab";
        $this->rows["b"] = "xy";
    }

    // Adds `$x` to the end of `$text`, then prints `$this->rows["a"]` and returns `$text`.
    private function add(string $text, string $x): string {
        $text .= $x;
        echo "saw: ", $this->rows["a"], "\n";
        return $text;
    }

    public function run(): void {
        try {
            $this->rows["a"] = $this->add($this->rows["a"], "c");
        } finally {
            // The `finally` block prints `abc`.
            echo "finally: ", $this->rows["a"], "\n";
        }
        echo $this->rows["a"], " and ", $this->rows["b"], "\n";
    }
}

Box $box = new Box();
$box->run();
--EXPECT--
saw: ab
finally: abc
abc and xy
