--TEST--
A string property replaced through `$this` by a private method that can throw, called so it does not, has the new value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Note {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }

    // Adds `$x` to the end of `$text`, then throws when `$x` is `!`.
    private function add(string $text, string $x): string {
        $text .= $x;
        if ($x == "!") {
            throw new LogicError("bad text");
        }
        return $text;
    }

    public function run(): void {
        // `c` is not `!`, so `$this->text` is `abc`.
        $this->text = $this->add($this->text, "c");
        echo $this->text, "\n";
    }
}

var $note = new Note("ab");
$note->run();
echo $note->text, "\n";
--EXPECT--
abc
abc
