--TEST--
A string element of an object's array property replaced by a `Core` function with a callback inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $words = [];

    public function constructor(string $a) {
        $this->words["a"] = $a;
        $this->words["b"] = "cart";
    }
}

Box $box = new Box("shop");
try {
    // `Core\Regex::replaceWith` calls the function for each `o`, so `$box->words["a"]` is `sh0p`.
    $box->words["a"] = Core\Regex::replaceWith($box->words["a"], "o", fn(Core\Regex\Match $m): string => "0");
} finally {
    echo "finally: ", $box->words["a"], "\n";
}
echo $box->words["a"], " ", $box->words["b"], "\n";
--EXPECT--
finally: sh0p
sh0p cart
