--TEST--
A static array property replaced by a Novis function that also writes that property has the returned value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static array<int> $items = [];
}

final class Lib {
    // Sets the property to `7` and prints both arrays. Then it appends `$x` to `$items` and returns it.
    public static function grow(array<int> $items, int $x): array<int> {
        Store::$items = [7];
        echo "callee: ", Lib::show($items), " and ", Lib::show(Store::$items), "\n";
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Store::$items = [1, 2];
try {
    Store::$items = Lib::grow(Store::$items, 3);
    // The error comes after the statement, so the property is already `1,2,3`.
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", Lib::show(Store::$items), "\n";
}
echo Lib::show(Store::$items), "\n";
--EXPECT--
callee: 1,2 and 7
stop: 1,2,3
1,2,3
