--TEST--
An `inout` string replaced by a `Core` function with a callback before an error is not written back to the caller — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Show {
    // The callback puts an `o` before the last `p`, then the method throws.
    public static function run(inout string $name): void {
        $name = Core\Regex::replaceWith($name, "p$", fn(Core\Regex\Match $m): string => "o" . $m->text());
        echo $name, "\n";
        throw new LogicError("stop");
    }
}

string $name = "shop";
try {
    Show::run(inout $name);
    echo "not reached\n";
} catch (LogicError $e) {
    // The call threw, so the caller's `$name` is still `shop`.
    echo $e->message, ": ", $name, "\n";
}
echo $name, "\n";
--EXPECT--
shoop
stop: shop
shop
