--TEST--
A generator's parameter array replaced by a `Core` function with a callback between two `yield`s yields its old value and then its new one, and the caller's array is unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Yields `$items`, replaces it with each value doubled, and yields it again.
    public static function steps(array<int> $items): Iterator<array<int>> {
        yield $items;
        $items = Core\Arr::map($items, fn(int $v): int => $v * 2);
        yield $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2, 3];
// This loop prints `1,2,3` and then `2,4,6`.
foreach (Lib::steps($items) as array<int> $step) {
    echo Lib::show($step), "\n";
}
// The caller's array still has `1,2,3`.
echo Lib::show($items), "\n";
--EXPECT--
1,2,3
2,4,6
1,2,3
