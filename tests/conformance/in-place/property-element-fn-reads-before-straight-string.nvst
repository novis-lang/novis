--TEST--
A method that reads a string element of a class property before it changes its parameter sees the old value, and the element then has the new one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $rows = [];

    public function constructor() {
        $this->rows["a"] = "ab";
        $this->rows["b"] = "xy";
    }

    // Prints `$this->rows["a"]`, then adds `$x` to the end of `$text` and returns it.
    private function add(string $text, string $x): string {
        echo "saw: ", $this->rows["a"], "\n";
        $text .= $x;
        return $text;
    }

    public function run(): void {
        // The method prints `ab`. Then the element is `abc`.
        $this->rows["a"] = $this->add($this->rows["a"], "c");
        echo $this->rows["a"], " and ", $this->rows["b"], "\n";
    }
}

Box $box = new Box();
$box->run();
--EXPECT--
saw: ab
abc and xy
