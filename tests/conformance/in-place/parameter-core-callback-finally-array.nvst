--TEST--
A parameter array replaced by a `Core` function with a callback inside a `try` has its new value in the `finally`, and the caller's array is unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Replaces `$items` with each value doubled. The `finally` prints `2,4,6`.
    public static function double(array<int> $items): array<int> {
        try {
            $items = Core\Arr::map($items, fn(int $v): int => $v * 2);
        } finally {
            echo "finally: ", Lib::show($items), "\n";
        }
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2, 3];
array<int> $out = Lib::double($items);
echo Lib::show($out), "\n";
// The caller's array still has `1,2,3`.
echo Lib::show($items), "\n";
--EXPECT--
finally: 2,4,6
2,4,6
1,2,3
