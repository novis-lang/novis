--TEST--
A static array property replaced in a generator by a Novis function that also writes that property yields its old value and then the returned one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static array<int> $items = [];
}

final class Lib {
    // Sets the property to `7` and prints both arrays. Then it appends `$x` to `$items` and returns it.
    public static function grow(array<int> $items, int $x): array<int> {
        Store::$items = [7];
        echo "callee: ", Lib::show($items), " and ", Lib::show(Store::$items), "\n";
        $items[] = $x;
        return $items;
    }

    public static function steps(): Iterator<array<int>> {
        Store::$items = [1, 2];
        yield Store::$items;
        Store::$items = Lib::grow(Store::$items, 3);
        yield Store::$items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

// The first value is still `1,2` after the property changed.
array<array<int>> $seen = [];
foreach (Lib::steps() as array<int> $v) {
    $seen[] = $v;
}
echo Lib::show($seen[0]), " then ", Lib::show($seen[1]), "\n";
--EXPECT--
callee: 1,2 and 7
1,2 then 1,2,3
