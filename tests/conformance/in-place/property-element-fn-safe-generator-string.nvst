--TEST--
A string element of a property replaced through `$this` by a Novis function between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $words = [];

    public function constructor() {
        $this->words["a"] = "ab";
        $this->words["b"] = "z";
    }

    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }

    public function steps(): Iterator<string> {
        yield $this->words["a"];
        $this->words["a"] = Box::add($this->words["a"], "c");
        yield $this->words["a"];
    }
}

Box $box = new Box();
array<string> $seen = [];
foreach ($box->steps() as string $v) {
    $seen[] = $v;
}
// The first value is still `ab` after the generator changed `$this->words["a"]`.
echo Core\Str::join($seen, ","), " and ", $box->words["b"], "\n";
--EXPECT--
ab,abc and z
