--TEST--
A method that replaces its array parameter with a `Core` result made with a callback and then throws still has the new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Doubles each number in `$items`, then throws. The `catch` prints `2,4`.
    public static function run(array<int> $items): void {
        try {
            $items = Core\Arr::map($items, fn(int $v): int => $v * 2);
            throw new LogicError("stop");
        } catch (LogicError $e) {
            echo $e->message, ": ", Lib::show($items), "\n";
        }
        echo Lib::show($items), "\n";
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
Lib::run($items);
// The caller's array is still `1,2`.
echo Lib::show($items), "\n";
--EXPECT--
stop: 2,4
2,4
1,2
