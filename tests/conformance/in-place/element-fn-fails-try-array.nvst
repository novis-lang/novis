--TEST--
An array element replaced by a Novis function that throws after its change still has its old value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<array<int>> $rows = [];
$rows["a"] = [1, 2];
try {
    // This call throws after its append, so `$rows["a"]` keeps `1,2`.
    $rows["a"] = Lib::add($rows["a"], -1);
    echo "not reached\n";
} catch (LogicError $e) {
    echo $e->message, ": ", Lib::show($rows["a"]), "\n";
}
echo Lib::show($rows["a"]), "\n";
--EXPECT--
negative: 1,2
1,2
