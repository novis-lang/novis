--TEST--
An `inout` string replaced by a `Core` function with a callback inside a `try` has its new value in the `finally` and in the caller — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Show {
    // The callback puts an `o` before the last `p`. The `finally` block prints the new value.
    public static function run(inout string $name): void {
        try {
            $name = Core\Regex::replaceWith($name, "p$", fn(Core\Regex\Match $m): string => "o" . $m->text());
        } finally {
            echo "finally: ", $name, "\n";
        }
    }
}

string $name = "shop";
Show::run(inout $name);
// The call writes `$name` back, so the caller's `$name` is `shoop`.
echo $name, "\n";
--EXPECT--
finally: shoop
shoop
