--TEST--
An array element replaced by a `Core` function with a callback has the new value, and a copy read before it keeps the old one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<array<int>> $rows = [];
$rows["a"] = [1, 2, 3];
array<int> $before = $rows["a"];
// `Core\Arr::map` multiplies each value by 10, so `$rows["a"]` is `10,20,30`.
$rows["a"] = Core\Arr::map($rows["a"], fn(int $v): int => $v * 10);
echo Lib::show($rows["a"]), "\n";
// `$before` was read before the change, so it is still `1,2,3`.
echo Lib::show($before), "\n";
--EXPECT--
10,20,30
1,2,3
