--TEST--
A string property reached through another property and replaced by a Novis function that can throw between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public string $text = "";

    public function constructor(string $text) {
        $this->text = $text;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(string $text) {
        $this->inner = new Inner($text);
    }
}

final class Lib {
    // Adds `$x` to the end of `$text`, then throws when `$x` is `!`.
    public static function add(string $text, string $x): string {
        $text .= $x;
        if ($x == "!") {
            throw new LogicError("bad text");
        }
        return $text;
    }

    public static function steps(): Iterator<string> {
        Box $box = new Box("ab");
        yield $box->inner->text;
        // `c` is not `!`, so this call returns `abc`.
        $box->inner->text = Lib::add($box->inner->text, "c");
        yield $box->inner->text;
    }
}

// The first value is still `ab` after the generator changed `$box->inner->text`.
array<string> $seen = [];
foreach (Lib::steps() as string $v) {
    $seen[] = $v;
}
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
ab,abc
