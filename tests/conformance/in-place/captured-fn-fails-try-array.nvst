--TEST--
A captured array replaced inside a closure by a Novis function that throws after its change keeps its old value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
callable $f = fn(): string => {
    try {
        $items = Lib::add($items, 3);
        // This call throws after its append, so the closure's copy keeps `1,2,3`.
        $items = Lib::add($items, -1);
    } catch (LogicError $e) {
        echo $e->message, ": ", Lib::show($items), "\n";
    }
    return Lib::show($items);
};
echo $f(), "\n";
echo $f(), "\n";
echo Lib::show($items), "\n";
--EXPECT--
negative: 1,2,3
1,2,3
negative: 1,2,3
1,2,3
1,2
