--TEST--
An array property reached through another property and replaced by a `Core` function with a callback inside a `try` has its new value in the `catch` of a later error — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(array<int> $items) {
        $this->inner = new Inner($items);
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2, 3, 4]);
try {
    // `Core\Arr::filter` keeps the even values, so `$box->inner->items` is `2,4` before the error.
    $box->inner->items = Core\Arr::filter($box->inner->items, fn(int $v): bool => $v % 2 == 0);
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", Box::show($box->inner->items), "\n";
}
echo Box::show($box->inner->items), "\n";
--EXPECT--
stop: 2,4
2,4
