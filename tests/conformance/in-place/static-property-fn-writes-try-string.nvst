--TEST--
A static string property replaced by a Novis function that also writes that property has the returned value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "ab";
}

final class Lib {
    // Sets the property to `z` and prints both strings. Then it adds `$x` to `$text` and returns it.
    public static function grow(string $text, string $x): string {
        Store::$text = "z";
        echo "callee: ", $text, " and ", Store::$text, "\n";
        $text .= $x;
        return $text;
    }
}

try {
    Store::$text = Lib::grow(Store::$text, "c");
    // The error comes after the statement, so the property is already `abc`.
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", Store::$text, "\n";
}
echo Store::$text, "\n";
--EXPECT--
callee: ab and z
stop: abc
abc
