--TEST--
A string property of a generator's local object replaced by a Novis function between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public string $text = "";

    public function constructor(string $text) {
        $this->text = $text;
    }
}

final class Lib {
    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }

    public static function steps(): Iterator<string> {
        Box $box = new Box("ab");
        yield $box->text;
        $box->text = Lib::add($box->text, "c");
        yield $box->text;
    }
}

// The first value is still `ab` after the generator changed `$box->text`.
array<string> $seen = [];
foreach (Lib::steps() as string $v) {
    $seen[] = $v;
}
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
ab,abc
