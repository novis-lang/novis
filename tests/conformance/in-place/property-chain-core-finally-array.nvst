--TEST--
An array property reached through another property and replaced by an owning `Core` call inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(array<int> $items) {
        $this->inner = new Inner($items);
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2, 3]);
try {
    // `Core\Arr::slice` drops the first value, so `$box->inner->items` is `2,3`.
    $box->inner->items = Core\Arr::slice($box->inner->items, 1);
} finally {
    echo "finally: ", Box::show($box->inner->items), "\n";
}
echo Box::show($box->inner->items), "\n";
--EXPECT--
finally: 2,3
2,3
