--TEST--
A static array property replaced by `Core\Arr::map` before an error has the new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static array<int> $items = [];

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Store::$items = [1, 2];
array<int> $before = Store::$items;
try {
    // `Core\Arr::map` doubles every value, so `Store::$items` is `2,4`.
    Store::$items = Core\Arr::map(Store::$items, fn(int $v): int => $v * 2);
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", Store::show(Store::$items), "\n";
}
echo Store::show(Store::$items), "\n";
echo Store::show($before), "\n";
--EXPECT--
stop: 2,4
2,4
1,2
