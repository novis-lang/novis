--TEST--
An array property replaced through `$this` by an owning `Core` call between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }

    public function steps(): Iterator<array<int>> {
        yield $this->items;
        // `Core\Arr::append` adds 3 to the end, so `$this->items` is `1,2,3`.
        $this->items = Core\Arr::append($this->items, 3);
        yield $this->items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

var $box = new Box([1, 2]);
array<int> $first = [];
bool $got = false;
foreach ($box->steps() as array<int> $v) {
    if (!$got) {
        $first = $v;
        $got = true;
    }
}
// The first value is still `1,2` after the generator changed the property.
echo Box::show($first), "\n";
echo Box::show($box->items), "\n";
--EXPECT--
1,2
1,2,3
