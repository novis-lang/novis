--TEST--
An array property replaced through `$this` by an owning `Core` call before an error has the new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }

    public function grow(): void {
        try {
            // `Core\Arr::slice` removes the first value, so `$this->items` is `2,3`.
            $this->items = Core\Arr::slice($this->items, 1);
            throw new LogicError("stop");
        } catch (LogicError $e) {
            echo $e->message, ": ", Box::show($this->items), "\n";
        }
        echo Box::show($this->items), "\n";
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

var $box = new Box([1, 2, 3]);
array<int> $before = $box->items;
$box->grow();
echo Box::show($before), "\n";
--EXPECT--
stop: 2,3
2,3
1,2,3
