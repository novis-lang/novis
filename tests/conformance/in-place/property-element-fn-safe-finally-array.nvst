--TEST--
An array element of a property replaced by a Novis function inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<array<int>> $rows = [];

    public function constructor() {
        $this->rows["a"] = [1, 2];
        $this->rows["b"] = [5];
    }

    // Appends `$x` to `$items` and returns it.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box();
array<int> $before = $box->rows["a"];
try {
    $box->rows["a"] = Box::add($box->rows["a"], 3);
} finally {
    echo "finally: ", Box::show($box->rows["a"]), " and ", Box::show($box->rows["b"]), "\n";
}
// The copy made before the `try` still has `1,2`.
echo Box::show($before), "\n";
--EXPECT--
finally: 1,2,3 and 5
1,2
