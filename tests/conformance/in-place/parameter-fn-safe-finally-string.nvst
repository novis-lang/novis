--TEST--
A string parameter replaced by a Novis function that changes its own parameter inside a `try` has its new value in the `finally`, and the caller's string is unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Adds `$x` to the end of `$s` and returns it.
    public static function add(string $s, string $x): string {
        $s .= $x;
        return $s;
    }

    // Adds `c` to `$name` inside a `try`. The `finally` block prints the new value.
    public static function grow(string $name): string {
        try {
            $name = Lib::add($name, "c");
        } finally {
            echo "finally: ", $name, "\n";
        }
        return $name;
    }
}

string $name = "ab";
echo Lib::grow($name), "\n";
// The caller's `$name` is still `ab`.
echo $name, "\n";
--EXPECT--
finally: abc
abc
ab
