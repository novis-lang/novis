--TEST--
A string array element replaced by an owning `Core` call in a loop has the value of the last pass — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
array<string> $words = [];
$words["a"] = "shopping";
$words["b"] = "cart";
string $before = $words["a"];
// Each pass drops the first character, so three passes leave `pping`.
for (int $i = 0; $i < 3; $i++) {
    $words["a"] = Core\Str::slice($words["a"], 1);
}
echo $words["a"], "\n";
echo $before, "\n";
// The other element is not changed, so `$words["b"]` is still `cart`.
echo $words["b"], "\n";
--EXPECT--
pping
shopping
cart
