--TEST--
A string element of a class property replaced in a loop by a method that writes the same element has the value of the last pass — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $rows = [];

    public function constructor() {
        $this->rows["a"] = "ab";
        $this->rows["b"] = "q";
    }

    // Sets `$this->rows["a"]` to `z`, then appends `$x` to `$text` and returns it.
    private function add(string $text, string $x): string {
        $this->rows["a"] = "z";
        echo "callee: ", $text, " / ", $this->rows["a"], "\n";
        $text .= $x;
        return $text;
    }

    public function run(): void {
        array<string> $xs = ["c", "d", "e"];
        // Each pass replaces the `z` with the returned string, so the element ends as `abcde`.
        foreach ($xs as string $x) {
            $this->rows["a"] = $this->add($this->rows["a"], $x);
        }
        echo $this->rows["a"], " and ", $this->rows["b"], "\n";
    }
}

Box $box = new Box();
$box->run();
--EXPECT--
callee: ab / z
callee: abc / z
callee: abcd / z
abcde and q
