--TEST--
An array element of a property replaced through `$this` by a Novis function between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<array<int>> $rows = [];

    public function constructor() {
        $this->rows["a"] = [1, 2];
        $this->rows["b"] = [5];
    }

    // Appends `$x` to `$items` and returns it.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }

    public function steps(): Iterator<array<int>> {
        yield $this->rows["a"];
        $this->rows["a"] = Box::add($this->rows["a"], 3);
        yield $this->rows["a"];
    }
}

Box $box = new Box();
array<array<int>> $seen = [];
foreach ($box->steps() as array<int> $v) {
    $seen[] = $v;
}
// The first value is still `1,2` after the generator changed `$this->rows["a"]`.
echo Box::show($seen[0]), " then ", Box::show($seen[1]), " and ", Box::show($box->rows["b"]), "\n";
--EXPECT--
1,2 then 1,2,3 and 5
