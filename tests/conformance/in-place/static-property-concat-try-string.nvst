--TEST--
A static string property replaced by a concatenation of itself before an error has its new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "ab";
}

try {
    Store::$text = Store::$text . "x";
    // The error comes after the statement, so the property is already `abx`.
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", Store::$text, "\n";
}
echo Store::$text, "\n";
--EXPECT--
stop: abx
abx
