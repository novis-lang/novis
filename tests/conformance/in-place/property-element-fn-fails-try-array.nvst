--TEST--
An array element of a property replaced by a Novis function that throws after its change still has its old value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<array<int>> $rows = [];

    public function constructor() {
        $this->rows["a"] = [1, 2];
        $this->rows["b"] = [5];
    }

    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box();
try {
    // This call throws after its append, so `$box->rows["a"]` keeps `1,2`.
    $box->rows["a"] = Box::add($box->rows["a"], -1);
    echo "not reached\n";
} catch (LogicError $e) {
    echo $e->message, ": ", Box::show($box->rows["a"]), "\n";
}
echo Box::show($box->rows["a"]), " and ", Box::show($box->rows["b"]), "\n";
--EXPECT--
negative: 1,2
1,2 and 5
