--TEST--
A local array replaced by a Novis function in a loop has every value the loop added — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$items` and returns it.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
array<int> $before = $items;
foreach ([3, 4, 5] as var $x) {
    $items = Lib::add($items, $x);
}
echo Lib::show($items), "\n";
// The copy made before the loop still has `1,2`.
echo Lib::show($before), "\n";
--EXPECT--
1,2,3,4,5
1,2
