--TEST--
A Novis function that reads a static array property before it changes its parameter sees the old value, and the property then has the new one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static array<int> $items = [];
}

final class Lib {
    // Prints `Store::$items`, then appends `$x` to `$items` and returns it.
    public static function add(array<int> $items, int $x): array<int> {
        echo "saw: ", Lib::show(Store::$items), "\n";
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Store::$items = [1, 2];
// The call prints `1,2`. Then the property is `1,2,3`.
Store::$items = Lib::add(Store::$items, 3);
echo Lib::show(Store::$items), "\n";
--EXPECT--
saw: 1,2
1,2,3
