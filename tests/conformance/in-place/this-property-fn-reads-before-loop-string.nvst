--TEST--
A string property replaced in a loop by a method that reads the property before its change shows each pass the value of the pass before — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Note {
    public string $text = "a";

    // Prints `$this->text`, then adds `$x` to the end of `$text`.
    private function add(string $text, string $x): string {
        echo "saw: ", $this->text, "\n";
        $text .= $x;
        return $text;
    }

    public function run(): void {
        array<string> $letters = ["b", "c", "d"];
        // Each pass adds one letter, so the property ends as `abcd`.
        foreach ($letters as string $x) {
            $this->text = $this->add($this->text, $x);
        }
        echo $this->text, "\n";
    }
}

Note $note = new Note();
$note->run();
--EXPECT--
saw: a
saw: ab
saw: abc
abcd
