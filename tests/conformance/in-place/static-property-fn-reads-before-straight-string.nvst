--TEST--
A Novis function that reads a static string property before it changes its parameter sees the old value, and the property then has the new one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "ab";
}

final class Lib {
    // Prints `Store::$text`, then adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        echo "saw: ", Store::$text, "\n";
        $text .= $x;
        return $text;
    }
}

// The call prints `ab`. Then the property is `abc`.
Store::$text = Lib::add(Store::$text, "c");
echo Store::$text, "\n";
--EXPECT--
saw: ab
abc
