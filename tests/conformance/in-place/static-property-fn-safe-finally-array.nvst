--TEST--
An array static property replaced by a Novis function inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static array<int> $items = [];
}

final class Lib {
    // Appends `$x` to `$items` and returns it.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Store::$items = [1, 2];
array<int> $before = Store::$items;
try {
    Store::$items = Lib::add(Store::$items, 3);
} finally {
    echo "finally: ", Lib::show(Store::$items), "\n";
}
// The copy made before the `try` still has `1,2`.
echo Lib::show($before), "\n";
--EXPECT--
finally: 1,2,3
1,2
