--TEST--
An `inout` string replaced by a Novis function that can throw, inside a `try` where it does not, has its new value in the `finally` and in the caller — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$s`, then throws when `$x` is `?`.
    public static function add(string $s, string $x): string {
        $s .= $x;
        if ($x == "?") {
            throw new LogicError("question");
        }
        return $s;
    }

    // Appends `s` to `$name`. The `finally` block prints the new value.
    public static function run(inout string $name): void {
        try {
            $name = Lib::add($name, "s");
        } finally {
            echo "finally: ", $name, "\n";
        }
    }
}

string $name = "shop";
Lib::run(inout $name);
// The call writes `$name` back, so the caller's `$name` is `shops`.
echo $name, "\n";
--EXPECT--
finally: shops
shops
