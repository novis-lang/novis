--TEST--
A string array element replaced by a `Core` function with a callback inside a `try` has its new value in the `catch` of a later error — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
array<string> $words = [];
$words["a"] = "shop";
$words["b"] = "cart";
try {
    // The callback replaces each `o` with `0`, so `$words["a"]` is `sh0p` before the error.
    $words["a"] = Core\Regex::replaceWith($words["a"], "o", fn(Core\Regex\Match $m): string => "0");
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", $words["a"], "\n";
}
echo $words["a"], ",", $words["b"], "\n";
--EXPECT--
stop: sh0p
sh0p,cart
