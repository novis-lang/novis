--TEST--
A string element of an object's property replaced by a concatenation of itself before an error has its new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $rows = [];

    public function constructor() {
        $this->rows["a"] = "ab";
        $this->rows["b"] = "q";
    }
}

Box $box = new Box();
try {
    $box->rows["a"] = $box->rows["a"] . "x";
    // The error comes after the statement, so the element is already `abx`.
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", $box->rows["a"], "\n";
}
echo $box->rows["a"], " and ", $box->rows["b"], "\n";
--EXPECT--
stop: abx
abx and q
