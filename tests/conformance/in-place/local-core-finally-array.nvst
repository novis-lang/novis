--TEST--
A local array replaced by an owning `Core` call inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
try {
    // `Core\Arr::append` adds 3 to the end, so `$items` is `1,2,3`.
    $items = Core\Arr::append($items, 3);
    echo "try: ", Lib::show($items), "\n";
} finally {
    echo "finally: ", Lib::show($items), "\n";
}
echo Lib::show($items), "\n";
--EXPECT--
try: 1,2,3
finally: 1,2,3
1,2,3
