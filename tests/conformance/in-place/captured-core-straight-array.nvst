--TEST--
A captured array replaced by an owning `Core` call inside an anonymous function changes only that call's copy — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
// The function changes its own copy of `$items`. Each call starts from `1,2`.
callable $f = fn(): string => {
    // `Core\Arr::append` adds 3 to the end, so the copy is `1,2,3`.
    $items = Core\Arr::append($items, 3);
    return Lib::show($items);
};
echo $f(), "\n";
echo $f(), "\n";
// The variable outside the function still has `1,2`.
echo Lib::show($items), "\n";
--EXPECT--
1,2,3
1,2,3
1,2
