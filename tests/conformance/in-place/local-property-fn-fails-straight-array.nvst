--TEST--
An array property of a local object replaced by a Novis function that can throw, called so it does not, has its new value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<int> $items = [];

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Lib {
    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2]);
array<int> $before = $box->items;
// 3 is not negative, so the call returns `1,2,3`.
$box->items = Lib::add($box->items, 3);
echo Lib::show($box->items), "\n";
echo Lib::show($before), "\n";
--EXPECT--
1,2,3
1,2
