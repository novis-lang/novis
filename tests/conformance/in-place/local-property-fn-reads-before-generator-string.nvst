--TEST--
A Novis function between two `yield`s that reads an object's string property before it changes its parameter sees the old value, and the value yielded before it stays unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }
}

final class Lib {
    // Prints `$box->text`, then adds `$x` to the end of `$text` and returns it.
    public static function add(Box $box, string $text, string $x): string {
        echo "saw: ", $box->text, "\n";
        $text .= $x;
        return $text;
    }

    public static function steps(): Iterator<string> {
        Box $box = new Box("ab");
        yield $box->text;
        $box->text = Lib::add($box, $box->text, "c");
        yield $box->text;
    }
}

array<string> $seen = [];
foreach (Lib::steps() as string $v) {
    $seen[] = $v;
}
// The first value is still `ab` after the generator changed the property.
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
saw: ab
ab,abc
