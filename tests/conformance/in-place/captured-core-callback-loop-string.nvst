--TEST--
A captured string replaced by a `Core` function with a callback in a loop inside an anonymous function changes only that call's copy — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
string $name = "shop";
// Each call starts from `shop`. Each pass replaces the last `p` with `op`.
callable $f = fn(): string => {
    for (int $i = 0; $i < 3; $i++) {
        $name = Core\Regex::replaceWith($name, "p$", fn(Core\Regex\Match $m): string => "o" . $m->text());
    }
    return $name;
};
echo $f(), "\n";
echo $f(), "\n";
// The variable outside the function still has `shop`.
echo $name, "\n";
--EXPECT--
shoooop
shoooop
shop
