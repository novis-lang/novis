--TEST--
A string element of a class property replaced in a loop by an interpolation of itself has the value of the last pass — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $rows = [];

    public function constructor() {
        $this->rows["a"] = "ab";
        $this->rows["b"] = "q";
    }

    public function run(): void {
        string $before = $this->rows["a"];
        array<string> $xs = ["x", "y", "z"];
        // Each pass adds one letter to the end, so the element is `abxyz`.
        foreach ($xs as string $x) {
            $this->rows["a"] = "{$this->rows["a"]}{$x}";
            echo $this->rows["a"], "\n";
        }
        echo "before: ", $before, "\n";
        echo $this->rows["a"], " and ", $this->rows["b"], "\n";
    }
}

Box $box = new Box();
$box->run();
--EXPECT--
abx
abxy
abxyz
before: ab
abxyz and q
