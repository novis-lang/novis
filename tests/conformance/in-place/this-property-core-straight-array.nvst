--TEST--
An array property replaced through `$this` by an owning `Core` call has its new value, and a copy made before has its old one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }

    // `Core\Arr::append` adds 3 to the end, so `$this->items` is `1,2,3`.
    public function grow(): void {
        $this->items = Core\Arr::append($this->items, 3);
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

var $box = new Box([1, 2]);
array<int> $before = $box->items;
$box->grow();
echo Box::show($box->items), "\n";
// The copy made before the call still has `1,2`.
echo Box::show($before), "\n";
--EXPECT--
1,2,3
1,2
