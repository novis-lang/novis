--TEST--
A string property of a local object replaced by a Novis function has its new value, and a copy made before has the old one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public string $text = "";

    public function constructor(string $text) {
        $this->text = $text;
    }
}

final class Lib {
    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }
}

Box $box = new Box("ab");
string $before = $box->text;
$box->text = Lib::add($box->text, "c");
echo $box->text, "\n";
// The copy made before the call still has `ab`.
echo $before, "\n";
--EXPECT--
abc
ab
