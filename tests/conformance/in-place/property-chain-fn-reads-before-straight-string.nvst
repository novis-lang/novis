--TEST--
A Novis function that reads a string property of an object's property before it changes its parameter sees the old value, and the property then has the new one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(string $text) {
        $this->inner = new Inner($text);
    }
}

final class Lib {
    // Prints `$box->inner->text`, then adds `$x` to the end of `$text` and returns it.
    public static function add(Box $box, string $text, string $x): string {
        echo "saw: ", $box->inner->text, "\n";
        $text .= $x;
        return $text;
    }
}

Box $box = new Box("ab");
// The call prints `ab`. Then the property is `abc`.
$box->inner->text = Lib::add($box, $box->inner->text, "c");
echo $box->inner->text, "\n";
--EXPECT--
saw: ab
abc
