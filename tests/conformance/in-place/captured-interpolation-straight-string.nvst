--TEST--
A captured string replaced by an interpolated string inside an anonymous function changes only that call's copy — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
string $name = "ab";
// The function has its own copy of `$name`. Each call starts from `ab`.
callable $f = fn(): string => {
    // `{$name}` inserts the old value, so the copy is `abx`.
    $name = "{$name}x";
    return $name;
};
echo $f(), "\n";
echo $f(), "\n";
// The variable outside the function is still `ab`.
echo $name, "\n";
--EXPECT--
abx
abx
ab
