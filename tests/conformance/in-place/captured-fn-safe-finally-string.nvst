--TEST--
A captured string replaced by a Novis function inside a closure's `try` has its new value in the `finally`, and each call starts from the captured value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }
}

string $name = "ab";
callable $f = fn(): string => {
    try {
        $name = Lib::add($name, "c");
    } finally {
        // The `finally` block sees the closure's new copy `abc`.
        echo "finally: ", $name, "\n";
    }
    return $name;
};
echo $f(), "\n";
echo $f(), "\n";
// The outer string is still `ab`.
echo $name, "\n";
--EXPECT--
finally: abc
abc
finally: abc
abc
ab
