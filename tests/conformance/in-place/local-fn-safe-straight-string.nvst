--TEST--
A local string replaced by a Novis function that appends to its parameter has the new value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$s` and returns it.
    public static function add(string $s, string $x): string {
        $s .= $x;
        return $s;
    }
}

string $name = "shop";
// `Lib::add` appends `s`, so `$name` is `shops`.
$name = Lib::add($name, "s");
echo $name, "\n";
--EXPECT--
shops
