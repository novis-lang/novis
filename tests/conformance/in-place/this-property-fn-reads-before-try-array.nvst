--TEST--
An array property replaced by a method that reads the property before its change has the new value in the `catch` of a later error — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Bag {
    public array<int> $items = [];

    public function constructor() {
        $this->items = [1, 2];
    }

    // Prints `$this->items`, then appends `$x` to `$items`.
    private function add(array<int> $items, int $x): array<int> {
        echo "saw: ", Bag::show($this->items), "\n";
        $items[] = $x;
        return $items;
    }

    public function run(): void {
        try {
            // The method prints `1,2`, and the property is then `1,2,3`.
            $this->items = $this->add($this->items, 3);
            throw new LogicError("stop");
        } catch (LogicError $e) {
            echo $e->message, ": ", Bag::show($this->items), "\n";
        }
        echo Bag::show($this->items), "\n";
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Bag $bag = new Bag();
$bag->run();
--EXPECT--
saw: 1,2
stop: 1,2,3
1,2,3
