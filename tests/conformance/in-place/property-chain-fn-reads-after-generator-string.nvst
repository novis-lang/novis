--TEST--
A Novis function between two `yield`s that reads a string property of an object's property after it changes its parameter still sees the old value, and the value yielded before it stays unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Inner {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }
}

final class Box {
    public Inner $inner;

    public function constructor(string $text) {
        $this->inner = new Inner($text);
    }
}

final class Lib {
    // Adds `$x` to the end of `$text`, then prints `$box->inner->text` and returns `$text`.
    public static function add(Box $box, string $text, string $x): string {
        $text .= $x;
        echo "saw: ", $box->inner->text, "\n";
        return $text;
    }

    public static function steps(): Iterator<string> {
        Box $box = new Box("ab");
        yield $box->inner->text;
        // The property changes only when the call returns, so the call prints `ab`.
        $box->inner->text = Lib::add($box, $box->inner->text, "c");
        yield $box->inner->text;
    }
}

array<string> $seen = [];
foreach (Lib::steps() as string $v) {
    $seen[] = $v;
}
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
saw: ab
ab,abc
