--TEST--
A string element of an object's array property replaced by a `Core` function with a callback in a loop has the value of the last pass — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<string> $words = [];

    public function constructor(string $a) {
        $this->words["a"] = $a;
        $this->words["b"] = "cart";
    }
}

Box $box = new Box("a");
string $before = $box->words["a"];
// Each pass doubles every `a`, so three passes leave eight of them.
for (int $i = 0; $i < 3; $i++) {
    $box->words["a"] = Core\Regex::replaceWith($box->words["a"], "a", fn(Core\Regex\Match $m): string => "aa");
}
echo $box->words["a"], "\n";
echo $before, "\n";
// The other element is not changed, so `$box->words["b"]` is still `cart`.
echo $box->words["b"], "\n";
--EXPECT--
aaaaaaaa
a
cart
