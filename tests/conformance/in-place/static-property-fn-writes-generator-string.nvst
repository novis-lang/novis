--TEST--
A static string property replaced in a generator by a Novis function that also writes that property yields its old string and then the returned one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "ab";
}

final class Lib {
    // Sets the property to `z` and prints both strings. Then it adds `$x` to `$text` and returns it.
    public static function grow(string $text, string $x): string {
        Store::$text = "z";
        echo "callee: ", $text, " and ", Store::$text, "\n";
        $text .= $x;
        return $text;
    }

    public static function steps(): Iterator<string> {
        yield Store::$text;
        Store::$text = Lib::grow(Store::$text, "c");
        yield Store::$text;
    }
}

// The first value is still `ab` after the property changed.
array<string> $seen = [];
foreach (Lib::steps() as string $v) {
    $seen[] = $v;
}
echo Core\Str::join($seen, ","), "\n";
--EXPECT--
callee: ab and z
ab,abc
