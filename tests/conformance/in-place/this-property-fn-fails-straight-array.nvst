--TEST--
An array property replaced through `$this` by a private method that can throw, called so it does not, has the new value — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Bag {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }

    // Appends `$x` to `$items`, then throws when `$x` is negative.
    private function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public function run(): void {
        // 3 is not negative, so `$this->items` is `1,2,3`.
        $this->items = $this->add($this->items, 3);
        echo Bag::show($this->items), "\n";
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

var $bag = new Bag([1, 2]);
$bag->run();
echo Bag::show($bag->items), "\n";
--EXPECT--
1,2,3
1,2,3
