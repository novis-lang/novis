--TEST--
An object's array property replaced by a `Core` function with a callback has the new value, and a copy read before it keeps the old one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2, 3]);
array<int> $before = $box->items;
// `Core\Arr::map` multiplies each value by 10, so `$box->items` is `10,20,30`.
$box->items = Core\Arr::map($box->items, fn(int $v): int => $v * 10);
echo Lib::show($box->items), "\n";
// `$before` was read before the change, so it is still `1,2,3`.
echo Lib::show($before), "\n";
--EXPECT--
10,20,30
1,2,3
