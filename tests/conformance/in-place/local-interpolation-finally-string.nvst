--TEST--
A local string replaced by an interpolated string inside a `try` has its new value in the `finally` block — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
string $name = "ab";
try {
    // The new string starts with the old value of `$name`, so `$name` is `abc`.
    $name = "{$name}c";
    echo $name, "\n";
} finally {
    // The `finally` block sees the new value `abc`.
    echo "finally: ", $name, "\n";
}
echo $name, "\n";
--EXPECT--
abc
finally: abc
abc
