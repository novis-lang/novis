--TEST--
A captured string replaced inside a closure by a Novis function that can throw, called so it does not, starts from the captured value on each call — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Adds `$x` to the end of `$text`, then throws when `$x` is `!`.
    public static function add(string $text, string $x): string {
        $text .= $x;
        if ($x == "!") {
            throw new LogicError("bad text");
        }
        return $text;
    }
}

string $name = "ab";
// `c` is not `!`, so the call returns the closure's copy with `c` added.
callable $f = fn(): string => {
    $name = Lib::add($name, "c");
    return $name;
};
echo $f(), "\n";
echo $f(), "\n";
// The outer string is still `ab`.
echo $name, "\n";
--EXPECT--
abc
abc
ab
