--TEST--
A class property string replaced between two `yield`s by a method that writes the same property yields its old value and then the returned one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public function constructor(public string $text) {}

    // Sets `$this->text` to `z`, then appends `$x` to `$text` and returns it.
    private function add(string $text, string $x): string {
        $this->text = "z";
        echo "callee: ", $text, " / ", $this->text, "\n";
        $text .= $x;
        return $text;
    }

    public function steps(): Iterator<string> {
        yield $this->text;
        $this->text = $this->add($this->text, "c");
        yield $this->text;
    }
}

Box $box = new Box("ab");
array<string> $seen = [];
foreach ($box->steps() as string $v) {
    $seen[] = $v;
    echo $v, "\n";
}
// The first value is still `ab` after the change.
echo "first: ", $seen[0], "\n";
echo "property: ", $box->text, "\n";
--EXPECT--
ab
callee: ab / z
abc
first: ab
property: abc
