--TEST--
An array element replaced by an owning `Core` call in a loop has the value of the last pass — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<array<int>> $rows = [];
$rows["a"] = [1, 2, 3, 4, 5, 6];
array<int> $before = $rows["a"];
// Each pass drops the first value, so three passes leave `4,5,6`.
for (int $i = 0; $i < 3; $i++) {
    $rows["a"] = Core\Arr::slice($rows["a"], 1);
}
echo Lib::show($rows["a"]), "\n";
echo Lib::show($before), "\n";
--EXPECT--
4,5,6
1,2,3,4,5,6
