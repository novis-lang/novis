--TEST--
A static string property replaced by an owning `Core` call has its new value, and a copy made before has its old one — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "shop";
}

string $before = Store::$text;
// `Core\Str::upper` changes every letter to upper case, so `Store::$text` is `SHOP`.
Store::$text = Core\Str::upper(Store::$text);
echo Store::$text, "\n";
// The copy made before the call still has `shop`.
echo $before, "\n";
--EXPECT--
SHOP
shop
