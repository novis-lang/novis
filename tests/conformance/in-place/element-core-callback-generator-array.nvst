--TEST--
A generator's array element replaced by a `Core` function with a callback between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function steps(): Iterator<array<int>> {
        array<array<int>> $rows = [];
        $rows["a"] = [1, 2, 3];
        yield $rows["a"];
        // `Core\Arr::map` multiplies each value by 10, so `$rows["a"]` is `10,20,30`.
        $rows["a"] = Core\Arr::map($rows["a"], fn(int $v): int => $v * 10);
        yield $rows["a"];
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $first = [];
int $n = 0;
foreach (Lib::steps() as array<int> $items) {
    if ($n == 0) {
        $first = $items;
    }
    $n++;
    echo Lib::show($items), "\n";
}
// The first value is still `1,2,3` after the generator changed the element.
echo Lib::show($first), "\n";
--EXPECT--
1,2,3
10,20,30
1,2,3
