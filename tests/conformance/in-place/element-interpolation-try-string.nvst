--TEST--
An array's string element replaced by an interpolation of itself before an error has its new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
array<string> $words = [];
$words["a"] = "ab";
try {
    $words["a"] = "{$words["a"]}x";
    // The error comes after the statement, so the element is already `abx`.
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", $words["a"], "\n";
}
echo $words["a"], "\n";
--EXPECT--
stop: abx
abx
