--TEST--
A string element replaced by a Novis function inside a `try` has its new value in the `catch` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }
}

array<string> $words = [];
$words["a"] = "ab";
try {
    $words["a"] = Lib::add($words["a"], "c");
    // The error comes after the call, so `$words["a"]` is already `abc`.
    throw new LogicError("stop");
} catch (LogicError $e) {
    echo $e->message, ": ", $words["a"], "\n";
}
echo $words["a"], "\n";
--EXPECT--
stop: abc
abc
