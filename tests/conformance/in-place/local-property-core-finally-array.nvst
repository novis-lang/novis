--TEST--
An object's array property replaced by an owning `Core` call inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }
}

final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

Box $box = new Box([1, 2, 3]);
try {
    // `Core\Arr::slice` drops the first value, so `$box->items` is `2,3`.
    $box->items = Core\Arr::slice($box->items, 1);
} finally {
    echo "finally: ", Lib::show($box->items), "\n";
}
echo Lib::show($box->items), "\n";
--EXPECT--
finally: 2,3
2,3
