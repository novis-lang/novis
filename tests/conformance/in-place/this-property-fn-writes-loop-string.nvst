--TEST--
A class property string replaced in a loop by a method that writes the same property has the value of the last call — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Box {
    public function constructor(public string $text) {}

    // Sets `$this->text` to `z`, then appends `$x` to `$text` and returns it.
    private function add(string $text, string $x): string {
        $this->text = "z";
        echo "callee: ", $text, " / ", $this->text, "\n";
        $text .= $x;
        return $text;
    }

    public function run(): void {
        array<string> $letters = ["b", "c", "d"];
        // Each call sees the value of the pass before it, so the end result is `abcd`.
        foreach ($letters as string $x) {
            $this->text = $this->add($this->text, $x);
        }
        echo $this->text, "\n";
    }
}

Box $box = new Box("a");
$box->run();
--EXPECT--
callee: a / z
callee: ab / z
callee: abc / z
abcd
