--TEST--
A captured array replaced by an owning `Core` call inside a `try` has the new value in the `finally` of each call, and the outer variable is unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2];
callable $f = fn(): string => {
    try {
        // `Core\Arr::append` adds 3 to the function's copy, so the copy is `1,2,3`.
        $items = Core\Arr::append($items, 3);
    } finally {
        echo "finally: ", Lib::show($items), "\n";
    }
    return Lib::show($items);
};
echo $f(), "\n";
echo $f(), "\n";
// The variable outside the function still has `1,2`.
echo Lib::show($items), "\n";
--EXPECT--
finally: 1,2,3
1,2,3
finally: 1,2,3
1,2,3
1,2
