--TEST--
An `inout` string replaced by a Novis function that cannot throw has the new value in the method and in the caller — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    // Appends `$x` to `$s` and returns it.
    public static function add(string $s, string $x): string {
        $s .= $x;
        return $s;
    }

    public static function run(inout string $name): void {
        // `Lib::add` appends `s`, so this prints `shops`.
        $name = Lib::add($name, "s");
        echo $name, "\n";
    }
}

string $name = "shop";
Lib::run(inout $name);
// The call writes `$name` back, so the caller's `$name` is `shops`.
echo $name, "\n";
--EXPECT--
shops
shops
