--TEST--
A captured array replaced by an owning `Core` call between two `yield`s leaves the value yielded before it and the generator's variable unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function steps(): Iterator<array<int>> {
        array<int> $items = [1, 2];
        yield $items;
        // The function adds 3 to its own copy of `$items`, so each call returns `1,2,3`.
        callable(): array<int> $f = fn(): array<int> => {
            $items = Core\Arr::append($items, 3);
            return $items;
        };
        yield $f();
        yield $f();
        yield $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $first = [];
bool $kept = false;
foreach (Lib::steps() as array<int> $v) {
    if (!$kept) {
        $first = $v;
        $kept = true;
    }
    echo Lib::show($v), "\n";
}
// The first value is still `1,2` after every change.
echo "first: ", Lib::show($first), "\n";
--EXPECT--
1,2
1,2,3
1,2,3
1,2
first: 1,2
