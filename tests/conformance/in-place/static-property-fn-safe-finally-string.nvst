--TEST--
A string static property replaced by a Novis function inside a `try` has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "ab";
}

final class Lib {
    // Adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        $text .= $x;
        return $text;
    }
}

string $before = Store::$text;
try {
    Store::$text = Lib::add(Store::$text, "c");
} finally {
    echo "finally: ", Store::$text, "\n";
}
// The copy made before the `try` still has `ab`.
echo $before, "\n";
--EXPECT--
finally: abc
ab
