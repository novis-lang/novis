--TEST--
An `inout` string replaced by a `Core` function with a callback in a loop has the value of the last pass in the method and in the caller — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Show {
    public static function run(inout string $name): void {
        // Each pass puts one more `o` before the last `p`, so this prints `shoooop`.
        foreach ([1, 2, 3] as var $i) {
            $name = Core\Regex::replaceWith($name, "p$", fn(Core\Regex\Match $m): string => "o" . $m->text());
        }
        echo $name, "\n";
    }
}

string $name = "shop";
Show::run(inout $name);
// The call writes `$name` back, so the caller's `$name` is `shoooop`.
echo $name, "\n";
--EXPECT--
shoooop
shoooop
