--TEST--
An array's string element replaced inside a `try` by an interpolation of itself has its new value in the `finally` — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
array<string> $words = [];
$words["a"] = "ab";
try {
    // The new string is the element followed by `x`, so the element is `abx`.
    $words["a"] = "{$words["a"]}x";
} finally {
    echo "finally: ", $words["a"], "\n";
}
echo $words["a"], "\n";
--EXPECT--
finally: abx
abx
