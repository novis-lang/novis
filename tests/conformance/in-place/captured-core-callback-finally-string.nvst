--TEST--
A captured string replaced by a `Core` function with a callback inside a `try` has the new value in the `finally` of each call, and the outer variable is unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
string $name = "shop";
callable $f = fn(): string => {
    try {
        // `Core\Regex::replaceWith` calls the callback for each `o`, so the copy is `sh0p`.
        $name = Core\Regex::replaceWith($name, "o", fn(Core\Regex\Match $m): string => "0");
    } finally {
        echo "finally: ", $name, "\n";
    }
    return $name;
};
echo $f(), "\n";
echo $f(), "\n";
// The variable outside the function still has `shop`.
echo $name, "\n";
--EXPECT--
finally: sh0p
sh0p
finally: sh0p
sh0p
shop
