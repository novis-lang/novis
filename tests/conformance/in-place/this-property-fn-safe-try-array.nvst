--TEST--
An array property replaced through `$this` by a private method that cannot throw keeps the new value when an error follows — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Bag {
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
    }

    // Appends `$x` to `$items` and returns it.
    private function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        return $items;
    }

    public function run(): void {
        try {
            $this->items = $this->add($this->items, 3);
            // The error comes after the change, so the `catch` prints `1,2,3`.
            throw new LogicError("stop");
        } catch (LogicError $e) {
            echo $e->message, ": ", Bag::show($this->items), "\n";
        }
        echo Bag::show($this->items), "\n";
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

var $bag = new Bag([1, 2]);
$bag->run();
--EXPECT--
stop: 1,2,3
1,2,3
