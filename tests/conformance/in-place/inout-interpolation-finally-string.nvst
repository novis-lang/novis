--TEST--
An `inout` string replaced by an interpolated string inside a `try` has its new value in the `finally` and in the caller — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Show {
    // Adds `s` at the end of `$name`. The `finally` block prints the new value.
    public static function run(inout string $name): void {
        try {
            $name = "{$name}s";
        } finally {
            echo "finally: ", $name, "\n";
        }
    }
}

string $name = "shop";
Show::run(inout $name);
// The call writes `$name` back, so the caller's `$name` is `shops`.
echo $name, "\n";
--EXPECT--
finally: shops
shops
