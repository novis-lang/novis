--TEST--
An array static property replaced by a Novis function that can throw between two `yield`s leaves the value yielded before it unchanged — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static array<int> $items = [];
}

final class Lib {
    // Appends `$x` to `$items`, then throws when `$x` is negative.
    public static function add(array<int> $items, int $x): array<int> {
        $items[] = $x;
        if ($x < 0) {
            throw new LogicError("negative");
        }
        return $items;
    }

    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }

    public static function steps(): Iterator<array<int>> {
        Store::$items = [1, 2];
        yield Store::$items;
        Store::$items = Lib::add(Store::$items, 3);
        yield Store::$items;
    }
}

// The first value is still `1,2` after the generator changed `Store::$items`.
array<array<int>> $seen = [];
foreach (Lib::steps() as array<int> $v) {
    $seen[] = $v;
}
echo Lib::show($seen[0]), " then ", Lib::show($seen[1]), "\n";
--EXPECT--
1,2 then 1,2,3
