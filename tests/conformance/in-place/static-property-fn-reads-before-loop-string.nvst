--TEST--
A Novis function called in a loop that reads a static string property before it changes its parameter sees the value from the previous pass each time — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Store {
    public static string $text = "ab";
}

final class Lib {
    // Prints `Store::$text`, then adds `$x` to the end of `$text` and returns it.
    public static function add(string $text, string $x): string {
        echo "saw: ", Store::$text, "\n";
        $text .= $x;
        return $text;
    }
}

foreach (["c", "d", "e"] as var $x) {
    Store::$text = Lib::add(Store::$text, $x);
}
echo Store::$text, "\n";
--EXPECT--
saw: ab
saw: abc
saw: abcd
abcde
