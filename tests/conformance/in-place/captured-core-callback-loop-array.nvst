--TEST--
A captured array replaced by a `Core` function with a callback in a loop inside an anonymous function changes only that call's copy — `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
final class Lib {
    public static function show(array<int> $items): string {
        return Core\Str::join(Core\Arr::map($items, fn(int $v): string => $v as string), ",");
    }
}

array<int> $items = [1, 2, 3];
// Each call starts from `1,2,3`. Three passes double each value three times.
callable $f = fn(): string => {
    for (int $i = 0; $i < 3; $i++) {
        $items = Core\Arr::map($items, fn(int $v): int => $v * 2);
    }
    return Lib::show($items);
};
echo $f(), "\n";
echo $f(), "\n";
// The variable outside the function still has `1,2,3`.
echo Lib::show($items), "\n";
--EXPECT--
8,16,24
8,16,24
1,2,3
