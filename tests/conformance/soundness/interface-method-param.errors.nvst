--TEST--
Each redeclaration of an interface method's parameter that the rule refuses, and each path it refuses, is a compile error at the line it names (generated; `rule:classes/an-override-keeps-its-parents-signature`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

interface Face2 {
    public function m(Animal $a): void;
}
class Child2 implements Face2 {
    public function m(Dog $a): void { echo "Child2.m ", Show::of($a), "\n"; }
}

interface Face4 {
    public function m(Animal $a): void;
}
class Child4 implements Face4 {
    public function m(Plant $a): void { echo "Child4.m ", Show::of($a), "\n"; }
}

interface Face5 {
    public function m(int|string $a): void;
}
class Child5 implements Face5 {
    public function m(int $a): void { echo "Child5.m ", Show::of($a), "\n"; }
}

interface Face6 {
    public function m(float $a): void;
}
class Child6 implements Face6 {
    public function m(int $a): void { echo "Child6.m ", Show::of($a), "\n"; }
}

interface Face7 {
    public function m(int $a): void;
}
class Child7 implements Face7 {
    public function m(float $a): void { echo "Child7.m ", Show::of($a), "\n"; }
}

interface Face8 {
    public function m(?Animal $a): void;
}
class Child8 implements Face8 {
    public function m(Animal $a): void { echo "Child8.m ", Show::of($a), "\n"; }
}

interface Face10 {
    public function m(Animal|Plant $a): void;
}
class Child10 implements Face10 {
    public function m(Animal $a): void { echo "Child10.m ", Show::of($a), "\n"; }
}
