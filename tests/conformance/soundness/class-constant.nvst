--TEST--
Each redeclaration of a class constant that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:statements/static-is-a-member-modifier`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent1 {
    public const int X = 1;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child1 extends Parent1 {
    public const int X = 2;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}
echo "same parent-name: ", Show::of(Parent1::X), "\n";
echo "same child-name: ", Show::of(Child1::X), "\n";
Child1::viaSelf("same self-in-parent: ");
Child1::viaChildSelf("same self-in-child: ");
Child1::viaStatic("same static: ");

class Parent5 {
    public const int|string X = "p";
    public static function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child5 extends Parent5 {
    public const int X = 2;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}
echo "int-under-int-string parent-name: ", Show::of(Parent5::X), "\n";
echo "int-under-int-string child-name: ", Show::of(Child5::X), "\n";
Child5::viaSelf("int-under-int-string self-in-parent: ");
Child5::viaChildSelf("int-under-int-string self-in-child: ");
Child5::viaStatic("int-under-int-string static: ");

class Parent8 {
    public const ?int X = 1;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child8 extends Parent8 {
    public const int X = 2;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}
echo "t-under-nullable parent-name: ", Show::of(Parent8::X), "\n";
echo "t-under-nullable child-name: ", Show::of(Child8::X), "\n";
Child8::viaSelf("t-under-nullable self-in-parent: ");
Child8::viaChildSelf("t-under-nullable self-in-child: ");
Child8::viaStatic("t-under-nullable static: ");

class Parent10 {
    public const int|string X = "p";
    public static function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child10 extends Parent10 {
    public const string X = "c";
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}
echo "member-under-union parent-name: ", Show::of(Parent10::X), "\n";
echo "member-under-union child-name: ", Show::of(Child10::X), "\n";
Child10::viaSelf("member-under-union self-in-parent: ");
Child10::viaChildSelf("member-under-union self-in-child: ");
Child10::viaStatic("member-under-union static: ");
--EXPECT--
same parent-name: int 1
same child-name: int 2
same self-in-parent: int 1
same self-in-child: int 2
same static: int 2
int-under-int-string parent-name: string p
int-under-int-string child-name: int 2
int-under-int-string self-in-parent: string p
int-under-int-string self-in-child: int 2
int-under-int-string static: int 2
t-under-nullable parent-name: int 1
t-under-nullable child-name: int 2
t-under-nullable self-in-parent: int 1
t-under-nullable self-in-child: int 2
t-under-nullable static: int 2
member-under-union parent-name: string p
member-under-union child-name: string c
member-under-union self-in-parent: string p
member-under-union self-in-child: string c
member-under-union static: string c
