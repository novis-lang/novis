--TEST--
Each redeclaration of `compareTo`'s parameter that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:classes/an-override-keeps-its-parents-signature`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Root1 {}
class Parent1 extends Root1 implements Comparable {
    public function compareTo(self $other): int { echo "Parent1.compareTo ", Show::of($other), "\n"; return 0; }
}
class Child1 extends Parent1 {
    public function compareTo(Parent1 $other): int { echo "Child1.compareTo ", Show::of($other), "\n"; return 0; }
}
Parent1 $v1x0 = new Child1();
echo "same parent-variable: "; $v1x0->compareTo(new Child1());
Child1 $v1x1 = new Child1();
echo "same child-variable: "; $v1x1->compareTo(new Child1());
Comparable $v1x2 = new Child1();
echo "same interface-variable: "; $v1x2->compareTo(new Child1());
mixed $v1x3 = new Child1();
echo "same mixed: "; $v1x3->compareTo(new Child1());
Parent1 $v1x4 = new Child1();
var $f1x4 = $v1x4->compareTo(...);
echo "same callable: "; $f1x4(new Child1());

class Root3 {}
class Parent3 extends Root3 implements Comparable {
    public function compareTo(self $other): int { echo "Parent3.compareTo ", Show::of($other), "\n"; return 0; }
}
class Child3 extends Parent3 {
    public function compareTo(Root3 $other): int { echo "Child3.compareTo ", Show::of($other), "\n"; return 0; }
}
Parent3 $v3x0 = new Child3();
echo "superclass parent-variable: "; $v3x0->compareTo(new Child3());
Child3 $v3x1 = new Child3();
echo "superclass child-variable: "; $v3x1->compareTo(new Child3());
Comparable $v3x2 = new Child3();
echo "superclass interface-variable: "; $v3x2->compareTo(new Child3());
mixed $v3x3 = new Child3();
echo "superclass mixed: "; $v3x3->compareTo(new Child3());
Parent3 $v3x4 = new Child3();
var $f3x4 = $v3x4->compareTo(...);
echo "superclass callable: "; $f3x4(new Child3());

class Root9 {}
class Parent9 extends Root9 implements Comparable {
    public function compareTo(self $other): int { echo "Parent9.compareTo ", Show::of($other), "\n"; return 0; }
}
class Child9 extends Parent9 {
    public function compareTo(?Parent9 $other): int { echo "Child9.compareTo ", Show::of($other), "\n"; return 0; }
}
Parent9 $v9x0 = new Child9();
echo "nullable-over-t parent-variable: "; $v9x0->compareTo(new Child9());
Child9 $v9x1 = new Child9();
echo "nullable-over-t child-variable: "; $v9x1->compareTo(new Child9());
Comparable $v9x2 = new Child9();
echo "nullable-over-t interface-variable: "; $v9x2->compareTo(new Child9());
mixed $v9x3 = new Child9();
echo "nullable-over-t mixed: "; $v9x3->compareTo(new Child9());
Parent9 $v9x4 = new Child9();
var $f9x4 = $v9x4->compareTo(...);
echo "nullable-over-t callable: "; $f9x4(new Child9());
--EXPECT--
same parent-variable: Child1.compareTo Child1
same child-variable: Child1.compareTo Child1
same interface-variable: Child1.compareTo Child1
same mixed: Child1.compareTo Child1
same callable: Child1.compareTo Child1
superclass parent-variable: Child3.compareTo Child3
superclass child-variable: Child3.compareTo Child3
superclass interface-variable: Child3.compareTo Child3
superclass mixed: Child3.compareTo Child3
superclass callable: Child3.compareTo Child3
nullable-over-t parent-variable: Child9.compareTo Child9
nullable-over-t child-variable: Child9.compareTo Child9
nullable-over-t interface-variable: Child9.compareTo Child9
nullable-over-t mixed: Child9.compareTo Child9
nullable-over-t callable: Child9.compareTo Child9
