--TEST--
Each redeclaration of a method's return type that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:classes/an-override-keeps-its-parents-signature`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent1 {
    public function m(): Animal { return new Animal(); }
}
class Child1 extends Parent1 {
    public function m(): Animal { return new Dog(); }
}
Parent1 $v1x0 = new Child1();
echo "same parent-variable: ", Show::of($v1x0->m()), "\n";
Child1 $v1x1 = new Child1();
echo "same child-variable: ", Show::of($v1x1->m()), "\n";
mixed $v1x2 = new Child1();
echo "same mixed: ", Show::of($v1x2->m()), "\n";
Parent1 $v1x3 = new Child1();
var $f1x3 = $v1x3->m(...);
echo "same callable: ", Show::of($f1x3()), "\n";

class Parent2 {
    public function m(): Animal { return new Animal(); }
}
class Child2 extends Parent2 {
    public function m(): Dog { return new Puppy(); }
}
Parent2 $v2x0 = new Child2();
echo "subclass parent-variable: ", Show::of($v2x0->m()), "\n";
Child2 $v2x1 = new Child2();
echo "subclass child-variable: ", Show::of($v2x1->m()), "\n";
mixed $v2x2 = new Child2();
echo "subclass mixed: ", Show::of($v2x2->m()), "\n";
Parent2 $v2x3 = new Child2();
var $f2x3 = $v2x3->m(...);
echo "subclass callable: ", Show::of($f2x3()), "\n";

class Parent5 {
    public function m(): int|string { return "p"; }
}
class Child5 extends Parent5 {
    public function m(): int { return 2; }
}
Parent5 $v5x0 = new Child5();
echo "int-under-int-string parent-variable: ", Show::of($v5x0->m()), "\n";
Child5 $v5x1 = new Child5();
echo "int-under-int-string child-variable: ", Show::of($v5x1->m()), "\n";
mixed $v5x2 = new Child5();
echo "int-under-int-string mixed: ", Show::of($v5x2->m()), "\n";
Parent5 $v5x3 = new Child5();
var $f5x3 = $v5x3->m(...);
echo "int-under-int-string callable: ", Show::of($f5x3()), "\n";

class Parent8 {
    public function m(): ?Animal { return new Animal(); }
}
class Child8 extends Parent8 {
    public function m(): Animal { return new Dog(); }
}
Parent8 $v8x0 = new Child8();
echo "t-under-nullable parent-variable: ", Show::of($v8x0->m()), "\n";
Child8 $v8x1 = new Child8();
echo "t-under-nullable child-variable: ", Show::of($v8x1->m()), "\n";
mixed $v8x2 = new Child8();
echo "t-under-nullable mixed: ", Show::of($v8x2->m()), "\n";
Parent8 $v8x3 = new Child8();
var $f8x3 = $v8x3->m(...);
echo "t-under-nullable callable: ", Show::of($f8x3()), "\n";

class Parent10 {
    public function m(): Animal|Plant { return new Plant(); }
}
class Child10 extends Parent10 {
    public function m(): Animal { return new Dog(); }
}
Parent10 $v10x0 = new Child10();
echo "member-under-union parent-variable: ", Show::of($v10x0->m()), "\n";
Child10 $v10x1 = new Child10();
echo "member-under-union child-variable: ", Show::of($v10x1->m()), "\n";
mixed $v10x2 = new Child10();
echo "member-under-union mixed: ", Show::of($v10x2->m()), "\n";
Parent10 $v10x3 = new Child10();
var $f10x3 = $v10x3->m(...);
echo "member-under-union callable: ", Show::of($f10x3()), "\n";
--EXPECT--
same parent-variable: Dog
same child-variable: Dog
same mixed: Dog
same callable: Dog
subclass parent-variable: Puppy
subclass child-variable: Puppy
subclass mixed: Puppy
subclass callable: Puppy
int-under-int-string parent-variable: int 2
int-under-int-string child-variable: int 2
int-under-int-string mixed: int 2
int-under-int-string callable: int 2
t-under-nullable parent-variable: Dog
t-under-nullable child-variable: Dog
t-under-nullable mixed: Dog
t-under-nullable callable: Dog
member-under-union parent-variable: Dog
member-under-union child-variable: Dog
member-under-union mixed: Dog
member-under-union callable: Dog
