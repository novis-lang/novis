--TEST--
Each redeclaration of a static property that the rule refuses, and each path it refuses, is a compile error at the line it names (generated; `rule:statements/static-is-a-member-modifier`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent1 {
    public static int $x = 1;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::$x), "\n"; }
}
class Child1 extends Parent1 {
    public static int $x = 2;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
Child1::viaStatic("same static: ");
Parent1 $v1x1 = new Child1();
echo "same parent-variable: ", Show::of($v1x1->x), "\n";

class Parent2 {
    public static ?Animal $x = null;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::$x), "\n"; }
}
class Child2 extends Parent2 {
    public static ?Dog $x = null;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
Parent2::$x = new Animal();
Child2::$x = new Puppy();
Child2::viaStatic("subclass static: ");
Parent2 $v2x1 = new Child2();
echo "subclass parent-variable: ", Show::of($v2x1->x), "\n";

class Parent3 {
    public static ?Dog $x = null;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::$x), "\n"; }
}
class Child3 extends Parent3 {
    public static ?Animal $x = null;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
Parent3::$x = new Dog();
Child3::$x = new Dog();
