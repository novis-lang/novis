--TEST--
Each redeclaration of a `covariant` method parameter that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:classes/a-covariant-type-is-checked-where-a-value-enters`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent2 {
    public function m(Animal $a): void { echo "Parent2.m ", Show::of($a), "\n"; }
}
class Child2 extends Parent2 {
    public function m(covariant Dog $a): void { echo "Child2.m ", Show::of($a), "\n"; }
}
Parent2 $v2x0 = new Child2();
try { $v2x0->m(new Animal()); } catch (LogicError $e2x0) { echo "subclass parent-variable: ", $e2x0->message, "\n"; }
Child2 $v2x1 = new Child2();
echo "subclass child-variable: "; $v2x1->m(new Puppy());
mixed $v2x2 = new Child2();
try { $v2x2->m(new Animal()); } catch (LogicError $e2x2) { echo "subclass mixed: ", $e2x2->message, "\n"; }
Parent2 $v2x3 = new Child2();
var $f2x3 = $v2x3->m(...);
try { $f2x3(new Animal()); } catch (LogicError $e2x3) { echo "subclass callable: ", $e2x3->message, "\n"; }

class Parent5 {
    public function m(int|string $a): void { echo "Parent5.m ", Show::of($a), "\n"; }
}
class Child5 extends Parent5 {
    public function m(covariant int $a): void { echo "Child5.m ", Show::of($a), "\n"; }
}
Parent5 $v5x0 = new Child5();
try { $v5x0->m("p"); } catch (LogicError $e5x0) { echo "int-under-int-string parent-variable: ", $e5x0->message, "\n"; }
Child5 $v5x1 = new Child5();
echo "int-under-int-string child-variable: "; $v5x1->m(2);
mixed $v5x2 = new Child5();
try { $v5x2->m("p"); } catch (LogicError $e5x2) { echo "int-under-int-string mixed: ", $e5x2->message, "\n"; }
Parent5 $v5x3 = new Child5();
var $f5x3 = $v5x3->m(...);
try { $f5x3("p"); } catch (LogicError $e5x3) { echo "int-under-int-string callable: ", $e5x3->message, "\n"; }

class Parent8 {
    public function m(?Animal $a): void { echo "Parent8.m ", Show::of($a), "\n"; }
}
class Child8 extends Parent8 {
    public function m(covariant Animal $a): void { echo "Child8.m ", Show::of($a), "\n"; }
}
Parent8 $v8x0 = new Child8();
try { $v8x0->m(null); } catch (LogicError $e8x0) { echo "t-under-nullable parent-variable: ", $e8x0->message, "\n"; }
Child8 $v8x1 = new Child8();
echo "t-under-nullable child-variable: "; $v8x1->m(new Dog());
mixed $v8x2 = new Child8();
try { $v8x2->m(null); } catch (LogicError $e8x2) { echo "t-under-nullable mixed: ", $e8x2->message, "\n"; }
Parent8 $v8x3 = new Child8();
var $f8x3 = $v8x3->m(...);
try { $f8x3(null); } catch (LogicError $e8x3) { echo "t-under-nullable callable: ", $e8x3->message, "\n"; }

class Parent10 {
    public function m(Animal|Plant $a): void { echo "Parent10.m ", Show::of($a), "\n"; }
}
class Child10 extends Parent10 {
    public function m(covariant Animal $a): void { echo "Child10.m ", Show::of($a), "\n"; }
}
Parent10 $v10x0 = new Child10();
try { $v10x0->m(new Plant()); } catch (LogicError $e10x0) { echo "member-under-union parent-variable: ", $e10x0->message, "\n"; }
Child10 $v10x1 = new Child10();
echo "member-under-union child-variable: "; $v10x1->m(new Dog());
mixed $v10x2 = new Child10();
try { $v10x2->m(new Plant()); } catch (LogicError $e10x2) { echo "member-under-union mixed: ", $e10x2->message, "\n"; }
Parent10 $v10x3 = new Child10();
var $f10x3 = $v10x3->m(...);
try { $f10x3(new Plant()); } catch (LogicError $e10x3) { echo "member-under-union callable: ", $e10x3->message, "\n"; }
--EXPECT--
subclass parent-variable: The parameter `$a` of `Child2::m` has the type `Dog`. The argument is an object of class `Animal`.
subclass child-variable: Child2.m Puppy
subclass mixed: The parameter `$a` of `Child2::m` has the type `Dog`. The argument is an object of class `Animal`.
subclass callable: The parameter `$a` of `Child2::m` has the type `Dog`. The argument is an object of class `Animal`.
int-under-int-string parent-variable: The parameter `$a` of `Child5::m` has the type `int`. The argument is a value of type `string`.
int-under-int-string child-variable: Child5.m int 2
int-under-int-string mixed: The parameter `$a` of `Child5::m` has the type `int`. The argument is a value of type `string`.
int-under-int-string callable: The parameter `$a` of `Child5::m` has the type `int`. The argument is a value of type `string`.
t-under-nullable parent-variable: The parameter `$a` of `Child8::m` has the type `Animal`. The argument is `null`.
t-under-nullable child-variable: Child8.m Dog
t-under-nullable mixed: The parameter `$a` of `Child8::m` has the type `Animal`. The argument is `null`.
t-under-nullable callable: The parameter `$a` of `Child8::m` has the type `Animal`. The argument is `null`.
member-under-union parent-variable: The parameter `$a` of `Child10::m` has the type `Animal`. The argument is an object of class `Plant`.
member-under-union child-variable: Child10.m Dog
member-under-union mixed: The parameter `$a` of `Child10::m` has the type `Animal`. The argument is an object of class `Plant`.
member-under-union callable: The parameter `$a` of `Child10::m` has the type `Animal`. The argument is an object of class `Plant`.
