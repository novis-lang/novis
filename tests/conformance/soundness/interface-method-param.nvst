--TEST--
Each redeclaration of an interface method's parameter that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:classes/an-override-keeps-its-parents-signature`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

interface Face1 {
    public function m(Animal $a): void;
}
class Child1 implements Face1 {
    public function m(Animal $a): void { echo "Child1.m ", Show::of($a), "\n"; }
}
Face1 $v1x0 = new Child1();
echo "same interface-variable: "; $v1x0->m(new Animal());
Child1 $v1x1 = new Child1();
echo "same class-variable: "; $v1x1->m(new Animal());
mixed $v1x2 = new Child1();
echo "same mixed: "; $v1x2->m(new Animal());
Face1 $v1x3 = new Child1();
var $f1x3 = $v1x3->m(...);
echo "same callable: "; $f1x3(new Animal());

interface Face3 {
    public function m(Dog $a): void;
}
class Child3 implements Face3 {
    public function m(Animal $a): void { echo "Child3.m ", Show::of($a), "\n"; }
}
Face3 $v3x0 = new Child3();
echo "superclass interface-variable: "; $v3x0->m(new Dog());
Child3 $v3x1 = new Child3();
echo "superclass class-variable: "; $v3x1->m(new Dog());
mixed $v3x2 = new Child3();
echo "superclass mixed: "; $v3x2->m(new Dog());
Face3 $v3x3 = new Child3();
var $f3x3 = $v3x3->m(...);
echo "superclass callable: "; $f3x3(new Dog());

interface Face9 {
    public function m(Animal $a): void;
}
class Child9 implements Face9 {
    public function m(?Animal $a): void { echo "Child9.m ", Show::of($a), "\n"; }
}
Face9 $v9x0 = new Child9();
echo "nullable-over-t interface-variable: "; $v9x0->m(new Animal());
Child9 $v9x1 = new Child9();
echo "nullable-over-t class-variable: "; $v9x1->m(new Animal());
mixed $v9x2 = new Child9();
echo "nullable-over-t mixed: "; $v9x2->m(new Animal());
Face9 $v9x3 = new Child9();
var $f9x3 = $v9x3->m(...);
echo "nullable-over-t callable: "; $f9x3(new Animal());

interface Face11 {
    public function m(Animal|Plant $a): void;
}
class Child11 implements Face11 {
    public function m(Animal|Plant|Stone $a): void { echo "Child11.m ", Show::of($a), "\n"; }
}
Face11 $v11x0 = new Child11();
echo "wider-union interface-variable: "; $v11x0->m(new Plant());
Child11 $v11x1 = new Child11();
echo "wider-union class-variable: "; $v11x1->m(new Plant());
mixed $v11x2 = new Child11();
echo "wider-union mixed: "; $v11x2->m(new Plant());
Face11 $v11x3 = new Child11();
var $f11x3 = $v11x3->m(...);
echo "wider-union callable: "; $f11x3(new Plant());
--EXPECT--
same interface-variable: Child1.m Animal
same class-variable: Child1.m Animal
same mixed: Child1.m Animal
same callable: Child1.m Animal
superclass interface-variable: Child3.m Dog
superclass class-variable: Child3.m Dog
superclass mixed: Child3.m Dog
superclass callable: Child3.m Dog
nullable-over-t interface-variable: Child9.m Animal
nullable-over-t class-variable: Child9.m Animal
nullable-over-t mixed: Child9.m Animal
nullable-over-t callable: Child9.m Animal
wider-union interface-variable: Child11.m Plant
wider-union class-variable: Child11.m Plant
wider-union mixed: Child11.m Plant
wider-union callable: Child11.m Plant
