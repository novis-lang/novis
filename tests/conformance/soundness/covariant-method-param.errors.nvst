--TEST--
Each redeclaration of a `covariant` method parameter that the rule refuses, and each path it refuses, is a compile error at the line it names (generated; `rule:classes/a-covariant-type-is-checked-where-a-value-enters`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent1 {
    public function m(Animal $a): void { echo "Parent1.m ", Show::of($a), "\n"; }
}
class Child1 extends Parent1 {
    public function m(covariant Animal $a): void { echo "Child1.m ", Show::of($a), "\n"; }
}

class Parent3 {
    public function m(Dog $a): void { echo "Parent3.m ", Show::of($a), "\n"; }
}
class Child3 extends Parent3 {
    public function m(covariant Animal $a): void { echo "Child3.m ", Show::of($a), "\n"; }
}

class Parent4 {
    public function m(Animal $a): void { echo "Parent4.m ", Show::of($a), "\n"; }
}
class Child4 extends Parent4 {
    public function m(covariant Plant $a): void { echo "Child4.m ", Show::of($a), "\n"; }
}

class Parent6 {
    public function m(float $a): void { echo "Parent6.m ", Show::of($a), "\n"; }
}
class Child6 extends Parent6 {
    public function m(covariant int $a): void { echo "Child6.m ", Show::of($a), "\n"; }
}

class Parent7 {
    public function m(int $a): void { echo "Parent7.m ", Show::of($a), "\n"; }
}
class Child7 extends Parent7 {
    public function m(covariant float $a): void { echo "Child7.m ", Show::of($a), "\n"; }
}

class Parent9 {
    public function m(Animal $a): void { echo "Parent9.m ", Show::of($a), "\n"; }
}
class Child9 extends Parent9 {
    public function m(covariant ?Animal $a): void { echo "Child9.m ", Show::of($a), "\n"; }
}

class Parent11 {
    public function m(Animal|Plant $a): void { echo "Parent11.m ", Show::of($a), "\n"; }
}
class Child11 extends Parent11 {
    public function m(covariant Animal|Plant|Stone $a): void { echo "Child11.m ", Show::of($a), "\n"; }
}
