--TEST--
A `secret` and a `tainted` value at a call with no parameter types keep their qualifier, so the position or the sink after it is a compile error at the line it names (generated; `rule:types/callable-signature`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Sink {
    public static function plain(string $s): void { echo $s, "\n"; }
}
class Holder {
    public secret string $token = "";
    public tainted string $name = "";
}

// cell: untyped-call secret
class Cell1 {
    public static function run(callable $f, secret string $x): void {
        $f($x);
    }
}

// cell: untyped-call tainted
class Cell2 {
    public static function run(callable $f, tainted string $x): void {
        $f($x);
    }
}

// cell: untyped-call secret call
class Cell3 {
    public static function run(callable $f, Holder $h, secret string $x): void {
        $f->call($h, $x);
    }
}

// cell: untyped-call tainted call
class Cell4 {
    public static function run(callable $f, Holder $h, tainted string $x): void {
        $f->call($h, $x);
    }
}
--EXPECT--

