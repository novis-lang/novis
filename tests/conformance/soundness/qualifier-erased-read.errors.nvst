--TEST--
A `secret` and a `tainted` value at a read that loses a property's declared type keep their qualifier, so the position or the sink after it is a compile error at the line it names (generated; `rule:security/secret-qualifier`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Sink {
    public static function plain(string $s): void { echo $s, "\n"; }
}
class Holder {
    public secret string $token = "";
    public tainted string $name = "";
}

// cell: erased-read secret
class Cell1 {
    public static function run(Holder $h): void {
        $h as {token: string};
    }
}

// cell: erased-read tainted
class Cell2 {
    public static function run(mixed $m): void {
        Sink::plain($m->name as string);
    }
}
--EXPECT--

--EXPECTF-ERROR--
error[E0894]: %s
%w--> %s:15:%d
%A
error[E0401]: %s
%w--> %s:22:%d
%A
error: aborting due to 2 errors
