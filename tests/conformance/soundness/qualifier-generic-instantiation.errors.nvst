--TEST--
A `secret` and a `tainted` value at a `Core` member's type variable keep their qualifier, so the position or the sink after it is a compile error at the line it names (generated; `rule:security/secret-propagation`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Sink {
    public static function plain(string $s): void { echo $s, "\n"; }
}
class Holder {
    public secret string $token = "";
    public tainted string $name = "";
}

// cell: generic-instantiation secret
class Cell1 {
    public static function run(array<secret string> $xs): void {
        echo Core\Arr::first($xs) ?? "";
    }
}

// cell: generic-instantiation tainted
class Cell2 {
    public static function run(array<tainted string> $xs): void {
        Sink::plain(Core\Arr::first($xs) ?? "");
    }
}
--EXPECT--

--EXPECTF-ERROR--
error[E0790]: %s
%w--> %s:15:%d
%A
error[E0401]: %s
%w--> %s:22:%d
%A
error: aborting due to 2 errors
