--TEST--
Each redeclaration of a static method's return type that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:classes/an-override-keeps-its-parents-signature`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent1 {
    public static function m(): Animal { return new Animal(); }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::m()), "\n"; }
}
class Child1 extends Parent1 {
    public static function m(): Animal { return new Dog(); }
}
Child1::viaStatic("same static: ");
echo "same child-name: ", Show::of(Child1::m()), "\n";
echo "same parent-name: ", Show::of(Parent1::m()), "\n";

class Parent2 {
    public static function m(): Animal { return new Animal(); }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::m()), "\n"; }
}
class Child2 extends Parent2 {
    public static function m(): Dog { return new Puppy(); }
}
Child2::viaStatic("subclass static: ");
echo "subclass child-name: ", Show::of(Child2::m()), "\n";
echo "subclass parent-name: ", Show::of(Parent2::m()), "\n";

class Parent5 {
    public static function m(): int|string { return "p"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::m()), "\n"; }
}
class Child5 extends Parent5 {
    public static function m(): int { return 2; }
}
Child5::viaStatic("int-under-int-string static: ");
echo "int-under-int-string child-name: ", Show::of(Child5::m()), "\n";
echo "int-under-int-string parent-name: ", Show::of(Parent5::m()), "\n";

class Parent8 {
    public static function m(): ?Animal { return new Animal(); }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::m()), "\n"; }
}
class Child8 extends Parent8 {
    public static function m(): Animal { return new Dog(); }
}
Child8::viaStatic("t-under-nullable static: ");
echo "t-under-nullable child-name: ", Show::of(Child8::m()), "\n";
echo "t-under-nullable parent-name: ", Show::of(Parent8::m()), "\n";

class Parent10 {
    public static function m(): Animal|Plant { return new Plant(); }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::m()), "\n"; }
}
class Child10 extends Parent10 {
    public static function m(): Animal { return new Dog(); }
}
Child10::viaStatic("member-under-union static: ");
echo "member-under-union child-name: ", Show::of(Child10::m()), "\n";
echo "member-under-union parent-name: ", Show::of(Parent10::m()), "\n";
--EXPECT--
same static: Dog
same child-name: Dog
same parent-name: Animal
subclass static: Puppy
subclass child-name: Puppy
subclass parent-name: Animal
int-under-int-string static: int 2
int-under-int-string child-name: int 2
int-under-int-string parent-name: string p
t-under-nullable static: Dog
t-under-nullable child-name: Dog
t-under-nullable parent-name: Animal
member-under-union static: Dog
member-under-union child-name: Dog
member-under-union parent-name: Plant
