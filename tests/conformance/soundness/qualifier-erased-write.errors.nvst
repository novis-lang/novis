--TEST--
A `secret` and a `tainted` value at a property write through `object` keep their qualifier, so the position or the sink after it is a compile error at the line it names (generated; `rule:types/erased-member-access`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Sink {
    public static function plain(string $s): void { echo $s, "\n"; }
}
class Holder {
    public secret string $token = "";
    public tainted string $name = "";
}

// cell: erased-write secret
class Cell1 {
    public static function run(object $o, secret string $x): void {
        $o->name = $x;
    }
}

// cell: erased-write tainted
class Cell2 {
    public static function run(object $o, tainted string $x): void {
        $o->name = $x;
    }
}
--EXPECT--

--EXPECTF-ERROR--
error[E0401]: %s
%w--> %s:15:%d
%A
error[E0895]: %s
%w--> %s:22:%d
%A
error: aborting due to 2 errors
