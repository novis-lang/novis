--TEST--
A `secret` and a `tainted` value at a value placed in `mixed` keep their qualifier, so the position or the sink after it is a compile error at the line it names (generated; `rule:security/secret-qualifier`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Sink {
    public static function plain(string $s): void { echo $s, "\n"; }
}
class Holder {
    public secret string $token = "";
    public tainted string $name = "";
}

// cell: widening secret
class Cell1 {
    public static function run(secret string $x): void {
        mixed $m = $x;
    }
}

// cell: widening tainted
class Cell2 {
    public static function run(tainted string $x): void {
        mixed $m = $x;
        Sink::plain($m as string);
    }
}
--EXPECT--

--EXPECTF-ERROR--
error[E0401]: %s
%w--> %s:15:%d
%A
error[E0401]: %s
%w--> %s:23:%d
%A
error: aborting due to 2 errors
