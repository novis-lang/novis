--TEST--
A `secret` and a `tainted` value at a member that makes keys from values keep their qualifier, so the position or the sink after it is a compile error at the line it names (generated; `rule:security/taint-propagation`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Sink {
    public static function plain(string $s): void { echo $s, "\n"; }
}
class Holder {
    public secret string $token = "";
    public tainted string $name = "";
}

// cell: key-making-member secret
class Cell1 {
    public static function run(array<secret string> $xs): void {
        array<uint> $c = Core\Arr::countBy($xs);
    }
}

// cell: key-making-member tainted
class Cell2 {
    public static function run(array<tainted string> $xs): void {
        array<uint> $c = Core\Arr::countBy($xs);
    }
}
--EXPECT--

