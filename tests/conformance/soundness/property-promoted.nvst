--TEST--
Each redeclaration of a promoted constructor parameter that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:classes/a-redeclared-property-keeps-its-parents-type`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent1 {
    public function constructor(public Animal $x) {}
}
class Child1 extends Parent1 {
    public function constructor(public Animal $x) { parent::constructor($x); }
}
final class Other1 {
    public Animal $x;
    public function constructor() { $this->x = new Animal(); }
}
Parent1 $v1x0 = new Child1(new Dog());
echo "same parent-variable: ", Show::of($v1x0->x), "\n";
Child1 $v1x1 = new Child1(new Dog());
echo "same child-variable: ", Show::of($v1x1->x), "\n";
object $v1x2 = new Child1(new Dog());
echo "same object: ", Show::of($v1x2->x), "\n";
mixed $v1x3 = new Child1(new Dog());
echo "same mixed: ", Show::of($v1x3->x), "\n";
Parent1 $v1x4 = new Child1(new Dog());
property<Parent1> $k1x4 = "x" as property<Parent1>;
echo "same property-key: ", Show::of($v1x4->$k1x4), "\n";
Parent1|Other1 $v1x5 = new Child1(new Dog());
echo "same union-tested: ", Show::of($v1x5->x), "\n";
Other1|Parent1 $v1x6 = new Child1(new Dog());
echo "same union-fallthrough: ", Show::of($v1x6->x), "\n";
--EXPECT--
same parent-variable: Dog
same child-variable: Dog
same object: Dog
same mixed: Dog
same property-key: Dog
same union-tested: Dog
same union-fallthrough: Dog
