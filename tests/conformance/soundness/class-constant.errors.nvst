--TEST--
Each redeclaration of a class constant that the rule refuses, and each path it refuses, is a compile error at the line it names (generated; `rule:statements/static-is-a-member-modifier`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent4 {
    public const int X = 1;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child4 extends Parent4 {
    public const string X = "c";
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}

class Parent6 {
    public const float X = 1.5;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child6 extends Parent6 {
    public const int X = 2;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}

class Parent7 {
    public const int X = 1;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child7 extends Parent7 {
    public const float X = 2.5;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}

class Parent9 {
    public const int X = 1;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child9 extends Parent9 {
    public const ?int X = 2;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}

class Parent11 {
    public const int|string X = "p";
    public static function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public static function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child11 extends Parent11 {
    public const int|string|bool X = true;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}
