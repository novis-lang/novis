--TEST--
A `secret` and a `tainted` value at reflection by name keep their qualifier, so the position or the sink after it is a compile error at the line it names (generated; `rule:security/taint-propagation`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Sink {
    public static function plain(string $s): void { echo $s, "\n"; }
}
class Holder {
    public secret string $token = "";
    public tainted string $name = "";
}

// cell: reflection secret
class Cell1 {
    public static function run(Holder $h, secret string $x): void {
        Core\Reflect::forObject($h)->set($h, "name", $x);
    }
}

// cell: reflection tainted
class Cell2 {
    public static function run(tainted string $x): void {
        Core\Reflect::forClass($x);
    }
}
--EXPECT--

--EXPECTF-ERROR--
error[E0895]: %s
%w--> %s:15:%d
%A
error[E0401]: %s
%w--> %s:22:%d
%A
error: aborting due to 2 errors
