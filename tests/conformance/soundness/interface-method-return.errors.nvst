--TEST--
Each redeclaration of an interface method's return type that the rule refuses, and each path it refuses, is a compile error at the line it names (generated; `rule:classes/an-override-keeps-its-parents-signature`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

interface Face3 {
    public function m(): Dog;
}
class Child3 implements Face3 {
    public function m(): Animal { return new Dog(); }
}

interface Face4 {
    public function m(): Animal;
}
class Child4 implements Face4 {
    public function m(): Plant { return new Plant(); }
}

interface Face6 {
    public function m(): float;
}
class Child6 implements Face6 {
    public function m(): int { return 2; }
}

interface Face7 {
    public function m(): int;
}
class Child7 implements Face7 {
    public function m(): float { return 2.5; }
}

interface Face9 {
    public function m(): Animal;
}
class Child9 implements Face9 {
    public function m(): ?Animal { return new Dog(); }
}

interface Face11 {
    public function m(): Animal|Plant;
}
class Child11 implements Face11 {
    public function m(): Animal|Plant|Stone { return new Stone(); }
}
