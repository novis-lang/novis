--TEST--
Each redeclaration of an interface constant that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:statements/static-is-a-member-modifier`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

interface Face1 {
    public const int X = 1;
    public function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child1 implements Face1 {
    public const int X = 2;
    public function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}
echo "same interface-name: ", Show::of(Face1::X), "\n";
echo "same class-name: ", Show::of(Child1::X), "\n";
Child1 $v1x2 = new Child1();
$v1x2->viaSelf("same self-in-interface: ");
Child1 $v1x3 = new Child1();
$v1x3->viaChildSelf("same self-in-class: ");
Child1 $v1x4 = new Child1();
$v1x4->viaStatic("same static: ");

interface Face5 {
    public const int|string X = "p";
    public function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child5 implements Face5 {
    public const int X = 2;
    public function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}
echo "int-under-int-string interface-name: ", Show::of(Face5::X), "\n";
echo "int-under-int-string class-name: ", Show::of(Child5::X), "\n";
Child5 $v5x2 = new Child5();
$v5x2->viaSelf("int-under-int-string self-in-interface: ");
Child5 $v5x3 = new Child5();
$v5x3->viaChildSelf("int-under-int-string self-in-class: ");
Child5 $v5x4 = new Child5();
$v5x4->viaStatic("int-under-int-string static: ");

interface Face8 {
    public const ?int X = 1;
    public function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child8 implements Face8 {
    public const int X = 2;
    public function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}
echo "t-under-nullable interface-name: ", Show::of(Face8::X), "\n";
echo "t-under-nullable class-name: ", Show::of(Child8::X), "\n";
Child8 $v8x2 = new Child8();
$v8x2->viaSelf("t-under-nullable self-in-interface: ");
Child8 $v8x3 = new Child8();
$v8x3->viaChildSelf("t-under-nullable self-in-class: ");
Child8 $v8x4 = new Child8();
$v8x4->viaStatic("t-under-nullable static: ");

interface Face10 {
    public const int|string X = "p";
    public function viaSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
    public function viaStatic(string $at): void { echo $at, Show::of(static::X), "\n"; }
}
class Child10 implements Face10 {
    public const string X = "c";
    public function viaChildSelf(string $at): void { echo $at, Show::of(self::X), "\n"; }
}
echo "member-under-union interface-name: ", Show::of(Face10::X), "\n";
echo "member-under-union class-name: ", Show::of(Child10::X), "\n";
Child10 $v10x2 = new Child10();
$v10x2->viaSelf("member-under-union self-in-interface: ");
Child10 $v10x3 = new Child10();
$v10x3->viaChildSelf("member-under-union self-in-class: ");
Child10 $v10x4 = new Child10();
$v10x4->viaStatic("member-under-union static: ");
--EXPECT--
same interface-name: int 1
same class-name: int 2
same self-in-interface: int 1
same self-in-class: int 2
same static: int 2
int-under-int-string interface-name: string p
int-under-int-string class-name: int 2
int-under-int-string self-in-interface: string p
int-under-int-string self-in-class: int 2
int-under-int-string static: int 2
t-under-nullable interface-name: int 1
t-under-nullable class-name: int 2
t-under-nullable self-in-interface: int 1
t-under-nullable self-in-class: int 2
t-under-nullable static: int 2
member-under-union interface-name: string p
member-under-union class-name: string c
member-under-union self-in-interface: string p
member-under-union self-in-class: string c
member-under-union static: string c
