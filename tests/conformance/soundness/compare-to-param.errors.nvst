--TEST--
Each redeclaration of `compareTo`'s parameter that the rule refuses, and each path it refuses, is a compile error at the line it names (generated; `rule:classes/an-override-keeps-its-parents-signature`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Root2 {}
class Parent2 extends Root2 implements Comparable {
    public function compareTo(self $other): int { echo "Parent2.compareTo ", Show::of($other), "\n"; return 0; }
}
class Child2 extends Parent2 {
    public function compareTo(self $other): int { echo "Child2.compareTo ", Show::of($other), "\n"; return 0; }
}

class Root4 {}
class Parent4 extends Root4 implements Comparable {
    public function compareTo(self $other): int { echo "Parent4.compareTo ", Show::of($other), "\n"; return 0; }
}
class Child4 extends Parent4 {
    public function compareTo(Plant $other): int { echo "Child4.compareTo ", Show::of($other), "\n"; return 0; }
}
--EXPECT--

