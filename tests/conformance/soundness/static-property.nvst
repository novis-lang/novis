echo "int-under-int-string child-name: ", Show::of(Child5::$x), "\n";
Child5::viaSelf("int-under-int-string self-in-parent: ");
Child5::viaChildSelf("int-under-int-string self-in-child: ");
object $v5x4 = new Child5();
try { mixed $r5x4 = $v5x4->x; echo "int-under-int-string object: ", Show::of($r5x4), "\n"; } catch (Throwable $e5x4) { echo "int-under-int-string object: threw", "\n"; }
mixed $v5x5 = new Child5();
try { mixed $r5x5 = $v5x5->x; echo "int-under-int-string mixed: ", Show::of($r5x5), "\n"; } catch (Throwable $e5x5) { echo "int-under-int-string mixed: threw", "\n"; }

