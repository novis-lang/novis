--TEST--
Each redeclaration of a static property that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:statements/static-is-a-member-modifier`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent1 {
    public static int $x = 1;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
class Child1 extends Parent1 {
    public static int $x = 2;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
echo "same parent-name: ", Show::of(Parent1::$x), "\n";
echo "same child-name: ", Show::of(Child1::$x), "\n";
Child1::viaSelf("same self-in-parent: ");
Child1::viaChildSelf("same self-in-child: ");
object $v1x4 = new Child1();
try { mixed $r1x4 = $v1x4->x; echo "same object: ", Show::of($r1x4), "\n"; } catch (Throwable $e1x4) { echo "same object: threw", "\n"; }
mixed $v1x5 = new Child1();
try { mixed $r1x5 = $v1x5->x; echo "same mixed: ", Show::of($r1x5), "\n"; } catch (Throwable $e1x5) { echo "same mixed: threw", "\n"; }

class Parent2 {
    public static ?Animal $x = null;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
class Child2 extends Parent2 {
    public static ?Dog $x = null;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
Parent2::$x = new Animal();
Child2::$x = new Puppy();
echo "subclass parent-name: ", Show::of(Parent2::$x), "\n";
echo "subclass child-name: ", Show::of(Child2::$x), "\n";
Child2::viaSelf("subclass self-in-parent: ");
Child2::viaChildSelf("subclass self-in-child: ");
object $v2x4 = new Child2();
try { mixed $r2x4 = $v2x4->x; echo "subclass object: ", Show::of($r2x4), "\n"; } catch (Throwable $e2x4) { echo "subclass object: threw", "\n"; }
mixed $v2x5 = new Child2();
try { mixed $r2x5 = $v2x5->x; echo "subclass mixed: ", Show::of($r2x5), "\n"; } catch (Throwable $e2x5) { echo "subclass mixed: threw", "\n"; }

class Parent3 {
    public static ?Dog $x = null;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
class Child3 extends Parent3 {
    public static ?Animal $x = null;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
Parent3::$x = new Dog();
Child3::$x = new Dog();
echo "superclass parent-name: ", Show::of(Parent3::$x), "\n";
echo "superclass child-name: ", Show::of(Child3::$x), "\n";
Child3::viaSelf("superclass self-in-parent: ");
Child3::viaChildSelf("superclass self-in-child: ");
object $v3x4 = new Child3();
try { mixed $r3x4 = $v3x4->x; echo "superclass object: ", Show::of($r3x4), "\n"; } catch (Throwable $e3x4) { echo "superclass object: threw", "\n"; }
mixed $v3x5 = new Child3();
try { mixed $r3x5 = $v3x5->x; echo "superclass mixed: ", Show::of($r3x5), "\n"; } catch (Throwable $e3x5) { echo "superclass mixed: threw", "\n"; }

class Parent4 {
    public static ?Animal $x = null;
    public static function viaSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
class Child4 extends Parent4 {
    public static ?Plant $x = null;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
Parent4::$x = new Animal();
Child4::$x = new Plant();
echo "unrelated parent-name: ", Show::of(Parent4::$x), "\n";
echo "unrelated child-name: ", Show::of(Child4::$x), "\n";
Child4::viaSelf("unrelated self-in-parent: ");
Child4::viaChildSelf("unrelated self-in-child: ");
object $v4x4 = new Child4();
try { mixed $r4x4 = $v4x4->x; echo "unrelated object: ", Show::of($r4x4), "\n"; } catch (Throwable $e4x4) { echo "unrelated object: threw", "\n"; }
mixed $v4x5 = new Child4();
try { mixed $r4x5 = $v4x5->x; echo "unrelated mixed: ", Show::of($r4x5), "\n"; } catch (Throwable $e4x5) { echo "unrelated mixed: threw", "\n"; }

class Parent5 {
    public static int|string $x = "p";
    public static function viaSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
class Child5 extends Parent5 {
    public static int $x = 2;
    public static function viaChildSelf(string $at): void { echo $at, Show::of(self::$x), "\n"; }
}
