--TEST--
Each redeclaration of a static method's parameter that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:classes/an-override-keeps-its-parents-signature`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent1 {
    public static function m(Animal $a): void { echo "Parent1.m ", Show::of($a), "\n"; }
    public static function viaStatic(string $at): void { echo $at; static::m(new Animal()); }
    public static function viaCallable(string $at): void { var $f = static::m; echo $at; $f(new Animal()); }
}
class Child1 extends Parent1 {
    public static function m(Animal $a): void { echo "Child1.m ", Show::of($a), "\n"; }
}
Child1::viaStatic("same static: ");
echo "same child-name: "; Child1::m(new Animal());
echo "same parent-name: "; Parent1::m(new Animal());
Parent1 $v1x3 = new Child1();
echo "same parent-variable: "; $v1x3->m(new Animal());
Child1::viaCallable("same callable: ");

class Parent3 {
    public static function m(Dog $a): void { echo "Parent3.m ", Show::of($a), "\n"; }
    public static function viaStatic(string $at): void { echo $at; static::m(new Dog()); }
    public static function viaCallable(string $at): void { var $f = static::m; echo $at; $f(new Dog()); }
}
class Child3 extends Parent3 {
    public static function m(Animal $a): void { echo "Child3.m ", Show::of($a), "\n"; }
}
Child3::viaStatic("superclass static: ");
echo "superclass child-name: "; Child3::m(new Dog());
echo "superclass parent-name: "; Parent3::m(new Dog());
Parent3 $v3x3 = new Child3();
echo "superclass parent-variable: "; $v3x3->m(new Dog());
Child3::viaCallable("superclass callable: ");

class Parent9 {
    public static function m(Animal $a): void { echo "Parent9.m ", Show::of($a), "\n"; }
    public static function viaStatic(string $at): void { echo $at; static::m(new Animal()); }
    public static function viaCallable(string $at): void { var $f = static::m; echo $at; $f(new Animal()); }
}
class Child9 extends Parent9 {
    public static function m(?Animal $a): void { echo "Child9.m ", Show::of($a), "\n"; }
}
Child9::viaStatic("nullable-over-t static: ");
echo "nullable-over-t child-name: "; Child9::m(new Animal());
echo "nullable-over-t parent-name: "; Parent9::m(new Animal());
Parent9 $v9x3 = new Child9();
echo "nullable-over-t parent-variable: "; $v9x3->m(new Animal());
Child9::viaCallable("nullable-over-t callable: ");

class Parent11 {
    public static function m(Animal|Plant $a): void { echo "Parent11.m ", Show::of($a), "\n"; }
    public static function viaStatic(string $at): void { echo $at; static::m(new Plant()); }
    public static function viaCallable(string $at): void { var $f = static::m; echo $at; $f(new Plant()); }
}
class Child11 extends Parent11 {
    public static function m(Animal|Plant|Stone $a): void { echo "Child11.m ", Show::of($a), "\n"; }
}
Child11::viaStatic("wider-union static: ");
echo "wider-union child-name: "; Child11::m(new Plant());
echo "wider-union parent-name: "; Parent11::m(new Plant());
Parent11 $v11x3 = new Child11();
echo "wider-union parent-variable: "; $v11x3->m(new Plant());
Child11::viaCallable("wider-union callable: ");
--EXPECT--
same static: Child1.m Animal
same child-name: Child1.m Animal
same parent-name: Parent1.m Animal
same parent-variable: Child1.m Animal
same callable: Child1.m Animal
superclass static: Child3.m Dog
superclass child-name: Child3.m Dog
superclass parent-name: Parent3.m Dog
superclass parent-variable: Child3.m Dog
superclass callable: Child3.m Dog
nullable-over-t static: Child9.m Animal
nullable-over-t child-name: Child9.m Animal
nullable-over-t parent-name: Parent9.m Animal
nullable-over-t parent-variable: Child9.m Animal
nullable-over-t callable: Child9.m Animal
wider-union static: Child11.m Plant
wider-union child-name: Child11.m Plant
wider-union parent-name: Parent11.m Plant
wider-union parent-variable: Child11.m Plant
wider-union callable: Child11.m Plant
