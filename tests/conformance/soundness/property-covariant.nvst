--TEST--
Each redeclaration of a `covariant` instance property that compiles runs the child's declaration through every path, and reads a value of its declared type (generated; `rule:classes/a-covariant-type-is-checked-where-a-value-enters`)
--FILE--
<?nvs
// Generated by `bun nv soundness --write` from the table in `tools/nv/cmd/soundness.ts`.
// Do not edit this file by hand: change the table and write it again.
class Show {
    public static function of(mixed $v): tainted string {
        if ($v == null) { return "null"; }
        if ($v is int) { return "int " . ($v as string); }
        if ($v is float) { return "float " . ($v as string); }
        if ($v is string) { return "string " . $v; }
        if ($v is bool) { return $v ? "bool true" : "bool false"; }
        if ($v is array<mixed>) {
            tainted string $s = "[";
            foreach ($v as mixed $e) { $s = $s . Show::of($e); }
            return $s . "]";
        }
        if ($v is object) { return $v::class; }
        return "unknown";
    }
}

class Animal {}
class Dog extends Animal {}
class Puppy extends Dog {}
class Plant {}
class Stone {}

class Parent2 {
    public Animal $x;
    public function constructor(Animal $v) { $this->x = $v; }
}
class Child2 extends Parent2 {
    public covariant Dog $x;
    public function constructor() { parent::constructor(new Puppy()); }
}
final class Other2 {
    public Animal $x;
    public function constructor() { $this->x = new Animal(); }
}
Parent2 $v2x0 = new Child2();
try { $v2x0->x = new Animal(); echo "subclass parent-variable: ", Show::of($v2x0->x), "\n"; } catch (LogicError $e2x0) { echo "subclass parent-variable: ", $e2x0->message, "\n"; }
Child2 $v2x1 = new Child2();
$v2x1->x = new Puppy();
echo "subclass child-variable: ", Show::of($v2x1->x), "\n";
object $v2x2 = new Child2();
try { $v2x2->x = new Animal(); echo "subclass object: ", Show::of($v2x2->x), "\n"; } catch (LogicError $e2x2) { echo "subclass object: ", $e2x2->message, "\n"; }
mixed $v2x3 = new Child2();
try { $v2x3->x = new Animal(); echo "subclass mixed: ", Show::of($v2x3->x), "\n"; } catch (LogicError $e2x3) { echo "subclass mixed: ", $e2x3->message, "\n"; }
Parent2 $v2x4 = new Child2();
property<Parent2> $k2x4 = "x" as property<Parent2>;
try { $v2x4->$k2x4 = new Animal(); echo "subclass property-key: ", Show::of($v2x4->x), "\n"; } catch (LogicError $e2x4) { echo "subclass property-key: ", $e2x4->message, "\n"; }
Parent2|Other2 $v2x5 = new Child2();
try { $v2x5->x = new Animal(); echo "subclass union-tested: ", Show::of($v2x5->x), "\n"; } catch (LogicError $e2x5) { echo "subclass union-tested: ", $e2x5->message, "\n"; }
Other2|Parent2 $v2x6 = new Child2();
try { $v2x6->x = new Animal(); echo "subclass union-fallthrough: ", Show::of($v2x6->x), "\n"; } catch (LogicError $e2x6) { echo "subclass union-fallthrough: ", $e2x6->message, "\n"; }

class Parent5 {
    public int|string $x;
    public function constructor(int|string $v) { $this->x = $v; }
}
class Child5 extends Parent5 {
    public covariant int $x;
    public function constructor() { parent::constructor(2); }
}
final class Other5 {
    public int|string $x;
    public function constructor() { $this->x = "p"; }
}
Parent5 $v5x0 = new Child5();
try { $v5x0->x = "p"; echo "int-under-int-string parent-variable: ", Show::of($v5x0->x), "\n"; } catch (LogicError $e5x0) { echo "int-under-int-string parent-variable: ", $e5x0->message, "\n"; }
Child5 $v5x1 = new Child5();
$v5x1->x = 2;
echo "int-under-int-string child-variable: ", Show::of($v5x1->x), "\n";
object $v5x2 = new Child5();
try { $v5x2->x = "p"; echo "int-under-int-string object: ", Show::of($v5x2->x), "\n"; } catch (LogicError $e5x2) { echo "int-under-int-string object: ", $e5x2->message, "\n"; }
mixed $v5x3 = new Child5();
try { $v5x3->x = "p"; echo "int-under-int-string mixed: ", Show::of($v5x3->x), "\n"; } catch (LogicError $e5x3) { echo "int-under-int-string mixed: ", $e5x3->message, "\n"; }
Parent5 $v5x4 = new Child5();
property<Parent5> $k5x4 = "x" as property<Parent5>;
try { $v5x4->$k5x4 = "p"; echo "int-under-int-string property-key: ", Show::of($v5x4->x), "\n"; } catch (LogicError $e5x4) { echo "int-under-int-string property-key: ", $e5x4->message, "\n"; }
Parent5|Other5 $v5x5 = new Child5();
try { $v5x5->x = "p"; echo "int-under-int-string union-tested: ", Show::of($v5x5->x), "\n"; } catch (LogicError $e5x5) { echo "int-under-int-string union-tested: ", $e5x5->message, "\n"; }
Other5|Parent5 $v5x6 = new Child5();
try { $v5x6->x = "p"; echo "int-under-int-string union-fallthrough: ", Show::of($v5x6->x), "\n"; } catch (LogicError $e5x6) { echo "int-under-int-string union-fallthrough: ", $e5x6->message, "\n"; }

class Parent8 {
    public ?Animal $x;
    public function constructor(?Animal $v) { $this->x = $v; }
}
class Child8 extends Parent8 {
    public covariant Animal $x;
    public function constructor() { parent::constructor(new Dog()); }
}
final class Other8 {
    public ?Animal $x;
    public function constructor() { $this->x = new Animal(); }
}
Parent8 $v8x0 = new Child8();
try { $v8x0->x = null; echo "t-under-nullable parent-variable: ", Show::of($v8x0->x), "\n"; } catch (LogicError $e8x0) { echo "t-under-nullable parent-variable: ", $e8x0->message, "\n"; }
Child8 $v8x1 = new Child8();
$v8x1->x = new Dog();
echo "t-under-nullable child-variable: ", Show::of($v8x1->x), "\n";
object $v8x2 = new Child8();
try { $v8x2->x = null; echo "t-under-nullable object: ", Show::of($v8x2->x), "\n"; } catch (LogicError $e8x2) { echo "t-under-nullable object: ", $e8x2->message, "\n"; }
mixed $v8x3 = new Child8();
try { $v8x3->x = null; echo "t-under-nullable mixed: ", Show::of($v8x3->x), "\n"; } catch (LogicError $e8x3) { echo "t-under-nullable mixed: ", $e8x3->message, "\n"; }
Parent8 $v8x4 = new Child8();
property<Parent8> $k8x4 = "x" as property<Parent8>;
try { $v8x4->$k8x4 = null; echo "t-under-nullable property-key: ", Show::of($v8x4->x), "\n"; } catch (LogicError $e8x4) { echo "t-under-nullable property-key: ", $e8x4->message, "\n"; }
Parent8|Other8 $v8x5 = new Child8();
try { $v8x5->x = null; echo "t-under-nullable union-tested: ", Show::of($v8x5->x), "\n"; } catch (LogicError $e8x5) { echo "t-under-nullable union-tested: ", $e8x5->message, "\n"; }
Other8|Parent8 $v8x6 = new Child8();
try { $v8x6->x = null; echo "t-under-nullable union-fallthrough: ", Show::of($v8x6->x), "\n"; } catch (LogicError $e8x6) { echo "t-under-nullable union-fallthrough: ", $e8x6->message, "\n"; }

class Parent10 {
    public Animal|Plant $x;
    public function constructor(Animal|Plant $v) { $this->x = $v; }
}
class Child10 extends Parent10 {
    public covariant Animal $x;
    public function constructor() { parent::constructor(new Dog()); }
}
final class Other10 {
    public Animal|Plant $x;
    public function constructor() { $this->x = new Plant(); }
}
Parent10 $v10x0 = new Child10();
try { $v10x0->x = new Plant(); echo "member-under-union parent-variable: ", Show::of($v10x0->x), "\n"; } catch (LogicError $e10x0) { echo "member-under-union parent-variable: ", $e10x0->message, "\n"; }
Child10 $v10x1 = new Child10();
$v10x1->x = new Dog();
echo "member-under-union child-variable: ", Show::of($v10x1->x), "\n";
object $v10x2 = new Child10();
try { $v10x2->x = new Plant(); echo "member-under-union object: ", Show::of($v10x2->x), "\n"; } catch (LogicError $e10x2) { echo "member-under-union object: ", $e10x2->message, "\n"; }
mixed $v10x3 = new Child10();
try { $v10x3->x = new Plant(); echo "member-under-union mixed: ", Show::of($v10x3->x), "\n"; } catch (LogicError $e10x3) { echo "member-under-union mixed: ", $e10x3->message, "\n"; }
Parent10 $v10x4 = new Child10();
property<Parent10> $k10x4 = "x" as property<Parent10>;
try { $v10x4->$k10x4 = new Plant(); echo "member-under-union property-key: ", Show::of($v10x4->x), "\n"; } catch (LogicError $e10x4) { echo "member-under-union property-key: ", $e10x4->message, "\n"; }
Parent10|Other10 $v10x5 = new Child10();
try { $v10x5->x = new Plant(); echo "member-under-union union-tested: ", Show::of($v10x5->x), "\n"; } catch (LogicError $e10x5) { echo "member-under-union union-tested: ", $e10x5->message, "\n"; }
Other10|Parent10 $v10x6 = new Child10();
try { $v10x6->x = new Plant(); echo "member-under-union union-fallthrough: ", Show::of($v10x6->x), "\n"; } catch (LogicError $e10x6) { echo "member-under-union union-fallthrough: ", $e10x6->message, "\n"; }
