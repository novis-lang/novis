--TEST--
A class reaches its own `private` property and `private` method through a `public` one, and a second instance of that class is as reachable as `$this` — ADR 0094 § 1
--FILE--
<?mwl
// The other half of the same rule: `private` is scoped to the declaring
// class, not to one object, so `$other->n` inside `Counter` is legal for the
// same reason `$this->n` is.
class Counter {
    private int $n = 0;
    private function bump(): void {
        $this->n = $this->n + 1;
    }
    public function twice(): int {
        $this->bump();
        $this->bump();
        return $this->n;
    }
    public function plus(Counter $other): int {
        return $this->n + $other->n;
    }
}
Counter $a = new Counter();
Counter $b = new Counter();
echo $a->twice(), "\n";
echo $b->twice(), "\n";
echo $a->plus($b), "\n";
--EXPECT--
2
2
4
