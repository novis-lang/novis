--TEST--
one prefix's roots are probed in declaration order and the first hit wins — `rule:programs/autoload`
--FILE--
<?nvs
// covers: lang:programs/autoload-find-a-class-by-its-namespace
// `App` has two homes. `App\Greeter` exists under both, so the first root
// answers and the second is never consulted; `App\Extra` exists only under
// the second, so the miss under the first is a miss rather than a failure.
// That pair is the Composer rule, and it is what makes an override directory
// in front of a vendor tree work.
require './bootstrap.nvs';
echo App\Greeter::from(), "\n";
echo App\Extra::from(), "\n";
--FILE bootstrap.nvs--
<?nvs
autoload 'App' from './override', './vendor';
--FILE override/Greeter.nvs--
<?nvs
namespace App;

class Greeter
{
    public static function from(): string
    {
        return "the first root";
    }
}
--FILE vendor/Greeter.nvs--
<?nvs
namespace App;

// Shadowed by the same name under the first root, so never loaded.
class Greeter
{
    public static function from(): string
    {
        return "the second root";
    }
}
--FILE vendor/Extra.nvs--
<?nvs
namespace App;

class Extra
{
    public static function from(): string
    {
        return "the second root";
    }
}
--EXPECT--
the first root
the second root
