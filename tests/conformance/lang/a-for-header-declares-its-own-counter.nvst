--TEST--
a `for` header's init clause is a typed declaration or an expression list, and the counter it declares is function-scoped — `rule:iteration/for-init-clause` and `rule:iteration/for-counter-scope`
--FILE--
<?nvs
// `rule:iteration/for-init-clause`: the declaration form. `local-decl` is ADR 0007 § 3.1's,
// unchanged and in full — so a written type and ADR 0037's `var` are the
// same production, not two.
for (int $i = 0; $i < 3; $i = $i + 1) {
    echo $i, " ";
}
echo "\n";

for (var $j = 0; $j < 3; $j = $j + 1) {
    echo $j, " ";
}
echo "\n";

// `rule:iteration/for-counter-scope`: the counter is function-scoped, exactly as ADR 0007 § 1
// makes every binding — so it is readable after the loop, carrying the
// value that ended it. That is what makes this a spelling change rather
// than a scoping one, and it is asserted from the outside.
echo $i, " ", $j, "\n";

// `rule:iteration/for-init-clause`: the condition and step clauses are unchanged, and so is
// the expression form of the init clause — the shape the corpus used
// before this ADR, and the shape a counter read after its loop still
// wants. Asserted here so that adding the declaration form cannot
// silently break it.
int $k = 0;
for ($k = 5; $k > 3; $k = $k - 1) {
    echo $k, " ";
}
echo "\n";
echo $k, "\n";

// A comma list is still a comma list when every item is an expression.
int $lo = 0;
int $hi = 0;
for ($lo = 0, $hi = 4; $lo < $hi; $lo = $lo + 1) {
    echo $lo, " ";
}
echo "\n";

// `for (;;)` — an empty init clause is the expression form with no items.
for (;;) {
    echo "once\n";
    break;
}

// The declaration form nests, and each loop's counter is its own name.
for (int $outer = 0; $outer < 2; $outer = $outer + 1) {
    for (int $inner = 0; $inner < 2; $inner = $inner + 1) {
        echo $outer, $inner, " ";
    }
}
echo "\n";

// `rule:iteration/for-init-clause`'s trial parse, from the other side: a `Name` starts both a
// class type and a static call, and only what follows it settles which.
final class Counter
{
    public static function start(): int
    {
        return 7;
    }
}

int $n = 0;
for ($n = Counter::start(); $n > 5; $n = $n - 1) {
    echo $n, " ";
}
echo "\n";

// The declaration's initialiser is an ordinary expression, so it may be a
// call — the trial parse commits on the `$`, not on the initialiser.
for (int $m = Counter::start(); $m > 5; $m = $m - 1) {
    echo $m, " ";
}
echo "\n";
--EXPECT--
0 1 2
0 1 2
3 3
5 4
3
0 1 2 3
once
00 01 10 11
7 6
7 6
