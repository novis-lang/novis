--TEST--
`.=` appends into the string's own buffer, and never into one a second binding still holds — ADR 0007 § 5
--FILE--
<?nvs
// A `string` local nothing else holds is appended to in place
// (`nvs_ir::ir::InstKind::StrAppend`, `nvs_runtime`'s `nvs_str_append`); one a
// second binding holds separates copy-on-write first, exactly as an array
// element write does under ADR 0007 § 5.
var $a = "grow";
var $b = $a;
$a .= "n";
echo $a, " ", $b, "\n";

// The separation happens once: `$a` owns its buffer now, so this append writes
// into it and `$b` is still untouched.
$a .= "!";
echo $a, " ", $b, "\n";

// The same allocation on both sides — its bytes are read before the old one
// is released.
var $s = "ab";
$s .= $s;
echo $s, "\n";

// The accumulate-in-a-loop shape capacity exists for, with a scalar suffix
// rendered to a `string` on the way in.
var $out = "";
var $i = 0;
while ($i < 8) {
    $out .= $i;
    $i = $i + 1;
}
echo $out, "\n";
--EXPECT--
grown grow
grown! grow
abab
01234567
