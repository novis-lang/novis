--TEST--
A parameter type that does not resolve reports once, where it is written, and a return of that parameter reports nothing more. A parameter written as `mixed` keeps its error — `rule:types/one-mistake-reports-once`
--FILE--
<?nvs
class Shop {
    // `Missing` is not declared. Its error is the only one this method gives.
    public static function label(Missing $item): string {
        // A method call, a property, an index, an operator and a loop give no error.
        $item->open();
        string $name = $item->name;
        int $first = $item[0];
        int $next = $item + 1;
        foreach ($item as string $part) {
        }
        string $class = $item::class;
        string $text = $item;
        // A conversion, a type test, text and destructuring give no error.
        int $count = $item as int;
        object $object = $item as object;
        string $converted = $item as string;
        bool $isShop = $item is Shop;
        string $joined = "item: {$item}";
        [int $left, int $right] = $item;
        array<int> $spread = [...$item];
        return $item;
    }

    // Each `Missing` written here gives one error. The default and the empty
    // `return` give none.
    public static function fallback(Missing $item = 3): Missing {
        return;
    }

    // `mixed` is what the program wrote, so returning it as a `string` is an error.
    public static function title(mixed $item): string {
        return $item;
    }

    // `Shop` has no parent class. Its error is the only one this method gives.
    public static function parentLabel(parent $item): string {
        return $item;
    }

    // A class reference, a property key and a read through an alias give no
    // error. Each `Missing` written here gives one.
    public static function kind(class<Missing> $kind, property<Missing> $key, Lookup::Red $red): string {
        return $key;
    }
}

type Lookup = Missing|int;

interface Lists {
    public function first(): string;
}

// A delegate typed with `Missing` gives no error.
class Catalog implements Lists by $inner {
    public function constructor(private Missing $inner) {}
}

// A command, a fixture, a test hook and a codec typed with `Missing` give no error.
class Tasks {
    #[Core\Command(name: "run", about: "Run the tasks")]
    public static function run(): Missing {
        return 0;
    }
}

final class ShopTest {
    #[Core\Test\Fixture]
    public static function item(): Missing {
        return 1;
    }

    #[Core\Test\Fixture]
    public static function other(): Missing {
        return 2;
    }

    #[Core\Test\AfterEachTest]
    public function after(Missing $outcome): void {
    }
}

#[Core\Json\Derive]
class Order {
    public Missing $item;

    public function constructor(int $item) {
        $this->item = $item;
    }
}
