--TEST--
A parameter type that does not resolve reports once, where it is written, and a return of that parameter reports nothing more. A parameter written as `mixed` keeps its error — `rule:types/one-mistake-reports-once`
--FILE--
<?nvs
class Shop {
    // `Missing` is not declared. Its error is the only one this method gives.
    public static function label(Missing $item): string {
        // A method call, a property, an index, an operator and a loop give no error.
        $item->open();
        string $name = $item->name;
        int $first = $item[0];
        int $next = $item + 1;
        foreach ($item as string $part) {
        }
        string $class = $item::class;
        string $text = $item;
        return $item;
    }

    // `mixed` is what the program wrote, so returning it as a `string` is an error.
    public static function title(mixed $item): string {
        return $item;
    }

    // `Shop` has no parent class. Its error is the only one this method gives.
    public static function parentLabel(parent $item): string {
        return $item;
    }
}
