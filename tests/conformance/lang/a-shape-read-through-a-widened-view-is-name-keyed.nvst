--TEST--
A shape field read through a widened view answers the field it names, not whatever sits at the view's own slot — `rule:types/shape-type` and `rule:types/erased-member-access`
--FILE--
<?nvs
// `rule:types/shape-type`'s width subtyping: `{x: int, y: int}` satisfies `{y: int}`,
// and the two lay their slots out differently. A shape's slots are its field
// names sorted, so `y` is slot 1 in the value and slot 0 in the view — which
// is why § 4 keys the fetch on the *name* rather than on a fixed offset.
class View {
    public static function y({y: int} $point): int {
        return $point->y;
    }

    // The same widening over a refcounted field: `label` is slot 1 in the
    // value and slot 0 in the view. The read borrows, so what `echo` renders
    // is the reference the value's own slot still owns.
    public static function label({label: string} $tagged): string {
        return $tagged->label;
    }
}

// Read back through the value's own shape: the slot the checker resolved is
// the one the value uses, and the runtime's hint hits on the first try.
var $point = {x: 1, y: 2};
echo $point->x, " ", $point->y, "\n";

// The same value through the narrower view, both as a binding and as a
// anonymous object written straight into the argument.
echo View::y($point), "\n";
echo View::y({x: 10, y: 20}), "\n";

echo View::label({alpha: "a", label: "left"}), "\n";
--EXPECT--
1 2
2
20
left
