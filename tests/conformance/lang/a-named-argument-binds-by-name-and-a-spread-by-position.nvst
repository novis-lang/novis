--TEST--
a `name:` call argument is evaluated where it is written and lands in its own parameter's slot, so a call may reorder its arguments and skip a defaulted parameter in the middle, while a `...` argument binds by position at the end of the list (ADR 0007 § 5, ADR 0063 R2, ADR 0011 § 1)
--FILE--
<?nvs
final class Fmt {
    // Three parameters, two of them defaulted, so a call can leave a hole
    // anywhere in the list rather than only at its end.
    public static function line(string $body, string $prefix = "> ", string $suffix = "!"): string {
        return $prefix . $body . $suffix;
    }
    // Written order is observable: `tap` says when it ran.
    public static function tap(string $v): string {
        echo "tap:", $v, " ";
        return $v;
    }
    public static function pair(string $a, string $b): string {
        return $a . "/" . $b;
    }
    // The body is handed the one array the call site collected, keys and all.
    public static function rest(string $sep, string ...$parts): string {
        string $out = "";
        foreach ($parts as string $p) {
            $out = $out . $p . $sep;
        }
        return "(" . $out . ")";
    }
}

final class Box {
    public string $tag;
    public int $size;
    public function constructor(string $tag = "t", int $size = 1) {
        $this->tag = $tag;
        $this->size = $size;
    }
    public function render(string $open = "[", string $close = "]"): string {
        return $open . $this->tag . ":" . $this->size as string . $close;
    }
    public static function bump(inout int $n, int $by = 1): void {
        $n = $n + $by;
    }
}

// A name fills its own parameter, so the middle default still applies.
echo Fmt::line("a"), "\n";
echo Fmt::line("a", suffix: "?"), "\n";
// Every argument named, and in none of the declared orders.
echo Fmt::line(suffix: "?", prefix: "* ", body: "a"), "\n";
echo Fmt::line(body: "a", suffix: "?"), "\n";

// Evaluation is in written order; placement is in parameter order. The two
// disagree here, and both are visible on one line.
echo Fmt::pair(b: Fmt::tap("B"), a: Fmt::tap("A")), "\n";

// `new` takes names the same way — this one skips the first parameter.
Box $b = new Box(size: 4);
echo $b->render(), "\n";
// So does an instance method, out of order.
echo $b->render(close: ">", open: "<"), "\n";

// An `inout $n` parameter written second by name still aliases the local it names.
int $n = 5;
Box::bump(by: 3, inout n: $n);
echo $n as string, "\n";

// A `...` binds by *position*, not by name: it lands wholly in the variadic
// tail, after every fixed parameter is filled, and its own entries become the
// tail's. A written argument before it keeps its own place.
array<string> $xs = ["a", "b"];
echo Fmt::rest("-"), "\n";
echo Fmt::rest("-", ...$xs), "\n";
echo Fmt::rest("-", "z", ...$xs), "\n";
--EXPECT--
> a!
> a?
* a?
> a?
tap:B tap:A A/B
[t:4]
<t:4>
8
()
(a-b-)
(z-a-b-)
