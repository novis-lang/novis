--TEST--
Every outer value an anonymous function reads is the copy that was there where the function was written, whichever shape held it, and an object captured that way is still the caller's own — `rule:types/implicit-capture`, `rule:types/anonymous-function`
--FILE--
<?nvs
// covers: lang:expressions/anonymous-functions
// Agreement over a sweep, not one answer: four shapes of captured storage are
// each written to after the function was created, and then counted. A shape
// that read its value at the call instead of where the function is written still prints
// plausibly on its own line and fails the count.
//
// The fifth shape is the one that differs, and it is named on both sides
// below: capture copies the value, and an object's value is the handle, so the
// object stays the caller's own while the number beside it does not.

class Cell {
    public int $n = 10;
}

class Maker {
    public int $base = 10;

    // `$this` is captured inside a method, so the function reads the object's
    // own property.
    public function reader(): callable {
        return fn (): int => $this->base;
    }

    // A parameter is an outer local like any other.
    public static function fromParameter(int $given): callable {
        return fn (): int => $given;
    }
}

int $local = 1;
string $text = "before";
array<int> $list = [1, 2];
Cell $cell = new Cell();
Maker $maker = new Maker();

callable $readsLocal = fn (): int => $local;
callable $readsText = fn (): string => $text;
callable $readsList = fn (): uint => Core\Arr::count($list);
callable $readsParameter = Maker::fromParameter(4) as callable;
callable $readsObject = fn (): int => $cell->n;

// Every one of them is written to after its function was written.
$local = 99;
$text = "after";
$list = Core\Arr::append($list, 3);
$cell->n = 20;

int $snapshots = 0;

if (($readsLocal() as int) == 1) {
    $snapshots = $snapshots + 1;
}

if (($readsText() as string) == "before") {
    $snapshots = $snapshots + 1;
}

if (($readsList() as uint) == 2) {
    $snapshots = $snapshots + 1;
}

if (($readsParameter() as int) == 4) {
    $snapshots = $snapshots + 1;
}

echo "shapes still holding what was there: ", $snapshots, " of 4\n";

// The row that differs, on both sides: the copy is of the handle, so the
// property written above is the one the function reads.
echo "through an object: ", $readsObject() as int, "\n";

// An anonymous function made in a loop takes that round's value, since the copy is made
// where the function is written, not where the call is.
array<callable> $rounds = [];
int $round = 0;

while ($round < 3) {
    $rounds = Core\Arr::append($rounds, fn (): int => $round);
    $round = $round + 1;
}

array<string> $seen = [];

foreach ($rounds as callable $reader) {
    $seen = Core\Arr::append($seen, ($reader() as int) as string);
}

echo "one per round: ", Core\Str::join($seen, ","), "\n";

// An anonymous function written inside another captures what the outer one captured,
// and `$this` reaches the property through the method it was written in.
callable $outer = fn (int $step): callable => fn (): int => $step * 2;

echo "two deep: ", $outer(21)() as int, " through this: ", $maker->reader()() as int, "\n";
--EXPECT--
shapes still holding what was there: 4 of 4
through an object: 20
one per round: 0,1,2
two deep: 42 through this: 10
