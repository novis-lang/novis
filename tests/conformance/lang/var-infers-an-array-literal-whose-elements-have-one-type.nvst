--TEST--
`var` over an array literal whose elements all have one type `T` declares an `array<T>`, at any depth, through a spread and as a `foreach` subject — `rule:types/var-inference`
--FILE--
<?nvs
// covers: lang:types/every-binding-has-a-type, lang:types/array-t
enum Size { Small, Large }

var $ids = [1, 2, 3];
$ids[] = 4;
var $prices = ["tea" => 2.5, "cake" => 4.0];
var $grid = [[1, 2], [3]];
var $all = [...$ids, ...[5, 6]];
var $sizes = [Size::Small, Size::Large];

// Each binding is the written type, so it passes where that type is read.
array<int> $sameIds = $ids;
array<float> $samePrices = $prices;
array<array<int>> $sameGrid = $grid;
array<Size> $sameSizes = $sizes;

echo Core\Arr::count($sameIds), " ", $samePrices["cake"], " ", $sameGrid[0][1], "\n";
echo Core\Str::join(Core\Arr::map($all, fn(int $n): string => $n as string), ","), "\n";
echo Core\Arr::count($sameSizes), "\n";

foreach ([10, 20] as var $n) {
    int $twice = $n * 2;
    echo $twice, "\n";
}
--EXPECT--
4 4 2
1,2,3,4,5,6
2
20
40
