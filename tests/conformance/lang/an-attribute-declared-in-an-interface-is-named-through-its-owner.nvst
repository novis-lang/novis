--TEST--
An attribute declared in an interface may be written `Owner::Name` on the interface's descendants and is retrieved as `Owner::Name` outside them, and an autoloaded attribute declaration is loaded by the attribute that names it — `rule:attributes/an-attribute-is-declared-with-its-sites` and `rule:attributes/a-retrieval-matches-the-declaration-it-names`
--FILE--
<?nvs
// `Page::Meta` is an attribute declared inside the interface `Page`.
// `Home` and `News` implement `Page`, so they may use it.
autoload 'Blog' from './lib';

interface Page {
    attribute Meta on method { title: string }
    public function render(): string;
}

class Home implements Page {
    #[Page::Meta(title: "Home")]
    public function render(): string { return "home"; }
}

class News implements Page {
    // `Blog\Section` is declared in `lib/Section.nvs`. Only this attribute
    // names it, so the attribute is what loads that file.
    #[Blog\Section(heading: "Latest")]
    #[Meta(title: "News", draft: true)]
    public function render(): string { return "news"; }
}

foreach (Core\Program::implementingWith<Page, Page::Meta>("render") as var $row) {
    echo $row->instance->render(), " ", $row->attribute?->title ?? "none", "\n";
}
foreach (Core\Program::implementingWith<Page, Blog\Section>("render") as var $section) {
    echo $section->instance->render(), " ", $section->attribute?->heading ?? "none", "\n";
}
--FILE lib/Section.nvs--
<?nvs
namespace Blog;

attribute Section on method { heading: string }
--EXPECT--
home Home
news News
home none
news Latest
