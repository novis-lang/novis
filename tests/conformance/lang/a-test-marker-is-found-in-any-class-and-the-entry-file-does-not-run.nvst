--TEST--
a `#[Test]` sits on a class that also holds ordinary methods, and the entry file's top-level statements do not run under `nvs test` (`rule:testing/test-attribute`)
--RUN--
test
--FILE--
<?nvs
// covers: lang:testing/a-test-is-a-method-marked-test
// `rule:testing/test-attribute`: nothing about a test is inferred from
// spelling, so the class under test holds its own tests beside its ordinary
// members — no base class, no interface, and no name the runner looks for.
// `--RUN--` above is what makes this case the runner's report; every other
// case in this tree is `nvs run`.
use Core\Test;

final class Basket {
    public static function shippingCents(int $totalCents): int {
        if ($totalCents >= 5000) {
            return 0;
        }
        return 499;
    }

    #[Test]
    public function aSmallBasketPaysForShipping(): void {
        Test::assertSame(Basket::shippingCents(1200), 499);
    }

    #[Test]
    public function theLimitItselfShipsFree(): void {
        Test::assertSame(Basket::shippingCents(5000), 0);
    }
}

// § 1: the entry file's top-level statements do not run under `nvs test`, so
// this line is absent from the report below. A case that ran them would print
// it above `Basket`.
echo "the entry file's statements do not run\n";
--EXPECTF--
  Basket
    ✓ aSmallBasketPaysForShipping      %f ms
    ✓ theLimitItselfShipsFree          %f ms

  0 failed, 2 passed, 0 skipped, 0 flaky in %d ms
