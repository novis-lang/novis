--TEST--
A `switch` compares every label in order, falls through a body with no `break`, and reaches `default` last wherever it is written
--FILE--
<?nvs
// covers: lang:statements/switch
class Grade {
    public static function tier(string $letter): string {
        switch ($letter) {
            case "A":
            case "B":
                return "pass";
            case "C":
                return "marginal";
            default:
                return "fail";
        }
    }
}

echo "tiers=", Grade::tier("A"), " ", Grade::tier("B"), " ", Grade::tier("C"), " ",
    Grade::tier("Z"), "\n";

// `default` written in the middle still runs last — every label is tried
// first — and still falls through into the case written after it.
var $log = "";
for (int $i = 0; $i < 4; $i += 1) {
    switch ($i) {
        case 0:
            $log .= "zero ";
            break;
        default:
            $log .= "other";
        case 3:
            $log .= "(3) ";
            break;
    }
}
echo "log=", $log, "|\n";

// A local declared inside one case body, and a `break` out of the switch.
var $sum = 0;
array<int> $ns = [1, 2, 3];
foreach ($ns as int $n) {
    switch ($n) {
        case 2:
            int $doubled = $n * 2;
            $sum += $doubled;
            break;
        default:
            $sum += $n;
            break;
    }
}
echo "sum=", $sum, "\n";

// No label matches and there is no `default`: the switch does nothing.
var $seen = "before ";
switch (9) {
    case 1:
        $seen .= "one";
        break;
}
$seen .= "after";
echo "seen=", $seen, "\n";
--EXPECT--
tiers=pass pass marginal fail
log=zero other(3) other(3) (3) |
sum=8
seen=before after
