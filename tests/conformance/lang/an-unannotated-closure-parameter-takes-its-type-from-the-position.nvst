--TEST--
A closure parameter written without a type takes it from the position the literal stands in, and its body is checked against what it took — `rule:types/anonymous-function-parameter-inference`, `rule:types/callable-arity`
--FILE--
<?nvs
class User {
    public string $name;
    public function constructor(string $name) { $this->name = $name; }
}

// `rule:types/anonymous-function-parameter-inference`: nothing annotates `$n`, so it is
// the `int` the written signature names — and `$n * 2` is the assertion, since
// `mixed` has no arithmetic to reach.
callable(int): int $twice = fn ($n): int => $n * 2;
echo $twice(21) as string, "\n";

// A parameter that *did* write its type keeps it, beside one that did not.
callable(string, int): string $tag = fn ($s, int $n): string => $s . "/" . ($n as string);
echo $tag("a", 7), "\n";

// `rule:types/callable-arity`'s prefix match, read through the inference: a
// literal shorter than the type takes the first types and never sees the rest.
callable(int, string): int $head = fn ($a): int => $a + 1;
echo $head(41, "ignored") as string, "\n";

// What the inference buys, and the reason it is worth having: `$u->name` is a
// field proven present on `User` where it is written, rather than
// `rule:types/erased-member-access`'s run-time fetch through a `mixed`.
callable(User): string $name = fn ($u): string => $u->name;
echo $name(new User("ada")), "\n";
--EXPECT--
42
a/7
42
ada
