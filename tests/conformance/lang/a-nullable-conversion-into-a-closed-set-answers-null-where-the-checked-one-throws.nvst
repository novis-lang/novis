--TEST--
`as ?T` into a literal, enum-case or whole-enum target answers `null` on exactly the values `as T` throws on, and coerces no more than it does — `rule:expressions/nullable-conversion-availability` row 2, over `rule:types/single-value-types`'s membership chain and `rule:types/conversion`'s two enum rows
--FILE--
<?nvs
enum Mode: int {
    Read = 1,
    Write = 2,
    Admin = 3,
}

final class Twin {
    // `rule:types/single-value-types`'s chain with the throw at the far end: the shape `as T`
    // has had since that section landed.
    public static function checkedMode(mixed $m): string {
        try {
            Mode $mode = $m as Mode;
            return "Mode(" . (($mode as int) as string) . ")";
        } catch (Throwable $threw) {
            return "threw";
        }
    }

    // `rule:expressions/nullable-conversion-availability` row 2: "that conversion is already checked and throwing;
    // this is its non-throwing twin." Same chain, with the miss edge answering
    // `null` instead of reaching `Helper::SingleValueMismatch`.
    public static function nullableMode(mixed $m): string {
        ?Mode $mode = $m as ?Mode;
        if ($mode != null) {
            return "Mode(" . (($mode as int) as string) . ")";
        }
        return "null";
    }

    // `rule:types/enum-case-type`'s named subset, over the same operand and the same pair.
    public static function checkedSubset(mixed $m): string {
        try {
            Mode::Read|Mode::Write $some = $m as Mode::Read|Mode::Write;
            return "Mode(" . (($some as int) as string) . ")";
        } catch (Throwable $refused) {
            return "threw";
        }
    }

    public static function nullableSubset(mixed $m): string {
        ?Mode $some = $m as ?(Mode::Read|Mode::Write);
        if ($some != null) {
            return "Mode(" . (($some as int) as string) . ")";
        }
        return "null";
    }

    // `rule:types/single-value-types`'s string literals. A `mixed` operand is tested on its own
    // runtime tag with no conversion in front of it, in both spellings, which
    // is what keeps a `mixed` holding `1` out of a set naming `"1"`.
    public static function checkedText(mixed $m): string {
        try {
            "a"|"b" $text = $m as "a"|"b";
            return $text;
        } catch (Throwable $missed) {
            return "threw";
        }
    }

    public static function nullableText(mixed $m): string {
        ?string $text = $m as ?("a"|"b");
        if ($text != null) {
            return $text;
        }
        return "null";
    }

    // The whole assertion of this case, asked of every row rather than read
    // off any one line: the twins **agree**, so a spelling that grew a
    // coercion of its own fails here while still printing plausibly on its
    // own side.
    public static function agrees(string $checked, string $nullable): bool {
        if ($checked == "threw") {
            return $nullable == "null";
        }
        return $checked == $nullable;
    }
}

// Every tag `rule:types/conversion` writes a row from, plus the two it does not: `true`
// has no numeric row at all, and `"x"` has one that fails.
array<mixed> $rows = ["1", 3, 9, true, "x", "a"];

int $pairs = 0;
int $agreed = 0;
foreach ($rows as mixed $row) {
    string $checked = Twin::checkedMode($row);
    string $nullable = Twin::nullableMode($row);
    echo $checked, " | ", $nullable, "\n";
    $pairs = $pairs + 1;
    if (Twin::agrees($checked, $nullable)) {
        $agreed = $agreed + 1;
    }

    string $subsetChecked = Twin::checkedSubset($row);
    string $subsetNullable = Twin::nullableSubset($row);
    echo $subsetChecked, " | ", $subsetNullable, "\n";
    $pairs = $pairs + 1;
    if (Twin::agrees($subsetChecked, $subsetNullable)) {
        $agreed = $agreed + 1;
    }

    string $textChecked = Twin::checkedText($row);
    string $textNullable = Twin::nullableText($row);
    echo $textChecked, " | ", $textNullable, "\n";
    $pairs = $pairs + 1;
    if (Twin::agrees($textChecked, $textNullable)) {
        $agreed = $agreed + 1;
    }
}
echo "agreed ", $agreed as string, " of ", $pairs as string, "\n";

// A statically typed operand takes the other branch — the base conversion
// runs first and the chain compares one representation — and the two
// spellings still agree.
int $two = 2;
echo Twin::nullableMode($two), "\n";
string $three = "3";
echo Twin::nullableMode($three), "\n";
string $far = "4";
echo Twin::nullableMode($far), "\n";

// `rule:types/grammar`'s two `bool` singletons as a nullable target: one value each,
// so a closed set of exactly the kind § 5 tests. `true` is a hit; `1` is not,
// because the test compares tags before payloads.
mixed $yes = true;
?bool $flag = $yes as ?true;
if ($flag != null) {
    echo "true\n";
} else {
    echo "null\n";
}
mixed $one = 1;
?bool $notFlag = $one as ?true;
if ($notFlag != null) {
    echo "true\n";
} else {
    echo "null\n";
}
--EXPECT--
Mode(1) | Mode(1)
Mode(1) | Mode(1)
threw | null
Mode(3) | Mode(3)
threw | null
threw | null
threw | null
threw | null
threw | null
threw | null
threw | null
threw | null
threw | null
threw | null
threw | null
threw | null
threw | null
a | a
agreed 18 of 18
Mode(2)
Mode(3)
null
true
null
