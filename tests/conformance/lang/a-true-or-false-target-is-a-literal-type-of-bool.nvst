--TEST--
`true` and `false` are `bool`'s literal types: an `as` into one tests membership and widening back to `bool` is free — `rule:types/grammar` and `rule:types/single-value-types`
--FILE--
<?nvs
class Flag {
    // § 4's checked row over the smallest closed set there is. A `mixed`
    // operand is tested against its own runtime tag, so a value that would
    // *convert* to `true` is still a miss: `1 as bool` is `true`, and `1` is
    // not `true`.
    public static function only(mixed $raw): string {
        try {
            true $on = $raw as true;
            return "on " . ($on as string) . "|";
        } catch (Throwable $e) {
            return "threw: " . $e->message;
        }
    }

    // The other singleton, and the reason a case renders through `as string`
    // with a sentinel after it: `false as string` is the empty string.
    public static function off(mixed $raw): string {
        try {
            false $flag = $raw as false;
            return "off " . ($flag as string) . "|";
        } catch (Throwable $e) {
            return "threw: " . $e->message;
        }
    }

    // A statically typed operand is converted first and tested after — the
    // same order the `int`/`string` sets already use, which is what makes a
    // truthy `int` a hit here where a `mixed` holding one is not. The miss
    // therefore names the *converted* value: `0` reaches the test as `false`.
    public static function truthy(int $n): string {
        try {
            true $on = $n as true;
            return "truthy " . ($on as string) . "|";
        } catch (Throwable $e) {
            return "threw: " . $e->message;
        }
    }

    // § 4's widening row: `true` is a subtype of `bool`, so the assignment
    // needs no conversion of its own — and § 5's "zero additional runtime
    // representation" is what makes that free.
    public static function widened(): string {
        true $on = true as true;
        bool $b = $on;
        return "widened " . ($b as string) . "|";
    }

    // The placement rule read the other way: a `true` expression is an
    // ordinary `bool` wherever the position does not name the singleton, so
    // an inferred binding stays reassignable.
    public static function inferred(): string {
        var $b = true;
        $b = false;
        return "inferred " . ($b as string) . "|";
    }
}

echo Flag::only(true), "\n";
echo Flag::only(false), "\n";
echo Flag::only(1), "\n";
echo Flag::only("true"), "\n";
echo Flag::off(false), "\n";
echo Flag::off(true), "\n";
echo Flag::truthy(1), "\n";
echo Flag::truthy(0), "\n";
echo Flag::widened(), "\n";
echo Flag::inferred(), "\n";
--EXPECT--
on 1|
threw: `false` is not one of `true`
threw: `1` is not one of `true`
threw: `"true"` is not one of `true`
off |
threw: `true` is not one of `false`
truthy 1|
threw: `false` is not one of `true`
widened 1|
inferred |
