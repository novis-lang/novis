--TEST--
Every arithmetic row with a `float` on one side promotes the other, and the promotion is the checked one — `rule:types/conversion` and `rule:types/arithmetic`
--FILE--
<?nvs
// `rule:types/arithmetic`'s "either operand a `float`" row, swept rather than sampled:
// four operators over four mixed pairings, counted rather than read off a
// line, so an implementation that promotes `int + float` and forgets
// `float + uint` fails here instead of printing plausibly.
int $n = 3;
uint $u = 3;
float $f = 0.5;
int $rows = 0;

if ($n + $f == 3.5) { $rows += 1; }
if ($f + $n == 3.5) { $rows += 1; }
if ($u + $f == 3.5) { $rows += 1; }
if ($f + $u == 3.5) { $rows += 1; }
if ($n - $f == 2.5) { $rows += 1; }
if ($f - $n == 0.0 - 2.5) { $rows += 1; }
if ($u - $f == 2.5) { $rows += 1; }
if ($f - $u == 0.0 - 2.5) { $rows += 1; }
if ($n * $f == 1.5) { $rows += 1; }
if ($f * $n == 1.5) { $rows += 1; }
if ($u * $f == 1.5) { $rows += 1; }
if ($f * $u == 1.5) { $rows += 1; }
if ($n / $f == 6.0) { $rows += 1; }
if ($f / $n == 0.5 / 3.0) { $rows += 1; }
if ($u / $f == 6.0) { $rows += 1; }
if ($f / $u == 0.5 / 3.0) { $rows += 1; }
echo "arithmetic rows promoting: ", $rows, " of 16\n";

// The ordering rows are the same table's, but they are *not* the same
// mechanism: § 4 closes with "a comparison has an exact answer in the
// mathematical integers and can be lowered as one", so no operand is
// converted at all. Both directions of all four operators, counted.
int $orders = 0;
if ($n < $f) { } else { $orders += 1; }
if ($n <= $f) { } else { $orders += 1; }
if ($n > $f) { $orders += 1; }
if ($n >= $f) { $orders += 1; }
if ($f < $n) { $orders += 1; }
if ($f <= $n) { $orders += 1; }
if ($f > $n) { } else { $orders += 1; }
if ($f >= $n) { } else { $orders += 1; }
echo "ordering rows agreeing: ", $orders, " of 8\n";

// `rule:types/conversion`'s bound, asserted on both sides. The implicit widening is the
// *same* conversion `$n as float` performs — "exact, or throws above 2^53" —
// so the last integer an `f64` represents widens and the first one it does
// not throws.
int $exact = 9007199254740992;
float $widened = $exact + 0.0;
echo "2^53 widens: ", $widened, "\n";

int $past = 9007199254740993;
try {
    float $lost = $past + 0.0;
    echo "widened ", $lost, "\n";
} catch (Throwable $over) {
    echo "past 2^53 throws: ", $over->message, "\n";
}

// And the same value ordered rather than added: exact, and never a throw,
// which is the whole reason a comparison does not go through the widening
// three lines above.
int $exactOrders = 0;
if ($past > $f) { $exactOrders += 1; }
if ($past >= $f) { $exactOrders += 1; }
if ($past < $f) { } else { $exactOrders += 1; }
if ($past <= $f) { } else { $exactOrders += 1; }
echo "ordering past 2^53 agreeing: ", $exactOrders, " of 4\n";
--EXPECT--
arithmetic rows promoting: 16 of 16
ordering rows agreeing: 8 of 8
2^53 widens: 9.007199254741E+15
past 2^53 throws: cannot convert `int` 9007199254740993 to `float`
ordering past 2^53 agreeing: 4 of 4
