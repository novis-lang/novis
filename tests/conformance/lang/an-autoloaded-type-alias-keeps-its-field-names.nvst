--TEST--
A `type` alias declared in an autoloaded file expands to the shape it declares, field names included, wherever it is used — `rule:types/type-alias` and `rule:programs/autoload`
--FILE--
<?nvs
// `Blog\Post` is declared in `lib/Post.nvs` and used here. Its expansion is
// read from that file, so its field names and the `Core` enum it names are
// the ones written there. Read with this file's text, both came out empty.
autoload 'Blog' from './lib';

class Main {
    public static function run(): void {
        Blog\Post $post = {title: 'Hello', method: Core\Http\Method::Get};
        echo $post->title, "\n";
        echo $post->method == Core\Http\Method::Get ? "get" : "other", "\n";
    }
}
Main::run();
--FILE lib/Post.nvs--
<?nvs
namespace Blog;

type Post = {title: string, method: Core\Http\Method};
--EXPECT--
Hello
get
