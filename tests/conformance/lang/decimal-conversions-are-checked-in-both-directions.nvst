--TEST--
ADR 0054 § 4: every conversion into and out of decimal is exact or throws, and a float is read at the value it prints as
--FILE--
<?nvs
// Into `decimal`: an integer is always exact, a string must be an exact
// literal in full, and a float is read at the value it *prints* as -- so
// `0.1` is `0.1`, not `0.1000000000000000055...`.
echo 42 as decimal, "|", "1.250" as decimal, "|", 0.1 as decimal, "\n";

// Out of `decimal`: integral and in range, or it throws. Rounding is said out
// loud, so `1.5 as int` is refused rather than silently picking a direction.
echo 2.00 as decimal as int, "|", 19.99 as decimal as float, "\n";

try {
    echo 1.5 as decimal as int, "\n";
} catch (Throwable $e) {
    echo "refused\n";
}

// `rule:expressions/nullable-conversion`'s non-throwing form answers `null` on the same rows.
echo ("nope" as ?decimal) ?? 0.0 as decimal, "|", ("7.5" as ?decimal) ?? 0.0 as decimal, "\n";

// ADR 0054 § 3: an overflow throws rather than wrapping or reducing scale.
try {
    echo (1 as decimal / 0), "\n";
} catch (Throwable $e) {
    echo "no division by zero\n";
}
--EXPECT--
42|1.250|0.1
2|19.99
refused
0.0|7.5
no division by zero
