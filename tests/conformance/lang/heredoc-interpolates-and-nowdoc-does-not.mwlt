--TEST--
A heredoc interpolates like a double-quoted string; a nowdoc keeps every character literal
--FILE--
<?mwl
string $who = "world";
int $count = 2;

string $doc = <<<TXT
hello $who
you have $count messages
TXT;
echo $doc, "\n";

string $raw = <<<'TXT'
hello $who
no \t escape here
TXT;
echo $raw, "\n";
--EXPECT--
hello world
you have 2 messages
hello $who
no \t escape here
