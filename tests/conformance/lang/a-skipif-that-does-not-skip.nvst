--TEST--
a --SKIPIF-- whose output does not start with `skip` lets the case run
--SKIPIF--
<?nvs
if (Core\Str::length("abc") != 3) {
    echo "skip strings are broken, so this proves nothing";
}
--FILE--
<?nvs
echo "ran\n";
--EXPECT--
ran
--CLEAN--
<?nvs
echo "this output is ignored, by definition";
