--TEST--
A `mixed` subject answers `is T` in both directions for every scalar, `object`, class, interface, `array`, `array<T>`, single-value, class-constant and enum-case row of the table, and for `mixed` itself — `rule:types/type-test`, `rule:types/uint`, `rule:types/single-value-types`, `rule:types/enum-case-type`
--FILE--
<?nvs
// `rule:types/type-test`'s table under "What may appear on the right", swept
// over a `mixed` subject — the one position where nothing is known
// statically, so every row below is the run-time answer and not a fold. Each
// row is asked twice, of a value that holds the type and of one that does
// not, and the rows are counted rather than read off their own lines: an
// operator that answered `true` for everything prints plausibly row by row
// and still fails the count.
//
// `uint` and `decimal` have rows here because PHP has no predicate for
// either, so they are the two the table cannot borrow a migration answer for.

interface Named {}

enum Rank: int {
    Bronze = 1,
    Silver = 2,
}

class Animal implements Named {
    public string $animalName;

    public function constructor(string $animalName) {
        $this->animalName = $animalName;
    }
}

class Rock {}

class Mode {
    public const int READ = 1;
}

class Row {
    // 1 where the row answered `true` for the value that holds the type and
    // `false` for the one that does not. The row is named on stdout when it
    // did not, so a failure says which one moved rather than only that the
    // count fell.
    public static function both(string $row, bool $holds, bool $other): int {
        if ($holds && !$other) {
            return 1;
        }
        echo "WRONG ", $row, ": ", Row::yn($holds), Row::yn($other), "\n";
        return 0;
    }

    // `bool as string` renders `false` as the empty string, which would let a
    // row whose two halves both went missing read as agreement.
    public static function yn(bool $b): string {
        if ($b) {
            return "y";
        }
        return "n";
    }
}

mixed $int = 1;
uint $u = 7;
mixed $uint = $u;
mixed $float = 2.5;
decimal $d = 19.99;
mixed $decimal = $d;
mixed $string = "yay";
bytes $b = "ab" as bytes;
mixed $bytes = $b;
mixed $true = true;
mixed $false = false;
mixed $null = null;
mixed $animal = new Animal("rex");
mixed $rock = new Rock();
mixed $ints = [1, 2, 3];
mixed $strings = ["a", "b"];
Rank $r = Rank::Silver;
mixed $rank = $r;
mixed $five = 5;
mixed $other = "nope";

int $rows = 0;

// The tag rows: one masked comparison each against the tag the value carries.
$rows = $rows + Row::both("int", $int is int, $string is int);
$rows = $rows + Row::both("uint", $uint is uint, $int is uint);
$rows = $rows + Row::both("float", $float is float, $int is float);
$rows = $rows + Row::both("decimal", $decimal is decimal, $float is decimal);
$rows = $rows + Row::both("string", $string is string, $bytes is string);
$rows = $rows + Row::both("bytes", $bytes is bytes, $string is bytes);
$rows = $rows + Row::both("bool", $true is bool, $int is bool);
$rows = $rows + Row::both("null", $null is null, $string is null);

// `object` is the opaque top of every class type, and asks nothing about
// which class the value is.
$rows = $rows + Row::both("object", $animal is object, $ints is object);

// A class and an interface are the descriptor walk a class test already
// pays for, reached once from a subject that is not an object at all and
// once from an object of the wrong class.
$rows = $rows + Row::both("class", $animal is Animal, $string is Animal);
$rows = $rows + Row::both("interface", $animal is Named, $rock is Named);

// A bare `array` is a tag row; a named element type is the O(n) walk
// `as array<T>` already performs, answering instead of throwing.
$rows = $rows + Row::both("array", $ints is array, $string is array);
$rows = $rows + Row::both("array<int>", $ints is array<int>, $strings is array<int>);

// `rule:types/single-value-types`: a literal is its own single-value type, so the row is a tag
// comparison with a payload compare behind it. `true` is a type here and not
// a value — `$x is true` is this row, `$x == true` is not.
$rows = $rows + Row::both("single-value int", $five is 5, $int is 5);
$rows = $rows + Row::both("single-value string", $string is 'yay', $other is 'yay');
$rows = $rows + Row::both("single-value true", $true is true, $false is true);

// `rule:types/constant-in-type-position`: a scalar class constant in type
// position folds to the single-value type of its own value, so this is the row
// above under another spelling.
$rows = $rows + Row::both("class constant", $int is Mode::READ, $string is Mode::READ);

// `rule:types/enum-case-type`: a case is a narrowed subtype of its enum, and
// the payload compare happens on the backing integer
// `rule:enums/representation` makes it.
$rows = $rows + Row::both("enum case", $rank is Rank::Silver, $rank is Rank::Bronze);

echo "rows=", $rows as string, "/18\n";

// `mixed` is the table's wildcard and the one row with no false side: it
// holds every value, so the checker settles the test to `true` for any
// subject, `null` included.
echo "mixed=", Row::yn($null is mixed), Row::yn($animal is mixed), "\n";
--EXPECT--
rows=18/18
mixed=yy
