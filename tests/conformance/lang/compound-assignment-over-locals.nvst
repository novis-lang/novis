--TEST--
`$x op= e` means `$x = $x op e`, for the arithmetic operators and `.`
--FILE--
<?nvs
int $i = 3;
$i += 4;
$i -= 1;
$i *= 2;
echo $i, "\n";

uint $u = 10;
$u += 5;
$u %= 4;
echo $u, "\n";

float $f = 1.5;
$f *= 2.0;
$f /= 4.0;
echo $f, "\n";

var $s = "a";
$s .= "b";
$s .= "c" . "d";
echo $s, "\n";

var $total = 0;
int $n = 0;
while ($n < 5) {
    $total += $n;
    $n += 1;
}
echo $total, "\n";
echo $n, "\n";
--EXPECT--
12
3
0.75
abcd
10
5
