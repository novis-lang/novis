--TEST--
a compound assignment reaches a property and an array element, not just a local
--FILE--
<?nvs
class Counter {
    public int $count;
    public string $log;

    public function constructor() {
        $this->count = 0;
        $this->log = "";
    }

    public function bump(int $by): void {
        $this->count += $by;
        $this->log .= "+";
    }
}

var $c = new Counter();
$c->bump(3);
$c->bump(4);
$c->count *= 2;
$c->log .= "!";
echo $c->count, "\n";
echo $c->log, "\n";

array<int> $nums = [1, 2, 3];
int $k = 1;
$nums[$k] += 40;
$nums[2] -= 3;
echo $nums[0], " ", $nums[1], " ", $nums[2], "\n";

array<string> $words = ["a", "b"];
$words[0] .= "x";
echo Core\Str::join($words, ","), "\n";

?string $maybe = null;
$maybe ??= "filled";
$maybe ??= "ignored";
echo $maybe ?? "none", "\n";
--EXPECT--
14
++!
1 42 0
ax,b
filled
