--TEST--
`float` arithmetic renders the way PHP's does — a whole result loses its fractional part
--FILE--
<?mwl
float $half = 7.0 / 2.0;
echo $half, "|\n";
echo 1.5 + 2.25, "|\n";
echo 2.5 * 4.0, "|\n";
echo 1.0 - 1.0, "|\n";
echo 7 as float, "|\n";
echo (2.5 * 4.0) as string, "|\n";
echo 0.5 + 0.25, "|\n";
--EXPECT--
3.5|
3.75|
10|
0|
7|
10|
0.75|
