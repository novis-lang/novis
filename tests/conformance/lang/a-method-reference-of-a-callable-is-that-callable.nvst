--TEST--
`$f(...)` over a `callable` answers the very callable `$f` already holds rather than wrapping it, at every shape the callee can take — `rule:types/callable-values`
--FILE--
<?nvs
// `callable` has exactly one inhabitant, so `$f(...)` already names a callable
// and there is nothing left for it to build: the answer is `$f` itself, with
// one more owner. This sweeps one spelling per shape the callee can be, so a
// site that started wrapping shows up as a `different` rather than as a value
// that still happens to answer the same number.
class C {
    public int $base = 10;
    public static function twice(int $n): int { return $n * 2; }
    public function plus(int $n): int { return $this->base + $n; }
    public static function pick(callable $c): callable { return $c(...); }
}

// A local holding a static-method reference. The read borrows the local's
// slot, so this is the shape that owes a retain.
callable $f = C::twice(...);
callable $g = $f(...);
echo $g(3), "\n";
echo $g == $f ? "same\n" : "different\n";

// An anonymous function's own local, and the same question asked across a call
// boundary — `pick` takes the sentinel over its parameter and returns it, so
// the identity has to survive a parameter slot and a return.
callable $h = fn (int $n): int => $n + 1;
callable $k = $h(...);
echo $k(4), "\n";
echo $k == $h ? "same\n" : "different\n";
echo C::pick($h) == $h ? "same\n" : "different\n";

// A bound instance-method reference, so the receiver rides along with it.
C $c = new C();
callable $m = $c->plus(...);
callable $n = $m(...);
echo $n(5), "\n";

// A callee that is no slot read at all: the callable the inner call produced is
// already this frame's to hand on, so this is the shape that must *not* retain.
callable $p = C::pick($h)(...);
echo $p(6), "\n";

// Taken a thousand times over one durable callable. A missing retain drops the
// last owner while `$f` still names it and a doubled one never frees, so the
// accounting is asserted by the loop finishing rather than by a printed value.
int $i = 0;
while ($i < 1000) {
    callable $q = $f(...);
    $i = $i + 1;
}
echo "looped\n";
--EXPECT--
6
same
5
same
same
15
7
looped
