--TEST--
a compound assignment through a `&$x` parameter updates the caller's own binding
--FILE--
<?mwl
class Bump {
    public static function twice(inout int $n, inout string $s): void {
        $n += 2;
        $s .= "!";
    }
}

int $count = 5;
var $label = "go";
Bump::twice(inout $count, inout $label);
Bump::twice(inout $count, inout $label);
echo $count, "\n";
echo $label, "\n";
--EXPECT--
9
go!!
