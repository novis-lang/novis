--TEST--
An argument to an anonymous function is checked against the parameter's declared type, identically through `$fn(...)` and a `Core` member's callback — `rule:types/anonymous-function`, `rule:types/conversion`
--FILE--
<?nvs
// `rule:types/anonymous-function`: a `callable` carries no parameter list, so nothing above the
// call can check what an anonymous function's parameters require. The callable object
// records one nibble per parameter and `nvs_runtime::call_callable` compares
// each argument against it — the one path both callers below take.
callable $isKeep = fn (string $s): bool => $s == "keep";

// The matching side, asked of both callers. Agreement rather than one answer:
// a check that grew a second entry point with a convention of its own would
// fail here while each half still printed plausibly on its own line.
// `filter`'s callback declares its signature (`rule:types/callable-signature`)
// and a bare `callable` promises none, so both callers below reach `$isKeep`
// through an anonymous function — which is what keeps them the *same* two callers.
array<string> $words = ["keep", "drop", "keep"];
array<string> $kept = Core\Arr::filter($words, fn (string $w): bool => $isKeep($w) as bool);
int $agree = 0;
foreach ($words as string $w) {
    if ($isKeep($w)) {
        $agree = $agree + 1;
    }
}
echo "kept ", Core\Arr::count($kept) as string, " agree ", $agree as string, "\n";

// The mismatched side, the same callable and the same two callers. The throw is
// an ordinary catchable `LogicError` (`rule:errors/propagation`'s checked return), not an engine
// fault, and it names the position, what it required and what arrived.
array<int> $ints = [1, 2, 3];
try {
    array<int> $none = Core\Arr::filter($ints, fn (int $n): bool => $isKeep($n) as bool);
    echo "filter did not throw, kept ", Core\Arr::count($none) as string, "\n";
} catch (Throwable $e) {
    echo "filter: ", $e->message, "\n";
}
try {
    // Bound before it is echoed: `echo` writes its arguments one at a time, so
    // evaluating the call inside the list would print the prefix before the
    // throw reached the `catch`.
    tainted string $direct = $isKeep(7) as string;
    echo "direct did not throw, ", $direct, "\n";
} catch (Throwable $e) {
    echo "direct: ", $e->message, "\n";
}

// `rule:types/conversion` makes `mixed` the one unchecked position, so a parameter
// declared `mixed` records the nibble that admits every tag and neither
// argument below is compared against anything.
callable $describe = fn (mixed $m): string => Core\Json::encode($m);
echo $describe(7) as string, " ", $describe("x") as string, "\n";
--EXPECT--
kept 2 agree 2
filter: argument 1 to a `callable` must be of type string, int given
direct: argument 1 to a `callable` must be of type string, int given
7 "x"
