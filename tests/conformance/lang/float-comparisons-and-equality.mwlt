--TEST--
`<`, `<=`, `===` and `!==` over `float` behave as the ordered comparisons they are
--FILE--
<?mwl
echo (1.5 < 2.5) as string, "|", (2.5 < 1.5) as string, "|\n";
echo (2.5 <= 2.5) as string, "|", (2.5 >= 2.5) as string, "|\n";
echo (1.0 === 1.0) as string, "|", (1.0 !== 1.0) as string, "|\n";
echo (0.0 === 0.0) as string, "|", ((0.0 - 1.5) < 0.0) as string, "|\n";
echo ((1.0 / 3.0) < 0.34) as string, "|\n";
echo (1.5 + 1.5 === 3.0) as string, "|\n";
--EXPECT--
1||
1|1|
1||
1|1|
1|
1|
