--TEST--
A `while` nested in a `while` keeps its own counter, and `break` leaves only the inner one
--FILE--
<?mwl
int $i = 0;
int $total = 0;
while ($i < 3) {
    int $j = 0;
    while ($j < 3) {
        $total = $total + $i * $j;
        $j = $j + 1;
    }
    $i = $i + 1;
}
echo $total, "\n";

int $row = 0;
var $out = "";
while ($row < 3) {
    int $col = 0;
    while ($col < 5) {
        if ($col > $row) {
            break;
        }
        $out = $out . $row . $col . ";";
        $col = $col + 1;
    }
    $row = $row + 1;
}
echo $out, "\n";
--EXPECT--
9
00;10;11;20;21;22;
