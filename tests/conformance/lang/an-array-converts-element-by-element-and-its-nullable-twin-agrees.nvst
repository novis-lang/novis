--TEST--
`array<T> as array<U>` walks every element and throws on the first one `U` does not admit, and `as ?array<U>` answers `null` in exactly the same places — `rule:types/conversion`, `rule:types/arrays` and `rule:types/unions-and-mixed` and `rule:expressions/nullable-conversion`
--FILE--
<?nvs
// `rule:types/conversion`'s one row whose check is per *element* rather than per value.
// Every subject arrives through `mixed`, which is § 6's way into it: two are
// arrays of strings, one is an array holding something else, and one is not an
// array at all.
array<mixed> $subjects = [["a", "b"], ["a", 1], [], "not an array"];

// One question asked twice of each, and the assertion is that the two
// spellings **agree** rather than what either answered on its own: `rule:expressions/nullable-conversion`
// says `as ?T` yields `null` exactly where `as T` would throw, so a walk
// that stopped one element early would still print plausibly against either
// half alone.
int $agreed = 0;
int $elements = 0;
foreach ($subjects as mixed $subject) {
    bool $threw = false;
    try {
        array<tainted string> $checked = $subject as array<string>;
        // `Core\Arr::count` answers a `uint`, which an `int` may not meet.
        $elements = $elements + (Core\Arr::count($checked) as int);
    } catch (Throwable $e) {
        $threw = true;
    }
    ?array<tainted string> $maybe =$subject as ?array<string>;
    if ($threw == ($maybe == null)) {
        $agreed = $agreed + 1;
    }
}
echo "agreed on ", $agreed as string, " of 4\n";
echo "walked ", $elements as string, " elements\n";

// `rule:types/arrays`'s "nests to any depth", which the walk follows: an element of
// the grid that is not itself an array of strings fails the outer conversion.
mixed $grid = [["a"], ["b", "c"]];
array<array<tainted string>> $cells =$grid as array<array<string>>;
echo Core\Json::encode($cells), "\n";

mixed $ragged = [["a"], [1]];
try {
    array<array<tainted string>> $flat =$ragged as array<array<string>>;
    echo "the nested row let it through\n";
} catch (Throwable $nested) {
    echo "the nested row throws\n";
}

// `array<mixed>` is the target every tag satisfies, so there is nothing for
// the walk to decide and the array comes back as it was — `rule:types/grammar`'s one
// unchecked position, one container in.
array<int> $ints = [1, 2, 3];
array<mixed> $any = $ints as array<mixed>;
echo Core\Json::encode($any), "\n";
--EXPECT--
agreed on 4 of 4
walked 2 elements
[["a"],["b","c"]]
the nested row throws
[1,2,3]
