--TEST--
`rule:expressions/nullable-conversion`'s `as ?T` yields `null` exactly where `as T` would throw
--FILE--
<?nvs
// covers: lang:types/nullable-union-literal-and-enum-case-types
// § 1 — the value the throwing form would produce, wherever it succeeds.
echo ("42" as ?int) ?? -1, "\n";
echo ("-7" as ?int) ?? -1, "\n";
echo ("0" as ?int) ?? -1, "\n";
echo ("3.5" as ?float) ?? -1.0, "\n";

// § 1 — `null` exactly where `as T` throws. `rule:types/conversion`'s whole-string rule
// reaches this form unchanged, so "12abc" is null rather than PHP's 12, and
// 19.99 is null rather than 19.
echo ("abc" as ?int) ?? -1, "\n";
echo ("12abc" as ?int) ?? -1, "\n";
echo ("" as ?int) ?? -1, "\n";
echo (19.99 as ?int) ?? -1, "\n";

// § 2 — a `null` operand converts to `null` rather than being a diagnostic.
?string $absent = null;
echo ($absent as ?int) ?? -1, "\n";
?string $present = "17";
echo ($present as ?int) ?? -1, "\n";

// § 3 — from `mixed` every target has a checked path, so a payload with no
// row into that target is `null` rather than a compile error.
mixed $numeric = "6";
echo ($numeric as ?int) ?? -1, "\n";
mixed $truthy = true;
echo ($truthy as ?int) ?? -1, "\n";

// The unsigned rows.
int $negative = 0 - 3;
uint $fallback = 99;
echo ($negative as ?uint) ?? $fallback, "\n";
string $eight = "8";
echo ($eight as ?uint) ?? $fallback, "\n";
--EXPECT--
42
-7
0
3.5
-1
-1
-1
-1
-1
17
6
-1
99
8
