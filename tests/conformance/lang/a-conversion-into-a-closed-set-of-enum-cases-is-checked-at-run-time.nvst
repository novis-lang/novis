--TEST--
A checked `as` into a closed set of enum cases tests membership at run time and throws naming the set — `rule:types/enum-case-type` and `rule:types/single-value-types`
--FILE--
<?nvs
// covers: lang:types/nullable-union-single-value-and-enum-case-types
enum Mode {
    Read = 1,
    Write = 2,
    Exec = 4,
}

class Gate {
    // § 3's subset over an operand only known at run time. The test is the
    // same one a set of allowed `int` values gets, run one representation down: a
    // case *is* its integer (`rule:enums/no-class-machinery`), so the comparison is over the
    // enum's backing type and the throw names the cases rather than them.
    public static function narrow(Mode $m): string {
        try {
            Mode::Read|Mode::Write $allowed = $m as Mode::Read|Mode::Write;
            return "allowed " . (($allowed as int) as string);
        } catch (Throwable $e) {
            return "threw: " . $e->message;
        }
    }

    // § 4's free row: a case written as an expression settles the conversion
    // at compile time — one outside the set is `E0470` and never runs — so
    // this pays no comparison at all, and widening back to the enum is the
    // same value again.
    public static function settled(): string {
        Mode::Read|Mode::Write $picked = Mode::Write as Mode::Read|Mode::Write;
        Mode $widened = $picked;
        return ($widened as int) as string;
    }
}

echo Gate::narrow(Mode::Read), "\n";
echo Gate::narrow(Mode::Write), "\n";
echo Gate::narrow(Mode::Exec), "\n";
echo Gate::settled(), "\n";
--EXPECT--
allowed 1
allowed 2
threw: `4` is not one of `Mode::Read`, `Mode::Write`
2
