--TEST--
one prefix declared by two explicit `autoload` statements does not compile — ADR 0061 § 1
--FILE--
<?mwl
// Two roots for one prefix is the ordered-probe form on the line above; two
// *statements* for one prefix is not, because nothing says which is first
// once the map is the union of every declaration in the bootstrap chain. One
// prefix has one home, and both sites are named so the fix is obvious.
require './bootstrap.mwl';
echo App\Greeter::from(), "\n";
--FILE bootstrap.mwl--
<?mwl
autoload 'App' from './override';
autoload 'App' from './vendor';
--FILE override/Greeter.mwl--
<?mwl
namespace App;

class Greeter
{
    public static function from(): string
    {
        return "the first root";
    }
}
--FILE vendor/Greeter.mwl--
<?mwl
namespace App;

class Greeter
{
    public static function from(): string
    {
        return "the second root";
    }
}
--EXPECT--

--EXPECTF-ERROR--
error[E0315]: `App` is already autoloaded from somewhere else
%A
error: aborting due to 1 error
