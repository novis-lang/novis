--TEST--
An operand whose static type names no conversion row takes `as bytes` from its runtime tag, and `as ?bytes` answers `null` on exactly the rows that throw — `rule:types/conversion` and `rule:types/unions-and-mixed`, `rule:types/conversion`, `rule:expressions/nullable-conversion`
--FILE--
<?nvs
class Render {
    // `rule:types/conversion`'s checked spelling: it "either produces a value of the
    // target type or throws", and § 2's table produces a `bytes` from a
    // `string` and from nothing else.
    public static function checked(mixed $m): tainted string {
        try {
            return Core\Encoding::toHex($m as bytes);
        } catch (Throwable $e) {
            return "threw";
        }
    }

    // `rule:expressions/nullable-conversion`'s twin, which "yields `null` exactly where `expr as T`
    // would throw". One row set under both spellings, so the sweep below
    // asserts that they agree rather than what either one answered.
    public static function nullable(mixed $m): tainted string {
        ?tainted bytes $b = $m as ?bytes;
        if ($b == null) {
            return "threw";
        }
        return Core\Encoding::toHex($b);
    }
}

// `rule:types/conversion`'s row is the operand's *tag*'s here, not its declared type's:
// a `string` and a `bytes` are one allocation under two tags, and every other
// tag has no row at all. `null` is among them — `rule:types/conversion` gives it a
// `string` form and no `bytes` one.
array<mixed> $probes = ["nvs", "λ" as bytes, 42, 1.5, true, null, ["a"]];
int $agreed = 0;
foreach ($probes as mixed $probe) {
    tainted string $left = Render::checked($probe);
    tainted string $right = Render::nullable($probe);
    if ($left == $right) {
        $agreed = $agreed + 1;
    }
    echo $left, "\n";
}
echo "agreed on ", $agreed as string, " of 7\n";

// And the tagged row is the same row, not a second copy of it: the answer a
// `mixed` gives is byte for byte the free `Reinterpret` a declared `string`
// already lowers to.
string $text = "λx";
bytes $free = $text as bytes;
mixed $wide = $text;
echo Core\Encoding::toHex($free), "\n";
echo Render::checked($wide), "\n";
echo Core\Bytes::length($wide as bytes) as string, "\n";
--EXPECT--
6e7673
cebb
threw
threw
threw
threw
threw
agreed on 7 of 7
cebb78
cebb78
3
