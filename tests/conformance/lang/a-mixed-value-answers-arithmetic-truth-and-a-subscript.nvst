--TEST--
One `mixed` value answers an operator, a condition and a subscript, and each answer agrees with the same value's declared-type twin — `rule:types/conversion` and `rule:types/arithmetic`, `rule:expressions/truthy-positions`, `rule:types/erased-member-access`
--FILE--
<?nvs
// covers: lang:types/mixed

// Three families read a `mixed` operand's runtime tag rather than its static
// type: `rule:types/arithmetic`'s arithmetic (`Helper::ValueAdd`), `rule:expressions/truthy-positions`'s truthy
// table, and `rule:types/erased-member-access`'s deferral one storage kind along, a subscript
// through a base that may not be an array at all. Each has its own case
// already; what none of them can assert alone is that the three agree with
// the *typed* spelling of the same question, which is what makes the tag the
// whole answer rather than a second implementation of one.
class Ask {
    public static function arith(mixed $m): string {
        try {
            return ($m + 1) as string;
        } catch (Throwable $e) {
            return "threw";
        }
    }

    public static function truth(mixed $m): string {
        if ($m) {
            return "T";
        }
        return "F";
    }

    // Under a `??` both failures answer `null`: the absent key and the base
    // that is no array at all.
    public static function sub(mixed $m): string {
        return ($m["k"] ?? "-") as string;
    }
}

class Typed {
    public static function arithInt(int $n): string {
        return ($n + 1) as string;
    }

    public static function arithFloat(float $f): string {
        return ($f + 1) as string;
    }

    public static function truthInt(int $n): string {
        if ($n) {
            return "T";
        }
        return "F";
    }

    public static function truthFloat(float $f): string {
        if ($f) {
            return "T";
        }
        return "F";
    }

    public static function truthString(string $s): string {
        if ($s) {
            return "T";
        }
        return "F";
    }

    public static function truthBool(bool $b): string {
        if ($b) {
            return "T";
        }
        return "F";
    }

    public static function truthArray(array<string> $a): string {
        if ($a) {
            return "T";
        }
        return "F";
    }

    public static function subArray(array<string> $a): string {
        return ($a["k"] ?? "-") as string;
    }
}

// The sweep is in source order and each row is numbered, so a family that
// stops answering shifts a row rather than printing plausibly. `"3" + 1`
// throws because `rule:types/arithmetic`'s operands are the numeric types and § 2 has no
// implicit conversion for a `string` to become one — the same refusal `E0716`
// makes where the static type shows it, arriving as a catchable throw here.
array<mixed> $vals = [7, 0, 2.5, 0.0, "3", "0", "abc", "", true, false, null, ["k" => "v"], ["j" => "w"]];
int $i = 0;
foreach ($vals as mixed $v) {
    echo $i as string, " ", Ask::arith($v), " ", Ask::truth($v), " ", Ask::sub($v), "\n";
    $i = $i + 1;
}

array<string> $full = ["k" => "v"];
array<string> $other = ["j" => "w"];
array<string> $empty = [];

// The agreement is counted rather than read off a line, so a family that
// grows a second answer for one row fails here while still looking right in
// the sweep above. Only a value with a declared-type twin has a row: `null`
// and the two operands the arithmetic table refuses outright have none.
int $agreed = 0;
if (Ask::arith(7) == Typed::arithInt(7)) { $agreed = $agreed + 1; }
if (Ask::arith(2.5) == Typed::arithFloat(2.5)) { $agreed = $agreed + 1; }
if (Ask::truth(7) == Typed::truthInt(7)) { $agreed = $agreed + 1; }
if (Ask::truth(0) == Typed::truthInt(0)) { $agreed = $agreed + 1; }
if (Ask::truth(2.5) == Typed::truthFloat(2.5)) { $agreed = $agreed + 1; }
if (Ask::truth(0.0) == Typed::truthFloat(0.0)) { $agreed = $agreed + 1; }
if (Ask::truth("3") == Typed::truthString("3")) { $agreed = $agreed + 1; }
if (Ask::truth("0") == Typed::truthString("0")) { $agreed = $agreed + 1; }
if (Ask::truth("abc") == Typed::truthString("abc")) { $agreed = $agreed + 1; }
if (Ask::truth("") == Typed::truthString("")) { $agreed = $agreed + 1; }
if (Ask::truth(true) == Typed::truthBool(true)) { $agreed = $agreed + 1; }
if (Ask::truth(false) == Typed::truthBool(false)) { $agreed = $agreed + 1; }
if (Ask::truth($full) == Typed::truthArray($full)) { $agreed = $agreed + 1; }
if (Ask::truth($empty) == Typed::truthArray($empty)) { $agreed = $agreed + 1; }
if (Ask::sub($full) == Typed::subArray($full)) { $agreed = $agreed + 1; }
if (Ask::sub($other) == Typed::subArray($other)) { $agreed = $agreed + 1; }
echo "agreed=", $agreed as string, "/16\n";
--EXPECT--
0 8 T -
1 1 F -
2 3.5 T -
3 1 F -
4 threw T -
5 threw F -
6 threw T -
7 threw F -
8 threw T -
9 threw F -
10 threw F -
11 threw T v
12 threw T -
agreed=16/16
