--TEST--
`===`/`!==` over two strings and two bools answer by value, and `false` renders as the empty string
--FILE--
<?mwl
echo "a" === "a", ";", "a" === "b", ";", "a" !== "b", "\n";
echo 1 == 1, ";", 1 === 1, ";", 1 != 2, "\n";
echo true === true, ";", true === false, "\n";
echo "10" === "10", ";", "abc" == "abc", "\n";
--EXPECT--
1;;1
1;1;1
1;
1;1
