--TEST--
The compiler acts on an attribute only when its name resolves to one of its closed `Core`-owned list, so a whole name and the short name a `use` binds are one attribute, a program's declaration with the same short name or the same fields is inert, and recognition leaves the payload in the reflected roster (`rule:core-classes/derive-attribute` and `rule:attributes/inert-metadata`)
--FILE--
<?nvs
// covers: lang:attributes/the-names-the-compiler-acts-on
// `rule:core-classes/derive-attribute`: the match is nominal and happens after resolution, so
// this case asks the same question from both sides in one program. The two
// forms of `Core\Json\Derive` each have to reach the codec, and the two
// program attributes each have to fail to.
use Core\Json\Derive;

attribute Command on method { name: string, note: string }
attribute Codec on class {}

// The `use`d short name.
#[Derive]
class Short {
    public string $who;
    public function constructor(string $who) { $this->who = $who; }
}

// The same attribute, written whole.
#[Core\Json\Derive]
class Long {
    public string $who;
    public function constructor(string $who) { $this->who = $who; }
}

// A program's attribute with the same empty field list `#[Core\Json\Derive]` has.
// It is a different declaration, so no codec is generated and `encode` refuses
// the instance at run time.
#[Codec]
class Plain {
    public string $who;
    public function constructor(string $who) { $this->who = $who; }
}

class Jobs {
    // One command called `import`. A second recognized `#[Command]` claiming
    // that word does not compile, so the program's twin below compiling is what
    // says it never reached the table.
    #[Core\Command(name: "import", about: "Read rows from a file")]
    public static function real(): void {}

    #[Command(name: "import", note: "mine")]
    public static function mine(): void {}
}

// Both forms reach the generated codec.
echo "short: ", Core\Json::encode(new Short("ada")), "\n";
echo "long: ", Core\Json::encode(new Long("bea")), "\n";

// `rule:attributes/inert-metadata`: everything below is counted rather than read off a line
// each, so an attribute that crossed the line in either direction fails here
// instead of printing one plausible line of seven.
uint $agreed = 0;

// The program's `Codec` is inert, so the class has no encoding.
try {
    echo Core\Json::encode(new Plain("cyd")), "\n";
} catch (LogicError $refused) {
    $agreed = $agreed + 1;
}

// The program's twin is ordinary metadata and reads back as itself.
var $mine = Core\Attributes::get<Command>(Jobs::mine);
if ($mine != null) {
    if ($mine->note == "mine") { $agreed = $agreed + 1; }
}

// The program's `Command` is not `Core\Command`, so `real` has none of it.
if (Core\Arr::count(Core\Attributes::all<Command>(Jobs::real)) == 0) { $agreed = $agreed + 1; }
if (Core\Arr::count(Core\Attributes::all<Codec>(Plain::constructor)) == 1) { $agreed = $agreed + 1; }

// Recognition does not take a payload out of the reflected roster: the
// recognized `#[Core\Command]` and the `use`d `#[Derive]` are each one entry
// under their full names, beside the program's own `Command`.
array<string> $rows = [];
array<string> $classes = ["Short", "Jobs"];
foreach ($classes as string $class) {
    var $info = Core\Reflect::forClass($class);
    if ($info != null) {
        foreach ($info->attributes() as Core\Reflect\AttributeInfo $one) {
            $rows[] = $one->name() . "@" . $one->target();
        }
    }
}
if (Core\Arr::count($rows) == 3) { $agreed = $agreed + 1; }
if ($rows[0] == "Core\\Json\\Derive@") { $agreed = $agreed + 1; }
if ($rows[1] == "Core\\Command@real") { $agreed = $agreed + 1; }

echo "agreed: ", $agreed, " of 7\n";
echo Core\Str::join($rows, ", "), "\n";
--EXPECT--
short: {"who":"ada"}
long: {"who":"bea"}
agreed: 7 of 7
Core\Json\Derive@, Core\Command@real, Command@mine
