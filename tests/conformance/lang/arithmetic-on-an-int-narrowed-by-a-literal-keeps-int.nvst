--TEST--
Arithmetic on an `int` that `==` narrowed to a literal is an `int`, in a local and in a method's return
--FILE--
<?nvs
class Counter {
    public static function next(int $n): int {
        if ($n == 100) {
            return $n + 1;
        }
        return $n;
    }
}

int $n = 100;
if ($n == 100) {
    int $m = $n * 2;
    echo $m, "\n";
}
echo Counter::next(100), "\n";
--EXPECT--
200
101
