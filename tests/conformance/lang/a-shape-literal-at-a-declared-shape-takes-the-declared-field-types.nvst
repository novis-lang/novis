--TEST--
An object literal written where a shape is declared takes each field's type from the declaration, so an `int` value in a `float` field is stored as a `float` and a later write of either kind works — `rule:types/shape-type`, `rule:types/conversion`
--FILE--
<?nvs
// covers: lang:types/callable-classes-object-shapes

type Price = {amount: float};
type Item = {price: Price, count: int};
type Amount = {n: int|float};

class Shop
{
    public static function make(): Price
    {
        return {amount: 2};
    }

    public static function read(Price $p): float
    {
        return $p->amount;
    }

    public static function inline({amount: float} $p): float
    {
        return $p->amount;
    }
}

// A whole-number literal in a `float` field is stored as `2.0`.
Price $literal = {amount: 2};
echo $literal->amount, " ", $literal->amount + 0.5, "\n";

// An `int` variable and an `int` sum are converted the same way.
int $two = 2;
Price $variable = {amount: $two};
Price $sum = {amount: 1 + 1};
echo $variable->amount + 0.5, " ", $sum->amount + 0.5, "\n";

// A literal passed as an argument, to a named or an inline shape, and a returned one.
echo Shop::read({amount: 2}) + 0.5, " ", Shop::inline({amount: 2}) + 0.5, "\n";
echo Shop::make()->amount + 0.5, "\n";

// A literal inside an array literal, and a literal nested in another literal.
array<Price> $list = [{amount: 2}, {amount: 3}];
Item $item = {price: {amount: 4}, count: 1};
echo $list[0]->amount + 0.5, " ", $list[1]->amount + 0.5, " ", $item->price->amount + 0.5, "\n";

// A nullable shape position works the same way.
?Price $maybe = {amount: 5};
echo $maybe?->amount + 0.5, "\n";

// The field is a `float`, so a later `float` write keeps the fraction.
$literal->amount = 2.5;
echo $literal->amount, "\n";

// An `int|float` field can be written with either kind afterwards.
Amount $either = {n: 2};
echo $either->n, "\n";
$either->n = 2.5;
echo $either->n, "\n";

// An existing `{n: int}` value is an `int|float` value, and reads back as `2`.
var $whole = {n: 2};
Amount $view = $whole;
echo $view->n, "\n";
--EXPECT--
2 2.5
2.5 2.5
2.5 2.5
2.5
2.5 3.5 4.5
5.5
2.5
2
2.5
2
