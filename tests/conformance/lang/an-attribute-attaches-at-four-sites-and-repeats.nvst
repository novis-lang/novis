--TEST--
an attribute attaches at a class, a method, a property and a parameter, the named and bare spellings reach retrieval alike, and a declaration keeps every attachment written on it (`rule:attributes/attach-sites-and-forms` and `rule:attributes/repeatable`)
--FILE--
<?nvs
// covers: lang:attributes/an-attribute-is-a-shape-literal-attached-to-a-declaration
// `rule:attributes/attach-sites-and-forms` names four attach sites. This case asks one
// question at each of them and counts the agreements rather than reading any
// one off a line of its own: a site that stopped attaching, or one attaching
// under something retrieval cannot see, fails here while the other three go
// on printing plausibly.
type Site = {site: string};

#[Site(site: "class")]
class Target {
    #[Site(site: "property")]
    public int $rows = 0;

    #[Site(site: "method")]
    public function run(#[Site(site: "parameter")] int $id): int {
        return $id;
    }
}

uint $agreed = 0;

?Site $onClass = Core\Attributes::get<Site>(Target::constructor(...));
if ($onClass != null) { if ($onClass->site == "class") { $agreed = $agreed + 1; } }

?Site $onMethod = Core\Attributes::get<Site>(Target::run(...));
if ($onMethod != null) { if ($onMethod->site == "method") { $agreed = $agreed + 1; } }

?Site $onProperty = Core\Attributes::get<Site>(Target::constructor(...), "rows");
if ($onProperty != null) { if ($onProperty->site == "property") { $agreed = $agreed + 1; } }

?Site $onParameter = Core\Attributes::get<Site>(Target::run(...), "id");
if ($onParameter != null) { if ($onParameter->site == "parameter") { $agreed = $agreed + 1; } }

echo "sites=", $agreed as string, "/4\n";

// `rule:attributes/repeatable`: nothing about attaching one attribute is aware of how many
// others share its site, so four attachments stay four — including the two
// identical ones, which no deduplication collapses — and `all` answers them in
// attach order. The comma-separated bracket is the same attachment as a second
// line, which is why the bare literal in it is counted here too.
#[Site(site: "first")]
#[Site(site: "first")]
#[Site(site: "third"), {site: "fourth"}]
class Repeated {}

array<Site> $all = Core\Attributes::all<Site>(Repeated::constructor(...));
echo "attachments=", Core\Arr::count($all) as string, "\n";
foreach ($all as Site $one) { echo "  ", $one->site, "\n"; }

// The two spellings differ only in whether a shape checks the literal
// (`rule:attributes/attach-sites-and-forms`), so a retrieval written for the same shape sees
// the same payload from either. Asserted as agreement rather than as two
// lines: a bare literal that stopped reaching retrieval fails here.
#[Site(site: "same")]
class Named {}

#[{site: "same"}]
class Bare {}

?Site $fromNamed = Core\Attributes::get<Site>(Named::constructor(...));
?Site $fromBare = Core\Attributes::get<Site>(Bare::constructor(...));
string $agree = "no";
if ($fromNamed != null) {
    if ($fromBare != null) {
        if ($fromNamed->site == $fromBare->site) { $agree = "yes"; }
    }
}
echo "spellings agree=", $agree, "\n";

# Only `#[` opens an attribute, so this line is a comment and `Plain` carries
# nothing at all — `{}` is satisfied by every attached literal, which makes a
# `null` here the assertion that none was attached.
class Plain {}

?{} $nothing = Core\Attributes::get<{}>(Plain::constructor(...));
echo "plain=", $nothing == null ? "none" : "some", "\n";
--EXPECT--
sites=4/4
attachments=4
  first
  first
  third
  fourth
spellings agree=yes
plain=none
