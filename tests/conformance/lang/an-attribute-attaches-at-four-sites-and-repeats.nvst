--TEST--
an attribute attaches at a class, a method, a property and a parameter, and a `repeatable` declaration keeps every use written on one declaration (`rule:attributes/attach-sites-and-forms` and `rule:attributes/repeatable`)
--FILE--
<?nvs
// covers: lang:attributes/an-attribute-is-an-anonymous-object-attached-to-a-declaration
// `rule:attributes/attach-sites-and-forms` names four attach sites. This case asks one
// question at each of them and counts the agreements rather than reading any
// one off a line of its own: a site that stopped attaching, or one attaching
// under something retrieval cannot see, fails here while the other three go
// on printing plausibly.
repeatable attribute Site on class, method, property, parameter { site: string }

#[Site(site: "class")]
class Target {
    #[Site(site: "property")]
    public int $rows = 0;

    #[Site(site: "method")]
    public function run(#[Site(site: "parameter")] int $id): int {
        return $id;
    }
}

uint $agreed = 0;

var $onClass = Core\Attributes::get<Site>(Target::constructor);
if ($onClass != null) { if ($onClass->site == "class") { $agreed = $agreed + 1; } }

var $onMethod = Core\Attributes::get<Site>(Target::run);
if ($onMethod != null) { if ($onMethod->site == "method") { $agreed = $agreed + 1; } }

var $onProperty = Core\Attributes::get<Site>(Target::constructor, "rows");
if ($onProperty != null) { if ($onProperty->site == "property") { $agreed = $agreed + 1; } }

var $onParameter = Core\Attributes::get<Site>(Target::run, "id");
if ($onParameter != null) { if ($onParameter->site == "parameter") { $agreed = $agreed + 1; } }

echo "sites=", $agreed as string, "/4\n";

// `rule:attributes/repeatable`: nothing about attaching one attribute is aware of how many
// others share its site, so four attachments stay four — including the two
// identical ones, which no deduplication collapses — and `all` answers them in
// attach order. The comma-separated bracket is the same attachment as a second
// line, which is why both uses in it are counted here.
#[Site(site: "first")]
#[Site(site: "first")]
#[Site(site: "third"), Site(site: "fourth")]
class Repeated {}

var $all = Core\Attributes::all<Site>(Repeated::constructor);
echo "attachments=", Core\Arr::count($all) as string, "\n";
foreach ($all as var $one) { echo "  ", $one->site, "\n"; }

# Only `#[` opens an attribute, so this line is a comment and `Plain` carries
# nothing at all, which makes a `null` here the assertion that none was attached.
class Plain {}

var $nothing = Core\Attributes::get<Site>(Plain::constructor);
echo "plain=", $nothing == null ? "none" : "some", "\n";
--EXPECT--
sites=4/4
attachments=4
  first
  first
  third
  fourth
plain=none
