--TEST--
`Core\Order` moved to `Core\Arr::Order`, so a `use` line, a type and an expression that write it each say where it went (`rule:core-api/a-moved-name-says-where-it-went`)
--FILE--
<?nvs
use Core\Order;

class Pick {
    public static function rank(Order $order): int { return 1; }
}

Core\Order $order = Core\Order::Desc;
echo Pick::rank($order) . "\n";
--EXPECT--

