--TEST--
A decimal-integer string key is the integer key, so `"10"` and `10` are one entry — ADR 0007 § 5
--FILE--
<?mwl
array<int> $a = ["10" => 1, 10 => 2, "x" => 3];
foreach ($a as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
echo Core\Arr::count($a), "|", Core\Arr::hasKey($a, 10) as string, "|", Core\Arr::hasKey($a, "10") as string, "|\n";

array<int> $b = ["01" => 1, "1" => 2, " 1" => 3];
foreach ($b as string $k => int $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
echo Core\Arr::count($b), "\n";
--EXPECT--
10=2;x=3;
2|1|1|
01=1;1=2; 1=3;
3
