--TEST--
A positional element in a literal takes one past the highest integer key before it, so no value is lost
--FILE--
<?nvs
array<string> $a = [1 => "a", "b", "c"];
foreach ($a as string $k => string $v) {
    echo $k, "=", $v, ";";
}
echo "\n";

array<string> $b = [5 => "a", 2 => "b", "c", "k" => "d", "e"];
foreach ($b as string $k => string $v) {
    echo $k, "=", $v, ";";
}
echo "\n";

array<string> $c = ["x", -3 => "y", "z"];
foreach ($c as string $k => string $v) {
    echo $k, "=", $v, ";";
}
echo "\n";
--EXPECT--
1=a;2=b;3=c;
5=a;2=b;6=c;k=d;7=e;
0=x;-3=y;1=z;
