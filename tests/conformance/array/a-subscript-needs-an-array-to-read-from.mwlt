--TEST--
a subscript whose base declares no element type is refused where it is written, for a `mixed`, a scalar, a `string` and an unnarrowed `?array<T>` alike — ADR 0007 § 5, ADR 0009 § 2
--FILE--
<?mwl
// ADR 0007 § 5 checks an element read and write against the array's *declared*
// element type, so a base that declares none has nothing to name and nothing
// to check the read against. PHP answers `null` with a warning for most of
// these — ADR 0007 § 7 row 8's family — and MWL refuses at check time instead.
// A `string` is not an exception: ADR 0009 § 2 indexes one by extended
// grapheme cluster through `Core\Str`, deliberately not through a subscript.
// The last one is the sharpest: a `!= null` test narrows a `?Class` receiver
// but not an array binding (`mwl_types::locals`' narrowing docs own why), so
// `$rows["0"]` inside the guard is refused rather than lowered.
mixed $m = "x";
$m["0"] = "1";
echo $m["0"], "\n";
int $i = 1;
echo $i["0"], "\n";
string $s = "abc";
echo $s["0"], "\n";
?array<string> $rows = null;
if ($rows != null) {
    echo $rows["0"], "\n";
}
echo "unreachable\n";
--EXPECT--

--EXPECTF-ERROR--
error[E0482]: `mixed` cannot be subscripted
   --> case.mwl:12:1
%A
error[E0482]: `mixed` cannot be subscripted
   --> case.mwl:13:6
%A
error[E0482]: `int` cannot be subscripted
   --> case.mwl:15:6
%A
error[E0482]: `string` cannot be subscripted
   --> case.mwl:17:6
%A
error[E0482]: `null|array<string>` cannot be subscripted
   --> case.mwl:20:10
%A
error: aborting due to 5 errors
