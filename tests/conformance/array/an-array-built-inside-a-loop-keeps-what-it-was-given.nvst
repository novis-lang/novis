--TEST--
An array accumulated across loop iterations — appended to, keyed by a computed string, and read back after the loop ends
--FILE--
<?nvs
class Build {
    public static function squares(int $upTo): array<int> {
        array<int> $out = [];
        int $i = 1;
        while ($i <= $upTo) {
            $out[] = $i * $i;
            $i = $i + 1;
        }
        return $out;
    }

    public static function index(array<string> $words): array<int> {
        array<int> $lengths = [];
        foreach ($words as string $k => string $word) {
            $lengths[$word] = Core\Str::length($word) as int;
        }
        return $lengths;
    }
}

var $sq = Build::squares(5);
echo Core\Arr::count($sq), ";", $sq[0], ";", $sq[4], "\n";

var $ix = Build::index(["ann", "bo", "cider"]);
foreach ($ix as string $k => int $n) {
    echo $k, "=", $n, ";";
}
echo "\n";
var $has = Core\Arr::hasKey($ix, "bo") ? "y" : "n";
echo $has, "\n";
--EXPECT--
5;1;25
ann=3;bo=2;cider=5;
y
