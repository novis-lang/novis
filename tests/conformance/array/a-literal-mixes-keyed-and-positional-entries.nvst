--TEST--
A literal's positional entries take the next integer index, counting past its keyed ones
--FILE--
<?mwl
class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

echo Render::of([1, "k" => 2, 3]), "\n";
echo Render::of(["first" => 1, "second" => 2]), "\n";
echo Render::of([1, 2, 3]), "\n";
echo Render::of([]), "\n";
echo Render::of(["k" => 1, 2, "j" => 3, 4]), "\n";
--EXPECT--
0=1;k=2;1=3;
first=1;second=2;
0=1;1=2;2=3;

k=1;0=2;j=3;1=4;
