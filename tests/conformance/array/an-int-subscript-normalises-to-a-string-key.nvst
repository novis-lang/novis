--TEST--
`$a[8]` and `$a["8"]` name one key, and `"08"` stays a different one — ADR 0007 § 5
--FILE--
<?nvs
class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $a = [];
$a[8] = 80;
echo $a["8"], "\n";
echo Render::of($a), "\n";

$a["8"] = 88;
echo Render::of($a), "\n";

$a["08"] = 8;
echo Render::of($a), "\n";
echo Core\Arr::count($a), "\n";
echo Core\Arr::hasKey($a, "8") as string, "|", Core\Arr::hasKey($a, "08") as string, "|\n";
--EXPECT--
80
8=80;
8=88;
8=88;08=8;
2
1|1|
