--TEST--
an array-element write through a narrowed `?T` receiver writes the property's own slot, in every subscript spelling — `rule:types/declaration`, `rule:types/arrays`
--FILE--
<?nvs
// A `?T` local is one tagged slot wide however narrow a condition later
// proves it (`rule:types/declaration`), so a receiver reached through one has to be
// untagged before anything stores into it. The plain `$m->rows = [...]` half
// already did that; the *element* write goes back through the property in a
// second place — the copy-on-write write-back `rule:types/arrays` owes every level —
// and that place has its own receiver to untag. This pins all four subscript
// spellings, because they share the one write-back.
class Box {
    public array<string> $rows = [];
    public array<array<string>> $grid = [];
    public string $tag = "t";
}

?Box $m = new Box();
if ($m != null) {
    $m->rows["0"] = "w";
    $m->rows[] = "app";
    $m->grid["a"]["b"] = "deep";
    $m->tag .= "!";
    echo $m->rows["0"], " ", $m->rows["1"], " ", $m->grid["a"]["b"], " ", $m->tag, "\n";
}

// The narrowing is a fact about the binding, not a copy of the object (ADR
// 0023), so a second narrowing of the same local reads back everything the
// first one wrote.
if ($m != null) {
    echo Core\Json::encode($m->rows), "\n";
    echo Core\Json::encode($m->grid), "\n";
}
--EXPECT--
w app deep t!
["w","app"]
{"a":{"b":"deep"}}
