--TEST--
Copying a row out of an array of arrays copies it; writing through the copy leaves the grid alone
--FILE--
<?nvs
array<array<int>> $grid = [[1, 2], [3, 4]];
echo $grid[0][0], "|", $grid[0][1], "|", $grid[1][0], "|", $grid[1][1], "|\n";

array<int> $row = $grid[1];
$row[0] = 99;
echo $grid[1][0], "|", $row[0], "|\n";

$row[] = 5;
echo Core\Arr::count($row), "|", Core\Arr::count($grid[1]), "|\n";

echo Core\Arr::count($grid), "|", Core\Arr::count($grid[0]), "|\n";
--EXPECT--
1|2|3|4|
3|99|
3|2|
2|2|
