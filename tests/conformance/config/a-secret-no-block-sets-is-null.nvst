--TEST--
`Core\Config::secret` returns `null` for a name no `[secrets]` block sets, and does not read a `[settings]` value of the same name — `rule:config/settings-and-secrets-are-a-programs-own-values`
--FILE nvs.toml--
[settings]
api_key = "a-setting"

[secrets]
mail_password = "mail-pass"
--FILE--
<?nvs
// No `[secrets]` block sets `missing`, so the result is `null`.
echo Core\Config::secret('missing') == null ? "null" : "set", "\n";
// `[secrets]` sets `mail_password`, so the value is the one written there.
echo Core\Config::secret('mail_password') == 'mail-pass' ? "mail" : "other", "\n";
// `api_key` is a setting and not a secret, so the result is `null`.
echo Core\Config::secret('api_key') == null ? "null" : "set", "\n";
--EXPECT--
null
mail
null
