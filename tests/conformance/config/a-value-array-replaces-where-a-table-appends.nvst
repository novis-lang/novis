--TEST--
a value array set in a later file replaces the earlier one wholesale while `[[table]]` entries accumulate across the tree — `rule:config/later-wins-and-every-override-is-recorded`, `rule:config/a-value-array-replaces-and-a-table-appends` and `rule:config/check-and-dump-audit-the-tree-offline`
--RUN--
config dump --origin
--FILE--
<?nvs
// Not run: `--RUN--` names `rule:config/check-and-dump-audit-the-tree-offline`'s audit. This is the program the tree
// would govern, written beside `nvs.toml` so the case describes a deployment.
echo Core\Config::get('capabilities.fs.read'), "\n";
--FILE nvs.toml--
# The root file grants one readable root and loads one extension.
[capabilities.fs]
read = ["./data"]

[[extension]]
path = "./ext/metrics.nvsx"
sha256 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

[[include]]
path = "conf.d/local.toml"
--FILE conf.d/local.toml--
# § 4: `read` is one value, so this states the whole grant and `./data` is
# gone — the last file that mentions a grant states all of it, and no reader
# has to assemble the effective root list from two files. The `[[extension]]`
# entry appends instead, because two of them in one file are two extensions.
[capabilities.fs]
read = ["./var/cache"]

[[extension]]
path = "./ext/tracing.nvsx"
sha256 = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
--EXPECTF--
capabilities.fs.read = ["%sconf.d%svar%scache"] %sconf.d%elocal.toml (overrides %snvs.toml)
extension.0.path     = "./ext/metrics.nvsx" %snvs.toml
extension.0.sha256   = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" %snvs.toml
extension.1.path     = "./ext/tracing.nvsx" %sconf.d%elocal.toml
extension.1.sha256   = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" %sconf.d%elocal.toml
include.0.path       = "conf.d/local.toml"     %snvs.toml
