--TEST--
`[limits] memory_high_water` is unset when no file writes it, and a program cannot turn it on, change it or restore it into being — `rule:observability/memory-high-water-writes-a-warn`
--FILE--
<?nvs
// covers: directive:limits.memory_high_water
// Unwritten is off, so the key reads back `null`.
echo Core\Config::get('limits.memory_high_water') ?? 'null', "\n";
// A system directive: every program write is refused, in range or not.
echo Core\Config::set('limits.memory_high_water', '0.5') ? 'set' : 'refused', "\n";
echo Core\Config::set('limits.memory_high_water', '0') ? 'set' : 'refused', "\n";
echo Core\Config::set('limits.memory_high_water', '2') ? 'set' : 'refused', "\n";
Core\Config::restore('limits.memory_high_water');
echo Core\Config::get('limits.memory_high_water') ?? 'null', "\n";
--EXPECT--
null
refused
refused
refused
null
