--TEST--
One generator's body consumes another with `foreach` and re-yields — a two-stage pipeline stays lazy at both stages
--FILE--
<?nvs
class Pipe {
    public static function source(int $upTo): Iterator<int> {
        int $i = 1;
        while ($i <= $upTo) {
            echo "s", $i, ";";
            yield $i;
            $i = $i + 1;
        }
    }

    public static function doubled(int $upTo): Iterator<int> {
        foreach (Pipe::source($upTo) as int $n) {
            yield $n * 2;
        }
    }

    public static function first(int $upTo): int {
        foreach (Pipe::doubled($upTo) as int $n) {
            return $n;
        }
        return -1;
    }
}

var $out = "";
foreach (Pipe::doubled(3) as int $n) {
    $out = $out . "|" . $n;
}
echo "\n", $out, "\n";
echo Pipe::first(9), "\n";
--EXPECT--
s1;s2;s3;
|2|4|6
s1;2
