--TEST--
A `break` out of a `foreach` over a generator stops it where it stood — the statements after the last `yield` never run
--FILE--
<?nvs
class G {
    public static function noisy(int $n): Iterator<int> {
        int $i = 0;
        while ($i < $n) {
            echo "-", $i;
            yield $i;
            echo "+", $i;
            $i = $i + 1;
        }
        echo "!";
    }
}

foreach (G::noisy(5) as int $v) {
    if ($v == 2) {
        break;
    }
    echo "[", $v, "]";
}
echo "\n";
foreach (G::noisy(2) as int $v) {
    echo "[", $v, "]";
}
echo "\n";
--EXPECT--
-0[0]+0-1[1]+1-2
-0[0]+0-1[1]+1!
