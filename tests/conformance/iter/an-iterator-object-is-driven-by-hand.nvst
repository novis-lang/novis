--TEST--
`Iterator<T>`'s two members are the whole protocol, so a `while` over `advance()`/`current()` drains it exactly as `foreach` would — `rule:iteration/two-interfaces`
--FILE--
<?nvs
// covers: lang:iteration/the-two-interfaces
class Walker implements Iterator<int> {
    public int $i;
    public array<int> $items;

    public function constructor(array<int> $items) {
        $this->items = $items;
        $this->i = -1;
    }

    public function advance(): bool {
        $this->i = $this->i + 1;
        return $this->i < Core\Arr::count($this->items) as int;
    }

    public function current(): int {
        return $this->items[$this->i];
    }
}

array<int> $xs = [4, 5, 6];
var $w = new Walker($xs);
int $sum = 0;
while ($w->advance()) {
    $sum = $sum + $w->current();
}
echo $sum, "\n";
--EXPECT--
15
