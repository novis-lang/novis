--TEST--
A generator's parameters are bound when it is called — and the state object it returns is an `Iterator`, drained once and never rewound
--FILE--
<?mwl
class Ladder {
    public static function steps(int $from, int $to): Iterator<int> {
        int $i = $from;
        while ($i <= $to) {
            yield $i;
            $i = $i + 1;
        }
    }

    public static function total(int $from, int $to): int {
        var $sum = 0;
        foreach (Ladder::steps($from, $to) as int $n) {
            $sum = $sum + $n;
        }
        return $sum;
    }
}

echo Ladder::total(2, 5), "\n";
echo Ladder::total(1, 1), "\n";
echo Ladder::total(4, 1), "\n";

var $a = Ladder::steps(1, 3);
var $b = Ladder::steps(10, 12);
var $out = "";
foreach ($a as int $n) {
    foreach ($b as int $m) {
        $out = $out . $n . "-" . $m . ";";
    }
}
echo $out, "\n";
--EXPECT--
14
1
0
1-10;1-11;1-12;
