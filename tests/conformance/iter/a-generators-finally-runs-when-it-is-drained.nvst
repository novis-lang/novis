--TEST--
A `finally` wrapped around a generator's whole body runs once, after the last `yield` resumes and the body falls off the end
--FILE--
<?mwl
class G {
    public static function guarded(int $n): Iterator<int> {
        try {
            int $i = 0;
            while ($i < $n) {
                yield $i;
                $i = $i + 1;
            }
        } finally {
            echo "[done]";
        }
    }
}

foreach (G::guarded(3) as int $v) {
    echo $v;
}
echo "\n";
foreach (G::guarded(0) as int $v) {
    echo $v;
}
echo "\n";
--EXPECT--
012[done]
[done]
