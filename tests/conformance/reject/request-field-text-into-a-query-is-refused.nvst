--TEST--
a request field read with `query`, `post`, `queryArray` or `postArray` is `tainted` text, so it reaches SQL only as a bound parameter, whether it is joined with `.`, interpolated, appended with `.=` or bound to a plain `string` — `rule:security/tainted-sources`, `rule:security/taint-propagation`
--FILE--
<?nvs
var $db = Core\Db::connect("main");
var $name = Core\Request::post("name");

$db->query("select * from users where id = " . Core\Request::query("id"), []);
$db->query("select * from users where name = '{$name}'", []);
string $sql = "select * from users where id = ";
$sql .= Core\Request::query("id");
string $id = Core\Request::query("id") as string;
array<string> $tags = Core\Request::queryArray("tag");
string $first = Core\Request::postArray("item")[0] ?? "";

// The bound parameter and the number conversion are the two accepted readings.
$db->query("select * from users where id = ?", [Core\Request::query("id")]);
int $page = Core\Request::query("page") as ?int ?? 1;
--FILE nvs.toml--
[capabilities.db]
connect = ["main"]

[db.main]
driver = "sqlite"
path = ":memory:"
--EXPECT--

