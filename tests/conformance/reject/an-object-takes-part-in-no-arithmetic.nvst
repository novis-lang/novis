--TEST--
`-7d` does not mean a backwards duration; Novis has no operator overloading — `rule:types/duration`
--FILE--
<?nvs
var $back = -7d;
echo "unreachable\n";
--EXPECT--

--EXPECTF-ERROR--
error[E0401]: `-` has no meaning for `Core\Time\Duration`
  --> case.nvs:2:13
