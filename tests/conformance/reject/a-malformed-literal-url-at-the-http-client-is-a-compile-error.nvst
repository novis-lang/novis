--TEST--
a malformed literal URL at an outbound `Core\Http\Client` member or `Core\Http::allowUrl` is refused while checking, and the same text behind a variable is not (`rule:security/outbound-url-is-a-sink` and `rule:expressions/intrinsic-constant-arguments`)
--FILE--
<?nvs
// The URL grammar is `Core\Uri::parse`'s, so the refusal is its sentence. Each
// member is asked at the parameter its URL fills: `request` and `stream` at
// argument 1, behind the method. The variable-borne twin adds no diagnostic, and the count
// in the final line is what asserts it.
var $badUrl = "https://exa mple.test/x";
var $a = Core\Http\Client::get("https://exa mple.test/x");
var $b = Core\Http\Client::post("https://exa mple.test/x");
var $c = Core\Http\Client::put("https://exa mple.test/x");
var $d = Core\Http\Client::patch("https://exa mple.test/x");
var $e = Core\Http\Client::delete("https://exa mple.test/x");
var $f = Core\Http\Client::head("https://exa mple.test/x");
var $g = Core\Http\Client::request(Core\Http\Method::Get, "https://exa mple.test/x");
var $h = Core\Http\Client::get("http://example.test:99999/x");
var $i = Core\Http\Client::stream(Core\Http\Method::Get, "https://exa mple.test/x");
var $j = Core\Http\Client::openSocket("wss://exa mple.test/x");
var $k = Core\Http::allowUrl("https://example.test:99999/x");
var $runtime = Core\Http\Client::get($badUrl);

echo "unreachable\n";
--EXPECT--

