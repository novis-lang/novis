--TEST--
a `secret` or `lateinit` property on a `#[Json\Derive]` class is refused at the declaration that put it on the wire contract — ADR 0071 §§ 2 and 6
--FILE--
<?mwl
class Session {
    public string $id;
    public function constructor(string $id) {
        $this->id = $id;
    }
}

#[Core\Json\Derive]
class Account {
    public secret string $apiKey;
    lateinit public Session $session;

    public function constructor(secret string $apiKey) {
        $this->apiKey = $apiKey;
    }
}
echo "unreachable\n";
--EXPECT--

--EXPECTF-ERROR--
error[E0462]: `$apiKey` is `secret`, so it cannot be a `#[Json\Derive]` field
   --> case.mwl:11:26
%A
error[E0463]: `$session` is `lateinit`, so it cannot be a `#[Json\Derive]` field
   --> case.mwl:12:29
%A
error: aborting due to 2 errors
