--TEST--
two attached literals on one implementor's member satisfying the shape are `E0728` naming that class, since each row's `attribute` holds at most one, `rule:programs/implementing-with`
--FILE--
<?nvs
interface Page {
    public function render(): string;
}

class Index implements Page {
    #[{path: "/"}]
    #[{path: "/home"}]
    public function render(): string { return "index"; }
}

var $rows = Core\Program::implementingWith<Page, {path: string}>("render");
echo "after\n";
// covers: Core\Program::implementingWith
--EXPECT--

