--TEST--
two payloads of the named declaration on one implementor's member are `E0728` naming that class, since each row's `attribute` holds at most one, `rule:programs/implementing-with`
--FILE--
<?nvs
repeatable attribute Route on method { path: string }

interface Page {
    public function render(): string;
}

class Index implements Page {
    #[Route(path: "/")]
    #[Route(path: "/home")]
    public function render(): string { return "index"; }
}

var $rows = Core\Program::implementingWith<Page, Route>("render");
echo "after\n";
// covers: Core\Program::implementingWith
--EXPECT--

--EXPECTF-ERROR--
error[E0728]: `Index::render` has 2 `Route` attributes
   --> case.nvs:14:13
