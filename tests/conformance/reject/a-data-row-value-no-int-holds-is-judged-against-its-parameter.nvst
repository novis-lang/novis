--TEST--
A `#[TestWith]` value only a `uint` holds is `E0738` at an `int` parameter and no error at a `uint` one, and a value past every `uint` is refused at both — `rule:testing/data-rows`
--FILE--
<?nvs
// covers: lang:testing/core-test-testwith-data-rows
// A `uint` parameter takes a row value no `int` holds; the same value at an
// `int` parameter is judged by the row's own rule, against that parameter.
use Core\Test;
use Core\Test\TestWith;

final class EdgeTest {
    #[TestWith(stock: 18446744073709551615, floor: 18446744073709551615)]
    #[Test]
    public function theLargestUint(uint $stock, int $floor): void {
        Test::assertTrue($stock > 0);
    }

    #[TestWith(stock: 18446744073709551616)]
    #[Test]
    public function oneMoreThanAnyUint(uint $stock): void {
        Test::assertTrue($stock > 0);
    }
}
--EXPECTF-ERROR--
