--TEST--
an added member may not take the name of a member its type or one of its parent types already has: a block on a `Core` class adding `year`, and a block on another package's subclass adding a method its parent class declares, are each `E1011` — `rule:classes/an-extend-block-adds-members-to-a-type`
--FILE--
<?nvs
namespace App;

use Core\Time\Date;
use Acme\Shop\GiftOrder;

autoload 'Acme\Shop' from './vendor/acme/shop/src';

extend Date as Years {
    public function year(): int {
        return 2000;
    }
}

extend GiftOrder as GiftTools {
    public function label(): string {
        return "present";
    }
}

echo "unreachable\n";
--FILE vendor/acme/shop/src/Order.nvs--
<?nvs
namespace Acme\Shop;

class Order
{
    public function constructor(public int $total) {}

    public function label(): string
    {
        return "order";
    }
}
--FILE vendor/acme/shop/src/GiftOrder.nvs--
<?nvs
namespace Acme\Shop;

final class GiftOrder extends Order
{
}
--FILE vendor/acme/shop/package.toml--
[package]
name = 'Acme\Shop'
--EXPECT--

