--TEST--
An object literal written where a shape is expected may write only the keys that shape names, at a parameter, a `return`, a typed variable, a nested field and a union of shapes — `rule:types/shape-type`
--FILE--
<?nvs
// covers: lang:expressions/anonymous-objects
final class Sheet
{
    type Options = ?{ freeze?: bool, zoom?: uint, csv?: { separator?: string } };

    public static function open(Options $options = null): void
    {
    }

    public static function defaults(): { freeze?: bool }
    {
        return { frezee: true };
    }

    public static function style({ bold: bool }|{ italic: bool } $style): void
    {
    }
}

Sheet::open({ frezee: true });
Sheet::open({ csv: { seperator: ';' } });
Sheet::Options $o = { zom: 3 };
Sheet::style({ bold: true, colour: 'red' });

// A value that is not a literal keeps width subtyping, so this compiles.
var $wider = { freeze: true, owner: 'x' };
Sheet::open($wider);
--EXPECT--

--EXPECTF-ERROR--
