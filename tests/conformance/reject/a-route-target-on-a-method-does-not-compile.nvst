--FILE--
<?nvs
class Menu {
    #[Core\Router\Target]
    public static function entry(callable $route): string {
        return "entry";
    }

    #[Core\Router\Params]
    public static function values(array $values): string {
        return "values";
    }
}

echo "unreachable\n";
