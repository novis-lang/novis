--TEST--
a row's `string` and `bytes` readers answer the `tainted` form, and so does text pulled out of its `get`, so a stored value reaches a query only after it is checked — `rule:core-classes/db-column-types`, `rule:security/taint-propagation`
--FILE--
<?nvs
use Core\Db\Row;

var $db = Core\Db::connect("main");
$db->execute("create table notes (label text not null, body blob not null)", []);
foreach ($db->query("select label, body from notes", []) as Row $row) {
    string $label = $row->string("label") ?? "";
    bytes $body = $row->bytes("body") ?? "" as bytes;
    $db->query("select * from notes where label = '" . ($row->get("label") as string) . "'", []);
}
--FILE nvs.toml--
[capabilities.db]
connect = ["main"]

[db.main]
driver = "sqlite"
path = ":memory:"
--EXPECT--

--EXPECTF-ERROR--
error[E0401]: expected `string`, found `string|tainted string`
  --> case.nvs:7:21
%A
error[E0401]: expected `bytes`, found `bytes|tainted bytes`
  --> case.nvs:8:19
%A
error[E0401]: expected `string`, found `tainted string`
  --> case.nvs:9:16
%A
