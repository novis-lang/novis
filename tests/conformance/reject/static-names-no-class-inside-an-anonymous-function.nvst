--TEST--
`static::` inside an anonymous function's body is refused in every form — a constant, a call, `::class` — because the anonymous function's frame carries no called class, `rule:statements/static-is-a-member-modifier`
--FILE--
<?nvs
class Base {
    public const string PATH = "/";

    public static function tag(): string {
        return "tag";
    }

    public function constant(): tainted string {
        callable $f = fn (): string => static::PATH;
        return $f() as string;
    }

    public function call(): tainted string {
        callable $f = fn (): string => static::tag();
        return $f() as string;
    }

    public static function name(): tainted string {
        callable $f = fn (): string => static::class;
        return $f() as string;
    }
}
echo "after\n";
// covers: lang:classes/methods-self-static-and-parent
--EXPECT--

--EXPECTF-ERROR--
error[E0834]: `static::` names no class inside an anonymous function
   --> case.nvs:10:40
%A
