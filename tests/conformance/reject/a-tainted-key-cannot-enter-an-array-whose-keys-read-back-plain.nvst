--TEST--
a `tainted` key written into an array whose keys read back as plain `string` does not compile, by a subscript, a `??=` or a literal, while an array whose element type keeps the mark takes one and `unset` takes any key — `rule:security/taint-propagation`
--FILE--
<?nvs
tainted string $t = "x";

// Each write below adds a key from outside to an array whose keys read back plain.
array<int> $counts = [];
$counts[$t] = 1;
array<array<int>> $groups = [];
$groups[$t]["n"] = 1;
$counts[$t] ??= 2;
array<int> $literal = [$t => 1];
var $inferred = [$t => 1];

// A `foreach` over these reads its keys as `tainted string`, so each compiles.
array<tainted string> $form = [];
$form[$t] = $t;
array<mixed> $decoded = [];
$decoded[$t] = 1;

// `unset` removes a key and adds none.
unset($counts[$t]);

// A key the program checked is plain again.
$counts[Core\Taint::assertTrusted($t, "one of the names this form lists")] = 3;
echo "unreachable\n";
--EXPECT--

--EXPECTF-ERROR--
