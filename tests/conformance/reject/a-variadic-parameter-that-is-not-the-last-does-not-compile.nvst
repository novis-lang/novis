--TEST--
A `...` on any parameter but the last is `E0107` at that parameter, in a method and an anonymous function alike
--FILE--
<?nvs
class Sum {
    public static function all(int $first, int ...$rest): int {
        int $total = $first;
        foreach ($rest as int $n) {
            $total += $n;
        }
        return $total;
    }

    public static function rest(int ...$xs, int $last): int {
        return $last;
    }

    public static function two(int ...$a, int ...$b): int {
        return 0;
    }
}

callable(int, int): int $f = fn(int ...$xs, int $y): int => $y;

echo Sum::all(1, 2, 3), "\n";
--EXPECT--

--EXPECTF-ERROR--
error[E0107]: only the last parameter can be variadic
%A
11 |     public static function rest(int ...$xs, int $last): int {
   |                                        ^^^ this parameter has `...` and is not the last one
%A
error[E0107]: only the last parameter can be variadic
%A
15 |     public static function two(int ...$a, int ...$b): int {
   |                                       ^^ this parameter has `...` and is not the last one
%A
error[E0107]: only the last parameter can be variadic
%A
20 | callable(int, int): int $f = fn(int ...$xs, int $y): int => $y;
%A
error: aborting due to 3 errors
