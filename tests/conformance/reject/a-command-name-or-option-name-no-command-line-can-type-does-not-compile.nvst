--TEST--
A command `name:` or an option `long:` that is empty or has a space, and a `short:` that is not one letter or digit, are `E0879` at the field — `rule:tooling/commands-are-compiled`
--FILE--
<?nvs
class Tool {
    #[Core\Command(name: "")]
    public static function nothing(): void {}

    #[Core\Command(name: "do it")]
    public static function twoWords(): void {}

    #[Core\Command(name: "build")]
    public static function build(
        #[Core\Option(short: "ab")] bool $all,
        #[Core\Option(short: "-")] bool $dash,
        #[Core\Option(long: "")] bool $empty,
        #[Core\Option(long: "dry run")] bool $dryRun,
        #[Core\Option(short: "q", long: "quiet")] bool $silent,
    ): void {}
}
--EXPECT--

--EXPECTF-ERROR--
error[E0879]: `name: ""` cannot be typed on a command line
