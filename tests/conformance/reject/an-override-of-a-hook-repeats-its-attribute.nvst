--TEST--
an override of an inherited hook, fixture or test repeats its attribute, and a second hook of one kind or a second fixture of one type beside an inherited one is refused, `rule:testing/hook-inheritance`
--FILE--
<?nvs
use Core\Test;
use Core\Test\AfterClass;
use Core\Test\AfterEachTest;
use Core\Test\BeforeClass;
use Core\Test\Fixture;

final class Catalog {
    public function constructor(public string $name) {}
}

abstract class DatabaseTest {
    #[BeforeClass]
    public static function openDatabase(): void {
    }

    #[AfterEachTest]
    public function removeFiles(): void {
    }

    #[Fixture]
    public static function catalog(): Catalog {
        return new Catalog("shop");
    }

    #[Test]
    public function itConnects(Catalog $catalog): void {
        Test::assertSame($catalog->name, "shop");
    }
}

// An override that repeats each attribute compiles.
final class ShopTest extends DatabaseTest {
    #[BeforeClass]
    public static function openDatabase(): void {
        parent::openDatabase();
    }

    #[Fixture]
    public static function catalog(): Catalog {
        return new Catalog("shop");
    }
}

final class BlogTest extends DatabaseTest {
    // Refused: the override does not repeat `#[BeforeClass]`.
    public static function openDatabase(): void {
    }

    // Refused: the override does not repeat `#[Fixture]`.
    public static function catalog(): Catalog {
        return new Catalog("blog");
    }

    // Refused: the override does not repeat `#[Test]`.
    public function itConnects(Catalog $catalog): void {
    }

    // Refused: the override has another attribute.
    #[Test]
    public function removeFiles(): void {
    }
}

final class NewsTest extends DatabaseTest {
    // Refused: the class inherits `removeFiles` as its `#[AfterEachTest]`.
    #[AfterEachTest]
    public function removeRows(): void {
    }

    // Refused: the class inherits `catalog`, which returns `Catalog` too.
    #[Fixture]
    public static function newsCatalog(): Catalog {
        return new Catalog("news");
    }
}
--EXPECTF-ERROR--
