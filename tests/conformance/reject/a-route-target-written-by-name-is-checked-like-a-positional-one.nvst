--TEST--
a `#[Core\Router\Target]` argument passed by name, after the named `params:`, is checked like a positional one and does not compile when the method has no `#[Route]` (`rule:routing/a-route-target-parameter-is-checked-like-a-link`)
--FILE--
<?nvs
class Shop {
    #[Core\Route(path: "/shop/{id}", method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function show(uint $id): string { return "show"; }

    // This method has no route.
    public static function plain(uint $id): string { return "plain"; }
}

class Links {
    // `$route` must be a route method. `$params` fills its path.
    public static function entry(#[Core\Router\Target] callable $route, #[Core\Router\Params] array<mixed> $params): string {
        return Core\Router::url($route, $params);
    }
}

// The arguments are named and in a different order. `Shop::plain` has no route, so this call does not compile.
echo Links::entry(params: ["id" => 1], route: Shop::plain), "\n";
// covers: lang:attributes/core-router-target-and-core-router-params-a-method-that-takes-a-route
--EXPECT--

--EXPECTF-ERROR--
error[E0754]: `Links::entry` takes a route, and `Shop::plain` has no `#[Route]`
   --> case.nvs:19:47
%A
error: aborting due to 1 error
