--TEST--
a `#[Property]` parameter needs a type that has random values, and each `gen:` range names a parameter, parses, and fits that parameter's type (`rule:testing/property-testing`)
--FILE--
<?nvs
// covers: lang:testing/core-test-property-generated-inputs
use Core\Test;
use Core\Test\Property;

interface Shape {}

abstract class Base {}

final class AcceptedTest {
    // Accepted: a range on a number, on a string's length and on a nullable list's length.
    #[Property(runs: 10, gen: {n: "1..9", s: "0..3", xs: "0..2"})]
    public function itTakesRanges(int $n, string $s, ?array<int> $xs): void {
        Test::assertTrue($n > 0);
    }
}

final class RefusedTest {
    // Refused: an interface has no constructor to build a value from.
    #[Property]
    public function itTakesAnInterface(Shape $shape): void {}

    // Refused: an abstract class cannot be built.
    #[Property]
    public function itTakesAnAbstractClass(Base $base): void {}

    // Refused: a secret value would be printed when the property fails.
    #[Property]
    public function itTakesASecret(secret string $key): void {}

    // Refused: the range names no parameter.
    #[Property(gen: {m: "1..9"})]
    public function itNamesNoParameter(int $n): void {}

    // Refused: the range does not parse.
    #[Property(gen: {n: "nine"})]
    public function itHasABadRange(int $n): void {}

    // Refused: a `bool` has no range.
    #[Property(gen: {b: "0..1"})]
    public function itHasARangeOnABool(bool $b): void {}

    // Refused: a property has no `retries:`, because its seed reproduces a failure.
    #[Property(retries: 2, because: "it fails at random")]
    public function itRetries(int $n): void {}
}
--EXPECTF-ERROR--
