--TEST--
A shape value that already exists, or a class instance, whose field is an `int` does not satisfy a shape whose field is a `float`, at any depth of the field type, because the value is shared and its field is not converted — `rule:types/shape-type`, `rule:types/conversion`
--FILE--
<?nvs
// covers: lang:types/callable-classes-object-shapes

type Whole = {amount: int};
type Price = {amount: float};

class Stock
{
    public int $amount = 2;
}

class Shop
{
    public static function read(Price $p): float
    {
        return $p->amount;
    }
}

// An existing `{amount: int}` value is not a `{amount: float}` value.
Whole $whole = {amount: 2};
Price $price = $whole;

// A class with an `int` property is not one either.
echo Shop::read(new Stock()), "\n";

// The same holds when the field type is nullable or a union.
({amount: ?float}) $maybe = $whole;
({amount: float|string}) $either = $whole;

// A shape nested in a field is checked the same way.
({inner: Price}) $outer = {inner: $whole};

// An `array<int>` field is not an `array<float>` field.
array<int> $counts = [1, 2];
var $list = {items: $counts};
({items: array<float>}) $floats = $list;
echo "unreachable\n";
--EXPECT--

--EXPECTF-ERROR--
