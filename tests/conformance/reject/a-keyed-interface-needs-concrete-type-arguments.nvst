--TEST--
A class implements `KeyedIterable` or `KeyedIterator` only with both type arguments written as types, so a bare name, one argument or undeclared names do not compile — `rule:iteration/keyed-interfaces`
--FILE--
<?nvs
// covers: KeyedIterable
final class Cursor implements KeyedIterator<string, int> {
    public function advance(): bool {
        return false;
    }

    public function key(): string {
        return "";
    }

    public function current(): int {
        return 0;
    }
}

// `KeyedIterable` without type arguments does not compile.
final class Bare implements KeyedIterable {
    public function iterateKeyed(): KeyedIterator<string, int> {
        return new Cursor();
    }
}

// `K` and `V` are not types, so this does not compile.
final class Named implements KeyedIterable<K, V> {
    public function iterateKeyed(): KeyedIterator<string, int> {
        return new Cursor();
    }
}

// `KeyedIterator` needs two type arguments, so one does not compile.
final class Half implements KeyedIterator<string> {
    public function advance(): bool {
        return false;
    }

    public function key(): string {
        return "";
    }

    public function current(): int {
        return 0;
    }
}
--EXPECT--

