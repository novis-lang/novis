--TEST--
An anonymous function written in a `Core\Html::later` call cannot change the response head -- a status, a header, a redirect, a cookie, a body method or any session write is a compile error there, in a nested anonymous function too, while the same calls in the main script and an `echo` in the anonymous function compile -- `rule:core-classes/html-later`
--FILE--
<?nvs
// A `later` callable fills one part of the page. At run time each of these
// calls throws `LogicError` inside it, and where the checker sees the
// anonymous function written in place, each is a compile error instead.
Core\Response::setStatus(200);
var $slot = Core\Html::later(fn(): void => {
    Core\Response::setStatus(404);
    Core\Response::setHeader("X-Shop", "1");
    Core\Response::redirect("/shop");
    Core\Response::addCookie("sid", "abc");
    Core\Response::sendText("body");
    Core\Session::regenerate();
});

// Every session write is a compile error here, for a visitor with a session too.
var $session = Core\Html::later(fn(): void => {
    array<secret bytes> $ring = [Core\Crypto::generateKey()];
    secret string $token = "sk-live-7";
    Core\Session::setShortLived("cart", 3);
    Core\Session::setLongLived("theme", "dark");
    Core\Session::setShortLivedSecret("refresh", $token, $ring);
    Core\Session::setLongLivedSecret("device", $token, $ring);
    Core\Session::remove("cart");
    Core\Session::clearShortLived();
    Core\Session::clearLongLived();
    Core\Session::clearAll();
});

// An anonymous function nested in a `later` one runs in the same slot.
var $nested = Core\Html::later(fn(): void => {
    var $inner = fn(): void => { Core\Response::sendJson(1); };
});

// The accepted half: an `echo` in the anonymous function is the slot's own
// output, and the options beside it are not part of it.
var $page = Core\Html::later(fn(): void => { echo "<p>Blog</p>"; },
                             {placeholder: html`<p>Loading</p>`});
Core\Response::setHeader("X-Blog", "1");
--EXPECT--

