--TEST--
a property and a parameter are separate declaration sites, so each mis-cased one gets its own diagnostic — `rule:core-api/casing-checks-the-leading-character`
--FILE--
<?nvs
class Point {
    public int $X;

    public function constructor(int $X) {
        $this->X = $X;
    }
}
echo "unreachable\n";
--EXPECT--

--EXPECTF-ERROR--
error[E0112]: property names must be camelCase, e.g. `x`
  --> case.nvs:3:16
%A
error[E0112]: parameter names must be camelCase, e.g. `x`
  --> case.nvs:5:37
