--TEST--
a `#[Bench]` method has a test's shape, takes `skip:` and `because:` alone and no data row, and is never also a `#[Test]` or a `#[Fixture]` (`rule:testing/bench-counters`)
--FILE--
<?nvs
// covers: lang:testing/bench-and-nvs-test-bench
use Core\Test;
use Core\Test\Bench;
use Core\Test\Fixture;
use Core\Test\TestWith;

final class AcceptedBench {
    // Accepted: a plain bench, a skipped one, and `because:` beside it.
    #[Bench]
    public function itRuns(): void {}

    #[Bench(skip: "measured elsewhere", because: "the import is slow")]
    public function itIsSkipped(): void {}
}

final class RefusedBench {
    // Refused: a bench runs once, so a retry buys nothing.
    #[Bench(retries: 2, because: "it is slow")]
    public function itRetries(): void {}

    // Refused: a bench cannot fix the random numbers or the clock.
    #[Bench(seed: 7)]
    public function itIsSeeded(): void {}

    #[Bench(at: "2026-01-01T00:00:00Z")]
    public function itHasAFixedClock(): void {}

    // Refused: a bench and a test on one method.
    #[Bench]
    #[Test]
    public function itIsAlsoATest(): void {}

    // Refused: a bench and a fixture on one method.
    #[Bench]
    #[Fixture]
    public static function itIsAlsoAFixture(): int {
        return 1;
    }

    // Refused: a bench is not `static` and returns `void`.
    #[Bench]
    public static function itIsStatic(): void {}

    #[Bench]
    public function itReturnsAValue(): int {
        return 1;
    }

    // Refused: the option is a string.
    #[Bench(skip: 3)]
    public function itSkipsWithANumber(): void {}

    // Refused: a bench takes no data row.
    #[Bench]
    #[TestWith(n: 1)]
    public function itHasARow(int $n): void {}
}
