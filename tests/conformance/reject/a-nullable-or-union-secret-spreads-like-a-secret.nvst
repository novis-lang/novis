--TEST--
`.`, interpolation, `.=` and `as` keep `secret` from a `?secret string`, a union with a `secret` member and an `array<secret string>` — `rule:security/secret-propagation`
--FILE--
<?nvs
// `rule:security/secret-propagation`: `.`, interpolation, `.=` and `as` read
// `secret` off every member of a union and off an array's element, as they read
// `tainted`, so a `?secret string` poisons exactly as a `secret string` does.
class Token {
    public static function concat(?secret string $s): void {
        echo "Bearer " . $s;
    }

    public static function interpolate(?secret string $s): void {
        echo "Bearer {$s}";
    }

    public static function union(secret string|int $s): void {
        echo "Bearer " . $s;
    }

    public static function append(?secret string $s): void {
        string $out = "Bearer ";
        $out .= $s;
    }

    public static function convert(?secret string $s): string {
        return $s as string;
    }

    public static function convertBoth(?secret tainted string $s): string {
        return $s as string;
    }

    public static function convertArray(array<secret string> $s): array<string> {
        return $s as array<string>;
    }
}
--EXPECT--

