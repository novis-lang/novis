--TEST--
`static::` inside a closure body is refused in every form — a constant, a call, `::class` — because the closure's frame carries no called class, `rule:statements/static-is-a-member-modifier`
--FILE--
<?nvs
class Base {
    public const string PATH = "/";

    public static function tag(): string {
        return "tag";
    }

    public function constant(): string {
        callable $f = fn (): string => static::PATH;
        return $f() as string;
    }

    public function call(): string {
        callable $f = fn (): string => static::tag();
        return $f() as string;
    }

    public static function name(): string {
        callable $f = fn (): string => static::class;
        return $f() as string;
    }
}
echo "after\n";
// covers: lang:classes/methods-self-static-and-parent
--EXPECT--

--EXPECTF-ERROR--
error[E0834]: `static::` names no class inside a closure body
   --> case.nvs:10:40
%A
error[E0834]: `static::` names no class inside a closure body
   --> case.nvs:15:40
%A
