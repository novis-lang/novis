--TEST--
`static` marks a class member and nothing else, so there is no per-function storage class — `rule:statements/no-function-static-and-no-global`
--FILE--
<?nvs
class Counter {
    public static function bump(): int {
        static int $n = 0;
        return 1;
    }
}
echo Counter::bump(), "\n";
--EXPECT--

--EXPECTF-ERROR--
error[E0209]: function-scope `static` is not supported
  --> case.nvs:4:9
