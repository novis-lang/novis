--TEST--
`$c is class<Dog>` is `E0867`, alone or in a union, and its help names `as ?class<Dog>`, which checks the class a reference names (`rule:types/type-test`)
--FILE--
<?nvs
class Animal {}
final class Dog extends Animal {}

class<Animal> $c = Dog::class as class<Animal>;
echo ($c is class<Dog>) ? "dog" : "other";
echo ($c is class<Dog>|null) ? "dog" : "other";
--EXPECT--

