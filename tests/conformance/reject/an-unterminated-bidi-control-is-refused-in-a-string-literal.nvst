--TEST--
a directional scope opened in a single-quoted literal and never closed is a compile error — ADR 0087 §§ 1-2
--FILE--
<?nvs
string $label = 'user ⁦ admin';
echo $label, "\n";
--EXPECT--

--EXPECTF-ERROR--
error[E0008]: unterminated bidirectional control U+2066 LEFT-TO-RIGHT ISOLATE
%A
error: aborting due to 1 error
