--TEST--
`self::m()` and `parent::m()` inside a closure call the class the closure is written in, and a static target reads that class as `static` — `rule:statements/static-is-a-member-modifier`
--FILE--
<?nvs
class Base {
    protected static function name(): string {
        return static::class;
    }

    protected function greet(int $n): string {
        return 'base ' . $n;
    }
}

class Shop extends Base {
    private string $prefix = 'item ';

    // A closure in a static method calls a private static method.
    public static function labels(): string {
        array<int> $a = [1, 2];
        return Core\Str::join(Core\Arr::map($a, fn($n) => self::label($n)), ', ');
    }

    // A closure in an instance method calls a static and an instance method.
    // The instance call uses the `$this` of the method that made the closure.
    public function tags(): string {
        array<int> $a = [1, 2];
        return Core\Str::join(
            Core\Arr::map($a, fn(int $n): string => self::label($n) . ' / ' . self::tag($n)),
            ', ',
        );
    }

    public static function parentName(): string {
        var $f = fn(): string => parent::name();
        return $f();
    }

    public function parentGreet(): string {
        var $f = fn(int $n): string => parent::greet($n);
        return $f(3);
    }

    // Outside a closure, `self::` keeps the class the outer call was made on.
    public static function direct(): string {
        return self::label(0);
    }

    private static function label(int $n): string {
        return static::class . ' ' . $n;
    }

    private function tag(int $n): string {
        return static::class . ' ' . $this->prefix . $n;
    }
}

final class Outlet extends Shop {
}

echo Shop::labels(), "\n";
echo Outlet::labels(), "\n";
echo Outlet::direct(), "\n";
echo (new Outlet())->tags(), "\n";
echo Outlet::parentName(), "\n";
echo (new Outlet())->parentGreet(), "\n";
--EXPECT--
Shop 1, Shop 2
Shop 1, Shop 2
Outlet 0
Shop 1 / Outlet item 1, Shop 2 / Outlet item 2
Shop
base 3
