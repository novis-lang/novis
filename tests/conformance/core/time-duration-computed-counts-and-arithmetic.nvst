--TEST--
Spec § 4: `Core\Time\Duration`'s eight constructors are for a computed count, and its arithmetic is exact
--FILE--
<?nvs
// The eight constructors exist for a count that is not known while compiling;
// a constant one is `rule:types/duration`'s literal, and the two agree exactly.
var $n = 2;
echo Core\Time\Duration::nanoseconds($n)->toNanoseconds() as string, "|\n";
echo Core\Time\Duration::microseconds($n)->toNanoseconds() as string, "|\n";
echo Core\Time\Duration::milliseconds($n)->toNanoseconds() as string, "|\n";
echo Core\Time\Duration::seconds($n)->toSeconds() as string, "|\n";
echo Core\Time\Duration::minutes($n)->toSeconds() as string, "|\n";
echo Core\Time\Duration::hours($n)->toSeconds() as string, "|\n";
echo Core\Time\Duration::days($n)->toSeconds() as string, "|\n";
echo Core\Time\Duration::weeks($n)->toSeconds() as string, "|\n";
echo Core\Time\Duration::seconds(30)->compareTo(30s) as string, "|\n";

// Every `to…` member truncates toward zero, which is what integer division
// already does in both directions.
echo (1500ns)->toMicroseconds() as string, "|\n";
echo (1500ns)->negated()->toMicroseconds() as string, "|\n";
echo (1999ms)->toSeconds() as string, "|\n";

// `rule:core-api/shape-rules` R3: nothing mutates. `plus` answers a fresh value and leaves its
// receiver alone.
var $base = 1h;
var $longer = $base->plus(30m);
echo $base->toSeconds() as string, "|", $longer->toSeconds() as string, "|\n";
echo $longer->minus(45m)->toString(), "|\n";
echo $base->multipliedBy(3)->toString(), "|\n";

// `rule:types/duration`: `-7d` does not parse, so a backwards step is `minus` or
// `negated` — and a negative duration renders with the sign the grammar
// itself has no spelling for.
echo (0s)->minus(90m)->toString(), "|\n";
echo (90m)->negated()->toString(), "|\n";
echo (90m)->negated()->negated()->compareTo(90m) as string, "|\n";

// `Comparable`'s answer is a sign, not a difference.
echo (30s)->compareTo(1h) as string, "|", (1h)->compareTo(30s) as string, "|\n";

// `rule:core-api/shape-rules` R4: failure throws. A count past the nanosecond range is refused
// rather than wrapped, at run time exactly as a literal is while compiling.
try {
    echo Core\Time\Duration::weeks(1000000)->toString(), "|\n";
} catch (Throwable $e) {
    echo Core\Str::contains($e->message, "longer than") as string, "|\n";
}

// `rule:types/duration`: `parse` throws on anything the grammar does not accept, which
// is what makes it a launderer for a config string. Behind a binding, because
// `rule:expressions/intrinsic-list-is-closed` folds this member's literal argument: written inline, the same
// text is a compile error rather than the throw this asks for.
string $spaced = "30 seconds";
try {
    echo Core\Time\Duration::parse($spaced)->toString(), "|\n";
} catch (Throwable $e) {
    echo Core\Str::contains($e->message, "duration") as string, "|\n";
}
--EXPECT--
2|
2000|
2000000|
2|
120|
7200|
172800|
1209600|
0|
1|
-1|
1|
3600|5400|
45m|
3h|
-1h30m|
-1h30m|
0|
-1|1|
1|
1|
