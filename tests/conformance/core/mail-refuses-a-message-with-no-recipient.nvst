--TEST--
Core\Mail::send refuses an empty recipient list rather than sending nothing quietly — ADR 0082 § 2
--FILE--
<?nvs
// `$to` is `array<string>` rather than a comma-separated string (ADR 0095's
// reading: a comma inside a display name would be a second recipient), which
// makes the empty list a shape the type permits and the member has to answer.
// It throws: a program that computed its recipients and got none has a bug,
// and a send that succeeded at delivering to nobody would hide it.
try {
    Core\Mail::send("transactional", [], "Your receipt", "Thank you.");
    echo "accepted", "\n";
} catch (RuntimeError $e) {
    echo "refused", "\n";
}
--EXPECT--
refused
