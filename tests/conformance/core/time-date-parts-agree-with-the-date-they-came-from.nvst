--TEST--
`Core\Time\Date`'s readers `year`, `month`, `day`, `weekday`, `dayOfYear` and `isLeapYear` agree with `format` and with the same reader on the `DateTime` at its midnight in `$zone`, and that `DateTime`'s `date()` is the date again, over a table that reaches both ends of the range and 29 February
--FILE--
<?nvs
// covers: Core\Time\Date::year, Core\Time\Date::month, Core\Time\Date::day, Core\Time\Date::weekday, Core\Time\Date::dayOfYear, Core\Time\Date::isLeapYear, Core\Time\DateTime::at
// Each reader can be answered on its own, which is how two of them come to
// disagree. So every row asks each field three ways: the reader, `format`
// (the independent oracle), and the same reader on the `DateTime` that
// `DateTime::at` builds at the date's midnight. The first and the last day start inside the
// timestamp range only at the widest offsets, so those two rows use them.
array<int> $years = [-9999, -1, 0, 1900, 2000, 2023, 2024, 2024, 2024, 9999];
array<int> $months = [1, 12, 2, 3, 12, 12, 2, 3, 10, 12];
array<int> $days = [1, 31, 29, 1, 31, 31, 29, 31, 27, 31];
array<string> $zoneIds = ["-", "UTC", "UTC", "Asia/Kolkata", "Pacific/Auckland", "UTC", "Europe/Berlin", "Europe/Berlin", "Europe/Berlin", "+"];

int $rows = 0;
int $formatAgrees = 0;
int $startAgrees = 0;
int $roundTrips = 0;
string $read = "";
int $row = 0;
for (; $row < 10; $row = $row + 1) {
    var $d = Core\Time\Date::at($years[$row as string], $months[$row as string] as uint, $days[$row as string] as uint);
    string $zoneId = $zoneIds[$row as string];
    var $zone = Core\Time\Zone::UTC;
    if ($zoneId == "-") {
        $zone = Core\Time\Zone::fixed(25h59m59s->negated());
    } else if ($zoneId == "+") {
        $zone = Core\Time\Zone::fixed(25h59m59s);
    } else {
        $zone = Core\Time\Zone::of($zoneId);
    }
    var $start = Core\Time\DateTime::at($d, Core\Time\TimeOfDay::at(0, 0), $zone);
    $rows = $rows + 1;

    // `u` is the signed year and `e` the weekday number, Monday `1`.
    string $readers = ($d->year() as string) . " " . ($d->month() as string) . " "
        . ($d->day() as string) . " " . ($d->dayOfYear() as string) . " "
        . ((($d->weekday() as int) + 1) as string);
    if ($readers == $d->format("u M d D e")) {
        $formatAgrees = $formatAgrees + 1;
    }
    if ($d->year() == $start->date()->year() && $d->month() == $start->date()->month()
        && $d->day() == $start->date()->day() && $d->dayOfYear() == $start->dayOfYear()
        && ($d->weekday() as int) == ($start->weekday() as int)
        && $d->isLeapYear() == $start->isLeapYear()) {
        $startAgrees = $startAgrees + 1;
    }
    if ($start->date()->compareTo($d) == 0 && $start->format("HH:mm") == "00:00") {
        $roundTrips = $roundTrips + 1;
    }
    $read = $read . $readers . " " . ($d->isLeapYear() as string) . "\n";
}
echo $rows as string, "|", $formatAgrees as string, "|", $startAgrees as string, "|", $roundTrips as string, "|\n";
// The values themselves, so the counts above are anchored to output a
// reader can check: year, month, day, day of year, weekday, leap year.
echo $read;

// A zone whose clocks skipped midnight: Sao Paulo moved from 00:00 to 01:00
// on 4 November 2018, so that day starts at 01:00, and the day before at 00:00.
var $saoPaulo = Core\Time\Zone::of("America/Sao_Paulo");
echo Core\Time\DateTime::at(Core\Time\Date::at(2018, 11, 4), Core\Time\TimeOfDay::at(0, 0), $saoPaulo)->format("yyyy-MM-dd HH:mm XXX"), "|\n";
echo Core\Time\DateTime::at(Core\Time\Date::at(2018, 11, 3), Core\Time\TimeOfDay::at(0, 0), $saoPaulo)->format("yyyy-MM-dd HH:mm XXX"), "|\n";

// In UTC, midnight on the last day is past the end of the timestamp range.
try {
    echo Core\Time\DateTime::at(Core\Time\Date::at(9999, 12, 31), Core\Time\TimeOfDay::at(0, 0), "UTC")->format("yyyy-MM-dd"), "|\n";
} catch (RuntimeError $e) {
    echo $e->message, "|\n";
}
--EXPECT--
10|10|10|10|
-9999 1 1 1 1
-1 12 31 365 5
0 2 29 60 2 1
1900 3 1 60 4
2000 12 31 366 7 1
2023 12 31 365 7
2024 2 29 60 4 1
2024 3 31 91 7 1
2024 10 27 301 7 1
9999 12 31 365 5
2018-11-04 01:00 -02:00|
2018-11-03 00:00 -03:00|
Core\Time\DateTime::at(): the time is outside -9999-01-02T01:59:59Z..=9999-12-30T22:00:00Z|
