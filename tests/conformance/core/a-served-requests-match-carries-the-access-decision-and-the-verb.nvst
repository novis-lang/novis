--TEST--
The match a request carries answers the access decision and the verb of its route, so the program answering it can refuse before it calls anything — `rule:routing/matched-once-before-the-handler` `rule:security/access-is-checked-for-presence-not-meaning`
--FILE--
<?nvs
// The other cases ask `Core\Router::match`, which is the table asked about a
// verb and a path the caller chose. This one asks the match the *door* took,
// the one `Core\Request::route()` answers, because that is the match a
// dispatcher reads: the decision has to have crossed with the request, or the
// program answering it has nothing to enforce.
//
// The `if` branch is the child: the program answering an in-process request is
// this same program, and `Core\Env::context()` is `Request` in that run.
enum Role { Admin }

class Api
{
    #[Core\Route(path: "/reports", method: Core\Http\Method::Post)]
    #[Core\Access(allow: Role::Admin, csrf: false)]
    public function report(): string { return "reported"; }
}

if (Core\Env::context() == Core\Env::Context::Request) {
    ?Core\Router\Match $matched = Core\Request::route();
    if ($matched == null) {
        echo "the table claimed nothing";
    } else {
        echo $matched->access() ?? "null";
        echo $matched->method() == Core\Http\Method::Post ? " under Post" : " under another verb";
        if ($matched->access() != "Core\\Audience::Public") {
            Core\Response::setStatus(403);
        }
    }
} else {
    var $answered = Core\Test::request(Core\Http\Method::Post, "/reports");
    echo "status ", $answered->status(), "\n";
    echo "body ", $answered->body(), "\n";
}
--EXPECT--
status 403
body Role::Admin under Post
