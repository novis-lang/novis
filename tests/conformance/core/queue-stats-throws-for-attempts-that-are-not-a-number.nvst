--TEST--
An `attempts` cell a program overwrote with text makes `stats` throw an `IOError` the program catches, and a negative one counts as zero, and neither is a fatal that ends the request — `rule:testing/a-failing-proof-is-fixed-or-recorded`
--FILE--
<?nvs
use Core\Queue;

// `status` reads one row and `stats` sums a column of them, and the program can
// write that column through the same connection. SQLite sums a text cell to a
// `real`, so the counter is not an integer and the call must reach the `catch`.
var $db = Core\Db::connect("jobs");
var $jobs = <<<'SQL'
create table nvs_jobs (id integer primary key autoincrement, queue varchar(255) not null,
    script text not null, args text, state smallint not null, attempts integer not null,
    max_attempts integer not null, backoff_ms bigint not null, run_at bigint not null,
    tag varchar(255), dedupe_key varchar(255), dedupe_pending varchar(255),
    created_at bigint not null, claimed_at bigint, errors text, grants text, limits text,
    constraint nvs_jobs_dedupe unique (dedupe_pending))
SQL;
var $dead = <<<'SQL'
create table nvs_dead_jobs (id bigint not null, queue varchar(255) not null,
    script text not null, args text, attempts integer not null, max_attempts integer not null,
    backoff_ms bigint not null, run_at bigint not null, tag varchar(255),
    dedupe_key varchar(255), created_at bigint not null, failed_at bigint not null,
    errors text not null, primary key (id))
SQL;
$db->execute($jobs, []);
$db->execute($dead, []);
Queue::push("jobs/a.nvs", {queue: "q"});

$db->execute("update nvs_jobs set attempts = 'many'", []);
try {
    uint $attempts = Queue::stats("q")->attempts();
    echo "text: ", $attempts, "\n";
} catch (IOError $e) {
    echo "text: IOError\n";
}

// A negative sum has no reading as work done, so the `uint` counter is `0`.
$db->execute("update nvs_jobs set attempts = -5", []);
echo "negative: ", Queue::stats("q")->attempts(), "\n";
echo "still running\n";
--FILE nvs.toml--
[capabilities.db]
connect = ["jobs"]

[db.jobs]
driver = "sqlite"
path = ":memory:"

[queue]
connection = "jobs"
workers = 0
--EXPECT--
text: IOError
negative: 0
still running
