--TEST--
`Core\Hash` computes every `Core\Digest`, authenticates with HMAC and compares two digests by content — spec § 11, `rule:types/bytes` and `rule:types/conversion`
--FILE--
<?nvs
// covers: Core\Digest
// § 11: the algorithm is an argument, not part of the member's name, so one
// member stands where PHP has `md5`, `sha1`, `crc32`, `hash` and
// `openssl_digest`. Each line below is that specification's own "abc" vector.
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Crc32)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Md5)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha1)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha384)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha512)), "\n";

// `rule:types/conversion`: `string as bytes` is total and free, so the same octets hash
// the same whichever of the two tags the caller is holding them under. That is
// what the `bytes|string` parameter buys, and the reason there is no
// text-flavoured twin of this member.
bytes $raw = Core\Encoding::fromHex("616263");
bytes $viaBytes = Core\Hash::of($raw, Core\Digest::Sha256);
bytes $viaText = Core\Hash::of("abc", Core\Digest::Sha256);
if (Core\Hash::equals($viaBytes, $viaText)) {
    echo "one digest, either tag\n";
}

// The result is `bytes` — the 32 octets a SHA-256 is, with no `raw_output`
// flag and no hex until `Core\Encoding` is asked for one (`rule:types/bytes`). Two
// hex digits per octet, so 64 is the width of the spelling and 32 is the
// width of the value. (`Core\Bytes::length` is § 7's, and unwritten.)
echo Core\Str::length(Core\Encoding::toHex($viaBytes)), "\n";

// RFC 4231's second test case, whose key is short enough to read: HMAC is a
// separate member rather than an option, because its third parameter is the
// closed `StrongDigest` subset and `of`'s is the whole enum.
bytes $key = Core\Encoding::fromHex("4a656665");
echo Core\Encoding::toHex(
    Core\Hash::hmac("what do ya want for nothing?", $key, Core\Digest::Sha256)
), "\n";
echo Core\Encoding::toHex(
    Core\Hash::hmac("what do ya want for nothing?", $key, Core\Digest::Sha512)
), "\n";

// A one-octet difference is still a difference: `equals` is constant-time in
// where the operands diverge, not in whether they do.
if (!Core\Hash::equals($viaBytes, Core\Hash::of("abd", Core\Digest::Sha256))) {
    echo "differ\n";
}
