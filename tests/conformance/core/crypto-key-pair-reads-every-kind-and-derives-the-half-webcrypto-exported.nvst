--TEST--
Core\Crypto\KeyPair::read takes every kind of the roster as DER PKCS#8, ->write hands the same file back, and ->publicKey derives the public half WebCrypto exported beside it — `rule:core-classes/crypto-interop-tier`, `rule:security/algorithm-comes-from-the-key`
--FILE--
<?nvs
// covers: Core\Crypto\KeyPair::write, Core\Crypto\KeyPair::publicKey
// WebCrypto's own private keys, frozen under
// `crates/nvs-stdlib/tests/vectors/`, each beside the `SubjectPublicKeyInfo`
// WebCrypto exported for it. That these *are* WebCrypto's bytes is held by that
// file; what a `.nvs` program can assert is that every kind of the roster reads,
// that a pair hands its own file back, and that the public half is derived from
// the private key rather than remembered from somewhere. Asserted by counting
// rather than read off a line: a reader that carried four kinds and lost the
// fifth prints a plausible row for each of the four it kept.
array<Core\Crypto\KeyKind> $kinds = [
    Core\Crypto\KeyKind::P256,
    Core\Crypto\KeyKind::X25519,
    Core\Crypto\KeyKind::Ed25519,
    Core\Crypto\KeyKind::RsaPkcs1,
    Core\Crypto\KeyKind::RsaPss,
];
array<string> $pkcs8 = [
    "3041020100301306072a8648ce3d020106082a8648ce3d03010704273025020101042033172cfd4cb8e906b35b1dd8753ac6b12b8c760281d124bf635dbf5c5f15c49a",
    "302e020100300506032b656e042204200172af48574da59d306df1b27cc27457304669fb73e0630b9f84eac038695c2c",
    "302e020100300506032b65700422042036e7913c75ff5d89ba4f46526320f547cf75369a560a168f6ab5bb178fbeaadf",
    "",
    "",
];
array<string> $spki = [
    "3059301306072a8648ce3d020106082a8648ce3d0301070342000468aa7eb5d775b8ab32e53b3a2b006dc42638d4d5a06d9b50c493781e2a65f3e036cb273ea410534a6e8c946ae9ea7e10318686faeeba6850b16fdb2572ff0e89",
    "302a300506032b656e0321007d82b8dc4d111da7d459301c4d278d8519db6bc4e05cf6de7b078a891767a331",
    "302a300506032b6570032100fcce9008a33565248561295a7ce1cccb040b6129bba8ff24744953bbc01261ac",
    "",
    "",
];

int $roundTrips = 0;
int $halves = 0;
int $kindsKept = 0;
foreach ($pkcs8 as string $slot => string $hex) {
    Core\Crypto\KeyPair $pair = Core\Crypto\KeyPair::read(
        Core\Encoding::fromHex($hex),
        $kinds[$slot]
    );

    // The pair holds its PKCS#8, so this asserts the file came back and not
    // merely that something parsed. `write` answers `secret bytes`, which is
    // what a private key is, so the expectation is widened to meet it rather
    // than the answer narrowed to meet the expectation.
    secret bytes $stored = Core\Encoding::fromHex($hex);
    if ($pair->write() == $stored) {
        $roundTrips += 1;
    }

    // The public half is derived from the private key. A pair that had kept
    // one handed to it could hold a public key belonging to somebody else;
    // this is the same key WebCrypto exported from the same private key.
    Core\Crypto\PublicKey $public = $pair->publicKey();
    if (Core\Encoding::toHex($public->write(Core\Crypto\KeyFormat::Spki)) == $spki[$slot]) {
        $halves += 1;
    }

    // The kind is the call's own word, carried from the pair to the public key.
    // The two RSA rows are one key type under two schemes, so a member deriving
    // the kind from the material could not tell them apart.
    if ($public->kind() == $kinds[$slot]) {
        $kindsKept += 1;
    }
}
echo "pkcs8 round-trips ", $roundTrips, " of ", Core\Arr::count($pkcs8), "\n";
echo "public halves derived ", $halves, " of ", Core\Arr::count($pkcs8), "\n";
echo "kinds kept ", $kindsKept, " of ", Core\Arr::count($pkcs8), "\n";
--EXPECT--
pkcs8 round-trips 5 of 5
public halves derived 5 of 5
kinds kept 5 of 5
