--TEST--
`Core\Hash\Stream::update`/`finish` agree with `Core\Hash::of` over every chunking of one input, for every `Core\Digest` — spec § 11, ADR 0009 §§ 1 and 3
--FILE--
<?nvs
// § 11: the streaming pair's whole contract is an *agreement* with the
// one-shot member — `finish` answers what `Core\Hash::of` would over the
// concatenation of every chunk, whatever shape the updates arrived in. So the
// question is asked of each of `Core\Digest`'s six cases with the same table
// of chunkings, and the answer is a count rather than a digest: a stream that
// carried a boundary into its state fails the count while every row of it
// still prints plausibly on its own.
//
// 70 octets crosses SHA-256's 64-byte block edge and sits past the 55-octet
// mark where its length padding no longer fits beside the message, and stays
// inside SHA-512's single 128-byte block — two different shapes of the same
// sweep, from one subject.
class Chunkings
{
    // Every two-way split, offset 0 through the length inclusive: the sweep
    // contains the empty leading chunk, the empty trailing one, and a boundary
    // either side of the block edge.
    public static function twoWay(string $message, Core\Digest $digest): int
    {
        int $len = Core\Str::length($message) as int;
        bytes $whole = Core\Hash::of($message, $digest);
        int $agree = 0;
        int $at = 0;
        for ($at = 0; $at <= $len; $at = $at + 1) {
            var $stream = Core\Hash::stream($digest);
            $stream->update(Core\Str::slice($message, 0, $at));
            $stream->update(Core\Str::slice($message, $at, $len - $at));
            if (Core\Hash::equals($stream->finish(), $whole)) {
                $agree = $agree + 1;
            }
        }
        return $agree;
    }

    // Every three-way split, both boundaries swept independently — which is
    // where a state that remembered only the *last* chunk's alignment shows
    // up, and where two adjacent empty chunks appear (`$i == $j`).
    public static function threeWay(string $message, Core\Digest $digest): int
    {
        int $len = Core\Str::length($message) as int;
        bytes $whole = Core\Hash::of($message, $digest);
        int $agree = 0;
        int $i = 0;
        int $j = 0;
        for ($i = 0; $i <= $len; $i = $i + 1) {
            for ($j = $i; $j <= $len; $j = $j + 1) {
                var $stream = Core\Hash::stream($digest);
                $stream->update(Core\Str::slice($message, 0, $i));
                $stream->update(Core\Str::slice($message, $i, $j - $i));
                $stream->update(Core\Str::slice($message, $j, $len - $j));
                if (Core\Hash::equals($stream->finish(), $whole)) {
                    $agree = $agree + 1;
                }
            }
        }
        return $agree;
    }

    // Fixed-width chunkings, width 1 through the length: the update *count*
    // swept rather than the boundary, so it includes the maximally fragmented
    // one octet at a time and the ragged tail every width but a divisor
    // leaves. With `$padded`, an empty `update` is interleaved before every
    // chunk and after the last — an update carrying no octets contributes
    // none, at any alignment.
    public static function byWidth(string $message, Core\Digest $digest, bool $padded): int
    {
        int $len = Core\Str::length($message) as int;
        bytes $whole = Core\Hash::of($message, $digest);
        int $agree = 0;
        for (int $width = 1; $width <= $len; $width = $width + 1) {
            var $stream = Core\Hash::stream($digest);
            int $at = 0;
            for ($at = 0; $at < $len; $at = $at + $width) {
                int $take = $len - $at;
                if ($take > $width) {
                    $take = $width;
                }
                if ($padded) {
                    $stream->update("");
                }
                $stream->update(Core\Str::slice($message, $at, $take));
            }
            if ($padded) {
                $stream->update("");
            }
            if (Core\Hash::equals($stream->finish(), $whole)) {
                $agree = $agree + 1;
            }
        }
        return $agree;
    }

    // The degenerate chunking: one `update` with the whole subject, and the
    // one with none at all, which is the empty-input row that exercises the
    // padding and nothing else. ADR 0009 § 3: `string as bytes` is total, so
    // the tag a chunk arrives under is not part of the digest either, and the
    // single-chunk row is spelled with the other one.
    public static function degenerate(string $message, Core\Digest $digest): int
    {
        int $agree = 0;
        var $one = Core\Hash::stream($digest);
        $one->update($message as bytes);
        if (Core\Hash::equals($one->finish(), Core\Hash::of($message, $digest))) {
            $agree = $agree + 1;
        }
        var $none = Core\Hash::stream($digest);
        if (Core\Hash::equals($none->finish(), Core\Hash::of("", $digest))) {
            $agree = $agree + 1;
        }
        return $agree;
    }

    public static function all(string $message, Core\Digest $digest): int
    {
        return Chunkings::degenerate($message, $digest)
            + Chunkings::twoWay($message, $digest)
            + Chunkings::threeWay($message, $digest)
            + Chunkings::byWidth($message, $digest, false)
            + Chunkings::byWidth($message, $digest, true);
    }
}

string $message = Core\Str::repeat("0123456789", 7);
echo "length: ", Core\Str::length($message), "\n";

// 2 degenerate + 71 two-way + 2556 three-way + 70 + 70 by width. The
// denominator is printed from the digest whose vectors are already pinned
// elsewhere, so a sweep that silently stopped short fails every later line
// against it rather than agreeing with itself.
int $total = Chunkings::all($message, Core\Digest::Sha256);
echo "chunkings per digest: ", $total, "\n";

// § 11 keeps `Crc32`, `Md5` and `Sha1` for interop, and the stream takes the
// whole enum for the same reason, so the agreement is asserted over all six
// rather than over the two the other streaming cases sweep. A member that
// grew a chunking rule of its own — a checksum accumulated per update, a
// block width read from the wrong case — fails its own line here while the
// digests either side of it still print.
echo "Crc32  agreeing: ", Chunkings::all($message, Core\Digest::Crc32) == $total ? "all" : "some", "\n";
echo "Md5    agreeing: ", Chunkings::all($message, Core\Digest::Md5) == $total ? "all" : "some", "\n";
echo "Sha1   agreeing: ", Chunkings::all($message, Core\Digest::Sha1) == $total ? "all" : "some", "\n";
echo "Sha256 agreeing: ", Chunkings::all($message, Core\Digest::Sha256) == $total ? "all" : "some", "\n";
echo "Sha384 agreeing: ", Chunkings::all($message, Core\Digest::Sha384) == $total ? "all" : "some", "\n";
echo "Sha512 agreeing: ", Chunkings::all($message, Core\Digest::Sha512) == $total ? "all" : "some", "\n";

// The count is only worth something if the six answers are actually six: the
// agreement above would hold vacuously if every digest answered the same
// octets. `Core\Hash::equals` says they do not, pairwise down the enum.
echo "distinct: ",
    !Core\Hash::equals(Core\Hash::of($message, Core\Digest::Crc32), Core\Hash::of($message, Core\Digest::Md5))
        && !Core\Hash::equals(Core\Hash::of($message, Core\Digest::Md5), Core\Hash::of($message, Core\Digest::Sha1))
        && !Core\Hash::equals(Core\Hash::of($message, Core\Digest::Sha1), Core\Hash::of($message, Core\Digest::Sha256))
        && !Core\Hash::equals(Core\Hash::of($message, Core\Digest::Sha256), Core\Hash::of($message, Core\Digest::Sha384))
        && !Core\Hash::equals(Core\Hash::of($message, Core\Digest::Sha384), Core\Hash::of($message, Core\Digest::Sha512))
        ? "yes" : "no",
    "\n";
--EXPECT--
length: 70
chunkings per digest: 2769
Crc32  agreeing: all
Md5    agreeing: all
Sha1   agreeing: all
Sha256 agreeing: all
Sha384 agreeing: all
Sha512 agreeing: all
distinct: yes
