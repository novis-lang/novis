--TEST--
`Core\Request::route()` alone opts the program into the autoload scan, so the request matches a route only an autoload root declares — `rule:routing/table-is-opt-in`
--FILE--
<?nvs
// `Shop\Catalog` is written nowhere in this program, and no `Core\Router` or
// `Core\Program` call appears. The table only has its route if `route()` makes
// the program scan the `Shop` root. Without the scan the child prints
// `the table claimed nothing` and the body says so. The child prints no method
// reference either, because writing `Shop\Catalog::index` would name the class.
//
// The `if` branch is the child: the program answering an in-process request is
// this same program, and `Core\Env::context()` is `Request` in that run.
autoload 'Shop' from './lib';

if (Core\Env::context() == Core\Env::Context::Request) {
    var $matched = Core\Request::route();
    if ($matched == null) {
        echo "the table claimed nothing";
    } else {
        echo "the table claimed GET /catalog";
    }
} else {
    var $answered = Core\Test::request(Core\Http\Method::Get, "/catalog");
    echo "status ", $answered->status(), "\n";
    echo "body ", $answered->body(), "\n";
}
--FILE lib/Catalog.nvs--
<?nvs
namespace Shop;

class Catalog
{
    #[Core\Route(path: "/catalog", method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function index(): string
    {
        return "catalog";
    }
}
--EXPECT--
status 200
body the table claimed GET /catalog
