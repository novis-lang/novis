--TEST--
Core\Random::int, float and token draw from a CSPRNG inside the bounds each one states, and an empty range throws — spec § 11, ADR 0063 R4
--FILE--
<?mwl
// A random answer cannot be asserted, so every line here pins an invariant of
// the draw rather than the draw itself. `Draw` exists because a `catch` does
// not lower at file scope; the two throwing rows go through it.
class Draw {
    public static function inRange(int $min, int $max): string {
        try {
            return Core\Random::int($min, $max) as string;
        } catch (Throwable $e) {
            return "threw: " . $e->message;
        }
    }

    public static function tokenLength(uint $bytes): string {
        try {
            return Core\Str::length(Core\Random::token($bytes)) as string;
        } catch (Throwable $e) {
            return "threw: " . $e->message;
        }
    }
}

// Spec § 11: `int` is inclusive at both ends, so the degenerate range is the
// one draw with a single possible answer.
echo Core\Random::int(5, 5), "\n";
echo Draw::inRange(-7, -7), "\n";

// Every other draw is compared against its own bounds instead.
var $die = Core\Random::int(1, 6);
echo ($die >= 1 && $die <= 6) ? "in range" : "out of range", "\n";

// `float()` is uniform in [0, 1): zero is drawable, one is not.
var $f = Core\Random::float();
echo ($f >= 0.0 && $f < 1.0) ? "unit" : "outside", "\n";

// `token` counts the *bytes* drawn and answers with hex, so the string is
// twice as long as the count — 32 bytes by `CoreMethod::defaults`.
echo Core\Str::length(Core\Random::token()), "\n";
echo Draw::tokenLength(8), "\n";
echo Core\Regex::matches(Core\Random::token(16), '^[0-9a-f]{32}$') ? "hex" : "not hex", "\n";

// ADR 0063 R4: an empty range and a zero-byte token each have no answer worth
// inventing, so both throw rather than swapping the bounds or handing back "".
echo Draw::inRange(4, 3), "\n";
echo Draw::tokenLength(0), "\n";
--EXPECT--
5
-7
in range
unit
64
16
hex
threw: Core\Random::int(): the range is empty — the lower bound 4 is above the upper bound 3, and both ends are inclusive
threw: Core\Random::token(): a token of zero bytes is the empty string, which is not a token — draw at least one byte
