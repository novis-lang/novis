--TEST--
`Core\Queue\Stats::attempts` sums the `attempts` of every row of one queue in `nvs_jobs` whatever its state, counts no other queue and no dead-lettered row, and keeps the number it read when the rows change after — `rule:concurrency/enqueue-commits-with-your-write`
--FILE--
<?nvs
// covers: Core\Queue\Stats::attempts
use Core\Queue;

var $db = Core\Db::connect("jobs");
var $jobs = <<<'SQL'
create table nvs_jobs (id integer primary key autoincrement, queue varchar(255) not null,
    script text not null, args text, state smallint not null, attempts integer not null,
    max_attempts integer not null, backoff_ms bigint not null, run_at bigint not null,
    tag varchar(255), dedupe_key varchar(255), dedupe_pending varchar(255),
    created_at bigint not null, claimed_at bigint, errors text, grants text, limits text,
    constraint nvs_jobs_dedupe unique (dedupe_pending))
SQL;
var $dead = <<<'SQL'
create table nvs_dead_jobs (id bigint not null, queue varchar(255) not null,
    script text not null, args text, attempts integer not null, max_attempts integer not null,
    backoff_ms bigint not null, run_at bigint not null, tag varchar(255),
    dedupe_key varchar(255), created_at bigint not null, failed_at bigint not null,
    errors text not null, primary key (id))
SQL;
$db->execute($jobs, []);
$db->execute($dead, []);

echo "empty: ", Queue::stats("q")->attempts(), "\n";

// One row in each of the four states a row in `nvs_jobs` can be in, and one on another queue.
int $n = 0;
while ($n < 5) {
    Queue::push("jobs/a.nvs", {queue: $n < 4 ? "q" : "other"});
    $n = $n + 1;
}
echo "pushed: ", Queue::stats("q")->attempts(), "\n";
$db->execute("update nvs_jobs set state = 0, attempts = 1 where id = 1", []);
$db->execute("update nvs_jobs set state = 1, attempts = 2 where id = 2", []);
$db->execute("update nvs_jobs set state = 2, attempts = 4 where id = 3", []);
$db->execute("update nvs_jobs set state = 4, attempts = 8 where id = 4", []);
$db->execute("update nvs_jobs set attempts = 100 where id = 5", []);
$db->execute(<<<'SQL'
insert into nvs_dead_jobs (id, queue, script, attempts, max_attempts, backoff_ms,
    run_at, created_at, failed_at, errors)
values (90, 'q', 'jobs/a.nvs', 1000, 5, 1000, 0, 0, 0, '[]')
SQL, []);

var $stats = Queue::stats("q");
echo "every state: ", $stats->attempts(), "\n";
echo "other: ", Queue::stats("other")->attempts(), "\n";
echo "dead: ", $stats->deadAttempts(), "\n";

// The result is read once, so a later write does not change it.
$db->execute("update nvs_jobs set attempts = 0", []);
echo "kept: ", $stats->attempts(), "\n";
echo "read again: ", Queue::stats("q")->attempts(), "\n";
--FILE nvs.toml--
[capabilities.db]
connect = ["jobs"]

[db.jobs]
driver = "sqlite"
path = ":memory:"

[queue]
connection = "jobs"
workers = 0
--EXPECT--
empty: 0
pushed: 0
every state: 15
other: 100
dead: 1000
kept: 15
read again: 0
