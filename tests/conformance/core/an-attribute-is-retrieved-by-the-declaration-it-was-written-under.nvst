--TEST--
`Core\Attributes::get<T>`/`all<T>` answer the payloads written under the declaration `T` names, on a class, a property, a method and a parameter, folded at the call site (`rule:attributes/a-retrieval-matches-the-declaration-it-names` and `rule:attributes/retrieval-folds-while-checking`)
--FILE--
<?nvs
// covers: Core\Attributes::get
// `rule:attributes/a-retrieval-matches-the-declaration-it-names`: retrieval is by declaration, never by
// shape. `Column` and `Alias` have the same field, and each retrieval answers only its own payloads.
attribute Route on class, method { path: string }
attribute Audit on class { audit: bool }
repeatable attribute Column on property { column: string, unique?: bool }
attribute Alias on property { column: string }
attribute Inject on parameter { inject: string }
attribute Unused on class { nosuch: string }

#[Route(path: "/users")]
#[Audit(audit: true)]
class Controller {
    // `rule:attributes/a-retrieval-matches-the-declaration-it-names`: a property is named by its class's
    // `constructor` reference plus a literal member name.
    #[Column(column: "name", unique: true)]
    #[Alias(column: "full_name")]
    public string $name = "";

    #[Column(column: "age")]
    #[Column(column: "years")]
    public int $age = 0;

    // A method is named by its own method reference, and a
    // parameter by that reference plus a literal member name.
    #[Route(path: "/show")]
    public static function show(#[Inject(inject: "repo")] int $id): int {
        return $id;
    }
}

var $route = Core\Attributes::get<Route>(Controller::constructor);
if ($route != null) { echo "class route=", $route->path, "\n"; }

var $audit = Core\Attributes::get<Audit>(Controller::constructor);
if ($audit != null) { echo "class audit=", $audit->audit as string, "\n"; }

// `Alias` has the same field as `Column`, and it is not an answer for `Column`.
var $column = Core\Attributes::get<Column>(Controller::constructor, "name");
if ($column != null) { echo "name column=", $column->column, "\n"; }
var $alias = Core\Attributes::get<Alias>(Controller::constructor, "name");
if ($alias != null) { echo "name alias=", $alias->column, "\n"; }

// `rule:attributes/retrieval-folds-while-checking`: nothing is written under `Unused`, so the call
// *is* a compiled-in `null`.
var $absent = Core\Attributes::get<Unused>(Controller::constructor);
echo "absent=", $absent != null ? "some" : "none", "\n";

// The fold's other end: two payloads are `all<T>`'s answer, in the order they are written.
var $both = Core\Attributes::all<Column>(Controller::constructor, "age");
echo "age columns=", Core\Arr::count($both) as string, "\n";
foreach ($both as var $one) { echo "  ", $one->column, "\n"; }

// A declaration nothing is written under answers the empty array.
var $empty = Core\Attributes::all<Unused>(Controller::constructor);
echo "empty=", Core\Arr::count($empty) as string, "\n";

// `rule:attributes/a-retrieval-matches-the-declaration-it-names`'s method and parameter forms.
var $method = Core\Attributes::get<Route>(Controller::show);
if ($method != null) { echo "method route=", $method->path, "\n"; }

// A member name is the *parameter's* name and never a word out of the payload:
// `"repo"` here would be `E0798`, which
// `reject/an-attribute-retrieval-is-refused-where-it-cannot-be-folded.nvst`
// pins.
var $named = Core\Attributes::get<Inject>(Controller::show, "id");
if ($named != null) { echo "param inject=", $named->inject, "\n"; }

// `rule:attributes/a-retrieval-matches-the-declaration-it-names`: a computed member name resolves
// nothing, and that is an empty result rather than a diagnostic.
string $computed = "i" . "d";
var $dynamic = Core\Attributes::get<Inject>(Controller::show, $computed);
echo "computed=", $dynamic != null ? "some" : "none", "\n";

// A retrieved payload is the same value a hand-written literal of the declaration's
// fields is, field for field: the fold replaces the call with the payload itself.
type Path = {path: string};
Path $written = {path: "/users"};
uint $agreed = 0;
// A `!= null` narrows the binding inside the `if` body and nowhere else, so
// each comparison is its own nested test rather than an `&&`.
if ($route != null) { if ($route->path == $written->path) { $agreed = $agreed + 1; } }
if ($method != null) { if ($method->path == "/show") { $agreed = $agreed + 1; } }
if ($column != null) { if ($column->column == "name") { $agreed = $agreed + 1; } }
if ($named != null) { if ($named->inject == "repo") { $agreed = $agreed + 1; } }
echo "agreed=", $agreed as string, "/4\n";
--EXPECT--
class route=/users
class audit=1
name column=name
name alias=full_name
absent=none
age columns=2
  age
  years
empty=0
method route=/show
param inject=repo
computed=none
agreed=4/4
