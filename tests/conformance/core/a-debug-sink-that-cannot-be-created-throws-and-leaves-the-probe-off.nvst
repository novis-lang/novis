--TEST--
`Core\Debug::startTrace` and `startProfile` throw a `RuntimeError` naming the file when it cannot be created, the probe stays off so the next start succeeds, and a stop with nothing running does nothing — `rule:testing/debug-surface`
--FILE--
<?nvs
// covers: Core\Debug::startTrace
// covers: Core\Debug::startProfile
// covers: Core\Debug::stopTrace
// covers: Core\Debug::stopProfile
// covers: Core\Debug::stopCoverage
//
// `./out/missing` is inside both grants and does not exist, so creating a file
// there fails. A start that left its probe on would make the second start throw
// "one at a time".
class Here {
    public static function path(#[Core\Path] string $path): string {
        return $path;
    }
}

// Nothing is running yet, so each stop does nothing and throws nothing.
Core\Debug::stopTrace();
Core\Debug::stopProfile();
Core\Debug::stopCoverage();
echo "three stops with nothing running\n";

try {
    Core\Debug::startTrace(Here::path('./out/missing/calls.jsonl'));
    echo "trace started\n";
} catch (RuntimeError $error) {
    echo $error->message, "\n";
}
try {
    Core\Debug::startProfile(Here::path('./out/missing/profile.json'));
    echo "profile started\n";
} catch (RuntimeError $error) {
    echo $error->message, "\n";
}

Core\Debug::startTrace(Here::path('./out/calls.jsonl'));
Core\Debug::stopTrace();
Core\Debug::startProfile(Here::path('./out/profile.json'));
Core\Debug::stopProfile();
echo Core\IO::exists('./out/calls.jsonl') ? "trace file written\n" : "no trace file\n";
echo Core\IO::exists('./out/profile.json') ? "profile file written\n" : "no profile file\n";
--FILE nvs.toml--
[debug]
mode = ["trace", "profile", "coverage"]

[capabilities.debug]
trace = ["./out"]
profile = ["./out"]

[capabilities.fs]
read = ["./out"]
--FILE out/note.txt--
note
--EXPECTF--
three stops with nothing running
Core\Debug::startTrace cannot create `%s%emissing%ecalls.jsonl`: %s.
Core\Debug::startProfile cannot create `%s%emissing%eprofile.json`: %s.
trace file written
profile file written
