--TEST--
`Core\Reflect\EnumInfo` reports a `uint` backing and an omitted one alike, reads a case whose value was counted on rather than written, and throws `LogicError` for a case the enum does not declare (`rule:enums/one-backing-type`, `rule:enums/reflection`)
--FILE--
<?nvs
// `rule:enums/one-backing-type`: exactly one backing per enum, `int` unless
// `: uint` is written, and no unbacked form for `isUnsigned` to have a third
// answer about.
enum Flags: uint {
    None = 0,
    All = 3,
}

enum Plain {
    First,
    Second,
    Third,
}

?Core\Reflect\EnumInfo $u = Core\Reflect\EnumInfo::of(Flags::class);
?Core\Reflect\EnumInfo $p = Core\Reflect\EnumInfo::of(Plain::class);
if ($u != null) {
    Core\Reflect\EnumInfo $flags = $u;
    echo $flags->isUnsigned() ? "uint" : "int", "\n";
    echo $flags->valueOf("All"), "\n";
}

if ($p != null) {
    Core\Reflect\EnumInfo $plain = $p;
    // A declaration with no `: Type` clause is `int`, so the bit is `false`
    // here for the same reason it is on a written `: int`.
    echo $plain->isUnsigned() ? "uint" : "int", "\n";

    // A counted-on value is a constant like any other: nothing below the
    // declaration can tell it from a written one, and the description reports
    // it.
    echo $plain->valueOf("First"), "\n";
    echo $plain->valueOf("Third"), "\n";

    // An unknown name is a mistake in the asking, not an absence: `cases` is
    // the list that cannot be wrong.
    try {
        echo $plain->valueOf("Fourth"), "\n";
    } catch (LogicError $err) {
        echo $err->message, "\n";
    }
}
--EXPECT--
uint
3
int
0
2
enum `Plain` declares no case `Fourth`
