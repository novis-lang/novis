--TEST--
`id`, `publicKey`, `algorithm` and `signCount` of a `Core\Passkey\Credential` return the four values `of` was given, unchanged and plain, at both ends of each range and for both algorithms, and the four values build an equal credential again — `rule:core-classes/passkey-verifies-a-webauthn-ceremony`
--FILE--
<?nvs
// covers: Core\Passkey\Credential::id
// covers: Core\Passkey\Credential::publicKey
// covers: Core\Passkey\Credential::algorithm
// covers: Core\Passkey\Credential::signCount
final class Show {
    public static function of(Core\Passkey\Credential $c): string {
        string $name = match ($c->algorithm()) {
            Core\Passkey\Credential::Algorithm::ES256 => "ES256",
            Core\Passkey\Credential::Algorithm::Ed25519 => "Ed25519",
        };
        return Core\Bytes::length($c->id()) . " id bytes, " . Core\Bytes::length($c->publicKey()) . " key bytes, "
            . $name . " (" . (($c->algorithm() as int) as string) . "), count " . $c->signCount();
    }
}

bytes $raw = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256)->publicKey()->write(Core\Crypto\PublicKey::Format::Raw);
bytes $es256 = Core\Bytes::join([
    Core\Encoding::fromHex("a5010203262001215820"),
    Core\Bytes::slice($raw, 1, 32),
    Core\Encoding::fromHex("225820"),
    Core\Bytes::slice($raw, 33, 32),
]);
bytes $ed25519 = Core\Encoding::fromHex("a4010103272006215820fcce9008a33565248561295a7ce1cccb040b6129bba8ff24744953bbc01261ac");
bytes $short = Core\Encoding::fromHex("00");
bytes $long = Core\Bytes::fill(1023, 255);

Core\Passkey\Credential $a = Core\Passkey\Credential::of($short, $es256, Core\Passkey\Credential::Algorithm::ES256, 0);
Core\Passkey\Credential $b = Core\Passkey\Credential::of($long, $ed25519, Core\Passkey\Credential::Algorithm::Ed25519, 4294967295);
echo Show::of($a), "\n";
echo Show::of($b), "\n";

// Each reader returns the bytes and the number it was given, and a plain type takes each result.
bytes $id = $b->id();
bytes $key = $b->publicKey();
Core\Passkey\Credential::Algorithm $algorithm = $b->algorithm();
int $count = $b->signCount();
echo $id == $long ? "id unchanged" : "id changed", "\n";
echo $key == $ed25519 ? "key unchanged" : "key changed", "\n";
echo Core\Encoding::toHex($a->id()), " ", $a->publicKey() == $es256 ? "key unchanged" : "key changed", "\n";

// The four values build the same credential again, and the readers of each agree.
Core\Passkey\Credential $again = Core\Passkey\Credential::of($id, $key, $algorithm, $count);
echo Show::of($again), "\n";
echo $again->id() == $b->id() && $again->publicKey() == $b->publicKey() && $again->algorithm() == $b->algorithm() && $again->signCount() == $b->signCount() ? "equal" : "different", "\n";

// The algorithm is saved as its integer and read back as the same case.
echo ($a->algorithm() as int) as Core\Passkey\Credential::Algorithm == Core\Passkey\Credential::Algorithm::ES256 ? "ES256 round-trips" : "lost", "\n";
--EXPECT--
1 id bytes, 77 key bytes, ES256 (0), count 0
1023 id bytes, 42 key bytes, Ed25519 (1), count 4294967295
id unchanged
key unchanged
00 key unchanged
1023 id bytes, 42 key bytes, Ed25519 (1), count 4294967295
equal
ES256 round-trips
