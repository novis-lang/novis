--TEST--
`Core\BigInt::shr` divides by a power of two and rounds toward negative infinity, which is where it parts from `div`, and past a receiver's own width the two signs end differently — `rule:types/arithmetic`, spec § 13
--FILE--
<?nvs
// covers: Core\BigInt::shr
// A shift right is a division by a power of two, and the rounding is the whole
// question: `div` cuts toward zero and `shr` rounds down. The two agree on
// every non-negative receiver and wherever the division is exact, and `shr` is
// one lower everywhere else. Counted over the sweep rather than read off a
// row, so a member that rounded toward zero on one sign still fails here.
array<int> $values = [0, 1, 7, 8, 255, -1, -7, -8, -255];
array<uint> $places = [0, 1, 3, 8];
uint $rows = 0;
uint $agreed = 0;
uint $lower = 0;
foreach ($values as int $value) {
    foreach ($places as uint $by) {
        var $shifted = Core\BigInt::of($value)->shr($by);
        var $divided = Core\BigInt::of($value)->div(Core\BigInt::of(1)->shl($by));
        int $order = $shifted->compareTo($divided);
        if ($order == 0) {
            $agreed = $agreed + (1 as uint);
        } elseif ($order < 0 && $divided->sub($shifted)->toInt() == 1) {
            $lower = $lower + (1 as uint);
        }
        $rows = $rows + (1 as uint);
    }
}
echo "rows ", $rows, " agreed ", $agreed, " lower ", $lower, "\n";

// Shifting left and back again is the value it started from, on every row, so
// the rounding above is the only place a bit is dropped.
uint $restored = 0;
foreach ($values as int $value) {
    foreach ($places as uint $by) {
        if (Core\BigInt::of($value)->shl($by)->shr($by)->compareTo(Core\BigInt::of($value)) == 0) {
            $restored = $restored + (1 as uint);
        }
    }
}
echo "restored ", $restored, "\n";

// Past the receiver's own width the two signs part: a positive value falls to
// 0 and a negative one to -1, because rounding down never reaches zero from
// below.
echo "far ", Core\BigInt::of(255)->shr(9223372036854775807)->toInt(), " ", Core\BigInt::of(-255)->shr(9223372036854775807)->toInt(), "\n";

// Three of the rows the counts are built from, named on their own so a count
// that happened to be right is not the whole assertion.
echo "row ", Core\BigInt::of(7)->shr(1)->toInt(), " ", Core\BigInt::of(-7)->shr(1)->toInt(), " ", Core\BigInt::of(-8)->shr(3)->toInt(), "\n";
--EXPECT--
rows 36 agreed 26 lower 10
restored 36
far 0 -1
row 3 -4 -1
