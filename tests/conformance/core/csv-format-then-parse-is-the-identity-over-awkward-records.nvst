--TEST--
`Core\Csv::format` then `Core\Csv::parse` is the identity over a table of awkward records, and the one record it is not — spec § 12's second table
--FILE--
<?mwl
// The writer's rule is "quote a field exactly where a byte in it would
// otherwise change the parse" (`crates/mwl-stdlib/src/csv.rs`'s module doc), so
// the claim that rule exists to buy is a round-trip invariant rather than any
// one rendering: whatever bytes a field holds, reading back what the writer
// emitted answers those same bytes. A table asserts that by *counting* — a
// writer that quotes plausibly record by record still fails here — and it holds
// every byte the dialect is written in, plus the ones a naive writer forgets.
array<array<string>> $table = [
    [",", "\"", "plain"],
    ["", "  sp  ", "a\nb"],
    ["a\r\nb", "x\"y", ",,,"],
    ["\"\"", "\n", "  "],
];

var $doc = Core\Csv::format($table);
var $back = Core\Csv::parse($doc);

// Every field of every record, compared against the field it was written from.
// The widths are counted separately: a reader that dropped a trailing empty
// field would still agree on every field it did answer.
int $i = 0;
int $fields = 0;
int $agree = 0;
int $widths = 0;
for (; $i < 4; $i = $i + 1) {
    var $want = $table[$i as string];
    var $got = $back[$i as string];
    if (Core\Arr::count($got) == Core\Arr::count($want)) {
        $widths = $widths + 1;
    }
    int $j = 0;
    for (; $j < 3; $j = $j + 1) {
        $fields = $fields + 1;
        if ($got[$j as string] == $want[$j as string]) {
            $agree = $agree + 1;
        }
    }
}
echo "records=", Core\Arr::count($back), " widths=", $widths, "\n";
echo "fields=", $fields, " agree=", $agree, "\n";

// The same invariant one level up: because reading is the inverse of writing,
// the document is a fixed point of writing what was read from it. This is what
// separates a round trip from a reader that merely happens to undo one
// encoding — a writer choosing a different quoting on the second pass would
// still satisfy the field comparison above.
var $twice = Core\Csv::format($back);
echo "fixedpoint=", $twice == $doc ? "yes" : "no", "\n";

// The one record the identity does not hold for, named rather than hidden by
// the sweep: a record of a single empty field is written as an empty line, and
// a blank line is not a record (`csv-keys-a-ragged-record-by-what-it-has.mwlt`
// pins that reading). So this one table comes back shorter than it went out.
// Every wider all-empty record survives, because the separators are still
// there to count — the loss needs a record of exactly one empty field.
var $lone = Core\Csv::format([[""]]);
var $pair = Core\Csv::format([["", ""]]);
echo "lone=", Core\Arr::count(Core\Csv::parse($lone)), " pair=", Core\Arr::count(Core\Csv::parse($pair)), "\n";
echo "pairwidth=", Core\Arr::count(Core\Csv::parse($pair)["0"]), "\n";
--EXPECT--
records=4 widths=4
fields=12 agree=12
fixedpoint=yes
lone=0 pair=1
pairwidth=2
