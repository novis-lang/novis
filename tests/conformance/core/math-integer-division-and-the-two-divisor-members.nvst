--TEST--
Core\Math::quotient, mod, gcd and lcm, and the zero divisor each of the first two throws on
--FILE--
<?nvs
// Four answers read off a line. That the quotient and the remainder reconstruct
// the dividend, and that gcd times lcm is the product's magnitude, are swept in
// math-the-division-identity-and-the-gcd-lcm-identity-hold-on-every-row-that-has-one.nvst.

// Truncated toward zero, so a negative quotient is not `floor`'s.
echo Core\Math::quotient(17, 5), "|", Core\Math::quotient(-17, 5), "\n";
// Integer modulo is the `%` operator, so this member is the `float` case only,
// and the remainder carries the sign of the dividend.
echo Core\Math::remainder(7.5, 2.0), "|", Core\Math::remainder(-7.5, 2.0), "\n";

echo Core\Math::gcd(84, 36), "|", Core\Math::gcd(-84, 36), "|", Core\Math::gcd(0, 0), "\n";
echo Core\Math::lcm(4, 6), "|", Core\Math::lcm(4, 0), "\n";

// A division by zero throws, which is why `divide`'s silent INF and
// `fmod`'s silent NAN have no equivalent.
try {
    echo Core\Math::quotient(1, 0), "\n";
} catch (Throwable $e) {
    echo "intDiv: ", $e->message, "\n";
}
try {
    echo Core\Math::remainder(1.0, 0.0), "\n";
} catch (Throwable $e) {
    echo "mod: ", $e->message, "\n";
}
// `int`'s smallest value over -1 is one past the largest.
try {
    echo Core\Math::quotient(-9223372036854775807 - 1, -1), "\n";
} catch (Throwable $e) {
    echo "overflow: ", $e->message, "\n";
}
--EXPECT--
3|-3
1.5|-1.5
12|12|0
12|0
intDiv: Core\Math::quotient was given a zero divisor
mod: Core\Math::remainder was given a zero divisor
overflow: Core\Math::quotient's answer does not fit an `int`
