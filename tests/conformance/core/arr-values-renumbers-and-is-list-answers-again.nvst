--TEST--
`Core\Arr::values` renumbers a map into a list from `0`, and does it again after a key is unset — ADR 0063
--FILE--
<?mwl
array<string> $a = ["x" => "one", "y" => "two", "z" => "three"];
echo Core\Arr::isList($a), "\n";
var $v = Core\Arr::values($a);
echo Core\Arr::isList($v), ";", Core\Arr::count($v), "\n";
string $s = "";
foreach ($v as string $k => string $e) {
    $s = $s . $k . ":" . $e . " ";
}
echo $s, "\n";
unset($a["y"]);
var $v2 = Core\Arr::values($a);
echo Core\Arr::count($v2), ";", $v2[1], "\n";
--EXPECT--

1;3
0:one 1:two 2:three
2;three
