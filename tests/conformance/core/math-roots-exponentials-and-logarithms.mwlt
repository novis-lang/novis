--TEST--
Core\Math::sqrt, cbrt, hypot, exp and log answer IEEE's value for a domain error, which isNan and isFinite then ask about
--FILE--
<?mwl
// `hypot` against the naive `sqrt($x * $x + $y * $y)`, over a table and at both
// ends of the exponent range, is
// math-hypot-agrees-with-the-naive-form-until-the-naive-form-overflows.mwlt.
// What a round trip through `sqrt`, `cbrt`, `exp` and `log` costs, over a
// table and on the rows where the intermediate is irrational, is
// math-a-root-and-a-logarithm-undo-themselves-only-where-the-answer-is-exact.mwlt.
echo Core\Math::sqrt(2.25), "|", Core\Math::cbrt(-8.0), "|", Core\Math::hypot(3.0, 4.0), "\n";
echo Core\Math::exp(0.0), "|", Core\Math::exp(1.0), "\n";

// One member for PHP's three: the default base is `e`, and 10 and 2 take
// f64's own routines so they answer exactly rather than as a ratio of logs.
echo Core\Math::log(1.0), "|", Core\Math::log(100.0, {base: 10.0}), "|",
     Core\Math::log(8.0, {base: 2.0}), "\n";

// A domain error is IEEE's answer and not a throw — which is what leaves
// `isNan` and `isFinite` something to answer about.
echo Core\Math::isNan(Core\Math::sqrt(-1.0)) as string, "|",
     Core\Math::isNan(1.0) as string, "|\n";
echo Core\Math::isFinite(1.0) as string, "|",
     Core\Math::isFinite(Core\Math::log(0.0)) as string, "|\n";
--EXPECT--
1.5|-2|5
1|2.718281828459
0|2|3
1||
1||
