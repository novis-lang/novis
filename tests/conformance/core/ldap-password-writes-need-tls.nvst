--TEST--
`setPassword` and `changePassword` on a connection without TLS throw `Core\Ldap\LdapError` with the kind `EncryptionRequired` and a `null` code before anything is sent, even where the cleartext grant allows the bind
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("plain");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
// The `plain` block logs in without TLS. Only a test server on this machine
// may be reached that way. The copied `ca.crt` is for the `corp` block.
var $plain = Core\Ldap::connect("plain");
var $staff = "CN=Staff,OU=Staff,DC=example,DC=test";

try {
    $plain->setPassword($staff, "Staff-first-Pass-7");
    echo "setPassword: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "setPassword: ", $refused->kind == Core\Ldap\LdapError::Kind::EncryptionRequired ? "EncryptionRequired" : "other", "\n";
    echo "code: ", $refused->code ?? "null", "\n";
}

try {
    $plain->changePassword($staff, "Staff-first-Pass-7", "Staff-second-Pass-8");
    echo "changePassword: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "changePassword: ", $refused->kind == Core\Ldap\LdapError::Kind::EncryptionRequired ? "EncryptionRequired" : "other", "\n";
}

// The same connection still works for other requests.
echo "whoami: ", $plain->whoami(), "\n";
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["plain"]
cleartext = ["127.0.0.1"]

[ldap.plain]
url = "ldap://127.0.0.1:16389"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls = "none"
--EXPECT--
setPassword: EncryptionRequired
code: null
changePassword: EncryptionRequired
whoami: u:EXAMPLE\Administrator
