--TEST--
`Core\Env::secret` answers a `secret string` that an outbound header, form field and JSON body accept with no launderer — `rule:security/secret-has-no-ambient-source`, `rule:security/secret-sinks-refuse`
--ENV--
NVS_CASE_API_KEY=s3cr3t-token
--FILE--
<?nvs
// `Core\Env::get` answers `tainted`, and an outbound header refuses `tainted`.
// `secret` answers the same variable as a `secret string`, which the three
// positions a credential belongs in take as it is. The program never prints
// the value: what is printed is the record of what left it
// (`rule:testing/an-outbound-call-is-answered-from-a-table`).
Core\Test::answerHttp("https://api.example.com/*", 200, {body: "ok"});

secret string $key = Core\Env::secret("NVS_CASE_API_KEY") ?? "";

var $bearer = Core\Http\Client::get("https://api.example.com/me", {headers: ["authorization" => "Bearer " . $key]});
var $exchange = Core\Http\Client::post("https://api.example.com/token", {form: ["client_secret" => $key]});
var $session = Core\Http\Client::post("https://api.example.com/session", {json: ["token" => $key]});

foreach (Core\Test::sentHttp() as Core\Test\SentRequest $call) {
    echo $call->url(), " ", $call->header("authorization") ?? "-", " ", ($call->body() as string), "\n";
}
--EXPECT--
https://api.example.com/me Bearer s3cr3t-token
https://api.example.com/token - client_secret=s3cr3t-token
https://api.example.com/session - {"token":"s3cr3t-token"}
