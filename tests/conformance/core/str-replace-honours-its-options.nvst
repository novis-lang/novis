--TEST--
Core\Str::replace takes `{caseInsensitive}` and `{limit}` in one options bag — ADR 0063 R2
--FILE--
<?nvs
echo Core\Str::replace("aAaA", "a", "-"), "\n";
echo Core\Str::replace("aAaA", "a", "-", {caseInsensitive: true}), "\n";
echo Core\Str::replace("aAaA", "a", "-", {caseInsensitive: true, limit: 2}), "\n";
echo Core\Str::replace("aaaa", "a", "-", {limit: 1}), "\n";
echo Core\Str::replace("banana", "na", "NA"), "\n";
echo Core\Str::replace("banana", "z", "-"), "\n";
--EXPECT--
-A-A
----
--aA
-aaa
baNANA
banana
