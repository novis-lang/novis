--TEST--
Core\Arr::sort over `array<string>` orders lexicographically, reverses under `{order}`, and reorders by a `{by}` projection
--FILE--
<?nvs
class Render {
    public static function of(array<string> $a): string {
        var $out = "";
        foreach ($a as string $k => string $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<string> $names = ["pear", "apple", "fig"];

echo Render::of(Core\Arr::sort($names)), "\n";
echo Render::of(Core\Arr::sort($names, {order: Core\Order::Desc})), "\n";
echo Render::of(Core\Arr::sort($names, {by: fn(string $s): uint => Core\Str::length($s)})), "\n";
echo Render::of(Core\Arr::sort($names, {by: fn(string $s): uint => Core\Str::length($s), order: Core\Order::Desc})), "\n";
echo Render::of($names), "\n";

array<string> $one = ["only"];
array<string> $none = [];
echo Render::of(Core\Arr::sort($one)), "|", Render::of(Core\Arr::sort($none)), "|\n";
--EXPECT--
0=apple;1=fig;2=pear;
0=pear;1=fig;2=apple;
0=fig;1=pear;2=apple;
0=apple;1=pear;2=fig;
0=pear;1=apple;2=fig;
0=only;||
