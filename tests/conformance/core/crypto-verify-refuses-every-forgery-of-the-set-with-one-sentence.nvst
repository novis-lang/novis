--TEST--
Core\Crypto::verify refuses every signature of the frozen set's refusal half — a flipped octet, another key's signature, an edited message, an ES256 signature in DER, one an octet short, an empty one, and a PKCS#1 signature under a PSS key — each with the same RuntimeError sentence, counted — `rule:security/verification-throws-and-compares-in-constant-time`
--FILE--
<?nvs
// The refusal half of the frozen set: each signature is wrong in its own way
// and every key is the right one. Counted as a set rather than asked a line at
// a time, because the claim is that all of them say the *same* sentence — a
// member that named which part was wrong would still look right on each line
// on its own, and would be an oracle over the part.
array<string> $pkcs8 = [
    "",
    "",
    "3041020100301306072a8648ce3d020106082a8648ce3d03010704273025020101042033172cfd4cb8e906b35b1dd8753ac6b12b8c760281d124bf635dbf5c5f15c49a",
    "302e020100300506032b65700422042036e7913c75ff5d89ba4f46526320f547cf75369a560a168f6ab5bb178fbeaadf",
];
array<Core\Crypto\KeyKind> $kinds = [
    Core\Crypto\KeyKind::RsaPkcs1,
    Core\Crypto\KeyKind::RsaPss,
    Core\Crypto\KeyKind::P256,
    Core\Crypto\KeyKind::Ed25519,
];

array<int> $signer = [0, 0, 3, 2, 2, 3, 1];
array<string> $messages = [
    "61206d65737361676520612070656572207369676e6564",
    "61206d65737361676520612070656572207369676e6564",
    "61206d65737361676520612070656572207369676e6544",
    "61206d65737361676520612070656572207369676e6564",
    "61206d65737361676520612070656572207369676e6564",
    "61206d65737361676520612070656572207369676e6564",
    "61206d65737361676520612070656572207369676e6564",
];
array<string> $offered = [
    "",
    "",
    "27a38debdc5fd557f8f617709b7dbf3f2fb07ed5203daa3386739b7a14600b9dd0d241f9419748a0e218857f104740f980ffb4e731d55b88660725461b677301",
    "3046022100b065d364c1f41b7e7b580d1bcc0061b297884c13cbba68ab33724f218eeabb7f022100ab89f4df12c4eb750aeb96a9afc6cee60569b4d1292948d7e1203d74b66ae98b",
    "b065d364c1f41b7e7b580d1bcc0061b297884c13cbba68ab33724f218eeabb7fab89f4df12c4eb750aeb96a9afc6cee60569b4d1292948d7e1203d74b66ae9",
    "",
    "",
];

int $refused = 0;
array<string> $said = [];
foreach (Core\Arr::range(0, 6) as int $v) {
    Core\Crypto\KeyPair $pair = Core\Crypto\KeyPair::read(
        Core\Encoding::fromHex($pkcs8[$signer[$v]]),
        $kinds[$signer[$v]]
    );
    bytes $message = Core\Encoding::fromHex($messages[$v]);
    bytes $claimed = Core\Encoding::fromHex($offered[$v]);
    try {
        Core\Crypto::verify($message, $claimed, $pair->publicKey());
        echo "took refusal vector ", $v, "\n";
    } catch (RuntimeError $notThisKeys) {
        $refused += 1;
        $said = Core\Arr::append($said, $notThisKeys->message);
    }
}
echo "refused ", $refused, " of 7", "\n";

int $oneSentence = 0;
foreach ($said as string $sentence) {
    if ($sentence == $said[0]) {
        $oneSentence += 1;
    }
}
echo "one sentence ", $oneSentence, " of ", Core\Arr::count($said), "\n";
echo $said[0], "\n";
--EXPECT--
refused 7 of 7
one sentence 7 of 7
Core\Crypto::verify(): this signature is not $key's over $message — it has been altered, it is not the shape the key's algorithm signs, or it was made under another key.
