--TEST--
Core\Totp::code answers six characters of text for every secret, never an integer whose leading zero was lost, and Core\Totp::check accepts each secret's code against that secret alone — `rule:security/protocol-roster`
--FILE--
<?nvs
// Invariance over a sweep, asserted by counting. One code looks right whatever
// the implementation does with the leading zero, because nine codes in ten do
// not have one; the property is only visible across a set. Twelve secrets is
// enough that a member answering an `int` would be caught most runs, and the
// per-secret binding below is exact every run.
// `crates/nvs-stdlib/src/totp.rs` owns the truncation this rests on.
array<secret bytes> $secrets = [
    Core\Random::bytes(20), Core\Random::bytes(20), Core\Random::bytes(20),
    Core\Random::bytes(20), Core\Random::bytes(20), Core\Random::bytes(20),
    Core\Random::bytes(20), Core\Random::bytes(20), Core\Random::bytes(20),
    Core\Random::bytes(20), Core\Random::bytes(20), Core\Random::bytes(20),
];

// Every code is six characters of decimal text. A member that answered the
// truncated integer would lose a leading zero and print five.
int $shaped = 0;
foreach ($secrets as secret bytes $secret) {
    string $code = Core\Totp::code($secret);
    if (Core\Str::length($code) == 6) {
        if (Core\Regex::matches($code, "^[0-9]{6}$")) {
            $shaped = $shaped + 1;
        }
    }
}
echo "shaped ", $shaped, " of ", Core\Arr::count($secrets), "\n";

// Every secret's code verifies against that secret. This is the half a member
// that ignored the secret entirely would also pass.
int $own = 0;
foreach ($secrets as secret bytes $secret) {
    if (Core\Totp::check(Core\Totp::code($secret), $secret) == null) {
        $own = $own + 0;
    } else {
        $own = $own + 1;
    }
}
echo "own ", $own, " of ", Core\Arr::count($secrets), "\n";

// And the first secret's code verifies against no other secret in the set —
// the half that makes the line above mean something, and the one a member
// deriving its code from the clock alone would fail on every row.
string $first = Core\Totp::code($secrets[0]);
int $crossed = 0;
int $index = 1;
while ($index < Core\Arr::count($secrets)) {
    if (Core\Totp::check($first, $secrets[$index]) == null) {
        $crossed = $crossed + 0;
    } else {
        $crossed = $crossed + 1;
    }
    $index = $index + 1;
}
echo "crossed ", $crossed, "\n";
--EXPECT--
shaped 12 of 12
own 12 of 12
crossed 0
