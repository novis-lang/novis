--TEST--
`Core\Db\Rows::value` answers the first column of the statement's own first row, answers it again because there is no cursor, ignores the class `queryAs` named, and answers `null` for an empty result and for a first column with no value alike — `rule:core-classes/db-statement-members`
--FILE--
<?nvs
// covers: Core\Db\Rows::value
// One table read four ways, so a member answering the column the table declares
// first, or the row the table stores first, fails on one line here rather than on
// every line. The repeat is counted rather than read off a line, because a member
// with a cursor under it answers the first call plausibly. The two absences are
// asserted together beside `count`, which is the exact question this member
// leaves to it.
use Core\Db\Derive;

#[Derive]
class Seating {
    public uint $seats;
    public tainted string $label;

    public function constructor(uint $seats, tainted string $label)
    {
        $this->seats = $seats;
        $this->label = $label;
    }
}

var $db = Core\Db::connect("main");
$db->execute("create table seatings (id integer primary key, seats int not null, label text not null)", []);
$db->execute(
    "insert into seatings (seats, label) values (?, ?), (?, ?), (?, ?)",
    [4, "north", 2, "east", 6, "south"]
);

// The first column is the one the statement selected first, and the first row is
// the one the statement ordered first.
var $labelFirst = $db->query("select label, seats from seatings order by id", []);
var $seatsFirst = $db->query("select seats, label from seatings order by id", []);
var $bySeats = $db->query("select label, seats from seatings order by seats", []);

echo "label first: ", $labelFirst->value() as ?string ?? "", "\n";
echo "seats first: ", $seatsFirst->value() as ?int ?? 0, "\n";
echo "by seats: ", $bySeats->value() as ?string ?? "", "\n";

// There is no cursor to move, so a result asked three times answers the same
// value three times.
uint $same = 0;
uint $i = 0;
while ($i < 3) {
    if (($labelFirst->value() as ?string ?? "") == "north") {
        $same = $same + 1;
    }
    $i = $i + 1;
}
echo "same: ", $same, " of 3\n";

// A column is a value and never an object, so the class `queryAs` named applies
// to the rows and not to this answer.
var $hydrated = $db->queryAs<Seating>("select label, seats from seatings order by label desc", []);
echo "hydrated: ", $hydrated->value() as ?string ?? "", "\n";

// An empty result and a first column with no value are the same `null`. The
// counts are what tell them apart.
$db->execute("create table gaps (id integer primary key, seats int)", []);
$db->execute("insert into gaps (seats) values (?)", [null]);
var $none = $db->query("select seats from gaps where id = ?", [99]);
var $gap = $db->query("select seats from gaps", []);

uint $nulls = 0;
if ($none->value() == null) {
    $nulls = $nulls + 1;
}
if ($gap->value() == null) {
    $nulls = $nulls + 1;
}
echo "nulls: ", $nulls, " of 2, counts ", $none->count(), " and ", $gap->count(), "\n";

$db->close();
--FILE nvs.toml--
# § 3: a SQLite connection's file path comes from its config block, so
# `db.connect` covers it.
[capabilities.db]
connect = ["main"]

[db.main]
driver = "sqlite"
path = ":memory:"
--EXPECT--
label first: north
seats first: 4
by seats: east
same: 3 of 3
hydrated: south
nulls: 2 of 2, counts 0 and 1
