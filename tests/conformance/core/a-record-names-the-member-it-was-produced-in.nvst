--TEST--
A record names the file, line and enclosing member it was produced at, a record produced at file scope names no member at all, and a `Throwable`'s location is that same datum whether a `throw` or a checked operator raised it -- `rule:errors/a-record-names-where-it-was-produced`
--FILE--
<?nvs
// The datum is the *producer's own* call site, not the frame that reached it:
// `Orders::place` writes the first record, so that is the member on it, however
// many calls deep the script was when it got there. One derivation, filled from
// a constant the compiler baked at the call -- never a stack walked at run time,
// which is what the rule declines to buy.
class Orders {
    public static function place(): void {
        Core\Log::write(Core\Log\Level::Info, "placed");
    }
}

Orders::place();

// A statement at file scope has a file and a line and no member to name, so the
// key is omitted rather than written empty -- the envelope's existing rule,
// applied to the one field a call site fills.
Core\Log::write(Core\Log\Level::Info, "done");

// The second reader of that one datum: `$e->location` is the site the `throw`
// was compiled with, handed to the raise as the very constant a producer above
// takes, so the property and an envelope's `source` cannot disagree about where
// something happened.
class Relay {
    public static function thrown(): string {
        try {
            throw new RuntimeError("boom");
        } catch (Throwable $failure) {
            return $failure->location;
        }
    }
}

echo Relay::thrown(), "\n";

// The third reader, and the only one that fills the datum with no Novis
// expression behind it: a checked operator raises inline, and is handed the
// site of the statement it failed in -- the very constant a `throw` in that
// statement would have taken, so whichever of the two raises names the same
// place.
class Checked {
    public static function divided(int $by): string {
        try {
            var $quotient = 10 / $by;
            return "no throw";
        } catch (Throwable $failure) {
            return $failure->location;
        }
    }
}

echo Checked::divided(0), "\n";
--EXPECT--
{"level":"info","msg":"placed","source":{"file":"case.nvs","line":9,"member":"Orders::place"}}
{"level":"info","msg":"done","source":{"file":"case.nvs","line":18}}
case.nvs:27
case.nvs:44
