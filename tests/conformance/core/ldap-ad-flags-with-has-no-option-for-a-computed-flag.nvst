--TEST--
`Ad\AccountFlags::with` has no `lockedOut` option, because Active Directory computes lockout, and an option of `with` does not accept `null` — `rule:core-classes/ldap-value-types`
--FILE--
<?nvs
class Accounts {
    public static function unlock(Core\Ldap\Ad\AccountFlags $flags): Core\Ldap\Ad\AccountFlags {
        return $flags->with({lockedOut: false});
    }

    public static function keep(Core\Ldap\Ad\GroupType $type): Core\Ldap\Ad\GroupType {
        return $type->with({security: null});
    }
}
