--TEST--
Core\Arr::range closes both of its ends and bounds its `step` on both sides — the last entry is inside the range while one step further is outside it, `1` is the smallest step accepted and `0` or less throws, and a cursor that would leave `int` stops rather than wrapping — spec § 2, `rule:types/arithmetic`, `rule:core-api/shape-rules` R2
--FILE--
<?nvs
// `range` is written around one claim: both ends are closed. That is only
// half assertable from the entries themselves -- a member that stopped one
// entry early would still print a plausible list -- so every row below asserts
// it from both directions at once. The last entry has to be *inside* the
// range, and the value one step past it has to be *outside* it; together those
// two say the walk stopped exactly where it had to, and neither says it alone.
//
// A callable cannot be called through the variable holding it (`nvs-ir` gap 1),
// so the row's question is a static method called directly.
class Bound {
    // A row as `count,` then three characters: `s` for the first entry being
    // the start, `e` or `i` for the last entry landing on the end or stopping
    // short of it because the stride does not divide the span, and `o` for one
    // further step being outside the range. A `!` in any position is the
    // invariant broken, and no row is allowed to print one.
    public static function of(int $start, int $end, int $step): string {
        array<int> $r = Core\Arr::range($start, $end, {step: $step});
        int $n = Core\Arr::count($r) as int;
        int $first = $r[0];
        int $last = $r[$n - 1];

        string $out = $n as string;
        if ($first == $start) {
            $out = $out . ",s";
        } else {
            $out = $out . ",!";
        }

        // The direction is the arguments' and not the step's, so which side of
        // `$end` counts as inside is decided here rather than by the sign of
        // anything -- there is no negative step to read it off.
        bool $upward = $start <= $end;
        int $next = $last - $step;
        bool $lastIn = $last >= $end;
        bool $nextOut = $next < $end;
        if ($upward) {
            $next = $last + $step;
            $lastIn = $last <= $end;
            $nextOut = $next > $end;
        }

        if ($lastIn) {
            if ($last == $end) {
                $out = $out . "e";
            } else {
                $out = $out . "i";
            }
        } else {
            $out = $out . "!";
        }
        if ($nextOut) {
            $out = $out . "o";
        } else {
            $out = $out . "!";
        }
        return $out;
    }
}

// Up and down, a stride that divides the span and one that does not, a step
// bigger than the whole span, and the one-point range that is the smallest a
// closed-closed bound can describe -- once with a step it never uses.
array<array<int>> $rows = [
    [1, 5, 1],
    [1, 10, 3],
    [1, 10, 4],
    [1, 5, 10],
    [5, 1, 1],
    [5, 1, 2],
    [10, 1, 4],
    [3, 3, 1],
    [3, 3, 7],
    [-3, 2, 1],
    [0, 10, 5],
    [1, 2, 1],
    [2, 1, 1],
];

int $held = 0;
foreach ($rows as array<int> $row) {
    string $v = Bound::of($row[0], $row[1], $row[2]);
    echo $row[0] as string, "..", $row[1] as string, "/", $row[2] as string, " ", $v, "\n";
    bool $broke = Core\Str::contains($v, "!");
    if ($broke == false) {
        $held = $held + 1;
    }
}
echo $held as string, "/", Core\Arr::count($rows) as string, "\n";

// The step's own bound, both sides. `1` is the smallest stride that advances,
// and it is one entry per integer in the span; `0` would never advance at all
// and a negative one would walk away from the end forever, so both throw
// rather than answering an empty array or looping -- and they throw with the
// step they were handed, so a caller's arithmetic bug names itself.
echo Core\Arr::count(Core\Arr::range(1, 3, {step: 1})) as string, "\n";
try {
    array<int> $none = Core\Arr::range(1, 3, {step: 0});
    echo "unreachable\n";
} catch (RuntimeError $zero) {
    echo "[", $zero->message, "]\n";
}
try {
    array<int> $back = Core\Arr::range(1, 3, {step: -1});
    echo "unreachable\n";
} catch (RuntimeError $negative) {
    echo "[", $negative->message, "]\n";
}

// `rule:types/arithmetic`'s overflow rule, inside a loop this member owns rather than in
// arithmetic a program wrote: the cursor advances by a checked add, so a range
// whose next step would leave `int` stops at the last value that fits. The
// closed end is reachable at `int`'s own maximum, and a stride that would
// carry the cursor past it ends the walk instead of wrapping to the bottom.
array<int> $top = Core\Arr::range(9223372036854775806, 9223372036854775807);
echo Core\Arr::count($top) as string, ",", $top[1] as string, "\n";
array<int> $over = Core\Arr::range(9223372036854775806, 9223372036854775807, {step: 2});
echo Core\Arr::count($over) as string, ",", $over[0] as string, "\n";
--EXPECT--
1..5/1 5,seo
1..10/3 4,seo
1..10/4 3,sio
1..5/10 1,sio
5..1/1 5,seo
5..1/2 3,seo
10..1/4 3,sio
3..3/1 1,seo
3..3/7 1,seo
-3..2/1 6,seo
0..10/5 3,seo
1..2/1 2,seo
2..1/1 2,seo
13/13
3
[Core\Arr::range(): the `step` option must be greater than 0, got 0]
[Core\Arr::range(): the `step` option must be greater than 0, got -1]
2,9223372036854775807
1,9223372036854775806
