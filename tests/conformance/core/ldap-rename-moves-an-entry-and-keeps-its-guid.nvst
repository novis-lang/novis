--TEST--
`rename` gives an entry a new name in place, then moves it under another parent with a `Dn`, and the entry keeps its GUID through both
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
// covers: Core\Ldap\Connection::rename
var $corp = Core\Ldap::connect("corp");
string $first = "OU=Atlas Two,DC=example,DC=test";
string $second = "OU=Harbor Two,DC=example,DC=test";
array<string> $leftovers = ["OU=Desk," . $first, "OU=Counter," . $first, "OU=Counter," . $second, $first, $second];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $gone) {
    }
}
$corp->add($first, ["objectClass" => "organizationalUnit"]);
$corp->add($second, ["objectClass" => "organizationalUnit"]);
$corp->add("OU=Desk," . $first, ["objectClass" => "organizationalUnit"]);
string $guid = $corp->read("OU=Desk," . $first, {select: ["objectGUID"]})?->uuid("objectGUID")?->toString() ?? "";

$corp->rename("OU=Desk," . $first, "OU=Counter," . $first);
echo "old name: ", $corp->read("OU=Desk," . $first) == null ? "gone" : "still there", "\n";

$corp->rename(Core\Ldap\Dn::parse("OU=Counter," . $first), Core\Ldap\Dn::parse("OU=Counter," . $second));
var $moved = $corp->read("OU=Counter," . $second, {select: ["ou", "objectGUID"]});
echo "moved: ", $moved?->string("ou") ?? "missing", "\n";
echo "same GUID: ", ($moved?->uuid("objectGUID")?->toString() ?? "none") == $guid ? "yes" : "no", "\n";

try {
    $corp->rename("OU=Counter," . $second, "Counter");
} catch (LogicError $notADn) {
    echo "LogicError\n";
}
try {
    $corp->rename("OU=Nowhere," . $second, "OU=Elsewhere," . $second);
} catch (Core\Ldap\LdapError $missing) {
    echo $missing->kind == Core\Ldap\LdapError::Kind::NoSuchObject ? "NoSuchObject" : "other", "\n";
}

$corp->delete("OU=Counter," . $second);
$corp->delete($first);
$corp->delete($second);
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://127.0.0.1:16636"
base = "DC=example,DC=test"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
old name: gone
moved: Counter
same GUID: yes
LogicError
NoSuchObject
