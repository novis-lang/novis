--TEST--
Each `Core\Passkey` member that saves or takes a challenge throws a `RuntimeError` naming `Core\Session::start()` before the session is started, `credentialId` needs no session, and a credential built with `of` returns its four values — `rule:core-classes/passkey-verifies-a-webauthn-ceremony` and `rule:core-classes/session-is-started-explicitly`
--GET--
under=a-request
--FILE--
<?nvs
// covers: Core\Passkey::registerOptions
// covers: Core\Passkey::verifyRegistration
// covers: Core\Passkey::signInOptions
// covers: Core\Passkey::verifySignIn
// covers: Core\Passkey::credentialId
// covers: Core\Passkey\Credential::of
// An Ed25519 COSE key: kty 1, alg -8, crv 6 and a 32-byte x.
bytes $key = Core\Bytes::join([Core\Encoding::fromHex("a4010103272006215820"), Core\Bytes::fill(32, 7)]);
Core\Passkey\Credential $stored = Core\Passkey\Credential::of(
    Core\Encoding::fromHex("0102030405"),
    $key,
    Core\Passkey\Credential::Algorithm::Ed25519,
    9,
);
echo "id ", Core\Encoding::toHex($stored->id()), ", key of ", Core\Bytes::length($stored->publicKey()),
    " bytes, counter ", $stored->signCount(), "\n";
echo "algorithm: ", $stored->algorithm() == Core\Passkey\Credential::Algorithm::Ed25519 ? "Ed25519" : "another", "\n";

// No session is started yet, so each of these four calls throws.
string $response = "{\"type\":\"public-key\",\"id\":\"AQIDBAU\",\"response\":{}}";
try {
    echo Core\Passkey::registerOptions("example.com", "Example", Core\Encoding::fromHex("01"), "ada");
} catch (RuntimeError $e) {
    echo "registerOptions: ", Core\Str::contains($e->message, "Core\\Session::start()") ? "names start" : $e->message, "\n";
}
try {
    Core\Passkey::verifyRegistration($response, "example.com", "https://example.com");
} catch (RuntimeError $e) {
    echo "verifyRegistration: ", Core\Str::contains($e->message, "Core\\Session::start()") ? "names start" : $e->message, "\n";
}
try {
    echo Core\Passkey::signInOptions("example.com", [$stored]);
} catch (RuntimeError $e) {
    echo "signInOptions: ", Core\Str::contains($e->message, "Core\\Session::start()") ? "names start" : $e->message, "\n";
}
try {
    Core\Passkey::verifySignIn($response, $stored, "example.com", "https://example.com");
} catch (RuntimeError $e) {
    echo "verifySignIn: ", Core\Str::contains($e->message, "Core\\Session::start()") ? "names start" : $e->message, "\n";
}

// `credentialId` only reads the response, so it works without a session.
echo "credentialId: ", Core\Encoding::toHex(Core\Passkey::credentialId($response)), "\n";
--EXPECT--
id 0102030405, key of 42 bytes, counter 9
algorithm: Ed25519
registerOptions: names start
verifyRegistration: names start
signInOptions: names start
verifySignIn: names start
credentialId: 0102030405
