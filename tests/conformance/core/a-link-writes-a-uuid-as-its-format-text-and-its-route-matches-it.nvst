--TEST--
`Core\Router::url` writes a `Core\Uuid` route value as its `format()` text, in its path segment and in the query string, in lower case even when `parse` read it in upper case, and the route that link reaches receives the same UUID; `Core\Uri::buildQuery` writes the same text — `rule:routing/link-target-and-params-are-checked`, `rule:routing/a-leftover-link-key-is-a-query-string`
--FILE--
<?nvs
// covers: Core\Uuid::format
class Shop {
    #[Core\Route(path: "/orders/{order}", method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function show(Core\Uuid $order, #[Core\Query] ?Core\Uuid $customer = null): void {
        echo "order ", $order->format(), " customer ", $customer?->format() ?? "none", "\n";
    }
}

// This gate allows every route and prints each refusal it receives.
class Gate implements Core\Router\Gate {
    public function allows(Core\Router\Match $route): bool {
        return true;
    }

    public function refused(Core\Router\Refusal $reason, ?Core\Router\Match $route): void {
        echo "refused\n";
    }

    public function failed(?Core\Router\Match $route, ?Throwable $error): void {
        echo "failed ", $error?->message ?? "no error", "\n";
    }
}

if (Core\Env::context() == Core\Env::Context::Request) {
    Core\Router::dispatch(new Gate());
} else {
    var $order = Core\Uuid::parse("F9168C5E-CEB2-4FAA-B6BF-329BF39FA1E4");
    var $customer = Core\Uuid::parse("0190d1e6-8e3c-7c2a-9a4b-1f2e3d4c5b6a");

    string $link = Core\Router::url(Shop::show, ["order" => $order, "customer" => $customer]);
    echo $link, "\n";
    var $answer = Core\Test::request(Core\Http\Method::Get, $link);
    echo $answer->status(), " ", $answer->body();

    string $bare = Core\Router::url(Shop::show, ["order" => $order]);
    echo $bare, "\n";

    echo Core\Uri::buildQuery(["order" => $order]), "\n";
}
--EXPECT--
/orders/f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4?customer=0190d1e6-8e3c-7c2a-9a4b-1f2e3d4c5b6a
200 order f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4 customer 0190d1e6-8e3c-7c2a-9a4b-1f2e3d4c5b6a
/orders/f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4
order=f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4
