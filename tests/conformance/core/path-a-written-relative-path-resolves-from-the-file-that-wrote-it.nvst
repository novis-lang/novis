--TEST--
a relative path given as a string literal at a path parameter is joined to the folder of the file that wrote it — a file reached through `require` from a subfolder reads its own folder, a `#[Core\Path]` parameter resolves the caller's literal, an absolute literal is unchanged, and a relative grant in `nvs.toml` covers the same files — `rule:programs/relative-paths-resolve-from-their-file`
--FILE--
<?nvs
// covers: lang:programs/file-paths-a-relative-path-starts-at-the-folder-of-its-file
require 'lib/reader.nvs';

// The literal is joined to this file's folder.
echo Core\IO::read('data/note.txt');

// `Reader` is declared in `lib/`, so the literal inside it names
// `lib/data/note.txt` and not this folder's file.
echo Reader::own();

// A `#[Core\Path]` parameter resolves the literal at the call, so this one
// is joined to this file's folder, where the call is written.
echo Reader::given('data/note.txt');

// What the parameter receives is an absolute path.
string $seen = Reader::path('./data/../data/note.txt');
echo Core\Path::isAbsolute($seen) ? "absolute\n" : "relative\n";
echo Core\Str::replace(Core\Path::relativeTo($seen, Core\Path::dirname(Reader::path('x'))) ?? '', Core\Path::SEPARATOR, '/'), "\n";

// An absolute literal is passed as it was written.
echo Reader::path('/srv/shop/data.json'), "\n";
--FILE lib/reader.nvs--
<?nvs
class Reader {
  public static function own(): string {
    return Core\IO::read('data/note.txt');
  }

  public static function given(#[Core\Path] string $file): string {
    return Core\IO::read($file);
  }

  public static function path(#[Core\Path] string $file): string {
    return $file;
  }
}
--FILE data/note.txt--
beside the entry file
--FILE lib/data/note.txt--
beside the library file
--FILE nvs.toml--
[capabilities.fs]
read = ["./data", "./lib/data"]
--EXPECT--
beside the entry file
beside the library file
beside the entry file
absolute
data/note.txt
/srv/shop/data.json
