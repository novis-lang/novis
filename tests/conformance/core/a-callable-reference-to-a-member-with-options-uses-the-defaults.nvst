--TEST--
A method reference to a `Core` member with an options bag takes the parameters before the bag, and a call through it passes the bag's defaults — `rule:types/callable-values`
--FILE--
<?nvs
// `Core\Str::split` takes `{limit?: int}` after its two strings. A call
// through a `callable` writes no bag, so the reference is
// `callable(string, string): array<string>` and every option has its default.
callable(string, string): array<string> $split = Core\Str::split(...);
array<string> $parts = $split("a,b,c", ",");
echo Core\Arr::count($parts), "\n";
echo Core\Str::join($parts, "|"), "\n";

// The same call written directly, with no bag, gives the same parts.
echo Core\Str::join(Core\Str::split("a,b,c", ","), "|"), "\n";

// Through a `Core` member that takes a callback, one pair per element.
array<string> $lines = ["x=1", "y=2"];
array<mixed> $pairs = Core\Arr::map($lines, fn(string $line) => $split($line, "="));
echo Core\Arr::count($pairs), "\n";
--EXPECT--
3
a|b|c
a|b|c
2
