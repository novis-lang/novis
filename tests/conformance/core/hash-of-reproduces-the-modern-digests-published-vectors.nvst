--TEST--
`Core\Hash::of` reproduces the published vector of every `Core\Digest` case added past the original six — spec § 11's roster table, `rule:types/bytes` and `rule:types/conversion`
--FILE--
<?nvs
// Spec § 11's roster grew from six cases to fifteen, and the nine below are
// the additions: three more SHA-2 widths, all four of FIPS 202's SHA-3, the
// Castagnoli checksum and BLAKE3. `hash-of-reproduces-each-digests-published-
// vectors.nvst` is the same case for the original six and is not repeated
// here.
//
// A registered enum case with nothing wired behind it passes every other check
// in this tree: the ordinal decodes, the member returns `bytes`, and only a
// vector says which algorithm actually ran. So each line below is that
// algorithm's own specification answering, never this implementation's output
// read back.

// The empty input, every new case. This is the row that pins the *padding*:
// an empty message still absorbs one padded block, so a member that
// special-cased "no data to feed" answers wrongly here and nowhere else. The
// two CRCs have no padding and start and end at zero, which is why `Crc32c`'s
// line is indistinguishable from `Crc32`'s and only the next block separates
// them.
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha224)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha512_224)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha512_256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha3_224)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha3_256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha3_384)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha3_512)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Crc32c)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Blake3)), "\n";

// "abc" — the vector FIPS 180-4 and FIPS 202 both publish, and the one
// BLAKE3's own reference implementation is quoted with everywhere. Two rows
// here are the ones a hand-fitted dispatch gets wrong while every other row
// still passes: `Sha512_224` is not `Sha512` truncated to 28 octets and
// `Sha512_256` is not `Sha512` truncated to 32, because each has its own
// initial state (FIPS 180-4 § 5.3.6) — compare these against the `Sha512`
// line in the sibling case and no prefix matches.
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha224)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha512_224)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha512_256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha3_224)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha3_256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha3_384)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Sha3_512)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Crc32c)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("abc", Core\Digest::Blake3)), "\n";

// FIPS 180-4's 896-bit message — 112 octets, which is the multi-block row for
// every algorithm below and for a different reason in each family. SHA-512's
// block is 128 octets, so the two truncated widths spill because the length
// field no longer fits behind the padding; a SHA-3 variant's rate is set by
// its own capacity — 144, 136, 104 and 72 octets — so 112 absorbs one block
// for SHA3-224 and SHA3-256 and two for SHA3-384 and SHA3-512. A sponge wired
// to one fixed rate passes half of these.
string $long = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
echo Core\Encoding::toHex(Core\Hash::of($long, Core\Digest::Sha512_224)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($long, Core\Digest::Sha512_256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($long, Core\Digest::Sha3_224)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($long, Core\Digest::Sha3_256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($long, Core\Digest::Sha3_384)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($long, Core\Digest::Sha3_512)), "\n";

// The CRC catalogue's check value is the checksum of the nine ASCII digits,
// and it is the one constant every CRC implementation is compared against.
// Printed for both polynomials together because that is the pair that would
// otherwise be one arm calling the other: CRC-32/ISO-HDLC answers `cbf43926`
// and CRC-32C/Castagnoli answers `e3069283`, four octets each, big-endian.
echo Core\Encoding::toHex(Core\Hash::of("123456789", Core\Digest::Crc32)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("123456789", Core\Digest::Crc32c)), "\n";

// A `bytes` no `string` could hold — a lone `ff`, a continuation byte with no
// lead and a truncated sequence. `"…" as bytes` only reaches octets that are
// already valid UTF-8 (`rule:types/bytes` and `rule:types/conversion`), so `Core\Encoding::fromHex` is
// where such a buffer comes from, and `of`'s `bytes|string` parameter is what
// lets it arrive. A digest is defined over octets and has no opinion about
// text; one case per family is enough to pin that, since they share `of`'s
// single reader.
bytes $raw = Core\Encoding::fromHex("00ff80fe");
echo Core\Encoding::toHex(Core\Hash::of($raw, Core\Digest::Sha512_256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($raw, Core\Digest::Sha3_256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($raw, Core\Digest::Crc32c)), "\n";
--EXPECT--
