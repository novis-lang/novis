--TEST--
Core\Str::trim's `{characters}` replaces the default whitespace set for all three trim members
--FILE--
<?nvs
echo "[", Core\Str::trim("xxhixx", {characters: "x"}), "]\n";
echo "[", Core\Str::trimStart("xxhixx", {characters: "x"}), "]\n";
echo "[", Core\Str::trimEnd("xxhixx", {characters: "x"}), "]\n";
echo "[", Core\Str::trim("--/path/--", {characters: "-/"}), "]\n";
echo "[", Core\Str::trim("  spaced  ", {characters: "x"}), "]\n";
echo "[", Core\Str::trim("xxxx", {characters: "x"}), "]\n";
--EXPECT--
[hi]
[hixx]
[xxhi]
[path]
[  spaced  ]
[]
