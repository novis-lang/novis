--TEST--
Under a test's answer table, `Core\WebPush::send` to an endpoint no row answers throws a `LogicError` naming `endpoint()`, a `429` and a `500` are not `gone()`, and `applicationServerKey` returns the same 87 characters for one pair and different ones for two — `rule:core-classes/web-push-sends-an-encrypted-message`, `rule:testing/an-outbound-call-is-answered-from-a-table`
--FILE--
<?nvs
// covers: Core\WebPush::send
// covers: Core\WebPush::applicationServerKey
// covers: Core\WebPush\Subscription::endpoint
// covers: Core\WebPush\Sent::status
// covers: Core\WebPush\Sent::gone
Core\Test::answerHttp("https://push.example.com/busy/*", 429, {});
Core\Test::answerHttp("https://push.example.com/broken/*", 500, {});

Core\Crypto\KeyPair $vapid = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256);
Core\Crypto\KeyPair $other = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256);
string $key = Core\WebPush::applicationServerKey($vapid);
echo "length ", Core\Str::length($key), "\n";
echo "same pair ", $key == Core\WebPush::applicationServerKey($vapid) ? "same" : "different", "\n";
echo "other pair ", $key == Core\WebPush::applicationServerKey($other) ? "same" : "different", "\n";

bytes $payload = Core\Encoding::encodeText("hello", Core\Charset::Utf8);
array<string> $paths = ["busy", "broken", "unknown"];
foreach ($paths as string $path) {
    string $json = "{\"endpoint\":\"https://push.example.com/" . $path . "/abc\",\"keys\":{\"p256dh\":"
        . "\"BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4\","
        . "\"auth\":\"BTBZMqHH6r4Tts7J_aSIgg\"}}";
    Core\WebPush\Subscription $to = Core\WebPush::subscription($json);
    try {
        Core\WebPush\Sent $sent = Core\WebPush::send($to, $payload, $vapid, "mailto:admin@example.com");
        echo $path, " ", $sent->status(), " gone ", $sent->gone() ? "yes" : "no", "\n";
    } catch (LogicError $e) {
        echo $path, " throws, names the endpoint ",
            Core\Str::contains($e->message, $to->endpoint() as string) ? "yes" : "no", "\n";
    }
}
--EXPECT--
length 87
same pair same
other pair different
busy 429 gone no
broken 500 gone no
unknown throws, names the endpoint yes
