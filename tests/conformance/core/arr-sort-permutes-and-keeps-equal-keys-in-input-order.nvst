--TEST--
Spec § 2: `Core\Arr::sort` answers a permutation of its subject under every combination of its four options, and equal keys keep their input order — which `Core\Order::Desc` therefore does not reverse
--FILE--
<?nvs
// The tables this member answers are already pinned one option at a time by
// the five `arr-sort-*` cases beside this one. What is not is either of the
// two properties the sort is *written around*, and both of them are claims
// about every option combination at once rather than about any one row.
class Bag {
    // How many times `$needle` appears — a plain walk, so the permutation
    // proof below never leans on the member it is checking.
    public static function occurrences(array<int> $a, int $needle): int {
        int $n = 0;
        foreach ($a as int $v) {
            if ($v == $needle) {
                $n = $n + 1;
            }
        }
        return $n;
    }

    // Every value of `$vocabulary` appears as often in `$b` as in `$a`, and
    // between them they account for every entry of both — so `$b` holds
    // exactly `$a`'s entries, multiplicities included, and nothing else. That
    // is stronger than a `diff` in both directions, which cannot see a
    // duplicate being dropped or invented.
    public static function isPermutationOf(array<int> $b, array<int> $a, array<int> $vocabulary): bool {
        int $accounted = 0;
        foreach ($vocabulary as int $v) {
            if (Bag::occurrences($a, $v) != Bag::occurrences($b, $v)) {
                return false;
            }
            $accounted = $accounted + Bag::occurrences($b, $v);
        }
        int $countA = Core\Arr::count($a) as int;
        int $countB = Core\Arr::count($b) as int;
        return $accounted == $countA && $countA == $countB;
    }
}

class Rows {
    // The entries whose first character is `$initial`, in the order the answer
    // holds them — one equal-key group, which is what stability is about.
    public static function group(array<string> $a, string $initial): string {
        var $out = "";
        foreach ($a as string $v) {
            if (Core\Str::slice($v, 0, 1) == $initial) {
                $out = $out . $v;
            }
        }
        return $out;
    }
}

// First property: the answer is a permutation of the subject, whatever the
// options say. The subject carries duplicates on purpose — a member that
// answered the *set* of its entries would pass a `diff`-both-ways check and
// fails this one. `by` and `comparator` compose rather than conflict, so the
// sweep includes the combination as well as each alone, and `preserveKeys`
// changes only the keys, so its answers hold the same entries as the rest.
array<int> $bag = [3, 1, 2, 1, 3, 1];
array<int> $vocabulary = [1, 2, 3];
array<array<int>> $answers = [
    Core\Arr::sort($bag),
    Core\Arr::sort($bag, {order: Core\Order::Asc}),
    Core\Arr::sort($bag, {order: Core\Order::Desc}),
    Core\Arr::sort($bag, {by: fn(int $n): int => 0 - $n}),
    Core\Arr::sort($bag, {by: fn(int $n): int => 0 - $n, order: Core\Order::Desc}),
    Core\Arr::sort($bag, {comparator: fn(int $x, int $y): int => $x - $y}),
    Core\Arr::sort($bag, {comparator: fn(int $x, int $y): int => $y - $x}),
    Core\Arr::sort($bag, {by: fn(int $n): int => 0 - $n, comparator: fn(int $x, int $y): int => $x - $y}),
    Core\Arr::sort($bag, {preserveKeys: true}),
    Core\Arr::sort($bag, {preserveKeys: true, order: Core\Order::Desc}),
];
int $swept = 0;
int $permutations = 0;
int $lists = 0;
foreach ($answers as array<int> $answer) {
    $swept = $swept + 1;
    if (Bag::isPermutationOf($answer, $bag, $vocabulary)) {
        $permutations = $permutations + 1;
    }
    if (Core\Arr::isList($answer)) {
        $lists = $lists + 1;
    }
}
echo $swept as string, "|", $permutations as string, "|", $lists as string, "|\n";

// A member that returned its subject untouched would satisfy the count above,
// so one line says the sweep is not vacuous: the entries do move, and the two
// orders are the two the options name.
echo Core\Str::join(Core\Arr::map(Core\Arr::sort($bag), fn(int $n): string => $n as string), ","), "|", Core\Str::join(Core\Arr::map(Core\Arr::sort($bag, {order: Core\Order::Desc}), fn(int $n): string => $n as string), ","), "|\n";

// Second property: the sort is stable, so entries with equal sort keys come
// out in the order they went in. The subject's entries are all distinct and
// its *keys* are not — the first character — which is the only shape in which
// stability is observable at all.
array<string> $rows = ["b1", "a1", "b2", "a2", "b3", "a3"];
array<array<string>> $stable = [
    Core\Arr::sort($rows, {by: fn(string $r): string => Core\Str::slice($r, 0, 1)}),
    Core\Arr::sort($rows, {by: fn(string $r): string => Core\Str::slice($r, 0, 1), order: Core\Order::Desc}),
    Core\Arr::sort($rows, {by: fn(string $r): string => Core\Str::slice($r, 0, 1), preserveKeys: true}),
    Core\Arr::sort($rows, {comparator: fn(string $x, string $y): int => Core\Str::compare(Core\Str::slice($x, 0, 1), Core\Str::slice($y, 0, 1))}),
    Core\Arr::sort($rows, {comparator: fn(string $x, string $y): int => Core\Str::compare(Core\Str::slice($y, 0, 1), Core\Str::slice($x, 0, 1))}),
];
int $sweptRows = 0;
int $keptOrder = 0;
foreach ($stable as array<string> $ordered) {
    $sweptRows = $sweptRows + 1;
    if (Rows::group($ordered, "a") == "a1a2a3" && Rows::group($ordered, "b") == "b1b2b3") {
        $keptOrder = $keptOrder + 1;
    }
}
echo $sweptRows as string, "|", $keptOrder as string, "|\n";

// The two together are what makes `Core\Order::Desc` reverse the *comparison*
// and not the result: the groups swap places while the entries inside each one
// do not, so the descending answer is not the ascending one read backwards.
// Reversing the result — the obvious implementation — would fail this line.
array<string> $asc = Core\Arr::sort($rows, {by: fn(string $r): string => Core\Str::slice($r, 0, 1)});
array<string> $desc = Core\Arr::sort($rows, {by: fn(string $r): string => Core\Str::slice($r, 0, 1), order: Core\Order::Desc});
echo Core\Str::join($asc, ","), "|", Core\Str::join($desc, ","), "|\n";
echo ($desc == Core\Arr::reverse($asc)) ? "reversed" : "not a reversal", "|\n";
--EXPECT--
10|10|8|
1,1,1,2,3,3|3,3,2,1,1,1|
5|5|
a1,a2,a3,b1,b2,b3|b1,b2,b3,a1,a2,a3|
not a reversal|
