--TEST--
`Core\Passkey\Credential::Algorithm` has the cases `ES256` and `Ed25519`, `algorithm()` returns the case `of` was given, each case accepts only its own COSE key, and a `match` over the two cases is exhaustive — `rule:core-classes/passkey-verifies-a-webauthn-ceremony`
--FILE--
<?nvs
// covers: Core\Passkey\Credential::Algorithm
final class Names {
    // No `default` arm: the two cases are every case.
    public static function of(Core\Passkey\Credential::Algorithm $algorithm): string {
        return match ($algorithm) {
            Core\Passkey\Credential::Algorithm::ES256 => "ES256",
            Core\Passkey\Credential::Algorithm::Ed25519 => "Ed25519",
        };
    }

    // Creates the credential, and prints its algorithm or the error.
    public static function load(bytes $key, Core\Passkey\Credential::Algorithm $algorithm): void {
        try {
            Core\Passkey\Credential $made = Core\Passkey\Credential::of(Core\Encoding::fromHex("0a0b"), $key, $algorithm, 0);
            echo Names::of($algorithm), ": ", Names::of($made->algorithm()), "\n";
        } catch (LogicError $e) {
            echo Names::of($algorithm), ": ", Core\Str::after($e->message, "(): ") ?? $e->message, "\n";
        }
    }
}

// The P-256 generator point as an ES256 key, and the RFC 8032 test key as an Ed25519 key.
bytes $es = Core\Encoding::fromHex("a5010203262001215820"
    . "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296" . "225820"
    . "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5");
bytes $ed = Core\Encoding::fromHex("a4010103272006215820d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a");
// An Ed25519 key that names COSE algorithm -19, which is also Ed25519.
bytes $ed19 = Core\Encoding::fromHex("a4010103322006215820d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a");

array<Core\Passkey\Credential::Algorithm> $cases = [
    Core\Passkey\Credential::Algorithm::ES256,
    Core\Passkey\Credential::Algorithm::Ed25519,
];
array<bytes> $keys = [$es, $ed, $ed19];
foreach ($keys as bytes $key) {
    foreach ($cases as Core\Passkey\Credential::Algorithm $case) {
        Names::load($key, $case);
    }
}

// The cases compare by identity.
echo Core\Passkey\Credential::Algorithm::ES256 == Core\Passkey\Credential::Algorithm::ES256 ? "same" : "different", "\n";
echo Core\Passkey\Credential::Algorithm::ES256 == Core\Passkey\Credential::Algorithm::Ed25519 ? "same" : "different", "\n";
--EXPECT--
ES256: ES256
Ed25519: $publicKey is not a key of $algorithm.
ES256: $publicKey is not a key of $algorithm.
Ed25519: Ed25519
ES256: $publicKey is not a key of $algorithm.
Ed25519: Ed25519
same
different
