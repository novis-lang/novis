--TEST--
`Core\Command::completions(Cli\Shell::Bash)` writes a function over `COMP_WORDS` registered with `complete -F`, over the same table `help` reads — ADR 0086 § 6
--FILE--
<?nvs
// § 6 generates the script from the declaration, exactly as it generates the
// usage page: the command names and the option spellings below are the table's
// own, so a completion cannot drift from the parser that answers it.
class Deployer {
    #[Core\Command(name: "deploy", about: "Push the current build")]
    public static function deploy(
        string $target,
        #[Core\Option(short: "n", about: "Print what would happen")] bool $dryRun = false,
    ): uint {
        return 0;
    }

    #[Core\Command(name: "version")]
    public static function version(): uint {
        return 0;
    }
}

// The name the script registers against is the program's own — for a file run
// from a command line, its stem, which is `case` here because that is what this
// case is written to disk as. `nvs_runtime::Ctx::program_name` owns why it is
// the script's stem and not `nvs`.
//
// `version` declares no option and so gets no `case` arm: `options` is already
// empty, and `<target>` is completed by nothing at all, because the table says
// what a parameter is called and not what it may hold.
echo Core\Command::completions(Core\Cli\Shell::Bash);
--EXPECT--
# bash completion for case — generated by Core\Command::completions
_case_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W 'deploy version' -- "$cur"))
        return
    fi
    local options=''
    case "${COMP_WORDS[1]}" in
        'deploy') options='-n --dryRun' ;;
    esac
    COMPREPLY=($(compgen -W "$options" -- "$cur"))
}
complete -F _case_complete 'case'
