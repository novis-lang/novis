--TEST--
Core\Str's trimming, splitting and search members over ASCII text
--FILE--
<?nvs
echo "[", Core\Str::trim("  padded  "), "]\n";
echo "[", Core\Str::trimStart("  padded  "), "]\n";
echo "[", Core\Str::trimEnd("  padded  "), "]\n";

echo Core\Str::join(Core\Str::split("a,b,,c", ","), "|"), "\n";
echo Core\Arr::count(Core\Str::split("a,b,,c", ",")), "\n";

echo Core\Str::contains("haystack", "ays") as string, "|\n";
echo Core\Str::contains("haystack", "zzz") as string, "|\n";
echo Core\Str::startsWith("haystack", "hay") as string, "|\n";
echo Core\Str::startsWith("haystack", "stack") as string, "|\n";
echo Core\Str::endsWith("haystack", "stack") as string, "|\n";
echo Core\Str::endsWith("haystack", "hay") as string, "|\n";

echo Core\Str::repeat("-=", 4), "\n";
echo Core\Str::isEmpty("") as string, "|", Core\Str::isEmpty("x") as string, "|\n";
--EXPECT--
[padded]
[padded  ]
[  padded]
a|b||c
4
1|
|
1|
|
1|
|
-=-=-=-=
1||
