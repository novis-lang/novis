--TEST--
An html template written straight at `echo` in an HTTP request writes its segments as they are and escapes each hole once, the same bytes the template gives through a `Markup` variable -- `rule:core-classes/html-template`, `rule:core-classes/html-auto-escape`
--FILE--
<?nvs
// The program sends a request to itself. `Core\Test::request` runs this file
// again for it, and in that run the first branch is the page.
if (Core\Env::context() == Core\Env::Context::Request) {
    string $name = "<b>Shop</b> & co";
    // At `echo` and through a variable, the template gives the same bytes.
    echo html`<p>{$name}</p>`, "\n";
    Core\Html\Markup $held = html`<p>{$name}</p>`;
    echo $held, "\n";
    // A template with no hole is written as it is.
    echo html`<hr>`, "\n";
} else {
    var $page = Core\Test::request(Core\Http\Method::Get, "/shop");
    echo $page->body();
}
--EXPECT--
<p>&lt;b&gt;Shop&lt;/b&gt; &amp; co</p>
<p>&lt;b&gt;Shop&lt;/b&gt; &amp; co</p>
<hr>
