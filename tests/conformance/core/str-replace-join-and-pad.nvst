--TEST--
Core\Str::replace, ::join and ::padStart return new strings, never mutating
--FILE--
<?nvs
string $csv = "a-b-c";
echo Core\Str::replace($csv, "-", "+"), "\n";
echo $csv, "\n";
echo Core\Str::join(["x", "y", "z"], "|"), "\n";
echo Core\Str::join([], "|"), "\n";
echo Core\Str::padStart("7", 3, "0"), "\n";
echo Core\Str::padStart("1234", 3, "0"), "\n";
--EXPECT--
a+b+c
a-b-c
x|y|z

007
1234
