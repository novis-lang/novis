--TEST--
Core\Crypto\KeyPair::read refuses every file that is not a PKCS#8 private key of the kind named, each with the one LogicError sentence, and reads one RSA file under either scheme into two pairs that differ only in the scheme — `rule:core-classes/crypto-interop-tier`, `rule:security/algorithm-comes-from-the-key`
--FILE--
<?nvs
// A private key is the program's own and never a peer's, so there is nobody a
// verdict could be about: every refusal here is a `LogicError`, a bug in what
// the program was deployed with. The sentence names what is accepted rather
// than what was wrong with these octets, so it is the same sentence for all of
// them and a case can assert that.
array<string> $notPairs = [
    // An Ed25519 key read as P-256: the file is a key, and not this kind of one.
    "302e020100300506032b65700422042036e7913c75ff5d89ba4f46526320f547cf75369a560a168f6ab5bb178fbeaadf",
    // The two Curve25519 kinds share a wrapper up to one octet of OID, which is
    // the octet that says an X25519 pair agrees and an Ed25519 pair signs.
    "302e020100300506032b65700422042036e7913c75ff5d89ba4f46526320f547cf75369a560a168f6ab5bb178fbeaadf",
    // A P-256 key read as RSA.
    "3041020100301306072a8648ce3d020106082a8648ce3d03010704273025020101042033172cfd4cb8e906b35b1dd8753ac6b12b8c760281d124bf635dbf5c5f15c49a",
    // A `SubjectPublicKeyInfo` — the public half, handed where the private one
    // goes. It parses as DER and is still not a private key.
    "302a300506032b6570032100fcce9008a33565248561295a7ce1cccb040b6129bba8ff24744953bbc01261ac",
    // A 1024-bit RSA key, which is a well-formed PKCS#8 outside the roster's
    // 2048 to 8192 bits. The floor is at the read, so no later member has to
    // ask how wide a key it was handed.
    "",
    // Octets that are not DER at all.
    "0102030405",
];
array<Core\Crypto\KeyKind> $asKind = [
    Core\Crypto\KeyKind::P256,
    Core\Crypto\KeyKind::X25519,
    Core\Crypto\KeyKind::RsaPkcs1,
    Core\Crypto\KeyKind::Ed25519,
    Core\Crypto\KeyKind::RsaPkcs1,
    Core\Crypto\KeyKind::Ed25519,
];

array<string> $said = [];
foreach ($notPairs as string $slot => string $hex) {
    try {
        Core\Crypto\KeyPair $no = Core\Crypto\KeyPair::read(
            Core\Encoding::fromHex($hex),
            $asKind[$slot]
        );
        echo "slot ", $slot, " was accepted", "\n";
    } catch (LogicError $bug) {
        $said = Core\Arr::append($said, $bug->message);
    }
}

// The armour is the refusal for the two labels next to `PRIVATE KEY`: PKCS#1 is
// a body this member does not read, and an encrypted PKCS#8 has a password
// there is no argument for. Neither is unwrapped, so neither reaches a parser.
array<string> $armoured = [
    "-----BEGIN RSA PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIDbnkTx1/12Juk9GUmMg9UfPdTaaVgoWj2q1uxePvqrf\n-----END RSA PRIVATE KEY-----\n",
    "-----BEGIN ENCRYPTED PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIDbnkTx1/12Juk9GUmMg9UfPdTaaVgoWj2q1uxePvqrf\n-----END ENCRYPTED PRIVATE KEY-----\n",
];
foreach ($armoured as string $block) {
    try {
        Core\Crypto\KeyPair $notUnwrapped = Core\Crypto\KeyPair::read(
            $block as bytes,
            Core\Crypto\KeyKind::Ed25519
        );
        echo "an armour this does not read was accepted", "\n";
    } catch (LogicError $bug) {
        $said = Core\Arr::append($said, $bug->message);
    }
}

uint $expected = Core\Arr::count($notPairs) + Core\Arr::count($armoured);
echo "refused ", Core\Arr::count($said), " of ", $expected, "\n";

int $oneSentence = 0;
foreach ($said as string $message) {
    if ($message == $said[0]) {
        $oneSentence += 1;
    }
}
echo "one sentence ", $oneSentence, " of ", Core\Arr::count($said), "\n";
echo $said[0], "\n";

// The one pairing that is not a mistake: an RSA file is a key of both RSA
// kinds, because PKCS#8 says *RSA* and never which of `RS256` and `PS256` the
// key is for. So the same octets read twice are two pairs holding one file and
// one public key, differing only in the scheme they are bound to — which is the
// single place `rule:security/algorithm-comes-from-the-key` leaves a choice,
// and it is made here and nowhere later.
string $rsa = "";
Core\Crypto\KeyPair $underPkcs1 = Core\Crypto\KeyPair::read(
    Core\Encoding::fromHex($rsa),
    Core\Crypto\KeyKind::RsaPkcs1
);
Core\Crypto\KeyPair $underPss = Core\Crypto\KeyPair::read(
    Core\Encoding::fromHex($rsa),
    Core\Crypto\KeyKind::RsaPss
);
echo $underPkcs1->write() == $underPss->write() ? "one file\n" : "two files\n";
echo Core\Encoding::toHex($underPkcs1->publicKey()->write(Core\Crypto\KeyFormat::Spki))
    == Core\Encoding::toHex($underPss->publicKey()->write(Core\Crypto\KeyFormat::Spki))
    ? "one public key\n"
    : "two public keys\n";
echo $underPkcs1->publicKey()->kind() == Core\Crypto\KeyKind::RsaPkcs1 ? "RsaPkcs1\n" : "another kind\n";
echo $underPss->publicKey()->kind() == Core\Crypto\KeyKind::RsaPss ? "RsaPss\n" : "another kind\n";
--EXPECT--
refused 8 of 8
one sentence 8 of 8
Core\Crypto\KeyPair::read(): these octets are not a PKCS#8 private key of the kind this call named — DER or one PEM `PRIVATE KEY` block, never a PKCS#1 body and never an encrypted PKCS#8.
one file
one public key
RsaPkcs1
RsaPss
