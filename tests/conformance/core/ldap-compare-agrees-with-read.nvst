--TEST--
Over every value `read` returns for `objectClass`, `compare` returns `true`, and it returns `false` for a class the entry does not have
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
// covers: Core\Ldap\Connection::compare
var $corp = Core\Ldap::connect("corp");
var $admin = "CN=Administrator,CN=Users,DC=example,DC=test";
?Core\Ldap\Entry $found = $corp->read($admin);
if ($found == null) {
    echo "no entry", "\n";
} else {
    Core\Ldap\Entry $entry = $found;
    var $classes = $entry->strings("objectClass") ?? [];
    int $disagree = 0;
    foreach ($classes as tainted string $class) {
        if (!$corp->compare($admin, "objectClass", $class)) {
            $disagree = $disagree + 1;
        }
    }
    echo "classes: ", Core\Arr::count($classes) > 1 ? "more than one" : "one or none", "\n";
    echo "disagreements: ", $disagree, "\n";
    echo "group: ", $corp->compare($admin, "objectClass", "group") ? "true" : "false", "\n";
}
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://localhost:16636"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
classes: more than one
disagreements: 0
group: false
