--TEST--
`setPassword` sets an account's password over LDAPS, `changePassword` changes it from the old one to a new one, and the account then binds with the new password — ADR 0278 § 9
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");
var $staff = "CN=Staff,OU=Staff,DC=example,DC=test";

// A run that stopped half-way leaves the account behind.
array<string> $leftovers = [$staff, "OU=Staff,DC=example,DC=test"];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $gone) {
    }
}
$corp->add("OU=Staff,DC=example,DC=test", ["objectClass" => "organizationalUnit"]);
$corp->add($staff, ["objectClass" => "user", "sAMAccountName" => "Staff"]);

// An administrator sets the first password and enables the account.
// `pwdLastSet` 0 means the user must change the password now.
$corp->setPassword($staff, "Staff-first-Pass-7");
$corp->modify($staff, [
    Core\Ldap\Change::replace("userAccountControl", 512),
    Core\Ldap\Change::replace("pwdLastSet", 0),
]);
echo "set: yes", "\n";

// The user changes the password. The server checks the old one.
$corp->changePassword($staff, "Staff-first-Pass-7", "Staff-second-Pass-8");
echo "changed: yes", "\n";

// The `staff` block logs in with the new password.
echo "login: ", Core\Ldap::connect("staff")->whoami(), "\n";

$corp->delete($staff);
$corp->delete("OU=Staff,DC=example,DC=test");
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp", "staff"]

[ldap.corp]
url = "ldaps://localhost:16636"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"

[ldap.staff]
url = "ldaps://localhost:16636"
user = "CN=Staff,OU=Staff,DC=example,DC=test"
password = "Staff-second-Pass-8"
tls_ca_file = "ca.crt"
--EXPECT--
set: yes
changed: yes
login: u:EXAMPLE\Staff
