--TEST--
`setPassword` sets an account's password over LDAPS, `changePassword` changes it from the old one to a new one, and the account then binds with the new password
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
// covers: Core\Ldap\Connection::setPassword, Core\Ldap\Connection::changePassword
var $corp = Core\Ldap::connect("corp");

// Each name ends in the process id, so two runs at the same time use different entries.
string $run = Core\Os::pid() as string;
string $account = "Staff-" . $run;
string $unit = "OU=" . $account . ",DC=example,DC=test";
var $staff = "CN=" . $account . "," . $unit;

// A run that stopped half-way leaves the account behind.
array<string> $leftovers = [$staff, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $gone) {
    }
}
$corp->add($unit, ["objectClass" => "organizationalUnit"]);
$corp->add($staff, ["objectClass" => "user", "sAMAccountName" => $account]);

// An administrator sets the first password and enables the account.
// `pwdLastSet` 0 means the user must change the password now.
$corp->setPassword($staff, "Staff-first-Pass-7");
$corp->modify($staff, [
    Core\Ldap\Change::replace("userAccountControl", 512),
    Core\Ldap\Change::replace("pwdLastSet", 0),
]);
echo "set: yes", "\n";

// The user changes the password. The server checks the old one.
$corp->changePassword($staff, "Staff-first-Pass-7", "Staff-second-Pass-8");
echo "changed: yes", "\n";

// The user logs in with the new password. This login sends the password
// without TLS, which only the test server on this machine allows.
var $login = Core\Ldap::open({
    url: "ldap://127.0.0.1:16389",
    user: $staff,
    password: "Staff-second-Pass-8",
    tls: Core\Ldap::Tls::None,
});
echo "login: ", $login->whoami(), "\n";

$corp->delete($staff);
$corp->delete($unit);
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]
open = ["127.0.0.1"]
cleartext = ["127.0.0.1"]

[capabilities.net]
internal = ["127.0.0.1"]

[ldap.corp]
url = "ldaps://127.0.0.1:16636"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECTF--
set: yes
changed: yes
login: u:EXAMPLE\Staff-%d
