--TEST--
Core\Imap::open of a block whose server does not answer throws `IOError`, and a second call tries the server again — `rule:core-classes/imap`
--FILE--
<?nvs
// Nothing listens on port 1, so the server of `[imap.inbox]` does not answer.
try {
    var $inbox = Core\Imap::open("inbox");
    echo "opened inbox", "\n";
} catch (IOError $down) {
    echo "IOError", "\n";
}

// The block is still granted, so a second call connects again and throws again.
try {
    var $again = Core\Imap::open("inbox");
    echo "opened inbox", "\n";
} catch (RuntimeError $failed) {
    echo "again: ", $failed is IOError ? "IOError" : "other", "\n";
}
--FILE nvs.toml--
[capabilities.imap]
connect = ["inbox"]

[imap.inbox]
host = "127.0.0.1"
port = 1
user = "ada@example.com"
password = "secret"
timeout = "2s"
--EXPECT--
IOError
again: IOError
