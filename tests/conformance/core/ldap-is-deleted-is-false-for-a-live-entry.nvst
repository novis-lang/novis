--TEST--
`isDeleted()` is `false` for a live entry, whether its attributes were selected or not, and `read` does not add `isDeleted` to a `select`
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");
var $admin = "CN=Administrator,CN=Users,DC=example,DC=test";

?Core\Ldap\Entry $named = $corp->read($admin, {select: ["cn"]});
echo "selected cn, isDeleted: ", $named?->isDeleted() ? "true" : "false", "\n";
echo "selected cn, has isDeleted: ", $named?->has("isDeleted") ? "yes" : "no", "\n";

?Core\Ldap\Entry $every = $corp->read($admin);
echo "every attribute, isDeleted: ", $every?->isDeleted() ? "true" : "false", "\n";
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://localhost:16636"
base = "DC=example,DC=test"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
selected cn, isDeleted: false
selected cn, has isDeleted: no
every attribute, isDeleted: false
