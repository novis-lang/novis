--TEST--
Spec § 4, `rule:classes/comparable`: `Core\Time\TimeOfDay::compareTo` is a total order, asserted by counting the laws over a table rather than reading a row — trichotomy, antisymmetry over 144 pairs and transitivity over 1,728 triples — and the order it answers is the one `Core\Arr::sort` produces over the same table from a comparator that never asks it
--FILE--
<?nvs
// covers: Core\Time\TimeOfDay::compareTo
// `rule:classes/comparable` makes `compareTo` the one order a value has, and § 4 gives a clock
// reading exactly one. A row-by-row case cannot tell a total order from a
// member that answers plausibly: the laws are statements about *triples* and
// about the whole table at once, so every count below is over a sweep and the
// expectation is the sweep's size.
class Clock {
    // A reading as one integer of nanoseconds since midnight, read out of
    // `format` — the independent view of the same value, so nothing below
    // checks `compareTo` against itself.
    public static function key(Core\Time\TimeOfDay $t): int {
        return (($t->format("HH") as int) * 3600
            + ($t->format("mm") as int) * 60
            + ($t->format("ss") as int)) * 1000000000
            + ($t->format("SSSSSSSSS") as int);
    }

    public static function render(Core\Time\TimeOfDay $t): string {
        return $t->format("HH:mm:ss.SSSSSSSSS");
    }
}

// Written out of clock order on purpose, so the sort below has something to
// do. Rows 2 and 6 are two distinct instances of one reading — the pair that
// makes `0` reachable off the diagonal — and three pairs differ only in a
// field coarser views drop: nanoseconds.
array<Core\Time\TimeOfDay> $clock = [
    Core\Time\TimeOfDay::at(12, 0, {second: 0, nanos: 500000001}),
    Core\Time\TimeOfDay::at(0, 0),
    Core\Time\TimeOfDay::at(9, 5),
    Core\Time\TimeOfDay::at(23, 59, {second: 59, nanos: 999999999}),
    Core\Time\TimeOfDay::at(12, 0, {second: 0, nanos: 500000000}),
    Core\Time\TimeOfDay::at(0, 0, {second: 0, nanos: 1}),
    Core\Time\TimeOfDay::at(9, 5),
    Core\Time\TimeOfDay::at(6, 30),
    Core\Time\TimeOfDay::at(18, 45, {second: 59}),
    Core\Time\TimeOfDay::at(12, 0),
    Core\Time\TimeOfDay::at(23, 59, {second: 59}),
    Core\Time\TimeOfDay::at(1, 2, {second: 3, nanos: 4}),
];

// Trichotomy and antisymmetry, over all 144 ordered pairs.
//
// `trichotomy` counts the answers that are one of the three signs at all — an
// `int` return leaves room for the `$a - $b` shape, which this member does not
// take. `zero-iff-same` is the load-bearing one: `0` exactly where the two
// readings render alike, which is 14 pairs (the 12 diagonal ones plus rows 2
// and 6 either way round) and no others. A member comparing only the fields a
// human reads would answer `0` on the three nanosecond-only pairs too.
int $a = 0;
int $trichotomy = 0;
int $zeros = 0;
int $agreesWithSameness = 0;
int $antisymmetric = 0;
int $strict = 0;
for (; $a < 12; $a = $a + 1) {
    int $b = 0;
    for (; $b < 12; $b = $b + 1) {
        var $left = $clock[$a as string];
        var $right = $clock[$b as string];
        int $sign = $left->compareTo($right);
        if ($sign == -1 || $sign == 0 || $sign == 1) {
            $trichotomy = $trichotomy + 1;
        }
        if ($sign == 0) {
            $zeros = $zeros + 1;
        }
        if (($sign == 0) == (Clock::render($left) == Clock::render($right))) {
            $agreesWithSameness = $agreesWithSameness + 1;
        }
        if ($sign + $right->compareTo($left) == 0) {
            $antisymmetric = $antisymmetric + 1;
        }
        if ($sign != 0) {
            $strict = $strict + 1;
        }
    }
}
echo "trichotomy=", $trichotomy as string,
    " zero=", $zeros as string,
    " zero-iff-same=", $agreesWithSameness as string,
    " antisym=", $antisymmetric as string,
    " strict=", $strict as string, "|\n";

// Transitivity, over all 1,728 ordered triples. This is the law no pairwise
// sweep can see and the one a member with a hand-rolled field cascade breaks
// first — a cascade that compares the wrong field second is antisymmetric and
// still ranks `x < y < z < x`.
//
// The implication is counted, and so are its antecedents, because a member
// answering `0` everywhere satisfies every implication vacuously: `weak` is
// the chains under `<=` and `strictChains` the ones under `<`, and both being
// large is what makes the 1,728 mean something.
int $i = 0;
int $transitive = 0;
int $weak = 0;
int $strictChains = 0;
for (; $i < 12; $i = $i + 1) {
    int $j = 0;
    for (; $j < 12; $j = $j + 1) {
        int $k = 0;
        for (; $k < 12; $k = $k + 1) {
            var $x = $clock[$i as string];
            var $y = $clock[$j as string];
            var $z = $clock[$k as string];
            int $xy = $x->compareTo($y);
            int $yz = $y->compareTo($z);
            int $xz = $x->compareTo($z);
            bool $chained = $xy <= 0 && $yz <= 0;
            if ($chained) {
                $weak = $weak + 1;
            }
            if ($xy < 0 && $yz < 0) {
                $strictChains = $strictChains + 1;
            }
            // The implication itself, counted over every triple including the
            // ones whose antecedent is false — so the total is the sweep's own
            // size and a triple that breaks the order subtracts from it.
            if (!$chained || $xz <= 0) {
                $transitive = $transitive + 1;
            }
        }
    }
}
echo "transitive=", $transitive as string,
    " weak-chains=", $weak as string,
    " strict-chains=", $strictChains as string, "|\n";

// `Core\Arr::sort` has no natural order for an object (`rule:classes/comparable` leaves that to
// `Comparable`), so it takes the comparator — and the one it is given here
// reads `Clock::key`, never `compareTo`. The sequence it lands on is therefore
// an ordering of this table derived from the rendering alone.
array<Core\Time\TimeOfDay> $byKey = Core\Arr::sort($clock, {
    comparator: fn (Core\Time\TimeOfDay $p, Core\Time\TimeOfDay $q): int
        => Clock::key($p) <=> Clock::key($q),
});
string $sequence = "";
int $s = 0;
for (; $s < 12; $s = $s + 1) {
    $sequence = $sequence . Clock::render($byKey[$s as string]) . " ";
}
echo $sequence, "|\n";

// Agreement, the whole point: over the same 144 pairs, `compareTo`'s sign is
// the sign of the two values' positions in that sequence. A position is the
// first index rendering alike, so the two equal rows share one — which is the
// only way a total order with a tie can be read off an array of distinct
// slots, and it is what makes the `0` answers agree here rather than be
// excused.
int $u = 0;
int $positionSign = 0;
for (; $u < 12; $u = $u + 1) {
    int $v = 0;
    for (; $v < 12; $v = $v + 1) {
        int $leftAt = 12;
        int $rightAt = 12;
        int $at = 11;
        for (; $at >= 0; $at = $at - 1) {
            if (Clock::render($byKey[$at as string]) == Clock::render($clock[$u as string])) {
                $leftAt = $at;
            }
            if (Clock::render($byKey[$at as string]) == Clock::render($clock[$v as string])) {
                $rightAt = $at;
            }
        }
        if ($clock[$u as string]->compareTo($clock[$v as string]) == ($leftAt <=> $rightAt)) {
            $positionSign = $positionSign + 1;
        }
    }
}

// And the other direction: sorting by `compareTo` reproduces that sequence
// exactly, from the table as written and from its reverse alike. A comparison
// that is not a total order sorts a permutation to somewhere else.
array<Core\Time\TimeOfDay> $reversed = [
    Core\Time\TimeOfDay::at(1, 2, {second: 3, nanos: 4}),
    Core\Time\TimeOfDay::at(23, 59, {second: 59}),
    Core\Time\TimeOfDay::at(12, 0),
    Core\Time\TimeOfDay::at(18, 45, {second: 59}),
    Core\Time\TimeOfDay::at(6, 30),
    Core\Time\TimeOfDay::at(9, 5),
    Core\Time\TimeOfDay::at(0, 0, {second: 0, nanos: 1}),
    Core\Time\TimeOfDay::at(12, 0, {second: 0, nanos: 500000000}),
    Core\Time\TimeOfDay::at(23, 59, {second: 59, nanos: 999999999}),
    Core\Time\TimeOfDay::at(9, 5),
    Core\Time\TimeOfDay::at(0, 0),
    Core\Time\TimeOfDay::at(12, 0, {second: 0, nanos: 500000001}),
];
array<Core\Time\TimeOfDay> $byMember = Core\Arr::sort($clock, {
    comparator: fn (Core\Time\TimeOfDay $p, Core\Time\TimeOfDay $q): int => $p->compareTo($q),
});
array<Core\Time\TimeOfDay> $fromReverse = Core\Arr::sort($reversed, {
    comparator: fn (Core\Time\TimeOfDay $p, Core\Time\TimeOfDay $q): int => $p->compareTo($q),
});
string $byMemberSequence = "";
string $fromReverseSequence = "";
int $m = 0;
int $nonDecreasing = 0;
for (; $m < 12; $m = $m + 1) {
    $byMemberSequence = $byMemberSequence . Clock::render($byMember[$m as string]) . " ";
    $fromReverseSequence = $fromReverseSequence . Clock::render($fromReverse[$m as string]) . " ";
    // Non-decreasing under the member itself, on the sequence the *key*
    // comparator produced: 11 adjacent pairs, none of them out of order.
    if ($m < 11) {
        if ($byKey[$m as string]->compareTo($byKey[($m + 1) as string]) <= 0) {
            $nonDecreasing = $nonDecreasing + 1;
        }
    }
}
echo "position-sign=", $positionSign as string,
    " non-decreasing=", $nonDecreasing as string,
    " same-sequence=", ($byMemberSequence == $sequence) as string,
    " permutation-invariant=", ($fromReverseSequence == $sequence) as string, "|\n";
--EXPECT--
trichotomy=144 zero=14 zero-iff-same=144 antisym=144 strict=130|
transitive=1728 weak-chains=378 strict-chains=210|
00:00:00.000000000 00:00:00.000000001 01:02:03.000000004 06:30:00.000000000 09:05:00.000000000 09:05:00.000000000 12:00:00.000000000 12:00:00.500000000 12:00:00.500000001 18:45:59.000000000 23:59:59.000000000 23:59:59.999999999 |
position-sign=144 non-decreasing=11 same-sequence=1 permutation-invariant=1|