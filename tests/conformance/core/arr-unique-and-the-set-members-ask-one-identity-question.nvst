--TEST--
Core\Arr::unique, contains, diff and intersect resolve one identity table, not four — spec § 2, `rule:expressions/equality-semantics`
--FILE--
<?nvs
// The depth claim is *agreement*, not another row of answers: every pair below
// is put to all four set members, and what is asserted is that they return one
// verdict rather than four. A member that grew its own comparison — a string
// cast, a loose `==`, a hash over raw bits — would still answer plausibly on
// its own line and would break here.
enum Suit {
    Hearts,
    Spades,
}

class Point {
    public function constructor(public int $x) {}
}

class Ask {
    // `1` when all four members say the pair is one value, `0` when all four
    // say it is two, and `-1` when they disagree — which is the failure this
    // case exists to catch. A callable cannot be called through the variable
    // holding it (`nvs-ir` gap 1), so the predicate is a static method.
    public static function verdict(array<mixed> $pair): int {
        array<mixed> $one = Core\Arr::slice($pair, 0, 1);
        array<mixed> $two = Core\Arr::slice($pair, 1, 1);
        var $c = Core\Arr::contains($one, $pair["1"]);
        var $u = Core\Arr::count(Core\Arr::unique($pair)) as int;
        var $d = Core\Arr::count(Core\Arr::diff($one, $two)) as int;
        var $i = Core\Arr::count(Core\Arr::intersect($one, $two)) as int;
        if ($c) {
            if ($u == 1 && $d == 0 && $i == 1) {
                return 1;
            }
            return -1;
        }
        if ($u == 2 && $d == 1 && $i == 0) {
            return 0;
        }
        return -1;
    }
}

var $p = new Point(1);

// One row per line of `rule:expressions/equality-semantics`'s table, plus § 5's cross-type pairs, which
// only a `mixed` element can even present to these members.
array<array<mixed>> $rows = [
    [null, null],                                   // null: always
    [true, true],
    [true, false],
    [1, 1],
    [1, 1.0],                                       // one numeric domain: the row
    [1, 2],                                         //   that diverges from `===`
    [0.0, -0.0],                                    // IEEE: equal
    [Core\Math::NAN, Core\Math::NAN],               // IEEE: a NaN is identical to
                                                    //   nothing, itself included
    ["1", "01"],                                    // a string is never numeric
    ["1e3", "1000"],
    ["a", "a"],
    ["a", "A"],
    ["ab" as bytes, "ab" as bytes],                 // bytes: the same bytes
    [[1, 2], [1, 2]],
    [[1, 2], [2, 1]],                               // order is part of an array
    [[1, 2], [1, 2, 3]],
    [["a" => 1, "b" => 2], ["a" => 1, "b" => 2]],
    [["a" => 1, "b" => 2], ["b" => 2, "a" => 1]],   // and so is key order
    [[[1]], [[1]]],                                 // the row recurses
    [$p, $p],                                       // an instance is the object
    [$p, new Point(1)],                             //   itself, never its twin
    [Suit::Hearts, Suit::Hearts],                   // an enum case is its integer
    [Suit::Hearts, Suit::Spades],
    [1, "1"],                                       // nothing converts, so every
    [true, 1],                                      //   cross-type pair below is
    [null, false],                                  //   two values — the whole of
    [null, 0],                                      //   PHP's `==` table that
    [null, ""],                                     //   Novis does not have
    [0, ""],
];

var $verdicts = "";
var $agreed = 0;
foreach ($rows as array<mixed> $row) {
    var $v = Ask::verdict($row);
    if ($v < 0) {
        $verdicts = $verdicts . "?";
    } else {
        $verdicts = $verdicts . ($v as string);
        $agreed = $agreed + 1;
    }
}
echo $verdicts, "\n";
// Counted rather than read off a line: a `?` anywhere is a member that answered
// its own question, and the tally is what says every row was actually asked.
echo $agreed, " of ", Core\Arr::count($rows), "\n";

// `unique`'s own consequence of the NaN row, which is the one place its seen
// set is not a set: nothing matches a NaN, so every NaN entry survives.
array<float> $nans = [Core\Math::NAN, Core\Math::NAN, Core\Math::NAN];
echo Core\Arr::count(Core\Arr::unique($nans)), "\n";

// And of the numeric row: `1` and `1.0` are one entry where `"1"` is a second.
array<mixed> $mixed = [1, 1.0, "1"];
echo Core\Arr::count(Core\Arr::unique($mixed)), "\n";

// `{by: ...}` changes *what* identity is asked about, never the table it is
// asked from — the three strings are three entries, and the integers they
// extract to are two.
array<string> $codes = ["1", "01", "2"];
echo Core\Arr::count(Core\Arr::unique($codes)), "\n";
echo Core\Arr::count(Core\Arr::unique($codes, {by: fn(string $c) => $c as int})), "\n";
--EXPECT--
11011010001011001011010000000
29 of 29
3
2
3
2
