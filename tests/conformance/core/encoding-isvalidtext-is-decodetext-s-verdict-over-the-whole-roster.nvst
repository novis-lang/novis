--TEST--
`Core\Encoding::isValidText` answers `true` exactly where `::decodeText` does not throw, over every charset the registry names crossed with itself — spec § 7, ADR 0009 § 3
--FILE--
<?nvs
// `isValidText` is documented in `crates/nvs-stdlib/src/encoding.rs` as
// `decodeText`'s question without the throw, and implemented by running the
// decode and discarding it, on the grounds that two implementations of one
// question is how they come to disagree. This case is the assertion that
// buys: the two members are asked the same question about the same octets
// under all 41 charsets and have to *agree*, counted, rather than each being
// checked against a frozen answer of its own. A validator that grew a fast
// path — an ASCII skip, a length-only check, a trust of a leading BOM —
// still answers every row above plausibly and fails the agreed count here.
//
// `encoding-charset-conversion-names-the-character-it-cannot-spell.nvst`
// already counts this agreement over the 256 single octets under one charset;
// what is new here is the roster, both sides of it: the bytes are what each
// charset *wrote*, read back under every charset including the 40 that did
// not write them, which is the shape a caller sniffing an unknown encoding
// actually produces.
//
// The charset comes out of a `match` on the index rather than an
// `array<Core\Charset>` for the reason
// `encoding-text-round-trips-through-every-charset-the-registry-names.nvst`
// records: a source-written `Core\Charset` does not unify with the registry's
// own enum type, while a `var` binding infers it.
array<string> $texts = ["nvs", "café", "あい"];
for (int $t = 0; $t < 3; $t = $t + 1) {
    string $text = $texts[$t];
    int $checked = 0;
    int $agreed = 0;
    int $accepted = 0;
    for (int $i = 0; $i < 41; $i = $i + 1) {
        var $src = match ($i) {
            0 => Core\Charset::Utf8,
            1 => Core\Charset::Utf16Le,
            2 => Core\Charset::Utf16Be,
            3 => Core\Charset::Ascii,
            4 => Core\Charset::Latin1,
            5 => Core\Charset::Ibm866,
            6 => Core\Charset::Iso88592,
            7 => Core\Charset::Iso88593,
            8 => Core\Charset::Iso88594,
            9 => Core\Charset::Iso88595,
            10 => Core\Charset::Iso88596,
            11 => Core\Charset::Iso88597,
            12 => Core\Charset::Iso88598,
            13 => Core\Charset::Iso88598I,
            14 => Core\Charset::Iso885910,
            15 => Core\Charset::Iso885913,
            16 => Core\Charset::Iso885914,
            17 => Core\Charset::Iso885915,
            18 => Core\Charset::Iso885916,
            19 => Core\Charset::Koi8R,
            20 => Core\Charset::Koi8U,
            21 => Core\Charset::Macintosh,
            22 => Core\Charset::Windows874,
            23 => Core\Charset::Windows1250,
            24 => Core\Charset::Windows1251,
            25 => Core\Charset::Windows1252,
            26 => Core\Charset::Windows1253,
            27 => Core\Charset::Windows1254,
            28 => Core\Charset::Windows1255,
            29 => Core\Charset::Windows1256,
            30 => Core\Charset::Windows1257,
            31 => Core\Charset::Windows1258,
            32 => Core\Charset::XMacCyrillic,
            33 => Core\Charset::Gbk,
            34 => Core\Charset::Gb18030,
            35 => Core\Charset::Big5,
            36 => Core\Charset::EucJp,
            37 => Core\Charset::Iso2022Jp,
            38 => Core\Charset::ShiftJis,
            39 => Core\Charset::EucKr,
            default => Core\Charset::XUserDefined,
        };
        bytes $out = Core\Bytes::fill(0, 0);
        bool $threw = false;
        try {
            $out = Core\Encoding::encodeText($text, $src);
        } catch (Throwable $noSpelling) {
            $threw = true;
        }
        // A charset with no spelling for the text writes no octets, so there
        // is nothing to ask the other 41 about; the round-trip case owns that
        // half of the roster.
        if ($threw) {
            continue;
        }
        for (int $j = 0; $j < 41; $j = $j + 1) {
            var $under = match ($j) {
                0 => Core\Charset::Utf8,
                1 => Core\Charset::Utf16Le,
                2 => Core\Charset::Utf16Be,
                3 => Core\Charset::Ascii,
                4 => Core\Charset::Latin1,
                5 => Core\Charset::Ibm866,
                6 => Core\Charset::Iso88592,
                7 => Core\Charset::Iso88593,
                8 => Core\Charset::Iso88594,
                9 => Core\Charset::Iso88595,
                10 => Core\Charset::Iso88596,
                11 => Core\Charset::Iso88597,
                12 => Core\Charset::Iso88598,
                13 => Core\Charset::Iso88598I,
                14 => Core\Charset::Iso885910,
                15 => Core\Charset::Iso885913,
                16 => Core\Charset::Iso885914,
                17 => Core\Charset::Iso885915,
                18 => Core\Charset::Iso885916,
                19 => Core\Charset::Koi8R,
                20 => Core\Charset::Koi8U,
                21 => Core\Charset::Macintosh,
                22 => Core\Charset::Windows874,
                23 => Core\Charset::Windows1250,
                24 => Core\Charset::Windows1251,
                25 => Core\Charset::Windows1252,
                26 => Core\Charset::Windows1253,
                27 => Core\Charset::Windows1254,
                28 => Core\Charset::Windows1255,
                29 => Core\Charset::Windows1256,
                30 => Core\Charset::Windows1257,
                31 => Core\Charset::Windows1258,
                32 => Core\Charset::XMacCyrillic,
                33 => Core\Charset::Gbk,
                34 => Core\Charset::Gb18030,
                35 => Core\Charset::Big5,
                36 => Core\Charset::EucJp,
                37 => Core\Charset::Iso2022Jp,
                38 => Core\Charset::ShiftJis,
                39 => Core\Charset::EucKr,
                default => Core\Charset::XUserDefined,
            };
            $checked = $checked + 1;
            bool $valid = Core\Encoding::isValidText($out, $under);
            bool $refused = false;
            try {
                Core\Encoding::decodeText($out, $under);
            } catch (Throwable $unreadable) {
                $refused = true;
            }
            if ($valid != $refused) {
                $agreed = $agreed + 1;
            }
            // The accepted count is what stops the agreement being vacuous: a
            // pair that both always answered "readable" would agree on every
            // row and print a different number here.
            if ($valid) {
                $accepted = $accepted + 1;
            }
        }
    }
    echo $checked, " checked, ", $agreed, " agreed, ", $accepted, " accepted\n";
}

// The truncated tail is where a validator written apart from its decoder
// diverges first, so the two are asked about every prefix of one buffer as
// well: a 1-, 3- and 4-byte UTF-8 sequence in a row, cut at all nine offsets.
// Only the four cuts that fall on a sequence boundary are readable, and
// `isValidText` has to say so at exactly those four.
bytes $wide = Core\Encoding::encodeText("aあ🦀", Core\Charset::Utf8);
int $len = Core\Bytes::length($wide) as int;
int $prefixes = 0;
int $prefixAgreed = 0;
int $prefixValid = 0;
for (int $p = 0; $p <= $len; $p = $p + 1) {
    bytes $cut = Core\Bytes::slice($wide, 0, $p);
    $prefixes = $prefixes + 1;
    bool $cutValid = Core\Encoding::isValidText($cut, Core\Charset::Utf8);
    bool $cutRefused = false;
    try {
        Core\Encoding::decodeText($cut, Core\Charset::Utf8);
    } catch (Throwable $partial) {
        $cutRefused = true;
    }
    if ($cutValid != $cutRefused) {
        $prefixAgreed = $prefixAgreed + 1;
    }
    if ($cutValid) {
        $prefixValid = $prefixValid + 1;
    }
}
echo $prefixes, " prefixes, ", $prefixAgreed, " agreed, ", $prefixValid, " readable\n";
--EXPECT--
1681 checked, 1681 agreed, 1603 accepted
861 checked, 861 agreed, 679 accepted
410 checked, 410 agreed, 374 accepted
9 prefixes, 9 agreed, 4 readable
