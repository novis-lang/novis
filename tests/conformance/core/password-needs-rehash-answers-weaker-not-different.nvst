--TEST--
Core\Password::hash answers an ordinary string carrying the parameters that made it, and ::needsRehash asks whether a stored hash is weaker rather than whether it differs — spec § 16, ADR 0033 § 3, ADR 0051 § 3
--FILE--
<?nvs
secret string $password = "correct horse battery staple";
string $stored = Core\Password::hash($password);

// ADR 0033 § 3: `hash` is one of exactly two operations that take a `secret`
// and answer something that is not one, which is what lets the result reach an
// output sink the password itself could never reach. The else branch echoes it
// for the same reason — if the prefix ever changes, the case says what to.
if (Core\Str::startsWith($stored, '$argon2id$v=19$m=19456,t=2,p=1$')) {
    echo "argon2id v19 m=19456 t=2 p=1", "\n";
} else {
    echo $stored, "\n";
}
if (Core\Password::verify($password, $stored)) {
    echo "and it verifies", "\n";
} else {
    echo "and it does not verify", "\n";
}

// The parameters travel with the digest, so `needsRehash` reads them off the
// stored value rather than off a column an application has to keep in step.
// A hash made under weaker settings has fallen behind on either axis.
string $thinMemory = '$argon2id$v=19$m=8192,t=2,p=1$jJ+hokoSJRsAzYsgfwhV6g$BGyWXoH11l0/GF4ezLqvtQgPY0T/4fv4DukErq9R0cI';
string $onePass = '$argon2id$v=19$m=19456,t=1,p=1$jJ+hokoSJRsAzYsgfwhV6g$BGyWXoH11l0/GF4ezLqvtQgPY0T/4fv4DukErq9R0cI';
if (Core\Password::needsRehash($thinMemory) && Core\Password::needsRehash($onePass)) {
    echo "weaker on either axis is stale", "\n";
} else {
    echo "a weaker hash was reported current", "\n";
}

// An older Argon2 version is a different function under the same name.
string $oldVersion = '$argon2id$v=16$m=19456,t=2,p=1$jJ+hokoSJRsAzYsgfwhV6g$BGyWXoH11l0/GF4ezLqvtQgPY0T/4fv4DukErq9R0cI';
if (Core\Password::needsRehash($oldVersion)) {
    echo "an older version is stale", "\n";
} else {
    echo "an older version was reported current", "\n";
}

// **Weaker, not different.** PHP compares the stored options to the current
// ones for equality, so a hash written under stronger settings asks to be
// rehashed and is silently downgraded by a program doing as it was told.
// Here it is left alone, on both axes and on lanes, which are not compared at
// all: `p` divides the same work rather than changing how much there is.
string $stronger = '$argon2id$v=19$m=65536,t=4,p=1$jJ+hokoSJRsAzYsgfwhV6g$BGyWXoH11l0/GF4ezLqvtQgPY0T/4fv4DukErq9R0cI';
string $moreLanes = '$argon2id$v=19$m=19456,t=2,p=4$jJ+hokoSJRsAzYsgfwhV6g$BGyWXoH11l0/GF4ezLqvtQgPY0T/4fv4DukErq9R0cI';
if (Core\Password::needsRehash($stronger)) {
    echo "a stronger hash was asked to downgrade itself", "\n";
} else {
    echo "stronger is left alone", "\n";
}
if (Core\Password::needsRehash($moreLanes)) {
    echo "a lane count was read as a cost", "\n";
} else {
    echo "lanes are not a cost", "\n";
}
--EXPECT--
argon2id v19 m=19456 t=2 p=1
and it verifies
weaker on either axis is stale
an older version is stale
stronger is left alone
lanes are not a cost
