--TEST--
`Core\Env::secret` answers the same value `get` does, an empty value as a value, and `null` for a name nothing set — `rule:security/secret-has-no-ambient-source`
--ENV--
NVS_CASE_PASSWORD=pa=ss word
NVS_CASE_EMPTY=
--FILE--
<?nvs
// The two members read one variable, and differ only in the qualifier. The
// values are revealed here so the case can compare and print them.
secret string $password = Core\Env::secret("NVS_CASE_PASSWORD") ?? "<unset>";
echo Core\Secret::reveal($password, "the case compares the value"), "\n";
echo Core\Secret::reveal($password, "the case compares the value") == (Core\Taint::assertTrusted(Core\Env::get("NVS_CASE_PASSWORD") ?? "", "the case compares the value")) ? "same" : "different", "\n";

// An empty value is set, so it is not `null`.
echo Core\Env::secret("NVS_CASE_EMPTY") == null ? "null" : "set", "\n";

// Nothing set these, and no platform can hold the last two names.
echo Core\Env::secret("NVS_CASE_NOBODY_SET_THIS") == null ? "null" : "set", "\n";
echo Core\Env::secret("") == null ? "null" : "set", "\n";
echo Core\Env::secret("NVS=CASE") == null ? "null" : "set", "\n";
--EXPECT--
pa=ss word
same
set
null
null
null
