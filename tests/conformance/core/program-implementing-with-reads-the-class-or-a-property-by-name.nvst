--TEST--
`implementingWith`'s `$member` selects the class's own attributes for the empty name and the constructor's roster for a property or promoted-parameter name, exactly as `Core\Attributes::get<T>`'s two forms do, `rule:programs/implementing-with`
--FILE--
<?nvs
// covers: lang:attributes/core-program-implementingwith-i-t-member-every-implementor-with-one-attribute
interface Plugin {
    attribute Priority on class { priority: int }
    attribute Setting on property, parameter { label: string }

    public function name(): string;
}

#[Priority(priority: 2)]
class Late implements Plugin {
    public function constructor(#[Setting(label: "promoted")] public string $when = "later") {}
    public function name(): string { return "late"; }
}

#[Priority(priority: 1)]
class Early implements Plugin {
    #[Setting(label: "declared")]
    public string $when = "soon";
    public function name(): string { return "early"; }
}

class Plain implements Plugin {
    public string $when = "whenever";
    public function name(): string { return "plain"; }
}

// The empty name: the attribute on the class itself.
foreach (Core\Program::implementingWith<Plugin, Plugin::Priority>() as var $row) {
    echo $row->instance->name(), " ", $row->attribute?->priority ?? 0, "\n";
}
// A property name: a declared property and a promoted parameter alike.
foreach (Core\Program::implementingWith<Plugin, Plugin::Setting>("when") as var $setting) {
    echo $setting->instance->name(), " ", $setting->attribute?->label ?? "-", "\n";
}
// covers: Core\Program::implementingWith
--EXPECT--
early 1
late 2
plain 0
early declared
late promoted
plain -
