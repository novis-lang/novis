--TEST--
Core\Json::encode writes a `float` with a whole value with `.0`, at any depth, and writes an exponent without a fractional part it does not need, so `1` and `1.0` stay two documents
--FILE--
<?nvs
// Whole-valued floats, including both signed zeros.
echo Core\Json::encode(0.0), "\n";
echo Core\Json::encode(-0.0), "\n";
echo Core\Json::encode(1.0), "\n";
echo Core\Json::encode(-7.0), "\n";
echo Core\Json::encode(2.0 * 3.0), "\n";

// The value decides, not the literal.
echo Core\Json::encode(0.5 + 0.5), "\n";
echo Core\Json::encode(1.5 * 2.0), "\n";

// Very large and very small values are written with an exponent.
echo Core\Json::encode(1.0e100), "\n";
echo Core\Json::encode(1.0e-7), "\n";
echo Core\Json::encode(1.5e300), "\n";

// The same rule inside an object or a list.
echo Core\Json::encode(["price" => 20.0, "qty" => 2.5]), "\n";
echo Core\Json::encode([1.0, 2.0, 3.5]), "\n";

// An `int` and a `float` with the same value give two different documents,
// and a round trip keeps the type.
echo Core\Json::encode(1), "|", Core\Json::encode(1.0), "\n";
echo Core\Json::encode(Core\Json::decode("1")), "|", Core\Json::encode(Core\Json::decode("1.0")), "\n";
--EXPECT--
0.0
-0.0
1.0
-7.0
6.0
1.0
3.0
1e+100
1e-7
1.5e+300
{"price":20.0,"qty":2.5}
[1.0,2.0,3.5]
1|1.0
1|1.0
