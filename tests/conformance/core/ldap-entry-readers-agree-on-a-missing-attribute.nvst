--TEST--
An `Ldap\Entry` read with `select` has only the attributes it named: `has` returns `false` for any other, and `string`, `strings` and `bytes` all return `null` for it — `rule:core-classes/ldap-value-types`
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");
?Core\Ldap\Entry $admin =$corp->read("CN=Administrator,CN=Users,DC=example,DC=test", {select: ["cn"]});
if ($admin == null) {
    echo "no entry", "\n";
} else {
    echo "dn: ", $admin->dn()->toString(), "\n";
    echo "has cn: ", $admin->has("CN") ? "yes" : "no", "\n";
    var $cn = $admin->bytes("cn");
    echo "cn as bytes: ", $cn == null ? "null" : Core\Bytes::length($cn), "\n";

    // `sAMAccountName` exists on the entry, but `select` did not name it.
    echo "has sAMAccountName: ", $admin->has("sAMAccountName") ? "yes" : "no", "\n";
    echo "string: ", $admin->string("sAMAccountName") == null ? "null" : "a value", "\n";
    echo "strings: ", $admin->strings("sAMAccountName") == null ? "null" : "a list", "\n";
    echo "bytes: ", $admin->bytes("sAMAccountName") == null ? "null" : "a value", "\n";
}
// covers: Core\Ldap\Entry::dn, Core\Ldap\Entry::has, Core\Ldap\Entry::string
// covers: Core\Ldap\Entry::strings, Core\Ldap\Entry::bytes
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://127.0.0.1:16636"
base = "DC=example,DC=test"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
dn: CN=Administrator,CN=Users,DC=example,DC=test
has cn: yes
cn as bytes: 13
has sAMAccountName: no
string: null
strings: null
bytes: null
