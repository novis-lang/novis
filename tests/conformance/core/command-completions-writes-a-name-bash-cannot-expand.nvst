--TEST--
`Core\Command::completions(Cli\Shell::Bash)` writes every command name and option spelling so that `compgen` cannot expand it, because `compgen -W` expands each word of its list — `rule:tooling/commands-are-compiled`
--FILE--
<?nvs
// `compgen -W` splits its list and then expands every word of it, so a name
// reaching that list unescaped is a command the user's own shell runs the
// moment they press Tab. The single quotes around the list do not stop it:
// they end when `bash` reads the script, and the expansion happens after that.
//
// Both lists are asserted here, because the names and the option spellings
// reach `compgen` down two different paths.
class Tool {
    #[Core\Command(name: "deploy", about: "Push the current build")]
    public static function deploy(
        string $target,
        #[Core\Option(long: "x$(echo pwned)", about: "An option that tries to run")]
        bool $flag = false,
    ): uint {
        return 0;
    }

    #[Core\Command(name: "run$(echo pwned)", about: "A name that tries to run")]
    public static function sneaky(): uint {
        return 0;
    }
}

echo Core\Command::completions(Core\Cli\Shell::Bash);
--EXPECT--
# bash completion for case — generated by Core\Command::completions
_case_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W 'deploy run\$(echo pwned)' -- "$cur"))
        return
    fi
    local options=''
    case "${COMP_WORDS[1]}" in
        'deploy') options='--x\$(echo pwned)' ;;
    esac
    COMPREPLY=($(compgen -W "$options" -- "$cur"))
}
complete -F _case_complete 'case'
