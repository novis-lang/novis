--TEST--
A property whose declared type carries `secret` renders as `[redacted]` however the receiver was spelled, and its value never reaches the record — `rule:errors/record-transformations`'s redaction row, property half; ADR 0033 § 1, § 4
--FILE--
<?nvs
// `rule:errors/record-transformations`: the *declared* type decides, so a `secret` slot is redacted
// beside its plain neighbours rather than the whole object being withheld.
class Account {
    public string $user = "ada";
    public secret string $token = "s3cr3t";
    public int $tries = 3;
}
Account $a = new Account();
echo Core\Debug::render($a), "\n";

// `rule:types/conversion`'s one unchecked position sees the same record: the bit is on
// the *instance*'s descriptor, not on the static type of the binding.
mixed $m = $a;
echo Core\Debug::render($m), "\n";

// ADR 0033 § 1's two axes are independent, and `secret` alone is what
// redacts: a `tainted` property is rendered, a `secret tainted` one is not.
class Axes {
    public tainted string $dirty = "d";
    public secret tainted string $both = "b";
}
Axes $x = new Axes();
echo Core\Debug::render($x), "\n";

// An inherited `secret` slot keeps its bit — the join is over the whole
// ancestor chain, in slot order.
class Base {
    public secret string $key = "k";
    public string $plain = "p";
}
class Derived extends Base {
    public secret string $own = "o";
    public int $n = 1;
}
echo Core\Debug::render(new Derived()), "\n";

// A nested object is redacted by *its own* class's declaration, one level
// down, which is what makes this a property rule rather than a top-level one.
class Holder {
    public function constructor(public Base $inner) {}
}
echo Core\Debug::render(new Holder(new Base())), "\n";

// `rule:classes/delegation-by-field`'s promoted parameter is a property, so it carries the bit too.
class Cred {
    public function constructor(public secret string $pw, public string $who) {}
}
echo Core\Debug::render(new Cred("hunter2", "ada")), "\n";

// The agreement the shape asks for: the rendering of a receiver spelled at
// its own type and of the same instance through `mixed` is one record, and
// neither of them contains the secret's own bytes. Counted rather than read
// off a line, so a spelling that grew a rendering of its own fails here.
Cred $c = new Cred("hunter2", "ada");
mixed $erased = $c;
string $typed = Core\Debug::render($c) as string;
string $through = Core\Debug::render($erased) as string;
int $agreed = 0;
if ($typed == $through) { $agreed = $agreed + 1; }
if (Core\Str::contains($typed, "[redacted]")) { $agreed = $agreed + 1; }
if (!Core\Str::contains($typed, "hunter2")) { $agreed = $agreed + 1; }
if (!Core\Str::contains($through, "hunter2")) { $agreed = $agreed + 1; }
echo "agreed=", $agreed, "/4\n";
--EXPECT--
Account#1 (3) {
  $user => string(3) "ada"
  $token => [redacted]
  $tries => int(3)
}
Account#1 (3) {
  $user => string(3) "ada"
  $token => [redacted]
  $tries => int(3)
}
Axes#1 (2) {
  $dirty => string(1) "d"
  $both => [redacted]
}
Derived#1 (4) {
  $key => [redacted]
  $plain => string(1) "p"
  $own => [redacted]
  $n => int(1)
}
Holder#1 (1) {
  $inner => Base#2 (2) {
    $key => [redacted]
    $plain => string(1) "p"
  }
}
Cred#1 (2) {
  $pw => [redacted]
  $who => string(3) "ada"
}
agreed=4/4
