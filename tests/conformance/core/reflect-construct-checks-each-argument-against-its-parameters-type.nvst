--TEST--
`Core\Reflect\ClassInfo::construct` checks each argument against the declared type of the constructor's parameter: an object of another class, an array with a wrong element, a variadic with a wrong element and an enum value no case has each throw a `LogicError`, and nothing is built — `rule:types/erased-member-access`
--FILE--
<?nvs
// covers: Core\Reflect\ClassInfo::construct
// `construct` checks each argument the way `is` checks it. A value of the
// wrong type throws a `LogicError` before the constructor runs.
enum Rank: int { Low = 1, High = 7 }
enum Other: int { One = 1, Three = 3 }

class Spot { public int $x = 5; }
class Stranger { public string $name = "stranger"; }

class Crate {
    public int $sum = 0;
    public string $rank = "";

    public function constructor(Spot $s, ?Spot $maybe, array<int> $ints, Rank $rank, int ...$more) {
        $this->sum = $s->x + $ints[0] + $more[0];
        $this->rank = $rank == Rank::High ? "High" : "Low";
    }
}

var $found = Core\Reflect::forClass("Crate");
if ($found == null) {
    echo "unreachable", "\n";
} else {
    Core\Reflect\ClassInfo $info = $found;

    // Values of the declared types. A variadic parameter takes its values as one array.
    mixed $built = $info->construct([new Spot(), null, [10], Rank::High, [100, 200]]);
    echo $info->get($built, "sum"), " ", $info->get($built, "rank"), "\n";

    // An object of another class where `Spot` is declared.
    try {
        mixed $notSpot = $info->construct([new Stranger(), null, [10], Rank::High, [100]]);
        echo "Spot: built", "\n";
    } catch (LogicError $e) {
        echo "Spot: LogicError", "\n";
    }

    // An object of another class where `?Spot` is declared.
    try {
        mixed $notMaybe = $info->construct([new Spot(), new Stranger(), [10], Rank::High, [100]]);
        echo "?Spot: built", "\n";
    } catch (LogicError $e) {
        echo "?Spot: LogicError", "\n";
    }

    // A string inside an array where `array<int>` is declared.
    try {
        mixed $notInts = $info->construct([new Spot(), null, ["ten"], Rank::High, [100]]);
        echo "array<int>: built", "\n";
    } catch (LogicError $e) {
        echo "array<int>: LogicError", "\n";
    }

    // A string among the values of `int ...$more`.
    try {
        mixed $notMore = $info->construct([new Spot(), null, [10], Rank::High, ["hundred"]]);
        echo "int ...: built", "\n";
    } catch (LogicError $e) {
        echo "int ...: LogicError", "\n";
    }

    // `Other::Three` is 3, and `Rank` has no case with that value.
    try {
        mixed $notRank = $info->construct([new Spot(), null, [10], Other::Three, [100]]);
        echo "Rank: built", "\n";
    } catch (LogicError $e) {
        echo "Rank: LogicError", "\n";
    }
}
--EXPECT--
115 High
Spot: LogicError
?Spot: LogicError
array<int>: LogicError
int ...: LogicError
Rank: LogicError
