--TEST--
`add` writes a new entry, `modify` applies `Change::add`, `remove`, `removeAll` and `replace` in one request, `rename` gives the entry a new name below another parent, and `delete` removes it, with an `int`, a `bool` and a `Dn` written in the form they are read — `rule:core-classes/ldap-value-types`
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
// covers: Core\Ldap\Connection::add, Core\Ldap\Connection::modify, Core\Ldap\Connection::delete
var $corp = Core\Ldap::connect("corp");
var $admin = Core\Ldap\Dn::parse("CN=Administrator,CN=Users,DC=example,DC=test");

// Each name ends in the process id, so two runs at the same time use different entries.
string $run = Core\Os::pid() as string;
string $blog = "OU=Blog-" . $run . ",DC=example,DC=test";
string $shop = "OU=Shop-" . $run . ",DC=example,DC=test";
string $store = "OU=Store," . $blog;

// A run that stopped half-way leaves its entries behind.
array<string> $leftovers = [$store, $shop, $blog];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $gone) {
    }
}

$corp->add($blog, ["objectClass" => "organizationalUnit"]);
$corp->add($shop, [
    "objectClass" => ["top", "organizationalUnit"],
    "description" => "one",
    "gPOptions" => 1,
    "managedBy" => $admin,
]);
?Core\Ldap\Entry $entry = $corp->read($shop, {select: ["gPOptions", "managedBy"]});
echo "gPOptions: ", $entry?->int("gPOptions") ?? "null", "\n";
echo "managedBy: ", $entry?->string("managedBy") ?? "null", "\n";

// The four changes are one request, applied in this order.
$corp->modify($shop, [
    Core\Ldap\Change::add("description", "two"),
    Core\Ldap\Change::remove("description", "one"),
    Core\Ldap\Change::removeAll("managedBy"),
    Core\Ldap\Change::replace("showInAdvancedViewOnly", true),
]);
$entry = $corp->read($shop, {select: ["description", "managedBy", "showInAdvancedViewOnly"]});
var $descriptions = $entry?->strings("description");
echo "description: ", $descriptions == null ? "null" : Core\Str::join($descriptions, ", "), "\n";
echo "managedBy: ", $entry?->has("managedBy") ? "set" : "removed", "\n";
echo "showInAdvancedViewOnly: ", $entry?->bool("showInAdvancedViewOnly") ? "true" : "false", "\n";

// The new DN has another parent, so the entry moves below it.
$corp->rename($shop, Core\Ldap\Dn::parse($store));
echo "old name: ", $corp->read($shop) == null ? "gone" : "still there", "\n";
?Core\Ldap\Entry $moved =$corp->read($store, {select: ["description"]});
echo "new name: ", $moved?->string("description") ?? "null", "\n";

$corp->delete($store);
$corp->delete($blog);
echo "deleted: ", $corp->read($blog) == null ? "yes" : "no", "\n";
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://127.0.0.1:16636"
base = "DC=example,DC=test"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
gPOptions: 1
managedBy: CN=Administrator,CN=Users,DC=example,DC=test
description: two
managedBy: removed
showInAdvancedViewOnly: true
old name: gone
new name: two
deleted: yes
