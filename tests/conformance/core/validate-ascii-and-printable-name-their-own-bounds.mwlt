--TEST--
`Core\Validate::isAscii` and `isPrintable` each name the last code point they accept beside the first they refuse, and the sweep between the two bounds counts the four cells they carve out — docs/spec/01-core-library.md § 12
--FILE--
<?mwl
// § 12's two character-class predicates draw two *different* lines over the
// same subject: `isAscii` asks an encoding question (every byte under `0x80`)
// and `isPrintable` a Unicode one (no `char` in general category `Cc`).
// `validate-ip-families-and-the-two-byte-classes.mwlt` crosses them at three
// named subjects; this case pins where each line actually falls, by naming the
// last code point accepted beside the first refused, so a member that stops one
// entry early still prints plausibly against either half alone.
//
// `crates/mwl-stdlib/src/validate.rs`'s module doc owns why these are two
// questions rather than one asked twice, and why `isPrintable` is not a
// spoofing check.
final class Cp {
    // A single code point as a `string`. `Core\Str::fromCodePoint` takes a
    // `uint`, so the sweep's `int` counter is converted at the argument.
    public static function one(int $c): string {
        return Core\Str::fromCodePoint($c as uint);
    }

    public static function yn(bool $b): string {
        return $b ? "y" : "n";
    }
}

// `isPrintable` from both ends of the printable ASCII block: `US` (0x1F) is the
// last `Cc` below it and `SPACE` (0x20) the first code point above, then `~`
// (0x7E) is the last accepted and `DEL` (0x7F) the first refused.
echo "printable-bound ",
     Cp::yn(Core\Validate::isPrintable(Cp::one(31))),
     Cp::yn(Core\Validate::isPrintable(Cp::one(32))),
     Cp::yn(Core\Validate::isPrintable(Cp::one(126))),
     Cp::yn(Core\Validate::isPrintable(Cp::one(127))),
     "\n";

// `isAscii`'s own bound sits one code point past where `isPrintable`'s did:
// `DEL` (0x7F) is the last it accepts, `U+0080` the first it refuses. That
// single-entry offset is the whole difference between the two questions at the
// top of the ASCII range.
echo "ascii-bound ",
     Cp::yn(Core\Validate::isAscii(Cp::one(127))),
     Cp::yn(Core\Validate::isAscii(Cp::one(128))),
     "\n";

// The C1 block is `Cc` as well, so `isPrintable` refuses through `U+009F` and
// accepts again at `U+00A0` — which `isAscii` refuses for the unrelated reason
// that it is two bytes. Both bounds of the second unprintable run, named beside
// the answer `isAscii` gives across it.
echo "c1-bound ",
     Cp::yn(Core\Validate::isPrintable(Cp::one(159))),
     Cp::yn(Core\Validate::isPrintable(Cp::one(160))),
     Cp::yn(Core\Validate::isAscii(Cp::one(159))),
     Cp::yn(Core\Validate::isAscii(Cp::one(160))),
     "\n";

// Every code point from `U+0000` to `U+010F` sorted into the four cells the two
// predicates carve out. The counts are what makes this a bound rather than four
// more rows: 95 printable ASCII (0x20..0x7E), 33 ASCII that is not printable
// (0x00..0x1F and `DEL`), 32 that is neither (the C1 block), and 112 printable
// non-ASCII (0x00A0..0x010F). A predicate whose line moved by one entry moves
// two of these counts.
int $both = 0;
int $asciiOnly = 0;
int $neither = 0;
int $printableOnly = 0;
int $c = 0;
for (; $c < 272; $c = $c + 1) {
    var $s = Cp::one($c);
    if (Core\Validate::isAscii($s)) {
        if (Core\Validate::isPrintable($s)) {
            $both = $both + 1;
        } else {
            $asciiOnly = $asciiOnly + 1;
        }
    } else {
        if (Core\Validate::isPrintable($s)) {
            $printableOnly = $printableOnly + 1;
        } else {
            $neither = $neither + 1;
        }
    }
}
echo "sweep ", $both as string, "|", $asciiOnly as string, "|",
     $neither as string, "|", $printableOnly as string, "\n";

// The same three bounds again, this time *searched for* rather than named, so
// the numbers are the bounds instead of asserting them: the run of accepted
// code points `isAscii` allows from `U+0000` is 128 long, the run `isPrintable`
// allows from `SPACE` is 95 long, and the run it refuses from `DEL` is 33 long.
int $ascii = 0;
int $i = 0;
for (; $i < 400; $i = $i + 1) {
    if (!Core\Validate::isAscii(Cp::one($i))) {
        break;
    }
    $ascii = $ascii + 1;
}

int $printable = 0;
int $j = 32;
for (; $j < 400; $j = $j + 1) {
    if (!Core\Validate::isPrintable(Cp::one($j))) {
        break;
    }
    $printable = $printable + 1;
}

int $unprintable = 0;
int $k = 127;
for (; $k < 400; $k = $k + 1) {
    if (Core\Validate::isPrintable(Cp::one($k))) {
        break;
    }
    $unprintable = $unprintable + 1;
}

echo "runs ", $ascii as string, "|", $printable as string, "|",
     $unprintable as string, "\n";
--EXPECT--
printable-bound nyyn
ascii-bound yn
c1-bound nynn
sweep 95|33|32|112
runs 128|95|33
