--TEST--
`Ad\AccountFlags::mustChangePassword` is `true` exactly where `pwdLastSet` is `0`, agrees whether or not `select` names `pwdLastSet`, and a copy from `with` keeps it — `rule:core-classes/ldap-value-types`
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");
var $users = Core\Ldap\Dn::parse("CN=Users,DC=example,DC=test");
array<string> $names = ["Administrator", "Guest", "krbtgt"];
foreach ($names as string $name) {
    var $dn = $users->child("CN", $name);
    // `read` asks for `pwdLastSet` itself when `userAccountControl` is selected.
    ?Core\Ldap\Ad\AccountFlags $flags = $corp->read($dn, {select: ["userAccountControl"]})?->accountFlags();
    ?Core\Ldap\Entry $both = $corp->read($dn, {select: ["userAccountControl", "pwdLastSet"]});
    ?Core\Ldap\Ad\AccountFlags $named = $both?->accountFlags();
    if ($flags == null || $named == null || $both == null) {
        echo $name, ": no flags", "\n";
        continue;
    }
    echo $name, ": ", $flags->mustChangePassword() ? "must change" : "no change", "\n";
    echo "  agrees with select: ", $flags->mustChangePassword() == $named->mustChangePassword() ? "yes" : "no", "\n";
    echo "  agrees with pwdLastSet: ", $flags->mustChangePassword() == ($both->instant("pwdLastSet") == null) ? "yes" : "no", "\n";
    echo "  kept by with: ", $flags->with({disabled: true})->mustChangePassword() == $flags->mustChangePassword() ? "yes" : "no", "\n";
}
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://localhost:16636"
base = "DC=example,DC=test"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
Administrator: no change
  agrees with select: yes
  agrees with pwdLastSet: yes
  kept by with: yes
Guest: must change
  agrees with select: yes
  agrees with pwdLastSet: yes
  kept by with: yes
krbtgt: no change
  agrees with select: yes
  agrees with pwdLastSet: yes
  kept by with: yes
