--TEST--
`Core\Uri::parseQuery` at the edges of a name: an empty pair contributes nothing, a valueless one contributes the empty string, and a malformed or unusual name is kept whole rather than repaired — spec § 12
--FILE--
<?nvs
// A value is `bytes` (spec § 12) and `Core\Json::encode` has no encoding for
// one, so the shape is rendered through this walk. Every row below is about a
// *name*, and a name is the array key the pair is filed under, so it is a
// `string` either way.
class Shape {
    public static function of(string $query): string {
        return Core\Json::encode(Shape::textual(Core\Uri::parseQuery($query)));
    }

    public static function textual(array<mixed> $values): array<mixed> {
        array<mixed> $out = [];
        foreach ($values as tainted string $key => mixed $value) {
            ?array<mixed> $nested = $value as ?array<mixed>;
            if ($nested == null) {
                $out[$key] = $value as bytes as string;
            } else {
                $out[$key] = Shape::textual($nested);
            }
        }
        return $out;
    }
}

// The two ends of "is there a pair here at all": nothing at all, and a string
// that is only separators, both answer the empty array. A pair with a name and
// no `=` is a pair — its value is the empty string, exactly as `a=` is.
echo Shape::of(""), "\n";
echo Shape::of("&&a=1&"), "\n";
echo Shape::of("a"), "|", Shape::of("a="), "\n";

// A pair with no *name* is the one that is dropped: there is no key to file it
// under, and inventing one would file two of them together.
echo Shape::of("=1"), "\n";

// `nvs_stdlib::uri`'s module doc: a name is a path only when it is a non-empty
// base followed by complete `[…]` groups, so a name that is not becomes one
// literal key. PHP repairs `a[b` into `a_b`; keeping it is what makes the
// answer say what actually arrived.
echo Shape::of("a[b=1"), "|", Shape::of("a[]"), "\n";

// The same rule, from the other side: a `.` or a space is a perfectly good key
// here, since the answer is an array rather than the variables `parse_str` was
// written to create. Rewriting them would merge `a.b` with `a_b`.
echo Shape::of("a.b=1&c d=2"), "\n";

// And the `?` is not part of the query component, so a caller that leaves it on
// gets it as the first byte of the first name rather than a silent trim.
echo Shape::of("?a=1"), "\n";

// Depth is uniform: an append inside an append, and a list under a map key.
// The last row is last-write-wins across two *shapes*, which is the case a
// scalar-then-map ordering decides.
echo Shape::of("a[][]=1"), "\n";
echo Shape::of("a[b][]=1&a[b][]=2"), "\n";
echo Shape::of("a=1&a[b]=2"), "\n";

// A name that is not text has no key to be — an array key is a `string`, which
// is the one refusal left in this member now that a value answers octets.
try {
    echo Shape::of("%FF=1"), "\n";
} catch (RuntimeError $e) {
    echo "a name outside UTF-8: refused\n";
}
--EXPECT--
[]
{"a":"1"}
{"a":""}|{"a":""}
[]
{"a[b":"1"}|{"a":[""]}
{"a.b":"1","c d":"2"}
{"?a":"1"}
{"a":[["1"]]}
{"a":{"b":["1","2"]}}
{"a":{"b":"2"}}
a name outside UTF-8: refused
