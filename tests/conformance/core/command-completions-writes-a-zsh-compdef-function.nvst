--TEST--
`Core\Command::completions(Cli\Shell::Zsh)` writes a `#compdef` function whose command word is a `_describe` and whose options are an `_arguments` — ADR 0086 § 6
--FILE--
<?nvs
class Deployer {
    #[Core\Command(name: "deploy", about: "Push the current build")]
    public static function deploy(
        string $target,
        #[Core\Option(short: "n", about: "Print what would happen")] bool $dryRun = false,
    ): uint {
        return 0;
    }

    #[Core\Command(name: "version")]
    public static function version(): uint {
        return 0;
    }
}

// Each script is written in its own shell's idiom rather than in one shape bent
// four ways — `crates/nvs-stdlib/src/command.rs` owns why. What this pins of
// zsh's: a command that declared an `about:` carries it past the colon
// `_describe` splits on, and one that declared none is the bare name rather
// than a name with an empty description hanging off a colon.
//
// An option contributes one `_arguments` spec per spelling, both carrying the
// same `about:`: zsh is being told two things it may offer, not that the two
// are one option, because the table numbers spellings and not options.
echo Core\Command::completions(Core\Cli\Shell::Zsh);
--EXPECT--
#compdef case
# zsh completion for case — generated by Core\Command::completions
_case() {
    local -a commands
    commands=(
        'deploy:Push the current build'
        'version'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
        return
    fi
    case "${words[2]}" in
        'deploy') _arguments '-n[Print what would happen]' '--dryRun[Print what would happen]' ;;
    esac
}
_case "$@"
