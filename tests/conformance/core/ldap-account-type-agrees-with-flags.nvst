--TEST--
Across the whole domain, `accountType()` agrees with the flags: `User` for a normal account, `Machine` for a computer or a domain controller, `Group` or `Alias` by the group's scope, and every flag reader agrees with `bits()` — `rule:core-classes/ldap-value-types`
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");
int $machines = 0;
bool $typeAgrees = true;
bool $readersAgree = true;
var $either = Core\Ldap\Filter::any(Core\Ldap\Filter::present("userAccountControl"), Core\Ldap\Filter::present("groupType"));
foreach ($corp->search($either, {select: ["userAccountControl", "groupType", "sAMAccountType"]}) as Core\Ldap\Entry $entry) {
    var $kind = $entry->accountType();
    ?Core\Ldap\Ad\AccountFlags $flags = $entry->accountFlags();
    if ($flags != null) {
        bool $machine = $flags->workstationTrustAccount() || $flags->serverTrustAccount();
        $machines = $machines + ($machine ? 1 : 0);
        if ($machine) {
            $typeAgrees = $typeAgrees && $kind == Core\Ldap\Ad\AccountType::Machine;
        } else if ($flags->interdomainTrustAccount()) {
            $typeAgrees = $typeAgrees && $kind == Core\Ldap\Ad\AccountType::Trust;
        } else if ($flags->normalAccount()) {
            $typeAgrees = $typeAgrees && $kind == Core\Ldap\Ad\AccountType::User;
        }
        int $sum = ($flags->script() ? 1 : 0) + ($flags->disabled() ? 2 : 0)
            + ($flags->homeDirectoryRequired() ? 8 : 0) + ($flags->lockedOut() ? 16 : 0)
            + ($flags->passwordNotRequired() ? 32 : 0) + ($flags->reversibleEncryption() ? 128 : 0)
            + ($flags->temporaryDuplicateAccount() ? 256 : 0) + ($flags->normalAccount() ? 512 : 0)
            + ($flags->interdomainTrustAccount() ? 2048 : 0) + ($flags->workstationTrustAccount() ? 4096 : 0)
            + ($flags->serverTrustAccount() ? 8192 : 0) + ($flags->passwordNeverExpires() ? 65536 : 0)
            + ($flags->mnsLogonAccount() ? 131072 : 0) + ($flags->smartcardRequired() ? 262144 : 0)
            + ($flags->trustedForDelegation() ? 524288 : 0) + ($flags->notDelegated() ? 1048576 : 0)
            + ($flags->useDesKeyOnly() ? 2097152 : 0) + ($flags->noPreauthRequired() ? 4194304 : 0)
            + ($flags->passwordExpired() ? 8388608 : 0) + ($flags->trustedToAuthForDelegation() ? 16777216 : 0)
            + ($flags->partialSecretsAccount() ? 67108864 : 0);
        $readersAgree = $readersAgree && $sum == ($flags->bits() & 100614075);
    }
    ?Core\Ldap\Ad\GroupType $type = $entry->groupType();
    if ($type != null) {
        // A security group is `Group`, or `Alias` when it is domain local.
        // A group without the security bit is a distribution group.
        if ($type->security()) {
            $typeAgrees = $typeAgrees && $kind == ($type->domainLocal() ? Core\Ldap\Ad\AccountType::Alias : Core\Ldap\Ad\AccountType::Group);
        } else {
            $typeAgrees = $typeAgrees && $kind == ($type->domainLocal() ? Core\Ldap\Ad\AccountType::NonSecurityAlias : Core\Ldap\Ad\AccountType::NonSecurityGroup);
        }
        int $groupSum = ($type->system() ? 1 : 0) + ($type->global() ? 2 : 0)
            + ($type->domainLocal() ? 4 : 0) + ($type->universal() ? 8 : 0)
            + ($type->appBasic() ? 16 : 0) + ($type->appQuery() ? 32 : 0)
            + ($type->security() ? 2147483648 : 0);
        $readersAgree = $readersAgree && $groupSum == ($type->bits() & 2147483711);
    }
}
echo "some machines: ", $machines > 0 ? "yes" : "no", "\n";
echo "account type agrees with flags: ", $typeAgrees ? "yes" : "no", "\n";
echo "readers agree with bits: ", $readersAgree ? "yes" : "no", "\n";
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://localhost:16636"
base = "DC=example,DC=test"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
some machines: yes
account type agrees with flags: yes
readers agree with bits: yes
