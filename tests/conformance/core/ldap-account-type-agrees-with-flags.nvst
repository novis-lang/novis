--TEST--
Across the whole domain, `accountType()` agrees with the flags: `User` for a normal account, `Machine` for a computer or a domain controller, `Group` or `Alias` by the group's scope, and every reader of a flag AD stores agrees with `bits()`, which leaves out the two AD computes, `lockedOut` and `passwordExpired` — `rule:core-classes/ldap-value-types`
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");
int $machines = 0;
bool $typeAgrees = true;
bool $readersAgree = true;
var $either = Core\Ldap\Filter::any(Core\Ldap\Filter::present("userAccountControl"), Core\Ldap\Filter::present("groupType"));
foreach ($corp->search($either, {select: ["userAccountControl", "groupType", "sAMAccountType"]}) as Core\Ldap\Entry $entry) {
    var $kind = $entry->accountType();
    ?Core\Ldap\Ad\AccountFlags $flags = $entry->accountFlags();
    if ($flags != null) {
        bool $machine = $flags->isWorkstationTrustAccount() || $flags->isServerTrustAccount();
        $machines = $machines + ($machine ? 1 : 0);
        if ($machine) {
            $typeAgrees = $typeAgrees && $kind == Core\Ldap\Entry::AccountType::Machine;
        } else if ($flags->isInterdomainTrustAccount()) {
            $typeAgrees = $typeAgrees && $kind == Core\Ldap\Entry::AccountType::Trust;
        } else if ($flags->isNormalAccount()) {
            $typeAgrees = $typeAgrees && $kind == Core\Ldap\Entry::AccountType::User;
        }
        int $sum = ($flags->hasLogonScript() ? 1 : 0) + ($flags->isDisabled() ? 2 : 0)
            + ($flags->isHomeDirectoryRequired() ? 8 : 0)
            + ($flags->isPasswordNotRequired() ? 32 : 0) + ($flags->allowsReversibleEncryption() ? 128 : 0)
            + ($flags->isTemporaryDuplicateAccount() ? 256 : 0) + ($flags->isNormalAccount() ? 512 : 0)
            + ($flags->isInterdomainTrustAccount() ? 2048 : 0) + ($flags->isWorkstationTrustAccount() ? 4096 : 0)
            + ($flags->isServerTrustAccount() ? 8192 : 0) + ($flags->hasNonExpiringPassword() ? 65536 : 0)
            + ($flags->isMnsLogonAccount() ? 131072 : 0) + ($flags->isSmartcardRequired() ? 262144 : 0)
            + ($flags->isTrustedForDelegation() ? 524288 : 0) + ($flags->isNotDelegated() ? 1048576 : 0)
            + ($flags->usesDesKeyOnly() ? 2097152 : 0) + ($flags->isPreauthNotRequired() ? 4194304 : 0)
            + ($flags->isTrustedToAuthenticateForDelegation() ? 16777216 : 0)
            + ($flags->isPartialSecretsAccount() ? 67108864 : 0);
        $readersAgree = $readersAgree && $sum == ($flags->bits() & 92225451);
    }
    ?Core\Ldap\Ad\GroupType $type = $entry->groupType();
    if ($type != null) {
        // A security group is `Group`, or `Alias` when it is domain local.
        // A group without the security bit is a distribution group.
        if ($type->isSecurityGroup()) {
            $typeAgrees = $typeAgrees && $kind == ($type->isDomainLocal() ? Core\Ldap\Entry::AccountType::Alias : Core\Ldap\Entry::AccountType::Group);
        } else {
            $typeAgrees = $typeAgrees && $kind == ($type->isDomainLocal() ? Core\Ldap\Entry::AccountType::NonSecurityAlias : Core\Ldap\Entry::AccountType::NonSecurityGroup);
        }
        int $groupSum = ($type->isSystemGroup() ? 1 : 0) + ($type->isGlobal() ? 2 : 0)
            + ($type->isDomainLocal() ? 4 : 0) + ($type->isUniversal() ? 8 : 0)
            + ($type->isAppBasicGroup() ? 16 : 0) + ($type->isAppQueryGroup() ? 32 : 0)
            + ($type->isSecurityGroup() ? 2147483648 : 0);
        $readersAgree = $readersAgree && $groupSum == ($type->bits() & 2147483711);
    }
}
echo "some machines: ", $machines > 0 ? "yes" : "no", "\n";
echo "account type agrees with flags: ", $typeAgrees ? "yes" : "no", "\n";
echo "readers agree with bits: ", $readersAgree ? "yes" : "no", "\n";
// covers: Core\Ldap\Entry::accountType, Core\Ldap\Entry::accountFlags, Core\Ldap\Entry::groupType, Core\Ldap\Entry::AccountType
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://127.0.0.1:16636"
base = "DC=example,DC=test"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
some machines: yes
account type agrees with flags: yes
readers agree with bits: yes
