--TEST--
`Core\Command::completions(Cli\Shell::Pwsh)` writes a `Register-ArgumentCompleter -Native` block that filters the table's own words — ADR 0086 § 6
--FILE--
<?nvs
class Deployer {
    #[Core\Command(name: "deploy", about: "Push the current build")]
    public static function deploy(
        string $target,
        #[Core\Option(short: "n", about: "Print what would happen")] bool $dryRun = false,
    ): uint {
        return 0;
    }

    #[Core\Command(name: "version")]
    public static function version(): uint {
        return 0;
    }
}

// PowerShell hands a completer the whole command AST rather than a word index,
// and the word being typed is itself one of its elements — which is why the
// block below selects a command only once some *other* word precedes it, and
// why nothing here counts positions the way the `bash` script does.
echo Core\Command::completions(Core\Cli\Shell::Pwsh);
--EXPECT--
# PowerShell completion for case — generated by Core\Command::completions
Register-ArgumentCompleter -Native -CommandName 'case' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)
    $words = @($commandAst.CommandElements | Select-Object -Skip 1 | ForEach-Object { $_.ToString() })
    $command = if ($words.Count -gt 0 -and $words[0] -ne $wordToComplete) { $words[0] } else { '' }
    $candidates = @()
    if ($command -eq '') {
        $candidates = @('deploy', 'version')
    } else {
        switch ($command) {
            'deploy' { $candidates = @('-n', '--dryRun') }
        }
    }
    $candidates | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
        [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
    }
}
