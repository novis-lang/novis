--TEST--
`Core\BigInt`'s `gcd`, `lcm`, `sqrt`, `raisedTo`, `raisedToModulo` and the two shifts each answer their own definition over a sweep rather than a table of remembered answers — `rule:types/arithmetic`
--FILE--
<?nvs
// The number-theory members are each defined by an identity, and asserting the
// identity rather than a table of answers is what catches a member that is
// right on the pairs somebody thought of. Every line below counts.
// covers: Core\BigInt::gcd, Core\BigInt::lcm
array<int> $lefts = [0, 1, 6, 12, 17, 360, -48];
array<int> $rights = [1, 4, 6, 18, 25, 97, -30];
int $pairs = 0;
int $product = 0;
int $divides = 0;
foreach ($lefts as int $a) {
    foreach ($rights as int $b) {
        $pairs = $pairs + 1;
        var $left = Core\BigInt::of($a);
        var $right = Core\BigInt::of($b);
        var $gcd = $left->gcd($right);
        var $lcm = $left->lcm($right);
        // gcd × lcm is the product's magnitude, at every sign and including
        // the zero row, where both sides are zero.
        if ($gcd->multipliedBy($lcm)->compareTo($left->multipliedBy($right)->abs()) == 0) {
            $product = $product + 1;
        }
        // And the gcd divides both operands exactly.
        if ($gcd->sign() != 0 && $left->remainder($gcd)->sign() == 0 && $right->remainder($gcd)->sign() == 0) {
            $divides = $divides + 1;
        }
    }
}
echo "pairs ", $pairs, " product ", $product, " divides ", $divides, "\n";

// `sqrt` is the floor, which is two inequalities rather than one number: the
// root squared does not exceed the value and the next one up does.
int $bracketed = 0;
int $n = 0;
while ($n <= 40) {
    var $square = Core\BigInt::of($n * $n * 7 + $n);
    var $root = $square->sqrt();
    if ($root->raisedTo(2)->compareTo($square) <= 0 && $root->plus(Core\BigInt::of(1))->raisedTo(2)->compareTo($square) > 0) {
        $bracketed = $bracketed + 1;
    }
    $n = $n + 1;
}
echo "bracketed ", $bracketed, " of 41, sqrt(10^20) ", Core\BigInt::of(10)->raisedTo(20)->sqrt()->toUint(), "\n";

// `raisedToModulo` is `raisedTo` then `remainder` wherever the whole power can be held, which is
// what says the fast path answers the definition rather than its own thing.
int $modular = 0;
uint $exponent = 0;
var $modulus = Core\BigInt::of(497);
while ($exponent <= 20) {
    var $base = Core\BigInt::of(4);
    if ($base->raisedToModulo(Core\BigInt::ofUint($exponent), $modulus)->compareTo($base->raisedTo($exponent)->remainder($modulus)) == 0) {
        $modular = $modular + 1;
    }
    $exponent = $exponent + 1;
}
echo "modular ", $modular, " of 21, 4^13 mod 497 = ", Core\BigInt::of(4)->raisedToModulo(Core\BigInt::of(13), $modulus)->toInt(), "\n";

// A negative receiver is where the two part: `raisedToModulo` gives the least
// non-negative residue, and `remainder` keeps the sign of the number it divides.
var $negative = Core\BigInt::of(-3);
echo "residue ", $negative->raisedToModulo(Core\BigInt::of(3), Core\BigInt::of(7))->toInt(), " but remainder ", $negative->raisedTo(3)->remainder(Core\BigInt::of(7))->toInt(), "\n";

// A shift is a multiplication and a division by a power of two, and the second
// one rounds toward negative infinity — which is where it parts from `dividedBy`.
var $value = Core\BigInt::of(-9);
echo "shl ", $value->shiftedLeft(3)->toInt(), " = ", $value->multipliedBy(Core\BigInt::of(8))->toInt(), "\n";
echo "shr ", $value->shiftedRight(1)->toInt(), " but div ", $value->dividedBy(Core\BigInt::of(2))->toInt(), "\n";
echo "neg ", $value->negated()->toString(), " format ", $value->format({radix: 16}), " parse ", Core\BigInt::parse("-9")->compareTo($value), "\n";
echo "decimal ", Core\BigInt::of(360)->gcd(Core\BigInt::of(48))->toDecimal(), " uint ", Core\BigInt::of(360)->lcm(Core\BigInt::of(48))->toUint(), "\n";
--EXPECT--
pairs 49 product 49 divides 49
bracketed 41 of 41, sqrt(10^20) 10000000000
modular 21 of 21, 4^13 mod 497 = 445
residue 1 but remainder -6
shl -72 = -72
shr -5 but div -4
neg 9 format -9 parse 0
decimal 24 uint 720
