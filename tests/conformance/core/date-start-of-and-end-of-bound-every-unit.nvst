--TEST--
`Core\Time\Date`'s `startOf` and `endOf` bound the week, month, quarter and year of every day of a leap year: each start is on or before the day and each end on or after it, a week is seven days from Monday to Sunday, a month is `daysInMonth()` days, a quarter starts in the month `quarter()` names, and the day after an end starts the next unit; at the ends of the calendar a week past `9999` throws and the rest return the last day
--FILE--
<?nvs
// covers: Core\Time\Date::startOf, Core\Time\Date::endOf, Core\Time\Date::daysInMonth, Core\Time\Date::quarter
use Core\Unit;
use Core\Time\Date;
use Core\Time\Weekday;

// Every day of 2024 and the first days of 2025, counted against each agreement.
int $bounded = 0;
int $weeks = 0;
int $months = 0;
int $quarters = 0;
int $years = 0;
int $next = 0;
var $day = Date::at(2023, 12, 25);
int $count = 0;
while ($count < 380) {
    var $ws = $day->startOf(Unit::Week);
    var $we = $day->endOf(Unit::Week);
    var $ms = $day->startOf(Unit::Month);
    var $me = $day->endOf(Unit::Month);
    var $qs = $day->startOf(Unit::Quarter);
    var $qe = $day->endOf(Unit::Quarter);
    var $ys = $day->startOf(Unit::Year);
    var $ye = $day->endOf(Unit::Year);
    if ($ws <= $day && $day <= $we && $ms <= $day && $day <= $me
        && $qs <= $day && $day <= $qe && $ys <= $day && $day <= $ye) {
        $bounded = $bounded + 1;
    }
    if ($ws->weekday() == Weekday::Monday && $we->weekday() == Weekday::Sunday
        && $ws->difference($we, Unit::Day) == 6) {
        $weeks = $weeks + 1;
    }
    if ($ms->day() == 1 && $me->day() == $day->daysInMonth() && $me->month() == $day->month()
        && $ms->difference($me, Unit::Day) == ($day->daysInMonth() as int) - 1) {
        $months = $months + 1;
    }
    if ($qs->day() == 1 && $qs->month() == ($day->quarter() - 1) * 3 + 1
        && $qe->quarter() == $day->quarter() && $qs->difference($qe->plus(1, Unit::Day), Unit::Month) == 3) {
        $quarters = $quarters + 1;
    }
    if ($ys->toIso() == $day->year() . '-01-01' && $ye->toIso() == $day->year() . '-12-31') {
        $years = $years + 1;
    }
    if ($we->plus(1, Unit::Day)->compareTo($we->plus(1, Unit::Day)->startOf(Unit::Week)) == 0
        && $me->plus(1, Unit::Day)->day() == 1 && $ye->plus(1, Unit::Day)->dayOfYear() == 1) {
        $next = $next + 1;
    }
    $day = $day->plus(1, Unit::Day);
    $count = $count + 1;
}
echo $bounded, ' ', $weeks, ' ', $months, ' ', $quarters, ' ', $years, ' ', $next, "\n";

// The ends of the calendar.
var $first = Date::at(-9999, 1, 1);
var $last = Date::at(9999, 12, 31);
echo $first->startOf(Unit::Week)->toIso(), ' ', $first->startOf(Unit::Year)->toIso(), "\n";
echo $last->endOf(Unit::Month)->toIso(), ' ', $last->endOf(Unit::Quarter)->toIso(), ' ', $last->endOf(Unit::Year)->toIso(), "\n";
try {
    $last->endOf(Unit::Week);
    echo "no error\n";
} catch (RuntimeError $e) {
    echo "RuntimeError\n";
}

// Quarters and month lengths, one row per month of a leap year and of a common year.
string $row = '';
uint $month = 1;
while ($month <= 12) {
    $row = $row . Date::at(2024, $month, 1)->quarter() . ':' . Date::at(2024, $month, 1)->daysInMonth()
        . '/' . Date::at(2023, $month, 1)->daysInMonth() . ' ';
    $month = $month + 1;
}
echo $row, "\n";
--EXPECT--
380 380 380 380 380 380
-9999-01-01 -9999-01-01
9999-12-31 9999-12-31 9999-12-31
RuntimeError
1:31/31 1:29/28 1:31/31 2:30/30 2:31/31 2:30/30 3:31/31 3:31/31 3:30/30 4:31/31 4:30/30 4:31/31
