--TEST--
`Core\Router\Match::attribute<T>()` is `null` for a route whose method has no attribute of the declaration it names, even where another route's method and a method with no `#[Route]` have one — `rule:routing/a-match-reads-an-attribute-as-data`
--FILE--
<?nvs
// covers: Core\Router\Match::attribute
attribute Limit on method { limit: int }

class Shop {
    #[Core\Route(path: "/shop", method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function index(): void {}

    #[Core\Route(path: "/cart", method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    #[Limit(limit: 10)]
    public function cart(): void {}

    #[Limit(limit: 99)]
    public function helper(): void {}
}

?Core\Router\Match $shop = Core\Router::match(Core\Http\Method::Get, "/shop");
var $none = $shop?->attribute<Limit>();
echo "shop: ", $none == null ? "null" : "found", "\n";

?Core\Router\Match $cart = Core\Router::match(Core\Http\Method::Get, "/cart");
var $limit = $cart?->attribute<Limit>();
if ($limit != null) {
    echo "cart: ", $limit->limit as string, "\n";
}

// A method reference returns the same attribute when it is called.
if ($cart != null) {
    var $read = $cart->attribute<Limit>(...);
    var $again = $read();
    if ($again != null) {
        echo "reference: ", $again->limit as string, "\n";
    }
}
--EXPECT--
shop: null
cart: 10
reference: 10
