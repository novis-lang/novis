--TEST--
a `secret` property of a `#[Json\Derive]` class is filled by its decoder, and a value of that class reaching the encoder as `mixed` throws naming the property — `rule:security/derived-codec-qualifiers`
--FILE--
<?nvs
// covers: lang:attributes/core-json-derive-and-core-json-field-a-class-with-a-json-codec
#[Core\Json\Derive]
class Login {
    public tainted string $user;
    public secret tainted string $password;

    public function constructor(tainted string $user, secret tainted string $password) {
        $this->user = $user;
        $this->password = $password;
    }
}

var $login = Core\Json::decodeAs<Login>('{"user":"ada","password":"pw-1"}');
echo $login->user, "\n";
echo Core\Str::length(Core\Secret::reveal($login->password, "the test reads it")), "\n";
mixed $any = $login;
try {
    echo Core\Json::encode($any);
} catch (LogicError $e) {
    echo $e->message, "\n";
}
try {
    echo Core\Json::encode([$login]);
} catch (LogicError $e) {
    echo $e->message, "\n";
}
--EXPECT--
ada
4
Core\Json::encode(): an instance of `Login` cannot be encoded, because its property `$password` is `secret`
Core\Json::encode(): an instance of `Login` cannot be encoded, because its property `$password` is `secret`
