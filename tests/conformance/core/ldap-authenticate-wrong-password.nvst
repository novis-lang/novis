--TEST--
`authenticate` throws `Core\Ldap\LdapError` with the kind `InvalidCredentials` for a wrong password and for a user that does not exist, with the same message and no password in it
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
// covers: Core\Ldap\LdapError, Core\Ldap\LdapError::Kind
var $corp = Core\Ldap::connect("corp");

// Each name ends in the process id, so two runs at the same time use different entries.
string $run = Core\Os::pid() as string;
string $account = "Clients-" . $run;
string $unit = "OU=" . $account . ",DC=example,DC=test";
var $clients = "CN=" . $account . "," . $unit;

// A run that stopped half-way leaves the account behind.
array<string> $leftovers = [$clients, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $gone) {
    }
}
$corp->add($unit, ["objectClass" => "organizationalUnit"]);
$corp->add($clients, ["objectClass" => "user", "sAMAccountName" => $account]);
$corp->setPassword($clients, "Clients-first-Pass-7");
$corp->modify($clients, [Core\Ldap\Change::replace("userAccountControl", 512)]);

string $wrong = "";
try {
    $corp->authenticate($clients, "Clients-wrong-Pass-8");
    echo "wrong password: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "wrong password: ", $refused->kind == Core\Ldap\LdapError::Kind::InvalidCredentials ? "InvalidCredentials" : "other", "\n";
    echo "code: ", $refused->code ?? "null", "\n";
    echo "password in message: ", Core\Str::contains($refused->message, "Clients-wrong") ? "yes" : "no", "\n";
    $wrong = $refused->message;
}

try {
    $corp->authenticate("CN=Nobody," . $unit, "Clients-first-Pass-7");
    echo "no such user: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "no such user: ", $refused->kind == Core\Ldap\LdapError::Kind::InvalidCredentials ? "InvalidCredentials" : "other", "\n";
    echo "same message: ", $refused->message == $wrong ? "yes" : "no", "\n";
}

$corp->delete($clients);
$corp->delete($unit);
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://127.0.0.1:16636"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
wrong password: InvalidCredentials
code: 49
password in message: no
no such user: InvalidCredentials
same message: yes
