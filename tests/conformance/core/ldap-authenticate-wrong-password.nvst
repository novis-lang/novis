--TEST--
`authenticate` throws `Core\Ldap\LdapError` with the kind `InvalidCredentials` for a wrong password and for a user that does not exist, with the same message and no password in it — ADR 0278 § 10
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");
var $clients = "CN=Clients,OU=Clients,DC=example,DC=test";

// A run that stopped half-way leaves the account behind.
array<string> $leftovers = [$clients, "OU=Clients,DC=example,DC=test"];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $gone) {
    }
}
$corp->add("OU=Clients,DC=example,DC=test", ["objectClass" => "organizationalUnit"]);
$corp->add($clients, ["objectClass" => "user", "sAMAccountName" => "Clients"]);
$corp->setPassword($clients, "Clients-first-Pass-7");
$corp->modify($clients, [Core\Ldap\Change::replace("userAccountControl", 512)]);

string $wrong = "";
try {
    $corp->authenticate($clients, "Clients-wrong-Pass-8");
    echo "wrong password: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "wrong password: ", $refused->kind == Core\Ldap\ErrorKind::InvalidCredentials ? "InvalidCredentials" : "other", "\n";
    echo "code: ", $refused->code ?? "null", "\n";
    echo "password in message: ", Core\Str::contains($refused->message, "Clients-wrong") ? "yes" : "no", "\n";
    $wrong = $refused->message;
}

try {
    $corp->authenticate("CN=Nobody,OU=Clients,DC=example,DC=test", "Clients-first-Pass-7");
    echo "no such user: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "no such user: ", $refused->kind == Core\Ldap\ErrorKind::InvalidCredentials ? "InvalidCredentials" : "other", "\n";
    echo "same message: ", $refused->message == $wrong ? "yes" : "no", "\n";
}

$corp->delete($clients);
$corp->delete("OU=Clients,DC=example,DC=test");
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://localhost:16636"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
wrong password: InvalidCredentials
code: 49
password in message: no
no such user: InvalidCredentials
same message: yes
