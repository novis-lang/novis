--TEST--
`Core\Hash::of` reproduces each `Core\Digest` case's own published vector, hashes the empty input and hashes a buffer no `string` could hold — spec § 11, ADR 0009 §§ 1 and 3
--FILE--
<?nvs
// § 11: the algorithm is an argument, so this one member has to be right six
// times over. `hash-computes-every-digest-and-authenticates-with-hmac.nvst`
// walks the roster once with "abc"; this case pins each case against the
// specification that publishes it, plus the two inputs a per-algorithm
// dispatch is most likely to get wrong — nothing at all, and octets that are
// not text.

// The empty input, every algorithm. Each of these is its own spec's published
// vector for a zero-length message (FIPS 180-4 for the SHA family, RFC 1321
// § A.5 for MD5), and it is the row that pins the *padding*: an empty message
// still compresses one padded block, so a member that special-cased "no data
// to feed" would answer the wrong thing here and nowhere else. CRC-32 has no
// padding and starts and ends at zero.
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Crc32)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Md5)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha1)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha384)), "\n";
echo Core\Encoding::toHex(Core\Hash::of("", Core\Digest::Sha512)), "\n";

// One published vector per case, taken from the document that defines that
// algorithm rather than from this implementation's own output.
//
// CRC-32/ISO-HDLC's check value: the catalogue defines it as the checksum of
// the nine ASCII digits, which is what makes `cbf43926` the one constant every
// CRC implementation is compared against. `Core\Hash::of` answers the four
// octets big-endian, so this reads as PHP's `hash("crc32b", …)` and not as its
// `crc32()`, which returns an `int` — this module's own docs say why.
echo Core\Encoding::toHex(Core\Hash::of("123456789", Core\Digest::Crc32)), "\n";

// RFC 1321 § A.5's suite, the entry long enough to be interesting.
echo Core\Encoding::toHex(Core\Hash::of("message digest", Core\Digest::Md5)), "\n";

// FIPS 180-4's 448-bit message, for the two algorithms with a 512-bit block:
// 56 octets, so the length field no longer fits behind the padding and the
// message spills into a second block. A one-block-only implementation passes
// every short vector above and fails exactly here.
echo Core\Encoding::toHex(Core\Hash::of(
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    Core\Digest::Sha1
)), "\n";
echo Core\Encoding::toHex(Core\Hash::of(
    "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
    Core\Digest::Sha256
)), "\n";

// FIPS 180-4's 896-bit message, which is the same test for the 1024-bit block
// SHA-384 and SHA-512 use: 112 octets against a 128-octet block.
echo Core\Encoding::toHex(Core\Hash::of(
    "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
    Core\Digest::Sha384
)), "\n";
echo Core\Encoding::toHex(Core\Hash::of(
    "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu",
    Core\Digest::Sha512
)), "\n";

// A `bytes` no `string` could hold: a lone `ff`, a continuation byte with no
// lead and a truncated two-byte sequence. `"…" as bytes` cannot spell this —
// it only reaches octets that are already valid UTF-8 (ADR 0009 §§ 1 and 3) —
// so `Core\Encoding::fromHex` is where such a buffer comes from, and the
// `bytes|string` parameter is what lets it arrive at all. Every algorithm
// takes the same path over it, which is the property being pinned: a digest
// is defined over octets and has no opinion about text.
bytes $raw = Core\Encoding::fromHex("00ff80fe");
echo Core\Encoding::toHex(Core\Hash::of($raw, Core\Digest::Crc32)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($raw, Core\Digest::Md5)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($raw, Core\Digest::Sha1)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($raw, Core\Digest::Sha256)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($raw, Core\Digest::Sha384)), "\n";
echo Core\Encoding::toHex(Core\Hash::of($raw, Core\Digest::Sha512)), "\n";
--EXPECT--
