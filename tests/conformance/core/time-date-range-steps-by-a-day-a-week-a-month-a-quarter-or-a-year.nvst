--TEST--
`Core\Time\Date::range` steps by a day, a week, a month, a quarter or a year, a month step is counted from `$from` and ends on the last day of a shorter month, and each date's calendar readers agree with a `DateTime` on the same day — `rule:core-classes/a-time-class-builds-its-own-values`
--FILE--
<?nvs
// covers: Core\Time\Date::range, Core\Time\Date::quarter, Core\Time\Date::daysInMonth, Core\Time\Date::isoWeek, Core\Time\Date::isoWeekYear
// covers: Core\Time\DateTime::quarter, Core\Time\DateTime::daysInMonth, Core\Time\DateTime::isoWeek, Core\Time\DateTime::isoWeekYear
use Core\Unit;

// The default step is one day. The list has both ends.
foreach (Core\Time\Date::range(Core\Time\Date::at(2026, 12, 30), Core\Time\Date::at(2027, 1, 2)) as Core\Time\Date $day) {
    echo $day->toIso(), ' week ', $day->isoWeek(), ' of ', $day->isoWeekYear(), "\n";
}

// A month step starts from 31 January. A shorter month gets its last day.
// Each line also prints the same day as a `DateTime` at noon in UTC.
foreach (Core\Time\Date::range(Core\Time\Date::at(2026, 1, 31), Core\Time\Date::at(2026, 5, 15), {step: Unit::Month}) as Core\Time\Date $month) {
    var $noon = Core\Time\DateTime::at($month, Core\Time\TimeOfDay::at(12, 0), "UTC");
    echo $month->toIso(), ' ', $month->daysInMonth(), ' ', $month->quarter(), ' ', $month->isoWeek(), ' ', $month->isoWeekYear(),
        ' | ', $noon->daysInMonth(), ' ', $noon->quarter(), ' ', $noon->isoWeek(), ' ', $noon->isoWeekYear(), "\n";
}

// A week step lists every seventh day.
foreach (Core\Time\Date::range(Core\Time\Date::at(2026, 1, 1), Core\Time\Date::at(2026, 1, 20), {step: Unit::Week}) as Core\Time\Date $week) {
    echo $week->toIso(), "\n";
}

// A quarter step is three months.
foreach (Core\Time\Date::range(Core\Time\Date::at(2025, 11, 30), Core\Time\Date::at(2026, 12, 31), {step: Unit::Quarter}) as Core\Time\Date $quarter) {
    echo $quarter->toIso(), ' Q', $quarter->quarter(), "\n";
}

// A year step from 29 February gives 28 February in a year that is not a leap year.
foreach (Core\Time\Date::range(Core\Time\Date::at(2024, 2, 29), Core\Time\Date::at(2029, 1, 1), {step: Unit::Year}) as Core\Time\Date $year) {
    echo $year->toIso(), "\n";
}
--EXPECT--
2026-12-30 week 53 of 2026
2026-12-31 week 53 of 2026
2027-01-01 week 53 of 2026
2027-01-02 week 53 of 2026
2026-01-31 31 1 5 2026 | 31 1 5 2026
2026-02-28 28 1 9 2026 | 28 1 9 2026
2026-03-31 31 1 14 2026 | 31 1 14 2026
2026-04-30 30 2 18 2026 | 30 2 18 2026
2026-01-01
2026-01-08
2026-01-15
2025-11-30 Q4
2026-02-28 Q1
2026-05-30 Q2
2026-08-30 Q3
2026-11-30 Q4
2024-02-29
2025-02-28
2026-02-28
2027-02-28
2028-02-29
