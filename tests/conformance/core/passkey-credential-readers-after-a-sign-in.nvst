--TEST--
The credential `Core\Passkey::verifySignIn` returns has the stored credential's `id`, `publicKey` and `algorithm` and the sent `signCount`, the stored credential's readers still return what they did, and a failed sign-in changes neither — `rule:core-classes/passkey-verifies-a-webauthn-ceremony`
--GET--
under=a-request
--FILE--
<?nvs
// covers: Core\Passkey\Credential::id
// covers: Core\Passkey\Credential::publicKey
// covers: Core\Passkey\Credential::algorithm
// covers: Core\Passkey\Credential::signCount
// This program plays the browser. It signs each sign-in with an Ed25519 key from `Core\Crypto`.
final class Device {
    public static function signIn(string $options, Core\Crypto\KeyPair $key, bytes $id, int $count): string {
        var $read = Core\Json::decode($options) as array<mixed>;
        string $challenge = Core\Taint::assertTrusted($read["challenge"] as string, "this program wrote the options");
        bytes $client = Core\Encoding::encodeText(
            "{\"type\":\"webauthn.get\",\"challenge\":\"" . $challenge . "\",\"origin\":\"https://example.com\"}",
            Core\Charset::Utf8,
        );
        bytes $auth = Core\Bytes::join([
            Core\Hash::of("example.com", Core\Hash::Digest::Sha256),
            Core\Bytes::pack("C", 0x05),
            Core\Bytes::pack("N", $count),
        ]);
        bytes $signature = Core\Crypto::sign(
            Core\Bytes::join([$auth, Core\Hash::of($client, Core\Hash::Digest::Sha256)]),
            $key,
        );
        return "{\"type\":\"public-key\",\"id\":\"" . Core\Encoding::toBase64Url($id)
            . "\",\"response\":{\"clientDataJSON\":\"" . Core\Encoding::toBase64Url($client)
            . "\",\"authenticatorData\":\"" . Core\Encoding::toBase64Url($auth)
            . "\",\"signature\":\"" . Core\Encoding::toBase64Url($signature) . "\"}}";
    }

    public static function same(Core\Passkey\Credential $x, Core\Passkey\Credential $y): string {
        return ($x->id() == $y->id() ? "id" : "-") . " " . ($x->publicKey() == $y->publicKey() ? "key" : "-")
            . " " . ($x->algorithm() == $y->algorithm() ? "algorithm" : "-");
    }
}

Core\Session::start();
Core\Crypto\KeyPair $key = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519);
bytes $cose = Core\Bytes::join([
    Core\Encoding::fromHex("a4010103272006215820"),
    $key->publicKey()->write(Core\Crypto\PublicKey::Format::Raw),
]);
Core\Passkey\Credential $stored = Core\Passkey\Credential::of(Core\Encoding::fromHex("0a0b0c0d"), $cose, Core\Passkey\Credential::Algorithm::Ed25519, 7);

string $options = Core\Passkey::signInOptions("example.com", [$stored]);
Core\Passkey\Credential $now = Core\Passkey::verifySignIn(Device::signIn($options, $key, $stored->id(), 9), $stored, "example.com", "https://example.com");
echo "new: ", Device::same($now, $stored), ", count ", $now->signCount(), "\n";
echo "stored: ", Core\Encoding::toHex($stored->id()), ", count ", $stored->signCount(), "\n";
echo "key: ", $now->publicKey() == $cose ? "the stored bytes" : "other bytes", "\n";

// A sign-in that fails leaves the credential it was given as it was.
$options = Core\Passkey::signInOptions("example.com", [$now]);
try {
    Core\Passkey::verifySignIn(Device::signIn($options, $key, $now->id(), 9), $now, "example.com", "https://example.com");
} catch (RuntimeError $e) {
    echo "count 9 again: ", Core\Str::after($e->message, "(): ") ?? $e->message, "\n";
}
echo "after the failure: ", Device::same($now, $stored), ", count ", $now->signCount(), "\n";
--EXPECT--
new: id key algorithm, count 9
stored: 0a0b0c0d, count 7
key: the stored bytes
count 9 again: the sign counter is 9, and the saved passkey has 9. The counter must increase, so the passkey may have been copied.
after the failure: id key algorithm, count 9
