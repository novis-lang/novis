--TEST--
Core\Crypto::agree answers the shared secret WebCrypto's own deriveBits answered over the same two keys, on both curves of the roster and from either end of each — `rule:core-classes/crypto-interop-tier`
--FILE--
<?nvs
// WebCrypto's own key pairs and the secret it derived from them, frozen under
// `crates/nvs-stdlib/tests/vectors/`. That these *are* WebCrypto's bytes is
// held by that file; what a `.nvs` program can assert is that this runtime
// agrees the same secret over them — which is the whole claim an interop tier
// makes — and that it agrees it from either end, since an agreement one side
// can compute and the other cannot is not an agreement.
array<Core\Crypto\KeyKind> $curves = [
    Core\Crypto\KeyKind::P256,
    Core\Crypto\KeyKind::X25519,
];
array<string> $minePkcs8 = [
    "3041020100301306072a8648ce3d020106082a8648ce3d03010704273025020101042027175a3adf2d51bb7d19a1d87129a545d6a67618341e284de0670d57557434e2",
    "302e020100300506032b656e042204200172af48574da59d306df1b27cc27457304669fb73e0630b9f84eac038695c2c",
];
array<string> $theirsPkcs8 = [
    "3041020100301306072a8648ce3d020106082a8648ce3d0301070427302502010104201273ae38c9225cb4b3a0525f528f86fb130c7d29d1c1a48f433c8fac3dca9ecd",
    "302e020100300506032b656e042204201135b8655ccc4ea0b976d3a303d6b64b90e9f0b643f65e52288c25bdcebe4fa4",
];
array<string> $theirsSpki = [
    "3059301306072a8648ce3d020106082a8648ce3d030107034200049ec2958dd9b249a49b6ef21bdefe416d32e07e186e821c50bb31d07a4b90028e4ef2d61be2c940f6d0c8d5360626af60650dbb6bda372c0766b789364a93a6b3",
    "302a300506032b656e0321009c7be3a9c961ce008340674cd3d468fc5be27c98b65a35262ca2d05573d0585e",
];
array<string> $agreed = [
    "ebd7bf6d8099e34b7940876a7fc89d2403289bde0b96fd25dad07bc626dd2395",
    "34749db6e8052e771090b04ad9ba16459ac958541996589611b0930a4d5ff709",
];

int $mineSide = 0;
int $theirsSide = 0;
int $peerKeyRead = 0;
foreach (Core\Arr::range(0, 1) as int $curve) {
    Core\Crypto\KeyPair $mine = Core\Crypto\KeyPair::read(
        Core\Encoding::fromHex($minePkcs8[$curve]),
        $curves[$curve]
    );
    Core\Crypto\KeyPair $theirs = Core\Crypto\KeyPair::read(
        Core\Encoding::fromHex($theirsPkcs8[$curve]),
        $curves[$curve]
    );

    // The peer's key as it arrives off the wire, rather than as this program
    // derived it: the same `SubjectPublicKeyInfo` WebCrypto exported.
    Core\Crypto\PublicKey $sent = Core\Crypto\PublicKey::read(
        Core\Encoding::fromHex($theirsSpki[$curve]),
        $curves[$curve],
        Core\Crypto\KeyFormat::Spki
    );
    if (Core\Encoding::toHex($theirs->publicKey()->write(Core\Crypto\KeyFormat::Spki))
        == $theirsSpki[$curve]) {
        $peerKeyRead += 1;
    }

    // The answer is `secret bytes`, which is what a shared secret is, so the
    // expectation is widened to meet it rather than the answer narrowed.
    secret bytes $want = Core\Encoding::fromHex($agreed[$curve]);
    if (Core\Crypto::agree($mine, $sent) == $want) {
        $mineSide += 1;
    }
    if (Core\Crypto::agree($theirs, $mine->publicKey()) == $want) {
        $theirsSide += 1;
    }
}
echo "agreed from my end ", $mineSide, " of ", Core\Arr::count($curves), "\n";
echo "agreed from their end ", $theirsSide, " of ", Core\Arr::count($curves), "\n";
echo "peer keys as exported ", $peerKeyRead, " of ", Core\Arr::count($curves), "\n";
--EXPECT--
agreed from my end 2 of 2
agreed from their end 2 of 2
peer keys as exported 2 of 2
