--TEST--
`Core\Router::methodsFor` answers an empty array for a path no route claims and every verb of a path some route does — ADR 0102 § 2
--FILE--
<?nvs
// § 2's two answers, with both bounds named in one file: empty is the `404`
// and non-empty is the `405`, so a member that claimed every path and a
// member that claimed none both fail here rather than only one of them.
//
// Nothing below matches a *request*: § 2's member is asked of the table about
// a path, which is what makes it answerable by a program that has no request
// in hand at all.
class Posts {
    // ADR 0096 § 1: the access decision is a required sibling of every
    // `#[Route]`, and `Core\Audience::Public` is § 1a's open case.
    #[Core\Route(path: "/posts", method: Core\Http\Method::Get, name: "Posts::list")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function list(): string { return "list"; }

    #[Core\Route(path: "/posts", method: Core\Http\Method::Post, name: "Posts::create")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function create(): string { return "created"; }

    #[Core\Route(path: "/posts/{id}", method: Core\Http\Method::Delete, name: "Posts::destroy")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function destroy(uint $id): string { return "gone " . $id; }
}

// Two rows declare `/posts` under two verbs, and both are claims: § 2's
// non-empty answer is the whole `Allow:` list rather than the first row found.
echo "claimed=", Core\Arr::count(Core\Router::methodsFor("/posts")), "\n";
// The `404`: no row of the table claims this path under any verb.
echo "unclaimed=", Core\Arr::count(Core\Router::methodsFor("/nothing/here")), "\n";
// A capture that will not convert leaves the path claimed by nobody — § 1's
// "a failed conversion is not a match", read from this side: `{id}` is a
// `uint` and `abc` is not one, so the row that would otherwise fit does not
// claim it and the answer is a `404` rather than a `405`.
echo "unconverted=", Core\Arr::count(Core\Router::methodsFor("/posts/abc")), "\n";
echo "converted=", Core\Arr::count(Core\Router::methodsFor("/posts/7")), "\n";
// A route is claimed whole: a prefix of one is a different path, and the root
// is a prefix of every route here.
echo "prefix=", Core\Arr::count(Core\Router::methodsFor("/")), "\n";
--EXPECT--
claimed=2
unclaimed=0
unconverted=0
converted=1
prefix=0
