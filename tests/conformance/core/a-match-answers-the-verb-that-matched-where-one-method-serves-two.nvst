--TEST--
`Core\Router\Match::method` answers the verb of the row that matched, which is what tells two `#[Route]`s on one method apart when `is` answers true for both — `rule:routing/matching-is-not-dispatching` `rule:routing/routes-are-compiled-not-registered`
--FILE--
<?nvs
// covers: Core\Router\Match::method, Core\Router\Match::is
// One method under two `#[Route]`s is how `Get` and `Post` share an
// implementation, and the two share one path. A route is its method, so `is`
// answers true for both matches, and the verb is the only answer on the match
// that differs.
class Contact
{
    #[Core\Route(path: "/contact", method: Core\Http\Method::Get)]
    #[Core\Route(path: "/contact", method: Core\Http\Method::Post)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function form(): string { return "form"; }
}

?Core\Router\Match $shown = Core\Router::match(Core\Http\Method::Get, "/contact");
?Core\Router\Match $sent = Core\Router::match(Core\Http\Method::Post, "/contact");
if ($shown != null) {
    if ($sent != null) {
        echo "same route: ", $shown->is(Contact::form) && $sent->is(Contact::form) ? "yes" : "no", "\n";
        echo "get: ", $shown->method() == Core\Http\Method::Get ? "yes" : "no", "\n";
        echo "post: ", $sent->method() == Core\Http\Method::Post ? "yes" : "no", "\n";
        echo "same verb: ", $shown->method() == $sent->method() ? "yes" : "no", "\n";
    }
}

// The answer is the row's verb and not the caller's argument read back: every
// verb `methodsFor` lists for the path is the verb of the match taken under it.
uint $agree = 0;
foreach (Core\Router::methodsFor("/contact") as Core\Http\Method $verb) {
    ?Core\Router\Match $match = Core\Router::match($verb, "/contact");
    if ($match?->method() == $verb) {
        $agree = $agree + 1;
    }
}
echo "agree: ", $agree as string, "\n";
--EXPECT--
same route: yes
get: yes
post: yes
same verb: no
agree: 2
