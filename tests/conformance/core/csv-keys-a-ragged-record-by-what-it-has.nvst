--TEST--
`Core\Csv::parse` answers a ragged document rather than throwing, keying each record by what it actually holds — spec § 12's second table
--FILE--
<?nvs
// A record with more fields than the header keys the surplus by its column
// index — the key that field would have had with no header at all — so nothing
// is dropped and the row still says where each value came from.
var $wide = Core\Csv::parse("a,b\n1,2,3\n", {header: true});
echo "wide=", Core\Arr::count($wide["0"]), " a=", $wide["0"]["a"], " surplus=", $wide["0"]["2"], "\n";

// A record with fewer fields simply has fewer keys. It is not padded with
// empty strings: an absent column and a column holding `""` are different
// facts, and this is what lets a reader tell them apart.
var $short = Core\Csv::parse("a,b,c\n1,2\n", {header: true});
echo "short=", Core\Arr::count($short["0"]), " keys=", Core\Str::join(Core\Arr::keys($short["0"]), "+"), " hasC=", Core\Arr::hasKey($short["0"], "c") ? "yes" : "no", "\n";

// A repeated column name keeps the last field under that name, as any keyed
// structure over duplicate keys must.
var $dup = Core\Csv::parse("a,a\n1,2\n", {header: true});
echo "dup=", Core\Arr::count($dup["0"]), " a=", $dup["0"]["a"], "\n";

// The header record is consumed whether or not any record follows it, so a
// document that is only a header is no rows rather than one.
var $only = Core\Csv::parse("a,b\n", {header: true});
echo "only=", Core\Arr::count($only), "\n";

// The empty document is no records under either reading — there is no header
// to consume and no phantom record of one empty field.
echo "empty=", Core\Arr::count(Core\Csv::parse("")), " emptyheader=", Core\Arr::count(Core\Csv::parse("", {header: true})), "\n";

// A document that ends inside a quoted field is read to its end rather than
// throwing: this reader prefers *a* parse over *no* parse, leaving a malformed
// upload to be rejected by the code that knows what the columns mean. The
// unterminated field therefore keeps the terminator that never closed it.
var $unterminated = Core\Csv::parse("a,\"b,c\n");
echo "unterminated=", Core\Arr::count($unterminated), " fields=", Core\Arr::count($unterminated["0"]), " last=[", $unterminated["0"]["1"], "]\n";

// A blank line is not a record, however many of them there are.
var $blank = Core\Csv::parse("a,b\n\n\nc,d\n");
echo "blank=", Core\Arr::count($blank), "\n";

// `{header: [...]}` is independent of the rows: a row is written by its values
// in order and its length is its own, so a ragged set writes back ragged.
var $ragged = Core\Csv::format([["1", "2", "3"], ["4"]], {header: ["a", "b"]});
echo "ragged=[", $ragged, "]\n";

// An empty field between two separators is a field, and it is present.
var $empties = Core\Csv::parse("a,,b\n");
echo "empties=", Core\Arr::count($empties["0"]), " middle=[", $empties["0"]["1"], "]\n";
--EXPECT--
wide=3 a=1 surplus=3
short=2 keys=a+b hasC=no
dup=1 a=2
only=0
empty=0 emptyheader=0
unterminated=1 fields=2 last=[b,c
]
blank=2
ragged=[a,b
1,2,3
4
]
empties=3 middle=[]
