--TEST--
`Core\Process::spawn` answers a handle a program reads its child's output off chunk by chunk, and writes the child's input into — the round trip `run` cannot express, since `run` is over by the time it answers — `rule:core-classes/process-spawn`
--FILE--
<?nvs
// What separates this from every `Core\Process::run` case is that the program
// is holding a child that has not finished. `run` answers one value once, so a
// program that needs to interleave — write, read what came back, write again —
// has no member to reach for at all; `rule:core-classes/process-spawn` is that
// member, and this is the two halves of what a handle is for.
//
// Both children are this platform's own shell, named absolutely and started as
// an ordinary program with a split argv, exactly as the `run` cases start one.
// The two candidates are the two families this suite runs on; the one that is
// not this platform's has nothing at its path, so the operating system answers
// `IOError` and that block starts nothing.
// covers: Core\Process\Handle::readStdout
// covers: Core\Process\Handle::readStderr
// covers: Core\Process\Handle::writeStdin

int $started = 0;
int $absent = 0;
// `-2` and not `-1`: a signalled child answers `-1`, so a sentinel spelled that
// way could not be told apart from a real status.
int $echoStatus = -2;
int $talkStatus = -2;
string $echoed = "<nothing ran>";
string $seen = "<nothing ran>";
string $seenErr = "<nothing ran>";

try {
    // The round trip. `cat` reads its input to the end and writes it back, so
    // what comes out of the handle is what the program put into it — and the
    // end of that input is `wait`'s doing, which is why a member that waited
    // without closing stdin would hang here rather than answer wrongly.
    Core\Process\Handle $echoer = Core\Process::spawn("/bin/sh", ["-c", "cat"]);
    $started += 1;
    $echoer->writeStdin("payload" as bytes);
    Core\Process\Result $back = $echoer->wait();
    $echoed = $back->stdout() as string;
    $echoStatus = $back->exitCode();

    // The streamed half. This child writes and exits, so the reads end at a
    // point the operating system chooses and not at one this case guessed: a
    // `readStdout` that answered `null` once rather than at the end of the
    // stream would lose the second line. The third line goes to standard
    // error, so a member reading both streams through one pipe answers it in
    // the wrong place.
    Core\Process\Handle $talker = Core\Process::spawn("/bin/sh", ["-c", "echo one; echo two; echo oops >&2"]);
    string $out = "";
    ?bytes $chunk = $talker->readStdout();
    while ($chunk != null) {
        $out = $out . ($chunk as string);
        $chunk = $talker->readStdout();
    }
    $seen = $out;

    string $err = "";
    ?bytes $errChunk = $talker->readStderr();
    while ($errChunk != null) {
        $err = $err . ($errChunk as string);
        $errChunk = $talker->readStderr();
    }
    $seenErr = $err;

    $talkStatus = $talker->wait()->exitCode();
    // Nothing is left to end. A `kill` of a child that has already exited is
    // the spelling a program writes when it does not want to ask first, and it
    // answers rather than throwing.
    $talker->kill();
} catch (IOError $notAUnix) {
    $absent += 1;
}

try {
    Core\Process\Handle $echoerOnWindows = Core\Process::spawn("C:\\Windows\\System32\\cmd.exe", ["/c", "sort"]);
    $started += 1;
    $echoerOnWindows->writeStdin("payload" as bytes);
    Core\Process\Result $backOnWindows = $echoerOnWindows->wait();
    $echoed = $backOnWindows->stdout() as string;
    $echoStatus = $backOnWindows->exitCode();

    Core\Process\Handle $talkerOnWindows = Core\Process::spawn("C:\\Windows\\System32\\cmd.exe", ["/c", "echo one&echo two&echo oops 1>&2"]);
    string $outOnWindows = "";
    ?bytes $chunkOnWindows = $talkerOnWindows->readStdout();
    while ($chunkOnWindows != null) {
        $outOnWindows = $outOnWindows . ($chunkOnWindows as string);
        $chunkOnWindows = $talkerOnWindows->readStdout();
    }
    $seen = $outOnWindows;

    string $errOnWindows = "";
    ?bytes $errChunkOnWindows = $talkerOnWindows->readStderr();
    while ($errChunkOnWindows != null) {
        $errOnWindows = $errOnWindows . ($errChunkOnWindows as string);
        $errChunkOnWindows = $talkerOnWindows->readStderr();
    }
    $seenErr = $errOnWindows;

    $talkStatus = $talkerOnWindows->wait()->exitCode();
    $talkerOnWindows->kill();
} catch (IOError $notWindows) {
    $absent += 1;
}

// The two counts come first because they are what make everything below mean
// anything: on every platform exactly one candidate is there and exactly one is
// not, so a run where nothing started would print the sentinels and read like a
// platform difference rather than like a broken member.
echo "started=", $started, "\n";
echo "absent=", $absent, "\n";
// The line terminator a shell writes is the platform's, so what is asserted is
// that the payload came back and not how it was punctuated.
echo "echoed=|", Core\Str::contains($echoed, "payload") as string, "|\n";
echo "echo status=", $echoStatus, "\n";
echo "one=|", Core\Str::contains($seen, "one") as string, "|\n";
echo "two=|", Core\Str::contains($seen, "two") as string, "|\n";
echo "oops in stdout=|", Core\Str::contains($seen, "oops") as string, "|\n";
echo "oops in stderr=|", Core\Str::contains($seenErr, "oops") as string, "|\n";
echo "one in stderr=|", Core\Str::contains($seenErr, "one") as string, "|\n";
echo "talk status=", $talkStatus, "\n";
--FILE nvs.toml--
# `true`, not a list of roots: what this case asserts is what a handle does once
# a child is running, and the door's own scoping is already pinned by
# `process-run-asks-for-the-capability-before-it-looks-at-the-target.nvst`.
[capabilities.process]
exec = true
--EXPECT--
started=1
absent=1
echoed=|1|
echo status=0
one=|1|
two=|1|
oops in stdout=||
oops in stderr=|1|
one in stderr=||
talk status=0
