--TEST--
Every value `Core\Mail\Message::parse` returns is `tainted`, the addresses and the attachments included, so a plain binding does not compile, and the HTML reaches a page only through `Core\Html::sanitize` — `rule:core-classes/mail-receive`
--FILE--
<?nvs
// The sender wrote every byte of a received message, so each reader returns tainted text.
// Each plain variable below does not compile.
Core\Mail\Message $message = Core\Mail\Message::parse("Subject: Hi\r\n\r\nHello");
?string $id = $message->messageId();
string $subject = $message->subject();
array<string> $lines = $message->header('Subject');
?string $answered = $message->inReplyTo();
array<string> $thread = $message->references();
?string $text = $message->text();
?string $html = $message->html();
bytes $raw = $message->raw();
foreach ($message->to() as Core\Mail\Address $to) {
    string $address = $to->address();
    string $name = $to->name();
}
foreach ($message->attachments() as Core\Mail\Attachment $part) {
    ?string $file = $part->name();
    string $type = $part->type();
    bytes $content = $part->bytes();
}
// The HTML is not markup. It reaches a page only through the sanitizer.
Core\Html\Markup $page = $message->html() ?? '';
Core\Html\Markup $clean = Core\Html::sanitize($message->html() ?? '');
// covers: Core\Mail\Message::parse, Core\Mail\Message::messageId, Core\Mail\Message::subject
// covers: Core\Mail\Message::header, Core\Mail\Message::inReplyTo, Core\Mail\Message::references
// covers: Core\Mail\Message::text, Core\Mail\Message::html, Core\Mail\Message::raw
// covers: Core\Mail\Message::to, Core\Mail\Message::attachments
// covers: Core\Mail\Address::address, Core\Mail\Address::name
// covers: Core\Mail\Attachment::name, Core\Mail\Attachment::type, Core\Mail\Attachment::bytes
--EXPECT--

