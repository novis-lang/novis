--TEST--
For every user and group under `CN=Users`, the flag readers of `Ad\AccountFlags` and `Ad\GroupType` agree with `bits()`, and `Ad::disabled()` finds exactly the users whose `disabled()` is true — `rule:core-classes/ldap-value-types`
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");
int $users = 0;
int $groups = 0;
bool $agree = true;
int $disabled = 0;
foreach ($corp->search(Core\Ldap\Filter::present("objectClass"), {base: "CN=Users,DC=example,DC=test", scope: Core\Ldap\Connection::Scope::OneLevel, select: ["userAccountControl", "groupType"]}) as Core\Ldap\Entry $entry) {
    ?Core\Ldap\Ad\AccountFlags $flags = $entry->accountFlags();
    if ($flags != null) {
        $users = $users + 1;
        $disabled = $disabled + ($flags->isDisabled() ? 1 : 0);
        // The sum of the bits each reader names. It must be the same as
        // `bits()` with only the named bits kept.
        int $sum = ($flags->hasLogonScript() ? 1 : 0) + ($flags->isDisabled() ? 2 : 0)
            + ($flags->isHomeDirectoryRequired() ? 8 : 0) + ($flags->isLockedOut() ? 16 : 0)
            + ($flags->isPasswordNotRequired() ? 32 : 0) + ($flags->allowsReversibleEncryption() ? 128 : 0)
            + ($flags->isTemporaryDuplicateAccount() ? 256 : 0) + ($flags->isNormalAccount() ? 512 : 0)
            + ($flags->isInterdomainTrustAccount() ? 2048 : 0) + ($flags->isWorkstationTrustAccount() ? 4096 : 0)
            + ($flags->isServerTrustAccount() ? 8192 : 0) + ($flags->hasNonExpiringPassword() ? 65536 : 0)
            + ($flags->isMnsLogonAccount() ? 131072 : 0) + ($flags->isSmartcardRequired() ? 262144 : 0)
            + ($flags->isTrustedForDelegation() ? 524288 : 0) + ($flags->isNotDelegated() ? 1048576 : 0)
            + ($flags->usesDesKeyOnly() ? 2097152 : 0) + ($flags->isPreauthNotRequired() ? 4194304 : 0)
            + ($flags->isPasswordExpired() ? 8388608 : 0) + ($flags->isTrustedToAuthenticateForDelegation() ? 16777216 : 0)
            + ($flags->isPartialSecretsAccount() ? 67108864 : 0);
        $agree = $agree && $sum == ($flags->bits() & 100614075);
        $agree = $agree && $entry->groupType() == null;
    }
    ?Core\Ldap\Ad\GroupType $type = $entry->groupType();
    if ($type != null) {
        $groups = $groups + 1;
        int $groupSum = ($type->isSystemGroup() ? 1 : 0) + ($type->isGlobal() ? 2 : 0)
            + ($type->isDomainLocal() ? 4 : 0) + ($type->isUniversal() ? 8 : 0)
            + ($type->isAppBasicGroup() ? 16 : 0) + ($type->isAppQueryGroup() ? 32 : 0)
            + ($type->isSecurityGroup() ? 2147483648 : 0);
        $agree = $agree && $groupSum == ($type->bits() & 2147483711);
        $agree = $agree && $entry->accountFlags() == null;
    }
}
echo "users: ", $users, "\n";
echo "some groups: ", $groups > 0 ? "yes" : "no", "\n";
echo "readers agree with bits: ", $agree ? "yes" : "no", "\n";
echo "disabled by flag: ", $disabled, "\n";
int $found = 0;
foreach ($corp->search(Core\Ldap\Filter::all(Core\Ldap\Filter::equals("objectClass", "user"), Core\Ldap\Ad::disabled()), {base: "CN=Users,DC=example,DC=test", select: ["userAccountControl"]}) as var $user) {
    $found = $found + (($user->accountFlags()?->isDisabled() ?? false) ? 1 : 0);
}
echo "disabled by filter: ", $found, "\n";
// covers: Core\Ldap\Ad\AccountFlags::hasLogonScript, Core\Ldap\Ad\AccountFlags::isDisabled
// covers: Core\Ldap\Ad\AccountFlags::isHomeDirectoryRequired, Core\Ldap\Ad\AccountFlags::isLockedOut
// covers: Core\Ldap\Ad\AccountFlags::isPasswordNotRequired, Core\Ldap\Ad\AccountFlags::allowsReversibleEncryption
// covers: Core\Ldap\Ad\AccountFlags::isTemporaryDuplicateAccount, Core\Ldap\Ad\AccountFlags::isNormalAccount
// covers: Core\Ldap\Ad\AccountFlags::isInterdomainTrustAccount, Core\Ldap\Ad\AccountFlags::isWorkstationTrustAccount
// covers: Core\Ldap\Ad\AccountFlags::isServerTrustAccount, Core\Ldap\Ad\AccountFlags::hasNonExpiringPassword
// covers: Core\Ldap\Ad\AccountFlags::isMnsLogonAccount, Core\Ldap\Ad\AccountFlags::isSmartcardRequired
// covers: Core\Ldap\Ad\AccountFlags::isTrustedForDelegation, Core\Ldap\Ad\AccountFlags::isNotDelegated
// covers: Core\Ldap\Ad\AccountFlags::usesDesKeyOnly, Core\Ldap\Ad\AccountFlags::isPreauthNotRequired
// covers: Core\Ldap\Ad\AccountFlags::isPasswordExpired, Core\Ldap\Ad\AccountFlags::isTrustedToAuthenticateForDelegation
// covers: Core\Ldap\Ad\AccountFlags::isPartialSecretsAccount, Core\Ldap\Ad\AccountFlags::bits
// covers: Core\Ldap\Ad\GroupType::isSystemGroup, Core\Ldap\Ad\GroupType::isGlobal
// covers: Core\Ldap\Ad\GroupType::isDomainLocal, Core\Ldap\Ad\GroupType::isUniversal
// covers: Core\Ldap\Ad\GroupType::isAppBasicGroup, Core\Ldap\Ad\GroupType::isAppQueryGroup
// covers: Core\Ldap\Ad\GroupType::isSecurityGroup, Core\Ldap\Ad\GroupType::bits
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://127.0.0.1:16636"
base = "DC=example,DC=test"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
users: 3
some groups: yes
readers agree with bits: yes
disabled by flag: 2
disabled by filter: 2
