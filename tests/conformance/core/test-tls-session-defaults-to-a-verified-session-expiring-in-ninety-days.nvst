--TEST--
`Core\Test::tlsSession` with no options is a verified TLS 1.3 session whose leaf expires 90 days after the test's clock, signed by one CA — `rule:testing/an-outbound-call-is-answered-from-a-table`
--FILE--
<?nvs
// covers: Core\Test::tlsSession
// Every option has a default, so the call with none is the session a test
// reaches for when only the reply's body matters to it.
var $session = Core\Test::tlsSession();
echo $session->version(), " ", $session->cipher(), "\n";
echo $session->verified() ? "verified" : "relaxed", "\n";
echo $session->subject(), " | ", $session->issuer(), "\n";

// The chain is the leaf and then the CA that signed it, both as PEM.
var $chain = $session->peerChain();
echo Core\Arr::count($chain), "\n";
echo Core\Str::startsWith($chain[0], "-----BEGIN CERTIFICATE-----") ? "pem" : "not pem", "\n";

// No clock is fixed here, so the default expiry is 90 days after the host's
// clock, in whole seconds: the window below allows for the seconds the call
// itself took.
int $left = $session->expiry()->toEpochSeconds() - Core\Time::now()->toEpochSeconds();
echo $left > 90 * 86400 - 60 && $left <= 90 * 86400 ? "90 days" : "wrong expiry", "\n";
--EXPECT--
TLSv1.3 TLS_AES_128_GCM_SHA256
verified
CN=example.com | CN=Novis Test CA
2
pem
90 days
