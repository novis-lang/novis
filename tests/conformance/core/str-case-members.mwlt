--TEST--
Core\Str's four case members are Unicode-aware, not byte-wise
--FILE--
<?mwl
echo Core\Str::upper("mwl"), "\n";
echo Core\Str::lower("MWL"), "\n";
echo Core\Str::upperFirst("mwl runs"), "\n";
echo Core\Str::upper("straße"), "\n";
echo Core\Str::lower("ÉCOLE"), "\n";
--EXPECT--
MWL
mwl
Mwl runs
STRASSE
école
