--TEST--
A `password_file` is read at boot and its content is the value `Core\Config` answers for the secret's own key — `rule:config/a-secret-is-a-file-whose-content-is-the-value`
--FILE--
<?nvs
// § 7 makes a secret a file whose content becomes the value, so the key the
// program reads is `password`, not the `password_file` it was written as. Both
// are in force: the `_file` sibling stays set so an audit can name the file.
echo "password=", Core\Config::get("db.main.password") ?? "null", "\n";
echo "file=", Core\Config::get("db.main.password_file") ?? "null", "\n";

// The rest of the block is untouched by the pass — a secret is one key of it.
echo "driver=", Core\Config::get("db.main.driver") ?? "null", "\n";

// `get` and `all` are one answer set, so a key one of them has is a key the
// other has: three written, three in force.
echo "all=", Core\Arr::count(Core\Config::all()), "\n";
--FILE nvs.toml--
# `rule:config/the-root-is-config-else-nvs-toml-else-the-shipped-defaults` step 2's `./nvs.toml`, the tree this run resolves.
[db.main]
driver = "postgres"
password_file = "secrets/db"
--FILE secrets/db--
 s3cr3t
--EXPECT--
password= s3cr3t
file=secrets/db
driver=postgres
all=3
