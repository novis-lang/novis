--TEST--
`compare` takes exactly one value, so a list and `null` throw `LogicError` before anything is sent, and an entry that does not exist throws `Core\Ldap\LdapError` with the kind `NoSuchObject`
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
// covers: Core\Ldap\Connection::compare
var $corp = Core\Ldap::connect("corp");
var $admin = "CN=Administrator,CN=Users,DC=example,DC=test";

try {
    $corp->compare($admin, "objectClass", ["top", "user"]);
    echo "list: not reached", "\n";
} catch (LogicError $list) {
    echo "list: LogicError", "\n";
}

try {
    $corp->compare($admin, "objectClass", null);
    echo "null: not reached", "\n";
} catch (LogicError $none) {
    echo "null: LogicError", "\n";
}

try {
    $corp->compare("OU=Nowhere,DC=example,DC=test", "description", "Books");
    echo "missing: not reached", "\n";
} catch (Core\Ldap\LdapError $missing) {
    echo "missing: ", $missing->kind == Core\Ldap\LdapError::Kind::NoSuchObject ? "NoSuchObject" : "other", "\n";
}

// The connection still works after each error.
echo "user: ", $corp->compare($admin, "objectClass", "user") ? "true" : "false", "\n";
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://localhost:16636"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
list: LogicError
null: LogicError
missing: NoSuchObject
user: true
