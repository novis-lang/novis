--TEST--
`authenticate` throws `MustChangePassword` for an account that must change its password, `AccountDisabled` for a disabled account, and `InvalidCredentials` for an empty login, which is never sent — `rule:security/ldap-pool-is-bound-as-its-block`
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");

// Each name ends in the process id, so two runs at the same time use different entries.
string $run = Core\Os::pid() as string;
string $account = "Patrons-" . $run;
string $unit = "OU=" . $account . ",DC=example,DC=test";
var $patrons = "CN=" . $account . "," . $unit;

// A run that stopped half-way leaves the account behind.
array<string> $leftovers = [$patrons, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $gone) {
    }
}
$corp->add($unit, ["objectClass" => "organizationalUnit"]);
$corp->add($patrons, ["objectClass" => "user", "sAMAccountName" => $account]);
$corp->setPassword($patrons, "Patrons-first-Pass-7");
$corp->modify($patrons, [
    Core\Ldap\Change::replace("userAccountControl", 512),
    Core\Ldap\Change::replace("pwdLastSet", 0),
]);

// The password is right, and the account must change it first.
try {
    $corp->authenticate($patrons, "Patrons-first-Pass-7");
    echo "must change: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "must change: ", $refused->kind == Core\Ldap\LdapError::Kind::MustChangePassword ? "MustChangePassword" : "other", "\n";
}

// The password is right, and the account is disabled.
$corp->modify($patrons, [Core\Ldap\Change::replace("userAccountControl", 514)]);
try {
    $corp->authenticate($patrons, "Patrons-first-Pass-7");
    echo "disabled: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "disabled: ", $refused->kind == Core\Ldap\LdapError::Kind::AccountDisabled ? "AccountDisabled" : "other", "\n";
}

// An empty login is refused before anything is sent, so there is no result code.
try {
    $corp->authenticate("", "Patrons-first-Pass-7");
    echo "empty login: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "empty login: ", $refused->kind == Core\Ldap\LdapError::Kind::InvalidCredentials ? "InvalidCredentials" : "other", "\n";
    echo "code: ", $refused->code ?? "null", "\n";
}

$corp->delete($patrons);
$corp->delete($unit);
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://127.0.0.1:16636"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
must change: MustChangePassword
disabled: AccountDisabled
empty login: InvalidCredentials
code: null
