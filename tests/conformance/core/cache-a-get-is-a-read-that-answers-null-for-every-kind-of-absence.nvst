--TEST--
A `get` answers `null` for a key nothing wrote, for one whose lifetime is over and for one a `forget` took out, and leaves the entry it read where it was — `rule:core-api/two-cache-tiers`
--FILE--
<?nvs
// covers: Core\Cache\Store::get
var $cache = Core\Cache::memory();

// A key nothing wrote is `null`, which is an answer and not a failure
// (`rule:concurrency/the-memory-tier-is-one-store-per-process`).
var $missing = $cache->get("nothing-wrote-this") ?? "null";
echo "miss=", $missing as string, "\n";

// A read copies in and leaves the entry where it was
// (`rule:concurrency/a-cached-value-is-copied-across-the-boundary`), so the
// second read answers what the first one did.
$cache->put("kept", "payload");
var $first = $cache->get("kept") as string;
var $second = $cache->get("kept") as string;
echo "first=", $first, "\n";
echo "second=", $second, "\n";

// An entry whose lifetime is already over reads as the same `null`. A
// caller cannot tell it from a key nothing wrote, which is the contract it has
// to be written against.
$cache->put("brief", "payload", {ttl: 0s});
var $expired = $cache->get("brief") ?? "null";
echo "expired=", $expired as string, "\n";

// And a key the program took out itself reads as the same `null` once more:
// absence has one answer whatever caused it.
$cache->put("removed", "payload");
$cache->forget("removed");
var $removed = $cache->get("removed") ?? "null";
echo "removed=", $removed as string, "\n";
--EXPECT--
miss=null
first=payload
second=payload
expired=null
removed=null
