--TEST--
A password the domain's policy does not accept throws `Core\Ldap\LdapError` with the kind `PasswordPolicy` from both `setPassword` and `changePassword`, and the message does not contain the password — ADR 0278 § 9 and § 10
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");
var $authors = "CN=Authors,OU=Authors,DC=example,DC=test";

// A run that stopped half-way leaves the account behind.
array<string> $leftovers = [$authors, "OU=Authors,DC=example,DC=test"];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $gone) {
    }
}
$corp->add("OU=Authors,DC=example,DC=test", ["objectClass" => "organizationalUnit"]);
$corp->add($authors, ["objectClass" => "user", "sAMAccountName" => "Authors"]);
$corp->setPassword($authors, "Authors-first-Pass-7");
$corp->modify($authors, [Core\Ldap\Change::replace("pwdLastSet", 0)]);

// A password of one letter is too short for the domain.
try {
    $corp->setPassword($authors, "q");
    echo "setPassword: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "setPassword: ", $refused->kind == Core\Ldap\ErrorKind::PasswordPolicy ? "PasswordPolicy" : "other", "\n";
    echo "code: ", $refused->code ?? "null", "\n";
}

// The new password is the same as the old one, which the history does not allow.
try {
    $corp->changePassword($authors, "Authors-first-Pass-7", "Authors-first-Pass-7");
    echo "changePassword: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "changePassword: ", $refused->kind == Core\Ldap\ErrorKind::PasswordPolicy ? "PasswordPolicy" : "other", "\n";
    echo "password in message: ", Core\Str::contains($refused->message, "Authors-first") ? "yes" : "no", "\n";
}

$corp->delete($authors);
$corp->delete("OU=Authors,DC=example,DC=test");
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://localhost:16636"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
setPassword: PasswordPolicy
code: 19
changePassword: PasswordPolicy
password in message: no
