--TEST--
A password the domain's policy does not accept throws `Core\Ldap\LdapError` with the kind `PasswordPolicy` from both `setPassword` and `changePassword`, and the message does not contain the password
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");

// Each name ends in the process id, so two runs at the same time use different entries.
string $run = Core\Os::pid() as string;
string $account = "Authors-" . $run;
string $unit = "OU=" . $account . ",DC=example,DC=test";
var $authors = "CN=" . $account . "," . $unit;

// A run that stopped half-way leaves the account behind.
array<string> $leftovers = [$authors, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $gone) {
    }
}
$corp->add($unit, ["objectClass" => "organizationalUnit"]);
$corp->add($authors, ["objectClass" => "user", "sAMAccountName" => $account]);
$corp->setPassword($authors, "Authors-first-Pass-7");
$corp->modify($authors, [Core\Ldap\Change::replace("pwdLastSet", 0)]);

// A password of one letter is too short for the domain.
try {
    $corp->setPassword($authors, "q");
    echo "setPassword: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "setPassword: ", $refused->kind == Core\Ldap\LdapError::Kind::PasswordPolicy ? "PasswordPolicy" : "other", "\n";
    echo "code: ", $refused->code ?? "null", "\n";
}

// The new password is the same as the old one, which the history does not allow.
try {
    $corp->changePassword($authors, "Authors-first-Pass-7", "Authors-first-Pass-7");
    echo "changePassword: not reached", "\n";
} catch (Core\Ldap\LdapError $refused) {
    echo "changePassword: ", $refused->kind == Core\Ldap\LdapError::Kind::PasswordPolicy ? "PasswordPolicy" : "other", "\n";
    echo "password in message: ", Core\Str::contains($refused->message, "Authors-first") ? "yes" : "no", "\n";
}

$corp->delete($authors);
$corp->delete($unit);
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://127.0.0.1:16636"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
setPassword: PasswordPolicy
code: 19
changePassword: PasswordPolicy
password in message: no
