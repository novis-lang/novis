--TEST--
Core\Str's four case members are Unicode-aware, not byte-wise
--FILE--
<?nvs
echo Core\Str::upper("nvs"), "\n";
echo Core\Str::lower("NVS"), "\n";
echo Core\Str::upperFirst("nvs runs"), "\n";
echo Core\Str::upper("straße"), "\n";
echo Core\Str::lower("ÉCOLE"), "\n";
--EXPECT--
NVS
nvs
Nvs runs
STRASSE
école
