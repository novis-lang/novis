--TEST--
A retrieved attribute payload whose array holds cases of one enum reads back as an `array<ThatEnum>`, on both backings, and an `array<mixed>` field keeps each case's own enum — `rule:attributes/retrieval-folds-while-checking` and `rule:enums/representation`
--FILE--
<?nvs
// The payload is checked against the declaration's fields while compiling, where
// each case still names its enum. A case of another enum in an `array<Mode>` field
// does not compile, so `Loose` declares `array<mixed>` for the mixed list.
enum Mode: int {
    Off = 0,
    On = 1,
}

enum Weight: uint {
    Light = 0,
    Heavy = 2,
}

attribute Plan on class { modes: array<Mode>, weights: array<Weight>, grid: array<array<Mode>> }
attribute Loose on class { modes: array<mixed> }
attribute Heavy on class { modes: array<Weight> }

#[Plan(modes: [Mode::Off, Mode::On], weights: [Weight::Light, Weight::Heavy], grid: [[Mode::On], []])]
class Job {
}

#[Loose(modes: [Mode::Off, Weight::Light])]
class Mixed {
}

#[Heavy(modes: [Weight::Heavy])]
class Other {
}

var $job = Core\Attributes::get<Plan>(Job::constructor);
echo "job: ", $job == null ? "null" : "matched", "\n";
if ($job != null) {
    foreach ($job->modes as Mode $mode) {
        mixed $seen = $mode;
        echo "  mode ", $mode == Mode::On ? "On" : "Off", " is Mode=", ($seen is Mode) ? "yes" : "no",
            " truthy=", $seen ? "yes" : "no", "\n";
    }
    foreach ($job->weights as Weight $weight) {
        mixed $held = $weight;
        echo "  weight ", $weight == Weight::Heavy ? "Heavy" : "Light", " is Weight=", ($held is Weight) ? "yes" : "no",
            " truthy=", $held ? "yes" : "no", "\n";
    }
    echo "  grid rows=", Core\Arr::count($job->grid), " first=", $job->grid[0][0] == Mode::On ? "On" : "other", "\n";
}

// Each element of an `array<mixed>` field is still a case of its own enum.
var $mixed = Core\Attributes::get<Loose>(Mixed::constructor);
if ($mixed != null) {
    foreach ($mixed->modes as mixed $one) {
        echo "mixed: ", $one is Mode ? "Mode" : ($one is Weight ? "Weight" : "other"), "\n";
    }
}

// `Other` has no `Plan`, so that retrieval is `null`.
var $other = Core\Attributes::get<Plan>(Other::constructor);
echo "other: ", $other == null ? "null" : "matched", "\n";
var $weights = Core\Attributes::get<Heavy>(Other::constructor);
echo "other as Weight: ", $weights == null ? "null" : "matched", "\n";
--EXPECT--
job: matched
  mode Off is Mode=yes truthy=yes
  mode On is Mode=yes truthy=yes
  weight Light is Weight=yes truthy=yes
  weight Heavy is Weight=yes truthy=yes
  grid rows=2 first=On
mixed: Mode
mixed: Weight
other: null
other as Weight: matched
