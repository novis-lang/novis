--TEST--
#[Core\Json\Derive] makes a class encodable from its declared properties, private ones included, in declaration order, with per-field renaming and skipping — `rule:core-classes/derive-attribute` and `rule:core-classes/derive-field-list`
--FILE--
<?nvs
// covers: lang:attributes/core-json-derive-and-core-json-field-a-class-with-a-json-codec
use Core\Json;
use Core\Json\Field;

// `rule:core-classes/derive-attribute`: the attribute is matched *nominally*, so the `use`d short
// spelling (`#[Field]` below) and the fully-qualified one (`#[Core\Json\Derive]`)
// are the same attribute. Each import binds one whole short name — `rule:statements/a-qualified-name-is-absolute`
// makes a qualified name absolute, so `use Core\Json;` reaches the *class*
// `Json::encode` is called on and never lets `Json\Derive` name the attribute.
// `Derive` itself is deliberately left unimported: the impostor at the foot of
// this case needs the short name free to shadow.
#[Core\Json\Derive]
class Address {
    public string $city;
    public function constructor(string $city) {
        $this->city = $city;
    }
}

#[Core\Json\Derive]
class User {
    public string $name;
    public int $age;
    // § 3: `name` renames one field's key; there is no whole-class policy.
    #[Field(name: "is_admin")]
    public bool $isAdmin;
    // § 3: `skip` removes the field entirely, and exempts it from § 2's
    // constructor-parameter requirement.
    #[Field(skip: true)]
    public int $cachedHash;
    // § 2: another class with a codec is a codec-reachable field type, and a
    // `?T` one always emits, `null` included (§ 4's "no omit-when-null").
    public Address $address;
    public ?int $score;

    public function constructor(string $name, int $age, bool $isAdmin, Address $address, ?int $score) {
        $this->name = $name;
        $this->age = $age;
        $this->isAdmin = $isAdmin;
        $this->cachedHash = 0;
        $this->address = $address;
        $this->score = $score;
    }
}

// Declaration order is the encode order, which is what makes the document
// byte-deterministic across runs and machines (§ 2).
echo Json::encode(new User("ada", 36, true, new Address("london"), null)), "\n";
echo Json::encode(new User("bob", 7, false, new Address("rome"), 12)), "\n";

// The same object twice is the same bytes — the property the ordering rule
// exists for.
var $grace = new User("grace", 45, false, new Address("nyc"), 1);
echo Json::encode($grace) == Json::encode($grace) ? "stable" : "varies", "\n";

// § 2: the field list is visibility-blind — a `protected` or `private` property
// is a field like any other. Visibility is an access-control decision, and a
// codec that dropped a field the day it gained a `private` would be exactly the
// silent break § 1's written opt-in is paying to remove. Decode is blind to it
// for the same reason and by the same route: it is an ordinary `new`, so the
// constructor assigns a private property as it assigns any other.
#[Core\Json\Derive]
class Ledger {
    public int $id;
    protected string $owner;
    private int $balance;

    public function constructor(int $id, string $owner, int $balance) {
        $this->id = $id;
        $this->owner = $owner;
        $this->balance = $balance;
    }
}
echo Json::encode(new Ledger(7, "ada", 42)), "\n";
echo Json::encode(Json::decodeAs<Ledger>('{"id":8,"owner":"bob","balance":3}')), "\n";

// § 1: a userland `type Derive = {};` is not the compiler's attribute, no
// matter how it is spelled — so this class gets nothing and stays unencodable.
type Derive = {};

#[Derive]
class Impostor {
    public int $n;
    public function constructor(int $n) {
        $this->n = $n;
    }
}
try {
    echo Json::encode(new Impostor(1)), "\n";
    echo "not reached\n";
} catch (LogicError $unencodable) {
    echo "no codec\n";
}
--EXPECT--
{"name":"ada","age":36,"is_admin":true,"address":{"city":"london"},"score":null}
{"name":"bob","age":7,"is_admin":false,"address":{"city":"rome"},"score":12}
stable
{"id":7,"owner":"ada","balance":42}
{"id":8,"owner":"bob","balance":3}
no codec
