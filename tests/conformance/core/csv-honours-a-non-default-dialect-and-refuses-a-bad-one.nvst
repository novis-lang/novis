--TEST--
`Core\Csv` reads and writes a caller's dialect on both legs, and refuses one that has no reading — spec § 12's second table
--FILE--
<?nvs
// The dialect is three single ASCII bytes and each is the caller's;
// `crates/nvs-stdlib/src/csv.rs`'s module doc owns why. A quoted field holds
// the separator whatever byte the separator is.
var $piped = Core\Csv::parse("one|'two|three'\n", {separator: "|", quote: "'"});
echo "piped=[", $piped["0"]["0"], "][", $piped["0"]["1"], "]\n";

// The writer takes the same two bytes, and its one rule follows them: quote a
// field exactly where a byte in it would otherwise change the parse — so `|`
// forces a quote here and `,` no longer does, and the quote inside a quoted
// field is doubled whatever byte the quote is.
var $back = Core\Csv::format([["a|b", "c'd", "plain"]], {separator: "|", quote: "'"});
echo "back=[", $back, "]\n";
var $again = Core\Csv::parse($back, {separator: "|", quote: "'"});
echo "again=[", $again["0"]["0"], "][", $again["0"]["1"], "][", $again["0"]["2"], "]\n";

// `{escape: "\\"}` asks for the historical backslash explicitly, and doubling
// keeps working beside it.
var $esc = Core\Csv::parse("\"a\\\"b\",\"c\"\"d\"\n", {escape: "\\"});
echo "escaped=", $esc["0"]["0"], " doubled=", $esc["0"]["1"], "\n";

// The same document under the default dialect — no escape character at all —
// is a different document, which is why the option exists rather than the
// reader guessing: the quote after the backslash closes the field, and the
// bytes after it continue the same one.
var $literal = Core\Csv::parse("\"a\\\"b\",x\n");
echo "noescape=[", $literal["0"]["0"], "] next=", $literal["0"]["1"], "\n";

// `{header: false}` is the default written out: the first record stays a
// record and the keys are column indices.
var $plain = Core\Csv::parse("name,qty\nfig,2\n", {header: false});
echo "plain=", Core\Arr::count($plain), " first=", $plain["0"]["0"], "\n";

// The four bytes the writer quotes on, in one row: an embedded LF, the
// separator and the quote. Every record ends with LF, including the last, so
// the round trip answers the same fields.
var $multi = Core\Csv::format([["line1\nline2", "sep,here", "quote\"here"]]);
echo "multi=[", $multi, "]\n";
var $round = Core\Csv::parse($multi);
echo "round=", Core\Arr::count($round["0"]), " nl=[", $round["0"]["0"], "] q=[", $round["0"]["2"], "]\n";

// A dialect option is caller data whose *value* can be wrong while its type is
// right, so each of these throws rather than being truncated to a first byte
// or silently ignored. The document itself never throws; only the dialect can.
try {
    var $bad = Core\Csv::parse("a,b\n", {separator: ";;"});
} catch (Throwable $e) {
    echo "threw: ", $e->message, "\n";
}
try {
    var $nl = Core\Csv::parse("a,b\n", {separator: "\n"});
} catch (Throwable $e) {
    echo "threw: ", $e->message, "\n";
}
try {
    var $same = Core\Csv::format([["a"]], {quote: ","});
} catch (Throwable $e) {
    echo "threw: ", $e->message, "\n";
}
--EXPECT--
piped=[one][two|three]
back=['a|b'|'c''d'|plain
]
again=[a|b][c'd][plain]
escaped=a"b doubled=c"d
noescape=[a\b"] next=x
plain=2 first=name
multi=["line1
line2","sep,here","quote""here"
]
round=3 nl=[line1
line2] q=[quote"here]
threw: Core\Csv::parse(): the `separator` option is longer than one ASCII character. A CSV dialect is written in single ASCII bytes, since the separator, the quote and the escape are each compared against one byte of the document
threw: Core\Csv::parse(): the `separator` option is a carriage return or a line feed, which already ends a record. A CSV dialect is written in single ASCII bytes, since the separator, the quote and the escape are each compared against one byte of the document
threw: Core\Csv::format(): two of the dialect options name the same byte, ','. A separator that is also the quote — or the escape — has no reading that recovers the fields
