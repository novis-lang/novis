--TEST--
`Core\Secret::reveal` and `::revealBytes` agree on the same content across the `string`/`bytes` boundary — revealing then converting is converting then revealing, over a sweep — ADR 0033 § 3, `rule:types/bytes`
--FILE--
<?nvs
// The two members exist because the registry has no overloading, not because
// they do different things — `crates/nvs-stdlib/src/secret.rs`'s module doc
// calls the second name "the only cost". This is the case that holds them to
// it: for content both bases can carry, the order of the reveal and the
// conversion must not matter. A member that grew a transformation of its own
// still looks right on its own line and fails here.
array<string> $contents = [
    "",
    "hunter2",
    "caf\u{e9}",
    "\u{1f512} rotate me",
    "tab\tand\nnewline",
];

int $sameOctets = 0;
int $sameAsEncoded = 0;
int $sameDecoded = 0;
uint $characters = 0;
uint $octets = 0;
string $lastHex = "";
foreach ($contents as string $content) {
    // One content, held twice: the qualifier survives the conversion (ADR 0033
    // § 2), so `$heldBytes` is as `secret` as `$held` and neither reaches a
    // sink without a reveal.
    secret string $held = $content;
    secret bytes $heldBytes = $content as bytes;

    string $viaText = Core\Secret::reveal($held, "the command prints the credential");
    bytes $viaBytes = Core\Secret::revealBytes($heldBytes, "the signer takes it as octets");

    // Three routes across the boundary, all asserted as *agreement* rather
    // than against a written-out expectation: the cast, `Core\Encoding`'s
    // explicit encode, and its decode coming back the other way.
    if (Core\Bytes::compare($viaText as bytes, $viaBytes) == 0) {
        $sameOctets = $sameOctets + 1;
    }
    if (Core\Bytes::compare(Core\Encoding::encodeText($viaText, Core\Charset::Utf8), $viaBytes) == 0) {
        $sameAsEncoded = $sameAsEncoded + 1;
    }
    if (Core\Encoding::decodeText($viaBytes, Core\Charset::Utf8) == $viaText) {
        $sameDecoded = $sameDecoded + 1;
    }

    $characters = $characters + Core\Str::length($viaText);
    $octets = $octets + Core\Bytes::length($viaBytes);
    $lastHex = Core\Encoding::toHex($viaBytes);
}
echo "octets ", $sameOctets, ", encoded ", $sameAsEncoded, ", decoded ", $sameDecoded,
     " of ", Core\Arr::count($contents), "\n";

// The sweep is not an ASCII sweep, which is what would make the agreement
// vacuous: the two counts differ because `caf\u{e9}` and the emoji are more
// octets than characters (`rule:types/string-is-utf8`'s granularity), so a route that
// silently re-encoded would land on a different number here.
echo "characters ", $characters, ", octets ", $octets, "\n";
echo $lastHex, "\n";
--EXPECT--
octets 5, encoded 5, decoded 5 of 5
characters 37, octets 41
74616209616e640a6e65776c696e65
