--TEST--
Core\Arr::append keeps the counter a removed key left behind, as `$a[] = $v` on the same array does, `rule:core-api/shape-rules`
--FILE--
<?nvs
final class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

// `$a[] = $v` changes one array. `unset` does not lower its counter, so the
// new entry lands on key 10.
array<int> $mutated = ["5" => 1, "x" => 2, "9" => 3];
unset($mutated["9"]);
$mutated[] = 9;
echo Render::of($mutated), "\n";

// `Core\Arr::append` returns a new array with the same counter, so the new
// entry lands on key 10 too.
array<int> $pure = ["5" => 1, "x" => 2, "9" => 3];
unset($pure["9"]);
echo Render::of(Core\Arr::append($pure, 9)), "\n";

// `withoutLast` keeps the counter too, so `append` gives key 10 again.
array<int> $mixed = ["5" => 1, "x" => 2, "9" => 3];
echo Render::of(Core\Arr::append(Core\Arr::withoutLast($mixed), 9)), "\n";

// Only key 0 remains here. The counter is still 5, so the new entry is key 5.
array<int> $gapped = ["0" => 1, "4" => 2];
echo Render::of(Core\Arr::append(Core\Arr::withoutLast($gapped), 9)), "\n";
--EXPECT--
5=1;x=2;10=9;
5=1;x=2;10=9;
5=1;x=2;10=9;
0=1;5=9;
