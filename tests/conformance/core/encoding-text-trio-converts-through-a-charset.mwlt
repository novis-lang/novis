--TEST--
Core\Encoding's encodeText/decodeText/isValidText convert through a Charset exactly, and report rather than substitute — spec § 7, ADR 0009 § 3
--FILE--
<?mwl
// § 7: the text trio sits on the `bytes`<->`string` seam, over the WHATWG
// Encoding Standard's index as `Core\Charset`. UTF-8 out is the octets a
// `string` already holds (ADR 0009 § 3), so this is the identity spelling.
echo Core\Encoding::toHex(Core\Encoding::encodeText("mwl", Core\Charset::Utf8)), "\n";

// One character, three charsets, three widths.
string $accented = "é";
echo Core\Encoding::toHex(Core\Encoding::encodeText($accented, Core\Charset::Latin1)), "\n";
echo Core\Encoding::toHex(Core\Encoding::encodeText($accented, Core\Charset::Utf16Le)), "\n";
echo Core\Encoding::toHex(Core\Encoding::encodeText($accented, Core\Charset::Utf8)), "\n";

// The three labels the standard folds into `windows-1252` and MWL keeps
// apart: `0x80` is the euro sign there, a C1 control in ISO-8859-1, and not
// ASCII at all. Each answer is spelled back as UTF-8 so the case asserts
// octets rather than a console's idea of them.
bytes $high = Core\Encoding::fromHex("80");
echo Core\Encoding::toHex(
    Core\Encoding::encodeText(
        Core\Encoding::decodeText($high, Core\Charset::Windows1252),
        Core\Charset::Utf8
    )
), "\n";
echo Core\Encoding::toHex(
    Core\Encoding::encodeText(
        Core\Encoding::decodeText($high, Core\Charset::Latin1),
        Core\Charset::Utf8
    )
), "\n";
echo (Core\Encoding::isValidText($high, Core\Charset::Ascii) ? "yes" : "no"), "\n";
echo (Core\Encoding::isValidText($high, Core\Charset::Latin1) ? "yes" : "no"), "\n";

// A delegated charset — the roster is the standard's, not a curated list.
string $hiragana = "あい";
bytes $jis = Core\Encoding::encodeText($hiragana, Core\Charset::ShiftJis);
echo Core\Encoding::toHex($jis), "\n";
echo Core\Encoding::decodeText($jis, Core\Charset::ShiftJis), "\n";

// R4: a sequence the charset cannot read is refused, never answered as
// U+FFFD. `isValidText` is that question with somewhere to put the `false`.
echo (Core\Encoding::isValidText(Core\Encoding::fromHex("ff"), Core\Charset::Utf8) ? "yes" : "no"), "\n";
echo (Core\Encoding::isValidText(Core\Encoding::fromHex("82"), Core\Charset::ShiftJis) ? "yes" : "no"), "\n";
echo (Core\Encoding::isValidText($jis, Core\Charset::ShiftJis) ? "yes" : "no"), "\n";
--EXPECT--
6d776c
e9
e900
c3a9
e282ac
c280
no
yes
82a082a2
あい
no
no
yes
