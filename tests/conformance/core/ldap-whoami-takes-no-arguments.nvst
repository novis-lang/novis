--TEST--
`whoami` asks the server who the connection is bound as, and takes no arguments, so passing a name does not compile — ADR 0278 § 5
--FILE--
<?nvs
class Bound {
    public static function as(Core\Ldap\Connection $corp): string {
        return $corp->whoami("Administrator");
    }
}
--EXPECT--

