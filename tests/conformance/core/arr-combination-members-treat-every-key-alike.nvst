--TEST--
Core\Arr::overlay, ::overlayDeep, ::underlay and ::appendAll combine by the member's name and never by a key's type, per ADR 0069 § 1
--FILE--
<?nvs
// ADR 0069 § 1: four members, each doing one thing to every key alike.
// `Core\Json::encode` pins the values *and* the key order in one line, and the
// order is half of what the ADR is about.
array<int> $base = ["a" => 1, "b" => 2];
array<int> $layer = ["b" => 9, "c" => 3];

// `overlay` — right wins. `b` replaces in place, `c` lands at the end.
// PHP's `array_replace($base, $layer)`, byte for byte.
echo Core\Json::encode(Core\Arr::overlay($base, $layer)), "\n";

// `underlay` — left wins, and it is PHP's `$base + $layer` exactly. It is the
// member `E0467` names when a program writes that operator.
echo Core\Json::encode(Core\Arr::underlay($base, $layer)), "\n";

// The two are not each other with the arguments flipped: `overlay($layer,
// $base)` holds the same entries as `underlay($base, $layer)` in a different
// order, and an Novis array is insertion-ordered.
echo Core\Json::encode(Core\Arr::overlay($layer, $base)), "\n";

// `appendAll` discards every key and always answers a list, whatever the
// arguments were — PHP's `array_merge` over lists and its `...$arrays` idiom.
echo Core\Json::encode(Core\Arr::appendAll($base, $layer)), "\n";

// The tail is variadic: no layer at all, and more than one, both walk left to
// right with the same rule at every step.
array<int> $third = ["a" => 7];
echo Core\Json::encode(Core\Arr::overlay($base)), "\n";
echo Core\Json::encode(Core\Arr::overlay($base, $layer, $third)), "\n";
echo Core\Json::encode(Core\Arr::underlay($base, $layer, $third)), "\n";

// `overlayDeep` recurses where both sides of a key hold an array and neither
// is a list. A list is replaced wholesale, which is exactly where it parts
// company with PHP's `array_replace_recursive` — that answers
// `"list":[4,2,3]`, merging element-wise, which is never what a configuration
// merge wanted.
array<array<int>> $one = ["db" => ["host" => 1, "port" => 2], "list" => [1, 2, 3]];
array<array<int>> $two = ["db" => ["port" => 9], "list" => [4]];
echo Core\Json::encode(Core\Arr::overlayDeep($one, $two)), "\n";

// Shallow `overlay` over the same two replaces the whole nested map instead.
echo Core\Json::encode(Core\Arr::overlay($one, $two)), "\n";

// No member consults a key's *type*: an integer key replaces in place exactly
// as a string one does, where PHP's `array_merge` renumbers one and keeps the
// other. This is the whole of ADR 0069.
array<string> $left = [0 => "zero", 1 => "one"];
array<string> $right = [1 => "ONE", 2 => "two"];
echo Core\Json::encode(Core\Arr::overlay($left, $right)), "\n";
echo Core\Json::encode(Core\Arr::underlay($left, $right)), "\n";
echo Core\Json::encode(Core\Arr::appendAll($left, $right)), "\n";

// Every argument is a value and none of them is touched (ADR 0063 R3).
echo Core\Json::encode($base), Core\Json::encode($layer), "\n";

// A layer of a second element type is what the `array<T|U>` return exists for;
// `crates/nvs-stdlib/src/arr.rs`'s module doc owns that spelling.
array<string> $names = ["a" => "x", "z" => "y"];
echo Core\Json::encode(Core\Arr::overlay($names, $third)), "\n";
--EXPECT--
{"a":1,"b":9,"c":3}
{"a":1,"b":2,"c":3}
{"b":2,"c":3,"a":1}
[1,2,9,3]
{"a":1,"b":2}
{"a":7,"b":9,"c":3}
{"a":1,"b":2,"c":3}
{"db":{"host":1,"port":9},"list":[4]}
{"db":{"port":9},"list":[4]}
["zero","ONE","two"]
["zero","one","two"]
["zero","one","ONE","two"]
{"a":1,"b":2}{"b":9,"c":3}
{"a":7,"z":"y"}
