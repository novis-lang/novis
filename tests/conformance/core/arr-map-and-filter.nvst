--TEST--
Core\Arr::map and ::filter take a callable and leave their subject alone
--FILE--
<?nvs
array<int> $ns = Core\Arr::range(1, 10);
var $evens = Core\Arr::filter($ns, fn(int $n) => $n % 2 == 0);
echo Core\Arr::count($evens), "\n";
echo Core\Arr::count($ns), "\n";

var $doubled = Core\Arr::map([1, 2, 3], fn(int $n) => $n * 2);
echo Core\Str::join(Core\Arr::map($doubled, fn(int $n) => $n as string), ","), "\n";

var $none = Core\Arr::filter($ns, fn(int $n) => $n > 100);
echo Core\Arr::count($none), "\n";
--EXPECT--
5
10
2,4,6
0
