--TEST--
`Core\Time\Date::at` and `Core\Time\TimeOfDay::at` throw an error for a month, day, hour, minute or year outside its range, and `plus` is the way to move a date past the end of a month or a year
--FILE--
<?nvs
final class Refusal {
    // Returns `1` when the message starts with the name of `$member`.
    public static function of(tainted string $message, string $member): string {
        return Core\Str::startsWith($message, $member . "(): ") as string;
    }
}

var $utc = Core\Time\Zone::UTC;
uint $refused = 0;
var $date = "Core\\Time\\Date::at";
var $time = "Core\\Time\\TimeOfDay::at";

// To move a date past the end of a year or a month, use `plus`.
echo Core\Time\DateTime::fromIso("2024-01-01", $utc)->plus(12, Core\Unit::Month)->format("yyyy-MM-dd"), "\n";
echo Core\Time\DateTime::fromIso("2024-02-01", $utc)->plus(29, Core\Unit::Day)->format("yyyy-MM-dd"), "\n";

// A month must be from 1 to 12.
try { Core\Time\DateTime::at(Core\Time\Date::at(2024, 13, 1), Core\Time\TimeOfDay::at(0, 0), $utc); } catch (Throwable $e) { $refused = $refused + 1; echo "month=13|", Refusal::of($e->message, $date), "\n"; }
try { Core\Time\DateTime::at(Core\Time\Date::at(2024, 0, 1), Core\Time\TimeOfDay::at(0, 0), $utc); } catch (Throwable $m0) { $refused = $refused + 1; echo "month=0|", Refusal::of($m0->message, $date), "\n"; }

// A day must exist in its month. February 2024 has 29 days, and there is no day 0.
try { Core\Time\DateTime::at(Core\Time\Date::at(2024, 2, 30), Core\Time\TimeOfDay::at(0, 0), $utc); } catch (Throwable $d30) { $refused = $refused + 1; echo "feb=30|", Refusal::of($d30->message, $date), "\n"; }
try { Core\Time\DateTime::at(Core\Time\Date::at(2024, 3, 0), Core\Time\TimeOfDay::at(0, 0), $utc); } catch (Throwable $d0) { $refused = $refused + 1; echo "day=0|", Refusal::of($d0->message, $date), "\n"; }

// The hour and the minute are checked the same way.
try { Core\Time\DateTime::at(Core\Time\Date::at(2024, 3, 1), Core\Time\TimeOfDay::at(25, 0), $utc); } catch (Throwable $h25) { $refused = $refused + 1; echo "hour=25|", Refusal::of($h25->message, $time), "\n"; }
try { Core\Time\DateTime::at(Core\Time\Date::at(2024, 3, 1), Core\Time\TimeOfDay::at(0, 60), $utc); } catch (Throwable $mi) { $refused = $refused + 1; echo "minute=60|", Refusal::of($mi->message, $time), "\n"; }

// A much larger month throws the same error.
try { Core\Time\DateTime::at(Core\Time\Date::at(2024, 300, 1), Core\Time\TimeOfDay::at(0, 0), $utc); } catch (Throwable $m300) { $refused = $refused + 1; echo "month=300|", Refusal::of($m300->message, $date), "\n"; }

// A year must be at most 9999.
try { Core\Time\DateTime::at(Core\Time\Date::at(10000, 1, 1), Core\Time\TimeOfDay::at(0, 0), $utc); } catch (Throwable $y) { $refused = $refused + 1; echo "year=10000|", Refusal::of($y->message, $date), "\n"; }

// All eight calls above throw an error.
echo "refused=", $refused, "/8\n";
--EXPECT--
2025-01-01
2024-03-01
month=13|1
month=0|1
feb=30|1
day=0|1
hour=25|1
minute=60|1
month=300|1
year=10000|1
refused=8/8
