--TEST--
Core\Math::sqrt and cbrt round trip exactly over every row whose root is representable, Core\Math::log does the same on exact powers of its base, and the rows where the intermediate is irrational come back near rather than equal — docs/spec/01-core-library.md § 3
--FILE--
<?mwl
// § 3 gives each of these members an inverse in the same class, so the question
// the class owes an answer for is what a round trip through one costs. The
// answer is a property of the *row*, not of the member: a round trip is exact
// exactly where the intermediate value it goes through is representable, and
// merely near everywhere else. Both halves are asserted here, because a member
// that had grown its own arithmetic looks right on either half alone.
//
// Asserted by counting over the whole table rather than read off a line, which
// is what makes it a property. The `hypot` case beside this one restricts its
// table for the same reason: on these rows `sqrt` is IEEE 754's correctly
// rounded square root of a value whose root is a `float`, so the root is that
// `float` exactly and squaring it lands back on the row it came from. Nothing
// here is a claim about one libm.

// Perfect squares, two powers of two, and dyadic fractions — 0.375 * 0.375 and
// 0.0625 * 0.0625 among them, so the table is not only integers.
array<float> $squares = [
    0.0, 1.0, 4.0, 9.0, 16.0, 25.0, 100.0, 144.0, 10000.0,
    16777216.0, 68719476736.0,
    2.25, 0.25, 6.25, 0.0625, 1.5625, 0.140625, 0.00390625,
];
int $sqRows = 0;
int $sqBack = 0;
foreach ($squares as float $n) {
    float $root = Core\Math::sqrt($n);
    $sqRows = $sqRows + 1;
    if ($root * $root == $n) {
        $sqBack = $sqBack + 1;
    }
}
echo "sqrt rows=", $sqRows, " back=", $sqBack, "\n";

// Perfect cubes of both signs — `cbrt` exists in § 3 rather than being left to
// `pow($n, 1/3)` precisely because it answers on a negative — and the dyadic
// cubes 0.5, 1.5, 2.5 and 0.125 cubed.
array<float> $cubes = [
    0.0, 1.0, 8.0, 27.0, 64.0, 125.0, 1000.0, 1728.0,
    -1.0, -8.0, -27.0, -1000.0,
    0.125, 3.375, 15.625, 0.001953125, -0.125, -15.625,
];
int $cbRows = 0;
int $cbBack = 0;
foreach ($cubes as float $m) {
    float $cbroot = Core\Math::cbrt($m);
    $cbRows = $cbRows + 1;
    if ($cbroot * $cbroot * $cbroot == $m) {
        $cbBack = $cbBack + 1;
    }
}
echo "cbrt rows=", $cbRows, " back=", $cbBack, "\n";

// Four roots read off the two sweeps, so a count of 18 cannot be reached by a
// member that answers a constant or that has quietly stopped at zero.
echo Core\Math::sqrt(68719476736.0), "|", Core\Math::sqrt(0.140625), "|",
     Core\Math::cbrt(1728.0), "|", Core\Math::cbrt(-15.625), "\n";

// The other half of the same rule. 2, 3 and 5 have no `float` square root, so
// the square of the rounded root is not the row: it is one or two units in the
// last place away from it, and which way depends only on where the true root
// fell. This is exact arithmetic, not an accident of the host — IEEE 754
// requires `sqrt` and `*` to be correctly rounded, so both differences below
// are the same on every conforming platform.
float $s2 = Core\Math::sqrt(2.0);
float $s3 = Core\Math::sqrt(3.0);
float $s5 = Core\Math::sqrt(5.0);
echo "2: eq=", ($s2 * $s2 == 2.0) as string, " off=", $s2 * $s2 - 2.0, "|\n";
echo "3: eq=", ($s3 * $s3 == 3.0) as string, " off=", $s3 * $s3 - 3.0, "|\n";
echo "5: eq=", ($s5 * $s5 == 5.0) as string, " off=", $s5 * $s5 - 5.0, "|\n";

// `cbrt` has no row in that block, and that is a claim rather than an omission:
// unlike `sqrt`, a cube root is not one of IEEE 754's correctly rounded
// operations, so `Core\Math::cbrt(2.0)` cubed is exactly 2.0 under glibc and
// one unit in the last place short of it under MSVC. There is no difference to
// freeze, which is why the irrational rows above are all square roots.

// The same rule under a logarithm, where "representable intermediate" reads as
// "an exact power of the base". Bases 2 and 10 each take f64's own routine
// rather than a ratio of natural logs, which is what lets the exponent come
// back as an integer. The table stops at 10^22 because that is the last power
// of ten a `float` holds exactly: 5^22 is under 2^53 and 5^23 is not.
array<array<float>> $powers = [
    [1.0, 2.0, 0.0],
    [2.0, 2.0, 1.0],
    [8.0, 2.0, 3.0],
    [1024.0, 2.0, 10.0],
    [0.5, 2.0, -1.0],
    [0.0625, 2.0, -4.0],
    [4503599627370496.0, 2.0, 52.0],
    [1.0, 10.0, 0.0],
    [10.0, 10.0, 1.0],
    [100.0, 10.0, 2.0],
    [1000.0, 10.0, 3.0],
    [1000000000000000.0, 10.0, 15.0],
    [10000000000000000000000.0, 10.0, 22.0],
];
int $lgRows = 0;
int $lgBack = 0;
foreach ($powers as array<float> $p) {
    float $value = $p["0"];
    float $base = $p["1"];
    float $want = $p["2"];
    $lgRows = $lgRows + 1;
    if (Core\Math::log($value, {base: $base}) == $want) {
        $lgBack = $lgBack + 1;
    }
}
echo "log rows=", $lgRows, " back=", $lgBack, "\n";
echo Core\Math::log(4503599627370496.0, {base: 2.0}), "|",
     Core\Math::log(10000000000000000000000.0, {base: 10.0}), "|",
     Core\Math::log(0.0625, {base: 2.0}), "\n";

// And `exp` against `log`, which is the pair with no exact rows at all bar the
// one fixed point: `exp($n)` is a power of `e`, and no power of `e` other than
// the zeroth is a `float`, so the round trip goes through a rounded
// intermediate on every other row. Neither member is a correctly rounded
// operation either, so this is asserted to a relative rounding step — the
// same reading `Core\Math::atanh` is held to in the parity case — rather than
// to equality, which would pin one libm.
array<float> $exponents = [
    0.0, 1.0, 2.0, -1.0, 0.5, -0.5, 3.0, 10.0, -3.25, 7.5, 0.125, -12.0,
];
int $xpRows = 0;
int $xpNear = 0;
foreach ($exponents as float $k) {
    float $back = Core\Math::log(Core\Math::exp($k));
    float $drift = $back - $k;
    float $mag = $k;
    if ($mag < 0.0) {
        $mag = 0.0 - $mag;
    }
    float $tol = 0.000000000001 * ($mag + 1.0);
    $xpRows = $xpRows + 1;
    if (($drift < $tol) && ($drift > 0.0 - $tol)) {
        $xpNear = $xpNear + 1;
    }
}
echo "exp/log rows=", $xpRows, " near=", $xpNear, "\n";

// The fixed point is the one row that is exact by definition rather than by
// rounding, and it is exact in both directions.
echo "fixed: ", (Core\Math::exp(0.0) == 1.0) as string, "|",
     (Core\Math::log(1.0) == 0.0) as string, "|",
     (Core\Math::log(Core\Math::exp(0.0)) == 0.0) as string, "|\n";
--EXPECT--
sqrt rows=18 back=18
cbrt rows=18 back=18
262144|0.375|12|-2.5
2: eq= off=4.4408920985006E-16|
3: eq= off=-4.4408920985006E-16|
5: eq= off=8.8817841970013E-16|
log rows=13 back=13
52|22|-4
exp/log rows=12 near=12
fixed: 1|1|1|
