--TEST--
`Core\Command::completions(Cli\Shell::Fish)` writes one `complete -c` line per command and per option spelling, with the dashes fish writes itself — `rule:tooling/commands-are-compiled`
--FILE--
<?nvs
class Deployer {
    #[Core\Command(name: "deploy", about: "Push the current build")]
    public static function deploy(
        string $target,
        #[Core\Option(short: "n", about: "Print what would happen")] bool $dryRun = false,
    ): uint {
        return 0;
    }

    #[Core\Command(name: "version")]
    public static function version(): uint {
        return 0;
    }
}

// fish has no completion *function*: the whole language is `complete` lines,
// gated by a condition. What this pins is the one translation the other three
// scripts do not do — fish writes an option's dashes itself, so `-n` is handed
// over as `-s n` and `--dryRun` as `-l dryRun`, and a script that passed the
// spelling through would register options nobody can type.
echo Core\Command::completions(Core\Cli\Shell::Fish);
--EXPECT--
# fish completion for case — generated by Core\Command::completions
complete -c 'case' -n '__fish_use_subcommand' -a 'deploy' -d 'Push the current build'
complete -c 'case' -n '__fish_seen_subcommand_from deploy' -s 'n' -d 'Print what would happen'
complete -c 'case' -n '__fish_seen_subcommand_from deploy' -l 'dryRun' -d 'Print what would happen'
complete -c 'case' -n '__fish_use_subcommand' -a 'version'
