--TEST--
`Core\Serialize::decode` checks every slot of a `Core` class it builds against the type the class states, as it checks a program's own properties — `rule:classes/serialize-is-a-closed-format`
--FILE--
<?nvs
class Forge
{
    // Returns one byte with the value `$value`.
    public static function byte(uint $value): bytes
    {
        return Core\Bytes::fill(1, $value);
    }

    // Returns the length of `$text` as one byte, then the text.
    public static function text(string $text): bytes
    {
        bytes $raw = $text as bytes;
        return Core\Bytes::join([Forge::byte(Core\Bytes::length($raw)), $raw]);
    }

    // Returns a payload with one `Core\Uri` object. `$values` is the bytes of
    // its eight properties, in order.
    public static function uri(bytes $values): bytes
    {
        array<string> $names = ['text', 'scheme', 'userInfo', 'host', 'port', 'path', 'query', 'fragment'];
        array<bytes> $parts = ['NVS' as bytes, Forge::byte(27), Forge::byte(1), Forge::byte(9)];
        $parts[] = Forge::text('Core\Uri');
        $parts[] = Forge::byte(Core\Arr::count($names));
        foreach ($names as string $name) {
            $parts[] = Forge::text($name);
        }
        $parts[] = $values;
        return Core\Bytes::join($parts);
    }

    // Returns the bytes of the whole number `$value`, from 0 to 255.
    public static function int(uint $value): bytes
    {
        return Core\Bytes::join([Forge::byte(2), Forge::byte($value), Core\Bytes::fill(7, 0)]);
    }

    // Returns the bytes of the string `$value`.
    public static function string(string $value): bytes
    {
        return Core\Bytes::join([Forge::byte(6), Forge::text($value)]);
    }

    // Returns the bytes of `null`.
    public static function none(): bytes
    {
        return Forge::byte(0);
    }

    // Decodes `$payload`, and prints `decoded` or the message of the `ParseError`.
    public static function decode(bytes $payload): void
    {
        bytes $trusted = Core\Taint::assertTrustedBytes($payload, 'this program wrote the bytes');
        try {
            Core\Serialize::decode($trusted);
            echo "decoded\n";
        } catch (ParseError $e) {
            echo $e->message, "\n";
        }
    }
}

// A `Core\Uri` that `encode` wrote is read back with the same parts.
Core\Uri $uri = Core\Uri::parse('https://example.com/cart?id=4');
Core\Uri $back = Core\Serialize::decode(Core\Serialize::encode($uri)) as Core\Uri;
echo $back->path(), "\n";

// The same object, written by hand. Every property has a value of its type.
Forge::decode(Forge::uri(Core\Bytes::join([
    Forge::string('https://example.com/a'),
    Forge::string('https'),
    Forge::none(),
    Forge::string('example.com'),
    Forge::none(),
    Forge::string('/a'),
    Forge::none(),
    Forge::none(),
])));

// The same bytes with the number 1 in `text`, which is a `string`.
Forge::decode(Forge::uri(Core\Bytes::join([
    Forge::int(1),
    Forge::string('https'),
    Forge::none(),
    Forge::string('example.com'),
    Forge::none(),
    Forge::string('/a'),
    Forge::none(),
    Forge::none(),
])));
--EXPECT--
/cart
decoded
Core\Serialize::decode(): `Core\Uri` declares property `text` as `string`, so an int cannot be written to it
