--TEST--
Core\Math::floor, truncate, round and ceil bracket every row in that order and the two ends are never more than one apart, truncate is the end nearer zero and round the end nearer the row — which leaves it undetermined at an exact half and nowhere else — docs/spec/01-core-library.md § 3
--FILE--
<?nvs
// The two cases beside this one take the halves where these members are *not*
// separated: they are all four the identity where there is no fraction
// (math-the-four-rounding-members-agree-wherever-there-is-no-fraction.nvst),
// and the six modes differ only at an exact tie
// (math-only-an-exact-tie-tells-the-round-modes-apart.nvst). This one takes the
// half where a fraction is present and no mode has been named: what constrains
// the four members there is an *ordering*, and each of them is a different rule
// for choosing an end of the same one-wide interval.
//
// Every row is a base plus a dyadic quarter, so every value below is exact and
// every comparison is a comparison of the numbers written rather than of what a
// decimal literal happened to become.
array<float> $bases = [-3.0, -2.0, -1.0, 0.0, 1.0, 2.0, 3.0];
array<float> $offsets = [0.0, 0.25, 0.5, 0.75];
int $rows = 0;
int $bracketed = 0;
int $gapOne = 0;
int $noFraction = 0;
int $towardZero = 0;
int $roundIsAnEnd = 0;
int $nearer = 0;
int $strictlyNearer = 0;
int $ties = 0;
foreach ($bases as float $b) {
    foreach ($offsets as float $o) {
        float $x = $b + $o;
        float $f = Core\Math::floor($x);
        float $c = Core\Math::ceil($x);
        float $t = Core\Math::truncate($x);
        float $r = Core\Math::round($x);
        $rows = $rows + 1;
        // 1. The interval. `floor` is at or below the row and `ceil` at or
        //    above it, on every row and in both signs — the claim a member
        //    that had grown a toward-zero habit at negative arguments fails,
        //    while still answering an integer on every line it prints.
        if (($f <= $x) && ($x <= $c)) {
            $bracketed = $bracketed + 1;
        }
        // 2. And it is one wide wherever there is a fraction, which is what
        //    makes "an end of the interval" a two-way choice rather than an
        //    open one. Where there is none the interval collapses and all four
        //    members have nothing to choose between.
        if ($c - $f == 1.0) {
            $gapOne = $gapOne + 1;
        }
        // 3. `truncate` is the end nearer zero, which is `floor` on one side of
        //    the origin and `ceil` on the other. Counted over both signs
        //    together, so a member implemented as one of the two outright fails
        //    on half the table rather than passing a case that only tested the
        //    positive half.
        if ($x < 0.0) {
            if ($t == $c) {
                $towardZero = $towardZero + 1;
            }
        } else {
            if ($t == $f) {
                $towardZero = $towardZero + 1;
            }
        }
        // 4. `round` is always one of the two ends — never a third value, and
        //    never outside the interval.
        if (($r == $f) || ($r == $c)) {
            $roundIsAnEnd = $roundIsAnEnd + 1;
        }
        float $toF = $x - $f;
        float $toC = $c - $x;
        // 5. And it is never further from the row than half the interval, which
        //    holds on every row including the ties.
        if (Core\Math::abs($r - $x) <= 0.5) {
            $nearer = $nearer + 1;
        }
        // 6. The partition that says where the ordering stops determining the
        //    answer. Three disjoint kinds of row: no interval to choose in, an
        //    interval whose two ends are equally far — where nearness has
        //    nothing to say and the mode of
        //    math-only-an-exact-tie-tells-the-round-modes-apart.nvst is what
        //    answers — and everything else, where `round` is pinned to the
        //    nearer end and is asserted to be exactly that.
        if ($c == $f) {
            $noFraction = $noFraction + 1;
        } else if ($toF == $toC) {
            $ties = $ties + 1;
        } else {
            float $near = $toF;
            if ($toC < $toF) {
                $near = $toC;
            }
            if (Core\Math::abs($r - $x) == $near) {
                $strictlyNearer = $strictlyNearer + 1;
            }
        }
    }
}
// Twenty-eight rows, and the first three claims hold on all of them.
echo "rows=", $rows, " bracketed=", $bracketed, " gap1=", $gapOne, " gap0=", $noFraction, "\n";
echo "towardZero=", $towardZero, " roundIsAnEnd=", $roundIsAnEnd, " nearer=", $nearer, "\n";
// Seven plus seven plus fourteen is the whole table, so the fourteen rows on
// which `round` is pinned by nearness are counted rather than assumed: the
// halves are the only rows left over, which is the whole claim.
echo "partition: ", $noFraction, "+", $ties, "+", $strictlyNearer, "\n";

// The seven ties, read on their own. With no mode named the default is PHP's —
// away from zero — so the ordering's two ends are chosen symmetrically about
// the origin rather than always upward, which is the one place `round` is not
// monotone-looking on a line of consecutive halves.
echo "halves: ", Core\Math::round(-2.5), "|", Core\Math::round(-1.5), "|",
     Core\Math::round(0.5), "|", Core\Math::round(1.5), "|", Core\Math::round(2.5), "\n";
// One tie in each sign, with all four members side by side: `truncate` and
// `round` take opposite ends of the same interval, and swap which end that is
// when the sign flips.
echo "at -2.5: floor=", Core\Math::floor(-2.5), " ceil=", Core\Math::ceil(-2.5),
     " truncate=", Core\Math::truncate(-2.5), " round=", Core\Math::round(-2.5), "\n";
echo "at 2.5:  floor=", Core\Math::floor(2.5), " ceil=", Core\Math::ceil(2.5),
     " truncate=", Core\Math::truncate(2.5), " round=", Core\Math::round(2.5), "\n";

// The interval between `-1.0` and `0.0` is the one whose upper end carries a
// sign `==` cannot read, and a *fraction* is what reaches it — the fixed-point
// case beside this one can only ask about a `-0.0` that was already there. All
// four members answer the negative zero, read here by its reciprocal.
echo "zero sign: ", 1.0 / Core\Math::floor(-0.0), "|", 1.0 / Core\Math::ceil(-0.25), "|",
     1.0 / Core\Math::truncate(-0.25), "|", 1.0 / Core\Math::round(-0.25), "\n";
--EXPECT--
rows=28 bracketed=28 gap1=21 gap0=7
towardZero=28 roundIsAnEnd=28 nearer=28
partition: 7+7+14
halves: -3|-2|1|2|3
at -2.5: floor=-3 ceil=-2 truncate=-2 round=-3
at 2.5:  floor=2 ceil=3 truncate=2 round=3
zero sign: -INF|-INF|-INF|-INF
