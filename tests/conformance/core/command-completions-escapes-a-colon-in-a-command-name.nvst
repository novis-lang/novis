--TEST--
`Core\Command::completions(Cli\Shell::Zsh)` escapes a colon inside a command's own name, so `db:migrate` stays one command word rather than becoming `db` with a description — `rule:tooling/commands-are-compiled`
--FILE--
<?nvs
// `db:migrate` is an ordinary command spelling and a common one. `_describe`
// reads an entry as the command word up to its first colon and the description
// after it, so a name carrying one has to say which colon is its own. A
// generator that escaped only the description's colons renders plausibly for
// every other name and offers `db` here.
//
// The `case` arm below is the other half of the same fact: it quotes the name
// for the *shell*, which splits on nothing, so the colon is not escaped there
// and the two spellings of one name are not interchangeable.
class Migrations {
    #[Core\Command(name: "db:migrate", about: "Apply pending migrations")]
    public static function migrate(
        #[Core\Option(short: "p", about: "Say what would happen and stop")] bool $pretend = false,
    ): uint {
        return 0;
    }

    // No `about:`, so the entry is the bare name — and `_describe` splits an
    // entry whether or not a description was written, so this colon is escaped
    // as well.
    #[Core\Command(name: "db:seed")]
    public static function seed(): uint {
        return 0;
    }
}

echo Core\Command::completions(Core\Cli\Shell::Zsh);
--EXPECT--
#compdef case
# zsh completion for case — generated by Core\Command::completions
_case() {
    local -a commands
    commands=(
        'db\:migrate:Apply pending migrations'
        'db\:seed'
    )
    if (( CURRENT == 2 )); then
        _describe 'command' commands
        return
    fi
    case "${words[2]}" in
        'db:migrate') _arguments '-p[Say what would happen and stop]' '--pretend[Say what would happen and stop]' ;;
    esac
}
_case "$@"
