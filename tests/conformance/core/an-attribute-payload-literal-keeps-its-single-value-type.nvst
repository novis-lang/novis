--TEST--
A string, int, `true` or enum-case literal in an attribute's payload is read at the single-value type its declaration names for the field, as an assignment of the same literal reads it, nested shapes and arrays included, and a retrieval of that declaration finds it — `rule:types/single-value-types` and `rule:attributes/attach-sites-and-forms`
--FILE--
<?nvs
enum Mode {
    Off,
    On,
}

attribute Link on property { onRemove?: 'keep'|'clear'|'cascade' }
attribute Level on property { level: 1|2|3, strict: true, mode: Mode::On|Mode::Off }
attribute Sort on property { order: array<'asc'|'desc'>, page: { size: 10|20|50 } }

type LinkValue = { onRemove?: 'keep'|'clear'|'cascade' };

class Post
{
    #[Link(onRemove: 'clear')]
    public string $author = '';

    #[Link]
    public string $editor = '';

    #[Level(level: 2, strict: true, mode: Mode::On)]
    #[Sort(order: ['asc', 'desc'], page: { size: 20 })]
    public string $title = '';
}

// The same literal assigned to the shape is already read this way.
LinkValue $direct = { onRemove: 'clear' };
echo "direct: ", $direct->onRemove, "\n";

// Each payload is found by the declaration it was written under.
var $link = Core\Attributes::get<Link>(Post::constructor, 'author');
echo "author: ", $link == null ? "null" : $link->onRemove, "\n";
var $none = Core\Attributes::get<Link>(Post::constructor, 'editor');
echo "editor: ", $none == null ? "null" : ($none->onRemove ?? "no value"), "\n";
var $level = Core\Attributes::get<Level>(Post::constructor, 'title');
echo "level: ", $level == null ? "null" : $level->level, " ", $level?->mode == Mode::On ? "On" : "other", "\n";
var $sort = Core\Attributes::get<Sort>(Post::constructor, 'title');
echo "sort: ", $sort == null ? "null" : Core\Str::join($sort->order, ', ') . " " . $sort->page->size, "\n";
--EXPECT--
direct: clear
author: clear
editor: no value
level: 2 On
sort: asc, desc 20
