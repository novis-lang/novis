--TEST--
`Core\Csrf::token` for a visitor who presents the session cookie it was sent keeps that session: no second cookie is set, and the new token passes the server like the first — `rule:security/csrf-is-on-by-default`
--FILE nvs.toml--
[http]
csrf_key = "BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc"
--FILE--
<?nvs
// covers: Core\Csrf::token
class Notes {
    #[Core\Route(path: "/form", method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function form(): void {
        Core\Session::start();
        echo Core\Csrf::token();
    }

    #[Core\Route(path: "/notes", method: Core\Http\Method::Post)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function save(): void {
        echo "saved";
    }
}

class Gate implements Core\Router\Gate {
    public function allows(Core\Router\Match $route): bool {
        return true;
    }

    public function refused(Core\Router\Refusal $reason, ?Core\Router\Match $route): void {
        echo "refused";
    }

    public function failed(?Core\Router\Match $route, ?Throwable $error): void {
        echo "failed";
    }
}

if (Core\Env::context() == Core\Env::Context::Request) {
    Core\Router::dispatch(new Gate());
} else {
    var $first = Core\Test::request(Core\Http\Method::Get, "/form");
    string $session = $first->cookies()["nvsid"] ?? "";
    string $old = $first->body() as string;

    // The second visit sends the cookie back. The page gets a new token and no new cookie.
    array<string> $cookie = ["cookie" => "nvsid=" . $session];
    var $second = Core\Test::request(Core\Http\Method::Get, "/form", {headers: $cookie});
    string $new = $second->body() as string;
    echo "new cookies: ", Core\Arr::count($second->cookies()), "\n";
    echo "the token changed: ", $new != $old ? "yes" : "no", "\n";

    // Both tokens pass with the one cookie.
    array<string> $tokens = [$old, $new];
    foreach ($tokens as string $token) {
        array<string> $form = ["cookie" => "nvsid=" . $session, "x-csrf-token" => $token];
        var $saved = Core\Test::request(Core\Http\Method::Post, "/notes", {headers: $form});
        echo $saved->status(), " ", $saved->body(), "\n";
    }
}
--EXPECT--
new cookies: 0
the token changed: yes
200 saved
200 saved
