--TEST--
Core\Json::encode is decode's inverse over every canonical document, isValid agrees with decode on every spelling, and the four places a re-encoding is deliberately not the input — spec § 6
--FILE--
<?nvs
// The sibling case pins § 6's members row by row. This one pins the property
// the pair is written around: for a document already in the form `encode`
// writes, decoding and re-encoding is the identity. A decoder that lost key
// order, re-spelled a number or dropped an escape would pass a row-by-row
// case and fail this one.
//
// The last four rows are malformed on purpose — a missing quote, the empty
// document, a trailing comma and a second document after the first — because
// `isValid` and `decode` are swept *together* and only their agreement is
// counted. That is the claim the pair makes: `isValid` is `decode` with the
// throw turned into a `false`, for every spelling rather than for the rows
// each member's own case happens to write.
array<string> $docs = [
    "{\"a\":1}",
    "[1,2,3]",
    "\"x\"",
    "true",
    "null",
    "0",
    "-1",
    "3.5",
    "[[1]]",
    "{\"a\":{\"b\":[]}}",
    "\"\"",
    "9223372036854775807",
    "{oops}",
    "",
    "[1,]",
    "[1] [2]",
];
int $agree = 0;
int $valid = 0;
int $trip = 0;
foreach ($docs as string $d) {
    bool $threw = false;
    try {
        Core\Json::decode($d);
    } catch (ParseError $malformed) {
        $threw = true;
    }
    $agree = $agree + ((Core\Json::isValid($d) == !$threw) ? 1 : 0);
    $valid = $valid + (Core\Json::isValid($d) ? 1 : 0);
    if (!$threw) {
        $trip = $trip + ((Core\Json::encode(Core\Json::decode($d)) == $d) ? 1 : 0);
    }
}
echo "agree ", $agree, " valid ", $valid, " of ", Core\Arr::count($docs), "\n";
echo "round trip ", $trip, " of ", $valid, "\n";

// The one document that cannot round-trip, and the reason is the language
// rather than the codec: Novis has one array type, so an empty JSON object and
// an empty JSON array decode to the same value and both re-encode as a list.
// A non-empty object keeps its keys and therefore its shape.
echo Core\Json::encode(Core\Json::decode("{}")), "|", Core\Json::encode(Core\Json::decode("[]")), "|\n";

// A number is re-spelled to what it *is* rather than to how it was written:
// JSON has one number type and Novis has three, so an exponent and a redundant
// sign come back as the float they denote. An integer stays an integer, which
// is why the sweep above round-trips `9223372036854775807` exactly.
echo Core\Json::encode(Core\Json::decode("1e2")), "|", Core\Json::encode(Core\Json::decode("-0")), "|", Core\Json::encode(Core\Json::decode("1.0")), "|\n";

// A repeated key is the last one, because the document decodes into one array
// and a second write to a key replaces it — PHP's json_decode answers the
// same, and RFC 8259 leaves it to the implementation.
echo Core\Json::encode(Core\Json::decode("{\"a\":1,\"a\":2}")), "|\n";

// An escape is decoded, not preserved: `\u00e9` is the character é, and
// re-encoding writes it as itself unless {escapeUnicode: true} asks otherwise
// — which then writes a non-BMP character as the surrogate pair JSON has no
// other spelling for.
echo Core\Json::encode(Core\Json::decode("\"\\u00e9\"")), "|", Core\Json::encode(Core\Json::decode("\"\\ud83d\\ude00\""), {escapeUnicode: true}), "|\n";

// A control character has to be escaped and is; a solidus does not have to be
// and is not, which is where json_encode's JSON_UNESCAPED_SLASHES went.
echo Core\Json::encode("a\tb"), "|", Core\Json::encode("a/b"), "|\n";
--EXPECT--
agree 16 valid 12 of 16
round trip 12 of 12
[]|[]|
100.0|-0.0|1.0|
{"a":2}|
"é"|"\ud83d\ude00"|
"a\tb"|"a/b"|
