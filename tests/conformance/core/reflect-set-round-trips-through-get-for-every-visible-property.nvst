--TEST--
Every name `Core\Reflect\ClassInfo::properties` hands back is one `set` writes and `get` reads back, asserted by counting rather than line by line — `rule:security/reflection-enforces-visibility`
--FILE--
<?nvs
// `rule:security/reflection-enforces-visibility`: the walk, the read and the write are one visibility answer.
// A member that grew its own would still look right on any single line, so
// this asks the whole roster at once and counts.
class Settings {
    public string $host = "localhost";
    public string $scheme = "https";
    public string $realm = "internal";
    private string $key = "hidden";
}

var $settings = new Settings();
var $described = Core\Reflect::forObject($settings);

int $written = 0;
int $agreed = 0;
foreach ($described->readableProperties() as string $property) {
    $written = $written + 1;
    $described->set($settings, $property, "rewritten-" . $property);
    if ($described->get($settings, $property) == "rewritten-" . $property) {
        $agreed = $agreed + 1;
    }
}

// Three, not four: `properties` never names the `private` one, and `set`
// refuses it under the same rule, so the roster and the write agree about
// which names exist for code outside the class.
echo "written=", $written, " agreed=", $agreed, "\n";

// The ordinary read sees the same values, so the writes landed in the object
// itself rather than anywhere reflection kept its own copy.
echo $settings->host, " ", $settings->scheme, " ", $settings->realm, "\n";
--EXPECT--
written=3 agreed=3
rewritten-host rewritten-scheme rewritten-realm
