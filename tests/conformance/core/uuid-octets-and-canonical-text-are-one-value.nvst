--TEST--
`$uuid->toBytes` and `$uuid->toString` render one UUID two ways, and `Core\Uuid::fromBytes` and `Core\Uuid::parse` read the same value back from either — spec § 11
--FILE--
<?nvs
// covers: Core\Uuid::toBytes
// The two doors onto one value. What is asserted is their *agreement*, asked
// of every row and counted, rather than what either answered on its own line:
// a `toBytes` that reversed the octets renders plausibly and round-trips
// against its own `fromBytes`, and fails only when the text is asked too.
array<string> $rows = [
    "00112233-4455-6677-8899-aabbccddeeff",
    "f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4",
    "0180d1e6-8e3c-7c2a-9a4b-1f2e3d4c5b6a",
    "00000000-0000-0000-0000-000000000000",
];
int $spelled = 0;
int $agreed = 0;
foreach ($rows as string $text) {
    // The octets are the canonical digits in the canonical order, so their hex
    // is that text with the hyphens taken out and nothing else changed.
    string $plain = Core\Str::replace($text, "-", "");
    $spelled = $spelled
        + ((Core\Encoding::toHex(Core\Uuid::parse($text)->toBytes()) == $plain) ? 1 : 0);

    // And the two readers answer the same UUID, whichever door it came in
    // through — the octets those digits spell, and the text itself.
    $agreed = $agreed
        + ((Core\Uuid::fromBytes(Core\Encoding::fromHex($plain))->toString()
            == Core\Uuid::parse($text)->toString()) ? 1 : 0);
}
echo "spelled ", $spelled, " agreed ", $agreed, " of ", Core\Arr::count($rows), "\n";

// The same agreement where no text was written down first, which is the shape
// a driver is in: it holds a drawn value and a column that takes octets.
var $drawn = Core\Uuid::v4();
echo Core\Encoding::toHex($drawn->toBytes()) == Core\Str::replace($drawn->toString(), "-", "")
    ? "draw agrees" : "draw differs", "\n";

// `toBytes` is a rendering and not a handle: two calls answer equal buffers,
// and neither is the UUID itself, so nothing a program does to one is visible
// through the other.
var $twice = Core\Uuid::v7();
echo Core\Bytes::compare($twice->toBytes(), $twice->toBytes()), "\n";
--EXPECT--
spelled 4 agreed 4 of 4
draw agrees
0
