--TEST--
`Core\Router::dispatch` passes an enum path capture and an enum query value to the route method as a case of the enum — `rule:routing/an-enum-capture-is-spelled-by-its-backing-value-or-its-case-name`
--FILE--
<?nvs
// covers: Core\Router::dispatch
enum Mode: uint { Fast = 1, Slow = 2 }

class Search {
    // `{mode}` and the query key `then` both convert `1` or `2` to a case of `Mode`.
    #[Core\Route(path: "/find/{mode}", method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function find(Mode $mode, #[Core\Query] Mode $then = Mode::Fast): void {
        echo "mode ", $mode == Mode::Slow ? "slow" : "fast", ", then ", $then == Mode::Slow ? "slow" : "fast", "\n";
    }
}

// This gate allows every route and prints each refusal it receives.
class Gate implements Core\Router\Gate {
    public function allows(Core\Router\Match $route): bool {
        return true;
    }

    public function refused(Core\Router\Refusal $reason, ?Core\Router\Match $route): void {
        echo "refused\n";
    }

    public function failed(?Core\Router\Match $route, ?Throwable $error): void {
        echo "failed ", $error?->message ?? "no error", "\n";
    }
}

if (Core\Env::context() == Core\Env::Context::Request) {
    Core\Router::dispatch(new Gate());
} else {
    array<string> $targets = ["/find/2", "/find/1?then=2", "/find/3"];
    foreach ($targets as string $target) {
        var $answer = Core\Test::request(Core\Http\Method::Get, $target);
        echo $target, " -> ", $answer->status(), "\n", $answer->body();
    }
}
--EXPECT--
/find/2 -> 200
mode slow, then fast
/find/1?then=2 -> 200
mode fast, then slow
/find/3 -> 404
refused
