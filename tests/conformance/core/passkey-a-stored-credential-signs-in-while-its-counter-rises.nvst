--TEST--
A credential rebuilt with `Core\Passkey\Credential::of` signs in, the options list its id, a sign counter that does not rise throws unless both counters are zero, and `of` throws a `LogicError` for a key of another algorithm, an empty id and a negative counter — `rule:core-classes/passkey-verifies-a-webauthn-ceremony`
--GET--
under=a-request
--FILE--
<?nvs
// covers: Core\Passkey::registerOptions
// covers: Core\Passkey::verifyRegistration
// covers: Core\Passkey::signInOptions
// covers: Core\Passkey::verifySignIn
// covers: Core\Passkey::credentialId
// covers: Core\Passkey\Credential::of
// This program plays the browser. It signs each sign-in with an Ed25519 key from `Core\Crypto`.
final class Device {
    public static function signIn(string $options, Core\Crypto\KeyPair $key, bytes $id, int $count): string {
        var $read = Core\Json::decode($options) as array<mixed>;
        string $challenge = Core\Taint::assertTrusted($read["challenge"] as string, "this program wrote the options");
        bytes $client = Core\Encoding::encodeText(
            "{\"type\":\"webauthn.get\",\"challenge\":\"" . $challenge . "\",\"origin\":\"https://example.com\"}",
            Core\Charset::Utf8,
        );
        bytes $auth = Core\Bytes::join([
            Core\Hash::of("example.com", Core\Hash::Digest::Sha256),
            Core\Bytes::pack("C", 0x05),
            Core\Bytes::pack("N", $count),
        ]);
        bytes $signature = Core\Crypto::sign(
            Core\Bytes::join([$auth, Core\Hash::of($client, Core\Hash::Digest::Sha256)]),
            $key,
        );
        return "{\"type\":\"public-key\",\"id\":\"" . Core\Encoding::toBase64Url($id)
            . "\",\"response\":{\"clientDataJSON\":\"" . Core\Encoding::toBase64Url($client)
            . "\",\"authenticatorData\":\"" . Core\Encoding::toBase64Url($auth)
            . "\",\"signature\":\"" . Core\Encoding::toBase64Url($signature) . "\"}}";
    }

    // Signs in once with a fresh challenge, and prints the counter or the error.
    public static function try(Core\Passkey\Credential $stored, Core\Crypto\KeyPair $key, int $count): Core\Passkey\Credential {
        string $options = Core\Passkey::signInOptions("example.com", [$stored]);
        string $sent = Device::signIn($options, $key, $stored->id(), $count);
        try {
            Core\Passkey\Credential $now = Core\Passkey::verifySignIn($sent, $stored, "example.com", "https://example.com");
            echo "sent ", $count, ": signed in, counter ", $now->signCount(), "\n";
            return $now;
        } catch (RuntimeError $e) {
            echo "sent ", $count, ": ", Core\Str::after($e->message, "(): ") ?? $e->message, "\n";
            return $stored;
        }
    }
}

Core\Session::start();
Core\Crypto\KeyPair $key = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519);
bytes $cose = Core\Bytes::join([
    Core\Encoding::fromHex("a4010103272006215820"),
    $key->publicKey()->write(Core\Crypto\PublicKey::Format::Raw),
]);
bytes $id = Core\Encoding::fromHex("0a0b0c0d");

// The application saved these four values when the passkey was registered.
Core\Passkey\Credential $stored = Core\Passkey\Credential::of($id, $cose, Core\Passkey\Credential::Algorithm::Ed25519, 0);

// Both options list the saved id, in base64url.
var $create = Core\Json::decode(Core\Passkey::registerOptions("example.com", "Example", Core\Encoding::fromHex("01"), "ada", [$stored])) as array<mixed>;
var $excluded = ($create["excludeCredentials"] as array<mixed>)[0] as array<mixed>;
echo "registerOptions excludes ", $excluded["id"] as string, "\n";
var $get = Core\Json::decode(Core\Passkey::signInOptions("example.com", [$stored])) as array<mixed>;
var $allowed = ($get["allowCredentials"] as array<mixed>)[0] as array<mixed>;
echo "signInOptions allows ", $allowed["id"] as string, "\n";

// A registration response that is not JSON throws.
try {
    Core\Passkey::verifyRegistration("not json", "example.com", "https://example.com");
} catch (RuntimeError $e) {
    echo "registration: ", Core\Str::after($e->message, "(): ") ?? $e->message, "\n";
}

// A device that keeps no counter sends 0 every time, and that signs in.
$stored = Device::try($stored, $key, 0);
$stored = Device::try($stored, $key, 0);

// Once a counter is not zero, it must rise.
$stored = Device::try($stored, $key, 5);
$stored = Device::try($stored, $key, 5);
$stored = Device::try($stored, $key, 3);
$stored = Device::try($stored, $key, 6);
echo "id read back: ", Core\Encoding::toHex(Core\Passkey::credentialId(Device::signIn("{\"challenge\":\"AA\"}", $key, $stored->id(), 7))), "\n";

// `of` checks the saved values again.
try {
    Core\Passkey\Credential::of($id, $cose, Core\Passkey\Credential::Algorithm::ES256, 0);
} catch (LogicError $wrong) {
    echo "other algorithm: ", Core\Str::after($wrong->message, "(): ") ?? $wrong->message, "\n";
}
try {
    Core\Passkey\Credential::of(Core\Encoding::fromHex(""), $cose, $stored->algorithm(), 0);
} catch (LogicError $empty) {
    echo "empty id: ", Core\Str::after($empty->message, "(): ") ?? $empty->message, "\n";
}
try {
    Core\Passkey\Credential::of($id, $stored->publicKey(), $stored->algorithm(), -1);
} catch (LogicError $negative) {
    echo "negative counter: ", Core\Str::after($negative->message, "(): ") ?? $negative->message, "\n";
}
--EXPECT--
registerOptions excludes CgsMDQ
signInOptions allows CgsMDQ
registration: the response is not JSON.
sent 0: signed in, counter 0
sent 0: signed in, counter 0
sent 5: signed in, counter 5
sent 5: the sign counter is 5, and the saved passkey has 5. The counter must increase, so the passkey may have been copied.
sent 3: the sign counter is 3, and the saved passkey has 5. The counter must increase, so the passkey may have been copied.
sent 6: signed in, counter 6
id read back: 0a0b0c0d
other algorithm: $publicKey is not a key of $algorithm.
empty id: $id is 0 bytes. It must be from 1 to 1023 bytes.
negative counter: $signCount is -1. It must be from 0 to 4294967295.
