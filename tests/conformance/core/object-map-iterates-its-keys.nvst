--TEST--
A `foreach` over a `Core\ObjectMap<K, V>` yields its keys, from a snapshot taken when the loop began — docs/spec/01-core-library.md § 9, ADR 0053 §§ 1, 3
--FILE--
<?nvs
final class Tag {
    public string $name;

    public function constructor(string $name) {
        $this->name = $name;
    }
}

Tag $red = new Tag("red");
Tag $blue = new Tag("blue");

Core\ObjectMap<Tag, int> $weights = new Core\ObjectMap<Tag, int>();
$weights->set($red, 3);
$weights->set($blue, 7);

// § 9: a map yields its keys, which is the half that hands `get` back the
// other one. The binding's type is `K` fixed at the receiver's own argument.
foreach ($weights as Tag $tag) {
    echo $tag->name, "=", $weights->get($tag) ?? 0, "\n";
}

// The loop walks a snapshot taken by `iterate()`, so a removal inside the body
// does not disturb the walk it is inside.
int $seen = 0;
foreach ($weights as Tag $tag) {
    $weights->remove($tag);
    $seen = $seen + 1;
}
echo $seen, " ", $weights->count(), "\n";
--EXPECT--
red=3
blue=7
2 0
