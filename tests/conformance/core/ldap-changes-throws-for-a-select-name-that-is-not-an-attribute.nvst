--TEST--
`changes` throws `LogicError` for a `select` name RFC 4512 does not allow before anything is sent, and throws `Unsupported` for a `base` that is not the root of the domain
--SKIPIF--
<?nvs
// The case needs the `samba-ad` server from `tests/db/compose.yaml`. Where it
// does not answer, the case is skipped, unless `NVS_LDAP_SAMBA` is set: CI's
// Linux leg runs the server and sets it, so a missing server fails there.
try {
    Core\Ldap::connect("corp");
} catch (Core\Ldap\LdapError $down) {
    if ($down->kind != Core\Ldap\LdapError::Kind::Unavailable || Core\Env::get("NVS_LDAP_SAMBA") != null) {
        throw $down;
    }
    echo "skip - ", $down->message, "\n";
}
--FILE--
<?nvs
var $corp = Core\Ldap::connect("corp");
var $units = Core\Ldap\Filter::equals("objectClass", "organizationalUnit");
array<string> $bad = ["ou)(objectClass=*", "*", "1ou", ""];
int $thrown = 0;
foreach ($bad as var $name) {
    try {
        $corp->changes($units, {select: ["ou", $name]});
    } catch (LogicError $notAName) {
        $thrown = $thrown + 1;
    }
}
echo "thrown: ", $thrown, " of ", Core\Arr::count($bad), "\n";

// DirSync starts only at the root of a domain.
try {
    $corp->changes($units, {base: "CN=Users,DC=example,DC=test"});
    echo "not the root: no error\n";
} catch (Core\Ldap\LdapError $error) {
    var $unsupported = $error->kind == Core\Ldap\LdapError::Kind::Unsupported;
    echo "not the root: ", $unsupported ? "Unsupported" : "another kind", ", code ", $error->code, "\n";
}
--COPY--
../../db/ca.crt
--FILE nvs.toml--
[capabilities.ldap]
connect = ["corp"]

[ldap.corp]
url = "ldaps://127.0.0.1:16636"
base = "DC=example,DC=test"
user = "CN=Administrator,CN=Users,DC=example,DC=test"
password = "Novis-test-1"
tls_ca_file = "ca.crt"
--EXPECT--
thrown: 4 of 4
not the root: Unsupported, code 53
