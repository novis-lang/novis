--TEST--
Core\Password hashes a secret without naming an algorithm or a cost, verifies on both sides of the bound, salts every call, and refuses a stored value that is not a hash — spec § 16, `rule:core-classes/secret-reveal`, `rule:core-api/tier-roster`, `rule:core-api/shape-rules`
--FILE--
<?nvs
// The whole surface is three members and none of them takes a parameter
// choice: `needsRehash` is how a stored hash learns it has fallen behind, so a
// caller never names a cost (spec § 16's row, and `crates/nvs-stdlib/src/password.rs`
// for which parameters this library picked).
secret string $password = "correct horse battery staple";

// A hash made now is by definition current, so `false` is the assertion.
string $stored = Core\Password::hash($password);
if (Core\Password::needsRehash($stored)) {
    echo "a fresh hash reported stale", "\n";
} else {
    echo "fresh", "\n";
}

// `rule:core-classes/secret-reveal`: `hash` takes a `secret` and answers something that is not one,
// which is the whole reason `$stored` is an ordinary `string` here.
if (Core\Password::verify($password, $stored)) {
    echo "accepts", "\n";
} else {
    echo "refused the right password", "\n";
}

// The bound, named on the other side too.
secret string $wrong = "hunter2";
if (Core\Password::verify($wrong, $stored)) {
    echo "accepted the wrong password", "\n";
} else {
    echo "refuses", "\n";
}

// Each call draws its own salt, so two users who chose one password are
// indistinguishable in the store — and both hashes still verify.
string $again = Core\Password::hash($password);
if ($again == $stored) {
    echo "two hashes of one password matched", "\n";
} else {
    echo "salted", "\n";
}
if (Core\Password::verify($password, $again)) {
    echo "both verify", "\n";
} else {
    echo "the second hash refused its own password", "\n";
}

// A stored value that is not a hash is a storage bug rather than a wrong
// password, so both readers throw instead of answering plausibly. PHP's
// `password_verify` answers `false` here and `password_needs_rehash` `true`;
// `rule:core-api/shape-rules`'s "failure throws" is why neither does.
try {
    bool $answered = Core\Password::verify($password, "not a stored hash");
    echo "verified against a non-hash", "\n";
} catch (LogicError $why) {
    echo "verify refuses a non-hash", "\n";
}
try {
    bool $stale = Core\Password::needsRehash("not a stored hash");
    echo "measured a non-hash", "\n";
} catch (LogicError $why) {
    echo "needsRehash refuses a non-hash", "\n";
}
--EXPECT--
fresh
accepts
refuses
salted
both verify
verify refuses a non-hash
needsRehash refuses a non-hash
