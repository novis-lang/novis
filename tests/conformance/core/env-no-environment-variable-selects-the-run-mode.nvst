--TEST--
No environment variable selects the run mode: `APP_ENV`, `NVS_ENV` and `NVS_MODE` are readable values and none of them moves `Core\Env::mode` — spec § 15
--ENV--
APP_ENV=development
NVS_ENV=development
NVS_MODE=development
--FILE--
<?nvs
// Spec § 15 says it outright: the mode "is set through `Core\Config`, like every
// other directive, and no environment variable is consulted for it". PHP has no
// run mode at all, so every framework invented a variable for this — and the
// convention this case pins is Novis *not* having one, on ADR 0063 R6's rule
// that no operation is reachable two ways.

// All three names are ordinary variables, and this same class reads them as
// such: they are values, not configuration.
echo "APP_ENV=", Core\Env::get("APP_ENV") ?? "<unset>", "\n";
echo "NVS_ENV=", Core\Env::get("NVS_ENV") ?? "<unset>", "\n";
echo "NVS_MODE=", Core\Env::get("NVS_MODE") ?? "<unset>", "\n";

// The file says production and every variable in the environment says
// development, so a member that consulted any of the three answers the other
// way here — which is what makes this a test and not a restatement.
echo "mode=", (Core\Env::mode() == Core\Env\Mode::Production) ? "Production" : "Development", "\n";

// Nor is development inferred from the ceiling merely permitting it: nothing
// asked for the flip, so what was written still stands.
echo "directive=", Core\Config::get("mode.default") ?? "unset", "\n";
--FILE nvs.toml--
[mode]
default = "production"
ceiling = "development"
--EXPECT--
APP_ENV=development
NVS_ENV=development
NVS_MODE=development
mode=Production
directive=production
