--TEST--
Core\Arr::map and ::filter carry each surviving entry's key across, leaving the subject alone
--FILE--
<?nvs
class Render {
    public static function of(array<int> $a): string {
        var $out = "";
        foreach ($a as string $k => int $v) {
            $out = $out . $k . "=" . $v . ";";
        }
        return $out;
    }
}

array<int> $scores = ["ann" => 3, "bob" => 8, "cy" => 5];

echo Render::of(Core\Arr::map($scores, fn(int $n) => $n * 10)), "\n";
echo Render::of(Core\Arr::filter($scores, fn(int $n) => $n > 4)), "\n";
echo Render::of($scores), "\n";

echo Core\Arr::count(Core\Arr::filter($scores, fn(int $n) => $n > 100)), "\n";
var $kept = Core\Arr::filter($scores, fn(int $n) => $n > 4);
echo Core\Str::join(Core\Arr::values(Core\Arr::map($kept, fn(int $n) => $n as string)), ","), "\n";
--EXPECT--
ann=30;bob=80;cy=50;
bob=8;cy=5;
ann=3;bob=8;cy=5;
0
8,5
