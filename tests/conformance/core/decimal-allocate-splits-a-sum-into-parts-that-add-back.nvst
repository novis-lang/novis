--TEST--
`rule:types/decimal` and `rule:types/arithmetic`: `Core\Decimal::allocate` splits a sum into parts at the amount's own scale that add back to it exactly
--FILE--
<?nvs
// The penny split. A third of five cents is not a number of cents, so the
// parts cannot all be equal -- and rounding each share on its own is exactly
// what loses or invents the cent that is left over.
decimal $nickel = 0.05;
array<decimal> $evenly = [1, 1, 1];
decimal $back = 0.00;
foreach (Core\Decimal::allocate($nickel, $evenly) as decimal $part) {
    echo $part, " ";
    $back = $back + $part;
}
echo "= ", $back, "\n";

// Weights that do come out even: nothing is left over, so nothing is handed
// out and every part is its exact share.
foreach (Core\Decimal::allocate(100.00, [7, 3]) as decimal $share) {
    echo $share, " ";
}
echo "\n";

// The amount's scale is the parts' scale (`rule:types/conversion` makes it
// observable), so the smallest unit a split can move is the one the amount is
// written in -- here a ten-thousandth rather than a cent.
foreach (Core\Decimal::allocate(1.0000, $evenly) as decimal $rate) {
    echo $rate, " ";
}
echo "\n";
--EXPECT--
0.02 0.02 0.01 = 0.05
70.00 30.00
0.3334 0.3333 0.3333
