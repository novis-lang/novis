--TEST--
`Core\IO\File::lock` takes an exclusive lock the handle holds, and a second handle is refused rather than made to wait — spec § 14, `rule:core-api/shape-rules` R3
--FILE--
<?nvs
// covers: Core\IO\File::lock
// PHP writes this as `flock($h, LOCK_EX)`, where a forgotten `LOCK_NB` is an
// unbounded wait on whatever other program holds the file. There is no such
// spelling here: the lock is taken or it is refused, and there is no mode
// argument to get wrong.
Core\IO\File $first = Core\IO::open("shared.txt", Core\IO\FileMode::ReadWrite);
$first->lock();
echo "held", "\n";

// A second handle on the same file. Opening is not locking, so this part
// succeeds; the lock does not, and it says so at once rather than waiting.
Core\IO\File $second = Core\IO::open("shared.txt", Core\IO\FileMode::ReadWrite);
try {
    $second->lock();
    echo "two handles held one lock", "\n";
} catch (IOError $busy) {
    echo $busy->message, "\n";
}

// The holder is untouched by the refusal — it still owns the file it locked,
// which is the whole point of having taken one.
$first->write("mine");
$first->close();
$second->close();
echo "wrote: ", Core\IO::readText("shared.txt"), "\n";
--FILE nvs.toml--
[capabilities.fs]
read = ["."]
write = ["."]
--EXPECT--
held
Core\IO\File::lock: another handle already holds the lock on shared.txt
wrote: mine
