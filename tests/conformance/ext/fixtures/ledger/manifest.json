{
  "manifest": 1,
  "world": "1.0.0",
  "class": "Shop\\Ledger",
  "interface": "shop:ledger/api",
  "methods": [
    {"name": "echoBool", "params": [{"name": "flag", "type": "bool"}], "returns": "bool",
     "help": "Returns `flag` unchanged."},
    {"name": "echoInt", "params": [{"name": "number", "type": "int"}], "returns": "int",
     "help": "Returns `number` unchanged."},
    {"name": "echoUint", "params": [{"name": "count", "type": "uint"}], "returns": "uint",
     "help": "Returns `count` unchanged."},
    {"name": "echoFloat", "params": [{"name": "amount", "type": "float"}], "returns": "float",
     "help": "Returns `amount` unchanged."},
    {"name": "echoString", "params": [{"name": "text", "type": "string"}], "returns": "string",
     "help": "Returns `text` unchanged."},
    {"name": "echoBytes", "params": [{"name": "data", "type": "bytes"}], "returns": "bytes",
     "help": "Returns `data` unchanged."},
    {"name": "echoList", "params": [{"name": "numbers", "type": "array<int>"}], "returns": "array<int>",
     "help": "Returns `numbers` unchanged."},
    {"name": "echoMap", "params": [{"name": "totals", "type": "array<string, int>"}],
     "returns": "array<string, int>",
     "help": "Returns `totals` unchanged, in the same order."},
    {"name": "echoItem", "params": [{"name": "row", "type": "{name: string, note?: string}"}],
     "returns": "{name: string, note?: string}",
     "help": "Returns `row` unchanged."},
    {"name": "echoOptional", "params": [{"name": "maybe", "type": "?int", "default": null}],
     "returns": "?int",
     "help": "Returns `maybe` unchanged. Without an argument, it returns `null`."},
    {"name": "echoArea", "params": [{"name": "shape", "type": "Area"}], "returns": "Area",
     "help": "Returns `shape` unchanged."},
    {"name": "echoInstant", "params": [{"name": "at", "type": "Core\\Time\\Instant"}],
     "returns": "Core\\Time\\Instant",
     "help": "Returns `at` unchanged."},
    {"name": "echoUri", "params": [{"name": "address", "type": "Core\\Uri"}], "returns": "Core\\Uri",
     "help": "Returns `address` unchanged."},
    {"name": "echoUnit", "params": [{"name": "unit", "type": "Unit"}], "returns": "Unit",
     "help": "Returns `unit` unchanged."},
    {"name": "kindOf", "params": [{"name": "anything", "type": "mixed"}], "returns": "int",
     "help": "Returns a number for the kind of `anything`: 0 for `null`, 1 for a `bool`, and so on."},
    {"name": "writeLine", "params": [{"name": "line", "type": "string", "sink": true}],
     "help": "Writes `line` to the ledger. `line` must not be tainted."},
    {"name": "fetch", "returns": "string", "source": true,
     "help": "Returns a line from outside the program. The result is tainted."},
    {"name": "fail", "params": [{"name": "kind", "type": "int"}, {"name": "message", "type": "string"}],
     "help": "Throws an error with `message`: a `LogicError` for 0, a `ParseError` for 1, a `RuntimeError` for 2."},
    {"name": "crash",
     "help": "Stops with an `ExtensionError`."}
  ],
  "consts": [{"name": "CURRENCY", "type": "string", "value": "EUR"}],
  "enums": [{"name": "Unit", "cases": ["Gram", "Kilogram", "MetricTon"]}],
  "unions": [{"name": "Area", "cases": [
    {"name": "Circle", "shape": "{radius: float}"},
    {"name": "Rect", "shape": "{width: float, height: float}"}]}]
}
