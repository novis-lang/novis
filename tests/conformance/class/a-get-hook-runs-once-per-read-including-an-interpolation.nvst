--TEST--
a `get` hook with a body runs on every read, and an interpolated `$obj->prop` is one of them — `rule:classes/property-hooks`
--FILE--
<?nvs
class Counter {
    public int $hits = 0;

    public int $value {
        get {
            $this->hits = $this->hits + 1;
            return 10;
        }
    }

    public function constructor() {
    }
}

var $c = new Counter();
echo $c->value, ";", $c->value, "\n";
echo "in a string: $c->value\n";
echo $c->hits, "\n";
// covers: lang:classes/property-hooks
--EXPECT--
10;10
in a string: 10
3
