--TEST--
a stored property an `extend` block adds runs the hooks the block writes: a `set` hook alone, a `get` and a `set` hook on a `lateinit` property, and the short `set =>` form. Inside its own hooks, `$this->p` reads and writes the stored value — `rule:classes/an-added-property-lives-in-one-hidden-slot`
--FILE--
<?nvs
namespace App;

use LogicError;
use Core\Str;
use Acme\Shop\Order;
use App\OrderLabels;

autoload 'Acme\Shop' from './vendor/acme/shop/src';

extend Order as OrderLabels {
    public ?string $label {
        set {
            $this->label = Str::trim($value ?? "");
        }
    }

    public lateinit int $count {
        get => $this->count * 10;
        set {
            if ($value < 0) {
                throw new LogicError("negative");
            }
            $this->count = $value;
        }
    }

    public ?string $code {
        set => Str::upper($value ?? "");
    }
}

var $order = new Order(100);
echo $order->label ?? "no label", " ", $order->code ?? "no code", "\n";
try {
    echo $order->count, "\n";
} catch (LogicError $e) {
    echo "unwritten\n";
}
$order->label = "  gift  ";
$order->count = 2;
$order->code = "ab";
echo "[", $order->label, "] ", $order->count, " ", $order->code, "\n";
$order->count += 1;
echo $order->count, "\n";
try {
    $order->count = -1;
} catch (LogicError $e) {
    echo "error: ", $e->message, "\n";
}
echo $order->count, "\n";
var $other = new Order(5);
echo $other->label ?? "no label", "\n";
// covers: lang:classes/extend-blocks
--FILE vendor/acme/shop/src/Order.nvs--
<?nvs
namespace Acme\Shop;

class Order
{
    public function constructor(public int $total) {}
}
--FILE vendor/acme/shop/package.toml--
[package]
name = 'Acme\Shop'
--EXPECT--
no label no code
unwritten
[gift] 20 AB
210
error: negative
210
no label
