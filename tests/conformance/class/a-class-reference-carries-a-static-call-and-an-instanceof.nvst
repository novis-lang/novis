--TEST--
`$cls::f()` dispatches on the descriptor and `$x instanceof $cls` tests against it — `rule:types/class-reference-sites`'s other two sites
--FILE--
<?nvs
// The two sites that take a class reference and are not `new`. A static call
// through one is virtual: the implementor's body wins where it has one, and
// the bound's is the fallback where it has not. An `instanceof` against one
// asks the same question a written class does, of a class this program only
// learns at run time.
class Formatter {
    public static function name(): string {
        return "plain";
    }

    // Late static binding sees the implementor, not the bound, because a
    // class reference's call hands the descriptor in as the callee's own
    // class — the arrangement `static::f()` already had.
    public static function describe(): string {
        return "a " . static::name() . " formatter";
    }
}

class Angled extends Formatter {
    public static function name(): string {
        return "angled";
    }
}

// Declares neither, so both calls below fall back to `Formatter`'s bodies.
class Quoted extends Formatter {
}

class<Formatter> $angled = Angled::class as class<Formatter>;
string $name = "Quoted";
class<Formatter> $quoted = $name as class<Formatter>;

echo $angled::name(), "\n";
echo $quoted::name(), "\n";
echo $angled::describe(), "\n";
echo $quoted::describe(), "\n";

Formatter $one = new $angled();
Formatter $two = new $quoted();

// The subject's class is the implementor, so it tests true against its own
// reference and false against a sibling's.
echo $one instanceof $angled ? "yes" : "no", "\n";
echo $one instanceof $quoted ? "yes" : "no", "\n";
echo $two instanceof $quoted ? "yes" : "no", "\n";

// A descriptor of the bound is a supertype, and the test walks the supertype
// set exactly as the written form does — so both spellings agree here.
class<Formatter> $base = Formatter::class as class<Formatter>;
echo $one instanceof $base ? "yes" : "no", "\n";
echo $one instanceof Formatter ? "yes" : "no", "\n";

// And the test answers rather than throwing when the subject is a `mixed`
// holding no object at all, which is the whole reason `instanceof` exists.
mixed $nothing = null;
echo $nothing instanceof $angled ? "yes" : "no", "\n";
--EXPECT--
angled
plain
a angled formatter
a plain formatter
yes
no
yes
yes
yes
no
