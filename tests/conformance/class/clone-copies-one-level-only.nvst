--TEST--
`clone` copies the object's own properties and shares whatever they point at — `rule:classes/clone-is-shallow`
--FILE--
<?nvs
class Tag {
    public string $text;

    public function constructor(string $text) {
        $this->text = $text;
    }
}

class Note {
    public string $title;
    public Tag $tag;

    public function constructor(string $title, Tag $tag) {
        $this->title = $title;
        $this->tag = $tag;
    }
}

var $original = new Note("first", new Tag("red"));
var $copy = clone $original;

$copy->title = "second";
echo $original->title, ",", $copy->title, "\n";

$copy->tag->text = "blue";
echo $original->tag->text, ",", $copy->tag->text, "\n";
--EXPECT--
first,second
blue,blue
