--TEST--
Reading a property of a revoked object throws an error
--FILE--
<?nvs
// After `revoke()`, reading `$post->title` throws a `RevokedObjectError`.
class Post implements Revocable {
    public function constructor(public string $title) {}
}

var $post = new Post("Hello");
echo $post->title, "\n";
$post->revoke();
try {
    echo $post->title, "\n";
    echo "not reached\n";
} catch (RevokedObjectError $e) {
    echo $e->message, "\n";
}
echo "done\n";
// covers: lang:classes/revocable-objects, RevokedObjectError
--EXPECT--
Hello
This `Post` object was revoked in `case.nvs` on line 9. A revoked object cannot be used.
done
