--TEST--
`is` is true for the class, every ancestor and every interface, and false for a sibling
--FILE--
<?nvs
interface Marks {
    public function mark(): string;
}

class Base implements Marks {
    public function mark(): string {
        return "base";
    }
}

class Middle extends Base {
}

class Leaf extends Middle {
}

class Other {
}

var $leaf = new Leaf();
var $other = new Other();

echo ($leaf is Leaf) as string, "|\n";
echo ($leaf is Middle) as string, "|\n";
echo ($leaf is Base) as string, "|\n";
echo ($leaf is Marks) as string, "|\n";
echo ($leaf is Other) as string, "|\n";
echo ($other is Marks) as string, "|\n";
echo $leaf->mark(), "|\n";
// covers: lang:classes/inheritance
--EXPECT--
1|
1|
1|
1|
|
|
base|
