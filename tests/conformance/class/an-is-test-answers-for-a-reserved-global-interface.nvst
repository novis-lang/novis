--TEST--
`is` answers for the four global interfaces the compiler declares and no source does — `rule:classes/comparable`, `rule:classes/stringable`, `rule:iteration/two-interfaces`
--FILE--
<?nvs
// `Stringable` and `Comparable` have no declaration anywhere: the compiler
// seeds them (`nvs_hir::interfaces`), so this pins that an implementor still
// carries a real ancestor edge to each at run time.
class Money implements Stringable, Comparable {
    public int $cents;

    public function constructor(int $cents) {
        $this->cents = $cents;
    }

    public function toString(): string {
        return ($this->cents) as string;
    }

    public function compareTo(Comparable $other): int {
        return 0;
    }
}

// The edge is inherited like any other: `Coin` names neither interface.
class Coin extends Money {
}

class Plain {
}

class Nums {
    public static function upTo(int $n): Iterator<int> {
        int $i = 0;
        while ($i < $n) {
            yield $i;
            $i = $i + 1;
        }
    }
}

var $m = new Money(250);
var $c = new Coin(5);
var $p = new Plain();
Iterator<int> $it = Nums::upTo(2);

echo ($m is Stringable) as string, "|\n";
echo ($m is Comparable) as string, "|\n";
echo ($c is Stringable) as string, "|\n";
echo ($p is Stringable) as string, "|\n";
echo ($p is Comparable) as string, "|\n";
// `rule:iteration/generators`'s state machine is a synthesized class implementing
// `Iterator`, so the same edge exists for a generator's own object. The right
// of `is` is a type (`rule:types/type-test`), so the argument `rule:iteration/two-interfaces`
// makes mandatory is written here as it is in a declaration; the walk itself
// compares descriptors and the argument is erased before it runs.
echo ($it is Iterator<int>) as string, "|\n";
echo ($m is Iterator<int>) as string, "|\n";
--EXPECT--
1|
1|
1|
|
|
1|
|
