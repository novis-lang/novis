--TEST--
one `compareTo` drives `<`, `>`, `<=`, `>=` and `<=>` alike, and its sign is what each of them reads — `rule:classes/ordering-lowers-to-compare-to`
--FILE--
<?nvs
// covers: lang:classes/comparable
class Version implements Comparable {
    public int $n;

    public function constructor(int $n) {
        $this->n = $n;
    }

    public function compareTo(Version $other): int {
        return $this->n - $other->n;
    }
}

var $a = new Version(2);
var $b = new Version(5);
var $c = new Version(2);
echo $a < $b, ";", $a > $b, ";", $a <= $c, ";", $a >= $c, "\n";
echo $a <=> $b, ";", $b <=> $a, ";", $a <=> $c, "\n";
--EXPECT--
1;;1;1
-3;3;0
