--TEST--
`clone` copies the object's own class along with its properties, so the copy answers `is` exactly as the original did — `rule:classes/clone-is-shallow`
--FILE--
<?nvs
class Shape {
    public int $side;

    public function constructor(int $side) {
        $this->side = $side;
    }
}

class Square extends Shape {
    public function constructor(int $side) {
        parent::constructor($side);
    }
}

var $s = new Square(3);
var $t = clone $s;
$t->side = 9;
echo $s->side, ";", $t->side, "\n";
echo $t is Square, ";", $t is Shape, "\n";
--EXPECT--
3;9
1;1
