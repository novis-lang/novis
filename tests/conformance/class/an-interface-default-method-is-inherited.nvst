--TEST--
An interface method with a body runs against the implementing class, and an implementor may override it
--FILE--
<?nvs
interface Greets {
    public function name(): string;

    public function greet(): string {
        return "Hello, " . $this->name() . "!";
    }
}

class Person implements Greets {
    private string $personName;

    public function constructor(string $personName) {
        $this->personName = $personName;
    }

    public function name(): string {
        return $this->personName;
    }
}

class Robot implements Greets {
    public function name(): string {
        return "unit-7";
    }

    public function greet(): string {
        return "BEEP " . $this->name();
    }
}

var $person = new Person("ada");
var $robot = new Robot();

echo $person->greet(), "\n";
echo $robot->greet(), "\n";
echo ($person is Greets) as string, "\n";
--EXPECT--
Hello, ada!
BEEP unit-7
1
