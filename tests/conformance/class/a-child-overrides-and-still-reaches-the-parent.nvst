--TEST--
An override calls `parent::` for the behaviour it extends, through two levels of inheritance
--FILE--
<?nvs
class Shape {
    public string $name;

    public function constructor(string $name) {
        $this->name = $name;
    }

    public function describe(): string {
        return "shape " . $this->name;
    }
}

class Polygon extends Shape {
    public int $sides;

    public function constructor(string $name, int $sides) {
        parent::constructor($name);
        $this->sides = $sides;
    }

    public function describe(): string {
        return parent::describe() . " with " . $this->sides . " sides";
    }
}

class Square extends Polygon {
    public function constructor() {
        parent::constructor("square", 4);
    }

    public function describe(): string {
        return parent::describe() . ", all equal";
    }
}

var $shape = new Shape("blob");
var $poly = new Polygon("pentagon", 5);
var $square = new Square();

echo $shape->describe(), "\n";
echo $poly->describe(), "\n";
echo $square->describe(), "\n";
echo ($square is Polygon) as string, "|", ($square is Shape) as string, "|", ($poly is Square) as string, "|\n";
// covers: lang:classes/methods-self-static-and-parent
--EXPECT--
shape blob
shape pentagon with 5 sides
shape square with 4 sides, all equal
1|1||
