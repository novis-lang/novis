--TEST--
An element write calls `beforePropertySet` with the new element and its key path: the append's next index, every level of a nested write, an `int` key as a string; a throw stops the write and the array keeps its entries
--FILE--
<?nvs
// covers: lang:classes/propertyguard
final class Sheet implements PropertyGuard {
    public array<string> $tags = [];
    public array<array<string>> $cells = [];
    public array<int> $counts = [];

    public function beforePropertySet(string $name, mixed $value, array<string> $keys): void {
        echo "  guard ", $name, " = ", Core\Json::encode($value), " keys ", Core\Json::encode($keys), "\n";
        if ($value == "bad") {
            throw new LogicError("bad value");
        }
    }

    public function beforePropertyUnset(string $name, array<string> $keys): void {}
}

Sheet $s = new Sheet();

echo "two appends:\n";
$s->tags[] = "a";
$s->tags[] = "b";

echo "a keyed write:\n";
$s->tags["k"] = "c";

echo "a nested write:\n";
$s->cells["0"]["1"] = "x";

echo "a nested append into a new row:\n";
$s->cells["r"][] = "y";

echo "an int key and an increment:\n";
$s->counts[7] = 1;
$s->counts[7]++;

echo "a refused write:\n";
try {
    $s->tags[] = "bad";
} catch (LogicError $e) {
    echo "  refused: ", $e->message, "\n";
}
echo Core\Json::encode($s->tags), "\n";
echo Core\Json::encode($s->cells), "\n";
echo Core\Json::encode($s->counts), "\n";
--EXPECT--
two appends:
  guard tags = "a" keys ["0"]
  guard tags = "b" keys ["1"]
a keyed write:
  guard tags = "c" keys ["k"]
a nested write:
  guard cells = "x" keys ["0","1"]
a nested append into a new row:
  guard cells = "y" keys ["r","0"]
an int key and an increment:
  guard counts = 1 keys ["7"]
  guard counts = 2 keys ["7"]
a refused write:
  guard tags = "bad" keys ["2"]
  refused: bad value
{"0":"a","1":"b","k":"c"}
{"0":{"1":"x"},"r":["y"]}
{"7":2}
