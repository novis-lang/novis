--TEST--
A constructor may satisfy its definite-initialization obligation from a private helper's return value
--FILE--
<?nvs
class Slug {
    public string $text;
    public int $length;

    public function constructor(string $raw) {
        $this->text = self::normalise($raw);
        $this->length = self::measure($this->text);
    }

    private static function normalise(string $raw): string {
        return Core\Str::lower(Core\Str::trim($raw));
    }

    private static function measure(string $s): int {
        return Core\Str::length($s) as int;
    }
}

var $s = new Slug("  Hello World  ");
echo $s->text, "|", $s->length, "\n";
echo (new Slug("NVS"))->text, "\n";
--EXPECT--
hello world|11
nvs
