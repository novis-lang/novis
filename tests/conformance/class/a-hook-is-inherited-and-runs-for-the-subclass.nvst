--TEST--
a subclass inherits the base's hooks, so a method it declares reads through the same `get` an outside read goes through
--FILE--
<?nvs
class Base {
    public int $n {
        get => $this->n * 2;
        set (int $v) {
            $this->n = $v + 1;
        }
    }

    public function constructor(int $n) {
        $this->n = $n;
    }
}

class Derived extends Base {
    public function constructor(int $n) {
        parent::constructor($n);
    }

    public function doubled(): int {
        return $this->n;
    }
}

var $d = new Derived(5);
echo $d->n, ";", $d->doubled(), "\n";
$d->n = 10;
echo $d->n, "\n";
// covers: lang:classes/property-hooks
--EXPECT--
12;12
22
