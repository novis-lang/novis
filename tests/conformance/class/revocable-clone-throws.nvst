--TEST--
Cloning a revoked object throws an error
--FILE--
<?nvs
// After `revoke()`, `clone $post` throws a `RevokedObjectError`.
class Post implements Revocable {
    public function constructor(public string $title) {}
}

var $post = new Post("Hello");
var $copy = clone $post;
echo $copy->title, "\n";
$post->revoke();
try {
    var $second = clone $post;
    echo "not reached\n";
} catch (RevokedObjectError $e) {
    echo $e->message, "\n";
}
echo $copy->title, "\n";
// covers: lang:classes/revocable-objects, RevokedObjectError
--EXPECT--
Hello
This `Post` object was revoked in `case.nvs` on line 10. A revoked object cannot be used.
Hello
