--TEST--
an interface may declare a `static` member beside its default method, and the default reaches it by name — ADR 0043 § 1
--FILE--
<?nvs
interface Shape {
    public function area(): int;

    public function describe(): string {
        return Shape::label() . " of area " . $this->area();
    }

    public static function label(): string {
        return "shape";
    }
}

class Rect implements Shape {
    public int $w;
    public int $h;

    public function constructor(int $w, int $h) {
        $this->w = $w;
        $this->h = $h;
    }

    public function area(): int {
        return $this->w * $this->h;
    }
}

var $r = new Rect(3, 4);
echo $r->describe(), "\n";
--EXPECT--
shape of area 12
