--TEST--
A `set` hook that throws leaves the property holding what it held before — the write never reaches the backing store
--FILE--
<?mwl
class Counter {
    public int $count {
        get => $this->count;
        set {
            if ($value < 0) {
                throw new LogicError("negative");
            }
            $this->count = $value;
        }
    }

    public function constructor() {
        $this->count = 0;
    }
}

var $c = new Counter();
$c->count = 7;
echo $c->count, "\n";
try {
    $c->count = -1;
} catch (LogicError $e) {
    echo "refused: ", $e->message, "\n";
}
echo $c->count, "\n";
$c->count = 8;
echo $c->count, "\n";
--EXPECT--
7
refused: negative
7
8
