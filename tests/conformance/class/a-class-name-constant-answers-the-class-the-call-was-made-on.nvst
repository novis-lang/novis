--TEST--
`static::class` is the class the call was made on and `$obj::class` the class the receiver is, both read off a descriptor the frame already holds — `rule:statements/static-is-a-member-modifier`'s late static binding at the one member that used to be folded instead
--FILE--
<?nvs
// covers: lang:classes/constants-and-class
namespace App;

class User {
    // `rule:statements/static-is-a-member-modifier` binds `static` to whichever class the call was made on, so
    // this answers the *called* class and never the declaring one. In a
    // `static` method that descriptor is parameter 0; in an instance method
    // it is `$this`'s own.
    public static function called(): string {
        return static::class;
    }

    // `self` is the class this method is declared in, and stays a compile-time
    // constant — `rule:statements/storage-that-outlives-a-call`'s "inlined at every use site". The two spellings
    // differing is the whole point of the one above.
    public static function declaring(): string {
        return self::class;
    }

    public function mine(): string {
        return static::class;
    }
}

class Admin extends User {
}

// A non-forwarding call sets the called class to the class it names.
echo User::called(), "\n";
echo Admin::called(), "\n";
echo Admin::declaring(), "\n";

// An instance method takes it off the receiver, so nothing is passed at the
// call site at all.
User $u = new Admin();
echo $u->mine(), "\n";

// `$obj::class` answers the class the receiver *is*, not the one its variable
// was declared as — which is why it cannot be folded even here, where the
// declared type resolved.
echo $u::class, "\n";
echo (new User())::class, "\n";

// It is a `string` like every other `::class`: it binds, concatenates and
// compares.
string $s = $u::class;
echo $s . "!", "\n";
echo ($u::class == "App\\Admin") as string, "\n";

// A `?T` narrowed to its class half reaches the same read the plain one does.
?User $maybe = new Admin();
if ($maybe != null) {
    echo $maybe::class, "\n";
}
--EXPECT--
App\User
App\Admin
App\User
App\Admin
App\Admin
App\User
App\Admin!
1
App\Admin
