--TEST--
The value `Core\Secret::reveal` returns is a plain string, so it crosses `spawn script`'s `args:`, a spawn placed on a worker and `Core\Serialize::encode` — `rule:security/secret-crosses-no-boundary`
--FILE nvs.toml--
[capabilities.script]
spawn = true
--FILE child.nvs--
<?nvs
return Core\Script::args();
--FILE--
<?nvs
// `$token` cannot cross any of the three. `reveal` returns a plain string,
// and that string crosses each of them.
secret string $token = "sk-test";
string $plain = Core\Secret::reveal($token, "the child signs requests with it");

var $here = spawn script "child.nvs" with(args: $plain);
echo (await $here)->value, "\n";

var $there = spawn script "child.nvs" with(args: $plain, on: "worker");
echo (await $there)->value, "\n";

bytes $saved = Core\Serialize::encode($plain);
echo Core\Serialize::decode($saved), "\n";
--EXPECT--
sk-test
sk-test
sk-test
