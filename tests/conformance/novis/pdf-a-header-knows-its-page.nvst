--TEST--
A header function's `Page` carries its number, the count, whether it is first or last and its `string-set` values, and a page made by hand keeps its values: rule:core-classes/pdf-header-is-a-page-function
--FILE--
<?nvs
// covers: Novis\Pdf\Document::header
// covers: Novis\Pdf\Page::constructor
// covers: Novis\Pdf\Page::isFirst
// covers: Novis\Pdf\Page::isLast
// covers: Novis\Pdf\Page::string
use Novis\Pdf\Document;
use Novis\Pdf\Page;

// A title page, then two chapters. Each `h2` starts a page and saves its text as `chapter`.
var $html = "<style>h2 { break-before: page; string-set: chapter content() }</style>"
    . "<h1>Shop handbook</h1><h2>Books</h2><p>A book</p><h2>Toys</h2><p>A ball</p>";

// The header prints what its page says about itself. Before the first `h2` the chapter is `null`.
var $header = fn(Page $page): Core\Html\Markup => {
    echo "page ", $page->number, " of ", $page->count, ": first ", $page->isFirst() ? "yes" : "no",
        ", last ", $page->isLast() ? "yes" : "no", ", chapter ", $page->string("chapter") ?? "null", "\n";
    return html`<p>Shop</p>`;
};
echo Document::fromHtml($html)->header($header)->render()->pageCount, " pages\n";

// A page made by hand keeps its values. `string` returns the first value with the name.
var $made = new Page(1, 1, "cover", [{name: "chapter", value: "Books"}, {name: "chapter", value: "Toys"}], []);
echo $made->number, " ", $made->count, " ", $made->name ?? "null", " ", $made->isFirst() && $made->isLast() ? "first and last" : "not both", "\n";
echo $made->string("chapter") ?? "null", " ", $made->string("section") ?? "null", "\n";

// A page past the count and page 0 are neither first nor last of a longer document.
var $past = new Page(5, 3, null, [], []);
var $zero = new Page(0, 3, null, [], []);
echo $past->isFirst() ? "first" : "not first", " ", $past->isLast() ? "last" : "not last", "\n";
echo $zero->isFirst() ? "first" : "not first", " ", $zero->isLast() ? "last" : "not last", "\n";
--EXPECT--
page 1 of 3: first yes, last no, chapter null
page 2 of 3: first no, last no, chapter Books
page 3 of 3: first no, last yes, chapter Toys
3 pages
1 1 cover first and last
Books null
not first not last
not first not last
