--TEST--
Each case of `Novis\Image`'s six enums is accepted by the step that takes it, and the cases that should give a different picture do: rule:core-classes/image-pipeline
--FILE--
<?nvs
// covers: Novis\Image\Fit, Novis\Image\Gravity, Novis\Image\Filter, Novis\Image\Axis, Novis\Image\Format, Novis\Image\Blend
use Novis\Image\Axis;
use Novis\Image\Blend;
use Novis\Image\Color;
use Novis\Image\Filter;
use Novis\Image\Fit;
use Novis\Image\Format;
use Novis\Image\Gravity;
use Novis\Image\Image;

class Look {
    public static function size(Image $image): string {
        var $raw = $image->raw();
        return "{$raw->width}x{$raw->height}";
    }

    public static function first(Image $image): string {
        array<mixed> $p = Core\Bytes::unpack(Core\Bytes::slice($image->raw()->pixels, 0, 4), "C4");
        return "{$p[0]} {$p[1]} {$p[2]}";
    }
}

Image $wide = Image::create(40, 20, Color::hex("#000"));
array<Fit> $fits = [Fit::Cover, Fit::Contain, Fit::Fill, Fit::Inside, Fit::Outside];
foreach ($fits as Fit $fit) {
    echo Look::size($wide->resize({ width: 10, height: 10, fit: $fit, upscale: true })), "\n";
}

// A row of red then blue pixels: which half a crop keeps depends on the gravity.
Image $row = Image::fromRaw({
    width: 4,
    height: 1,
    pixels: Core\Encoding::fromHex("ff0000ffff0000ff0000ffff0000ffff"),
});
array<Gravity> $sides = [Gravity::West, Gravity::East];
foreach ($sides as Gravity $gravity) {
    echo Look::first($row->resize({ width: 1, height: 1, fit: Fit::Cover, gravity: $gravity, filter: Filter::Nearest })), "\n";
}
array<Gravity> $others = [Gravity::Center, Gravity::North, Gravity::NorthEast, Gravity::SouthEast, Gravity::South, Gravity::SouthWest, Gravity::NorthWest];
array<string> $cropped = [];
foreach ($others as Gravity $g) {
    $cropped[] = Look::size($row->resize({ width: 2, height: 1, fit: Fit::Cover, gravity: $g }));
}
echo Core\Str::join($cropped, " "), "\n";

array<Filter> $filters = [Filter::Nearest, Filter::Bilinear, Filter::CatmullRom, Filter::Mitchell, Filter::Lanczos3];
array<string> $grown = [];
foreach ($filters as Filter $filter) {
    $grown[] = Look::size($row->resize({ width: 8, height: 2, fit: Fit::Fill, filter: $filter, upscale: true }));
}
echo Core\Str::join($grown, " "), "\n";

echo Look::first($row->flip(Axis::Horizontal)), "\n";
echo Look::first($row->flip(Axis::Vertical)), "\n";

array<Format> $formats = [Format::Jpeg, Format::Png, Format::Webp, Format::Gif, Format::Avif, Format::Jxl, Format::Svg, Format::Pdf];
foreach ($formats as Format $format) {
    echo Image::mime($format), " ", Image::extension($format), "\n";
}

array<Blend> $blends = [Blend::Normal, Blend::Multiply, Blend::Screen, Blend::Overlay, Blend::Darken, Blend::Lighten];
echo Core\Arr::count($blends), " ", $blends[1] == Blend::Multiply ? "same" : "differ", " ", $blends[0] == $blends[5] ? "same" : "differ", "\n";
--EXPECT--
10x10
10x10
10x10
10x5
20x10
255 0 0
0 0 255
2x1 2x1 2x1 2x1 2x1 2x1 2x1
8x2 8x2 8x2 8x2 8x2
0 0 255
255 0 0
image/jpeg jpg
image/png png
image/webp webp
image/gif gif
image/avif avif
image/jxl jxl
image/svg+xml svg
application/pdf pdf
6 same differ
