--TEST--
The steps of a `Novis\Image\Image` run in the order they are written, so a crop before a resize gives a different size than a crop after it — rule:core-classes/image-pipeline
--FILE--
<?nvs
use Novis\Image\Image;

// A PNG of 3 by 2 pixels with an alpha channel, written as hex.
bytes $png = Core\Encoding::fromHex(
    "89504e470d0a1a0a0000000d49484452000000030000000208060000009d74661a"
    . "0000000b49444154789c6360c00500001a0001bc3ce0410000000049454e44ae426082"
);
Image $image = Image::open($png);

// Resize to 6 by 4, then crop 2 by 2: the result is 2 by 2.
var $first = Image::info(
    $image->resize({width: 6, upscale: true})->crop({x: 0, y: 0, width: 2, height: 2})->encode()
);
echo $first->width, "x", $first->height, "\n";

// Crop 2 by 2, then resize to a width of 6: the result is 6 by 6.
var $second = Image::info(
    $image->crop({x: 0, y: 0, width: 2, height: 2})->resize({width: 6, upscale: true})->encode()
);
echo $second->width, "x", $second->height, "\n";

// Rotate by 90 degrees, then crop 2 by 3: this works only because the image is 2 by 3 after the rotation.
var $third = Image::info($image->rotate(90.0)->crop({x: 0, y: 0, width: 2, height: 3})->encode());
echo $third->width, "x", $third->height, "\n";
--EXPECT--
2x2
6x6
2x3
