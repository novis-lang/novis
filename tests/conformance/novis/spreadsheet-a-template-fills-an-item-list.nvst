--TEST--
`Template::fill` fills a template's placeholders, writes its item row once for each item with the row's formula moved to it, grows the sum below the items to cover them all, and `set` fills one cell by address: rule:core-classes/spreadsheet-template-fill
--FILE--
<?nvs
// covers: Novis\Spreadsheet\Template::open
// covers: Novis\Spreadsheet\Template::set
// covers: Novis\Spreadsheet\Template::fill
// covers: Novis\Spreadsheet\Export::save
// covers: Novis\Spreadsheet\Export::bytes
// covers: Novis\Spreadsheet\Engine::templateOpen
// covers: Novis\Spreadsheet\Engine::templateSet
// covers: Novis\Spreadsheet\Engine::templateFill
// covers: Novis\Spreadsheet\Engine::templateItems
// covers: Novis\Spreadsheet\Engine::templateFinish
use Novis\Spreadsheet\Formula;
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Row;
use Novis\Spreadsheet\Template;
use Novis\Spreadsheet\Workbook;

final class Show
{
    public static function value(mixed $value): string
    {
        if ($value == null) {
            return "null";
        }
        if ($value is tainted string) {
            return "string " . Core\Taint::assertTrusted($value, "the test prints what it wrote");
        }
        if ($value is int) {
            return "int " . ($value as string);
        }
        if ($value is float) {
            return "float " . ($value as string);
        }
        if ($value is Formula) {
            return "=" . Core\Taint::assertTrusted($value->text, "the test prints what it wrote");
        }
        return "another value";
    }

    public static function rows(bytes|Core\IO\File $file): void
    {
        foreach (Reader::open($file)->rows("Invoice", {formulas: true}) as Row $row) {
            echo "row ", $row->number;
            foreach ($row->values as tainted string $key => mixed $value) {
                echo " | ", Core\Taint::assertTrusted($key, "the test prints what it wrote"), ": ", Show::value($value);
            }
            echo "\n";
        }
    }

    public static function data(): array<mixed>
    {
        return [
            "number" => 42,
            "customer" => ["name" => "Shop"],
            "items" => [
                ["name" => "Pen", "qty" => 2, "price" => 1.5],
                ["name" => "Ink", "qty" => 1, "price" => 4.25],
                ["name" => "Pad", "qty" => 3, "price" => 2.75],
            ],
        ];
    }
}

// This workbook is the template. Row 3 is the item row, and row 4 adds up its total.
var $design = Workbook::createInMemory();
$design->sheet("Invoice")->addAll([
    ["Invoice {{number}}", "{{customer.name}}"],
    ["Item", "Qty", "Price", "Total"],
    ["{{items.name}}", "{{items.qty}}", "{{items.price}}", Formula::of("B3*C3")],
    ["Sum", null, null, Formula::of("SUM(D3:D3)")],
]);
bytes $template = $design->finish()->bytes ?? Core\Bytes::fill(0, 0);

// `fill` writes row 3 once for each of the three items. The sum moves to row 6 and covers D3:D5.
var $written = Template::open($template)->set("Invoice!D1", "Paid")->fill(Show::data())->save("invoice.xlsx");
echo "rows: ", $written->rows["Invoice"], "\n";
Core\IO\File $saved = Core\IO::open("invoice.xlsx", Core\IO::FileMode::Read);
Show::rows($saved);
$saved->close();

// Two fills of the same data give the same bytes.
var $once = Template::open($template)->fill(Show::data())->bytes();
var $twice = Template::open($template)->fill(Show::data())->bytes();
echo $once == $twice ? "the same bytes" : "different bytes", "\n";
--FILE nvs.toml--
[capabilities.fs]
read = ["."]
write = ["."]
--EXPECT--
rows: 6
row 1 | A: string Invoice 42 | B: string Shop | D: string Paid
row 2 | A: string Item | B: string Qty | C: string Price | D: string Total
row 3 | A: string Pen | B: int 2 | C: float 1.5 | D: =B3*C3
row 4 | A: string Ink | B: int 1 | C: float 4.25 | D: =B4*C4
row 5 | A: string Pad | B: int 3 | C: float 2.75 | D: =B5*C5
row 6 | A: string Sum | D: =SUM(D3:D5)
the same bytes
