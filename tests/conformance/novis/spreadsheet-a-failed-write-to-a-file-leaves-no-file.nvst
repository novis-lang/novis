--TEST--
`Workbook::createForFile` writes to a temporary file beside the path and renames it at `finish`; a `finish` that fails deletes the temporary file, leaves a file already at the path unchanged, and later calls throw: rule:core-classes/spreadsheet-writes-as-a-stream
--FILE--
<?nvs
// covers: Novis\Spreadsheet\Workbook::createForFile
// covers: Novis\Spreadsheet\Workbook::finish
use Novis\Spreadsheet\Workbook;

final class Folder {
    // This function prints the names in the folder `out`, sorted.
    public static function show(string $when): void {
        array<string> $names = Core\IO::list("out");
        $names = Core\Arr::sort($names);
        echo $when, ": [", Core\Str::join($names, ", "), "]\n";
    }
}

Core\IO::makeDir("out");
Core\IO::write("out/shop.xlsx", "old report");

// Before `finish`, the rows are in a temporary file. The old file is unchanged.
var $book = Workbook::createForFile("out/shop.xlsx");
$book->sheet("Orders")->add(["Tea", 2]);
echo "while writing: ", Core\IO::readText("out/shop.xlsx"), ", ", Core\Arr::count(Core\IO::list("out")), " files\n";

// The name points at a sheet the workbook does not have, so `finish` throws.
$book->define("Totals", "'Missing'!A1:A2");
try {
    $book->finish();
} catch (LogicError $e) {
    echo "finish threw\n";
}
Folder::show("after the failed finish");
echo "out/shop.xlsx: ", Core\IO::readText("out/shop.xlsx"), "\n";

// Every later call throws.
try {
    $book->sheet("More");
} catch (LogicError $e) {
    echo $e->message, "\n";
}

// A workbook that finishes replaces the old file, and no other file is left.
var $good = Workbook::createForFile("out/shop.xlsx");
$good->sheet("Orders")->add(["Tea", 2]);
$good->finish();
Folder::show("after a good finish");
echo "a new report: ", Core\IO::size("out/shop.xlsx") > 10 ? "yes" : "no", "\n";
--FILE nvs.toml--
[capabilities.fs]
read = ["."]
write = ["."]
--EXPECT--
while writing: old report, 2 files
finish threw
after the failed finish: [shop.xlsx]
out/shop.xlsx: old report
The workbook could not be written to its file, and its temporary file is deleted. Create a new workbook to try again.
after a good finish: [shop.xlsx]
a new report: yes
