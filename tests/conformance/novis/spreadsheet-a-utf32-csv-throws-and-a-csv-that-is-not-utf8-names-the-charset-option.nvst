--TEST--
`Reader::open` throws a `ParseError` for a CSV in UTF-32, little-endian or big-endian, and for a CSV that is not UTF-8, from bytes and from a file, naming the `charset` option; with that option the same bytes read: rule:core-classes/spreadsheet-reads-as-a-stream
--FILE--
<?nvs
use Novis\Spreadsheet\Reader;

// UTF-32 with a byte order mark, little-endian and big-endian.
bytes $little = Core\Encoding::fromHex("fffe00004900000074000000");
bytes $big = Core\Encoding::fromHex("0000feff0000004900000074");
array<bytes> $marked = [$little, $big];
foreach ($marked as bytes $utf32) {
    try {
        Reader::open($utf32);
        echo "not reached\n";
    } catch (ParseError $e) {
        echo $e->message, "\n";
    }
}

// Windows-1252 bytes with no `charset` option. `ü` is the one byte 0xFC.
bytes $latin = Core\Encoding::encodeText("Name;City\nJürgen;Köln\n", Core\Charset::Windows1252);
try {
    Reader::open($latin, { csv: { separator: ';' } });
    echo "not reached\n";
} catch (ParseError $e) {
    echo $e->message, "\n";
}

// The same bytes in a file.
Core\IO\File $out = Core\IO::open("shop.csv", Core\IO::FileMode::Write);
$out->write($latin);
$out->close();
Core\IO\File $file = Core\IO::open("shop.csv", Core\IO::FileMode::Read);
try {
    Reader::open($file, { csv: { separator: ';' } });
    echo "not reached\n";
} catch (ParseError $e) {
    echo $e->message, "\n";
}
$file->close();

// A character that is not UTF-8 after the first 4 KiB. `open` checks the
// first 4 KiB only, so reading the rows finds it.
bytes $late = Core\Bytes::join([Core\Encoding::encodeText(Core\Str::repeat("Bolt,1\n", 700), Core\Charset::Utf8), $latin]);
try {
    uint $count = 0;
    foreach (Reader::open($late)->rows(0) as var $row) {
        $count = $count + 1;
    }
    echo "not reached\n";
} catch (ParseError $e) {
    echo $e->message, "\n";
}

// With the `charset` option, the bytes read.
foreach (Reader::open($latin, { csv: { separator: ';', charset: Core\Charset::Windows1252 } })->rows(0, { header: true }) as var $row) {
    echo $row->values['Name'] as string, " in ", $row->values['City'] as string, "\n";
}
--FILE nvs.toml--
[capabilities.fs]
read = ["."]
write = ["."]
--EXPECT--
The CSV file is in UTF-32. UTF-32 is not supported. Save the file as UTF-8 or UTF-16.
The CSV file is in UTF-32. UTF-32 is not supported. Save the file as UTF-8 or UTF-16.
The CSV file is not UTF-8 text. Set the `csv` option `charset` to its charset, such as `Core\Charset::Windows1252`.
The CSV file is not UTF-8 text. Set the `csv` option `charset` to its charset, such as `Core\Charset::Windows1252`.
Core\Csv::rows: line 702 of the source has a field that is not valid UTF-8
Jürgen in Köln
