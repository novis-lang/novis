--TEST--
`Reader::open` reads CSV bytes and an open CSV file through `Core\Csv`, as one sheet named `Sheet1`, with the options and the row shape of an xlsx: every header key in every row with `null` for an empty or missing field, a surplus field under its column letter, a duplicate header numbered and an empty one its column letter, empty rows skipped unless kept, `from`, `limit` and `columns` choosing the range, and every value a `string`: rule:core-classes/spreadsheet-reads-as-a-stream
--FILE--
<?nvs
// covers: Novis\Spreadsheet\Reader::open
// covers: Novis\Spreadsheet\Reader::sheets
// covers: Novis\Spreadsheet\Reader::rows
// covers: Novis\Spreadsheet\Reader::macros
// covers: Novis\Spreadsheet\Reader::merged
// covers: Novis\Spreadsheet\Reader::properties
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Row;
use Novis\Spreadsheet\Workbook;

final class Show
{
public static function value(mixed $value): string
{
    if ($value == null) {
        return "null";
    }
    if ($value is tainted string) {
        return "string " . Core\Taint::assertTrusted($value, "the test prints what it wrote");
    }
    return "another value";
}

public static function rows(Iterator<Row> $rows): void
{
    foreach ($rows as Row $row) {
        echo "row ", $row->number;
        foreach ($row->values as tainted string $key => mixed $value) {
            echo " | ", Core\Taint::assertTrusted($key, "the test prints what it wrote"), ": ", Show::value($value);
        }
        echo "\n";
    }
}
}

// Row 3 is empty. `Gizmo` has no count, and `Bolt` has one field more than the header.
string $text = "Item,Price,Count\nWidget,2.5,3\n,,\nGadget,,4\nGizmo,1.25\nBolt,0.5,9,extra\n";
var $reader = Reader::open($text as bytes);
foreach ($reader->sheets() as var $info) {
    echo Core\Taint::assertTrusted($info->name, "the test prints what it read"), " is at position ", $info->position, " with ", $info->rows, " rows and ", $info->columns, " columns\n";
}

// A CSV file has no macros, no merged cells and no properties.
echo "macros: ", Core\Arr::count($reader->macros()), ", merged: ", Core\Arr::count($reader->merged(0)), "\n";
echo "title: ", $reader->properties()->title == null ? "null" : "set", "\n";

// The key of each value is its header. Every value is a `string`, and an empty field is `null`.
Show::rows($reader->rows("Sheet1", {header: true}));

// `header: 1` says the header is row 1. `from`, `limit` and `columns` choose the rows and the columns.
Show::rows($reader->rows(0, {header: 1, from: 4, limit: 1, columns: ["A", "C"]}));

// Without a header, the keys are the column letters. `emptyRows: 'keep'` also gives the empty row 3.
Show::rows($reader->rows("Sheet1", {from: 2, limit: 2, emptyRows: "keep"}));

// The same rows written to an xlsx read back with the same keys.
var $book = Workbook::createInMemory();
$book->sheet("Sheet1", {header: false})->addAll([["Item", "Price", "Count"], ["Widget", "2.5", "3"], [null], ["Gadget", null, "4"], ["Gizmo", "1.25"], ["Bolt", "0.5", "9", "extra"]]);
Show::rows(Reader::open($book->finish()->bytes ?? Core\Bytes::fill(0, 0))->rows("Sheet1", {header: true}));

// A header that is used twice gets ` (2)`. An empty header gets its column letter.
// The byte order mark that Excel writes at the start of a CSV file is not part of the first header.
Core\IO::write("names.csv", "\u{FEFF}Name,Name,,City\nAda,Lovelace,x,London\n");
Core\IO\File $file = Core\IO::open("names.csv", Core\IO::FileMode::Read);
Show::rows(Reader::open($file)->rows("Sheet1", {header: true}));
echo "the file is at byte ", $file->tell(), "\n";
$file->close();

// A sheet that a CSV file does not have throws an error.
try {
    $reader->rows("Orders");
    echo "not reached\n";
} catch (LogicError $e) {
    echo $e->message, "\n";
}
--FILE nvs.toml--
[capabilities.fs]
read = ["."]
write = ["."]
--EXPECT--
Sheet1 is at position 0 with 6 rows and 4 columns
macros: 0, merged: 0
title: null
row 2 | Item: string Widget | Price: string 2.5 | Count: string 3
row 4 | Item: string Gadget | Price: null | Count: string 4
row 5 | Item: string Gizmo | Price: string 1.25 | Count: null
row 6 | Item: string Bolt | Price: string 0.5 | Count: string 9 | D: string extra
row 4 | Item: string Gadget | Count: string 4
row 2 | A: string Widget | B: string 2.5 | C: string 3
row 3
row 2 | Item: string Widget | Price: string 2.5 | Count: string 3
row 4 | Item: string Gadget | Price: null | Count: string 4
row 5 | Item: string Gizmo | Price: string 1.25 | Count: null
row 6 | Item: string Bolt | Price: string 0.5 | Count: string 9 | D: string extra
row 2 | Name: string Ada | Name (2): string Lovelace | C: string x | City: string London
the file is at byte 0
A CSV file has one sheet, `Sheet1` at position 0. It has no sheet `Orders`.
