--TEST--
A CSV file has one sheet, so a second `addSheet` throws naming both sheets, the first sheet stays open, and a format other than `xlsx`, `ods` or `csv` throws naming it: rule:core-classes/spreadsheet-has-no-io
--FILE--
<?nvs
// covers: Novis\Spreadsheet\Workbook::addSheet
// covers: Novis\Spreadsheet\Workbook::createInMemory
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory({format: "csv"});
var $orders = $book->addSheet("Orders", {header: false});
$orders->addRow(["Widget", 3]);
try {
    $book->addSheet("Totals");
    echo "not reached\n";
} catch (LogicError $e) {
    echo $e->message, "\n";
}

// The first sheet is still open after the error.
$orders->addRow(["Gadget", 4]);
var $written = $book->finish();
echo $written->rows["Orders"], " rows\n";
bytes $file = $written->bytes ?? Core\Bytes::fill(0, 0);
// The CSV file starts with a byte order mark and ends each line with CR and LF. This prints it without both.
echo Core\Str::replaceAll($file as string, ["\u{FEFF}" => "", "\r\n" => "\n", "\r" => ""]);

try {
    Workbook::createInMemory({format: "xls"});
    echo "not reached\n";
} catch (LogicError $e) {
    echo $e->message, "\n";
}
--EXPECT--
A CSV file has one sheet, so the sheet `Totals` cannot be added. The file already has the sheet `Orders`.
2 rows
Widget,3
Gadget,4
The format `xls` is not supported. Use `xlsx`, `ods` or `csv`.
