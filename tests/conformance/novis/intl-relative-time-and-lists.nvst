--TEST--
A relative time is in the past for a negative count and in the future for a positive one, and a list is joined with the locale's words: rule:core-classes/intl-batch-shape rule:core-classes/intl-roster
--FILE--
<?nvs
// covers: Novis\Intl\RelativeTime::Unit, Novis\Intl\Width, Novis\Intl\RelativeTime::Numeric, Novis\Intl\ListFormat::Type
use Novis\Intl\ListFormat;
use Novis\Intl\RelativeTime;
use Novis\Intl\Width;

// A negative count is in the past, and a positive count is in the future.
var $items = [
    {count: -3, unit: RelativeTime::Unit::Day},
    {count: 2, unit: RelativeTime::Unit::Hour},
    {count: -1, unit: RelativeTime::Unit::Day},
    {count: 1, unit: RelativeTime::Unit::Year},
];
echo Core\Str::join(RelativeTime::format($items, "en"), " | "), "\n";

// `RelativeTime::Numeric::Auto` uses a word such as "yesterday" where the language has one.
echo Core\Str::join(RelativeTime::format($items, "en", {numeric: RelativeTime::Numeric::Auto}), " | "), "\n";
echo Core\Str::join(RelativeTime::format($items, "de", {numeric: RelativeTime::Numeric::Auto}), " | "), "\n";
echo Core\Str::join(RelativeTime::format($items, "en", {width: Width::Short}), " | "), "\n";

// Each list is joined with the words of the locale.
var $lists = [["Shop", "Blog", "Wiki"], ["Shop", "Blog"], ["Shop"]];
echo Core\Str::join(ListFormat::join($lists, "en"), " | "), "\n";
echo Core\Str::join(ListFormat::join($lists, "de"), " | "), "\n";
echo Core\Str::join(ListFormat::join($lists, "fr", {type: ListFormat::Type::Or}), " | "), "\n";

// An empty list gives an empty string.
array<array<string>> $empty = [[]];
echo "[", Core\Str::join(ListFormat::join($empty, "en"), ""), "]\n";
--EXPECT--
3 days ago | in 2 hours | 1 day ago | in 1 year
3 days ago | in 2 hours | yesterday | next year
vor 3 Tagen | in 2 Stunden | gestern | nächstes Jahr
3 days ago | in 2 hr. | 1 day ago | in 1 yr.
Shop, Blog, and Wiki | Shop and Blog | Shop
Shop, Blog und Wiki | Shop und Blog | Shop
Shop, Blog ou Wiki | Shop ou Blog | Shop
[]
