--TEST--
A Spreadsheet CSV export starts with one UTF-8 byte order mark, however many batches it writes, ends every record with CRLF, keeps a line feed inside a field, and reads back as the same rows; a UTF-16 export has one mark and a Latin-1 export none: rule:core-classes/spreadsheet-evaluation-and-roster
--FILE--
<?nvs
// covers: Novis\Spreadsheet\Workbook::createInMemory
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

final class Shop {
    // This generator gives 2,500 rows, more than one batch.
    public static function orders(): Iterator<array<mixed>> {
        int $at = 0;
        while ($at < 2500) {
            yield ["Item" => "Tea", "Note" => "line one\nline two", "Qty" => $at];
            $at = $at + 1;
        }
    }
}

var $book = Workbook::createInMemory({ format: 'csv' });
$book->sheet("Orders")->addAll(Shop::orders());
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);
string $text = $file as string;

echo "starts with: ", Core\Encoding::toHex(Core\Bytes::slice($file, 0, 3)), "\n";
echo "marks: ", Core\Arr::count(Core\Str::split($text, "\u{FEFF}")) - 1, "\n";
echo "CRLF: ", Core\Arr::count(Core\Str::split($text, "\r\n")) - 1, "\n";
echo "first record: ", Core\Str::replaceAll(Core\Str::slice($text, 1, 18), ["\r" => "<CR>", "\n" => "<LF>"]), "\n";

// The reader skips the mark and reads the line feed inside the field.
int $rows = 0;
foreach (Reader::open($file)->rows(0, { header: true }) as var $row) {
    if ($rows == 0) {
        echo "read: ", Core\Str::replaceAll($row->values['Note'] as string, ["\n" => "<LF>"]), "\n";
    }
    $rows = $rows + 1;
}
echo $rows, " rows\n";

// UTF-16 has one byte order mark. Latin-1 has none.
array<Core\Charset> $charsets = [Core\Charset::Utf16Le, Core\Charset::Latin1];
foreach ($charsets as Core\Charset $charset) {
    var $other = Workbook::createInMemory({ format: 'csv', csv: { encoding: $charset } });
    $other->sheet("Orders")->add(["Tea", 2]);
    bytes $written = $other->finish()->bytes ?? Core\Bytes::fill(0, 0);
    echo "starts with: ", Core\Encoding::toHex(Core\Bytes::slice($written, 0, 4)), "\n";
}
--EXPECT--
starts with: efbbbf
marks: 1
CRLF: 2501
first record: Item,Note,Qty<CR><LF>Tea,
read: line one<LF>line two
2500 rows
starts with: fffe5400
starts with: 5465612c
