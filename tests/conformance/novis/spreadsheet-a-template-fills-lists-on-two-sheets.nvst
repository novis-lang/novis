--TEST--
`Template::fill` repeats a list on each of two sheets, and every formula that names a moved row, on its own sheet or on the other one, moves with it: rule:core-classes/spreadsheet-template-fill
--FILE--
<?nvs
// covers: Novis\Spreadsheet\Template::fill
use Novis\Spreadsheet\Formula;
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Row;
use Novis\Spreadsheet\Template;
use Novis\Spreadsheet\Workbook;

final class Show
{
    public static function value(mixed $value): string
    {
        if ($value == null) {
            return "null";
        }
        if ($value is tainted string) {
            return Core\Taint::assertTrusted($value, "the test prints what it wrote");
        }
        if ($value is int) {
            return $value as string;
        }
        if ($value is Formula) {
            return "=" . Core\Taint::assertTrusted($value->text, "the test prints what it wrote");
        }
        return "another value";
    }

    public static function sheet(bytes $file, string $name): void
    {
        echo $name, "\n";
        foreach (Reader::open($file)->rows($name, {formulas: true}) as Row $row) {
            echo "row ", $row->number;
            foreach ($row->values as tainted string $key => mixed $value) {
                echo " | ", Core\Taint::assertTrusted($key, "the test prints what it wrote"), ": ", Show::value($value);
            }
            echo "\n";
        }
    }
}

// Each sheet has one item row. The sum on `Summary` also adds the sum on `Invoice`.
var $design = Workbook::createInMemory();
$design->sheet("Invoice")->addAll([
    ["Item", "Qty"],
    ["{{items.name}}", "{{items.qty}}"],
    ["Sum", Formula::of("SUM(B2:B2)")],
]);
$design->sheet("Summary")->addAll([
    ["Line", "Amount"],
    ["{{lines.label}}", "{{lines.amount}}"],
    ["Sum", Formula::of("SUM(B2:B2)+Invoice!B3")],
]);
bytes $template = $design->finish()->bytes ?? Core\Bytes::fill(0, 0);

array<mixed> $data = [
    "lines" => [
        ["label" => "Rent", "amount" => 500],
        ["label" => "Power", "amount" => 80],
    ],
    "items" => [
        ["name" => "Pen", "qty" => 2],
        ["name" => "Ink", "qty" => 1],
        ["name" => "Pad", "qty" => 3],
    ],
];

// `Invoice` gets three item rows and `Summary` two line rows. The sum on `Summary` names `Invoice!B5`.
bytes $filled = Template::open($template)->fill($data)->bytes();
Show::sheet($filled, "Invoice");
Show::sheet($filled, "Summary");
--EXPECT--
Invoice
row 1 | A: Item | B: Qty
row 2 | A: Pen | B: 2
row 3 | A: Ink | B: 1
row 4 | A: Pad | B: 3
row 5 | A: Sum | B: =SUM(B2:B4)
Summary
row 1 | A: Line | B: Amount
row 2 | A: Rent | B: 500
row 3 | A: Power | B: 80
row 4 | A: Sum | B: =SUM(B2:B3)+Invoice!B5
