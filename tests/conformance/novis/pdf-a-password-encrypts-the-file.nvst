--TEST--
A password encrypts the file with AES-256 revision 6, equal input stays byte-equal, a different password gives different bytes, the reader cannot open the encrypted file, and a password beside a PDF/A standard throws `LogicError`: rule:core-classes/pdf-standards-and-passwords
--FILE--
<?nvs
// covers: Novis\Pdf\Document::password
use Novis\Pdf\Document;
use Novis\Pdf\Reader;

var $statement = Document::fromHtml("<h1>Statement</h1><p>Balance: 10.00 EUR</p>");
bytes $plain = $statement->render()->bytes;
bytes $locked = $statement->password("ada-7731")->render()->bytes;

// The encrypted file names AES-256, revision 6, in its encryption dictionary. The plain file has none.
echo Core\Bytes::startsWith($locked, "%PDF-" as bytes) ? "a PDF file" : "not a PDF file", "\n";
echo Core\Bytes::contains($plain, "/Encrypt" as bytes) ? "plain is encrypted" : "plain is not encrypted", "\n";
echo Core\Bytes::contains($locked, "/Encrypt" as bytes) ? "locked is encrypted" : "locked is not encrypted", "\n";
echo Core\Bytes::contains($locked, "/R 6" as bytes) ? "revision 6" : "another revision", "\n";
echo Core\Bytes::contains($locked, "/AESV3" as bytes) ? "AES-256" : "another cipher", "\n";

// The same document and password give the same bytes. Another password gives other bytes.
echo $statement->password("ada-7731")->render()->bytes == $locked ? "same bytes" : "different bytes", "\n";
echo $statement->password("grace-1906")->render()->bytes == $locked ? "same bytes" : "different bytes", "\n";

// The reader opens only files without encryption.
try {
    Reader::open($locked);
} catch (ParseError $encrypted) {
    echo "ParseError: ", $encrypted->message, "\n";
}

// PDF/A forbids encryption, so a password beside a PDF/A standard throws.
try {
    $statement->password("ada-7731")
        ->standard(Document::Standard::PdfA2b)
        ->created(Core\Time::fromIso("2026-01-01T00:00:00Z"))
        ->render();
} catch (LogicError $archive) {
    echo "LogicError: ", $archive->message, "\n";
}
--EXPECT--
a PDF file
plain is not encrypted
locked is encrypted
revision 6
AES-256
same bytes
different bytes
ParseError: the PDF is encrypted. Only a PDF without encryption can be read, merged or placed
LogicError: a PDF/A document cannot have a password
