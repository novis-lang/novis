--TEST--
A `Workbook` writes CSV through `Core\Csv::format` when its name ends in `.csv` or `format: 'csv'` is given, from the same calls as an xlsx: the header row from the keys, each value by the write table as text, a formula as its `=` text, a string Excel would read as a formula with a `'` first, and the styles, widths and sheet-end parts left out; `finish` counts the rows and the bytes, and a download sends the same text: rule:core-classes/spreadsheet-has-no-io
--FILE--
<?nvs
// covers: Novis\Spreadsheet\Workbook::createInMemory
// covers: Novis\Spreadsheet\Workbook::createForFile
// covers: Novis\Spreadsheet\Workbook::createForDownload
// covers: Novis\Spreadsheet\Workbook::fromRows
// covers: Novis\Spreadsheet\Workbook::finish
use Novis\Spreadsheet\Cell;
use Novis\Spreadsheet\Formula;
use Novis\Spreadsheet\Style;
use Novis\Spreadsheet\Workbook;

// `format: 'csv'` writes CSV. A style, a width and a merge are ignored.
var $book = Workbook::createInMemory({format: "csv"});
var $sheet = $book->sheet("Orders", {columns: ["item" => {header: "Item", width: 30}]});
$sheet->add(["item" => "Widget, large", "count" => 3, "price" => 2.5, "paid" => true]);
$sheet->add(["item" => Cell::of("Gadget", Style::of({bold: true})), "count" => null, "price" => 10.0, "paid" => false], {height: 30.0});
$sheet->add(["item" => "=1+1", "count" => -4, "price" => Formula::of("SUM(C2:C3)"), "paid" => null]);
$sheet->merge("A1:B1");
var $written = $book->finish();
echo $written->rows["Orders"], " rows\n";
bytes $file = $written->bytes ?? Core\Bytes::fill(0, 0);
echo $written->size == Core\Bytes::length($file) ? "the size is the length of the file" : "the size is wrong", "\n";
echo $file as string;

// A date, a time, a duration and an `Instant` in the workbook's `zone` are written as text.
var $times = Workbook::createInMemory({format: "csv", zone: "Europe/Berlin"});
$times->sheet("Times", {header: false})->add([Core\Time\Date::at(2024, 1, 15), Core\Time\TimeOfDay::at(9, 30), Core\Time\Duration::minutes(150), Core\Time::at(2024, 1, 15, Core\Time\Zone::UTC, {hour: 9, minute: 30})->toInstant()]);
bytes $timesFile = $times->finish()->bytes ?? Core\Bytes::fill(0, 0);
echo $timesFile as string;

// A name that ends in `.csv` writes CSV, and `fromRows` writes it the same way.
Workbook::fromRows([["name" => "Ada", "city" => "London"]])->save("people.csv");
echo Core\IO::read("people.csv");

// A download of a CSV file sends the same text.
var $sent = Core\Out::capture(fn (): void => {
    Workbook::fromRows([["name" => "Ada", "city" => "London"]])->download("people.csv");
});
echo $sent as string;
--FILE nvs.toml--
[capabilities.fs]
read = ["."]
write = ["."]
--EXPECT--
3 rows
the size is the length of the file
Item,count,price,paid
"Widget, large",3,2.5,TRUE
Gadget,,10,FALSE
'=1+1,-4,=SUM(C2:C3),
2024-01-15,09:30:00,2:30:00,2024-01-15 10:30:00
name,city
Ada,London
name,city
Ada,London
