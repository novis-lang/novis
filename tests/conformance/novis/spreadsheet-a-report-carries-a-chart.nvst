--TEST--
A streamed report carries a column chart combined with a line, its ranges from `column` cover every row the sheet ends with, and a combination outside column, line and area throws: rule:core-classes/spreadsheet-sheet-end-parts
--FILE--
<?nvs
// covers: Novis\Spreadsheet\Sheet::chart
// covers: Novis\Spreadsheet\Chart::column
// covers: Novis\Spreadsheet\Chart::line
// covers: Novis\Spreadsheet\Chart::pie
// covers: Novis\Spreadsheet\Chart::series
// covers: Novis\Spreadsheet\Chart::combine
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sales = $book->sheet("Sales");
$sales->add(["month" => "Jan", "sales" => 120, "costs" => 80]);
$sales->add(["month" => "Feb", "sales" => 150, "costs" => 90]);

// The chart is added after two rows, and its ranges still grow to the last row.
var $chart = Chart::column({title: "Sales by month", legend: "bottom"})
    ->series($sales->column("sales"), {categories: $sales->column("month"), name: "Sales", color: "#1F77B4"})
    ->combine(Chart::line()->series($sales->column("costs"), {categories: $sales->column("month"), name: "Costs"}));
$sales->chart("E2", $chart, {width: 600});
$sales->add(["month" => "Mar", "sales" => 170, "costs" => 95]);
$sales->add(["month" => "Apr", "sales" => 160, "costs" => 99]);

try {
    $sales->chart("E20", Chart::pie()->series("B2:B5")->combine(Chart::line()->series("C2:C5")));
    echo "not reached\n";
} catch (LogicError $e) {
    echo $e->message, "\n";
}

try {
    Chart::bar({legend: "middle"});
    echo "not reached\n";
} catch (LogicError $e) {
    echo $e->message, "\n";
}

var $written = $book->finish();
bytes $file = $written->bytes ?? Core\Bytes::fill(0, 0);
var $part = Core\Zip::read($file, "xl/charts/chart1.xml") as string;
var $drawing = Core\Zip::read($file, "xl/drawings/drawing1.xml") as string;
echo Core\Str::contains($part, "<c:f>Sales!\$B\$2:\$B\$5</c:f>") ? "sales cover rows 2 to 5" : "sales do not cover every row", "\n";
echo Core\Str::contains($part, "<c:f>Sales!\$C\$2:\$C\$5</c:f>") ? "costs cover rows 2 to 5" : "costs do not cover every row", "\n";
echo Core\Str::contains($part, "<c:lineChart>") ? "a line is combined" : "no line", "\n";
echo Core\Str::contains($part, "<a:t>Sales by month</a:t>") ? "the title is written" : "no title", "\n";
echo Core\Str::contains($drawing, "<xdr:to><xdr:col>13</xdr:col><xdr:colOff>228600</xdr:colOff><xdr:row>15</xdr:row><xdr:rowOff>76200</xdr:rowOff></xdr:to>") ? "the chart is 600 by 288 pixels" : "the chart has another size", "\n";
echo "Sales: ", $written->rows["Sales"], "\n";
--EXPECT--
The chart at `E20` combines pie and line. A chart combines two different types of column, line and area.
The chart's `legend` is `'right'`, `'top'`, `'bottom'`, `'left'` or `'hidden'`. It has `'middle'`.
sales cover rows 2 to 5
costs cover rows 2 to 5
a line is combined
the title is written
the chart is 600 by 288 pixels
Sales: 4
