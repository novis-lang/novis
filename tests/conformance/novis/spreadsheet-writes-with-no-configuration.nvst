--TEST--
`Workbook::createInMemory` writes a sheet of typed rows from a binary with no `nvs.toml` and no grant, `finish` returns the row count and the size, the bytes are an xlsx archive whose sheet holds each cell by the write table, and in a request a download sends an xlsx file with its media type, its file name and a body that is not text: rule:core-classes/spreadsheet-writes-as-a-stream
--FILE--
<?nvs
// covers: Novis\Spreadsheet\Workbook::createInMemory
// covers: Novis\Spreadsheet\Workbook::createForDownload
// covers: Novis\Spreadsheet\Workbook::sheet
// covers: Novis\Spreadsheet\Workbook::finish
// covers: Novis\Spreadsheet\Written::constructor
// covers: Novis\Spreadsheet\Sheet::add
// covers: Novis\Spreadsheet\Sheet::addAll
use Novis\Spreadsheet\Workbook;

// In a request, the program sends one sheet as a download.
if (Core\Env::context() == Core\Env::Context::Request) {
    var $download = Workbook::createForDownload("Orders März.xlsx");
    $download->sheet("Orders")->add(["Widget", 3]);
    $download->finish();
    return;
}

// Each value is one cell. A `string` is text, a number is a number, and a date is a date.
var $book = Workbook::createInMemory({properties: {title: "Shop orders"}});
var $sheet = $book->sheet("Orders");
$sheet->add(["Widget", 3, 2.5, true, null, Core\Time\Date::at(2024, 1, 15)]);
$sheet->addAll([["Gadget", 4], ["Gizmo", 5]]);
$sheet->add(["Total"], {height: 30.0});
var $written = $book->finish();
echo $written->rows["Orders"], " rows\n";

// The size is the length of the file in bytes.
bytes $file = $written->bytes ?? Core\Bytes::fill(0, 0);
echo $written->size == Core\Bytes::length($file) ? "the size is the length of the file" : "the size is wrong", "\n";

// An xlsx file is a zip archive. Its first sheet is `xl/worksheets/sheet1.xml`.
var $xml = Core\Zip::read($file, "xl/worksheets/sheet1.xml") as string;
array<string> $cells = [
    "<c r=\"A1\" t=\"inlineStr\"><is><t>Widget</t></is></c>",
    "<c r=\"B1\"><v>3</v></c>",
    "<c r=\"C1\"><v>2.5</v></c>",
    "<c r=\"D1\" t=\"b\"><v>1</v></c>",
    "<v>45306</v>",
    "<row r=\"4\" ht=\"30\" customHeight=\"1\">",
];
foreach ($cells as string $cell) {
    echo Core\Str::contains($xml, $cell) ? "has " : "lacks ", $cell, "\n";
}
// `null` is an empty cell, so the row has no cell `E1`.
echo Core\Str::contains($xml, "r=\"E1\"") ? "has E1" : "no E1", "\n";

// A download sends an xlsx file with its media type and its file name.
// The file is not text, so `body()` throws an error. `bytes()` returns the
// file, and its sheet has the row the request wrote.
var $sent = Core\Test::request(Core\Http\Method::Get, "/orders");
echo $sent->status(), " ", $sent->header("Content-Type") ?? "none", "\n";
echo $sent->header("Content-Disposition") ?? "none", "\n";
try {
    $sent->body();
    echo "the body is text\n";
} catch (RuntimeError $notText) {
    echo "the body is a workbook\n";
}
var $sentXml = Core\Zip::read($sent->bytes(), "xl/worksheets/sheet1.xml") as string;
echo Core\Str::contains($sentXml, "<c r=\"B1\"><v>3</v></c>") ? "the sheet has the row\n" : "the sheet lacks the row\n";
--EXPECT--
4 rows
the size is the length of the file
has <c r="A1" t="inlineStr"><is><t>Widget</t></is></c>
has <c r="B1"><v>3</v></c>
has <c r="C1"><v>2.5</v></c>
has <c r="D1" t="b"><v>1</v></c>
has <v>45306</v>
has <row r="4" ht="30" customHeight="1">
no E1
200 application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
attachment; filename="Orders M_rz.xlsx"; filename*=UTF-8''Orders%20M%C3%A4rz.xlsx
the body is a workbook
the sheet has the row
