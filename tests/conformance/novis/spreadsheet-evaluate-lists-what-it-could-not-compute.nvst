--TEST--
`Reader::evaluate` lists a function outside its set, a dynamic reference, a circular reference and text it cannot read, each cell keeps the result saved in the file, and a CSV returns no list: rule:core-classes/spreadsheet-evaluation-and-roster
--FILE--
<?nvs
// covers: Novis\Spreadsheet\Reader::evaluate
use Novis\Spreadsheet\Formula;
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet("Data");
$sheet->add(["a" => 1, "b" => Formula::of("=TODAY()", {cached: 45000})]);
$sheet->add(["a" => 2, "b" => Formula::of("=INDIRECT(\"A2\")", {cached: 7})]);
$sheet->add(["a" => Formula::of("=B4+1", {cached: 3}), "b" => Formula::of("=A4+1", {cached: 4})]);
$sheet->add(["a" => 5, "b" => Formula::of("=SUM(A2:A3", {cached: 8})]);
$sheet->add(["a" => 6, "b" => Formula::of("=A2*10")]);
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

var $reader = Reader::open($file);
foreach ($reader->evaluate() as var $missed) {
    echo $missed['cell'], " ", $missed['kind'], " ", $missed['text'], "\n";
}
foreach ($reader->rows("Data", { header: true }) as var $row) {
    echo $row->number, ": ", $row->values['a'], " ", $row->values['b'], "\n";
}

echo Core\Arr::count(Reader::open("a,b\n1,=1+1\n" as bytes)->evaluate()), " for a CSV\n";
--EXPECT--
Data!A4 circular =B4+1
Data!B2 function TODAY
Data!B3 function INDIRECT
Data!B4 circular =A4+1
Data!B5 token =SUM(A2:A3
2: 1 45000
3: 2 7
4: 3 4
5: 5 8
6: 6 10
0 for a CSV
