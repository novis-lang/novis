--TEST--
`Core\Uuid::parse` in a `try` whose `catch` arm reads the error gives the UUID, or `null` after it counts the error — `rule:expressions/a-cheaper-form-with-the-same-result-is-compiled-or-named`
--FILE--
<?nvs
final class Ids {
    public static int $errors = 0;

    public static function read(string $s): string {
        ?Core\Uuid $v = null;
        try {
            $v = Core\Uuid::parse($s);
        } catch (RuntimeError $e) {
            // The arm counts the error when it has a message, then sets `$v` to `null`.
            if ($e->message != "") {
                Ids::$errors = Ids::$errors + 1;
            }
            $v = null;
        }
        return $v?->toString() ?? "null";
    }
}

array<string> $inputs = ["0123ABCD-0000-4000-8000-00000000000F", "nope", ""];
foreach ($inputs as string $s) {
    echo Ids::read($s), "\n";
}
// Two texts are not UUIDs, so this prints `2`.
echo Ids::$errors, "\n";
--EXPECT--
0123abcd-0000-4000-8000-00000000000f
null
null
2
