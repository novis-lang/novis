--TEST--
A conversion with `as int` in a `try` whose `catch` sets the variable to `-1` gives the number or `-1` — `rule:expressions/a-cheaper-form-with-the-same-result-is-compiled-or-named`
--FILE--
<?nvs
final class Convert {
    public static function toInt(mixed $x): ?int {
        ?int $v = 0;
        try {
            $v = $x as int;
        } catch (RuntimeError) {
            $v = -1;
        }
        return $v;
    }
}

array<mixed> $inputs = ["42", 5.0, "abc", 3.9, null];
foreach ($inputs as mixed $x) {
    echo Core\Json::encode(Convert::toInt($x)), "\n";
}
--EXPECT--
42
5
-1
-1
-1
