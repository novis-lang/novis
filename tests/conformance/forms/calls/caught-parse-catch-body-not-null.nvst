--TEST--
`Core\Uuid::parse` in a `try` whose `catch` sets the variable to a default UUID gives the UUID or the default — `rule:expressions/a-cheaper-form-with-the-same-result-is-compiled-or-named`
--FILE--
<?nvs
final class Ids {
    public static function read(string $s): string {
        ?Core\Uuid $v = null;
        try {
            $v = Core\Uuid::parse($s);
        } catch (RuntimeError) {
            $v = Core\Uuid::parse("00000000-0000-4000-8000-000000000000");
        }
        return $v?->toString() ?? "null";
    }
}

// The texts that are not UUIDs give the default UUID.
array<string> $inputs = ["0123ABCD-0000-4000-8000-00000000000F", "nope", ""];
foreach ($inputs as string $s) {
    echo Ids::read($s), "\n";
}
--EXPECT--
0123abcd-0000-4000-8000-00000000000f
00000000-0000-4000-8000-000000000000
00000000-0000-4000-8000-000000000000
