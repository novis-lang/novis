--TEST--
A method whose only line is `return $this->name;` gives the other body's result for an object of a class that declares the method again — `rule:expressions/a-cheaper-form-with-the-same-result-is-compiled-or-named`
--FILE--
<?nvs
class User {
    protected string $name;

    public function constructor(string $name) {
        $this->name = $name;
    }

    public function getName(): string {
        return $this->name;
    }
}

// `Guest` declares `getName` again, so a call on a `Guest` runs this body.
class Guest extends User {
    public function getName(): string {
        return "guest " . $this->name;
    }
}

final class Names {
    public static function of(User $u): string {
        return $u->getName();
    }
}

echo Names::of(new User("ana")), "\n";
echo Names::of(new Guest("bo")), "\n";
--EXPECT--
ana
guest bo
