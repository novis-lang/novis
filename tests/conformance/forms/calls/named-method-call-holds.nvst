--TEST--
A method call on a variable of class `Animal` runs the one body of the method, also for an object of a class that extends `Animal` — `rule:expressions/a-cheaper-form-with-the-same-result-is-compiled-or-named`
--FILE--
<?nvs
class Animal {
    public string $name;

    public function constructor(string $name) {
        $this->name = $name;
    }

    public function describe(int $legs): string {
        return $this->name . " has " . $legs . " legs";
    }
}

// `Dog` does not declare `describe` again, so `Animal::describe` runs for a `Dog` too.
class Dog extends Animal {
}

final class Zoo {
    public static function show(Animal $a, int $legs): string {
        return $a->describe($legs);
    }
}

echo Zoo::show(new Animal("bird"), 2), "\n";
echo Zoo::show(new Dog("dog"), 4), "\n";
// The method reads the property when it runs, so the new name is printed.
Animal $pet = new Dog("rex");
$pet->name = "max";
echo $pet->describe(3), "\n";
--EXPECT--
bird has 2 legs
dog has 4 legs
max has 3 legs
