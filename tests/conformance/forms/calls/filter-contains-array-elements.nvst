--TEST--
`Core\Arr::filter` with a test of `Core\Arr::contains` compares arrays by their entries, where the elements are arrays — `rule:expressions/a-cheaper-form-with-the-same-result-is-compiled-or-named`
--FILE--
<?nvs
final class Sets {
    public static function without(array<array<int>> $a, array<array<int>> $b): array<array<int>> {
        return Core\Arr::filter($a, fn(array<int> $x): bool => !Core\Arr::contains($b, $x));
    }

    public static function within(array<array<int>> $a, array<array<int>> $b): array<array<int>> {
        return Core\Arr::filter($a, fn(array<int> $x): bool => Core\Arr::contains($b, $x));
    }
}

array<array<int>> $a = [[1, 2], [3], [1, 2], [2, 1]];
array<array<int>> $b = [[1, 2]];
// Both copies of `[1, 2]` are equal to the entry in `b`. `[2, 1]` is not.
echo Core\Json::encode(Sets::without($a, $b)), "\n";
echo Core\Json::encode(Sets::within($a, $b)), "\n";
// An empty array is equal only to another empty array.
echo Core\Json::encode(Sets::without([[], [0]], [[]])), "\n";
--EXPECT--
{"1":[3],"3":[2,1]}
{"0":[1,2],"2":[1,2]}
{"1":[0]}
