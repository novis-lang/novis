--TEST--
A loop over `Core\Arr::range` counts up, counts down, takes a step, and fixes its values before the first step even when the body changes the bounds — `rule:expressions/a-cheaper-form-with-the-same-result-is-compiled-or-named`
--FILE--
<?nvs
// `range(1, 5)` counts up from 1 to 5.
foreach (Core\Arr::range(1, 5) as int $i) {
    echo $i, ";";
}
echo "\n";

// When the start is bigger than the end, `range` counts down.
foreach (Core\Arr::range(5, 1) as int $i) {
    echo $i, ";";
}
echo "\n";

// A step of 4 stops at the last value that is not past the end, so this prints `1;5;9;`.
foreach (Core\Arr::range(1, 10, options: {step: 4}) as int $i) {
    echo $i, ";";
}
echo "\n";

// A step also works when counting down.
foreach (Core\Arr::range(10, -2, options: {step: 3}) as int $i) {
    echo $i, ";";
}
echo "\n";

// When the start and the end are equal, the loop runs once.
foreach (Core\Arr::range(7, 7) as int $i) {
    echo $i, ";";
}
echo "\n";

// The body changes the bounds and the step. The values were fixed before the first step,
// so the loop still prints `0;2;4;6;`.
int $from = 0;
int $to = 6;
int $step = 2;
foreach (Core\Arr::range($from, $to, options: {step: $step}) as int $i) {
    $from = 100;
    $to = -100;
    $step = 50;
    echo $i, ";";
}
echo "\n";
echo $from, " ", $to, " ", $step, "\n";

// Changing the loop variable in the body does not change the next value.
foreach (Core\Arr::range(1, 3) as int $i) {
    echo $i, ";";
    $i = $i + 10;
}
echo "\n";
--EXPECT--
1;2;3;4;5;
5;4;3;2;1;
1;5;9;
10;7;4;1;-2;
7;
0;2;4;6;
100 -100 50
1;2;3;
