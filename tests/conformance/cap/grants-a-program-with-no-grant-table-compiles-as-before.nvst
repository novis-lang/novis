--TEST--
with no `package.toml`, every namespace has the application's capabilities, so a namespaced file reads a file as before — `rule:security/an-unmatched-namespace-holds-the-application`
--FILE--
<?nvs
// There is no `[grants]` table, so `Acme\Cache` can read files like the
// application can.
autoload 'Acme\Cache' from './cache';

echo Acme\Cache\Store::load(), "\n";
--FILE cache/Store.nvs--
<?nvs
namespace Acme\Cache;

final class Store
{
    public static function load(): string
    {
        return Core\IO::readText("../note.txt");
    }
}
--FILE note.txt--
note
--EXPECT--
note
