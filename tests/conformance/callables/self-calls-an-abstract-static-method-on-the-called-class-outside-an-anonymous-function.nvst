--TEST--
Outside an anonymous function, `self::` and `static::` on an `abstract static` method call the class the outer call was made on, so an inherited static method reaches the subclass's body — `rule:statements/static-is-a-member-modifier`
--FILE--
<?nvs
abstract class Page {
    public abstract static function title(): string;

    public static function heading(): string {
        return "# " . self::title();
    }

    public static function footer(): string {
        return "-- " . static::title();
    }

    // An anonymous function reads the value that was read outside it.
    public static function shout(): string {
        string $title = self::title();
        callable $f = fn (): string => Core\Str::upper($title);
        return $f() as string;
    }
}

final class Blog extends Page {
    public static function title(): string {
        return "Blog";
    }
}

final class Shop extends Page {
    public static function title(): string {
        return "Shop";
    }
}

echo Blog::heading(), "\n";
echo Shop::heading(), "\n";
echo Blog::footer(), "\n";
echo Shop::shout(), "\n";
--EXPECT--
# Blog
# Shop
-- Blog
SHOP
