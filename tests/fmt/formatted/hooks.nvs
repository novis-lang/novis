<?nvs
class Temperature
{
    public float $celsius {
        get => $this->celsius;
        set(float $value) {
            if ($value < -273.15) {
                throw new LogicError('below absolute zero');
            }
            $this->celsius = $value;
        }
    }
}

var $t = new Temperature();
$t->celsius = 21.5;
echo $t->celsius . "\n";
