<?nvs
class Status
{
    public static function label(int $code): string
    {
        switch ($code) {
            case 200:
                return 'ok';
            case 301:
            case 302:
                // A redirect has two codes.
                return 'moved';
            default:
                if ($code >= 500) {
                    return 'server error';
                }
                return 'other';
        }
    }
}

echo Status::label(302) . "\n";
