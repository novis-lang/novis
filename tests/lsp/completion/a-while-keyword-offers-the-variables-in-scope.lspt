--TEST--
a cursor on the `while` keyword is in the statement and in neither its condition nor its body, which is a position, and the locals the script declared are in scope there, `rule:ide/the-index-answers-the-cursor`
--FILE--
<?nvs
int $count = 0;
whil<|>e ($count < 3) {
    $count = $count + 1;
}
--REQUEST--
completion prefix=$
--EXPECT--
$count  variable  int
