--TEST--
a cursor on the `foreach` keyword is in the loop and in neither the subject nor the binder, and the body it belongs to is the script frame whose locals it is offered, `rule:ide/the-index-answers-the-cursor`
--FILE--
<?nvs
array<int> $rows = [1, 2, 3];
forea<|>ch ($rows as int $row) {
    echo $row;
}
--REQUEST--
completion prefix=$
--EXPECT--
$row    variable  int
$rows   variable  array<int>
