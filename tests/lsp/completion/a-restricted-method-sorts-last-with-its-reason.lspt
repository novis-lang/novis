--TEST--
a method a `[[restrict]]` entry does not allow at the cursor sorts after every other item, its `detail` says where it is allowed, and it is not tagged deprecated, `rule:packaging/a-restriction-limits-where-a-declaration-is-used`
--FILE--
<?nvs
autoload 'App' from './app';

echo App\Secret\Vault::<|>
--FILE app/Secret/Vault.nvs--
<?nvs
namespace App\Secret;

final class Vault
{
    public static function close(): string
    {
        return "closed";
    }

    public static function open(): string
    {
        return "open";
    }
}
--FILE package.toml--
[[restrict]]
use = 'App\Secret\Vault::open'
allow = ['App\Allowed']
note = 'Use `App\Allowed\Door::open`.'
--REQUEST--
completion
--EXPECT--
close() method    string
open()  method    string
  sorted last: You cannot use this here. It is allowed only in `App\Allowed`. Use `App\Allowed\Door::open`.
