--TEST--
an arm condition of a `match` over a nullable enum is offered `null` among the cases it expects, and the keyword `null` is not offered a second time, `rule:ide/completion-is-asked-where-a-spelling-ends`
--FILE--
<?nvs
enum Priority { Low, Normal, High }

final class Labels
{
    public static function short(?Priority $p): string
    {
        return match ($p) {
            Priority::Low => "low",
            <|>
        };
    }
}
--REQUEST--
completion prefix=nu
--EXPECT--
null    keyword
