--TEST--
a subscript of an array keyed by an enum is offered every case of that enum, the key already written included,`rule:ide/completion-is-asked-where-a-spelling-ends`, `rule:types/arrays`
--FILE--
<?nvs
enum Priority { Low, Normal, High }

array<Priority, string> $labels = [Priority::Low => "low"];
echo $labels[<|>];
--REQUEST--
completion prefix=Priority
--EXPECT--
Priority enum      Priority
Priority::High enumMember
Priority::Low enumMember
Priority::Normal enumMember
