--TEST--
a cursor on the `switch` keyword is in the statement and in neither its subject nor an arm, which is a position, and the locals the script declared are in scope there, `rule:ide/the-index-answers-the-cursor`
--FILE--
<?nvs
int $code = 1;
switc<|>h ($code) {
    case 1:
        echo "one";
        break;
    default:
        break;
}
--REQUEST--
completion prefix=$
--EXPECT--
$code   variable  int
