--TEST--
`new` opens an expression rather than an access, so a cursor on the keyword is offered the words an expression may open with, `rule:ide/the-request-set-is-closed`
--FILE--
<?nvs
class User
{
    public string $name = "";
}

var $u = ne<|>w User();
--REQUEST--
completion prefix=cl
--EXPECT--
clone   keyword
