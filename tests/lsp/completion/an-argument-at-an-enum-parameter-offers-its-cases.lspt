--TEST--
an argument at a parameter typed by an enum is offered every case of that enum,`rule:ide/completion-is-asked-where-a-spelling-ends`
--FILE--
<?nvs
enum Priority { Low, Normal, High }

final class Labels
{
    public static function label(Priority $p): string
    {
        return "label";
    }
}

echo Labels::label(<|>);
--REQUEST--
completion prefix=Priority
--EXPECT--
Priority enum      Priority
Priority::High enumMember
Priority::Low enumMember
Priority::Normal enumMember
