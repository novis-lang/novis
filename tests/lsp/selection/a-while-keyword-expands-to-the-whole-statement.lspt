--TEST--
a cursor on the `while` keyword is in the statement and in neither its condition nor its body, so the whole statement is the one step there is, `rule:ide/the-index-answers-the-cursor`
--FILE--
<?nvs
int $count = 0;
whil<|>e ($count < 3) {
    $count = $count + 1;
}
--REQUEST--
selectionRange
--EXPECT--
3:1-5:2
