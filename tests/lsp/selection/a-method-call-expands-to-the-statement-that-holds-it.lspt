--TEST--
a call written off a receiver is one node covering both halves, so the step out of it is the statement rather than the receiver, `rule:ide/the-index-answers-the-cursor`
--FILE--
<?nvs
class User { public function greet(): string { return "hi"; } }
var $u = new User();
echo $u->gr<|>eet();
--REQUEST--
selectionRange
--EXPECT--
4:6-4:17
4:1-4:18
