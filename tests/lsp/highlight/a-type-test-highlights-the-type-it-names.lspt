--TEST--
The cursor anywhere in a type test resolves to the type the test names, so the use it highlights in this file is the `implements` clause and not the declaration, `rule:ide/the-index-answers-the-cursor`
--FILE--
<?nvs
interface Shape
{
    public function area(): int;
}

class Square implements Shape
{
    public function area(): int { return 4; }
}

mixed $s = new Square();
if ($s i<|>s Shape) {
    echo $s->area();
}
--REQUEST--
documentHighlight
--EXPECT--
case.nvs:7:25
