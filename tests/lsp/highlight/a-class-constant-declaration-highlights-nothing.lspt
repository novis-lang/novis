--TEST--
a class constant's declaration highlights nothing however many sites read it, because a constant read resolves to nothing the occurrence walk records, `rule:ide/five-features-are-one-reference-index`
--FILE--
<?nvs
class Cart
{
    public const int LI<|>MIT = 10;
}

echo Cart::LIMIT;
--REQUEST--
documentHighlight
--EXPECT--
none
