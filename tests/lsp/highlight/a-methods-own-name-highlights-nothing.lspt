--TEST--
a method's own declaration highlights nothing where two calls in the same file resolve to it, which is the declaration side of the same seam a class name meets, `rule:ide/five-features-are-one-reference-index`
--FILE--
<?nvs
class User
{
    public function gr<|>eet(): string
    {
        return "hi";
    }
}

var $u = new User();
echo $u->greet();
echo $u->greet();
--REQUEST--
documentHighlight
--EXPECT--
none
