--TEST--
a case declaration highlights nothing even where the case is read, because that read was recorded against the enum rather than against the case, `rule:ide/five-features-are-one-reference-index`
--FILE--
<?nvs
enum Status: int
{
    case Dr<|>aft = 1;
    case Live = 2;
}

var $s = Status::Draft;
--REQUEST--
documentHighlight
--EXPECT--
none
