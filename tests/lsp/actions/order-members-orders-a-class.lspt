--TEST--
order class members puts a property above a method, and the file stays formatted, `rule:tooling/class-members-have-one-order`
--FILE--
<?nvs
class Shop
{
    public function <|>run(): void
    {
    }

    private int $count = 0;
}
--REQUEST--
codeAction only=source.orderMembers.nvs
