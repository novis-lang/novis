--TEST--
a cursor on the `foreach` keyword meets no diagnostic's range, so it is offered nothing, `rule:ide/a-code-action-ships-only-a-fix-a-diagnostic-already-knows`
--FILE--
<?nvs
array<int> $rows = [1, 2, 3];
forea<|>ch ($rows as int $row) {
    echo $row;
}
--REQUEST--
codeAction
--EXPECT--
none
