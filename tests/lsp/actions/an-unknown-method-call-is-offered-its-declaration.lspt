--TEST--
a call to a method the class does not declare is offered its declaration
--FILE--
<?nvs
class Cart
{
    public int $total = 0;
}

var $cart = new Cart();
var $count = 2;
int $sum = <|>$cart->add($count, "pen", 4.5);
echo $sum;
--REQUEST--
codeAction
--EXPECT--
