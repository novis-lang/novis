--TEST--
organize imports deletes the `use` line nothing reads and sorts the others, `rule:ide/no-refactoring-introduces-an-alias`
--FILE--
<?nvs
require 'lib/shop.nvs';

use Shop\Order;
use Shop\Coupon;
use Shop\Item;

class Label {
    public function title(Item $item, Order $order): string {
        return "item";
    }
}

var $label = new Label();<|>
--FILE lib/shop.nvs--
<?nvs
namespace Shop;

class Item {}

class Order {}

class Coupon {}
--REQUEST--
codeAction only=source.organizeImports
--EXPECT--
4:10-6:14 source.organizeImports Organize imports -> "Item;\nuse Shop\Order"
