--TEST--
`prepareRename` on a class constant read answers the range of the constant's name alone, without the class and the `::` in front of it, `rule:ide/no-refactoring-introduces-an-alias`
--FILE--
<?nvs
class Cart
{
    public const int LIMIT = 10;
}

echo Cart::LI<|>MIT;
--REQUEST--
prepareRename
--EXPECT--
case.nvs:7:12-7:17
