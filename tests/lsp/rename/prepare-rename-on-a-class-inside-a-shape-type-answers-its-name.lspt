--TEST--
prepare-rename on a class written as a field's type inside a shape type answers the class name's range, `rule:types/shape-type`, `rule:ide/five-features-are-one-reference-index`
--FILE--
<?nvs
class Customer
{
    public string $name = "";
}

class Shop
{
    public static function place({owner: Cus<|>tomer, note?: string} $order): void {}
}

Shop::place({owner: new Customer(), note: "gift"});
--REQUEST--
prepareRename
--EXPECT--
case.nvs:9:42-9:50
