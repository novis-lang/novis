--TEST--
`prepareRename` on a class constant's own declaration answers the range of its name alone, without the type in front of it, `rule:ide/no-refactoring-introduces-an-alias`
--FILE--
<?nvs
class Cart
{
    public const int LI<|>MIT = 10;
}

echo Cart::LIMIT;
--REQUEST--
prepareRename
--EXPECT--
case.nvs:4:22-4:27
