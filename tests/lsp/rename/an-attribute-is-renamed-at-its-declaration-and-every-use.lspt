--TEST--
a rename on the name in an attribute's own declaration rewrites that name and each `#[Name]` written under it, `rule:ide/no-refactoring-introduces-an-alias`
--FILE--
<?nvs
interface Page {
    attribute Pa<|>th on method { path: string }

    public function render(): string;
}

class Home implements Page {
    #[Path(path: "/")]
    public function render(): string { return "home"; }
}
--REQUEST--
rename to=Route
--EXPECT--
case.nvs:3:15 Route
case.nvs:9:7 Route
