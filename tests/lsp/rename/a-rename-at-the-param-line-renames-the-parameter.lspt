--TEST--
a rename with the cursor on the `$name` of an `@param` line renames the parameter it names, in the signature, the body and the comment, `rule:tooling/doc-comment-tags-are-closed-and-checked`
--FILE--
<?nvs
class Greeter
{
    /// Greets one person.
    ///
    /// @param $na<|>me the person to greet
    public function greet(string $name): string
    {
        return "Hello, " . $name;
    }
}
--REQUEST--
rename to=person
--EXPECT--
case.nvs:6:16 $person
case.nvs:7:34 $person
case.nvs:9:28 $person
