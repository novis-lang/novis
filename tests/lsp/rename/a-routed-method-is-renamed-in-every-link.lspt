--TEST--
a method that carries a `#[Route]` is renamed at its declaration and in every link that names it, so each link still names its route, `rule:ide/no-refactoring-introduces-an-alias`
--FILE--
<?nvs
class Shop
{
    #[Core\Route(path: '/items/{id}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(uint $id): string
    {
        return "item";
    }

    #[Core\Route(path: '/', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function index(): string
    {
        return Core\Router::url(Shop::sh<|>ow, ['id' => 3]);
    }
}
--REQUEST--
rename to=item
--EXPECT--
case.nvs:6:21 item
case.nvs:15:39 item
