--TEST--
an `isRevoked()` call resolves to the member `Revocable` declares, so it answers that member's line and card, `rule:classes/revocable-objects`
--FILE--
<?nvs
class Post implements Revocable {
    public function constructor(public string $title) {}
}

var $post = new Post('Hello');
$post->revoke();
echo $post->isRev<|>oked() ? 'yes' : 'no', "\n";
