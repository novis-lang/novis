--TEST--
hover on a parameter inside the method's body shows the sentence of its `@param` line, `rule:tooling/doc-comment-tags-are-closed-and-checked`
--FILE--
<?nvs
class Greeter
{
    /// Greets one person.
    ///
    /// @param $name the person to greet, as they wrote their name
    public function greet(string $name): string
    {
        return "Hello, " . $na<|>me;
    }
}
--REQUEST--
hover
--EXPECT--
