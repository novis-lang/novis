--TEST--
a method that carries a `#[Route]` answers every `#[Core\Router\Target]` argument that names it, beside its links, because each names the route by an ordinary method reference, `rule:ide/five-features-are-one-reference-index`
--FILE--
<?nvs
class Shop
{
    #[Core\Route(path: '/items/{id}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function sh<|>ow(uint $id): string
    {
        return "item";
    }
}

class Menu
{
    public static function entry(#[Core\Router\Target] callable $route,
                                 #[Core\Router\Params] array $params): string
    {
        return "entry";
    }
}

echo Core\Router::url(Shop::show, ['id' => 3]);
echo Menu::entry(Shop::show, ['id' => 4]);
echo Menu::entry(params: ['id' => 5], route: Shop::show);
--REQUEST--
references
--EXPECT--
case.nvs:6:28
case.nvs:21:29
case.nvs:22:24
case.nvs:23:52
