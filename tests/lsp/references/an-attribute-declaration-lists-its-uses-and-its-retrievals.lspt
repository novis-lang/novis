--TEST--
a cursor on an attribute's own declaration answers the declaration, every `#[Name]` written under it and every retrieval whose type argument names it, `rule:attributes/an-attribute-is-declared-with-its-sites`, `rule:ide/five-features-are-one-reference-index`
--FILE--
<?nvs
interface Page {
    attribute Pa<|>th on method { path: string }

    public function render(): string;
}

class Home implements Page {
    #[Path(path: "/")]
    public function render(): string { return "home"; }
}

var $rows = Core\Program::implementingWith<Page, Page::Path>("render");
--REQUEST--
