--TEST--
a compiler attribute is a declaration like a program's, so asking for its references lists each use of it, `rule:ide/five-features-are-one-reference-index`, `rule:attributes/an-attribute-is-declared-with-its-sites`
--FILE--
<?nvs
class Blog
{
    #[Core\Ro<|>ute(path: "/", method: Core\Http\Method::Get)]
    public static function index(): string
    {
        return "hello";
    }
}
--REQUEST--
references
--EXPECT--
case.nvs:4:7
