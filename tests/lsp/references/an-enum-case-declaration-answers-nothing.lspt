--TEST--
a case declaration answers nothing even where the case is read, because the index has no symbol of its own for a case and the read was recorded against the enum, `rule:ide/five-features-are-one-reference-index`
--FILE--
<?nvs
enum Status: int
{
    case Dr<|>aft = 1;
    case Live = 2;
}

var $s = Status::Draft;
--REQUEST--
references
--EXPECT--
none
