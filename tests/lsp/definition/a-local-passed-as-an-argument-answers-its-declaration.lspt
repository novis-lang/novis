--TEST--
a local passed as a call's argument answers its own declaration and not the method the call resolves to, because the variable token under the cursor is asked before the call around it, `rule:ide/five-features-are-one-reference-index`
--FILE--
<?nvs
class Section
{
    public static function create(string $title, string $body): string
    {
        return $title . $body;
    }
}

string $summary = "none";
if (true) {
    $summary = "some";
}
echo Section::create("Title", $sum<|>mary);
--REQUEST--
definition
--EXPECT--
case.nvs:10:8
