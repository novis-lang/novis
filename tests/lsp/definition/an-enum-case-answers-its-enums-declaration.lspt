--TEST--
a case is a member and the symbol table holds declarations, so `Status::Live` under the cursor answers `enum Status` rather than the case itself, `rule:enums/no-class-machinery`
--FILE--
<?nvs
enum Status: int {
    case Draft = 1;
    case Live = 2;
}

$s = Status::Li<|>ve;
echo $s;
--REQUEST--
definition
--EXPECT--
case.nvs:2:6
