--TEST--
the `$name` after `@param` is coloured as a parameter, as the same name in the parameter list is, `rule:tooling/doc-comment-tags-are-closed-and-checked`
--FILE--
<?nvs
class Greeter
{
    /// @param $name the person to greet
    public function greet(string $name): string
    {
        return "Hello, " . $name;
    }
}
