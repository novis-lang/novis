--TEST--
an import only a parameter type reads is kept, and one nothing reads is the faded warning, `rule:statements/an-unused-use-is-a-warning`
--FILE--
<?nvs
require 'lib/shop.nvs';

use Shop\Item;
use Shop\Order;

class Label {
    public function title(Item $item): string {
        return "item";
    }
}

var $label = new Label();
--FILE lib/shop.nvs--
<?nvs
namespace Shop;

class Item {}

class Order {}
--REQUEST--
diagnostics
--EXPECT--
5:5-5:15 warning W1026 `Shop\Order` is imported, but this file never uses it
