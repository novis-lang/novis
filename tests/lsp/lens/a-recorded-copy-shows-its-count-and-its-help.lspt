--TEST--
a line where the newest recorded request copied a value has one lens that sums its sites' copies and shows the help of the site that copied the most, an older request's copies on that line are not counted, and a record made from another text or another file gives no lens, `rule:types/a-replaced-value-is-changed-in-place`
--FILE--
<?nvs
array<int> $prices = [30, 10, 20];
array<int> $sorted = Core\Arr::sort($prices);
    $prices = Core\Arr::append($prices, 40);
echo $prices[0] + $sorted[0];
--FILE debug/index.sql--
CREATE TABLE requests (id INTEGER PRIMARY KEY, trace TEXT NOT NULL, span TEXT);
CREATE TABLE copies (trace TEXT NOT NULL, span TEXT, file TEXT NOT NULL, line INTEGER NOT NULL, hash TEXT NOT NULL, reason TEXT NOT NULL, copies INTEGER NOT NULL, units INTEGER NOT NULL);
INSERT INTO requests VALUES (1, '0123456789abcdef0123456789abcdef', '0123456789abcdef');
INSERT INTO requests VALUES (2, 'fedcba9876543210fedcba9876543210', 'fedcba9876543210');
INSERT INTO copies VALUES ('0123456789abcdef0123456789abcdef', '0123456789abcdef', 'case.nvs', 3, '{{hash}}', 'still_used', 9, 27);
INSERT INTO copies VALUES ('fedcba9876543210fedcba9876543210', 'fedcba9876543210', 'case.nvs', 3, '{{hash}}', 'still_used', 1, 3);
INSERT INTO copies VALUES ('fedcba9876543210fedcba9876543210', 'fedcba9876543210', 'case.nvs', 3, '{{hash}}', 'slot_kept', 1, 1);
INSERT INTO copies VALUES ('0123456789abcdef0123456789abcdef', '0123456789abcdef', 'case.nvs', 4, '{{hash}}', 'callee_unknown', 1, 4);
INSERT INTO copies VALUES ('fedcba9876543210fedcba9876543210', 'fedcba9876543210', 'case.nvs', 2, 'a hash of another text of the file', 'still_used', 1, 3);
INSERT INTO copies VALUES ('fedcba9876543210fedcba9876543210', 'fedcba9876543210', 'other.nvs', 5, '{{hash}}', 'still_used', 1, 3);
--REQUEST--
codeLens
--EXPECT--
3:1 Copied 2 times here, 4 entries or bytes. The variable is used again after this call, so the call changes a copy.
4:5 Copied once here, 4 entries or bytes. The function that runs here is only known when the program runs, so the value is copied.
