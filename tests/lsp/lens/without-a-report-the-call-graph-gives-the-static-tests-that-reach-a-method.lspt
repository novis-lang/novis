--TEST--
without a coverage report the tests come from the call graph and read static, and a test that requests a route reaches that route's handler, `rule:ide/used-by-counts-the-routes-and-tests-that-reach-a-method`
--FILE--
<?nvs
use Core\Http\Method;
use Core\Test;

class Prices {
    public function base(): int {
        return 3;
    }
}

class Shop {
    #[Core\Route(path: '/cart', method: Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function cart(): void {
        echo new Prices()->base();
    }
}

class ShopTest {
    #[Test]
    public function cartLoads(): void {
        var $page = Test::request(Method::Get, '/cart');
        Test::assertEquals(200, $page->status());
    }
    #[Test]
    public function baseIsThree(): void {
        Test::assertEquals(3, new Prices()->base());
    }
    #[Test]
    public function missingPage(): void {
        var $page = Test::request(Method::Get, '/nowhere');
        Test::assertEquals(404, $page->status());
    }
}
--REQUEST--
