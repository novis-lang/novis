--TEST--
a method names the nearest method it overrides up each edge, skipping a class that declares none, and counts every method below that overrides it, `rule:ide/five-features-are-one-reference-index`
--FILE--
<?nvs
class Animal {
    public function speak(): string { return ""; }
}
class Dog extends Animal {
    public function speak(): string { return "woof"; }
}
class Puppy extends Dog {}
class Pup extends Puppy {
    public function speak(): string { return "yip"; }
}
--REQUEST--
codeLens
--EXPECT--
2:7 1 reference -> case.nvs:5:19
2:7 1 subclass -> case.nvs:5:7
3:21 2 overrides -> case.nvs:6:21, case.nvs:10:21
3:21 no references
5:7 1 reference -> case.nvs:8:21
5:7 1 subclass -> case.nvs:8:7
6:21 1 override -> case.nvs:10:21
6:21 no references
6:21 overrides Animal::speak -> case.nvs:3:21
8:7 1 reference -> case.nvs:9:19
8:7 1 subclass -> case.nvs:9:7
9:7 no references
10:21 no references
10:21 overrides Dog::speak -> case.nvs:6:21
