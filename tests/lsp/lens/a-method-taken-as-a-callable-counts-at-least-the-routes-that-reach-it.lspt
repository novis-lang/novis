--TEST--
a method that is also taken as a callable value may be reached by a call the graph does not follow, so its counts read at least, `rule:ide/used-by-counts-the-routes-and-tests-that-reach-a-method`
--FILE--
<?nvs
use Core\Http\Method;

class Prices {
    public function base(): int {
        return 3;
    }
    public function plain(): int {
        return 5;
    }
}

class Shop {
    #[Core\Route(path: '/cart', method: Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function cart(): void {
        var $p = new Prices();
        echo $p->base();
        echo $p->plain();
    }
}

var $f = new Prices()->base(...);
