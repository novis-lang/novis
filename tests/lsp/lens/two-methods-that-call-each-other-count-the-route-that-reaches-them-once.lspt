--TEST--
two methods that call each other end the walk, and each counts the one route that reaches them once, `rule:ide/used-by-counts-the-routes-and-tests-that-reach-a-method`
--FILE--
<?nvs
use Core\Http\Method;

class Counter {
    public function even(int $n): bool {
        return $n == 0 ? true : $this->odd($n - 1);
    }
    public function odd(int $n): bool {
        return $n == 0 ? false : $this->even($n - 1);
    }
}

class Shop {
    #[Core\Route(path: '/even', method: Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function check(): void {
        echo new Counter()->even(4);
    }
}
--REQUEST--
codeLens
