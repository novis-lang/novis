--TEST--
an interface method counts the methods that implement it, and a method that both extends a class and implements an interface names both methods it overrides, `rule:ide/five-features-are-one-reference-index`
--FILE--
<?nvs
interface Named {
    public function name(): string;
}
class Base {
    public function name(): string { return "base"; }
}
class Item extends Base implements Named {
    public function name(): string { return "item"; }
}
--REQUEST--
codeLens
--EXPECT--
2:11 1 implementation -> case.nvs:8:7
2:11 1 reference -> case.nvs:8:36
3:21 1 override -> case.nvs:9:21
3:21 no references
5:7 1 reference -> case.nvs:8:20
5:7 1 subclass -> case.nvs:8:7
6:21 1 override -> case.nvs:9:21
6:21 no references
8:7 no references
9:21 no references
9:21 overrides Base::name, Named::name -> case.nvs:3:21, case.nvs:6:21
