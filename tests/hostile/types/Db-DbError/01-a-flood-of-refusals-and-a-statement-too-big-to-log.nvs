<?nvs
// Attack: the database rejects a statement 100,000 times, then rejects one
// statement that is megabytes long. Then an error is thrown again through 20,000 calls.
// Each `DbError` has a copy of its statement. Every error should be freed after
// its `catch` block, so memory stays small and the program finishes.
// hostile: timeout-ms 60000

use Core\Db;
use Core\Db\Connection;
use Core\Db\DbError;

final class Flood
{
    // Inserts the same row again and again. Each round creates a `DbError`,
    // reads it and frees it.
    public static function churn(Connection $db, int $rounds): uint
    {
        uint $kept = 0;
        int $i = 0;
        while ($i < $rounds) {
            try {
                $db->execute('insert into one (id) values (?)', [1]);
            } catch (DbError $refused) {
                // This reads both fields, so the error must really contain them.
                if (Core\Str::length($refused->message) > 0) {
                    $kept = $kept + 1;
                }
                string $wrote = $refused->sql ?? '';
                if (Core\Str::length($wrote) > 0) {
                    $kept = $kept + 1;
                }
            }
            $i = $i + 1;
        }
        return $kept;
    }

    // One rejected statement with a few megabytes of text. The error keeps that
    // text. It should be stored once, and not copied on its way to the `catch` block.
    public static function huge(Connection $db, int $doublings): uint
    {
        string $padding = "-- and the rest of it\n";
        int $i = 0;
        while ($i < $doublings) {
            $padding = $padding . $padding;
            $i = $i + 1;
        }
        try {
            $db->execute($padding . 'insert into one (id) values (1)', []);
            return 0;
        } catch (DbError $refused) {
            string $wrote = $refused->sql ?? '';
            return Core\Str::length($wrote);
        }
    }

    // Each call catches the error from the call below it. Then it throws a new
    // `DbError` with the same message.
    public static function rethrow(Connection $db, int $depth): bool
    {
        if ($depth == 0) {
            $db->execute('insert into one (id) values (?)', [1]);
            return true;
        }
        try {
            return Flood::rethrow($db, $depth - 1);
        } catch (DbError $rising) {
            throw new Core\Db\DbError($rising->message);
        }
    }
}

var $db = Db::connect('schema');
$db->execute('create table one (id integer primary key)', []);
$db->execute('insert into one (id) values (1)', []);

echo Flood::churn($db, 100000), "\n";
echo Flood::huge($db, 17), "\n";

try {
    echo Flood::rethrow($db, 20000) ? "inserted\n" : "declined\n";
} catch (Throwable $gaveUp) {
    echo "the chain ended\n";
}
