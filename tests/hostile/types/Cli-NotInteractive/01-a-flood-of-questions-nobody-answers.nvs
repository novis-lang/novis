<?nvs
// Attack: call `Core\Cli::ask` many times with no terminal, then with a question
// that is megabytes long. Then rethrow the error through a deep chain of calls.
// The memory for each call should be freed, and the program should finish in time.
// hostile: timeout-ms 30000

final class Nobody
{
    // Each round calls `ask`, which throws `Core\Cli\NotInteractive`. The handle,
    // the message and the terminal check of each round should be freed.
    public static function churn(int $rounds): uint
    {
        uint $kept = 0;
        int $i = 0;
        while ($i < $rounds) {
            try {
                tainted string $said = Core\Cli::ask('who is there?');
                $kept = $kept + Core\Str::length($said);
            } catch (Core\Cli\NotInteractive $none) {
                // The code reads the message, so every error must create its message.
                if (Core\Str::length($none->message) > 0) {
                    $kept = $kept + 1;
                }
            }
            $i = $i + 1;
        }
        return $kept;
    }

    // One question of a few megabytes. There is no terminal, so `ask` should
    // write nothing and copy the text at most once.
    public static function huge(int $doublings): uint
    {
        string $question = 'who is there? ';
        int $i = 0;
        while ($i < $doublings) {
            $question = $question . $question;
            $i = $i + 1;
        }
        try {
            tainted string $said = Core\Cli::ask($question);
            return Core\Str::length($said);
        } catch (Core\Cli\NotInteractive $none) {
            return Core\Str::length($question);
        }
    }

    // Each frame catches the error from the frame below it and throws a new one
    // with the same message. A deep chain has one live error per frame.
    public static function rethrow(int $depth): bool
    {
        if ($depth == 0) {
            return Core\Cli::confirm('still there?');
        }
        try {
            return Nobody::rethrow($depth - 1);
        } catch (Core\Cli\NotInteractive $rising) {
            throw new Core\Cli\NotInteractive($rising->message);
        }
    }
}

echo Nobody::churn(200000), "\n";
echo Nobody::huge(18), "\n";

try {
    echo Nobody::rethrow(20000) ? "answered\n" : "declined\n";
} catch (Throwable $gaveUp) {
    echo "the chain ended\n";
}
