<?nvs
// Attack: fail while already failing. Every level of a deep stack throws a new
// IOError out of its own cleanup, so the error in flight is replaced hundreds
// of times on the way up, each replacement allocating while the unwind runs.
// hostile: timeout-ms 20000

class Unwind
{
    public static function down(uint $depth): void
    {
        if ($depth == 0) {
            throw new IOError('the bottom');
        }
        try {
            Unwind::down($depth - 1);
        } finally {
            // Cleanup that itself fails, which is the case a runtime is most
            // likely to have got wrong: the error being carried is dropped here
            // and a new one takes its place.
            throw new IOError('cleanup failed on the way up');
        }
    }
}

uint $round = 0;
while ($round < 200) {
    try {
        Unwind::down(400);
    } catch (Throwable $whatever) {
        // Caught and dropped: nothing may be held once the clause ends, however
        // many errors were built to get here.
    }
    $round = $round + 1;
}
echo "unwound\n";

// The other direction: an error raised inside the clause handling an error,
// again and again, so each answer is itself an answer to something.
uint $nested = 0;
while ($nested < 2000) {
    try {
        try {
            try {
                throw new IOError('first');
            } catch (IOError $first) {
                throw new IOError('second', { previous: $first });
            }
        } catch (IOError $second) {
            throw new IOError('third', { previous: $second });
        }
    } catch (IOError $third) {
        var $under = $third->previous;
        if ($under == null) {
            echo "a cause went missing\n";
        }
    }
    $nested = $nested + 1;
}
echo "nested\n";

// And a stack deeper than anything above, with nothing to catch what comes back
// but the outermost clause.
try {
    Unwind::down(100000);
} catch (Throwable $deep) {
    echo "deep\n";
}
