<?nvs
// Attack: a program throws thousands of `ParseError` errors with eight issues each.
// It decodes a document of only brackets, and then keeps every error in memory.
// The memory limit should stop the program before it uses up the server.
// hostile: timeout-ms 20000
// hostile: ends-early

uint $round = 0;
uint $seen = 0;
while ($round < 5000) {
    try {
        Core\Arr::shapeAs<{a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int}>([
            'a' => 'x',
            'b' => 'x',
            'c' => 'x',
            'd' => 'x',
            'e' => 'x',
            'f' => 'x',
            'g' => 'x',
            'h' => 'x',
        ]);
    } catch (ParseError $dropped) {
        // The issues are counted. The error should be freed when this block ends.
        $seen = $seen + Core\Arr::count($dropped->issues);
    }
    $round = $round + 1;
}
echo 'dropped ', $seen, " entries\n";

// A document of only opening brackets. The decoder reaches its depth limit
// and throws a `ParseError`.
try {
    Core\Json::decode(Core\Str::repeat('[', 200000));
} catch (ParseError $nesting) {
    echo "nesting refused\n";
}

// One broken value that is 250000 characters long.
try {
    Core\Json::decode(Core\Str::repeat('1', 250000) . 'x');
} catch (ParseError $long) {
    echo "long refused\n";
}

// This loop keeps every error and its issues in memory. The memory limit
// should stop the program here.
array<ParseError> $kept = [];
uint $held = 0;
while ($held < 200000) {
    try {
        Core\Arr::shapeAs<{a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int}>([
            'a' => 'x',
            'b' => 'x',
            'c' => 'x',
            'd' => 'x',
            'e' => 'x',
            'f' => 'x',
            'g' => 'x',
            'h' => 'x',
        ]);
    } catch (ParseError $keep) {
        $kept[] = $keep;
    }
    $held = $held + 1;
}
echo 'kept ', Core\Arr::count($kept), "\n";
