<?nvs
// Attack: throw this error many times, then rethrow it in every frame of a deep
// chain of calls. The memory for each error should be freed, and the program
// should finish within its time limit.
// hostile: timeout-ms 30000

final class Flood
{
    public static function churn(int $rounds): int
    {
        int $kept = 0;
        int $i = 0;
        while ($i < $rounds) {
            try {
                // The compiler cannot see that `$zero` is zero. So every round
                // throws the error while the program runs.
                int $zero = $i - $i;
                $kept = $kept + (1 % $zero);
            } catch (ArithmeticError $failed) {
                // The code reads the message, so every error must create its message.
                if (Core\Str::length($failed->message) > 0) {
                    $kept = $kept + 1;
                }
            }
            $i = $i + 1;
        }
        return $kept;
    }

    // Each frame catches the error from the frame below it and throws a new one
    // with the same message. A deep chain has one live error per frame.
    public static function rethrow(int $depth): int
    {
        if ($depth == 0) {
            int $zero = 0;
            return 1 % $zero;
        }
        try {
            return Flood::rethrow($depth - 1);
        } catch (ArithmeticError $rising) {
            throw new ArithmeticError($rising->message);
        }
    }
}

echo Flood::churn(400000), "\n";

try {
    echo Flood::rethrow(20000), "\n";
} catch (Throwable $gaveUp) {
    echo "the chain ended\n";
}
