<?nvs
// Attack: a program reaches the recursion limit many times. Each call creates an
// object and has a `finally` block, so each unwind has a lot of work to do.
// A `catch` block also starts the next deep recursion. The program should still finish.
// hostile: timeout-ms 20000

class Load
{
    public array<string> $rows;

    public function constructor()
    {
        $this->rows = ['order', 'customer', 'shipping address'];
    }
}

class Heavy
{
    public static function down(uint $depth): uint
    {
        // Each call creates one object and has one `finally` block. Unwinding
        // the stack frees thousands of objects and runs thousands of blocks.
        var $held = new Load();
        try {
            return Heavy::down($depth + 1) + Core\Arr::count($held->rows);
        } finally {
            $held = new Load();
        }
    }
}

uint $round = 0;
while ($round < 200) {
    try {
        Heavy::down(0);
    } catch (RecursionError $stopped) {
    }
    $round = $round + 1;
}
echo "hit two hundred times\n";

// The `catch` block starts the next deep recursion. So the limit is reached
// again while the last error is still being handled.
class Nested
{
    public static function again(uint $left): void
    {
        try {
            Heavy::down(0);
        } catch (RecursionError $stopped) {
            if ($left > 0) {
                Nested::again($left - 1);
            }
        }
    }
}

Nested::again(50);
echo "fifty of them inside each other\n";

// Two classes that call each other, so no single function calls itself.
// After that, an anonymous function that calls itself with no end.
class Ping
{
    public static function go(uint $depth): uint
    {
        return Pong::go($depth + 1);
    }
}

class Pong
{
    public static function go(uint $depth): uint
    {
        return Ping::go($depth + 1);
    }
}

try {
    Ping::go(0);
} catch (RecursionError $mutual) {
    echo "two classes, one stack\n";
}

callable $forever = fn down(uint $depth): uint => down($depth + 1);

try {
    $forever(0);
} catch (Throwable $anything) {
    echo "through an anonymous function\n";
}

echo "still standing\n";
