<?nvs
// Attack: a request calls `Engine::read` directly with encrypted files, broken files and forged invoices.
// Each call should return a shape or throw an error, and the server keeps running.
use Novis\Pdf\Document;
use Novis\Pdf\Engine;

class Forge
{
    // This method builds a PDF file from its objects, with a correct table of where each object starts.
    public static function pdf(array<bytes> $objects): bytes
    {
        array<bytes> $parts = ["%PDF-1.7\n" as bytes];
        array<int> $offsets = [];
        int $at = 9;
        int $n = 0;
        foreach ($objects as bytes $body) {
            $n = $n + 1;
            $offsets[] = $at;
            bytes $object = Core\Bytes::join(["{$n} 0 obj\n" as bytes, $body, "\nendobj\n" as bytes]);
            $parts[] = $object;
            $at = $at + Core\Bytes::length($object) as int;
        }
        string $table = "xref\n0 " . ($n + 1) as string . "\n0000000000 65535 f \n";
        foreach ($offsets as int $offset) {
            $table .= Core\Str::padStart($offset as string, 10, '0') . " 00000 n \n";
        }
        $parts[] = ($table . "trailer\n<< /Size " . ($n + 1) as string . " /Root 1 0 R >>\nstartxref\n{$at}\n%%EOF\n") as bytes;
        return Core\Bytes::join($parts);
    }

    // This method builds a PDF file with one page and `$xml` attached as `factur-x.xml`.
    public static function invoice(bytes $xml): bytes
    {
        uint $length = Core\Bytes::length($xml);
        return self::pdf([
            '<< /Type /Catalog /Pages 2 0 R /Names << /EmbeddedFiles << /Names [(factur-x.xml) 4 0 R] >> >> >>' as bytes,
            '<< /Type /Pages /Kids [3 0 R] /Count 1 >>' as bytes,
            '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] >>' as bytes,
            '<< /Type /Filespec /F (factur-x.xml) /UF (factur-x.xml) /EF << /F 5 0 R >> >>' as bytes,
            Core\Bytes::join(["<< /Type /EmbeddedFile /Length {$length} >>\nstream\n" as bytes, $xml, "\nendstream" as bytes]),
        ]);
    }
}

bytes $good = Document::fromHtml('<p>Shop</p>')->render()->bytes;

// 1. A file with an empty password, and a file with a long one.
array<string> $passwords = ['', Core\Str::repeat('x', 100000)];
foreach ($passwords as string $password) {
    try {
        var $locked = Document::fromHtml('<p>Locked</p>')->password($password)->render()->bytes;
        echo 'step 1 ran ', Engine::read($locked)->pageCount, "\n";
    } catch (Throwable $e) {
        echo "step 1 stopped\n";
    }
}

// 2. A good file with a forged `/Encrypt` entry added at its end.
try {
    var $forged = Core\Bytes::join([$good, "\ntrailer\n<< /Encrypt << /Filter /Standard /V 99 /R 99 >> >>\n%%EOF\n" as bytes]);
    echo 'step 2 ran ', Engine::read($forged)->pageCount, "\n";
} catch (Throwable $e) {
    echo "step 2 stopped\n";
}

// 3. Empty bytes, one byte, only the header of a PDF file, and the first 2000 bytes of a good file.
array<bytes> $broken = ['' as bytes, '%' as bytes, "%PDF-1.7\n%%EOF\n" as bytes, Core\Bytes::slice($good, 0, 2000)];
foreach ($broken as bytes $data) {
    try {
        echo 'step 3 ran ', Engine::read($data)->pageCount, "\n";
    } catch (Throwable $e) {
        echo "step 3 stopped\n";
    }
}

// 4. An invoice whose XML expands to ten billion words. The XML is read back as text and not expanded.
try {
    string $entities = '<!ENTITY lol0 "lol">';
    for (int $level = 1; $level <= 10; $level++) {
        $entities .= "<!ENTITY lol{$level} \"" . Core\Str::repeat('&lol' . ($level - 1) as string . ';', 10) . '">';
    }
    string $laughs = '<?xml version="1.0"?><!DOCTYPE r [' . $entities . ']><r>&lol10;</r>';
    echo 'step 4 ran ', Core\Str::length(Engine::read(Forge::invoice($laughs as bytes))->invoiceXml ?? ''), "\n";
} catch (Throwable $e) {
    echo "step 4 stopped\n";
}

// 5. An invoice whose XML is not UTF-8 text.
try {
    echo 'step 5 ran ', Engine::read(Forge::invoice(Core\Encoding::fromHex('3c723eff fe3c2f723e')))->invoiceXml ?? 'null', "\n";
} catch (Throwable $e) {
    echo "step 5 stopped\n";
}
