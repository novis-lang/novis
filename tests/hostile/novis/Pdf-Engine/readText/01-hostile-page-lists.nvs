<?nvs
// Attack: a request calls `Engine::readText` directly with page lists that `Reader` never sends.
// Each call should return text or throw an error, and the server keeps running.
use Novis\Pdf\Document;
use Novis\Pdf\Engine;

bytes $good = Document::fromHtml('<p>Shop</p>')->render()->bytes;

// 1. An empty page list.
try {
    array<uint> $none = [];
    echo 'step 1 ran ', Core\Arr::count(Engine::readText($good, $none)), "\n";
} catch (Throwable $e) {
    echo "step 1 stopped\n";
}

// 2. Page 0, and the largest page number.
array<uint> $numbers = [0, 18446744073709551615];
foreach ($numbers as uint $number) {
    try {
        echo 'step 2 ran ', Core\Arr::count(Engine::readText($good, [$number])), "\n";
    } catch (Throwable $e) {
        echo "step 2 stopped\n";
    }
}

// 3. One page asked for one hundred thousand times.
try {
    array<uint> $same = [];
    for (int $i = 0; $i < 100000; $i++) {
        $same[] = 1;
    }
    echo 'step 3 ran ', Core\Arr::count(Engine::readText($good, $same)), "\n";
} catch (Throwable $e) {
    echo "step 3 stopped\n";
}

// 4. A good page first, then a page past the end.
try {
    echo 'step 4 ran ', Core\Arr::count(Engine::readText($good, [1, 2])), "\n";
} catch (Throwable $e) {
    echo "step 4 stopped\n";
}

// 5. An encrypted file and bytes that are not a PDF file.
try {
    var $locked = Document::fromHtml('<p>Locked</p>')->password('example-password')->render()->bytes;
    echo 'step 5 ran ', Core\Arr::count(Engine::readText($locked, [1])), "\n";
} catch (Throwable $e) {
    echo "step 5a stopped\n";
}
try {
    echo 'step 5 ran ', Core\Arr::count(Engine::readText('Hello' as bytes, [1])), "\n";
} catch (Throwable $e) {
    echo "step 5b stopped\n";
}
