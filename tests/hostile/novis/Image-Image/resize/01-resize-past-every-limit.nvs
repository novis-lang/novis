<?nvs
// Attack: a request asks `resize` for images far larger than any server can hold.
// Each attempt should throw an error before the pixels are made, and the server keeps running.
use Novis\Image\Color;
use Novis\Image\Fit;
use Novis\Image\Image;

Image $small = Image::create(4, 4, Color::hex('#ff0000'));

// 1. A width of one million pixels, with `upscale` on.
try {
    $small->resize({ width: 1000000, upscale: true })->raw();
    echo "step 1 ran\n";
} catch (Throwable $e) {
    echo "step 1 stopped\n";
}

// 2. A box of the largest whole numbers, stretched to fill it.
try {
    $small->resize({ width: 18446744073709551615, height: 18446744073709551615, fit: Fit::Fill, upscale: true })->raw();
    echo "step 2 ran\n";
} catch (Throwable $e) {
    echo "step 2 stopped\n";
}

// 3. A width of zero.
try {
    $small->resize({ width: 0 })->raw();
    echo "step 3 ran\n";
} catch (Throwable $e) {
    echo "step 3 stopped\n";
}

// 4. Many resizes in a row, each one growing the image again.
try {
    Image $growing = $small;
    uint $i = 0;
    while ($i < 40) {
        $growing = $growing->resize({ width: 64, upscale: true })->resize({ width: 4 });
        $i = $i + 1;
    }
    var $last = $growing->resize({ width: 100000, height: 100000, fit: Fit::Fill, upscale: true })->raw();
    echo 'step 4 ran ', $last->width, "\n";
} catch (Throwable $e) {
    echo "step 4 stopped\n";
}
