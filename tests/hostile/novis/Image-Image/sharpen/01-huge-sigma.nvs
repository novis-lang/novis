<?nvs
// Attack: a request sends a sharpen width so large that the step would take a very long time.
// Each attempt should throw an error, stop at a limit or return an image, and the server keeps running.
// hostile: timeout-ms 30000
use Novis\Image\Color;
use Novis\Image\Image;

Image $small = Image::create(64, 64, Color::hex('#336699'));

// 1. A `sigma` that is not a number.
try {
    $small->sharpen({ sigma: Core\Math::sqrt(-1.0) })->raw();
    echo "step 1 ran\n";
} catch (Throwable $e) {
    echo "step 1 stopped\n";
}

// 2. A `sigma` of zero.
try {
    $small->sharpen({ sigma: 0.0 })->raw();
    echo "step 2 ran\n";
} catch (Throwable $e) {
    echo "step 2 stopped\n";
}

// 3. A `sigma` of infinity.
try {
    $small->sharpen({ sigma: 1.0e308 * 10.0 })->raw();
    echo "step 3 ran\n";
} catch (Throwable $e) {
    echo "step 3 stopped\n";
}

// 4. A `sigma` of one million pixels.
try {
    $small->sharpen({ sigma: 1000000.0 })->raw();
    echo "step 4 ran\n";
} catch (Throwable $e) {
    echo "step 4 stopped\n";
}
