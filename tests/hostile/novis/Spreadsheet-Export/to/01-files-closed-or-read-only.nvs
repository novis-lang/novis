<?nvs
// Attack: a program writes exports and a filled template to files that are closed or open only for reading.
// It also closes a file while the rows are written. Each export should finish or throw an error.
use Novis\Spreadsheet\Template;
use Novis\Spreadsheet\Workbook;

class Attack
{
    public static ?Core\IO\File $shared = null;

    // This method runs one step and prints whether it ran or threw. Each error is caught, so the next step still runs.
    public static function attempt(int $step, callable(): void $write): void
    {
        try {
            $write();
            echo 'step ', $step, " ran\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }

    // This generator gives 1,500 rows, and closes the file the rows are written to after 1,000 of them.
    public static function rows(): Iterator<array<mixed>>
    {
        for (int $at = 0; $at < 1500; $at++) {
            if ($at == 1000) {
                self::$shared?->close();
            }
            yield ['order' => $at, 'note' => 'a row of the export'];
        }
    }
}

string $folder = Core\IO::temporaryDir();
string $path = Core\Path::join($folder, 'attack-export-to.xlsx');
var $design = Workbook::createInMemory();
$design->sheet('Invoice')->add(['{{shop}}']);
bytes $template = $design->finish()->bytes ?? Core\Bytes::fill(0, 0);

// 1. A file that is already closed, for an export and for a template.
Attack::attempt(1, fn(): void => {
    var $file = Core\IO::open($path, Core\IO::FileMode::Write);
    $file->close();
    Workbook::fromRows([['order' => 1]])->to($file);
});
Attack::attempt(1, fn(): void => {
    var $file = Core\IO::open($path, Core\IO::FileMode::Write);
    $file->close();
    Template::open($template)->fill(['shop' => 'Shop'])->to($file);
});

// 2. A file that is open only for reading.
Attack::attempt(2, fn(): void => {
    var $file = Core\IO::open($path, Core\IO::FileMode::Read);
    Workbook::fromRows([['order' => 2]])->to($file);
});

// 3. The file is closed while the rows are still being written.
Attack::attempt(3, fn(): void => {
    var $file = Core\IO::open($path, Core\IO::FileMode::Write);
    Attack::$shared = $file;
    Workbook::fromRows(Attack::rows())->to($file);
});

// 4. Two exports and a template written to the same open file, one after another.
Attack::attempt(4, fn(): void => {
    var $file = Core\IO::open($path, Core\IO::FileMode::Write);
    Workbook::fromRows([['order' => 4]])->to($file);
    Workbook::fromRows([['order' => 5]], { format: 'csv' })->to($file);
    Template::open($template)->fill(['shop' => 'Shop'])->to($file);
    $file->close();
});
Core\IO::remove($path);
