<?nvs
// Attack: a request writes very large lists and extreme numbers in the short form.
// Each call should return a list or throw an error, and the server keeps running.
// hostile: timeout-ms 20000
use Novis\Intl\CompactDisplay;
use Novis\Intl\NumberFormat;

// 1. An empty list.
try {
    echo 'step 1 ran ', Core\Arr::count(NumberFormat::compact([], 'de')), "\n";
} catch (Throwable $e) {
    echo "step 1 stopped\n";
}

// 2. Twenty thousand numbers in one call, in the long form.
try {
    array<int|float|decimal> $many = [];
    for (int $i = 0; $i < 20000; $i++) {
        $many[] = $i * 997;
    }
    echo 'step 2 ran ', Core\Arr::count(NumberFormat::compact($many, 'en', { display: CompactDisplay::Long })), "\n";
} catch (Throwable $e) {
    echo "step 2 stopped\n";
}

// 3. Numbers far larger than any short form, and far smaller than one.
try {
    array<int|float|decimal> $extreme = [1.7976931348623157e308, -1.7976931348623157e308, 5e-324, 9223372036854775807];
    echo 'step 3 ran ', Core\Arr::count(NumberFormat::compact($extreme, 'ja')), "\n";
} catch (Throwable $e) {
    echo "step 3 stopped\n";
}

// 4. A decimal with one hundred thousand digits.
try {
    decimal $long = Core\Str::repeat('9', 100000) as decimal;
    echo 'step 4 ran ', Core\Arr::count(NumberFormat::compact([$long], 'en')), "\n";
} catch (Throwable $e) {
    echo "step 4 stopped\n";
}

// 5. A number that is not finite.
try {
    NumberFormat::compact([Core\Math::INFINITY], 'en');
    echo "step 5 ran\n";
} catch (Throwable $e) {
    echo "step 5 stopped\n";
}

// 6. A bad locale tag a thousand times. Each call must still return or throw.
uint $stopped = 0;
for (int $j = 0; $j < 1000; $j++) {
    try {
        NumberFormat::compact([1234], 'en_US!');
    } catch (Throwable $e) {
        $stopped = $stopped + 1;
    }
}
echo 'step 6 stopped ', $stopped, "\n";
