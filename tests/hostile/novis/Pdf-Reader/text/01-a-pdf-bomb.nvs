<?nvs
// Attack: a request reads the text of pages built to loop, nest deeply or unpack a huge stream.
// Each read should return text, throw an error or stop at a limit. The server keeps running.
use Novis\Pdf\Reader;

class Forge
{
    // This method builds a PDF file from its objects, with a correct table of where each object starts.
    public static function pdf(array<bytes> $objects): bytes
    {
        array<bytes> $parts = ["%PDF-1.7\n" as bytes];
        array<int> $offsets = [];
        int $at = 9;
        int $n = 0;
        foreach ($objects as bytes $body) {
            $n = $n + 1;
            $offsets[] = $at;
            bytes $object = Core\Bytes::join(["{$n} 0 obj\n" as bytes, $body, "\nendobj\n" as bytes]);
            $parts[] = $object;
            $at = $at + Core\Bytes::length($object) as int;
        }
        string $table = "xref\n0 " . ($n + 1) as string . "\n0000000000 65535 f \n";
        foreach ($offsets as int $offset) {
            $table .= Core\Str::padStart($offset as string, 10, '0') . " 00000 n \n";
        }
        $parts[] = ($table . "trailer\n<< /Size " . ($n + 1) as string . " /Root 1 0 R >>\nstartxref\n{$at}\n%%EOF\n") as bytes;
        return Core\Bytes::join($parts);
    }

    // This method builds a PDF file with one page whose content is `$content`, written with `$filter`.
    public static function page(bytes $content, string $filter): bytes
    {
        uint $length = Core\Bytes::length($content);
        return self::pdf([
            '<< /Type /Catalog /Pages 2 0 R >>' as bytes,
            '<< /Type /Pages /Kids [3 0 R] /Count 1 >>' as bytes,
            '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Contents 4 0 R /Resources << /Font << /F1 5 0 R /F2 6 0 R >> /XObject << /X 6 0 R >> >> >>' as bytes,
            Core\Bytes::join(["<< /Length {$length}{$filter} >>\nstream\n" as bytes, $content, "\nendstream" as bytes]),
            '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>' as bytes,
            "<< /Type /XObject /Subtype /Form /BBox [0 0 200 200] /Length 7 >>\nstream\n/X Do q\nendstream" as bytes,
        ]);
    }
}

// 1. Page numbers that the file does not have: 0, 2 and the largest page number.
array<uint> $numbers = [0, 2, 4294967295];
foreach ($numbers as uint $number) {
    try {
        echo 'step 1 ran ', Reader::open(Forge::page('BT /F1 12 Tf (Shop) Tj ET' as bytes, ''))->text($number), "\n";
    } catch (Throwable $e) {
        echo "step 1 stopped\n";
    }
}

// 2. A page that draws a form, and the form draws itself.
try {
    echo 'step 2 ran ', Core\Str::length(Reader::open(Forge::page('/X Do' as bytes, ''))->text(1)), "\n";
} catch (Throwable $e) {
    echo "step 2 stopped\n";
}

// 3. A page that uses a font which is a form and not a font, at a size of one billion.
try {
    echo 'step 3 ran ', Core\Str::length(Reader::open(Forge::page('BT /F2 1000000000 Tf (Shop) Tj ET' as bytes, ''))->text(1)), "\n";
} catch (Throwable $e) {
    echo "step 3 stopped\n";
}

// 4. A page that shows the same word two hundred thousand times.
try {
    bytes $words = Core\Str::join(['BT /F1 12 Tf', Core\Str::repeat('(Shop) Tj ', 200000), 'ET'], ' ') as bytes;
    echo 'step 4 ran ', Core\Str::length(Reader::open(Forge::page($words, ''))->text(1)), "\n";
} catch (Throwable $e) {
    echo "step 4 stopped\n";
}

// 5. A page whose content is a small compressed stream that unpacks to 64 MB.
// It unpacks to more than 1000 times its packed size, so `text` throws a `ParseError`.
bytes $packed = Core\Compress::compress(Core\Str::repeat(' ', 67108864) as bytes, Core\Compress::Codec::Zlib);
try {
    echo 'step 5 ran ', Core\Str::length(Reader::open(Forge::page($packed, ' /Filter /FlateDecode'))->text(1)), "\n";
} catch (Throwable $e) {
    echo 'step 5 stopped ', $e::class, "\n";
}
