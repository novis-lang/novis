<?nvs
// Attack: a request renders page numbers that can move the pages they count, and links in a chain.
// Then it renders a table of 100000 rows with a memory limit of 64 MB.
// Each render should finish or throw an error. The last one should stop at the memory limit.
// hostile: ends-early 5 FATAL
use Novis\Pdf\Document;

class Attack
{
    // This method renders `$html` and prints the page count, or the class of the error.
    public static function attempt(int $step, string $html): void
    {
        try {
            var $rendered = Document::fromHtml($html)->render();
            echo 'step ', $step, ' ran ', $rendered->pageCount, "\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

string $number = '<style>@page { size: 60mm 40mm; margin: 2mm } body { font-size: 9pt } '
    . "a::after { content: leader('.') target-counter(attr(href), page) }</style>";

// 1. A table of contents just before its target. Each page number changes the length of the line,
//    which can move the target to the next page and change the number again.
for (uint $fill = 1; $fill <= 40; $fill++) {
    Attack::attempt(
        1,
        $number
            . Core\Str::repeat('<p>Shop</p>', $fill)
            . '<p>'
            . Core\Str::repeat('x', $fill * 3)
            . " <a href=\"#end\">end</a></p><p id=\"end\">The end</p>",
    );
}

// 2. 300 links in a chain, each pointing at the next, and one that points at itself.
string $chain = '';
for (int $n = 0; $n < 300; $n++) {
    $chain .= "<p id=\"l{$n}\"><a href=\"#l" . ($n + 1) as string . "\">next</a></p>";
}
Attack::attempt(2, $number . $chain . "<p id=\"me\"><a href=\"#me\">me</a></p>");

// 3. Links to an element that does not exist, to an empty name, and to a name of 1 MB.
Attack::attempt(3, $number . "<a href=\"#nowhere\">a</a><a href=\"#\">b</a><a href=\"\">c</a><a href=\"#" . Core\Str::repeat('z', 1000000) . "\">d</a>");

// 4. Page counters in two margin boxes, and a heading that starts a new page 500 times.
Attack::attempt(
    4,
    "<style>@page { @top-left { content: counter(page) ' of ' counter(pages) } "
        . '@bottom-right { content: counter(pages) counter(pages) counter(pages) } } h2 { break-before: page }</style>'
        . Core\Str::repeat('<h2>Part</h2>', 500),
);

// 5. A table of 100000 rows. It does not fit in 64 MB, so the render stops here.
echo "step 5\n";
string $rows = Core\Str::repeat('<tr><td>Order</td><td>Shop</td><td>12.50 EUR</td></tr>', 100000);
Attack::attempt(5, "<table><thead><tr><th>Order</th><th>Customer</th><th>Total</th></tr></thead><tbody>{$rows}</tbody></table>");
