<?nvs
// Attack: a request encrypts a statement with passwords that are empty, huge, or not plain text.
// Each render should make an encrypted file or throw an error. The server keeps running.
use Novis\Pdf\Document;

class Attack
{
    // This method renders a statement with `$password`, and prints whether the file is encrypted.
    public static function attempt(int $step, string $password): ?bytes
    {
        try {
            bytes $file = Document::fromHtml("<h1>Statement</h1><p>Balance: 10.00 EUR</p>")->password($password)->render()->bytes;
            echo "step ", $step, " ran ", Core\Bytes::contains($file, "/Encrypt" as bytes) ? "encrypted" : "plain", "\n";
            return $file;
        } catch (Throwable $e) {
            echo "step ", $step, " stopped ", $e::class, "\n";
            return null;
        }
    }
}

// 1. An empty password.
Attack::attempt(1, "");

// 2. A password of 10 MB.
Attack::attempt(2, Core\Str::repeat("p", 10000000));

// 3. NUL characters, line breaks and characters that change the direction of text.
Attack::attempt(3, "\u{0}\u{0}\n\r\u{202E}\u{200B}");

// 4. Letters that look the same but are different characters, and 1000 emoji.
Attack::attempt(4, "Ａｄａ\u{0130}\u{FB01}");
Attack::attempt(4, Core\Str::repeat("👨‍👩‍👧‍👦", 1000));

// 5. Two passwords that are the same for their first 127 bytes and differ after that.
//    A reader uses only the first 127 bytes, so the two files may be the same.
?bytes $first = Attack::attempt(5, Core\Str::repeat("a", 127) . "one");
?bytes $second = Attack::attempt(5, Core\Str::repeat("a", 127) . "two");
echo "step 5 ", $first == $second ? "same" : "different", "\n";

// 6. A password that looks like PDF syntax.
Attack::attempt(6, ") >> /Encrypt null /Filter /Standard (");
