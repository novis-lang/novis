<?nvs
// Attack: a request attaches invoice XML that expands to ten billion words, reads a file on the server,
// or is far too large. Each render should throw an error or attach the XML unchanged.
// The last render should stop at the memory limit. The server keeps running.
// hostile: ends-early 7 FATAL
use Novis\Pdf\Document;
use Novis\Pdf\Reader;

class Attack
{
    // This method renders an invoice with `$xml` attached, and prints its size or the error.
    public static function attempt(int $step, string $xml): void
    {
        try {
            var $rendered = Document::fromHtml("<html lang=\"en\"><head><title>Shop</title></head><body><p>Invoice</p></body></html>")
                ->standard(Document::Standard::PdfA3b)
                ->created(Core\Time::fromIso('2026-01-01T00:00:00Z'))
                ->invoiceXml($xml)
                ->render();
            ?string $back = Reader::open($rendered->bytes)->invoiceXml();
            echo 'step ', $step, ' ran ', $back == $xml ? 'unchanged' : 'changed', "\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

string $root = "<rsm:CrossIndustryInvoice xmlns:rsm=\"urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100\">";

// 1. Ten levels of entities. Each level repeats the level below ten times.
string $entities = "<!ENTITY lol0 \"lol\">";
for (int $level = 1; $level <= 10; $level++) {
    $entities .= "<!ENTITY lol{$level} \"" . Core\Str::repeat('&lol' . ($level - 1) as string . ';', 10) . "\">";
}
Attack::attempt(1, "<?xml version=\"1.0\"?><!DOCTYPE rsm:CrossIndustryInvoice [{$entities}]>{$root}&lol10;</rsm:CrossIndustryInvoice>");

// 2. An entity that reads a file on the server, and one that loads an address in the cloud.
Attack::attempt(2, "<?xml version=\"1.0\"?><!DOCTYPE x [<!ENTITY secret SYSTEM \"file:///etc/passwd\">]>{$root}&secret;</rsm:CrossIndustryInvoice>");
Attack::attempt(2, "<?xml version=\"1.0\"?><!DOCTYPE x SYSTEM \"http://169.254.169.254/latest/meta-data/\">{$root}</rsm:CrossIndustryInvoice>");

// 3. A parameter entity that defines itself again inside the document type.
Attack::attempt(3, "<?xml version=\"1.0\"?><!DOCTYPE x [<!ENTITY % a \"<!ENTITY &#37; a 'x'>\"> %a; %a;]>{$root}</rsm:CrossIndustryInvoice>");

// 4. 100000 elements, each inside the one before it.
Attack::attempt(4, $root . Core\Str::repeat('<a>', 100000) . Core\Str::repeat('</a>', 100000) . '</rsm:CrossIndustryInvoice>');

// 5. A guideline id of 1 MB, which the render reads to find the profile.
Attack::attempt(
    5,
    $root
        . '<rsm:ExchangedDocumentContext><ram:GuidelineSpecifiedDocumentContextParameter '
        . "xmlns:ram=\"urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100\"><ram:ID>"
        . Core\Str::repeat('urn:factur-x.eu:', 65536)
        . '</ram:ID></ram:GuidelineSpecifiedDocumentContextParameter>'
        . '</rsm:ExchangedDocumentContext></rsm:CrossIndustryInvoice>',
);

// 6. An empty string, and XML that ends in the middle of a tag.
Attack::attempt(6, '');
Attack::attempt(6, $root . '<rsm:Exch');

// 7. 60 MB of text in one element. The render runs out of memory, so this is the last step.
echo "step 7\n";
Attack::attempt(7, $root . Core\Str::repeat('x', 60000000) . '</rsm:CrossIndustryInvoice>');
