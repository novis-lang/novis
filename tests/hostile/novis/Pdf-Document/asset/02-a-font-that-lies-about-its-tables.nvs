<?nvs
// Attack: a request adds font files whose table of contents lies: tables past the end of the file,
// tables of 2 GB and tables on top of each other. Each render should throw an error or draw the text.
use Novis\Pdf\Document;

class Attack
{
    // This method renders a paragraph in the font `$font`, and prints the page count or the error.
    public static function attempt(int $step, bytes $font): void
    {
        try {
            var $rendered = Document::fromHtml(
                '<style>@font-face { font-family: Shop; src: url(shop.ttf) } '
                    . 'p { font-family: Shop }</style><p>Shop 1042</p>',
            )
                ->asset('shop.ttf', $font)
                ->render();
            echo 'step ', $step, ' ran ', $rendered->pageCount, ' ', Core\Arr::count($rendered->missingGlyphs), "\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

// The start of a TrueType file: the version and the number of tables.
string $start = '00010000' . '0004' . '0040' . '0002' . '0000';

// 1. A `head` table past the end of the file, a `cmap` table of 2 GB, and a `maxp` table on top of the header.
Attack::attempt(1, Core\Encoding::fromHex(
    $start
        . '68656164'
        . '00000000'
        . 'ffffff00'
        . '00000036'
        . '636d6170'
        . '00000000'
        . '0000004c'
        . '7fffffff'
        . '676c7966'
        . '00000000'
        . '0000004c'
        . '00000010'
        . '6d617870'
        . '00000000'
        . '00000000'
        . '00000006'
        . Core\Str::repeat('ff', 64),
));

// 2. A file that says it has 65535 tables and has none.
Attack::attempt(2, Core\Encoding::fromHex('00010000ffff00000000000000'));

// 3. An OpenType file that is only its first four bytes.
Attack::attempt(3, Core\Encoding::fromHex('4f54544f'));

// 4. A font collection that names 1 million fonts at offsets past the end.
Attack::attempt(4, Core\Encoding::fromHex('74746366' . '00010000' . '000f4240' . Core\Str::repeat('7ffffff0', 16)));

// 5. A WOFF2 file whose sizes are all at their largest value.
Attack::attempt(5, Core\Encoding::fromHex('774f4632' . '00010000' . 'ffffffff' . 'ffff' . '0000' . 'ffffffff' . Core\Str::repeat('ff', 32)));

// 6. An empty file, and a file of 1 MB of zero bytes.
Attack::attempt(6, '' as bytes);
Attack::attempt(6, Core\Bytes::repeat(Core\Encoding::fromHex('00'), 1048576));
