<?nvs
// Attack: a request renders documents that break each PDF standard in many ways at once.
// Each render should make a valid file or throw a `LogicError`. The server keeps running.
use Novis\Pdf\Document;

class Attack
{
    // This method renders `$html` under `$standard`, and prints the page count or the error.
    public static function attempt(int $step, string $html, Document::Standard $standard): void
    {
        try {
            var $rendered = Document::fromHtml($html)
                ->standard($standard)
                ->created(Core\Time::fromIso('2026-01-01T00:00:00Z'))
                ->render();
            echo 'step ', $step, ' ran ', $rendered->pageCount, "\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

array<Document::Standard> $standards = [Document::Standard::PdfA2b, Document::Standard::PdfA3b, Document::Standard::PdfUa1];
string $image = "<img src=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='4' height='4'/>\">";

foreach ($standards as Document::Standard $standard) {
    // 1. 2000 images without `alt` text, and no title.
    Attack::attempt(1, Core\Str::repeat($image, 2000), $standard);

    // 2. Characters that no font has, in the title and in the text.
    Attack::attempt(2, "<html lang=\"en\"><head><title>𓀀𓀁</title></head><body><p>𓀀 \u{FFFF} \u{E000}</p></body></html>", $standard);

    // 3. A title of 1 MB, a language that does not exist, and text that changes direction.
    Attack::attempt(
        3,
        "<html lang=\""
            . Core\Str::repeat('x', 1000)
            . "\"><head><title>"
            . Core\Str::repeat('T', 1000000)
            . "</title></head><body><p dir=\"rtl\">\u{202E}Shop\u{202C}</p></body></html>",
        $standard,
    );

    // 4. A heading of every level in the wrong order, and a table with header cells everywhere.
    Attack::attempt(
        4,
        "<html lang=\"en\"><head><title>Shop</title></head><body><h6>a</h6><h1>b</h1><h3>c</h3>"
            . Core\Str::repeat('<table><tr><th><th><th></tr></table>', 500)
            . '</body></html>',
        $standard,
    );

    // 5. A transparent image and a link with JavaScript, which PDF/A does not allow.
    Attack::attempt(
        5,
        "<html lang=\"en\"><head><title>Shop</title></head><body><p style=\"opacity: 0.1\">x</p>"
            . "<a href=\"javascript:alert(1)\">pay</a></body></html>",
        $standard,
    );
}
