<?nvs
// Attack: a request gives pie charts ranges whose sheet names have quotes, markup or no name at all.
// Each name should be written as text or throw an error, and the XML of the chart should stay valid.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

class Attack
{
    // This method adds a pie of `$values` at D2 and prints whether the file was written, or the class of the error.
    public static function attempt(int $step, string $values, ?string $categories): void
    {
        try {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Shops');
            $sheet->addAll([['shop' => 'North', 'sales' => 340], ['shop' => 'South', 'sales' => 210]]);
            $sheet->chart('D2', Chart::pie()->series($values, { categories: $categories ?? 'A2:A3' }));
            bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);
            echo 'step ', $step, ' wrote ', Core\Bytes::length($file) > 0 ? 'a file' : 'nothing', "\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

// 1. Sheet names with a quote, with two quotes, and with a quote that is not closed.
Attack::attempt(1, "'O''Brien'!B2:B3", null);
Attack::attempt(1, "'Shop'!'B2:B3", null);
Attack::attempt(1, "'Shops!B2:B3", null);

// 2. An empty sheet name, a name that is only a mark, and a name with markup.
Attack::attempt(2, '!B2:B3', null);
Attack::attempt(2, "''!B2:B3", null);
Attack::attempt(2, '</c:f><c:f>Shops!B2:B3', '<x/>!A2:A3');

// 3. A name of 10,000 characters and a name with a newline and control characters.
Attack::attempt(3, Core\Str::repeat('S', 10000) . '!B2:B3', null);
Attack::attempt(3, "'Sh\nops\u{0}'!B2:B3", "'" . Core\Str::fromCodePoint(27) . "'!A2:A3");

// 4. Many marks in one range.
Attack::attempt(4, 'Shops!Shops!B2:B3', 'a!b!c!A2:A3');
