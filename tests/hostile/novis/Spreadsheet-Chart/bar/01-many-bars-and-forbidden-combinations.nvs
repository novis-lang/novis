<?nvs
// Attack: a request builds bar charts with very many series and bars, and combines bars with other types.
// The charts should be written, and each combination with bars should throw an error.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

class Attack
{
    // This method adds `$chart` at E2 of a sheet of `$rows` rows and prints whether the file was written, or the class of the error.
    public static function attempt(int $step, Chart $chart, int $rows): void
    {
        try {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Shop');
            for (int $n = 1; $n <= $rows; $n++) {
                $sheet->add(['shop' => "Shop {$n}", 'sales' => $n]);
            }
            $sheet->chart('E2', $chart);
            bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);
            echo 'step ', $step, ' wrote ', Core\Bytes::length($file) > 0 ? 'a file' : 'nothing', "\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

// 1. A bar chart with 2,000 series of the same range.
var $many = Chart::bar();
for (int $n = 0; $n < 2000; $n++) {
    $many = $many->series('B2:B3', { name: "Bar {$n}" });
}
Attack::attempt(1, $many, 2);

// 2. A bar chart over 20,000 rows, with a range that covers every row of the sheet.
Attack::attempt(2, Chart::bar()->series('B1:B1048576', { categories: 'A1:A1048576' }), 20000);

// 3. Bars combined with columns, with a line, and with a column chart that is combined with bars.
Attack::attempt(3, Chart::bar()->series('B2:B3')->combine(Chart::column()->series('B2:B3')), 2);
Attack::attempt(3, Chart::bar()->series('B2:B3')->combine(Chart::line()->series('B2:B3')), 2);
Attack::attempt(3, Chart::column()->series('B2:B3')->combine(Chart::bar()->series('B2:B3')), 2);
