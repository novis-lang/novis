<?nvs
// Attack: a program opens a workbook from a file, lists its sheets, and then another handle changes
// the file before `rows` reads it. Each `rows` call should throw an error, and the file opened
// again should give the new content or a `ParseError`.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

class Attack
{
    // This method reads every row of the first sheet and prints how many rows it read, or the class of the error.
    public static function read(int $step, Reader $reader): void
    {
        try {
            int $count = 0;
            foreach ($reader->rows(0) as var $row) {
                $count++;
            }
            echo 'step ', $step, ' read ', $count, " rows\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }

    // This method opens the file again and prints how many sheets it has, or the class of the error.
    public static function open(int $step, Core\IO\File $file): void
    {
        try {
            uint $sheets = Core\Arr::count(Reader::open($file)->sheets());
            echo 'step ', $step, ' opened ', $sheets, " sheets\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }

    // This method replaces everything in the file with `$content`.
    public static function replace(Core\IO\File $file, bytes $content): void
    {
        $file->truncate(0);
        $file->seek(0);
        $file->write($content);
    }
}

// Two workbooks. The first has 1,000 rows on one sheet. The second has 3 sheets with one row each.
var $long = Workbook::createInMemory();
var $sheet = $long->sheet('Shop');
for (int $n = 0; $n < 1000; $n++) {
    $sheet->add([$n, "item {$n}"]);
}
bytes $first = $long->finish()->bytes ?? Core\Bytes::fill(0, 0);
var $short = Workbook::createInMemory();
$short->sheet('Blog')->add(['one']);
$short->sheet('News')->add(['two']);
$short->sheet('Shop')->add(['three']);
bytes $second = $short->finish()->bytes ?? Core\Bytes::fill(0, 0);

string $dir = Core\Path::join(Core\IO::temporaryDir(), 'attack-sheet-changes');
Core\IO::makeDir($dir);
string $path = Core\Path::join($dir, 'upload.xlsx');
Core\IO::write($path, $first);
Core\IO\File $file = Core\IO::open($path, Core\IO::FileMode::Read);
Core\IO\File $writer = Core\IO::open($path, Core\IO::FileMode::ReadWrite);

// 1. The file is replaced with the second workbook after `sheets`, and before `rows`.
Reader $reader = Reader::open($file);
echo 'sheets: ', Core\Arr::count($reader->sheets()), "\n";
Attack::replace($writer, $second);
Attack::read(1, $reader);
Attack::open(1, $file);

// 2. The file loses its last 2,000 bytes after `sheets`. Then the file is opened again.
Attack::replace($writer, $first);
$reader = Reader::open($file);
$reader->sheets();
$writer->truncate(Core\Bytes::length($first) - 2000);
Attack::read(2, $reader);
Attack::open(2, $file);

// 3. The file is emptied after `sheets`. Then the file is opened again.
Attack::replace($writer, $first);
$reader = Reader::open($file);
$reader->sheets();
$writer->truncate(0);
Attack::read(3, $reader);
Attack::open(3, $file);

// 4. The file is replaced with CSV text after `sheets`. Then the file is opened again.
Attack::replace($writer, $first);
$reader = Reader::open($file);
$reader->sheets();
Attack::replace($writer, Core\Str::repeat("a,b\n", 1000) as bytes);
Attack::read(4, $reader);
Attack::open(4, $file);

$file->close();
$writer->close();
Core\IO::remove($path);
Core\IO::removeDir($dir);
