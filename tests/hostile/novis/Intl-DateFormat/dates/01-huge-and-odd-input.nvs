<?nvs
// Attack: a request formats very many dates, the first and last possible dates, odd calendars
// and broken locale tags. Each call should return a list or throw an error.
// hostile: timeout-ms 20000
use Novis\Intl\DateFormat;
use Novis\Intl\Length;

// 1. An empty list.
try {
    echo 'step 1 ran ', Core\Arr::count(DateFormat::dates([], 'en')), "\n";
} catch (Throwable $e) {
    echo "step 1 stopped\n";
}

// 2. Twenty thousand dates in one call.
try {
    array<Core\Time\Date> $dates = [];
    for (uint $i = 0; $i < 20000; $i++) {
        $dates[] = Core\Time\Date::at($i % 2 == 0 ? 1900 : 2100, 1 + $i % 12, 1 + $i % 28);
    }
    echo 'step 2 ran ', Core\Arr::count(DateFormat::dates($dates, 'fr', { length: Length::Long })), "\n";
} catch (Throwable $e) {
    echo "step 2 stopped\n";
}

// 3. The first and the last year a date can have, in a calendar that counts years differently.
try {
    array<Core\Time\Date> $edges = [Core\Time\Date::at(1, 1, 1), Core\Time\Date::at(9999, 12, 31)];
    echo 'step 3 ran ', Core\Arr::count(DateFormat::dates($edges, 'ja-u-ca-japanese', { length: Length::Long })), "\n";
} catch (Throwable $e) {
    echo "step 3 stopped\n";
}

// 4. A locale tag of ten thousand characters.
try {
    DateFormat::dates([Core\Time\Date::at(2026, 3, 1)], 'de' . Core\Str::repeat('-abcdefgh', 1000));
    echo "step 4 ran\n";
} catch (Throwable $e) {
    echo "step 4 stopped\n";
}

// 5. A bad locale tag a thousand times. Each call must still return or throw.
uint $stopped = 0;
for (int $j = 0; $j < 1000; $j++) {
    try {
        DateFormat::dates([Core\Time\Date::at(2026, 3, 1)], '');
    } catch (Throwable $e) {
        $stopped = $stopped + 1;
    }
}
echo 'step 5 stopped ', $stopped, "\n";
