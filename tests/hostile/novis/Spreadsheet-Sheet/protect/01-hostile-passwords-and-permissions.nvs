<?nvs
// Attack: a request locks a sheet with hostile passwords and permission names, and locks it many times.
// `protect` should keep no password text in the file, and throw an error for a permission that does not exist.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

class Attack
{
    // This method locks a new sheet, then prints whether the password text is in the file and whether its rows read back.
    public static function attempt(int $step, string $password, array<string> $allow): void
    {
        try {
            var $book = Workbook::createInMemory();
            $book->sheet('Shop')->protect({ password: $password, allow: $allow })->add(['Order']);
            bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);
            var $xml = Core\Zip::read($file, 'xl/worksheets/sheet1.xml') as string;
            bool $kept = $password != '' && Core\Str::contains($xml, $password);
            uint $rows = 0;
            foreach (Reader::open($file)->rows('Shop') as var $row) {
                $rows = $rows + 1;
            }
            echo 'step ', $step, ' kept the password: ', $kept ? 'yes' : 'no', ', read ', $rows, " row\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

// 1. A password with markup, an empty password, and a password of 100,000 characters.
Attack::attempt(1, '"/><sheetProtection sheet="0', []);
Attack::attempt(1, '', []);
Attack::attempt(1, Core\Str::repeat('p', 100000), []);

// 2. A password of letters outside English, and one with a zero byte.
Attack::attempt(2, 'Pässwörd-日本', []);
Attack::attempt(2, "pass\u{0}word", []);

// 3. Permissions that do not exist, with markup, and in other letter case.
Attack::attempt(3, 'secret', ['everything']);
Attack::attempt(3, 'secret', ['sort"/><x a="']);
Attack::attempt(3, 'secret', ['SORT']);

// 4. Every permission twice, and the same sheet locked 1,000 times.
Attack::attempt(4, 'secret', ['sort', 'sort', 'autoFilter', 'autoFilter']);
var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Shop');
for (int $n = 0; $n < 1000; $n++) {
    $sheet->protect({ password: "secret{$n}" });
}
$sheet->add(['Order']);
echo 'step 4 wrote ', Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0)) > 0 ? 'a file' : 'nothing', "\n";
