<?nvs
// Attack: a request asks for the place category of very large lists, extreme numbers and broken
// locale tags. Each call should return a list or throw an error, and the server keeps running.
// hostile: timeout-ms 20000
use Novis\Intl\PluralRules;

// 1. An empty list.
try {
    echo 'step 1 ran ', Core\Arr::count(PluralRules::ordinal([], 'en')), "\n";
} catch (Throwable $e) {
    echo "step 1 stopped\n";
}

// 2. Twenty thousand places in one call.
try {
    array<int|float|decimal> $many = [];
    for (int $i = 0; $i < 20000; $i++) {
        $many[] = $i;
    }
    echo 'step 2 ran ', Core\Arr::count(PluralRules::ordinal($many, 'cy')), "\n";
} catch (Throwable $e) {
    echo "step 2 stopped\n";
}

// 3. Places that are negative, have a fraction, or are very large.
try {
    array<int|float|decimal> $odd = [-1, 2.5, 9223372036854775807, 1e300];
    echo 'step 3 ran ', Core\Arr::count(PluralRules::ordinal($odd, 'en')), "\n";
} catch (Throwable $e) {
    echo "step 3 stopped\n";
}

// 4. A number that is not finite.
try {
    PluralRules::ordinal([Core\Math::INFINITY], 'en');
    echo "step 4 ran\n";
} catch (Throwable $e) {
    echo "step 4 stopped\n";
}

// 5. A locale tag of ten thousand characters.
try {
    PluralRules::ordinal([1], Core\Str::repeat('x-', 5000));
    echo "step 5 ran\n";
} catch (Throwable $e) {
    echo "step 5 stopped\n";
}

// 6. A bad locale tag a thousand times. Each call must still return or throw.
uint $stopped = 0;
for (int $j = 0; $j < 1000; $j++) {
    try {
        PluralRules::ordinal([1], '');
    } catch (Throwable $e) {
        $stopped = $stopped + 1;
    }
}
echo 'step 6 stopped ', $stopped, "\n";
