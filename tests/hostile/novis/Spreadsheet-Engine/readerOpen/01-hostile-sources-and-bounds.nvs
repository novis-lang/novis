<?nvs
// Attack: a request calls `Engine::readerOpen` directly with sources that are not workbooks, and with bounds of zero.
// Each call should open the workbook or throw an error, and no call should read past its bounds.
use Novis\Spreadsheet\Engine;
use Novis\Spreadsheet\Workbook;

class Attack
{
    // This method opens `$source` with the two bounds and prints how many sheets it has, or the class of the error.
    public static function attempt(int $step, mixed $source, ?uint $maxBytes, ?uint $maxRatio): void
    {
        try {
            var $reader = Engine::readerOpen($source, { maxBytes: $maxBytes, maxRatio: $maxRatio });
            echo 'step ', $step, ' ran ', Core\Arr::count(Engine::readerSheets($reader, $source)), " sheets\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

bytes $good = Workbook::fromRows([['item' => 'Widget', 'price' => 2.5]], { sheet: 'Shop' })->bytes();
array<array<mixed>> $same = [];
for (int $at = 0; $at < 2000; $at++) {
    $same[] = ['item' => Core\Str::repeat('a', 1000)];
}
bytes $packed = Workbook::fromRows($same, { sheet: 'Shop' })->bytes();

// 1. Sources that are not `bytes` or a file: text, a number, `null` and an array.
Attack::attempt(1, 'Shop', null, null);
Attack::attempt(1, 42, null, null);
Attack::attempt(1, null, null, null);
Attack::attempt(1, [$good], null, null);

// 2. A good workbook with bounds of zero and one.
Attack::attempt(2, $good, 0, 0);
Attack::attempt(2, $good, 1, null);
Attack::attempt(2, $good, null, 1);

// 3. A workbook whose sheet is two million letters `a`, which compresses very well, read with a ratio bound of 10.
Attack::attempt(3, $packed, null, 10);
Attack::attempt(3, $packed, 1000, null);

// 4. No bytes, a zip file header alone, and a workbook without its last 1,500 bytes.
Attack::attempt(4, Core\Bytes::fill(0, 0), null, null);
Attack::attempt(4, 'PK' as bytes, null, null);
Attack::attempt(4, Core\Bytes::slice($good, 0, Core\Bytes::length($good) as int - 1500), null, null);

// 5. The largest bounds a `uint` can have, and the good workbook with no bounds last.
Attack::attempt(5, $good, 18446744073709551615, 18446744073709551615);
Attack::attempt(5, $good, null, null);
