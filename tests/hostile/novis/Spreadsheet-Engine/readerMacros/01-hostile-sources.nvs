<?nvs
// Attack: a request calls `Engine::readerMacros` directly with sources that `Reader::macros` never sends.
// Each call should return the names of the macro modules or throw an error, and no macro should run.
use Novis\Spreadsheet\Engine;
use Novis\Spreadsheet\Reading;
use Novis\Spreadsheet\Workbook;

class Attack
{
    // This method prints how many macro modules there are, or the class of the error.
    public static function attempt(int $step, Reading $reader, mixed $source): void
    {
        try {
            echo 'step ', $step, ' ran ', Core\Arr::count(Engine::readerMacros($reader, $source)), " modules\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

bytes $file = Workbook::fromRows([['item' => 'Widget', 'price' => 2.5]], { sheet: 'Shop' })->bytes();
Reading $reader = Engine::readerOpen($file, { maxBytes: null, maxRatio: null });

// 1. Sources that are not `bytes` or a file: text, a number and `null`.
Attack::attempt(1, $reader, 'Shop');
Attack::attempt(1, $reader, 42);
Attack::attempt(1, $reader, null);

// 2. A source that is not the one the reader opened: another workbook, no bytes, and the file cut short.
Attack::attempt(2, $reader, Workbook::fromRows([['title' => 'Post']], { sheet: 'Blog' })->bytes());
Attack::attempt(2, $reader, Core\Bytes::fill(0, 0));
Attack::attempt(2, $reader, Core\Bytes::slice($file, 0, 2000));

// 3. Bytes that start like an old xls file and then stop, given as the source of an xlsx reader.
Attack::attempt(3, $reader, Core\Bytes::join([Core\Encoding::fromHex('d0cf11e0a1b11ae1'), Core\Bytes::fill(504, 0)]));

// 4. The real file, read 1,000 times.
for (int $count = 0; $count < 1000; $count++) {
    Engine::readerMacros($reader, $file);
}
Attack::attempt(4, $reader, $file);
