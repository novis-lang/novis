<?nvs
// Attack: a request calls `Engine::readerImages` directly with sheet names and sources that `Reader::images` never sends.
// Each call should return the pictures or throw an error, and no call should fetch a picture from outside the file.
use Novis\Spreadsheet\Engine;
use Novis\Spreadsheet\Reading;
use Novis\Spreadsheet\Workbook;

class Attack
{
    // This method returns a workbook with 200 pictures on its sheet `Shop`, and a second sheet `Blog`.
    public static function book(): bytes
    {
        bytes $png = Core\Encoding::fromBase64('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==');
        var $book = Workbook::createInMemory();
        var $sheet = $book->sheet('Shop');
        for (int $row = 1; $row <= 200; $row++) {
            $sheet->add(['Widget']);
            $sheet->image('B' . $row as string, $png);
        }
        $book->sheet('Blog')->add(['Post']);
        return $book->finish()->bytes ?? Core\Bytes::fill(0, 0);
    }

    // This method prints how many pictures the sheet has, or the class of the error.
    public static function attempt(int $step, Reading $reader, mixed $source, string $sheet): void
    {
        try {
            var $images = Engine::readerImages($reader, $source, $sheet);
            echo 'step ', $step, ' ran ', Core\Arr::count($images), " pictures\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

bytes $file = Attack::book();
Reading $reader = Engine::readerOpen($file, { maxBytes: null, maxRatio: null });

// 1. Sheet names the workbook does not have: an empty name, a name with a NUL byte, and paths of parts inside the file.
Attack::attempt(1, $reader, $file, '');
Attack::attempt(1, $reader, $file, "Shop\u{0}");
Attack::attempt(1, $reader, $file, 'xl/media/image1.png');
Attack::attempt(1, $reader, $file, '../../xl/workbook.xml');

// 2. Sources that are not `bytes` or a file.
Attack::attempt(2, $reader, 'Shop', 'Shop');
Attack::attempt(2, $reader, 42, 'Shop');

// 3. A source that is not the one the reader opened: another workbook, no bytes, and the file cut short.
Attack::attempt(3, $reader, Workbook::fromRows([['title' => 'Post']], { sheet: 'Shop' })->bytes(), 'Shop');
Attack::attempt(3, $reader, Core\Bytes::fill(0, 0), 'Shop');
Attack::attempt(3, $reader, Core\Bytes::slice($file, 0, 2000), 'Shop');

// 4. The real sheets, read 100 times each.
for (int $count = 0; $count < 100; $count++) {
    Engine::readerImages($reader, $file, 'Shop');
}
Attack::attempt(4, $reader, $file, 'Shop');
Attack::attempt(4, $reader, $file, 'Blog');
