<?nvs
// Attack: a request calls `Engine::readerProperties` directly with sources that `Reader::properties` never sends.
// Each call should return the properties or throw an error, and a title that looks like XML should come back as text.
use Novis\Spreadsheet\Engine;
use Novis\Spreadsheet\Reading;
use Novis\Spreadsheet\Workbook;

class Attack
{
    // This method prints the title, or the class of the error.
    public static function attempt(int $step, Reading $reader, mixed $source): void
    {
        try {
            var $found = Engine::readerProperties($reader, $source);
            echo 'step ', $step, ' ran, the title is ', $found->title ?? 'null', "\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

var $book = Workbook::createInMemory({ properties: { title: '</dc:title><evil/>', author: Core\Str::repeat('a', 100000), created: Core\Time::fromEpoch(0) } });
$book->sheet('Shop')->add(['Widget', 2.5]);
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);
Reading $reader = Engine::readerOpen($file, { maxBytes: null, maxRatio: null });

// 1. Sources that are not `bytes` or a file: text, a number and `null`.
Attack::attempt(1, $reader, 'Shop');
Attack::attempt(1, $reader, 42);
Attack::attempt(1, $reader, null);

// 2. A source that is not the one the reader opened: another workbook, no bytes, and the file cut short.
Attack::attempt(2, $reader, Workbook::fromRows([['title' => 'Post']], { sheet: 'Blog' })->bytes());
Attack::attempt(2, $reader, Core\Bytes::fill(0, 0));
Attack::attempt(2, $reader, Core\Bytes::slice($file, 0, 2000));

// 3. The real file, read once and then 1,000 times more. Its author is 100,000 letters.
Attack::attempt(3, $reader, $file);
try {
    for (int $count = 0; $count < 1000; $count++) {
        Engine::readerProperties($reader, $file);
    }
    echo "step 3 ran 1,000 times\n";
} catch (Throwable $e) {
    echo 'step 3 stopped ', $e::class, "\n";
}
