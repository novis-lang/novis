<?nvs
// Attack: a request calls `Engine::templateOpen` directly with sources that are not templates, and with bounds of zero.
// Each call should open the template or throw an error.
use Novis\Spreadsheet\Engine;
use Novis\Spreadsheet\Workbook;

class Attack
{
    // This method opens `$source` as a template with the two bounds, or prints the class of the error.
    public static function attempt(int $step, mixed $source, ?uint $maxBytes, ?uint $maxRatio): void
    {
        try {
            Engine::templateOpen($source, { maxBytes: $maxBytes, maxRatio: $maxRatio });
            echo 'step ', $step, " ran\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

var $design = Workbook::createInMemory();
$design->sheet('Shop')->addAll([['{{note}}', '{{customer.name}}'], ['{{items.name}}', '{{items.qty}}']]);
bytes $template = $design->finish()->bytes ?? Core\Bytes::fill(0, 0);

// 1. Sources that are not `bytes` or a file: text, a number, `null` and an array.
Attack::attempt(1, '{{note}}', null, null);
Attack::attempt(1, 42, null, null);
Attack::attempt(1, null, null, null);
Attack::attempt(1, [$template], null, null);

// 2. A good template with bounds of zero and one.
Attack::attempt(2, $template, 0, 0);
Attack::attempt(2, $template, 1, null);
Attack::attempt(2, $template, null, 1);

// 3. A CSV file, no bytes, and a template without its last 1,500 bytes.
Attack::attempt(3, "{{note}},{{items.name}}\n" as bytes, null, null);
Attack::attempt(3, Core\Bytes::fill(0, 0), null, null);
Attack::attempt(3, Core\Bytes::slice($template, 0, Core\Bytes::length($template) as int - 1500), null, null);

// 4. 500 templates opened in one request and never filled, and the good template last.
for (int $count = 0; $count < 500; $count++) {
    Engine::templateOpen($template, { maxBytes: null, maxRatio: null });
}
Attack::attempt(4, $template, null, null);
