<?nvs
// Attack: a request calls `Engine::writerDefine` directly with names and references that `Workbook::define` never sends.
// Each name should be written as escaped text or throw an error.
use Novis\Spreadsheet\Engine;
use Novis\Spreadsheet\Visibility;
use Novis\Spreadsheet\Writer;

class Attack
{
    // This method opens a workbook with one sheet named `Shop`.
    public static function writer(): Writer
    {
        Writer $writer = Engine::writerOpen({ properties: { title: null, subject: null, author: null, company: null, keywords: null, created: null }, target: 'Shop.xlsx' });
        Engine::writerSheet($writer, {
            name: 'Shop',
            position: null,
            visibility: Visibility::Visible,
            columns: [],
            freezeRows: 0,
            freezeColumns: 0,
            autofilter: null,
            tabColor: null,
            zoom: null,
            gridlines: true,
            rightToLeft: false,
            header: { defaultStyle: false, style: null, freeze: false, filter: false },
            newSheetOnOverflow: false,
        }, []);
        return $writer;
    }

    // This method gives `$reference` the name `$name` in a new workbook and finishes it.
    // It prints whether `xl/workbook.xml` has the text `<evil/>` unescaped, or the class of the error.
    public static function attempt(int $step, string $name, string $reference): void
    {
        try {
            Writer $writer = Attack::writer();
            Engine::writerDefine($writer, $name, $reference);
            bytes $last = Engine::writerFinish($writer)->data;
            echo 'step ', $step, ' ran', Core\Str::contains(Core\Zip::read($last, 'xl/workbook.xml') as string, '<evil/>') ? ', raw text' : '', "\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

// 1. A name and a reference that close the XML element.
Attack::attempt(1, '"/><evil/>', 'Shop!$A$1');
Attack::attempt(1, 'Rate', '</definedName><evil/>');

// 2. Names Excel does not allow: an empty name, a cell address, `R1C1` and a name with a space.
Attack::attempt(2, '', 'Shop!$A$1');
Attack::attempt(2, 'B2', 'Shop!$A$1');
Attack::attempt(2, 'R1C1', 'Shop!$A$1');
Attack::attempt(2, 'Shop Rate', 'Shop!$A$1');

// 3. A name of 1,000 letters, and a reference of 100,000 letters.
Attack::attempt(3, Core\Str::repeat('a', 1000), 'Shop!$A$1');
Attack::attempt(3, 'Rate', Core\Str::repeat('a', 100000));

// 4. A formula that calls a program outside the workbook, as the reference.
Attack::attempt(4, 'Rate', "cmd|' /C calc'!A0");

// 5. The same name twice, 10,000 names in one workbook, and a name after the workbook is finished.
Attack::attempt(5, 'Rate', 'Shop!$A$1');
try {
    Writer $many = Attack::writer();
    Engine::writerDefine($many, 'Rate', 'Shop!$A$1');
    Engine::writerDefine($many, 'RATE', 'Shop!$A$2');
    echo "step 5 ran the same name twice\n";
} catch (Throwable $e) {
    echo 'step 5 stopped ', $e::class, "\n";
}
try {
    Writer $names = Attack::writer();
    for (int $at = 0; $at < 10000; $at++) {
        Engine::writerDefine($names, 'Rate' . $at as string, 'Shop!$A$1');
    }
    echo 'step 5 ran ', Engine::writerFinish($names)->size, " bytes\n";
    Engine::writerDefine($names, 'Late', 'Shop!$A$1');
    echo "step 5 ran after finish\n";
} catch (Throwable $e) {
    echo 'step 5 stopped ', $e::class, "\n";
}
