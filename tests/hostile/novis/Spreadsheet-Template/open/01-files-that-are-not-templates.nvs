<?nvs
// Attack: the template is a file that is not an Excel workbook, or a workbook that is cut short or changed.
// `Template::open` or the first write should throw an error, and the program should keep running.
use Novis\Spreadsheet\Template;
use Novis\Spreadsheet\Workbook;

class Attack
{
    public static function template(): bytes
    {
        var $design = Workbook::createInMemory();
        $design->sheet('Shop')->addAll([['Order', '{{order}}']]);
        return $design->finish()->bytes ?? Core\Bytes::fill(0, 0);
    }

    // This method opens `$source`, fills it and prints the size of the file, or the class of the error.
    public static function attempt(int $step, bytes $source): void
    {
        try {
            bytes $file = Template::open($source)->fill(['order' => 1])->bytes();
            echo 'step ', $step, ' ran ', Core\Bytes::length($file) > 0 ? 'a file' : 'an empty file', "\n";
        } catch (Throwable $e) {
            echo 'step ', $step, ' stopped ', $e::class, "\n";
        }
    }
}

bytes $good = Attack::template();
int $size = Core\Bytes::length($good) as int;

// 1. No bytes, the two bytes that start a zip file, plain text, and a CSV file.
Attack::attempt(1, Core\Bytes::fill(0, 0));
Attack::attempt(1, 'PK' as bytes);
Attack::attempt(1, 'Order,{{order}}' as bytes);
var $csv = Workbook::createInMemory({ format: 'csv' });
$csv->sheet('Shop')->add(['{{order}}']);
Attack::attempt(1, $csv->finish()->bytes ?? Core\Bytes::fill(0, 0));

// 2. The first 1,000 bytes of a workbook, a workbook without its last byte, and a workbook with zeros at its end.
Attack::attempt(2, Core\Bytes::slice($good, 0, 1000));
Attack::attempt(2, Core\Bytes::slice($good, 0, $size - 1));
Attack::attempt(2, Core\Bytes::join([Core\Bytes::slice($good, 0, $size - 22), Core\Bytes::fill(22, 0)]));

// 3. A workbook with each 50th byte set to zero.
array<bytes> $parts = [];
for (int $at = 0; $at < $size; $at += 50) {
    int $length = $size - $at < 50 ? $size - $at : 50;
    $parts[] = Core\Bytes::slice($good, $at, $length - 1);
    $parts[] = Core\Bytes::fill(1, 0);
}
Attack::attempt(3, Core\Bytes::join($parts));

// 4. 200 templates opened in one request, and the good workbook last.
for (int $count = 0; $count < 200; $count++) {
    Template::open($good);
}
Attack::attempt(4, $good);
