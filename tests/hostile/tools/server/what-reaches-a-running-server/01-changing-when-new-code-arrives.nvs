<?nvs
// Attack: a request tries to change when the server uses new code, and which
// keys need a restart. Only the person who runs the server may set these, so
// every attempt below should fail.
// A name written directly in the call does not compile. Each name here is in a variable, so every call runs.

// 1. Compile the program again after every file that a deploy writes.
string $settle = 'opcache.settle';
echo 'settle 0ms:           ', Core\Config::set($settle, '0ms') ? 'accepted' : 'refused', "\n";

// 2. Wait so long that a fix never arrives.
echo 'settle 100 years:     ', Core\Config::set($settle, '876000h') ? 'accepted' : 'refused', "\n";

// 3. Check the files on every request.
string $freq = 'opcache.revalidate_freq';
echo 'revalidate_freq 0:    ', Core\Config::set($freq, '0') ? 'accepted' : 'refused', "\n";

// 4. Stop checking the files at all.
string $validate = 'opcache.validate';
echo 'validate never:       ', Core\Config::set($validate, 'never') ? 'accepted' : 'refused', "\n";

// 5. Change the three keys that need a restart.
string $listen = 'server.listen';
echo 'listen:               ', Core\Config::set($listen, '0.0.0.0:80') ? 'accepted' : 'refused', "\n";
string $socketMode = 'server.socket_mode';
echo 'socket_mode:          ', Core\Config::set($socketMode, '0777') ? 'accepted' : 'refused', "\n";
string $workers = 'server.workers';
echo 'workers:              ', Core\Config::set($workers, '100000') ? 'accepted' : 'refused', "\n";

// 6. Nothing is set, so both settings are still `null`.
echo 'settle is still:      ', Core\Config::get('opcache.settle') ?? '(no value)', "\n";
echo 'revalidate_freq is:   ', Core\Config::get('opcache.revalidate_freq') ?? '(no value)', "\n";
