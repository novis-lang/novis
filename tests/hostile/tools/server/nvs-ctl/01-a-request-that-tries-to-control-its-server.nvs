<?nvs
// Attack: a request tries to control its own server through the control socket.
// Only the person who runs the server may use that socket, so every attempt below should fail.

// 1. Move the control socket to a path that the attacker can use.
echo 'move the socket:     ', Core\Config::set('control.socket', '/tmp/attacker.sock') ? 'accepted' : 'refused', "\n";

// 2. Turn the control socket off, so that nobody can reload the server.
echo 'turn the socket off: ', Core\Config::set('control.socket', 'false') ? 'accepted' : 'refused', "\n";

// 3. Give the control socket a network address.
echo 'network address:     ', Core\Config::set('control.socket', '0.0.0.0:9000') ? 'accepted' : 'refused', "\n";

// 4. Connect to the socket and send a reload request.
//    The program has no `net.local` grant, so the connect throws an error.
string $request = "POST /reload HTTP/1.1\r\nHost: localhost\r\nContent-Length: 0\r\n\r\n";
try {
    Core\Net\Stream $stream = Core\Net::connectLocal('/run/nvs/control.sock', 1s);
    $stream->write($request as bytes, 1s);
    echo 'connect:             connected', "\n";
} catch (Throwable $error) {
    echo 'connect:             ', $error::class, "\n";
}

// 5. Write the same request to the socket as a file, under its Unix name and its Windows name.
//    The program has no `fs.write` grant, so each write throws an error.
array<string> $names = ['/run/nvs/control.sock', '\\\\.\\pipe\\nvs-control'];
foreach ($names as string $name) {
    try {
        Core\IO::write($name, $request);
        echo 'write:               written', "\n";
    } catch (Throwable $error) {
        echo 'write:               ', $error::class, "\n";
    }
}

// 6. Try to move the socket 100000 times, to a different path each time.
uint $accepted = 0;
uint $i = 0;
while ($i < 100000) {
    if (Core\Config::set('control.socket', "/tmp/attacker-{$i}.sock")) {
        $accepted = $accepted + 1;
    }
    $i = $i + 1;
}
echo 'accepted changes:    ', $accepted, "\n";

// 7. The setting still has the value from `nvs.toml`.
echo 'the socket is still: ', Core\Config::get('control.socket') ?? 'none', "\n";
