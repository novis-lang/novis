<?nvs
// Attack: a client sends forged forwarding headers, and the program tries to add
// the client to `trusted_proxies`. The server trusts no proxy, so the address and
// the scheme of the request should stay the same in every step.

// 1. Reads the address and the scheme. The forged headers say 127.0.0.1 and https.
?tainted string $address = Core\Request::clientIp();
tainted string $scheme = Core\Request::scheme();
echo 'client: ', $address ?? 'none', "\n";
echo 'scheme: ', $scheme, "\n";

// 2. Tries to trust every address, the address of the client, and values that are
//    not addresses. Each call returns `false`.
array<string> $lists = [
    '0.0.0.0/0',
    '::/0',
    '198.51.100.23',
    '198.51.100.23/32',
    '198.51.100.0/0',
    '10.0.0.0/99',
    '/',
    '',
    'unknown',
    "198.51.100.23\u{0000}",
    "10.0.0.5\n198.51.100.23",
    '["198.51.100.23"]',
    Core\Str::repeat('198.51.100.23,', 100000),
];
uint $accepted = 0;
foreach ($lists as string $list) {
    if (Core\Config::set('server.trusted_proxies', $list)) {
        $accepted = $accepted + 1;
    }
    if (Core\Config::set('server.trusted_proxies.0', $list)) {
        $accepted = $accepted + 1;
    }
    if (Core\Config::set('app.0.server.trusted_proxies', $list)) {
        $accepted = $accepted + 1;
    }
}

// 3. Tries the forged header itself as the list. This call returns `false` too.
tainted string $forged = Core\Request::header('x-forwarded-for') ?? '';
if (Core\Config::set('server.trusted_proxies', $forged)) {
    $accepted = $accepted + 1;
}
echo 'accepted: ', $accepted, "\n";

// 4. Repeats the attempt 100000 times and reads the address and the scheme each time.
uint $changes = 0;
uint $i = 0;
while ($i < 100000) {
    Core\Config::set('server.trusted_proxies', '0.0.0.0/0');
    if (Core\Request::clientIp() != $address || Core\Request::scheme() != $scheme) {
        $changes = $changes + 1;
    }
    $i = $i + 1;
}
echo 'changes: ', $changes, "\n";

// 5. Splits the forged header into its parts 20000 times and keeps every part.
//    This step uses a lot of memory.
array<tainted string> $parts = [];
uint $j = 0;
while ($j < 20000) {
    foreach (Core\Str::split($forged, ',') as tainted string $part) {
        $parts[] = Core\Str::trim($part);
    }
    $j = $j + 1;
}
echo 'parts kept: ', Core\Arr::count($parts), "\n";

// 6. Reads the address and the scheme again. This prints the same values as step 1.
echo 'client: ', Core\Request::clientIp() ?? 'none', "\n";
echo 'scheme: ', Core\Request::scheme(), "\n";
