<?nvs
// Attack: the extension blurs each `secret` string, and this file puts them in hard places.
// If a blur is one character short, the last character of a key is visible. If it is one
// line off, it hides other code and the key is visible. The file compiles and runs, so
// every case reaches the editor.

// Emoji before a secret on the same line. Each emoji code point is two UTF-16 units and
// four UTF-8 bytes. If the extension counts the wrong unit, the blur is too far left.
string $flag = '🏴🇦🇶🧑🚀🛰️';
secret string $afterAstral = 'sk-live-astral';

// Accent marks and a zero-width joiner. Here one grapheme has several code points,
// and the editor column is different from both counts.
string $marks = "é🇳🇴👩‍💻e\u{0301}";
secret string $afterMarks = 'sk-live-combining';

// A right-to-left override character inside the value. When the value is revealed,
// the rest of the line must not be shown backwards.
secret string $override = "sk-live-\u{202E}gnitset";

// Two secrets on one line. Revealing one of them must show that one only.
secret string $left = 'sk-live-left'; secret string $right = 'sk-live-right';

// An empty secret string. Its range starts and ends at the same position. The blur
// must not be lost, drawn twice or drawn at the start of the file.
secret string $empty = '';

// A line longer than the editor window, with the value at the end. The extension
// must blur it even when that part of the line is not on the screen.
secret string $long = 'sk-live-0000000000111111111122222222223333333333444444444455555555556666666666777777777788888888889999999999aaaaaaaaaabbbbbbbbbbccccccccccddddddddddeeeeeeeeeeffffffffff';

// A value written across three lines. It is one range, and the only range in
// this file that starts and ends on different lines.
secret string $wrapped = 'sk-live-first'
    . '-second'
    . '-third';

// A secret inside a class. The extension keeps revealed ranges for each file, so revealing
// this one must not reveal the same position in another open file.
final class Credentials
{
    public secret string $token = 'unset';

    public function rotate(): void
    {
        $this->token = 'sk-live-rotated';
    }
}

var $credentials = new Credentials();
$credentials->rotate();

// The program prints no secret, because the compiler does not allow that. It prints two
// lengths and one line, so a run that stopped early has less output.
echo Core\Str::length($flag), ' ', Core\Str::length($marks), "\n";
echo "credentials rotated\n";
