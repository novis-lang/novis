<?nvs
// Attack: a program tries to read the password file directly, or to point the password at another file.
// Every attempt should fail, and no error message should contain the password.

// `Here::path` returns its argument as a full path. A relative path in a string literal
// starts at the folder of this file.
class Here {
    public static function path(#[Core\Path] string $path): string {
        return $path;
    }
}
string $dir = Here::path('.');
string $secret = 'correct-horse-7';

// 1. Read the password file through paths that start in `data`. Each read should fail.
array<string> $paths = [
    $dir . '/secrets/mail-password',
    $dir . '/data/../secrets/mail-password',
    $dir . '/data\\..\\secrets\\mail-password',
    $dir . '/data/' . Core\Str::repeat('../', 64) . 'mail-password',
    $dir . "/data/../secrets/mail-password\0.txt",
    $dir . '/secrets',
];
foreach ($paths as string $path) {
    try {
        string $read = Core\IO::read($path);
        echo Core\Str::contains($read, $secret) ? "leaked\n" : "read\n";
    } catch (Throwable $denied) {
        echo Core\Str::contains($denied->message, $secret) ? "leaked\n" : "denied\n";
    }
}

// 2. Point the password at another file, or replace it. Each call should return `false`.
array<string> $keys = [
    'mail.relay.password_file',
    'mail.relay.password',
    'mail.relay',
    'mail.other.password_file',
];
foreach ($keys as string $key) {
    echo $key, ': ', Core\Config::set($key, '/etc/shadow') ? 'yes' : 'no', "\n";
}

// 3. Read the setting with names that are empty, very long, or contain zero bytes.
array<string> $names = [
    '',
    'mail.relay.password_file',
    'mail.relay.password.',
    "mail.relay.password\0",
    Core\Str::repeat('mail.relay.', 100000) . 'password',
];
foreach ($names as string $name) {
    try {
        echo Core\Str::length(Core\Config::get($name) ?? ''), "\n";
    } catch (Throwable $denied) {
        echo "denied\n";
    }
}

// 4. The password is still the content of the file. This prints `true`.
echo Core\Config::get('mail.relay.password') == $secret ? 'true' : 'false', "\n";
