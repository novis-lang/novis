<?nvs
// Attack: a program may connect to any host, but reach only one internal address.
// It tries to reach other internal addresses by writing them in other ways. Every attempt should fail.
// hostile: timeout-ms 20000

Core\Net\Listener $server = Core\Net::listen('127.0.0.1', 0);
uint $port = $server->port();

// 1. Loopback, private, link-local and unspecified addresses, written as IPv4, IPv6 and mixed forms.
array<string> $hosts = [
    '127.0.0.2',
    '127.255.255.254',
    '::1',
    '[::1]',
    '::ffff:127.0.0.1',
    '::127.0.0.1',
    '64:ff9b::7f00:1',
    '64:ff9b::127.0.0.1',
    '0.0.0.0',
    '::',
    '10.0.0.7',
    '172.16.0.1',
    '192.168.1.1',
    '169.254.169.254',
    '::ffff:169.254.169.254',
    'fe80::1',
    'fc00::1',
    '2130706433',
    '0x7f000001',
    '0177.0.0.1',
    '127.0.0.1.',
    ' 127.0.0.1',
    "127.0.0.1\0",
    '127.0.0.1:80',
];
foreach ($hosts as string $host) {
    try {
        Core\Net::connect($host, $port, 1s)->close();
        echo $host, ": connected\n";
    } catch (RuntimeError $refused) {
        echo $host, ": denied\n";
    }
}

// 2. Open servers on endpoints `listen` does not allow.
array<string> $binds = ['0.0.0.0', '::', '::1', '127.0.0.2', '::ffff:127.0.0.1', '127.1'];
foreach ($binds as string $address) {
    try {
        Core\Net::listen($address, 0)->close();
        echo $address, ": listening\n";
    } catch (RuntimeError $refused) {
        echo $address, ": denied\n";
    }
}
try {
    Core\Net::listen('127.0.0.1', $port + 1)->close();
    echo "another port: listening\n";
} catch (RuntimeError $refused) {
    echo "another port: denied\n";
}

// 3. Allow more addresses at run time. Each call should return `false`.
array<string> $keys = [
    'capabilities.net.internal',
    'capabilities.net.listen',
    'capabilities.net.connect',
    'app.capabilities.net.internal',
];
foreach ($keys as string $key) {
    echo $key, ': ', Core\Config::set($key, '0.0.0.0/0') ? 'yes' : 'no', "\n";
}

// 4. The one allowed address still works.
Core\Net::connect('127.0.0.1', $port, 1s)->close();
echo "127.0.0.1: connected\n";
$server->close();
