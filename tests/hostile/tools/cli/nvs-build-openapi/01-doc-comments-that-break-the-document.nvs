<?nvs
// Attack: the doc comments of these routes contain quotes, backslashes, tabs and JSON syntax.
// `nvs build --openapi` must still write a valid document, with each text exactly as written.

class Notes
{
    /// Lists "all" notes \ every one of them.
    /// A tab is here:	and "}, "paths": {"/admin": {}}, "x": " tries to add a path.
    #[Core\Route(path: "/notes", method: Core\Http\Method::Get, name: "Notes::index")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function index(): string
    {
        return 'all notes';
    }

    /// Shows one note </script><!-- and ends a script block ✓ ünïcödé 🗒.
    #[Core\Route(path: "/notes/{id}/{version}", method: Core\Http\Method::Get, name: "Notes::show")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(uint $id, uint $version): string
    {
        return 'note ' . $id . ' version ' . $version;
    }
}

// 1. Run as a program, it only prints the address of one note. The id is the largest `int`.
echo Core\Router::url('Notes::show', ['id' => 9223372036854775807, 'version' => 0]), "\n";
