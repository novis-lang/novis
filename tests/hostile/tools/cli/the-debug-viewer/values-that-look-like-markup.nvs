<?nvs
// Attack: this program records dumps, log lines and an error that contain HTML, script and links.
// `nvs debug` shows these records in a browser. Every value should show as plain text, and no
// script should run.
// hostile: ends-early 6 RuntimeError

// 1. A dump of text with a script tag, an image tag that runs code, and a closing `</textarea>` tag.
string $markup = '<script>window.__pwned=1</script><img src=x onerror="window.__pwned=2"></textarea><b>bold</b>';
Core\Debug::dump($markup);

// 2. A dump of an array whose keys and values are HTML tags and `javascript:` links.
array<mixed> $links = [
    $markup => 'javascript:window.__pwned=3//',
    'javascript:alert(1)' => $markup,
    '<a href="javascript:alert(1)">open</a>' => ['<svg onload="alert(1)">' => 'data:text/html,<script>alert(1)</script>'],
];
Core\Debug::dump($links);

// 3. A dump of control characters and characters that reverse the order of the text.
string $hidden = "\x00\x07\x08\x1f[31m\r\n\t\x7f\u{202e}gnp.exe\u{202c} \u{2066}\u{2069}\u{200f}\u{feff}\u{200b}";
Core\Debug::dump($hidden, [$hidden => $hidden . $markup]);

// 4. Log lines with HTML in the message, in the names of the fields and in their values.
Core\Log::write(Core\Log::Level::Warn, $markup, [$markup => $markup, 'link' => 'javascript:alert(1)', 'hidden' => $hidden]);
Core\Log::write(Core\Log::Level::Info, "javascript:alert(1)\n" . $hidden);

// 5. A dump and a log line of 2 MB of HTML.
string $large = Core\Str::repeat($markup, 20000);
Core\Debug::dump($large);
Core\Log::write(Core\Log::Level::Error, $large);

// 6. An error with HTML and a `javascript:` link in its message. Nothing catches it, so the program ends here.
echo "step 6\n";
throw new RuntimeError('javascript:alert(1)// ' . $markup . $hidden);
