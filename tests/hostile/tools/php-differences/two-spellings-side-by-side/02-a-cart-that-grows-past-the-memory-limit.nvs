<?nvs
// Attack: a loop creates eight million objects and keeps all of them. The loop prints nothing.
// The program should stop at its memory limit with an error.
// hostile: timeout-ms 60000
// hostile: ends-early 1 FATAL
// proof: gap nvs-runtime/a-loop-that-only-creates-objects-passes-the-memory-limit

final class Line
{
    public function constructor(public int $price, public ?Line $next)
    {}
}

// 1. Each new object has the object before it as its `$next`, so no object is freed.
echo "step 1\n";
?Line $cart = null;
int $i = 0;
while ($i < 8000000) {
    $cart = new Line($i, $cart);
    $i = $i + 1;
}
