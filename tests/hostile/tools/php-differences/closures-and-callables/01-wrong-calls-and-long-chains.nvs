<?nvs
// Attack: closures are called with the wrong arguments, nested very deep, and copied many times.
// Each step should end with an error or a clean result, and never a crash.
// hostile: timeout-ms 30000

class Counter
{
    public function constructor(public int $n)
    {}
    public function add(int $x): int
    {
        return $this->n + $x;
    }
}

callable $double = fn(int $x): int => $x * 2;

// 1. The closure needs an `int`, and gets a string.
try {
    echo $double('not a number') as int, "\n";
} catch (Throwable $e) {
    echo 'caught: ', $e->message, "\n";
}

// 2. The closure needs one argument, and gets none, then three.
try {
    echo $double() as int, "\n";
} catch (Throwable $e) {
    echo 'caught: ', $e->message, "\n";
}
try {
    echo $double(1, 2, 3) as int, "\n";
} catch (Throwable $e) {
    echo 'caught: ', $e->message, "\n";
}

// 3. A method named with `$o->m(...)` is called after the variable of its object is replaced.
Counter $counter = new Counter(1);
callable $add = $counter->add(...);
$counter = new Counter(1000);
echo $add(1) as int, "\n";

// 4. Each closure calls the one before it, 300,000 closures deep.
callable $chain = fn(int $x): int => $x;
uint $i = 0;
while ($i < 300000) {
    callable $inner = $chain;
    $chain = fn(int $x): int => $inner($x + 1) as int;
    $i = $i + 1;
}
try {
    echo $chain(0) as int, "\n";
} catch (Throwable $e) {
    echo 'caught: ', $e->message, "\n";
}

// 5. 1,000,000 closures each read a text of 10,000 characters, and every closure is kept.
string $text = Core\Str::repeat('x', 10000);
array<callable> $all = [];
$i = 0;
while ($i < 1000000) {
    $all[] = fn(): uint => Core\Str::length($text);
    $i = $i + 1;
}
echo Core\Arr::count($all), "\n";
