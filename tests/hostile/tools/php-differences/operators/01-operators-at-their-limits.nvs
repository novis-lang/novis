<?nvs
// Attack: the operators from the PHP table get values at the far end of their range, and very large arrays.
// Each step should end with an error or a clean result, and never a crash.
// hostile: timeout-ms 30000

// 1. Powers and comparisons past the largest `int`.
array<int> $exponents = [62, 63, 64, 1000, -1];
foreach ($exponents as int $e) {
    try {
        echo 2 ** $e, "\n";
    } catch (Throwable $err) {
        echo 'caught: ', Core\Str::slice($err->message, 0, 50), "\n";
    }
}
int $max = 9223372036854775807;
int $min = -9223372036854775807 - 1;
echo $max <=> $min, ' ', $min <=> $max, ' ', $max == $max ? 'same' : 'different', "\n";
try {
    echo $min * -1, "\n";
} catch (Throwable $err) {
    echo 'caught: ', Core\Str::slice($err->message, 0, 50), "\n";
}

// 2. Characters of a string, at positions past both ends.
string $word = 'héllo';
array<int> $positions = [0, 4, 5, -5, -6, $max, $min];
foreach ($positions as int $p) {
    try {
        echo Core\Str::at($word, $p), "\n";
    } catch (Throwable $err) {
        echo 'caught: ', Core\Str::slice($err->message, 0, 50), "\n";
    }
}

// 3. Two arrays of one million entries are merged, then merged again under themselves.
array<int> $big = [];
int $i = 0;
while ($i < 1000000) {
    $big[] = $i;
    $i = $i + 1;
}
array<int> $merged = Core\Arr::underlay($big, $big, $big);
echo Core\Arr::count($merged), "\n";

// 4. One million values are spread into a variadic parameter.
class Sum
{
    public static function of(int ...$values): int
    {
        int $total = 0;
        foreach ($values as int $v) {
            $total = $total + $v;
        }
        return $total;
    }
}
echo Sum::of(...$big), "\n";

// 5. A nullsafe chain and `??=` on a value that is `null` a million times.
class Node
{
    public ?Node $next = null;
}
Node $head = new Node();
?int $seen = null;
int $misses = 0;
$i = 0;
while ($i < 1000000) {
    if ($head->next?->next is null) {
        $misses = $misses + 1;
    }
    $seen ??= $i;
    $i = $i + 1;
}
echo $misses, ' ', $seen ?? -1, "\n";
