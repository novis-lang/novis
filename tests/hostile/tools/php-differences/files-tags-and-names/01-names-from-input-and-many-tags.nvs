<?nvs
// Attack: class names come from user input, and a page switches between HTML and code many times.
// Each step should end with an error or a clean result, and never a crash.
// hostile: timeout-ms 30000

class Report
{
    public static function title(): string
    {
        return 'report';
    }
}

class Secret
{
    public static function title(): string
    {
        return 'secret';
    }
}

// 1. Names a user could send: another class, an empty string, a leading `\`, a very long name.
array<string> $names = [
    'Secret',
    '',
    "\\Report",
    "Report\\..\\Secret",
    'report',
    Core\Str::repeat('A', 1000000),
];
foreach ($names as string $name) {
    try {
        class<Report> $cls = $name as class<Report>;
        echo $cls::title(), "\n";
    } catch (Throwable $e) {
        echo 'caught: ', Core\Str::slice($e->message, 0, 60), "\n";
    }
}

// 2. The same name is converted 1,000,000 times.
uint $i = 0;
uint $found = 0;
while ($i < 1000000) {
    class<Report> $again = 'Report' as class<Report>;
    $found = $found + Core\Str::length($again::title());
    $i = $i + 1;
}
echo $found, "\n";

// 3. A loop leaves code mode and prints a value through `<?= ?>` 200,000 times.
$i = 0;
uint $step = 0;
while ($i < 200000) {
    $step = $i % 10;
    if ($step == 0) {
        ?>[<?= $step ?>]<?nvs
    }
    $i = $i + 1;
}
echo "\n", $step, "\n";
