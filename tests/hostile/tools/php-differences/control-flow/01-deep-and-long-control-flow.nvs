<?nvs
// Attack: loops, generators and `try` blocks are run a very large number of times, or nested very deeply.
// Each step should end with an error or a clean result, and never a crash.
// hostile: timeout-ms 30000

class Deep
{
    // Each call opens one more `try` block before it calls itself.
    public static function nest(int $depth): int
    {
        try {
            if ($depth == 0) {
                throw new RuntimeError('bottom');
            }
            return Deep::nest($depth - 1);
        } finally {
            $depth = $depth + 0;
        }
    }

    public static function count(int $limit): Iterator<int>
    {
        int $i = 0;
        while ($i < $limit) {
            yield $i;
            $i = $i + 1;
        }
    }

    // Each generator passes on every value of the one inside it.
    public static function chain(int $depth): Iterator<int>
    {
        if ($depth == 0) {
            foreach (Deep::count(3) as int $v) {
                yield $v;
            }
            return;
        }
        foreach (Deep::chain($depth - 1) as int $v) {
            yield $v;
        }
    }
}

// 1. One million errors are thrown and caught.
int $caught = 0;
int $i = 0;
while ($i < 1000000) {
    try {
        throw new RuntimeError('row ' . $i);
    } catch (RuntimeError $e) {
        $caught = $caught + 1;
    }
    $i = $i + 1;
}
echo $caught, "\n";

// 2. A generator gives one million values.
int $sum = 0;
foreach (Deep::count(1000000) as int $v) {
    $sum = $sum + $v;
}
echo $sum, "\n";

// 3. A thousand generators are nested inside each other.
int $seen = 0;
foreach (Deep::chain(1000) as int $v) {
    $seen = $seen + 1;
}
echo $seen, "\n";

// 4. A `match` with no matching arm, one million times.
int $missed = 0;
$i = 0;
while ($i < 1000000) {
    try {
        echo match ($i) {
            -1 => 'never',
        };
    } catch (LogicError $noArm) {
        $missed = $missed + 1;
    }
    $i = $i + 1;
}
echo $missed, "\n";

// 5. One million `try` blocks are open at the same time, one inside each call.
try {
    echo Deep::nest(1000000), "\n";
} catch (Throwable $err) {
    echo 'caught: ', Core\Str::slice($err->message, 0, 50), "\n";
}
