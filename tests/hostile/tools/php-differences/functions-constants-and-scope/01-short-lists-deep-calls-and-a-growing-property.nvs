<?nvs
// Attack: a program reads more values than an array has, calls a method ten million times deep,
// and grows a static property. Each step should end with an error or a clean result, and never a crash.
// hostile: timeout-ms 30000

class Deep
{
    private static array<int> $seen = [];

    public static function down(int $n): int
    {
        if ($n == 0) {
            return 0;
        }
        return 1 + self::down($n - 1);
    }

    public static function keep(int $v): uint
    {
        self::$seen[] = $v;
        return Core\Arr::count(self::$seen);
    }

    public static function forget(): uint
    {
        self::$seen = [];
        return Core\Arr::count(self::$seen);
    }
}

// 1. Three variables are read from an array with two values.
try {
    array<int> $short = [1, 2];
    [int $a, int $b, int $c] = $short;
    echo $a + $b + $c, "\n";
} catch (Throwable $e) {
    echo 'caught: ', $e->message, "\n";
}

// 2. Values are read by position from an array that only has string keys.
try {
    array<int> $keyed = ['a' => 1, 'b' => 2];
    [int $x, int $y] = $keyed;
    echo $x + $y, "\n";
} catch (Throwable $e) {
    echo 'caught: ', $e->message, "\n";
}

// 3. An array replaces variable variables. It gets 1,000,000 names, and then a name it does not have is read.
array<int> $vars = [];
int $i = 0;
while ($i < 1000000) {
    $vars['name' . $i] = $i;
    $i = $i + 1;
}
echo Core\Arr::count($vars), "\n";
try {
    echo $vars['name' . Core\Str::repeat('9', 100000)], "\n";
} catch (Throwable $e) {
    echo 'caught: ', Core\Str::slice($e->message, 0, 40), "\n";
}

// 4. A static property grows by 1,000,000 values, and is then emptied.
$i = 0;
uint $n = 0;
while ($i < 1000000) {
    $n = Deep::keep($i);
    $i = $i + 1;
}
echo $n, ' ', Deep::forget(), "\n";

// 5. A static method calls itself ten million times deep.
try {
    echo Deep::down(10000000), "\n";
} catch (Throwable $e) {
    echo 'caught: ', $e->message, "\n";
}
echo "end\n";
