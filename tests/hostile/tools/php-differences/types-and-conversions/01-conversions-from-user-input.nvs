<?nvs
// Attack: text from a user is converted to numbers: very long digits, values past the largest `int`,
// and a million values in a row. Each step should end with an error or a clean result, and never a crash.
// hostile: timeout-ms 30000

// 1. Text that is not a whole number, or is too large for an `int`.
array<string> $inputs = [
    '',
    ' 42',
    '42 ',
    '-0',
    '1e3',
    '0x1A',
    '9223372036854775807',
    '9223372036854775808',
    '-9223372036854775809',
    Core\Str::repeat('9', 1000000),
    '12' . Core\Str::repeat(' ', 100000),
];
foreach ($inputs as string $text) {
    ?int $maybe = $text as ?int;
    echo $maybe is null ? 'null' : 'set', ' ';
    try {
        int $n = $text as int;
        echo $n, "\n";
    } catch (Throwable $e) {
        echo 'caught: ', Core\Str::slice($e->message, 0, 50), "\n";
    }
}

// 2. The largest `int` is doubled.
try {
    int $big = '9223372036854775807' as int;
    echo $big * 2, "\n";
} catch (Throwable $e) {
    echo 'caught: ', $e->message, "\n";
}

// 3. One million texts are converted, and the results are added up.
int $total = 0;
int $i = 0;
while ($i < 1000000) {
    string $digits = $i as string;
    $total = $total + ($digits as int);
    $i = $i + 1;
}
echo $total, "\n";
