<?nvs
// `signWith` calls `sign` on the interface type, and `openVault` creates a `Vault`.
namespace Shop;

final class Checkout
{
    public static function signWith(Acme\Signing\Signs $signer): string
    {
        return $signer->sign('page');
    }

    public static function openVault(): string
    {
        return (new Acme\Signing\Vault())->open();
    }
}
