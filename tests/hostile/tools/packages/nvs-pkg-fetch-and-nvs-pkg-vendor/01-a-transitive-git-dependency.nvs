// so this program should not compile.
// hostile: expect-refusal

require './vendor/packages.nvs';

// 1. Loads the copy of `Other\Tools` from the folder of `Acme\Http`.
autoload 'Other\Tools' from './vendor/acme/http/tools/src';

echo Acme\Http\Client::send(), "\n";
