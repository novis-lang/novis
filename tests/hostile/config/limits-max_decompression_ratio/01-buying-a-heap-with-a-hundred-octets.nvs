<?nvs
// Attack: a request tries to remove `limits.max_decompression_ratio`, the most
// output bytes allowed for each input byte. It then unpacks inputs with a high
// ratio. Every write should fail, and inputs over the ratio should throw.
// hostile: timeout-ms 60000

// 1. Tries the ratio's key and keys that are almost the same.
array<string> $names = [
    'limits.max_decompression_ratio',
    'limits.MAX_DECOMPRESSION_RATIO',
    'limits.Max_Decompression_Ratio',
    'limits.max_decompression_ratio.',
    '.limits.max_decompression_ratio',
    'limits..max_decompression_ratio',
    'limits.max.decompression.ratio',
    'limits.max-decompression-ratio',
    'limits.maxdecompressionratio',
    'limits.hard.max_decompression_ratio',
    'limits.max_decompression_ratio.hard',
    'app.limits.max_decompression_ratio',
    'app.0.limits.max_decompression_ratio',
    "limits.max_decompression_ratio\u{0000}",
    'limits.max_decompressed/../max_decompression_ratio',
    Core\Str::repeat('limits.', 20000) . 'max_decompression_ratio',
];
foreach ($names as string $key) {
    Core\Config::set($key, '1000000');
    Core\Config::set($key, 'false');
    Core\Config::set($key, '0');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 2. Tries many values on the real key. In `[limits]`, `false` means "no limit",
//    so it is tried too. Every write should fail.
array<string> $values = [
    'false',
    'true',
    '0',
    '1',
    '-1',
    '1000',
    '1001',
    '1000000000000',
    '18446744073709551615',
    '18446744073709551616',
    '0.001',
    '1e9',
    '',
    'NaN',
    'inf',
];
foreach ($values as string $value) {
    Core\Config::set('limits.max_decompression_ratio', $value);
}
Core\Config::restore('limits.max_decompression_ratio');

// 3. Compresses longer and longer runs of `A`, so the ratio grows. The small
//    inputs unpack, and the large ones should throw a `ParseError`.
array<uint> $sizes = [16384, 65536, 262144, 1048576, 4194304, 8388608];
foreach ($sizes as uint $size) {
    bytes $frame = Core\Compress::compress(Core\Str::repeat('A', $size) as bytes, Core\Codec::Gzip);
    try {
        uint $out = Core\Bytes::length(Core\Compress::decompress($frame, Core\Codec::Gzip));
        echo $size, ': ', $out, " octets back\n";
    } catch (ParseError $refused) {
        echo $size, ": refused\n";
    }
}

// 4. Sends a large input to a stream one byte at a time. The ratio counts the
//    whole stream, so `finish` should throw a `ParseError`.
bytes $bomb = Core\Compress::compress(Core\Str::repeat('A', 4194304) as bytes, Core\Codec::Gzip);
Core\Compress\Decompressor $stream = Core\Compress::decompressor(Core\Codec::Gzip);
int $at = 0;
int $len = Core\Bytes::length($bomb) as int;
while ($at < $len) {
    $stream->add(Core\Bytes::slice($bomb, $at, 1));
    $at = $at + 1;
}
try {
    $stream->finish();
    echo "one octet at a time: got the whole thing\n";
} catch (ParseError $chunked) {
    echo "one octet at a time: refused\n";
}

// 5. Passes ratios from `0` to the largest `uint`. A call may lower the ratio
//    but not raise it.
array<uint> $asks = [0, 1, 2, 999, 1000, 1001, 18446744073709551615];
foreach ($asks as uint $ask) {
    try {
        Core\Compress::decompress($bomb, Core\Codec::Gzip, 67108864, $ask);
    } catch (ParseError $refused) {
    }
}
echo "still standing\n";
