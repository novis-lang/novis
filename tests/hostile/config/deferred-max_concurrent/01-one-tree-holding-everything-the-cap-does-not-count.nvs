<?nvs
// Attack: `[deferred] max_concurrent` counts requests, not pieces of work. So this request adds
// 200,000 anonymous functions to run after the response. One of them tries to add more while it runs.
// It also tries to raise the limit, and every change to the limit should fail.
// The server should run all the work and keep running.
// hostile: timeout-ms 40000

// `Core\Config::set('deferred.max_concurrent', ...)` does not compile, because a program may not change `deferred.max_concurrent`.
// A name in a variable is checked only when the program runs. Then `set` returns `false`.
string $maxConcurrent = 'deferred.max_concurrent';

// 1. Raise the limit, or set values that could mean "no limit". Each change should fail.
array<string> $caps = [
    '4096',
    '18446744073709551615',
    '99999999999999999999999999999999999999',
    '-1',
    '0',
    '0x1000',
    '1e9',
    'true',
    '',
    ' ',
    'unlimited',
    "256\u{0000}4096",
];
foreach ($caps as string $cap) {
    Core\Config::set($maxConcurrent, $cap);
    Core\Config::get('deferred.max_concurrent');
}
Core\Config::restore($maxConcurrent);
Core\Config::restore($maxConcurrent);

// 2. Set names that are almost the real name, and a name with 10,000 parts separated by dots.
array<string> $nearby = [
    'deferred.max_concurrent.',
    '.deferred.max_concurrent',
    'deferred..max_concurrent',
    'deferredmax_concurrent',
    'deferred.max-concurrent',
    'DEFERRED.MAX_CONCURRENT',
    'Deferred.Max_Concurrent',
    'max_concurrent',
    'deferred.deadline.max_concurrent',
    'app.deferred.max_concurrent',
    'deferred.max_concurrent.' . Core\Str::repeat('scope.', 10000) . 'default',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, '4096');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 3. Add an anonymous function that runs first and tries to add more work while it runs.
// Each `Core\Task::afterResponse` call inside it should throw an error.
Core\Task::afterResponse(fn(): void => {
    try {
        Core\Task::afterResponse(fn(): void => {});
    } catch (Throwable $refused) {
        echo "a drain may not extend itself\n";
    }
    uint $again = 0;
    while ($again < 1000) {
        try {
            Core\Task::afterResponse(fn(): void => {});
        } catch (Throwable $refused) {
        }
        $again = $again + 1;
    }
});

// 4. Add 200,000 anonymous functions, each with its own string. The limit counts this request once, so all are accepted.
uint $i = 0;
while ($i < 200000) {
    string $payload = 'entry-' . $i . '-' . Core\Str::repeat('x', 64);
    Core\Task::afterResponse(fn(): void => {
        // This function prints nothing. The test only checks that the server still runs afterwards.
        Core\Str::length($payload);
    });
    $i = $i + 1;
}

echo "answered with 200001 hand-offs behind it\n";
