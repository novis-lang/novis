<?nvs
// Attack: `[deferred] max_concurrent` counts requests, not pieces of work. So this request adds
// 200,000 closures to run after the response, and one closure tries to add more while it runs.
// It also tries to raise the limit, and every change to the limit should fail.
// The server should run all the work and keep running.
// hostile: timeout-ms 40000

// 1. Raise the limit, or set values that could mean "no limit". Each change should fail.
array<string> $caps = [
    '4096',
    '18446744073709551615',
    '99999999999999999999999999999999999999',
    '-1',
    '0',
    '0x1000',
    '1e9',
    'true',
    '',
    ' ',
    'unlimited',
    "256\u{0000}4096",
];
foreach ($caps as string $cap) {
    Core\Config::set('deferred.max_concurrent', $cap);
    Core\Config::get('deferred.max_concurrent');
}
Core\Config::restore('deferred.max_concurrent');
Core\Config::restore('deferred.max_concurrent');

// 2. Set keys that are almost the real key, and a key with 10,000 parts.
array<string> $nearby = [
    'deferred.max_concurrent.',
    '.deferred.max_concurrent',
    'deferred..max_concurrent',
    'deferredmax_concurrent',
    'deferred.max-concurrent',
    'DEFERRED.MAX_CONCURRENT',
    'Deferred.Max_Concurrent',
    'max_concurrent',
    'deferred.deadline.max_concurrent',
    'app.deferred.max_concurrent',
    'deferred.max_concurrent.' . Core\Str::repeat('scope.', 10000) . 'default',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, '4096');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 3. Add a closure that runs first and tries to add more work while it runs. Each try should throw.
Core\Task::afterResponse(fn (): void => {
    try {
        Core\Task::afterResponse(fn (): void => {});
    } catch (Throwable $refused) {
        echo "a drain may not extend itself\n";
    }
    uint $again = 0;
    while ($again < 1000) {
        try {
            Core\Task::afterResponse(fn (): void => {});
        } catch (Throwable $refused) {
        }
        $again = $again + 1;
    }
});

// 4. Add 200,000 closures, each with its own string. The limit counts this request once, so all are accepted.
uint $i = 0;
while ($i < 200000) {
    string $payload = 'entry-' . $i . '-' . Core\Str::repeat('x', 64);
    Core\Task::afterResponse(fn (): void => {
        // This closure prints nothing. The test only checks that the server still runs afterwards.
        Core\Str::length($payload);
    });
    $i = $i + 1;
}

echo "answered with 200001 hand-offs behind it\n";
