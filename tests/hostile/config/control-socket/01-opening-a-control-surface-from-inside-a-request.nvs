<?nvs
// Attack: a request tries to move `[control] socket`, or to open it. The person who runs
// the server manages it through this socket, so whoever can use it controls the server.
// Every attempt below should fail.

// 1. Set the socket to paths and network addresses. Each change should fail, even to a valid path.
array<string> $addresses = [
    '/tmp/mine.sock',
    '\\\\.\\pipe\\mine',
    '0.0.0.0:9000',
    '127.0.0.1:9000',
    'tcp://0.0.0.0:9000',
    'http://0.0.0.0:9000',
    '[::]:9000',
    '\\\\attacker.example\\pipe\\nvs-control',
    '//./pipe/nvs-control',
    '/dev/null',
    'NUL',
    'CON',
    'false',
    'true',
    '',
    '.',
    '..',
];
foreach ($addresses as string $address) {
    Core\Config::set('control.socket', $address);
    Core\Config::restore('control.socket');
}

// 2. Set a 256 KB path, and a path with a null byte. A shortened path would name another socket.
string $overlong = '/tmp/' . Core\Str::repeat('s', 262144) . '.sock';
Core\Config::set('control.socket', $overlong);
Core\Config::set('control.socket', "/tmp/one\u{0000}/../../etc/two.sock");

// 3. Set the whole block, and keys that are almost the real key or are unknown.
array<string> $nearby = [
    'control',
    'control.',
    'control.socket.',
    'control.socket.path',
    'control.socketx',
    'CONTROL.SOCKET',
    'control.nvs_no_such_key',
    'app.0.control.socket',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, '0.0.0.0:9000');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 4. Try the same change 100,000 times. Each try should fail and leave nothing behind.
uint $i = 0;
while ($i < 100000) {
    Core\Config::set('control.socket', '0.0.0.0:9000');
    Core\Config::restore('control.socket');
    $i = $i + 1;
}

// 5. Read the usual control socket paths as files. The program has no right to read them.
array<string> $endpoints = [
    '\\\\.\\pipe\\nvs-control',
    '/run/nvs/control.sock',
    '/tmp/nvs-control.sock',
];
foreach ($endpoints as string $endpoint) {
    try {
        Core\IO::read($endpoint);
        echo 'opened: ', $endpoint, "\n";
    } catch (RuntimeError $refused) {
        echo 'refused: ', $endpoint, "\n";
    }
}

// The socket should still be the value from the file.
echo 'control socket: ', Core\Config::get('control.socket') ?? '(none)', "\n";
