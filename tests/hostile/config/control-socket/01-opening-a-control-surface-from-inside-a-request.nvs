<?nvs
// Attack: move the control surface from inside a request, and reach the one
// this machine might already have. `[control] socket` is the door every
// administrative operation on a live server arrives through, and its whole
// authentication is who owns it -- so a request that could write the key would
// be choosing where that door is, and one that could write a host and a port
// would be putting it on the network, which the boot refuses outright.

// 1. The key itself, written with every shape the boot exists to refuse. A
//    `System` directive answers nobody, so every one of these has to come back
//    false -- including the ones that are perfectly good local paths, because
//    "is this a reasonable socket" is not the question being asked.
array<string> $addresses = [
    '/tmp/mine.sock',
    '\\\\.\\pipe\\mine',
    '0.0.0.0:9000',
    '127.0.0.1:9000',
    'tcp://0.0.0.0:9000',
    'http://0.0.0.0:9000',
    '[::]:9000',
    '\\\\attacker.example\\pipe\\nvs-control',
    '//./pipe/nvs-control',
    '/dev/null',
    'NUL',
    'CON',
    'false',
    'true',
    '',
    '.',
    '..',
];
foreach ($addresses as string $address) {
    Core\Config::set('control.socket', $address);
    Core\Config::restore('control.socket');
}

// 2. A path at the length where a name stops being a name: an endpoint on Unix
//    is bounded by the address structure it is copied into, and one that was
//    truncated rather than refused would name a *different* socket than the one
//    written down.
string $overlong = '/tmp/' . Core\Str::repeat('s', 262144) . '.sock';
Core\Config::set('control.socket', $overlong);
Core\Config::set('control.socket', "/tmp/one\u{0000}/../../etc/two.sock");

// 3. The block and the names around the key, because the registry answers by
//    longest prefix and the row here is the *key* rather than the block: a key
//    added to `[control]` is ungoverned until somebody writes its row, and a
//    request must not be the one that finds that out.
array<string> $nearby = [
    'control',
    'control.',
    'control.socket.',
    'control.socket.path',
    'control.socketx',
    'CONTROL.SOCKET',
    'control.nvs_no_such_key',
    'app.0.control.socket',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, '0.0.0.0:9000');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 4. The same refusal a hundred thousand times, in case an overlay a request
//    writes into keeps what it was handed even when the write was refused.
uint $i = 0;
while ($i < 100000) {
    Core\Config::set('control.socket', '0.0.0.0:9000');
    Core\Config::restore('control.socket');
    $i = $i + 1;
}

// 5. The surface itself, as a file. `nvs ctl` speaks HTTP over this socket, and
//    a program that could open it would be issuing control operations with a
//    request's authority rather than an operator's -- so the endpoint is a path
//    like any other and the file grant is what stands in the way.
array<string> $endpoints = [
    '\\\\.\\pipe\\nvs-control',
    '/run/nvs/control.sock',
    '/tmp/nvs-control.sock',
];
foreach ($endpoints as string $endpoint) {
    try {
        Core\IO::read($endpoint);
        echo 'opened: ', $endpoint, "\n";
    } catch (RuntimeError $refused) {
        echo 'refused: ', $endpoint, "\n";
    }
}

// Still standing, and the door still wherever the file put it.
echo 'control socket: ', Core\Config::get('control.socket') ?? '(none)', "\n";
