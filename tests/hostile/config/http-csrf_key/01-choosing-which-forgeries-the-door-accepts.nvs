<?nvs
// Attack: a request tries to set or clear `[http] csrf_key`. The server checks the CSRF token
// of every request against this key. A request may change most of `[http]`, but every
// change to this key should fail.
// hostile: timeout-ms 30000

// 1. Set the key to a value the attacker knows, to empty values and to very long values.
array<string> $keys = [
    'attacker-chosen-key',
    '',
    '0',
    'false',
    'null',
    Core\Str::repeat('\u{0000}', 32),
    Core\Str::repeat('A', 32),
    Core\Str::repeat('A', 1000000),
    "key\u{0000}ignored",
    "key\r\ncsrf_key_file = \"/tmp/attacker.key\"",
    "key\ncsrf_key = \"\"",
];
foreach ($keys as string $value) {
    Core\Config::set('http.csrf_key', $value);
    Core\Config::get('http.csrf_key');
}
Core\Config::restore('http.csrf_key');

// 2. Set `csrf_key_file` to a file the attacker controls, a device or an invalid path.
array<string> $files = [
    '/tmp/attacker.key',
    'nvs.toml',
    '.',
    '/dev/zero',
    '\\\\attacker.test\\share\\csrf.key',
    "/tmp/attacker.key\u{0000}",
    Core\Str::repeat('../', 20000) . 'tmp/attacker.key',
];
foreach ($files as string $value) {
    Core\Config::set('http.csrf_key_file', $value);
    Core\Config::get('http.csrf_key_file');
}
Core\Config::restore('http.csrf_key_file');

// 3. Set both keys, one after the other. Each change should fail on its own.
Core\Config::set('http.csrf_key', 'inline');
Core\Config::set('http.csrf_key_file', '/tmp/attacker.key');
Core\Config::get('http.csrf_key');
Core\Config::restore('http.csrf_key');
Core\Config::restore('http.csrf_key_file');

// 4. Set keys that are almost the real keys, and a key with 20,000 parts.
array<string> $spellings = [
    'http.csrf_key.value',
    'http.csrf_key.',
    'http..csrf_key',
    'HTTP.CSRF_KEY',
    'Http.Csrf_Key_File',
    'http.csrf-key',
    'http.csrfkey',
    'http.csrf_key_file_file',
    'http.headers.csrf_key',
    'app.http.csrf_key',
    'http.csrf_key.' . Core\Str::repeat('sub.', 20000) . 'off',
];
foreach ($spellings as string $key) {
    Core\Config::set($key, 'attacker-chosen-key');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 5. Try both changes 100,000 times with no restore. A failed change should use no memory.
uint $i = 0;
while ($i < 100000) {
    Core\Config::set('http.csrf_key', 'attacker-chosen-key');
    Core\Config::set('http.csrf_key_file', '/tmp/attacker.key');
    $i = $i + 1;
}
echo Core\Config::get('http.csrf_key') ?? '(nothing)', "\n";
