<?nvs
// Attack: a request tries to change `[tls.client]`. Every outbound TLS connection uses these
// settings, so they decide which certificates every request trusts. Every change should fail.
// hostile: timeout-ms 30000

// `Core\Config::set('tls.client.roots', ...)` does not compile, because a program may not change `tls.client.roots`.
// This program keeps the names in variables. The compiler does not check a variable, so `set` runs and returns `false`.
string $rootsKey = 'tls.client.roots';
string $minVersion = 'tls.client.min_version';
string $keylog = 'tls.client.keylog';

// 1. Set the trusted certificates to the attacker's file, to an empty list and to invalid values.
array<string> $roots = [
    '["/tmp/attacker.pem"]',
    '[]',
    '',
    'bundled',
    '["bundled", "/tmp/attacker.pem"]',
    '/tmp/attacker.pem',
    "[\"bundled\"]\u{0000}[\"/tmp/attacker.pem\"]",
    "[\"bundled\"]\r\nkeylog = \"/tmp/keys.log\"",
    'null',
    'false',
    '["' . Core\Str::repeat('../', 20000) . 'tmp/attacker.pem"]',
    Core\Str::repeat('["/tmp/a.pem"]', 50000),
];
foreach ($roots as string $value) {
    Core\Config::set($rootsKey, $value);
    Core\Config::get('tls.client.roots');
}
Core\Config::restore($rootsKey);

// 2. Set the oldest TLS version to older versions and to invalid values.
array<string> $versions = [
    '1.0',
    '1.1',
    'ssl3',
    '0',
    '',
    '1.2 ',
    '1,2',
    '1.3.0',
    '-1.3',
    Core\Str::repeat('1', 100000) . '.2',
];
foreach ($versions as string $value) {
    Core\Config::set($minVersion, $value);
    Core\Config::get('tls.client.min_version');
}
Core\Config::restore($minVersion);

// 3. Set the file for session secrets. With them, an attacker could read all outbound traffic.
array<string> $keylogs = [
    '/tmp/keys.log',
    'keys.log',
    '.',
    '/dev/stdout',
    '\\\\attacker.test\\share\\keys.log',
    'C:\\Windows\\System32\\config\\keys.log',
    "keys.log\u{0000}",
    Core\Str::repeat('a/', 50000) . 'keys.log',
];
foreach ($keylogs as string $value) {
    Core\Config::set($keylog, $value);
    Core\Config::get('tls.client.keylog');
}
Core\Config::restore($keylog);

// 4. Switch to development mode first, and then set the secrets file. This should still fail.
Core\Config::set('mode.default', 'development');
Core\Config::set($keylog, '/tmp/keys.log');
Core\Config::get('tls.client.keylog');
Core\Config::restore('mode.default');

// 5. Set keys that are almost the real keys, the old `[http.client.tls]` keys, and the same keys under `[http.client.socket]`.
array<string> $keys = [
    'tls.client',
    'tls.client.',
    'tls..client.roots',
    'tls.client.roots.0',
    'TLS.CLIENT.ROOTS',
    'Tls.Client.Keylog',
    'tls.clientx.roots',
    'http.client.tls.roots',
    'http.client.tls.keylog',
    'http.client.socket.tls.roots',
    'http.client.socket.max_message.tls.keylog',
    'tls.client.roots.' . Core\Str::repeat('sub.', 20000) . 'off',
    'tls.roots',
    'roots',
];
foreach ($keys as string $key) {
    Core\Config::set($key, '["/tmp/attacker.pem"]');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 6. Try two changes 100,000 times with no restore. A failed change should use no memory.
uint $i = 0;
while ($i < 100000) {
    Core\Config::set($rootsKey, '["/tmp/attacker.pem"]');
    Core\Config::set($keylog, '/tmp/keys.log');
    $i = $i + 1;
}
echo Core\Config::get('tls.client.min_version') ?? '(nothing)', "\n";
