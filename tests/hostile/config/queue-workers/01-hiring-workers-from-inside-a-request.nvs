<?nvs
// Attack: a request tries to change `queue.workers`, the number of queue workers
// on this server. More workers take CPU time from other requests, and `0` stops
// all queue work. Every write should fail, and the value should not change.
// hostile: timeout-ms 20000

// 1. Tries numbers written in many ways, from `0` to numbers too large to store,
//    and values that are not numbers. Every write should fail.
array<string> $counts = [
    '0',
    '1',
    '-1',
    '-0',
    '8',
    '4294967295',
    '4294967296',
    '18446744073709551615',
    '18446744073709551616',
    '1e9',
    '0x10',
    '010',
    ' 8 ',
    "8\u{0000}",
    '8.0',
    '+8',
    'true',
    'false',
    '',
    'null',
    Core\Str::repeat('9', 100000),
    '-' . Core\Str::repeat('9', 100000),
];
foreach ($counts as string $count) {
    Core\Config::set('queue.workers', $count);
    Core\Config::set('app.0.queue.workers', $count);
    Core\Config::restore('queue.workers');
}

// 2. Tries `queue.workers`, `queue.connection` and keys that are almost the same.
//    A worker uses both keys, so both writes must fail.
array<string> $keys = ['queue.workers', 'queue.connection', 'QUEUE.WORKERS', 'queue.workers ', 'app.0.queue.workers'];
foreach ($keys as string $key) {
    Core\Config::set($key, '64');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 3. Writes and reads the value 200,000 times. The value should never change,
//    so this prints `0`.
uint $changes = 0;
string $standing = Core\Config::get('queue.workers') ?? '(nothing written)';
uint $i = 0;
while ($i < 200000) {
    Core\Config::set('queue.workers', '64');
    Core\Config::set('queue.workers', '0');
    Core\Config::restore('queue.workers');
    if ((Core\Config::get('queue.workers') ?? '(nothing written)') != $standing) {
        $changes = $changes + 1;
    }
    $i = $i + 1;
}

// 4. Builds 20,000 strings, as a real request would. The settings should still
//    be the configured values after this work.
array<string> $work = [];
uint $j = 0;
while ($j < 20000) {
    $work[] = 'batch-' . $j . '-' . Core\Str::repeat('y', $j % 64);
    $j = $j + 1;
}

echo 'changes: ', $changes, "\n";
echo 'work built: ', Core\Arr::count($work), "\n";
echo 'workers:    ', Core\Config::get('queue.workers') ?? '(nothing written)', "\n";
echo 'connection: ', Core\Config::get('queue.connection') ?? '(nothing written)', "\n";
