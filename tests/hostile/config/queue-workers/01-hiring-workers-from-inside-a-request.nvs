<?nvs
// Attack: the number of tasks this instance spawns to work the queue, written
// from inside a request. This is the block's resource key, so what a successful
// write buys is not data but the machine — a count a request could raise is a
// request spawning tasks on a host every co-resident request is also running
// on, and a count it could lower is this instance quietly stopping its share of
// the work, which looks exactly like a queue with nothing in it. The count
// still reading what the file wrote, after all of it, is the evidence that no
// task was started or stopped.
// hostile: timeout-ms 20000

// 1. Every shape a count can be written in. The words are not the dangerous
//    ones: a value that reads as a number to one parser and as nothing to the
//    next is how a count arrives spelled as something the refusal does not
//    recognise, and the far end of the range is where a count that *was*
//    accepted stops being a count and becomes an allocation.
array<string> $counts = [
    '0',
    '1',
    '-1',
    '-0',
    '8',
    '4294967295',
    '4294967296',
    '18446744073709551615',
    '18446744073709551616',
    '1e9',
    '0x10',
    '010',
    ' 8 ',
    "8\u{0000}",
    '8.0',
    '+8',
    'true',
    'false',
    '',
    'null',
    Core\Str::repeat('9', 100000),
    '-' . Core\Str::repeat('9', 100000),
];
foreach ($counts as string $count) {
    Core\Config::set('queue.workers', $count);
    Core\Config::set('app.0.queue.workers', $count);
    Core\Config::restore('queue.workers');
}

// 2. The key beside it, in the same breath. `connection` and `workers` are the
//    two keys a worker is built out of and they apply together, so a refusal
//    that held for one of them and not the other would be a half-built worker:
//    the right number of tasks dialled at the wrong database, or the reverse.
array<string> $keys = ['queue.workers', 'queue.connection', 'QUEUE.WORKERS', 'queue.workers ', 'app.0.queue.workers'];
foreach ($keys as string $key) {
    Core\Config::set($key, '64');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 3. All of it as fast as the runtime will take it, reading the count back every
//    round. The value is read when a worker is built rather than per job, so a
//    write that nevertheless reached the published snapshot would be invisible
//    until a restart acted on it — here it shows as the standing count moving,
//    which is the only place a request could ever see it.
uint $changes = 0;
string $standing = Core\Config::get('queue.workers') ?? '(nothing written)';
uint $i = 0;
while ($i < 200000) {
    Core\Config::set('queue.workers', '64');
    Core\Config::set('queue.workers', '0');
    Core\Config::restore('queue.workers');
    if ((Core\Config::get('queue.workers') ?? '(nothing written)') != $standing) {
        $changes = $changes + 1;
    }
    $i = $i + 1;
}

// 4. And real work alongside it, because the request asking for more workers is
//    a request already using the machine it is asking for more of.
array<string> $work = [];
uint $j = 0;
while ($j < 20000) {
    $work[] = 'batch-' . $j . '-' . Core\Str::repeat('y', $j % 64);
    $j = $j + 1;
}

echo 'changes: ', $changes, "\n";
echo 'work built: ', Core\Arr::count($work), "\n";
echo 'workers:    ', Core\Config::get('queue.workers') ?? '(nothing written)', "\n";
echo 'connection: ', Core\Config::get('queue.connection') ?? '(nothing written)', "\n";
