<?nvs
// Attack: a program tries to change `[debug] tls_key_file`, so the debug viewer uses a private key
// that the program knows. It also tries paths outside the folder and paths that are not files.
// Every change should fail, and the setting should stay unset.

// 1. Set paths to other keys. Each change should fail.
array<string> $paths = [
    '/etc/novis/debug.key',
    '/tmp/debug.key',
    'debug.key',
    './debug.key',
    '../../../../etc/ssl/private/server.key',
    '/etc/novis/../../tmp/debug.key',
    '/dev/stdin',
    '/dev/zero',
    '/proc/self/environ',
    'C:\\Windows\\debug.key',
    '\\\\example.com\\share\\debug.key',
    'https://example.com/debug.key',
];
foreach ($paths as string $path) {
    Core\Config::set('debug.tls_key_file', $path);
}
Core\Config::restore('debug.tls_key_file');

// 2. Set values that are empty or that contain control characters. Each change should fail.
array<string> $words = ['', ' ', '.', '/', "/tmp/a.key\0.pem", "/tmp/a.key\n/tmp/b.key", '-----BEGIN PRIVATE KEY-----'];
foreach ($words as string $word) {
    Core\Config::set('debug.tls_key_file', $word);
}
Core\Config::restore('debug.tls_key_file');

// 3. Set a very long path. A slow check or a crash would show here.
string $long = '/' . Core\Str::repeat('a/', 50000) . 'debug.key';
Core\Config::set('debug.tls_key_file', $long);
Core\Config::restore('debug.tls_key_file');

// 4. Set keys that are almost the real key: extra dots, capital letters and other names.
array<string> $nearby = [
    'debug.tls_key_file.',
    '.debug.tls_key_file',
    'debug..tls_key_file',
    'DEBUG.TLS_KEY_FILE',
    'debug.tls-key-file',
    'debug.tls_key',
    'debug.key_file',
    'tls_key_file',
    'debug',
    'server.tls_key_file',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, '/tmp/debug.key');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 5. Try the same change 50,000 times. Each try should fail and leave nothing behind.
uint $i = 0;
while ($i < 50000) {
    Core\Config::set('debug.tls_key_file', '/tmp/debug.key');
    Core\Config::restore('debug.tls_key_file');
    $i = $i + 1;
}

// 6. The setting should still be unset.
echo 'debug.tls_key_file: ', Core\Config::get('debug.tls_key_file') ?? '(nothing)', "\n";
