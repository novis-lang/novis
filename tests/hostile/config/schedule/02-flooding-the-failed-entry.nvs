<?nvs
// Attack: a request adds hundreds of queue jobs that fail, so that a `failed` entry
// runs once for each failure. The `failed` entry should run at most once a minute,
// and a program should not be able to change or read that limit.
// hostile: timeout-ms 20000
use Core\Queue;

// The jobs table is made first. If no database is allowed, the error is caught
// and the steps below still run.
var $jobs = <<<'SQL'
create table nvs_jobs (id integer primary key autoincrement, queue varchar(255) not null,
    script text not null, args text, state smallint not null, attempts integer not null,
    max_attempts integer not null, backoff_ms bigint not null, run_at bigint not null,
    tag varchar(255), dedupe_key varchar(255), dedupe_pending varchar(255),
    created_at bigint not null, claimed_at bigint, errors text, grants text, limits text,
    non_transactional smallint, token text, constraint nvs_jobs_dedupe unique (dedupe_pending))
SQL;
try {
    Core\Db::connect('jobs')->execute($jobs, []);
} catch (Throwable $e) {
    echo "no jobs table\n";
}

// 1. Adds 300 jobs that may run only once, for a script that does not exist.
//    Each error is caught, so the next job is still added.
uint $added = 0;
uint $errors = 0;
uint $i = 0;
while ($i < 300) {
    try {
        Queue::push('jobs/missing.nvs', { queue: 'fail', maxAttempts: 1, args: ['n' => $i] });
        $added = $added + 1;
    } catch (Throwable $e) {
        $errors = $errors + 1;
    }
    $i = $i + 1;
}

// 2. Adds 300 more jobs on 300 different queues, so each failure looks different.
uint $j = 0;
while ($j < 300) {
    try {
        Queue::push('jobs/missing.nvs', { queue: 'fail-' . $j, maxAttempts: 1 });
        $added = $added + 1;
    } catch (Throwable $e) {
        $errors = $errors + 1;
    }
    $j = $j + 1;
}

// 3. Tries to change the `failed` entry and its limit through `Core\Config`.
//    Every write should fail, and every read should return `null`.
array<string> $keys = [
    'schedule.0.on',
    'schedule.0.cron',
    'schedule.0.overlap',
    'schedule.on',
    'schedule.failed',
    'schedule.0.failed',
    'schedule.0.interval',
    'schedule.0.every',
    'schedule.0.min_interval',
    'schedule.floor',
    'server.schedule_poll',
    'queue.dead_letter',
];
array<string> $values = ['failed', 'start', 'stop', 'reload', '0', '1s', '* * * * *', ''];
uint $visible = 0;
foreach ($keys as string $key) {
    foreach ($values as string $value) {
        Core\Config::set($key, $value);
    }
    if (Core\Config::get($key) != null) {
        $visible = $visible + 1;
    }
    Core\Config::restore($key);
}

echo 'added: ', $added, "\n";
echo 'errors: ', $errors, "\n";
echo 'visible: ', $visible, "\n";
