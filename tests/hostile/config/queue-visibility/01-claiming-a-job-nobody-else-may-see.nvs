<?nvs
// Attack: a request tries to change `queue.visibility`. A very short time lets two
// workers run the same job. A very long time hides a job for days after its worker
// stops. Every write should fail, and the value should stay the configured one.
// hostile: timeout-ms 20000

// 1. Tries durations in many forms, and values that are not durations. In
//    `[limits]`, `false` means "no limit", so it is tried too.
array<string> $leases = [
    '0',
    '0s',
    '0ms',
    '-0s',
    '-1s',
    '1ms',
    '5m',
    '300s',
    '300',
    'false',
    'true',
    '',
    'null',
    'forever',
    'inf',
    'nan',
    '5 m',
    ' 5m ',
    "5m\u{0000}",
    '5M',
    '5min',
    '5mm',
    '5h5m',
    '0x5',
    '1e9s',
    '18446744073709551615s',
    '18446744073709551616s',
    Core\Str::repeat('9', 100000) . 's',
    '0.' . Core\Str::repeat('0', 100000) . '1s',
];
foreach ($leases as string $lease) {
    Core\Config::set('queue.visibility', $lease);
    Core\Config::set('app.0.queue.visibility', $lease);
    Core\Config::restore('queue.visibility');
}

// 2. Tries keys that are almost `queue.visibility`, such as `visibility_timeout`.
//    Every write should fail.
array<string> $keys = [
    'queue.visibility',
    'QUEUE.VISIBILITY',
    'queue.visibility ',
    'queue.visibility_timeout',
    'queue.visible',
    'queue..visibility',
    'app.0.queue.visibility',
    "queue.visibility\u{0000}",
];
foreach ($keys as string $key) {
    Core\Config::set($key, '1ms');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 3. Writes and reads the value 200,000 times. The server reads it each time it
//    takes a job. The value should never change, so this prints `0`.
uint $changes = 0;
string $standing = Core\Config::get('queue.visibility') ?? '(nothing written)';
uint $i = 0;
while ($i < 200000) {
    Core\Config::set('queue.visibility', '1ms');
    Core\Config::set('queue.visibility', '0s');
    Core\Config::restore('queue.visibility');
    if ((Core\Config::get('queue.visibility') ?? '(nothing written)') != $standing) {
        $changes = $changes + 1;
    }
    $i = $i + 1;
}

// 4. Builds 20,000 job strings, as a real request would. The settings should
//    still be the configured values after this work.
array<string> $claims = [];
uint $j = 0;
while ($j < 20000) {
    $claims[] = 'claim-' . $j . '-' . Core\Str::repeat('w', $j % 64);
    $j = $j + 1;
}

echo 'changes: ', $changes, "\n";
echo 'claims built: ', Core\Arr::count($claims), "\n";
echo 'visibility:   ', Core\Config::get('queue.visibility') ?? '(nothing written)', "\n";
echo 'max_attempts: ', Core\Config::get('queue.max_attempts') ?? '(nothing written)', "\n";
