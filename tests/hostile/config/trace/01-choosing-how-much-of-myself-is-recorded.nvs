<?nvs
// Attack: a request tries to change `trace.sample`, the share of requests that is
// traced, and three other `[trace]` keys. Every write should fail. At the end,
// `sample`, `propagate`, `exporter` and `endpoint` should still be the configured values.
// hostile: timeout-ms 20000

// `Core\Config::set('trace.sample', ...)` does not compile, because a program may not change `trace.sample`.
// This program keeps the names in variables. The compiler does not check a variable, so `set` runs and returns `false`.
string $sample = 'trace.sample';
string $appSample = 'app.0.trace.sample';
string $propagate = 'trace.propagate';
string $exporter = 'trace.exporter';
string $endpoint = 'trace.endpoint';

// 1. Tries numbers written in many ways, including `nan`, `inf`, `50%` and very
//    long numbers. Every write should fail.
array<string> $fractions = [
    '0.0',
    '1.0',
    '0',
    '1',
    '-0.0',
    '-0.000001',
    '1.0000000000000002',
    '0.5000000000000001',
    'nan',
    'NaN',
    'inf',
    '-inf',
    'Infinity',
    '1e400',
    '1e-400',
    '0x1',
    '1/2',
    '50%',
    ' 0.5 ',
    "0.5\u{0000}",
    "0\u{066B}5",
    '0.' . Core\Str::repeat('9', 100000),
    Core\Str::repeat('1', 100000) . '.0',
];
foreach ($fractions as string $fraction) {
    Core\Config::set($sample, $fraction);
    Core\Config::set($appSample, $fraction);
    Core\Config::restore($sample);
}

// 2. Tries to turn off the trace header on outgoing calls, and to change the
//    exporter and endpoint. Every write should fail.
array<string> $flags = ['false', 'FALSE', 'False', '0', 'no', 'off', 'null', '', 'true', '2'];
foreach ($flags as string $flag) {
    Core\Config::set($propagate, $flag);
    Core\Config::set($exporter, $flag);
    Core\Config::set($endpoint, 'http://127.0.0.1:1/' . $flag);
    Core\Config::restore($propagate);
}

// 3. Writes all four keys 200,000 times and reads the sample back each time.
//    The value should never change, so this prints `0`.
uint $changes = 0;
string $standing = Core\Config::get('trace.sample') ?? '(no value)';
uint $i = 0;
while ($i < 200000) {
    Core\Config::set($sample, '1.0');
    Core\Config::set($propagate, 'false');
    Core\Config::set($exporter, 'otlp');
    Core\Config::set($endpoint, 'https://collector.mine/v1');
    Core\Config::restore($sample);
    if ((Core\Config::get('trace.sample') ?? '(no value)') != $standing) {
        $changes = $changes + 1;
    }
    $i = $i + 1;
}

// 4. Builds 20,000 strings. The settings should still
//    be the configured values after this work.
array<string> $spans = [];
uint $j = 0;
while ($j < 20000) {
    $spans[] = 'span-' . $j . '-' . Core\Str::repeat('x', $j % 64);
    $j = $j + 1;
}

echo 'changes: ', $changes, "\n";
echo 'spans built: ', Core\Arr::count($spans), "\n";
echo 'sample:    ', Core\Config::get('trace.sample') ?? '(no value)', "\n";
echo 'exporter:  ', Core\Config::get('trace.exporter') ?? '(no value)', "\n";
echo 'propagate: ', Core\Config::get('trace.propagate') ?? '(no value)', "\n";
