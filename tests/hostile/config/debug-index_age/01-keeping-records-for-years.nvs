<?nvs
// Attack: a program tries to change `[debug] index_age`, so `nvs debug` keeps its records for years.
// It also tries to set the time to zero, so other records are deleted at once.
// Every change should fail, and the setting should keep the value from the file.

// 1. Set `debug.index_age` to very long times, to zero and to negative times. Each change should fail.
array<string> $times = [
    '3650d',
    '99999999999999999999d',
    '9223372036854775807s',
    '18446744073709551616ms',
    '0',
    '0s',
    '-1d',
    '-7d',
    '1d',
    '7d',
];
foreach ($times as string $time) {
    Core\Config::set('debug.index_age', $time);
}
Core\Config::restore('debug.index_age');

// 2. Set values that are not times. Each change should fail.
array<string> $words = ['', ' ', 'forever', 'never', 'NaN', 'inf', '1e30d', '7', "7d\n3650d", '7d 3650d'];
foreach ($words as string $word) {
    Core\Config::set('debug.index_age', $word);
}
Core\Config::restore('debug.index_age');

// 3. Set keys that are almost the real key: extra dots, capital letters and other names.
array<string> $nearby = [
    'debug.index_age.',
    '.debug.index_age',
    'debug..index_age',
    'debugindex_age',
    'DEBUG.INDEX_AGE',
    'Debug.Index_Age',
    'debug.index-age',
    'debug.index',
    'index_age',
    'debug',
    'log.index_age',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, '3650d');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 4. Use a key with 10,000 parts. A slow key lookup or a stack overflow would show here.
string $deep = 'debug.index_age.' . Core\Str::repeat('scope.', 10000) . 'days';
Core\Config::set($deep, '3650d');
Core\Config::get($deep);
Core\Config::restore($deep);

// 5. Try the same change 50,000 times. Each try should fail and leave nothing behind.
uint $i = 0;
while ($i < 50000) {
    Core\Config::set('debug.index_age', '3650d');
    Core\Config::restore('debug.index_age');
    $i = $i + 1;
}

// 6. The setting should still be the value from the file.
echo 'debug.index_age: ', Core\Config::get('debug.index_age') ?? '(nothing)', "\n";
