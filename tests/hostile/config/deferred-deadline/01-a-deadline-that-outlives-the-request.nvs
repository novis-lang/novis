<?nvs
// Attack: make after-response work outlast its budget. `[deferred] deadline` is
// one of the few keys a request may genuinely write, so the attack is not "can
// it be written" but "what can be written into it": a deadline longer than the
// machine will be up for, one that is not a time at all, one megabyte of one,
// and fifty thousand of them in a row. Beside it sits the key that is *not* a
// request's -- the number of request trees a core keeps alive -- because raising
// that is how one program would make every other program's deferred work wait.

// 1. The sibling that bounds the host. Every spelling of a bigger number, and
//    the values that mean "no bound at all" if anything reads them loosely: a
//    request that got one of these through would be sizing somebody else's
//    machine from inside a request it does not own.
array<string> $caps = ['4096', '18446744073709551615', '-1', '0', 'true', '', 'unlimited'];
foreach ($caps as string $cap) {
    Core\Config::set('deferred.max_concurrent', $cap);
}
Core\Config::restore('deferred.max_concurrent');

// 2. The deadline itself, at both ends of what a duration can be and past them.
//    Nothing here is expected to be useful; what is expected is that a value
//    nobody can use is still a value nothing comes apart on, at the write and at
//    the read alike.
array<string> $deadlines = [
    '0s',
    '0',
    '-1s',
    '-9223372036854775808s',
    '9223372036854775807s',
    '99999999999999999999999h',
    '30',
    '30 s',
    '30ss',
    '3.0e10s',
    'banana',
    '',
    ' ',
    "30s\u{0000}forever",
];
foreach ($deadlines as string $deadline) {
    Core\Config::set('deferred.deadline', $deadline);
    Core\Config::get('deferred.deadline');
}
Core\Config::restore('deferred.deadline');

// 3. One value big enough to be the attack by itself: a megabyte of digits is
//    not a duration, and whatever refuses it has to refuse it without parsing
//    its way through the whole thing first.
string $flood = Core\Str::repeat('9', 1000000) . 's';
Core\Config::set('deferred.deadline', $flood);
Core\Config::get('deferred.deadline');
Core\Config::restore('deferred.deadline');

// 4. Names that sit near the real one, because the registry answers by longest
//    prefix: a row reached for a key nobody declared would be governing the
//    block's other half as well, and that half is the operator's.
array<string> $nearby = [
    'deferred.deadline.',
    '.deferred.deadline',
    'deferred..deadline',
    'deferreddeadline',
    'deferred.deadline.default',
    'DEFERRED.DEADLINE',
    'Deferred.Deadline',
    'deadline',
    'deferred',
    'deferred.max_concurrent.deadline',
    'app.deferred.deadline',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, '9999h');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 5. A key long enough to be a walk rather than a lookup: the prefix rule scans
//    back through the dots, so twenty thousand of them is the shape that finds a
//    quadratic one or a stack that recurses per segment.
string $deep = 'deferred.deadline.' . Core\Str::repeat('scope.', 10000) . 'default';
Core\Config::set($deep, '9999h');
Core\Config::get($deep);
Core\Config::restore($deep);

// 6. Fifty thousand writes, each with its own value, and never a restore between
//    them. The overlay a request writes into is the thing under attack here: it
//    has to hold one entry for this key rather than one per write, or a request
//    that sets a deadline in a loop is a request that exhausts its own memory.
uint $i = 0;
while ($i < 50000) {
    Core\Config::set('deferred.deadline', $i . 's');
    $i = $i + 1;
}
Core\Config::restore('deferred.deadline');

// 7. And a restore of a key this program never wrote, twice, because a drop that
//    assumes it is dropping something is a drop that has something to get wrong.
Core\Config::restore('deferred.deadline');
Core\Config::restore('deferred.max_concurrent');

echo 'deadline: ', Core\Config::get('deferred.deadline') ?? '(nothing)', "\n";
echo 'cap:      ', Core\Config::get('deferred.max_concurrent') ?? '(nothing)', "\n";
