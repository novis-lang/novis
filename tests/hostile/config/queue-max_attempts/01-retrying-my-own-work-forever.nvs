<?nvs
// Attack: a request tries to raise or lower `queue.max_attempts`. A higher value
// retries a failing job for too long, and `0` would never run it. Every write
// should fail, and the value should stay the configured one.
// hostile: timeout-ms 20000

// 1. Tries many numbers, from `0` and negative values to numbers too large to
//    store, and values that are not numbers. Every write should fail.
array<string> $attempts = [
    '0',
    '-0',
    '-1',
    '1',
    '5',
    'false',
    'true',
    '',
    'null',
    'none',
    'unlimited',
    'inf',
    'nan',
    '0.9',
    '4294967295',
    '4294967296',
    '18446744073709551615',
    '18446744073709551616',
    '1e9',
    '0x10',
    ' 5 ',
    "5\u{0000}",
    Core\Str::repeat('9', 100000),
    '-' . Core\Str::repeat('9', 100000),
];
foreach ($attempts as string $attempt) {
    Core\Config::set('queue.max_attempts', $attempt);
    Core\Config::set('app.0.queue.max_attempts', $attempt);
    Core\Config::restore('queue.max_attempts');
}

// 2. Tries this key, `queue.visibility` and keys that are almost the same. The
//    server reads both keys each time it takes a job, so a change would apply at once.
array<string> $keys = [
    'queue.max_attempts',
    'queue.visibility',
    'QUEUE.MAX_ATTEMPTS',
    'queue.max_attempts ',
    'queue.maxattempts',
    'queue.max-attempts',
    'app.0.queue.max_attempts',
];
foreach ($keys as string $key) {
    Core\Config::set($key, '1000000');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 3. Writes and reads the value 200,000 times. The value should never change,
//    so this prints `0`.
uint $changes = 0;
string $standing = Core\Config::get('queue.max_attempts') ?? '(nothing written)';
uint $i = 0;
while ($i < 200000) {
    Core\Config::set('queue.max_attempts', '1000000');
    Core\Config::set('queue.max_attempts', '0');
    Core\Config::restore('queue.max_attempts');
    if ((Core\Config::get('queue.max_attempts') ?? '(nothing written)') != $standing) {
        $changes = $changes + 1;
    }
    $i = $i + 1;
}

// 4. Builds 20,000 job strings, as a real request would. The settings should
//    still be the configured values after this work.
array<string> $jobs = [];
uint $j = 0;
while ($j < 20000) {
    $jobs[] = 'attempt-' . $j . '-' . Core\Str::repeat('z', $j % 64);
    $j = $j + 1;
}

echo 'changes: ', $changes, "\n";
echo 'jobs built: ', Core\Arr::count($jobs), "\n";
echo 'max_attempts: ', Core\Config::get('queue.max_attempts') ?? '(nothing written)', "\n";
echo 'visibility:   ', Core\Config::get('queue.visibility') ?? '(nothing written)', "\n";
