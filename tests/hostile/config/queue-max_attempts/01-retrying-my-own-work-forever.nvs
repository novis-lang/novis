<?nvs
// Attack: the bound that makes a failing job stop, pushed by the request that
// enqueued it. Both directions are worth taking — a bound raised is a job that
// keeps costing a worker, a connection and a row long after it was going to
// succeed, and every other job in the same queue waits behind it; a bound
// lowered is work that stops being retried and therefore stops arriving, which
// nothing downstream can tell from work that succeeded. Zero is the shape the
// boot refuses outright, so the pressure here is on every spelling that might
// arrive as one. The bound still reading what the deployment configured is the
// evidence that none of them did.
// hostile: timeout-ms 20000

// 1. Every shape a count of attempts can be written in. The ones that matter
//    are at the two ends: a spelling that folds to zero is a job dead-lettered
//    by the enqueue that created it, and one that folds to a number nothing
//    reaches is the unbounded retry § 6 has no spelling for, arriving as a
//    number instead of as a word.
array<string> $attempts = [
    '0',
    '-0',
    '-1',
    '1',
    '5',
    'false',
    'true',
    '',
    'null',
    'none',
    'unlimited',
    'inf',
    'nan',
    '0.9',
    '4294967295',
    '4294967296',
    '18446744073709551615',
    '18446744073709551616',
    '1e9',
    '0x10',
    ' 5 ',
    "5\u{0000}",
    Core\Str::repeat('9', 100000),
    '-' . Core\Str::repeat('9', 100000),
];
foreach ($attempts as string $attempt) {
    Core\Config::set('queue.max_attempts', $attempt);
    Core\Config::set('app.0.queue.max_attempts', $attempt);
    Core\Config::restore('queue.max_attempts');
}

// 2. The lease beside it, under the same writes. These are the block's two
//    `Reload` keys — both read out of the published snapshot as a job is
//    claimed rather than when a worker is built — so a write that reached the
//    snapshot would be in force for the very next job, and neither of them has
//    a restart standing between the write and the effect.
array<string> $keys = [
    'queue.max_attempts',
    'queue.visibility',
    'QUEUE.MAX_ATTEMPTS',
    'queue.max_attempts ',
    'queue.maxattempts',
    'queue.max-attempts',
    'app.0.queue.max_attempts',
];
foreach ($keys as string $key) {
    Core\Config::set($key, '1000000');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 3. All of it as fast as the runtime will take it, reading the bound back
//    every round. There is no restart between this write and the job it would
//    govern, so the standing value moving here is the whole failure — a job
//    claimed one instruction later would be retried under it.
uint $changes = 0;
string $standing = Core\Config::get('queue.max_attempts') ?? '(nothing written)';
uint $i = 0;
while ($i < 200000) {
    Core\Config::set('queue.max_attempts', '1000000');
    Core\Config::set('queue.max_attempts', '0');
    Core\Config::restore('queue.max_attempts');
    if ((Core\Config::get('queue.max_attempts') ?? '(nothing written)') != $standing) {
        $changes = $changes + 1;
    }
    $i = $i + 1;
}

// 4. And real work alongside, because a request that wants its own job retried
//    forever is a request in the middle of enqueueing it.
array<string> $jobs = [];
uint $j = 0;
while ($j < 20000) {
    $jobs[] = 'attempt-' . $j . '-' . Core\Str::repeat('z', $j % 64);
    $j = $j + 1;
}

echo 'changes: ', $changes, "\n";
echo 'jobs built: ', Core\Arr::count($jobs), "\n";
echo 'max_attempts: ', Core\Config::get('queue.max_attempts') ?? '(nothing written)', "\n";
echo 'visibility:   ', Core\Config::get('queue.visibility') ?? '(nothing written)', "\n";
