<?nvs
// Attack: hand this program a capability the file never granted it. The
// `[capabilities]` block is the one row a request may write at all, and only
// ever downwards -- so every spelling below is an attempt to make that one
// opening widen instead: a grant written directly, a grant written under a name
// that resolves near the real one, and a refusal worn down by being asked a
// hundred thousand times. A single `true` getting through is a program deciding
// its own authority.

// 1. Every grant this deployment knows about, written from inside the request
//    that would benefit. The values are the ones that mean "everything" if
//    anything reads them loosely.
array<string> $grants = [
    'capabilities',
    'capabilities.fs.read',
    'capabilities.fs.write',
    'capabilities.net.connect',
    'capabilities.net.listen',
    'capabilities.net.internal',
    'capabilities.script.spawn',
    'capabilities.process.exec',
    'capabilities.db.connect',
    'capabilities.db.open',
    'capabilities.db.schema',
    'capabilities.tls.insecure',
    'capabilities.tls.any_name',
    'capabilities.mail.send',
    'capabilities.cache.shared',
    'capabilities.queue.purge',
    'capabilities.debug.trace',
];
array<string> $everything = ['true', 'True', 'TRUE', '1', '*', '/', 'C:\\', '["/"]', '["*"]', 'yes', 'on', '-1'];
foreach ($grants as string $grant) {
    foreach ($everything as string $value) {
        Core\Config::set($grant, $value);
    }
    // And the other direction, because a narrowing this row cannot compare is
    // refused too: a `set` that took even this would mean the comparison ran.
    Core\Config::set($grant, 'false');
    Core\Config::restore($grant);
}

// 2. Names that sit near the real ones, because the registry answers by longest
//    prefix and a row reached for a key nobody declared would be governing the
//    block's neighbours as well.
array<string> $nearby = [
    'capabilities.',
    '.capabilities',
    'capabilities..fs..read',
    'capabilitiesfs.read',
    'CAPABILITIES.FS.READ',
    'Capabilities.Fs.Read',
    'capabilities.nvs_no_such_grant',
    'capabilities.fs.read.root',
    'app.capabilities.fs.read',
    'app.0.capabilities.fs.read',
    'fs.read',
    'read',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, 'true');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 3. A key long enough to be a walk rather than a lookup: the prefix rule is a
//    scan back through the dots, so twenty thousand of them is the shape that
//    finds a quadratic one or a stack that recurses per segment.
string $deep = 'capabilities.fs.read.' . Core\Str::repeat('scope.', 10000) . 'root';
Core\Config::set($deep, 'true');
Core\Config::get($deep);
Core\Config::restore($deep);

// 4. The same refusal, a hundred thousand times, in case it is decided once
//    and remembered -- or in case each attempt leaves something behind in the
//    overlay a request writes into.
uint $i = 0;
while ($i < 100000) {
    Core\Config::set('capabilities.fs.write', 'true');
    Core\Config::restore('capabilities.fs.write');
    $i = $i + 1;
}

// 5. The doors themselves, after all of that. Neither grant was ever written
//    for this program, so both have to refuse -- and a door that consulted an
//    overlay rather than the grant would now be open.
try {
    Core\IO::write('tests/hostile/config/capabilities/claimed.txt', 'granted after all');
    echo "fs.write opened\n";
} catch (RuntimeError $refused) {
    echo "fs.write still refused\n";
}
try {
    var $store = Core\Cache::shared();
    $store->put('claimed', 'mine');
    echo "cache.shared opened\n";
} catch (RuntimeError $refused) {
    echo "cache.shared still refused\n";
}

// 6. And the one grant this program does hold, arriving from the block that
//    covers every program in this checkout. The attack must not have moved it
//    either: a block that can be written from inside is broken in both
//    directions, and a `false` here would be this request having narrowed a
//    right for whatever reads the snapshot next.
echo 'run scripts: ', Core\Config::get('capabilities.script.spawn') ?? '(nothing)', "\n";
