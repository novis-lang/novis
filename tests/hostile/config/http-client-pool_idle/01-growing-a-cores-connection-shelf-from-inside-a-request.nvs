<?nvs
// Attack: the cap bounds memory a *core* holds after this request is gone, so
// the attack is every way of reaching it that is not the key's own name — the
// key spelled sideways, a name invented underneath it that might fall through
// to the request-settable blanket row beside it, the number written as
// something the reader has to guess at, and then a loop that asks a few hundred
// thousand times in case the refusal is only the first answer.
// hostile: timeout-ms 30000

// 1. The key itself, written as everything a cap could be written as: a number
//    past what any counter holds, a negative one, a size where a count goes, a
//    removal spelled as `false`, and nothing at all.
array<string> $values = [
    '18446744073709551615',
    '9223372036854775808',
    '-1',
    '0',
    '',
    'false',
    'true',
    'null',
    '512M',
    '1e9',
    '0x10000',
    '  4096  ',
    "16\u{0000}1048576",
    Core\Str::repeat('9', 100000),
];
foreach ($values as string $value) {
    Core\Config::set('http.client.pool_idle', $value);
    Core\Config::get('http.client.pool_idle');
}
Core\Config::restore('http.client.pool_idle');

// 2. Names invented underneath the cap. The blanket row over this whole block
//    answers `Runtime`, so a lookup that failed to reach the cap's own row would
//    not fail loudly — it would land on a row a request may set, which is the
//    one shape of this bug nothing else would notice.
array<string> $beneath = [
    'http.client.pool_idle.max',
    'http.client.pool_idle.default',
    'http.client.pool_idle.per_core',
    'http.client.pool_idle.0',
    'http.client.pool_idle..max',
    'http.client.pool_idle.' . Core\Str::repeat('sub.', 20000) . 'max',
];
foreach ($beneath as string $key) {
    Core\Config::set($key, '1048576');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 3. The key spelled sideways, because the registry answers by longest prefix
//    on dot boundaries and a near miss is how a cap comes to be governed by
//    something that is not it.
array<string> $sideways = [
    'http.client.pool_idlex',
    'http.client.pool_idle ',
    ' http.client.pool_idle',
    'HTTP.CLIENT.POOL_IDLE',
    'Http.Client.Pool_Idle',
    'http..client.pool_idle',
    'httpclient.pool_idle',
    'http.client.poolidle',
    'pool_idle',
    'client.pool_idle',
    'app.http.client.pool_idle',
    'http.client.pool_idle.pool_idle',
];
foreach ($sideways as string $key) {
    Core\Config::set($key, '1048576');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 4. Two hundred thousand refusals in a row with no restore between them. A
//    refusal that recorded an overlay entry anyway would be a request growing
//    its own snapshot by asking for something it is not allowed to have.
uint $i = 0;
while ($i < 200000) {
    Core\Config::set('http.client.pool_idle', '1048576');
    $i = $i + 1;
}
Core\Config::restore('http.client.pool_idle');

echo 'pool_idle: ', Core\Config::get('http.client.pool_idle') ?? '(nothing)', "\n";
