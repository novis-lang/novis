<?nvs
// Attack: a request tries to store more than `[cache.local] max_size` allows, and then to
// raise that limit. The cache should delete old entries, and every change to the limit should fail.
// The test writes 1 GB into a 32 MB cache, so it needs more time than usual.
// hostile: timeout-ms 40000

var $cache = Core\Cache::local();

// 1. Store 1 GB in 1 MB entries. The cache should delete old entries to stay under the limit.
string $megabyte = Core\Str::repeat('x', 1048576);
uint $i = 0;
while ($i < 1024) {
    $cache->put('bulk:' . $i, $megabyte);
    $i = $i + 1;
}

// 2. Store one entry that is four times larger than the whole limit.
$cache->put('oversized', Core\Str::repeat('y', 134217728));

// 3. Use 10 MB keys with 8-byte values. A key counts toward the limit too.
uint $k = 0;
while ($k < 16) {
    $cache->put(Core\Str::repeat('k', 10485760) . $k, 'eight!!!');
    $k = $k + 1;
}

// 4. Write and delete the same key 100,000 times. Only stored entries should count.
uint $c = 0;
while ($c < 100000) {
    $cache->put('hot', $c);
    $cache->forget('hot');
    $c = $c + 1;
}

// 5. Raise the limit, remove it with `false`, or set it to values that are not sizes.
array<string> $raises = [
    '1G',
    '1024G',
    '9223372036854775807',
    '-1',
    '0',
    'false',
    '',
    '32M',
];
foreach ($raises as string $value) {
    Core\Config::set('cache.local.max_size', $value);
    Core\Config::set('cache.local', $value);
    Core\Config::set('cache', $value);
}
Core\Config::restore('cache.local.max_size');

// The limit should still be the value from the file. `hot` was deleted in step 4,
// so this prints `(forgotten)`.
echo 'cap: ', Core\Config::get('cache.local.max_size') ?? '(the built-in cap)', "\n";
echo 'hot: ', $cache->get('hot') ?? '(forgotten)', "\n";
