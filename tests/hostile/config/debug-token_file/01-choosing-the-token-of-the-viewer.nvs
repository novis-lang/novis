<?nvs
// Attack: a program tries to change `[debug] token_file`, so the debug viewer opens with a token
// that the program knows. Anybody with that token could then read the recorded requests.
// Every change should fail, and the setting should stay unset.

// 1. Set paths to other token files. Each change should fail.
array<string> $paths = [
    '/etc/novis/debug.token',
    '/tmp/debug.token',
    'debug.token',
    './debug.token',
    '../../../../etc/hostname',
    '/etc/novis/../../tmp/debug.token',
    '/dev/stdin',
    '/dev/null',
    '/proc/self/environ',
    'C:\\Windows\\debug.token',
    '\\\\example.com\\share\\debug.token',
    'https://example.com/debug.token',
];
foreach ($paths as string $path) {
    Core\Config::set('debug.token_file', $path);
}
Core\Config::restore('debug.token_file');

// 2. Set values that are empty, that are a token or that contain control characters. Each change should fail.
array<string> $words = ['', ' ', '.', '/', "/tmp/a.token\0.txt", "/tmp/a.token\n/tmp/b.token", '0123456789abcdef'];
foreach ($words as string $word) {
    Core\Config::set('debug.token_file', $word);
}
Core\Config::restore('debug.token_file');

// 3. Set a very long path. A slow check or a crash would show here.
string $long = '/' . Core\Str::repeat('a/', 50000) . 'debug.token';
Core\Config::set('debug.token_file', $long);
Core\Config::restore('debug.token_file');

// 4. Set keys that are almost the real key: extra dots, capital letters and other names.
array<string> $nearby = [
    'debug.token_file.',
    '.debug.token_file',
    'debug..token_file',
    'DEBUG.TOKEN_FILE',
    'debug.token-file',
    'debug.token',
    'debug.tokenfile',
    'token_file',
    'debug',
    'server.token_file',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, '/tmp/debug.token');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 5. Try the same change 50,000 times. Each try should fail and leave nothing behind.
uint $i = 0;
while ($i < 50000) {
    Core\Config::set('debug.token_file', '/tmp/debug.token');
    Core\Config::restore('debug.token_file');
    $i = $i + 1;
}

// 6. The setting should still be unset.
echo 'debug.token_file: ', Core\Config::get('debug.token_file') ?? '(nothing)', "\n";
