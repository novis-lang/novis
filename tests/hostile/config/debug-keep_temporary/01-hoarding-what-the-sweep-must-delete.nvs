<?nvs
// Attack: a request tries to keep the temporary directories that are deleted when it ends.
// First it tries to change `[debug] keep_temporary`, and every change should fail.
// Then it makes directories that are hard to delete. All of them should still be deleted.

// 1. Set `keep_temporary` and `io.temp_root` to values that could mean "yes" or a new path.
array<string> $keys = ['debug.keep_temporary', 'io.temp_root', 'debug', 'io'];
array<string> $yes = ['true', 'True', 'TRUE', '1', 'on', 'yes', '-1', '/', 'C:\\', '.'];
foreach ($keys as string $key) {
    foreach ($yes as string $value) {
        Core\Config::set($key, $value);
    }
    Core\Config::restore($key);
}

// 2. Set keys that are almost the real key: extra dots, capital letters and other names.
array<string> $nearby = [
    'debug.keep_temporary.',
    '.debug.keep_temporary',
    'debug..keep_temporary',
    'debugkeep_temporary',
    'debug.keep_temporary.root',
    'DEBUG.KEEP_TEMPORARY',
    'Debug.Keep_Temporary',
    'debug.keep-temporary',
    'debug.keeptemporary',
    'keep_temporary',
    'app.debug.keep_temporary',
    'debug.inline.keep_temporary',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, 'true');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 3. Use a key with 10,000 parts. A slow key lookup or a stack overflow would show here.
string $deep = 'debug.keep_temporary.' . Core\Str::repeat('scope.', 10000) . 'root';
Core\Config::set($deep, 'true');
Core\Config::get($deep);
Core\Config::restore($deep);

// 4. Try the same change 50,000 times. Each try should fail and leave nothing behind.
uint $i = 0;
while ($i < 50000) {
    Core\Config::set('debug.keep_temporary', 'true');
    Core\Config::restore('debug.keep_temporary');
    $i = $i + 1;
}

// 5. Make 1,000 temporary directories with files in them, and delete none of them here.
uint $made = 0;
while ($made < 1000) {
    string $scratch = Core\IO::temporaryDir();
    Core\IO::write($scratch . '/order.csv', "order,total\n1042,19.90\n");
    Core\IO::write($scratch . '/order.csv.part', '');
    $made = $made + 1;
}

// 6. Make one directory 400 levels deep. Deleting it should not overflow the stack.
string $tower = Core\IO::temporaryDir();
string $path = $tower;
uint $level = 0;
while ($level < 400) {
    $path = $path . '/d';
    Core\IO::makeDir($path);
    $level = $level + 1;
}
Core\IO::write($path . '/bottom.txt', 'the last one');

// 7. Delete one temporary directory early, and replace another with a file. The cleanup should not fail.
string $vanished = Core\IO::temporaryDir();
Core\IO::removeDir($vanished);

string $swapped = Core\IO::temporaryDir();
Core\IO::removeDir($swapped);
Core\IO::write($swapped, 'no longer a directory');

// 8. `keep_temporary` should still be the value from the file.
echo 'keep_temporary: ', Core\Config::get('debug.keep_temporary') ?? '(nothing)', "\n";
