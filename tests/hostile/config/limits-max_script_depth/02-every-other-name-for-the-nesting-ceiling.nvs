<?nvs
// Attack: a request tries to change `limits.max_script_depth` with keys that are
// almost the same: other letter case, other prefixes, null bytes or `..`.
// Every write should fail.
// hostile: timeout-ms 30000

array<string> $names = [
    'limits.max_script_depth',
    'max_script_depth',
    'limits.MAX_SCRIPT_DEPTH',
    'limits.Max_Script_Depth',
    'limits.max_script_depth.',
    '.limits.max_script_depth',
    'limits..max_script_depth',
    'limits.max.script.depth',
    'limits.max-script-depth',
    'limits.maxscriptdepth',
    'limits.hard.max_script_depth',
    'limits.max_script_depth.hard',
    'app.limits.max_script_depth',
    'app.0.limits.max_script_depth',
    "limits.max_script_depth\u{0000}",
    "limits.memory\u{0000}limits.max_script_depth",
    'limits.memory/../max_script_depth',
    'limits.' . Core\Str::repeat('sub.', 20000) . 'max_script_depth',
];
foreach ($names as string $key) {
    Core\Config::set($key, 'false');
    Core\Config::set($key, '1000000');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// Tries many values on the real key: whole numbers, values that are not whole
// numbers, and `0` and `false`, which mean "no limit". Every write should fail.
array<string> $values = [
    '0',
    'false',
    'true',
    '-1',
    '1',
    '64',
    '65',
    '064',
    '  64  ',
    '64.5',
    '1e9',
    '0x40',
    '1_000',
    '4294967295',
    '4294967296',
    '18446744073709551615',
    '99999999999999999999999999',
    'sixty-four',
    '',
];
foreach ($values as string $value) {
    Core\Config::set('limits.max_script_depth', $value);
}
Core\Config::restore('limits.max_script_depth');

// Prints the limit, then starts the endless chain from the other file. The
// chain should stop at the limit, and this prints `yes`.
echo 'the ceiling reads: ', Core\Config::get('limits.max_script_depth') ?? '(nothing)', "\n";
// `Here::path` returns its argument as a full path. A relative path in a string literal
// starts at the folder of this file.
class Here {
    public static function path(#[Core\Path] string $path): string {
        return $path;
    }
}
string $endless = Here::path('01-a-chain-of-spawns-with-no-end.nvs');
var $chain = spawn script $endless with(
    output: 'capture',
);
var $done = await $chain;
echo 'the chain came back: ', $done->ok ? 'yes' : 'no', "\n";
