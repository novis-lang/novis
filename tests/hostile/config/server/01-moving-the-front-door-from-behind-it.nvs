<?nvs
// Attack: the server's own block, written from a request the server is already
// serving. Three keys here are worth more than the rest of the file put
// together. `listen` is which interface the deployment answers on, and a
// loopback server that started answering on every address is exposed without
// anybody having deployed anything. `trusted_proxies` is fail-closed and
// empty, so an entry added to it makes every forwarding header believed —
// which is the client address the logs, the rate limits and the allow-lists all
// read. And the four waits are what stops a connection that sends one byte a
// minute from holding a slot forever. Every one of them still reading what the
// file wrote is the evidence that the front door did not move.
// hostile: timeout-ms 20000

// 1. The address. Every spelling of "everywhere" is worth trying, because the
//    dangerous value is not a malformed one — it is a well-formed address that
//    a loopback deployment never meant to answer on.
array<string> $addresses = [
    '127.0.0.1:8000',
    '0.0.0.0:80',
    '0.0.0.0:0',
    '[::]:80',
    '[::ffff:0.0.0.0]:80',
    '*:80',
    ':80',
    '0:80',
    '2130706433:80',
    '127.1:80',
    '/tmp/nvs.sock',
    '/var/run/nvs.sock',
    "127.0.0.1:8000\u{0000}0.0.0.0:80",
    "127.0.0.1:8000\n0.0.0.0:80",
    '127.0.0.1:8000,0.0.0.0:80',
    Core\Str::repeat('0.0.0.0:80,', 100000),
];
foreach ($addresses as string $address) {
    Core\Config::set('server.listen', $address);
    Core\Config::set('server.listen.0', $address);
    Core\Config::set('app.0.server.listen', $address);
    Core\Config::restore('server.listen');
}

// 2. The proxy list, which is the quietest of the three: nothing crashes when
//    it grows, and everything downstream starts believing a header this request
//    wrote about itself.
array<string> $proxies = [
    '0.0.0.0/0',
    '::/0',
    '127.0.0.1',
    '10.0.0.0/8',
    '0.0.0.0/0,::/0',
    '',
    'true',
    Core\Str::repeat('0.0.0.0/0,', 100000),
];
foreach ($proxies as string $proxy) {
    Core\Config::set('server.trusted_proxies', $proxy);
    Core\Config::set('server.trusted_proxies.0', $proxy);
    Core\Config::restore('server.trusted_proxies');
}

// 3. The waits and the ceilings, in both directions. Lengthened, a wait is a
//    slot held by a connection doing nothing; removed, it is every slot. The
//    ceiling beside them is the count that refuses a request before anything is
//    allocated for it, so a raised one is the same attack spelled as a number.
array<string> $bounds = [
    'server.header_timeout',
    'server.body_idle_timeout',
    'server.write_idle_timeout',
    'server.keepalive_timeout',
    'server.drain_timeout',
    'server.max_in_flight',
    'server.workers',
    'server.root',
    'server.dispatch',
    'server.static',
    'server.health_path',
    'server.socket_mode',
    'SERVER.LISTEN',
    'server..listen',
    'app.0.server.header_timeout',
];
array<string> $values = ['0', '0s', 'false', '86400s', '4294967295', 'true', '/'];
foreach ($bounds as string $bound) {
    foreach ($values as string $value) {
        Core\Config::set($bound, $value);
    }
    Core\Config::get($bound);
    Core\Config::restore($bound);
}

// 4. All of it as fast as the runtime will take it, reading back every round.
//    The block is bound at boot, so a write that nevertheless reached the
//    published snapshot would not move a listener until a restart acted on it —
//    but it is the snapshot a reload carries forward, and that is the one place
//    this could ever become visible from inside a request.
uint $changes = 0;
string $standing = Core\Config::get('server.listen') ?? '(nothing written)';
uint $i = 0;
while ($i < 200000) {
    Core\Config::set('server.listen', '0.0.0.0:80');
    Core\Config::set('server.trusted_proxies', '0.0.0.0/0');
    Core\Config::restore('server.listen');
    if ((Core\Config::get('server.listen') ?? '(nothing written)') != $standing) {
        $changes = $changes + 1;
    }
    $i = $i + 1;
}

// 5. And real work alongside it, because the request moving the front door is a
//    request that came through it.
array<string> $connections = [];
uint $j = 0;
while ($j < 20000) {
    $connections[] = 'conn-' . $j . '-' . Core\Str::repeat('c', $j % 64);
    $j = $j + 1;
}

echo 'changes: ', $changes, "\n";
echo 'connections built: ', Core\Arr::count($connections), "\n";
echo 'listen:          ', Core\Config::get('server.listen') ?? '(nothing written)', "\n";
echo 'trusted_proxies: ', Core\Config::get('server.trusted_proxies') ?? '(nothing written)', "\n";
echo 'header_timeout:  ', Core\Config::get('server.header_timeout') ?? '(nothing written)', "\n";
