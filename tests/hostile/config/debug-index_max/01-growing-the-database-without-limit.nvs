<?nvs
// Attack: a program tries to raise `[debug] index_max`, so the database of `nvs debug` grows until
// the disk is full. It also tries to set the size to zero, so other records are deleted at once.
// Every change should fail, and the limit should keep the value from the file.

// 1. Set `debug.index_max` to huge sizes, to zero and to negative sizes. Each change should fail.
array<string> $sizes = [
    '1T',
    '100G',
    '18446744073709551615',
    '18446744073709551616',
    '99999999999999999999999999G',
    '0',
    '0M',
    '-1',
    '-1G',
    '1M',
    '1G',
];
foreach ($sizes as string $size) {
    Core\Config::set('debug.index_max', $size);
}
Core\Config::restore('debug.index_max');

// 2. Set values that are not sizes. Each change should fail.
array<string> $words = ['', ' ', 'NaN', 'inf', '1e30', '0x7fffffff', 'unlimited', 'off', "1G\n1T", '1G; 1T'];
foreach ($words as string $word) {
    Core\Config::set('debug.index_max', $word);
}
Core\Config::restore('debug.index_max');

// 3. Set keys that are almost the real key: extra dots, capital letters and other names.
array<string> $nearby = [
    'debug.index_max.',
    '.debug.index_max',
    'debug..index_max',
    'debugindex_max',
    'DEBUG.INDEX_MAX',
    'Debug.Index_Max',
    'debug.index-max',
    'debug.index',
    'index_max',
    'debug',
    'db.index_max',
];
foreach ($nearby as string $key) {
    Core\Config::set($key, '1T');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 4. Use a key with 10,000 parts. A slow key lookup or a stack overflow would show here.
string $deep = 'debug.index_max.' . Core\Str::repeat('scope.', 10000) . 'bytes';
Core\Config::set($deep, '1T');
Core\Config::get($deep);
Core\Config::restore($deep);

// 5. Try the same change 50,000 times. Each try should fail and leave nothing behind.
uint $i = 0;
while ($i < 50000) {
    Core\Config::set('debug.index_max', '1T');
    Core\Config::restore('debug.index_max');
    $i = $i + 1;
}

// 6. The limit should still be the value from the file.
echo 'debug.index_max: ', Core\Config::get('debug.index_max') ?? '(nothing)', "\n";
