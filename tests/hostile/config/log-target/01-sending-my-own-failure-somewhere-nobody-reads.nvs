<?nvs
// Attack: a program tries to change `log.target`, where the server writes the
// record of its failure. Every write should fail. The program then fails, and
// the record should still be written to the configured target.
// hostile: timeout-ms 20000
// hostile: ends-early

// 1. Tries `log.target` and keys that are almost the same.
array<string> $names = [
    'log.target',
    'target',
    'LOG.TARGET',
    'Log.Target',
    'log..target',
    '.log.target',
    'log.target.',
    'log.target.path',
    'log.target.file',
    'app.log.target',
    'app.0.log.target',
    'app.1.log.target',
    "log.target\u{0000}",
    "log.level\u{0000}log.target",
    'log.level/../target',
    'log.' . Core\Str::repeat('sub.', 20000) . 'target',
];
foreach ($names as string $key) {
    Core\Config::set($key, 'file:/dev/null');
    Core\Config::set($key, 'stderr');
    Core\Config::get($key);
    Core\Config::restore($key);
}

// 2. Tries targets that are a device, a directory, a path outside the project,
//    or an empty `file:`. Every write to `log.target` should fail.
array<string> $destinations = [
    '',
    ' ',
    'file:',
    'file: ',
    'stdout',
    'STDERR',
    'syslog ',
    'file:.',
    'file:..',
    'file:/',
    'file:C:\\',
    'file:nul',
    'file:/dev/null',
    'file:/dev/full',
    'file:\\\\?\\C:\\Windows\\System32\\drivers\\etc\\hosts',
    'file:../../../../etc/passwd',
    "file:/tmp/nvs.log\u{0000}.txt",
    'file:https://example.test/records',
    'file:' . Core\Str::repeat('a/', 16384) . 'nvs.log',
    'file:' . Core\Str::repeat('x', 1048576),
];
foreach ($destinations as string $destination) {
    Core\Config::set('log.target', $destination);
    Core\Config::set('log.format', 'html');
    Core\Config::set('log.level', 'Critical');
}
Core\Config::restore('log.target');
Core\Config::restore('log.format');
Core\Config::restore('log.level');

echo 'writing to: ', Core\Config::get('log.target') ?? '(nothing written)', "\n";

// 3. Registers a handler that throws an error, so the server must write the
//    record to `log.target` itself.
Core\Fatal::onLimit(fn (): void => {
    throw new RuntimeError('the handler this program arranged threw as well');
});

// 4. Throws an error with a very long message, and nothing catches it. The
//    server should write the record and keep running.
throw new RuntimeError(Core\Str::repeat('the destination is not mine to move. ', 65536));
