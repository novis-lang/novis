<?nvs
// Attack: a login server sends metadata documents that are false, broken or huge.
// `fetch` must throw an error for each one, and the program must keep running.
autoload 'Novis\Rest' from '../../../../packages/rest/src';

class Attack
{
    // Every reply comes from `Core\Test::answerHttp`, so nothing is sent over a network.
    // Each step uses its own issuer, so each step gets its own reply.
    public static function served(string $issuer, array<mixed> $document): void
    {
        Core\Test::answerHttp($issuer . '/.well-known/openid-configuration', 200, { json: $document });
    }

    // `fetch` must throw a `RuntimeError`. If it returns, the `LogicError` stops the program.
    public static function mustFail(string $step, string $issuer): void
    {
        try {
            Novis\Rest\Discovery $found = Novis\Rest\Discovery::fetch($issuer);
            throw new LogicError(Core\Str::format('%s: a false document was accepted: %s', $step, $found->tokenEndpoint));
        } catch (RuntimeError $error) {
            echo $step, ': ', Core\Str::slice($error->message, 0, 80), "\n";
        }
    }
}

string $base = 'https://login.example.com';

// 1. The document names another issuer, or an issuer that differs by one character.
Attack::served($base . '/s1', ['issuer' => 'https://evil.example.com', 'token_endpoint' => 'https://evil.example.com/token']);
Attack::mustFail('step 1a', $base . '/s1');
Attack::served($base . '/s1b', ['issuer' => $base . '/s1b/', 'token_endpoint' => $base . '/token']);
Attack::mustFail('step 1b', $base . '/s1b');
Attack::served($base . '/s1c', ['issuer' => 'HTTPS://LOGIN.EXAMPLE.COM/s1c', 'token_endpoint' => $base . '/token']);
Attack::mustFail('step 1c', $base . '/s1c');

// 2. The token endpoint uses `http:`, another scheme, or has no host.
array<string> $endpoints = [
    'http://login.example.com/token',
    'javascript:alert(1)',
    'file:///etc/passwd',
    'https:///token',
    'https://',
    '//evil.example.com/token',
    '',
];
uint $n = 0;
foreach ($endpoints as string $endpoint) {
    string $plain = $base . '/s2-' . $n;
    Attack::served($plain, ['issuer' => $plain, 'token_endpoint' => $endpoint]);
    Attack::mustFail('step 2', $plain);
    $n = $n + 1;
}

// 3. An endpoint has a fragment, a space, a control character or a line break.
array<string> $hidden = [
    'https://login.example.com/token#steal',
    'https://login.example.com/to ken',
    "https://login.example.com/token\r\nX-Evil: 1",
    "https://login.example.com/token\u{0}",
    "https://login.example.com/t\u{202E}oken",
];
foreach ($hidden as string $endpoint) {
    string $token = $base . '/s3-' . $n;
    Attack::served($token, ['issuer' => $token, 'token_endpoint' => $endpoint]);
    Attack::mustFail('step 3', $token);
    string $keys = $base . '/s3k-' . $n;
    Attack::served($keys, ['issuer' => $keys, 'token_endpoint' => $base . '/token', 'jwks_uri' => $endpoint]);
    Attack::mustFail('step 3', $keys);
    $n = $n + 1;
}

// 4. A field is missing, or has the wrong type.
Attack::served($base . '/s4a', ['issuer' => $base . '/s4a']);
Attack::mustFail('step 4a', $base . '/s4a');
Attack::served($base . '/s4b', ['token_endpoint' => $base . '/token']);
Attack::mustFail('step 4b', $base . '/s4b');
Attack::served($base . '/s4c', ['issuer' => $base . '/s4c', 'token_endpoint' => ['https://login.example.com/token']]);
Attack::mustFail('step 4c', $base . '/s4c');
Attack::served($base . '/s4d', ['issuer' => 42, 'token_endpoint' => $base . '/token']);
Attack::mustFail('step 4d', $base . '/s4d');
Attack::served($base . '/s4e', ['issuer' => $base . '/s4e', 'token_endpoint' => $base . '/token', 'dpop_signing_alg_values_supported' => 'ES256']);
Attack::mustFail('step 4e', $base . '/s4e');
Attack::served($base . '/s4f', ['issuer' => $base . '/s4f', 'token_endpoint' => $base . '/token', 'dpop_signing_alg_values_supported' => ['ES256', 7]]);
Attack::mustFail('step 4f', $base . '/s4f');

// 5. A DPoP algorithm is not one short word.
Attack::served($base . '/s5a', ['issuer' => $base . '/s5a', 'token_endpoint' => $base . '/token', 'dpop_signing_alg_values_supported' => ['ES256 none']]);
Attack::mustFail('step 5a', $base . '/s5a');
Attack::served($base . '/s5b', ['issuer' => $base . '/s5b', 'token_endpoint' => $base . '/token', 'dpop_signing_alg_values_supported' => [Core\Str::repeat('A', 100000)]]);
Attack::mustFail('step 5b', $base . '/s5b');

// 6. The reply is not JSON, is nested very deeply, or is not a `200` reply.
Core\Test::answerHttp($base . '/s6a/.well-known/openid-configuration', 200, { body: 'this is not JSON' });
Attack::mustFail('step 6a', $base . '/s6a');
Core\Test::answerHttp($base . '/s6b/.well-known/openid-configuration', 200, { body: Core\Str::repeat('[', 1000000) });
Attack::mustFail('step 6b', $base . '/s6b');
Core\Test::answerHttp($base . '/s6c/.well-known/openid-configuration', 302, { body: '' });
Attack::mustFail('step 6c', $base . '/s6c');
Core\Test::answerHttp($base . '/s6d/.well-known/openid-configuration', 404);
Core\Test::answerHttp($base . '/.well-known/oauth-authorization-server/s6d', 500);
Attack::mustFail('step 6d', $base . '/s6d');

// 7. The token endpoint is eight million characters long.
Attack::served($base . '/s7', ['issuer' => $base . '/s7', 'token_endpoint' => $base . '/' . Core\Str::repeat('a', 8000000)]);
Attack::mustFail('step 7', $base . '/s7');

// 8. The issuer itself is not an `https:` URL. No request is sent for any of these.
uint $before = Core\Arr::count(Core\Test::sentHttp());
array<string> $issuers = ['http://login.example.com', 'https://', 'https://login.example.com#x', 'login.example.com', ''];
foreach ($issuers as string $issuer) {
    Attack::mustFail('step 8', $issuer);
}
if (Core\Arr::count(Core\Test::sentHttp()) != $before) {
    throw new LogicError('a request was sent for an issuer that is not an https URL');
}
echo "done\n";
