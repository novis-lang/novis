<?nvs
// Attack: a page switches between code and text on almost every line. Blocks
// start in one mode and end in another, several levels deep. The text also has
// things that look like tags. Every byte of output should be in the right place.
// hostile: timeout-ms 20000

int $rounds = 0;
?><? this is text, because there is no short open tag ?>
<?xml version="1.0" encoding="utf-8"?>
<?nvs $rounds = $rounds + 1; ?>?> a stray closing marker in text is text too
<?nvs $rounds = $rounds + 1; ?><?nvs $rounds = $rounds + 1; ?><?nvs $rounds = $rounds + 1; ?>
<?nvs
// Text with no newline between the tags, twenty thousand times. The output is
// one long line, and the loop switches mode every round.
int $i = 0;
while ($i < 20000) {
    $i = $i + 1;
    ?>.<?nvs
}
?>
<?nvs
// Blocks several levels deep. Each level opens and closes in code,
// with page text between them.
array<string> $rows = ['a', 'b', 'c'];
foreach ($rows as string $row) {
    if ($row != 'b') {
        int $k = 0;
        while ($k < 2) {
            $k = $k + 1;
            ?>[<?= $row ?><?= $k ?>]<?nvs
        }
    } else {
        ?>(skipped)<?nvs
    }
}
?>
<?nvs
// A short echo tag with an expression, and one with a number that is
// converted to a string.
$rounds = $rounds + 1;
?>
rounds so far: <?= $rounds + 1000 ?>
list length: <?= Core\Arr::count($rows) ?>
<?nvs
// Markers inside a string are only characters.
echo 'a string holding <?nvs and ?> and <?= and none of them count', "\n";

// A short echo whose expression throws an error. The `catch` lets the page continue.
try {
    ?><?= ('not a number' as int) ?><?nvs
    } catch (Throwable $e) {
    echo "refused\n";
}
?>
one very long line of page text, repeated so the text side is not a short one:  and it ends here.
<?nvs
// The file ends in code mode, without a closing tag.
echo "done\n";
