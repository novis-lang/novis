<?nvs
// Attack: a program uses class names that would load a file `autoload` does not
// allow. One name has the wrong capitals for a folder. The other names a file in
// a folder that the `autoload` line does not list. Both should fail to load.
// hostile: expect-refusal

autoload 'App' from './app';

// The folder is `Text`, so `App\text` should not load. Some file systems
// ignore capitals, and this name should still fail there.
echo App\text\Greeter::hello('first'), "\n";

// `outside/Text/Secret.nvs` exists and declares this class. The `autoload` line
// lists only `./app`, so this class should not load.
echo App\Text\Secret::hello('second'), "\n";
