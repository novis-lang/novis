<?nvs
// Attack: a program asks for every class that implements an interface, over
// and over. Each call creates one object per class, so a run that kept them
// would need more and more memory. The program should run to its last line.
// hostile: timeout-ms 30000

// 1. An interface with many implementations. Each object carries a field, so
//    every round of the loop below has something to allocate.
interface Check
{
    public function weight(): uint;
}

// 2. An interface nothing implements, asked for in the same loop.
interface Unused
{
    public function nothing(): uint;
}

abstract class Heavy implements Check
{
    public array<string> $notes = [];

    public function constructor()
    {
        $this->notes = ['one', 'two', 'three', 'four'];
    }

    public function weight(): uint
    {
        return Core\Arr::count($this->notes);
    }
}

class Check01 extends Heavy
{}
class Check02 extends Heavy
{}
class Check03 extends Heavy
{}
class Check04 extends Heavy
{}
class Check05 extends Heavy
{}
class Check06 extends Heavy
{}
class Check07 extends Heavy
{}
class Check08 extends Heavy
{}
class Check09 extends Heavy
{}
class Check10 extends Heavy
{}
class Check11 extends Heavy
{}
class Check12 extends Heavy
{}
class Check13 extends Heavy
{}
class Check14 extends Heavy
{}
class Check15 extends Heavy
{}
class Check16 extends Heavy
{}

class Attack
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // 3. A fresh set of objects every round, and the round before it
            //    has to be freed for the program to stay inside its memory.
            array<Check> $checks = Core\Program::implementing<Check>();
            $total = $total + $checks[$total % 16]->weight();
            $total = $total + Core\Arr::count(Core\Program::implementing<Unused>());
            $i = $i + 1;
        }
        return $total;
    }
}

// 4. Two sets asked for at once, so both are alive at the same time.
array<Check> $first = Core\Program::implementing<Check>();
array<Check> $second = Core\Program::implementing<Check>();
echo Core\Arr::count($first) + Core\Arr::count($second), "\n";

echo Attack::run(20000), "\n";
echo "still standing\n";
