<?nvs
// Attack: reading attributes back in ways far larger than a real program uses.
// Novis reads every attribute while it compiles the program, so all of this
// work happens before the program starts. The program below should compile and
// run to its last line, and the memory it uses must not grow with each read.

repeatable attribute Count on class { n: int }
attribute Deep on class { l1: { l2: { l3: { l4: { l5: { l6: { l7: { l8: { l9: { l10: { l11: { l12: int } } } } } } } } } } } }
attribute Position on parameter { p: int }

// 1. A class with 120 attributes, all of them read back at once. This
//    tries to find a limit on how many values one retrieval may return.
#[Count(n: 1), Count(n: 2), Count(n: 3), Count(n: 4), Count(n: 5), Count(n: 6), Count(n: 7), Count(n: 8), Count(n: 9), Count(n: 10)]
#[Count(n: 11), Count(n: 12), Count(n: 13), Count(n: 14), Count(n: 15), Count(n: 16), Count(n: 17), Count(n: 18), Count(n: 19), Count(n: 20)]
#[Count(n: 21), Count(n: 22), Count(n: 23), Count(n: 24), Count(n: 25), Count(n: 26), Count(n: 27), Count(n: 28), Count(n: 29), Count(n: 30)]
#[Count(n: 31), Count(n: 32), Count(n: 33), Count(n: 34), Count(n: 35), Count(n: 36), Count(n: 37), Count(n: 38), Count(n: 39), Count(n: 40)]
#[Count(n: 41), Count(n: 42), Count(n: 43), Count(n: 44), Count(n: 45), Count(n: 46), Count(n: 47), Count(n: 48), Count(n: 49), Count(n: 50)]
#[Count(n: 51), Count(n: 52), Count(n: 53), Count(n: 54), Count(n: 55), Count(n: 56), Count(n: 57), Count(n: 58), Count(n: 59), Count(n: 60)]
#[Count(n: 61), Count(n: 62), Count(n: 63), Count(n: 64), Count(n: 65), Count(n: 66), Count(n: 67), Count(n: 68), Count(n: 69), Count(n: 70)]
#[Count(n: 71), Count(n: 72), Count(n: 73), Count(n: 74), Count(n: 75), Count(n: 76), Count(n: 77), Count(n: 78), Count(n: 79), Count(n: 80)]
#[Count(n: 81), Count(n: 82), Count(n: 83), Count(n: 84), Count(n: 85), Count(n: 86), Count(n: 87), Count(n: 88), Count(n: 89), Count(n: 90)]
#[Count(n: 91), Count(n: 92), Count(n: 93), Count(n: 94), Count(n: 95), Count(n: 96), Count(n: 97), Count(n: 98), Count(n: 99), Count(n: 100)]
#[Count(n: 101), Count(n: 102), Count(n: 103), Count(n: 104), Count(n: 105), Count(n: 106), Count(n: 107), Count(n: 108), Count(n: 109), Count(n: 110)]
#[Count(n: 111), Count(n: 112), Count(n: 113), Count(n: 114), Count(n: 115), Count(n: 116), Count(n: 117), Count(n: 118), Count(n: 119), Count(n: 120)]
class Crowded
{}

// 2. A payload nested twelve levels deep, checked against an attribute nested
//    just as deep. This tries to run the compiler out of stack while it checks it.
#[Deep(l1: { l2: { l3: { l4: { l5: { l6: { l7: { l8: { l9: { l10: { l11: { l12: 7 } } } } } } } } } } })]
class Nested
{}

// 3. Eight parameters, each with an attribute, each read back by name.
//    This tries to find a limit on selecting one parameter out of many.
class Many
{
    public static function take(
        #[Position(p: 1)] int $a,
        #[Position(p: 2)] int $b,
        #[Position(p: 3)] int $c,
        #[Position(p: 4)] int $d,
        #[Position(p: 5)] int $e,
        #[Position(p: 6)] int $f,
        #[Position(p: 7)] int $g,
        #[Position(p: 8)] int $h,
    ): int
    {
        return $a + $b + $c + $d + $e + $f + $g + $h;
    }
}

// 4. All of it read back 200000 times. This tries to make the program keep a
//    copy of every value it reads.
class Attack
{
    public static function run(uint $rounds): int
    {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // This returns all 120 `Count` values, the largest result in this program.
            var $all = Core\Attributes::all<Count>(Crowded::constructor);
            $total = $total + (Core\Arr::count($all) as int);

            var $deep = Core\Attributes::get<Deep>(Nested::constructor);
            if ($deep != null) {
                $total = $total + ($deep->l1->l2->l3->l4->l5->l6->l7->l8->l9->l10->l11->l12 as int);
            }

            var $first = Core\Attributes::get<Position>(Many::take, 'a');
            var $last = Core\Attributes::get<Position>(Many::take, 'h');
            if ($first != null) {
                if ($last != null) {
                    $total = $total + $first->p + $last->p;
                }
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Attack::run(200000), "\n";
echo "still standing\n";
