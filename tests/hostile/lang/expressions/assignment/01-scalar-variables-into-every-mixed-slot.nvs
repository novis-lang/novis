<?nvs
// Attack: a program writes `int`, `float` and `bool` variables into every kind of
// `mixed` place: array elements, properties and `inout` parameters. It does this
// thousands of times. Every value read back should be the value that was written.
// hostile: timeout-ms 30000
// covers: lang:expressions/assignment

class Box
{
    public mixed $held;
    public array<mixed> $rows;

    public function constructor()
    {
        $this->held = 0;
        $this->rows = [];
    }

    public static function into(inout mixed $slot, int $v): void
    {
        $slot = $v;
    }

    public static function push(inout array<mixed> $a, float $v): void
    {
        $a[] = $v;
    }
}

int $n = 5000;
int $i = 0;
int $iv = 0;
float $fv = 0.0;
bool $bv = false;
array<mixed> $flat = [];
array<mixed> $keyed = [];
array<array<mixed>> $grid = [[]];
var $box = new Box();
mixed $slot = null;
int $sum = 0;
while ($i < $n) {
    $iv = $i * 3;
    $fv = ($i as float) / 2.0;
    $bv = $i % 2 == 0;
    // Writes into array elements: appended, by key, nested, and a new row by key.
    $flat[] = $iv;
    $flat[] = $fv;
    $flat[] = $bv;
    $keyed[$iv as string] = $fv;
    $grid[0][] = $iv;
    $grid[][0] = $bv;
    // Writes into properties and into `inout` parameters of type `mixed` and `array<mixed>`.
    $box->held = $fv;
    $box->rows[] = $iv;
    Box::into(inout $slot, $iv);
    Box::push(inout $flat, $fv);
    Box::push(inout $box->rows, $fv);
    // Reads two values back. A wrong type or a wrong count changes the output.
    if ($slot == $iv && $box->held == $fv) {
        $sum = $sum + 1;
    }
    $i = $i + 1;
}
echo Core\Arr::count($flat) as string, ' ', Core\Arr::count($keyed) as string, ' ', Core\Arr::count($grid) as string, ' ', Core\Arr::count($box->rows) as string, ' ', $sum as string, "\n";
