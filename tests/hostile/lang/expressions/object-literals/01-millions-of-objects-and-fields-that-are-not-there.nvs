<?nvs
// Attack: build object literals in numbers a program never reaches, and
// read fields that are not there. Millions of objects are made and
// dropped, a million more are kept alive at once, and every read of a
// missing field throws. The program must not crash.
// hostile: timeout-ms 30000

type Point = {x: int, y: int};
type Optional = {id: string, label?: string};

class Attack
{
    // 1. Make and drop millions of objects.
    public static function churn(uint $rounds): int
    {
        int $seen = 0;
        uint $i = 0;

        while ($i < $rounds) {
            Point $point = { x: $seen, y: $seen + 1 };
            $seen = $point->y % 1000;
            $i = $i + 1;
        }

        return $seen;
    }

    // 2. Read a field the shape does not name. Every read throws, and the
    // error is caught every time.
    public static function missingField(uint $rounds): uint
    {
        Point $point = { x: 1, y: 2 };
        uint $caught = 0;
        uint $i = 0;

        while ($i < $rounds) {
            try {
                $caught = $caught + ($point->z as uint);
            } catch (RuntimeError $gone) {
                $caught = $caught + 1;
            }

            $i = $i + 1;
        }

        return $caught;
    }

    // 3. A field that may be missing, asked for with `??` and with `isset`.
    public static function optional(uint $rounds): uint
    {
        Optional $bare = { id: '7' };
        Optional $full = { id: '8', label: 'eight' };
        uint $found = 0;
        uint $i = 0;

        while ($i < $rounds) {
            string $label = $bare->label ?? 'none';
            $found = $found + Core\Str::length($label);

            if (isset($full->label)) {
                $found = $found + 1;
            }

            $i = $i + 1;
        }

        return $found;
    }

    // 4. Keep a million objects alive at once, then let go of all of them.
    public static function holdThemAll(uint $objects): uint
    {
        array<Point> $all = [];
        uint $i = 0;

        while ($i < $objects) {
            $all[] = { x: ($i as int), y: 0 };
            $i = $i + 1;
        }

        return Core\Arr::count($all);
    }

    // 5. A literal nested far deeper than a person would write it, made
    // again and again.
    public static function nested(uint $rounds): string
    {
        string $last = '';
        uint $i = 0;

        while ($i < $rounds) {
            var $deep = { a: { a: { a: { a: { a: { a: { a: { a: { value: 'bottom' } } } } } } } } };
            $last = $deep->a->a->a->a->a->a->a->a->value;
            $i = $i + 1;
        }

        return $last;
    }

    // 6. Objects captured by closures, with the closures kept in an array.
    public static function captured(uint $closures): int
    {
        array<callable(): int> $held = [];
        uint $i = 0;

        while ($i < $closures) {
            Point $point = { x: ($i as int), y: 1 };
            $held[] = fn(): int => $point->x + $point->y;
            $i = $i + 1;
        }

        int $sum = 0;
        foreach ($held as string $at => callable(): int $call) {
            $sum = ($sum + $call()) % 100000;
        }

        return $sum;
    }
}

echo Attack::churn(2000000), "\n";
echo Attack::missingField(200000), "\n";
echo Attack::optional(200000), "\n";
echo Attack::holdThemAll(1000000), "\n";
echo Attack::nested(200000), "\n";
echo Attack::captured(200000), "\n";
