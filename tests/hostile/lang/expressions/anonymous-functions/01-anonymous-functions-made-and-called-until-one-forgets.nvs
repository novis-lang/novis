<?nvs
// Attack: anonymous functions are made, kept and called until one of them loses
// a value it captured. A million are kept at once, one captures text millions
// of characters long, and calls are nested as deep as the engine allows.
// Nothing may crash, hang or lose what it captured.
// hostile: timeout-ms 20000
// covers: lang:expressions/anonymous-functions

class Attack
{
    // 1. Each call makes an anonymous function and frees it, so millions are
    // made and freed.
    public static function fresh(int $seed): int
    {
        callable $once = fn (int $n): int => $n + $seed;

        return $once($seed) as int;
    }

    // 2. An anonymous function calls a method that makes another anonymous
    // function, so the nesting runs as deep as the stack allows.
    public static function deeper(int $depth): int
    {
        if ($depth <= 0) {
            return 0;
        }

        callable $down = fn (int $n): int => Attack::deeper($n - 1);

        return 1 + ($down($depth) as int);
    }

    // 3. An anonymous function gets the wrong kind of value. The call throws
    // an error.
    public static function refuse(callable $rule, mixed $value): tainted string
    {
        return $rule($value) as string;
    }
}

// Ten thousand anonymous functions are kept at once. Each one captures its own
// number, and every one of them is called afterwards.
array<callable> $held = [];
int $made = 0;

while ($made < 10000) {
    $held = Core\Arr::append($held, fn (): int => $made);
    $made = $made + 1;
}

int $called = 0;
int $sum = 0;

foreach ($held as callable $one) {
    $sum = ($sum + ($one() as int)) % 1000003;
    $called = $called + 1;
}

echo $called, ' ', $sum, "\n";

// Millions of anonymous functions are made and freed one at a time.
int $round = 0;
int $rolling = 0;

while ($round < 500000) {
    $rolling = (Attack::fresh($round) + $rolling) % 1000003;
    $round = $round + 1;
}

echo $rolling, "\n";

// An anonymous function captures text millions of characters long. The
// variable is emptied afterwards, and the function still returns the full length.
string $long = '';
int $built = 0;

while ($built < 400000) {
    $long = $long . 'novis-';
    $built = $built + 1;
}

callable $measure = fn (): uint => Core\Str::length($long);
$long = '';
echo $measure() as uint, ' ', Core\Str::length($long), "\n";

// Anonymous functions are nested until the stack is full. The error is caught,
// so the steps after it still run.
try {
    echo Attack::deeper(100000000), "\n";
} catch (RecursionError $stopped) {
    echo $stopped->message, "\n";
}

// An anonymous function gets a value of a type it does not declare, tens of
// thousands of times. Each error is caught.
callable $needsText = fn (string $s): string => Core\Str::upper($s);
int $refused = 0;
int $attempt = 0;

while ($attempt < 20000) {
    try {
        echo Attack::refuse($needsText, $attempt);
    } catch (Throwable $wrong) {
        $refused = $refused + 1;
    }
    $attempt = $attempt + 1;
}

echo $refused, "\n";

// An anonymous function is called with far more arguments than it declares.
// Another one is made and called in the same line, hundreds of thousands of times.
callable $spareStep = fn (int $n): int => $n + 1;
int $spare = 0;
$attempt = 0;

while ($attempt < 200000) {
    $spare = $spareStep($spare, 1, 2, 3, 4, 5, 6, 7, 8, 9) as int;
    $spare = (fn (int $n): int => $n + 1)($spare) as int;
    $spare = $spare % 1000003;
    $attempt = $attempt + 1;
}

echo $spare, "\n";
echo "still standing\n";
