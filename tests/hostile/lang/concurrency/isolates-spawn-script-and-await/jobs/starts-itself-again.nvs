<?nvs
// The attack in the folder above starts this script. It starts itself again,
// and the copy it starts does the same. Nothing here stops the chain, so the
// runtime is what has to stop it.

var $handle = spawn script 'starts-itself-again.nvs' with(output: 'capture');
var $result = await $handle;

// The copy started above either returned a depth or stopped. This run counts
// itself either way.
uint $deeper = 0;
if ($result->ok) {
    $deeper = $result->value as uint;
}
return $deeper + 1;
