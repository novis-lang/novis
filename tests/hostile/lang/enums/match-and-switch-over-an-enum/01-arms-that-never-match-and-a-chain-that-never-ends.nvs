<?nvs
// Attack: a program runs `match` and `switch` over an enum with extreme input.
// A million `match` calls find no arm, a `switch` runs through many labels, and a
// `match` calls itself without end. Each step should throw an error the program
// can catch, and the runtime should keep running.
// covers: lang:enums/match-and-switch-over-an-enum
// hostile: timeout-ms 20000

// 1. A `match` over a `mixed` value that fits no arm, one million times.
// Each error is caught, so the program keeps going.
class Missed
{
    public static function count(int $rounds): int
    {
        int $caught = 0;
        int $i = 0;
        mixed $huge = Runaway::Mode::Huge;
        while ($i < $rounds) {
            try {
                string $unreached = match ($huge) { Runaway::Mode::Read => 'read' };
                $caught = $caught + (Core\Str::length($unreached) as int);
            } catch (Throwable $e) {
                $caught = $caught + 1;
            }
            $i = $i + 1;
        }
        return $caught;
    }
}

echo '1: caught ', Missed::count(1000000), "\n";

// 2. A `switch` whose arms all fall through, walked from the first label to the
// last two million times.
class Through
{
    public static function walk(int $rounds): int
    {
        int $steps = 0;
        int $i = 0;
        while ($i < $rounds) {
            switch (Runaway::Mode::Read) {
                case Runaway::Mode::Read:
                    $steps = $steps + 1;
                case Runaway::Mode::Write:
                    $steps = $steps + 1;
                case Runaway::Mode::Huge:
                    $steps = $steps + 1;
                default:
                    $steps = $steps + 1;
            }
            $i = $i + 1;
        }
        return $steps;
    }
}

echo '2: steps ', Through::walk(2000000), "\n";

// 3. A case of a `uint` enum has the largest `uint` number. A `match` compares it
// with its own arm and with the arm below it.
Runaway::Mode $end = Runaway::Mode::Huge;
echo '3: ', match ($end) { Runaway::Mode::Read => 'read', Runaway::Mode::Huge => 'huge', default => 'other' }, "\n";
echo '3: ', match ($end) { Runaway::Mode::Read => 'read', Runaway::Mode::Write => 'write', default => 'other' }, "\n";

// 4. A `match` whose arm calls the method it is written in, with no end.
class Runaway
{
    enum Mode: uint { Read = 0, Write = 1, Huge = 18446744073709551615 }

    public static function down(Mode $m): int
    {
        return match ($m) {
            Mode::Read => Runaway::down($m),
            default => 0,
        };
    }
}

try {
    int $reached = Runaway::down(Runaway::Mode::Read);
    echo '4: BAD, the call returned ', $reached, "\n";
} catch (Throwable $e) {
    echo '4: caught ', $e->message, "\n";
}

echo "the runtime is still running\n";
