<?nvs
// Attack: a program calls the functions that replace PHP's enum methods millions
// of times. It gets case names, builds the list of all cases and looks up long
// strings. It also runs a workflow that never ends. Each result should be
// correct, and the runtime should keep running.
// covers: lang:enums/what-replaces-php-s-enum-members
// hostile: timeout-ms 20000

enum Level { Debug, Info, Warn, Error }

class Levels
{
    public static function name(Level $l): string
    {
        return match ($l) {
            Level::Debug => 'debug',
            Level::Info => 'info',
            Level::Warn => 'warn',
            Level::Error => 'error',
        };
    }

    public static function all(): array<Level>
    {
        return [Level::Debug, Level::Info, Level::Warn, Level::Error];
    }

    public static function byName(string $wanted): ?Level
    {
        foreach (Levels::all() as Level $l) {
            if (Levels::name($l) == $wanted) {
                return $l;
            }
        }
        return null;
    }
}

// 1. Four million calls that get the name of a case made from the round number.
class Names
{
    public static function sweep(int $rounds): int
    {
        int $wrong = 0;
        int $i = 0;
        while ($i < $rounds) {
            Level $held = ($i % 4) as Level;
            if (Core\Str::length(Levels::name($held)) < 4) {
                $wrong = $wrong + 1;
            }
            $i = $i + 1;
        }
        return $wrong;
    }
}

echo '1: wrong names ', Names::sweep(4000000), "\n";

// 2. Four hundred thousand copies of the list of all cases, each read in a loop.
// Memory use should not grow.
class Lists
{
    public static function sweep(int $rounds): int
    {
        int $seen = 0;
        int $i = 0;
        while ($i < $rounds) {
            foreach (Levels::all() as Level $l) {
                $seen = $seen + ($l as int);
            }
            $i = $i + 1;
        }
        return $seen;
    }
}

echo '2: seen ', Lists::sweep(400000), "\n";

// 3. Lookups by name with ten thousand characters, an empty string, and `war`.
// `war` is one letter short of `warn`. No lookup should find a case.
class Lookups
{
    public static function sweep(int $rounds): int
    {
        string $long = Core\Str::repeat('warn', 2500);
        int $found = 0;
        int $i = 0;
        while ($i < $rounds) {
            if (Levels::byName($long) != null) {
                $found = $found + 1;
            }
            if (Levels::byName('') != null) {
                $found = $found + 1;
            }
            if (Levels::byName('war') != null) {
                $found = $found + 1;
            }
            $i = $i + 1;
        }
        return $found;
    }
}

echo '3: found ', Lookups::sweep(50000), "\n";

// 4. A workflow step calls the next step, and this never ends.
class Runaway
{
    public static function next(Level $l): Level
    {
        return match ($l) {
            Level::Debug => Runaway::next(Level::Info),
            Level::Info => Runaway::next(Level::Debug),
            Level::Warn => Level::Warn,
            Level::Error => Level::Error,
        };
    }
}

try {
    Level $reached = Runaway::next(Level::Debug);
    echo '4: BAD, the walk ended at ', Levels::name($reached), "\n";
} catch (Throwable $e) {
    echo '4: caught ', $e->message, "\n";
}

echo "the runtime is still running\n";
