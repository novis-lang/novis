<?nvs
// Attack: a program pushes the number behind an enum case past what its type
// can hold. It then converts cases hundreds of thousands of times, and once
// from a function that never stops calling itself. Every step should end in an
// error the program can catch, and the runtime should stay standing.
// covers: lang:enums/a-case-is-its-integer
// hostile: timeout-ms 20000

enum Mask: uint { None = 0, All = 18446744073709551615 }
enum Depth { Floor = -9223372036854775807, Ground = 0, Step = 1 }

// 1. The largest number a `uint` enum can carry, raised by one.
uint $top = Mask::All as uint;
echo '1: ', $top, "\n";
try {
    uint $over = $top + 1;
    echo '1: BAD, the sum was ', $over, "\n";
} catch (Throwable $e) {
    echo '1: caught ', $e->message, "\n";
}

// 2. The most negative number an `int` enum can carry, lowered by two.
int $floor = Depth::Floor as int;
echo '2: ', $floor, "\n";
try {
    int $under = $floor - 2;
    echo '2: BAD, the difference was ', $under, "\n";
} catch (Throwable $e) {
    echo '2: caught ', $e->message, "\n";
}

// 3. The same conversion run 500000 times, each round using the last one.
class Grind
{
    public static function run(int $rounds): int
    {
        array<Depth> $steps = [Depth::Ground, Depth::Step];
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            $total = $total + ($steps[$total % 2] as int) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo '3: ', Grind::run(500000), "\n";

// 4. A function that converts a case and then calls itself, with no end.
class Runaway
{
    public static function down(Depth $step, int $n): int
    {
        return Runaway::down($step, $n + ($step as int));
    }
}

try {
    int $reached = Runaway::down(Depth::Step, 0);
    echo '4: BAD, the call returned ', $reached, "\n";
} catch (Throwable $e) {
    echo '4: caught ', $e->message, "\n";
}

echo "the runtime is still running\n";
