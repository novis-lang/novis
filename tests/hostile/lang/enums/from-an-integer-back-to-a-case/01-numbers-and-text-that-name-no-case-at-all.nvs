<?nvs
// Attack: a program converts numbers and strings that match no case of an enum.
// It throws and catches many errors and converts numbers at the ends of the
// ranges. It also converts a string of ten thousand digits. Each conversion
// should give `null` or throw an error, and the runtime should keep running.
// covers: lang:enums/from-an-integer-back-to-a-case
// hostile: timeout-ms 20000

enum Level: int { Debug = 0, Info = 1, Warn = 2, Error = 3 }

enum Wide: uint { None = 0, All = 18446744073709551615 }

// 1. Two hundred thousand conversions that throw an error, and each error is
// caught. Memory use should not grow.
class Thrown
{
    public static function sweep(int $rounds): int
    {
        int $caught = 0;
        int $i = 0;
        while ($i < $rounds) {
            try {
                Level $l = ($i + 4) as Level;
                return -1;
            } catch (RuntimeError $e) {
                $caught = $caught + 1;
            }
            $i = $i + 1;
        }
        return $caught;
    }
}

echo '1: caught ', Thrown::sweep(200000), "\n";

// 2. Four million conversions with `as ?Level` of numbers that match no case.
// Every result should be `null`.
class Missing
{
    public static function sweep(int $rounds): int
    {
        int $notNull = 0;
        int $i = 0;
        while ($i < $rounds) {
            ?Level $maybe = ($i + 4) as ?Level;
            if ($maybe != null) {
                $notNull = $notNull + 1;
            }
            $i = $i + 1;
        }
        return $notNull;
    }
}

echo '2: not null ', Missing::sweep(4000000), "\n";

// 3. Numbers at the ends of the ranges. Only the largest `uint` matches a case,
// `Wide::All`. Every other result should be `null`.
class Ends
{
    public static function sweep(int $rounds): int
    {
        int $unexpected = 0;
        int $low = -9223372036854775807;
        int $high = 9223372036854775807;
        int $i = 0;
        while ($i < $rounds) {
            if (($low as ?Level) != null) {
                $unexpected = $unexpected + 1;
            }
            if (($high as ?Level) != null) {
                $unexpected = $unexpected + 1;
            }
            if (($low as ?Wide) != null) {
                $unexpected = $unexpected + 1;
            }
            if ((18446744073709551615 as ?Wide) == null) {
                $unexpected = $unexpected + 1;
            }
            $i = $i + 1;
        }
        return $unexpected;
    }
}

echo '3: unexpected ', Ends::sweep(1000000), "\n";

// 4. Strings of ten thousand digits, an empty string, and a string with no digits.
// Every result should be `null`.
class Text
{
    public static function sweep(int $rounds): int
    {
        string $long = Core\Str::repeat('9', 10000);
        int $found = 0;
        int $i = 0;
        while ($i < $rounds) {
            if (($long as ?Level) != null) {
                $found = $found + 1;
            }
            if (('' as ?Level) != null) {
                $found = $found + 1;
            }
            if (('level three' as ?Level) != null) {
                $found = $found + 1;
            }
            $i = $i + 1;
        }
        return $found;
    }
}

echo '4: found ', Text::sweep(100000), "\n";

// 5. A method converts a number and then calls itself without end.
class Runaway
{
    public static function down(int $n): int
    {
        Level $l = $n as Level;
        return Runaway::down($l as int);
    }
}

try {
    int $reached = Runaway::down(1);
    echo '5: BAD, the call returned ', $reached, "\n";
} catch (Throwable $e) {
    echo '5: caught ', $e->message, "\n";
}

echo "the runtime is still running\n";
