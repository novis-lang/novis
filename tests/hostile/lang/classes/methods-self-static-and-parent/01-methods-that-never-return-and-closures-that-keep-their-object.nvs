<?nvs
// Attack: a program calls methods in ways a normal one never does. A method
// calls itself with no end. Two static methods call each other with no end. A
// closure that keeps its object is made again and again. The runtime should
// stay standing.
// hostile: ends-early
// covers: lang:classes/methods-self-static-and-parent

final class Endless
{
    public function constructor(public int $depth)
    {}

    public function down(int $n): int
    {
        return $this->down($n + 1);
    }

    public function adder(): callable
    {
        return fn (int $k): int => $this->depth + $k;
    }
}

final class Bounce
{
    public static function ping(int $n): int
    {
        return self::pong($n + 1);
    }

    public static function pong(int $n): int
    {
        return self::ping($n + 1);
    }

    public static function refuse(): int
    {
        throw new RuntimeError('this method never returns a value');
    }
}

// 1. An instance method calls itself and never returns.
var $endless = new Endless(1);
try {
    int $reached = $endless->down(0);
    echo '1: BAD, the method returned ', $reached, "\n";
} catch (Throwable $e) {
    echo '1: caught ', $e->message, "\n";
}

// 2. Two static methods call each other and never return.
try {
    int $bounced = Bounce::ping(0);
    echo '2: BAD, the call returned ', $bounced, "\n";
} catch (Throwable $e) {
    echo '2: caught ', $e->message, "\n";
}

// 3. Two hundred thousand closures are made inside a method, each one keeping
//    the object it was made on.
int $made = 0;
int $sum = 0;
while ($made < 200000) {
    var $add = $endless->adder();
    $sum = $sum + ($add(1) as int);
    $made = $made + 1;
}
echo '3: made ', $made, ' closures that add up to ', $sum, "\n";

// 4. A static method throws instead of returning, and nothing catches it. The
//    program ends here.
echo Bounce::refuse(), "\n";
echo "4: BAD, the program is still running\n";
