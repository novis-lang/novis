<?nvs
// Attack: an observer reads properties while the constructor is still setting
// them. A property that has no value yet should throw a `LogicError`, which the
// program catches. The program should then go on.
// covers: lang:classes/propertyobserver

class Record implements PropertyObserver
{
    public int $id;
    public string $title;
    public array<string> $tags;
    public int $reads = 0;
    public int $errors = 0;

    public function constructor()
    {
        $this->id = 1;
        $this->title = 'first';
        $this->tags = ['a', 'b'];
    }

    public function onPropertyGet(string $name, mixed $value): void
    {
    }

    // Each write reads `title` and `tags`. During the first write, neither has a value.
    public function onPropertySet(string $name, mixed $value): void
    {
        if ($name == 'reads' || $name == 'errors') {
            return;
        }
        try {
            uint $length = Core\Str::length($this->title) + Core\Arr::count($this->tags);
            $this->reads++;
        } catch (LogicError $e) {
            $this->errors++;
        }
    }
}

// 1. Build one object. The first two writes find properties with no value.
var $record = new Record();
echo 'step 1: ', $record->reads, ' reads, ', $record->errors, " errors\n";

// 2. Write again after the constructor. Every property has a value now.
$record->title = 'second';
echo 'step 2: ', $record->reads, ' reads, ', $record->errors, " errors\n";

// 3. Build many objects in a loop.
int $errors = 0;
for (var $i = 0; $i < 1000; $i++) {
    $errors = $errors + (new Record())->errors;
}
echo 'step 3: ', $errors, " errors\n";
