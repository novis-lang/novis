<?nvs
// Attack: the options on `#[Test]` are filled with values written to break the
// part of the compiler that reads them. They hold the two ends of the whole
// number range, reasons of five hundred characters, and every option at once.
// The program should run to its last line.

use Core\Random;
use Core\Test;

class Options
{
    // 1. The two ends of the allowance: the largest whole number, and none.
    #[Test(retries: 9223372036854775807, because: "the largest allowance a whole number can hold")]
    public function itTakesTheLargestAllowance(): void
    {
        Test::assertTrue(true);
    }

    #[Test(retries: 0, because: "an allowance of nothing is still an allowance")]
    public function itTakesAnAllowanceOfNothing(): void
    {
        Test::assertTrue(true);
    }

    // 2. The two ends of the clock, as the instant a test reads.
    #[Test(at: "0001-01-01T00:00:00Z")]
    public function itTakesTheEarliestInstant(): void
    {
        Test::assertTrue(true);
    }

    #[Test(at: "9999-12-31T23:59:59Z")]
    public function itTakesTheLatestInstant(): void
    {
        Test::assertTrue(true);
    }

    // 3. The two ends of the range, as the seed the numbers are drawn from.
    #[Test(seed: 9223372036854775807)]
    public function itTakesTheLargestSeed(): void
    {
        Test::assertTrue(Random::int(0, 9) >= 0);
    }

    #[Test(seed: -9223372036854775807)]
    public function itTakesTheSmallestSeed(): void
    {
        Test::assertTrue(Random::int(0, 9) >= 0);
    }

    // 4. Five hundred characters of text in both options that take text, with
    //    characters outside the English alphabet in them.
    #[Test(skip: "ünïcödé 🙂 ", retries: 3, because: "ünïcödé 🙂 ")]
    public function itTakesVeryLongReasons(): void
    {
        Test::assertTrue(true);
    }

    // 5. Every option at once, on one test.
    #[Test(skip: "every option at once", at: "2026-01-01T00:00:00Z", seed: 1, retries: 1, because: "every option at once", db: "main", server: true)]
    public function itTakesEveryOptionAtOnce(): void
    {
        Test::assertTrue(true);
    }
}

// 6. The whole range a seed covers is drawn from at run time. An error here
//    is caught, so the program still reaches its last line.
try {
    int $draw = Random::int(-9223372036854775807, 9223372036854775807);
    echo 'step 6: the draw is at least the smallest number: ', ($draw >= -9223372036854775807) ? 'yes' : 'no', "\n";
} catch (Throwable $caught) {
    echo 'step 6 stopped: ', $caught->message, "\n";
}

// 7. An empty range is drawn from. This error is caught as well.
try {
    int $empty = Random::int(9, 1);
    echo 'step 7: a number was drawn from an empty range: ', $empty, "\n";
} catch (Throwable $caught) {
    echo 'step 7 stopped: ', $caught->message, "\n";
}

echo 'the program reached its last line', "\n";
