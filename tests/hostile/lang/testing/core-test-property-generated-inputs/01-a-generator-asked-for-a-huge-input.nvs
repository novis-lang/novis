    // 4. Every long string fails, so the runner makes the input smaller, many times over.
    #[Property(seed: 3, gen: { text: '5000..10000' })]
    public function itShrinksALongString(string $text): void
    {
        Test::assertTrue(Core\Str::length($text) < 5000);
    }
