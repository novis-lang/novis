<?nvs
// Attack: properties ask for the longest inputs a `gen:` range allows, and for more
// than one call may use. Each test should pass or fail with an error, and the report should end.
// proof: test

use Core\Test;
use Core\Test\Property;

final class HugeInputTest
{
    // 1. Every call gets a string of 10000 characters, the longest a range allows.
    #[Property(gen: { text: '10000..10000' })]
    public function itTakesTheLongestString(string $text): void
    {
        Test::assertTrue(Core\Str::length($text) > 0);
    }

    // 2. A list of 10000 lists of strings. The inner lists share what is left of the limit.
    #[Property(runs: 10, gen: { rows: '10000..10000' })]
    public function itTakesAListOfLists(array<array<string>> $rows): void
    {
        Test::assertCount($rows, 10000);
    }

    // 3. 105 strings of 10000 characters each. That is more than one call may use,
    //    so this test fails with an error before any input is built.
