<?nvs
// Attack: ask the same question millions of times, from every position at
// once, about values whose kind is only known while the program runs. Big
// text and big lists go in, so anything that reads a value instead of asking
// its length takes the whole thing; and each round builds a fresh list inside
// the test itself, so a list the test forgets to let go of shows up as
// memory that never comes back.
// hostile: timeout-ms 20000

class Ask
{
    public static function everywhere(mixed $value): int
    {
        int $hits = 0;

        if ($value) {
            $hits = $hits + 1;
        }

        while ($value) {
            $hits = $hits + 1;
            break;
        }

        for (int $guard = 0; $value; $guard = $guard + 1) {
            $hits = $hits + 1;
            break;
        }

        $hits = $hits + ($value ? 1 : 0);

        if ($value && true) {
            $hits = $hits + 1;
        }

        if (!$value) {
            $hits = $hits + 0;
        } else {
            $hits = $hits + 1;
        }

        return $hits;
    }

    public static function deep(mixed $value): bool
    {
        return !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!$value;
    }
}

// Every kind of value the question has an answer for, including the ones that
// sit right on the line between the two answers.
array<mixed> $values = [
    false,
    true,
    0,
    -1,
    0.0,
    -0.0,
    Core\Math::NAN,
    '',
    '0',
    '0.0',
    ' ',
    [],
    [0],
    null,
    new Ask(),
];

int $total = 0;
int $round = 0;

while ($round < 60000) {
    foreach ($values as mixed $value) {
        $total = $total + Ask::everywhere($value);
    }

    $round = $round + 1;
}

echo $total, "\n";

// A single piece of text four million characters long, and a list of a
// million elements. Both answers are about size alone, so neither of these
// should take any longer to answer than a one-character one.
string $huge = Core\Str::repeat('0', 4000000);
array<int> $long = Core\Arr::fill(1000000, 0);

int $sized = 0;
int $pass = 0;

while ($pass < 200000) {
    if ($huge) {
        $sized = $sized + 1;
    }

    if ($long) {
        $sized = $sized + 1;
    }

    $pass = $pass + 1;
}

echo $sized, "\n";

// The test builds the list it asks about, so nothing else is holding on to it
// once the answer is given.
int $fresh = 0;
int $churn = 0;

while ($churn < 300000) {
    if (Core\Str::split(Core\Str::repeat('a,', 8), ',')) {
        $fresh = $fresh + 1;
    }

    $churn = $churn + 1;
}

echo $fresh, "\n";

// Thirty-two turnarounds of one answer, over and over.
int $flipped = 0;
int $turn = 0;

while ($turn < 200000) {
    foreach ($values as mixed $value) {
        if (Ask::deep($value)) {
            $flipped = $flipped + 1;
        }
    }

    $turn = $turn + 1;
}

echo $flipped, "\n";
