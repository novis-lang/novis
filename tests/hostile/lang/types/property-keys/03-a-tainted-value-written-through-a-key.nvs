<?nvs
// Attack: a request picks the property to write and also sends the value. The key
// names a plain `string` property, so the program should not compile.
// hostile: expect-refusal
// covers: lang:types/property-keys

class Profile
{
    public string $city = 'London';
    public tainted string $note = '';
}

Profile $profile = new Profile();

// 1. The property name and the value both come from the web address.
?property<Profile> $key = Core\Request::query('field') as ?property<Profile>;
?tainted string $value = Core\Request::query('value');
if ($key != null && $value != null) {
    $profile->$key = $value;
}
string $city = $profile->city;
echo $city, "\n";
