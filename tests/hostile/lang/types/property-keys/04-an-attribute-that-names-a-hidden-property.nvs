<?nvs
// Attack: a `Search` attribute above a class lists a private property, or a property of another class.
// Each name must be a public property of the class below the attribute. The program should not compile.
// hostile: expect-refusal
// covers: lang:types/property-keys

attribute Search on class { fields: array<property<static>> }

class User
{
    public string $email = 'ada@example.com';
}

// 1. The attribute above `Account` names `password`, which is a private property of `Account`.
#[Search(fields: ['owner', 'password'])]
class Account
{
    public string $owner = 'ada';
    private string $password = 's3cret';
}

// 2. The attribute above `Order` names `email`. `email` is a property of `User`, and `Order` has no `email`.
#[Search(fields: ['email'])]
class Order
{
    public int $total = 10;
}

var $search = Core\Attributes::get<Search>(Account::constructor);
if ($search != null) {
    Account $account = new Account();
    foreach ($search->fields as var $field) {
        echo $account->$field, "\n";
    }
}
