<?nvs
// Attack: a request picks the property to write, and the class has a `readonly`
// property. The program should not compile, because the key could name that property.
// hostile: expect-refusal
// covers: lang:types/property-keys

class Invoice
{
    public readonly int $id;
    public string $status = 'open';
    public string $note = '';

    public function constructor(int $id)
    {
        $this->id = $id;
    }
}

Invoice $invoice = new Invoice(41);

// 1. The property name comes from the web address. Here it is "id".
?property<Invoice> $key = Core\Request::query('field') as ?property<Invoice>;
if ($key != null) {
    $invoice->$key = '99';
}
echo $invoice->id, "\n";
