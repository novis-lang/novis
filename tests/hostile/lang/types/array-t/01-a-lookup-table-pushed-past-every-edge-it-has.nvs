<?nvs
// Attack: a lookup table pushed past every edge it has. A key at the far end
// of what a whole number can be, so the next append has nowhere to go. Keys
// that look like the same number and are not. A table nested fifty thousand
// deep and then thrown away in one go. Hundreds of thousands of entries,
// copied while they are still being added to. A key that was never stored.
// hostile: timeout-ms 40000

// The append counter is asked for the number after the largest one there is.
array<int> $far = [];
$far[9223372036854775807] = 1;
try {
    $far[] = 2;
    echo "appended past the end\n";
} catch (Throwable $e) {
    echo 'refused: ', $e->message, "\n";
}

// Six keys a reader would call the same key. Only two of them are.
array<int> $lookalike = [];
$lookalike[8] = 1;
$lookalike['8'] = 2;
$lookalike['08'] = 3;
$lookalike['+8'] = 4;
$lookalike[' 8'] = 5;
$lookalike['8.0'] = 6;
echo Core\Arr::count($lookalike), " distinct keys\n";

// A key a megabyte long, and the table has to find it again.
string $huge = Core\Str::repeat('k', 1048576);
array<int> $wide = [];
$wide[$huge] = 7;
echo Core\Arr::hasKey($wide, $huge) ? "found it\n" : "lost it\n";

// Fifty thousand tables inside one another, built one at a time and then
// dropped all at once, which is where a recursive release comes apart.
array<mixed> $deep = [];
uint $depth = 0;
while ($depth < 50000) {
    $deep = ['inner' => $deep];
    $depth = $depth + 1;
}
$deep = [];
echo "nested and released\n";

// Half a million entries, with a copy taken every thousand rounds and written
// to, so the table is forever splitting off from a copy of itself.
array<string> $rows = [];
uint $i = 0;
uint $copies = 0;
while ($i < 500000) {
    $rows[] = 'row';
    if ($i % 1000 == 0) {
        array<string> $snapshot = $rows;
        $snapshot[] = 'extra';
        $copies = $copies + Core\Arr::count($snapshot) - Core\Arr::count($rows);
    }
    $i = $i + 1;
}
echo Core\Arr::count($rows), ' rows, ', $copies, " copies that never showed\n";

// A key that was never stored, asked for on purpose.
try {
    echo $rows['no such row'], "\n";
    echo "read a key that is not there\n";
} catch (Throwable $e) {
    echo 'refused: ', $e->message, "\n";
}
