<?nvs
// Attack: the program checks a value's type with `is`, uses the value, and then replaces it.
// It does this hundreds of thousands of times. Each object should be freed exactly once,
// so memory use stays flat. A recursive function also walks a chain of twenty thousand objects.
// hostile: timeout-ms 20000

class Leaf
{
    public ?Leaf $next = null;
    public string $tag = 'leaf';
}

class Attack
{
    public static function chain(?Leaf $node, uint $depth): uint
    {
        if ($node == null) {
            return $depth;
        }

        ?Leaf $next = $node->next;

        return Attack::chain($next, $depth + 1);
    }

    public static function arms(mixed $value): int
    {
        return match (true) {
            $value is Leaf => 1,
            $value is string => 2,
            $value is int => 3,
            $value is float => 4,
            $value is array<mixed> => 5,
            default => 6,
        };
    }
}

Leaf $head = new Leaf();
Leaf $cursor = $head;
uint $built = 0;

while ($built < 20000) {
    Leaf $node = new Leaf();
    $cursor->next = $node;
    $cursor = $node;
    $built = $built + 1;
}

try {
    echo Attack::chain($head, 0), "\n";
} catch (RecursionError $tooDeep) {
    echo "the call depth limit held\n";
}

array<mixed> $values = [new Leaf(), 'text', 7, 2.5, [1, 2], true];
int $total = 0;
uint $round = 0;

while ($round < 40000) {
    foreach ($values as mixed $value) {
        $total = $total + Attack::arms($value);

        if ($value is Leaf) {
            $total = $total + (Core\Str::length($value->tag) as int);
        }
    }

    $round = $round + 1;
}

echo $total, "\n";

// Inside the `if`, `$slot` gets a string, so the `Leaf` object it had is freed.
uint $churn = 0;

while ($churn < 200000) {
    mixed $slot = new Leaf();

    if ($slot is Leaf) {
        $slot->next = new Leaf();
        $slot = 'gone';
    }

    $churn = $churn + 1;
}

echo $churn, "\n";
