<?nvs
// Attack: the program converts values that are not allowed to a set of words,
// an enum, a `?uint` and a union. Each conversion should throw an error,
// or give `null` for `?uint`. The values include huge text, near misses and extreme numbers.
// hostile: timeout-ms 60000

enum Action
{ Read, Write, Admin }

class Poke
{
    // Each method checks whether a value is in a small set of allowed values.
    // The check happens while the program runs.
    public static function word(mixed $v): string
    {
        try {
            $v as "read"|"write"|"admin";
            return 'in';
        } catch (Throwable $e) {
            return 'out';
        }
    }

    public static function whichCase(mixed $v): string
    {
        try {
            return (($v as int) as Action) as int as string;
        } catch (Throwable $e) {
            return 'out';
        }
    }

    // `as ?uint` does not throw an error. It gives a number or `null`.
    public static function maybe(mixed $v): string
    {
        ?uint $n = $v as ?uint;
        return $n is null ? 'none' : ($n as string);
    }
}

// One megabyte of text, then near misses: one byte short, one byte long,
// a zero byte at the end, and capital letters.
string $huge = Core\Str::repeat('read', 262144);
echo Poke::word($huge), ' ', Poke::word('rea'), ' ', Poke::word('reads'), ' ', Poke::word("read\0"), ' ', Poke::word('READ'), "\n";

// Values that are not text, checked against the set of words.
echo Poke::word(0), ' ', Poke::word(null), ' ', Poke::word(true), ' ', Poke::word(['read']), ' ', Poke::word(1.5), "\n";

// Converts to an enum with three cases: the smallest and largest `int`,
// then `-1`, the last case `2`, and `3`.
echo Poke::whichCase('-9223372036854775808'), ' ', Poke::whichCase('9223372036854775807'), ' ', Poke::whichCase('-1'), ' ', Poke::whichCase('2'), ' ', Poke::whichCase('3'), "\n";

// Converts values of many types to `?uint`. Each one should give a number or `null`.
array<mixed> $rotation = [1, '2', 3.5, true, null, ['x'], '-1', '99999999999999999999999'];
uint $nothings = 0;
uint $j = 0;
while ($j < 8) {
    if (Poke::maybe($rotation[$j as int]) == 'none') {
        $nothings = $nothings + 1;
    }
    $j = $j + 1;
}
echo $nothings, " of eight answered nothing\n";

// A million loop rounds. The value is an `int` in some rounds and a `string` in others.
array<mixed> $ids = [1, 'one', 2, 'two', 3];
uint $numbers = 0;
uint $i = 0;
while ($i < 1000000) {
    int|string $id = $ids[($i % 5) as int] as int|string;
    if ($id is int) {
        $numbers = $numbers + 1;
    }
    $i = $i + 1;
}
echo $numbers, " of a million were numbers\n";

// A hundred thousand arrays nested inside each other.
// Then all of them are freed at once.
mixed $chain = null;
uint $depth = 0;
while ($depth < 100000) {
    $chain = ['next' => $chain];
    $depth = $depth + 1;
}
$chain = null;
echo "chained and released\n";
