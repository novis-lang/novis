<?nvs
// Attack: a function declared only as `callable` is called with arguments its parameters do not accept.
// Every call should throw a `LogicError`, and the function body should never run.

enum Level: int { Low = 1, High = 7 }
enum Color: int { Red = 1, Blue = 3 }

class Pet
{
    public string $name = 'pet';
}

class Rock
{
    public int $weight = 9;
}

class Runner
{
    // The parameter is a bare `callable`, so the compiler cannot check the arguments.
    public static function run(callable $f, object|array<int|string>|Color|string $v): mixed
    {
        return $f($v);
    }
}

// 1. An object of an unrelated class is passed where a `Pet` is declared.
try {
    Runner::run(fn(Pet $p): string => { echo "body ran\n"; return $p->name; }, new Rock());
    echo "called\n";
} catch (LogicError $refused) {
    echo "refused\n";
}

// 2. The same object is passed where a `?Pet` is declared.
try {
    Runner::run(fn(?Pet $p): string => { echo "body ran\n"; return 'p'; }, new Rock());
    echo "called\n";
} catch (LogicError $refused) {
    echo "refused\n";
}

// 3. An array with a string in it is passed where an `array<int>` is declared.
array<int|string> $mixed = [1, 'two', 3];
try {
    Runner::run(fn(array<int> $a): int => { echo "body ran\n"; return $a[1] + 1; }, $mixed);
    echo "called\n";
} catch (LogicError $refused) {
    echo "refused\n";
}

// 4. A case of another enum is passed where a `Level` is declared. Its value 3 is not a value of `Level`.
try {
    Runner::run(fn(Level $l): int => { echo "body ran\n"; return $l as int; }, Color::Blue);
    echo "called\n";
} catch (LogicError $refused) {
    echo "refused\n";
}

// 5. A string is passed where a `?float` is declared.
try {
    Runner::run(fn(?float $x): float => { echo "body ran\n"; return ($x ?? 0.0) * 2.0; }, 'text');
    echo "called\n";
} catch (LogicError $refused) {
    echo "refused\n";
}
