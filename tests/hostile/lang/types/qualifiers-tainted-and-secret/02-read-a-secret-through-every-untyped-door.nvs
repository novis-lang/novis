<?nvs
// Attack: a program tries to read a secret property where its type is unknown, and
// to put a long text into an error message. Each step should throw an error, and
// no message should contain the secret or the text.

class Vault
{
    public secret string $token = 's3cr3t-0f-the-vault';
    public string $owner = 'Shop';

    public function key(): secret string
    {
        return $this->token;
    }
}

class Probe
{
    // Prints whether the message of the error contains the given text.
    public static function report(string $step, string $message, string $hidden): void
    {
        echo $step, ': ', Core\Str::contains($message, $hidden) ? 'leaked' : 'kept', "\n";
    }
}

var $vault = new Vault();
mixed $loose = $vault;
object $erased = $vault;
string $hidden = 's3cr3t';

// Step 1: reads the property through a variable of type `object`.
try {
    var $first = $erased->token;
    echo "1: read\n";
} catch (LogicError $e) {
    Probe::report('1', $e->message, $hidden);
}

// Step 2: reads the property through a variable of type `mixed`.
try {
    var $second = $loose->token;
    echo "2: read\n";
} catch (LogicError $e) {
    Probe::report('2', $e->message, $hidden);
}

// Step 3: a shape test reads every field it names.
try {
    if ($loose is tainted { token: string }) {
        echo "3: matched\n";
    }
} catch (LogicError $e) {
    Probe::report('3', $e->message, $hidden);
}

// Step 4: reads the property by its name with `Core\Reflect`.
var $described = Core\Reflect::forObject($vault);
try {
    var $fourth = $described->get($vault, 'token');
    echo "4: read\n";
} catch (LogicError $e) {
    Probe::report('4', $e->message, $hidden);
}

// Step 5: calls the method that returns the secret, by its name.
try {
    var $fifth = $described->call($vault, 'key', []);
    echo "5: called\n";
} catch (LogicError $e) {
    Probe::report('5', $e->message, $hidden);
}

// Step 6: calls the same method through a variable of type `mixed`.
try {
    var $sixth = $loose->key();
    echo "6: called\n";
} catch (LogicError $e) {
    Probe::report('6', $e->message, $hidden);
}

// Step 7: converts a long text to a number. The conversion fails.
string $long = Core\Str::repeat('hunter2 ', 100000);
try {
    var $seventh = $long as int;
    echo "7: converted\n";
} catch (RuntimeError $failed) {
    Probe::report('7', $failed->message, 'hunter2');
}
