<?nvs
// Attack: a method is called on a `mixed` value with arguments of the wrong type. The
// method reads a property, calls a method or adds numbers. Each call should throw an error.

class Wallet
{
    public int $balance = 10;

    public function double(): int
    {
        return $this->balance * 2;
    }
}

// A class with a property of the same name, but the property is a string.
class FakeWallet
{
    public string $balance = 'a lot of money';

    public function double(): string
    {
        return $this->balance;
    }
}

class Bank
{
    public function read(Wallet $wallet): int
    {
        return $wallet->balance + 1;
    }

    public function ask(?Wallet $wallet): int
    {
        if ($wallet == null) {
            return 0;
        }
        return $wallet->double() + 1;
    }

    public function add(array<int> $amounts): int
    {
        int $sum = 0;
        foreach ($amounts as int $amount) {
            $sum = $sum + $amount;
        }
        return $sum;
    }

    public static function open(int $amount): int
    {
        return $amount;
    }

    public function raise(inout int $amount): void
    {
        $amount = $amount + 1;
    }
}

mixed $bank = new Bank();

// 1. Passes a `FakeWallet` where a `Wallet` is declared. The method reads its `balance`.
try {
    echo $bank->read(new FakeWallet()), "\n";
} catch (Throwable $error) {
    echo "step 1 refused\n";
}

// 2. Passes a `FakeWallet` and a string where `?Wallet` is declared. The method calls `double()`.
array<mixed> $notWallets = [new FakeWallet(), 'wallet'];
foreach ($notWallets as mixed $notWallet) {
    try {
        echo $bank->ask($notWallet), "\n";
    } catch (Throwable $error) {
        echo "step 2 refused\n";
    }
}

// 3. Passes arrays that contain a string, a float and an object where `array<int>` is declared.
array<array<mixed>> $lists = [[1, 'two'], [1, 2.5], [1, new Wallet()], [1, null]];
foreach ($lists as array<mixed> $list) {
    try {
        echo $bank->add($list), "\n";
    } catch (Throwable $error) {
        echo "step 3 refused\n";
    }
}

// 4. Calls a `static` method and a method with an `inout` parameter on the `mixed` value.
try {
    echo $bank->open(5), "\n";
} catch (Throwable $error) {
    echo "step 4 static refused\n";
}
try {
    $bank->raise(5);
    echo "step 4 inout called\n";
} catch (Throwable $error) {
    echo "step 4 inout refused\n";
}

// 5. Passes a `FakeWallet` 100000 times. Each error should be freed.
uint $refused = 0;
uint $i = 0;
FakeWallet $fake = new FakeWallet();
while ($i < 100000) {
    try {
        $bank->read($fake);
    } catch (Throwable $error) {
        $refused = $refused + 1;
    }
    $i = $i + 1;
}
echo $refused, "\n";
