<?nvs
// Attack: the program pushes `int`, `uint`, `float` and `decimal` past the ends of their range.
// It uses overflow, division by zero and very large powers. Each step should throw
// an error or give a correct value.
// hostile: timeout-ms 40000

int $top = 9223372036854775807;
int $bottom = -9223372036854775807 - 1;
uint $ceiling = 18446744073709551615;

try {
    echo $top + 1, "\n";
} catch (Throwable $e) {
    echo 'int top: ', $e->message, "\n";
}
try {
    echo $bottom - 1, "\n";
} catch (Throwable $e) {
    echo 'int bottom: ', $e->message, "\n";
}
try {
    echo -$bottom, "\n";
} catch (Throwable $e) {
    echo 'negating the bottom: ', $e->message, "\n";
}
try {
    echo $ceiling + 1, "\n";
} catch (Throwable $e) {
    echo 'uint ceiling: ', $e->message, "\n";
}
try {
    uint $floor = 0;
    echo $floor - 1, "\n";
} catch (Throwable $e) {
    echo 'uint floor: ', $e->message, "\n";
}
try {
    echo $top * $top, "\n";
} catch (Throwable $e) {
    echo 'int product: ', $e->message, "\n";
}
try {
    echo $top ** $top, "\n";
} catch (Throwable $e) {
    echo 'int power: ', $e->message, "\n";
}

// Divides by zero with every number type, and takes a remainder by zero.
int $zero = 0;
try {
    echo $top / $zero, "\n";
} catch (Throwable $e) {
    echo 'int by zero: ', $e->message, "\n";
}
try {
    echo $top % $zero, "\n";
} catch (Throwable $e) {
    echo 'int remainder by zero: ', $e->message, "\n";
}
try {
    float $wide = 1.5;
    echo $wide / 0.0, "\n";
} catch (Throwable $e) {
    echo 'float by zero: ', $e->message, "\n";
}
try {
    decimal $money = 1.50;
    echo $money / 0, "\n";
} catch (Throwable $e) {
    echo 'decimal by zero: ', $e->message, "\n";
}

// A `decimal` grows until it has too many digits before the point.
// Another one shrinks until it has too many digits after the point.
decimal $big = 1;
uint $left = 0;
try {
    while ($left < 100) {
        $big = $big * 1000;
        $left = $left + 1;
    }
    echo 'grew a decimal past every bound with no complaint', "\n";
} catch (Throwable $e) {
    echo 'decimal left of the point: ', $e->message, "\n";
}
decimal $small = 1;
uint $right = 0;
try {
    while ($right < 100) {
        $small = $small / 3;
        $right = $right + 1;
    }
    echo 'decimal right of the point: ', $small, ' -- rounded away rather than refused', "\n";
} catch (Throwable $e) {
    echo 'decimal right of the point: ', $e->message, "\n";
}

// A `float` grows past its largest value and becomes infinity, with no error.
// Then the program converts infinity to `int`.
float $huge = 1.0;
uint $doubles = 0;
while ($doubles < 5000) {
    $huge = $huge * 10.0;
    $doubles = $doubles + 1;
}
echo $huge, "\n";
try {
    echo $huge as int, "\n";
} catch (Throwable $e) {
    echo 'infinity as a whole number: ', $e->message, "\n";
}
try {
    float $nothing = $huge - $huge;
    echo $nothing, ' ', $nothing == $nothing ? 'equal to itself' : 'not equal to itself', "\n";
} catch (Throwable $e) {
    echo 'infinity minus itself: ', $e->message, "\n";
}

// Adds 1 to a `uint` many times, starting just below its largest value.
// The addition should throw an error when the result no longer fits.
uint $step = 18446744073709551610;
uint $taken = 0;
try {
    while ($taken < 100) {
        $step = $step + 1;
        $taken = $taken + 1;
    }
    echo 'walked past the ceiling with no complaint', "\n";
} catch (Throwable $e) {
    echo 'walked into the ceiling after ', $taken, " steps\n";
}

echo "still here\n";
