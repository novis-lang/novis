<?nvs
// Attack: build argument lists until one of them loses a value. Lists of a
// million leftovers go in; calls stack twenty thousand deep, each one holding
// a variable the one below it will write back into; and a method that throws
// halfway through is called hundreds of thousands of times, since the write
// back is the one step a throw is supposed to skip. A frame that forgets what
// it was holding shows up as a wrong total at the end.
// hostile: timeout-ms 20000

class Collect
{
    public static function howMany(int ...$rest): int
    {
        return Core\Arr::count($rest) as int;
    }

    public static function sum(int $first, int $second = 2, int ...$rest): int
    {
        int $total = $first + $second;

        foreach ($rest as int $each) {
            $total = $total + $each;
        }

        return $total;
    }

    public static function deepen(inout int $carried, int $depth): int
    {
        if ($depth == 0) {
            $carried = $carried + 1;

            return $carried;
        }

        int $inner = $carried;
        int $reached = Collect::deepen(inout $inner, $depth - 1);
        $carried = $inner;

        return $reached;
    }

    public static function halfway(inout int $slot): void
    {
        $slot = $slot + 1;

        throw new RuntimeError('halfway');
    }
}

// A million leftovers, poured in from a list rather than written out.
array<int> $many = Core\Arr::fill(1000000, 1);
echo Collect::howMany(...$many), "\n";
echo Collect::sum(1, 2, ...$many), "\n";

// The same call, built every way a caller can build it, hundreds of
// thousands of times over. Each round feeds the round before it back in.
int $rolling = 1;
int $round = 0;

while ($round < 200000) {
    $rolling = Collect::sum($rolling % 5) + Collect::sum($rolling % 5, 3)
        + Collect::sum(first: $rolling % 5, second: 3)
        + Collect::sum(second: 3, first: $rolling % 5)
        + Collect::sum($rolling % 5, 3, 4, 5);

    $round = $round + 1;
}

echo $rolling, "\n";

// Twenty thousand frames, every one of them holding a cell the frame below
// writes back into on the way out.
int $carried = 0;

try {
    echo Collect::deepen(inout $carried, 20000), ' ', $carried, "\n";
} catch (RecursionError $tooDeep) {
    echo "the call depth limit held\n";
}

// A callee that throws is the one path that does not reach the write back,
// and the cell it was handed has to survive being abandoned that often.
int $abandoned = 7;
int $attempt = 0;
int $caught = 0;

while ($attempt < 300000) {
    try {
        Collect::halfway(inout $abandoned);
    } catch (RuntimeError $stopped) {
        $caught = $caught + 1;
    }

    $attempt = $attempt + 1;
}

echo $caught, ' ', $abandoned, "\n";
