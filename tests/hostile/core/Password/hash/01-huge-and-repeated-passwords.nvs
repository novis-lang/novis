<?nvs
// Attack: a request hashes a huge password, an empty one, and many passwords in
// a row. Each hash should finish, and its memory should be freed every time.

// 1. A password of 32 MiB is hashed.
secret string $huge = Core\Str::repeat('x', 33554432);
string $stored = Core\Password::hash($huge);
echo Core\Password::verify($huge, $stored) ? 'huge ok' : 'huge wrong', "\n";

// 2. An empty password is hashed and checked.
secret string $empty = '';
string $emptyHash = Core\Password::hash($empty);
echo Core\Password::verify($empty, $emptyHash) ? 'empty ok' : 'empty wrong', "\n";

// 3. A password full of zero bytes is hashed. bcrypt stops at a zero byte.
// Argon2id reads all of it, so a shorter password must not match.
secret string $zeros = Core\Str::repeat("\0", 100);
string $zeroHash = Core\Password::hash($zeros);
secret string $shorter = "\0";
echo Core\Password::verify($shorter, $zeroHash) ? 'zeros matched' : 'zeros ok', "\n";

// 4. Forty hashes run one after another. Each one uses 19 MiB, so the
// memory must be freed after each call.
uint $i = 0;
uint $made = 0;
while ($i < 40) {
    secret string $password = Core\Str::repeat('p', $i + 1);
    string $one = Core\Password::hash($password);
    $made = $made + Core\Str::length($one);
    $i = $i + 1;
}
echo $made, "\n";
