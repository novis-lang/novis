<?nvs
// Attack: one connection joins the same topic again and again, and then tries
// to join a hundred thousand topics with long names. One connection can join
// at most 1024 topics, so `subscribe` throws a `LogicError` after that.
Core\Socket $conn = Core\Socket::current();

// 1. Join with an empty name. This throws a `LogicError`.
try {
    Core\Topic::subscribe('');
    echo "joined an empty name\n";
} catch (LogicError $error) {
    echo "empty name refused\n";
}

// 2. Join one topic a hundred thousand times. It is still one subscription.
uint $i = 0;
while ($i < 100000) {
    Core\Topic::subscribe('room:lobby');
    $i = $i + 1;
}
echo Core\Topic::publish('room:lobby', 'once'), " subscription\n";

// 3. Join a hundred thousand different topics, each with a long name.
// `room:lobby` is already one topic, so this throws after 1023 more.
string $long = Core\Str::repeat('x', 200);
$i = 0;
try {
    while ($i < 100000) {
        Core\Topic::subscribe('room:' . $long . ($i as string));
        $i = $i + 1;
    }
} catch (LogicError $error) {
    echo 'stopped after ', $i, " more topics\n";
}
echo Core\Topic::publish('room:' . $long . '1022', 'last'), " subscription\n";

// 4. Join a topic with a name longer than 256 bytes. This throws a `LogicError`.
try {
    Core\Topic::subscribe(Core\Str::repeat('y', 300));
    echo "joined a long name\n";
} catch (LogicError $error) {
    echo "long name refused\n";
}

// 5. Read what arrived. Both publishes arrive once each.
uint $arrived = 0;
?Core\Socket\Message $message = $conn->receive();
while ($message != null) {
    $arrived = $arrived + 1;
    $message = $conn->receive();
}
echo $arrived, " messages\n";
