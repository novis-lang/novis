<?nvs
// Attack: a script publishes values that are hard to copy to a subscriber.
// Each one should either arrive or throw an error, and the server must not crash.
// hostile: ends-early 4 FATAL
Core\Socket $conn = Core\Socket::current();
Core\Topic::subscribe('room:lobby');

class Login
{
    public string $user = 'ana';
    public secret string $password = 'hunter2';
}

// 1. Publish an empty topic name. This throws a `LogicError`.
try {
    Core\Topic::publish('', 'anything');
} catch (LogicError $error) {
    echo "empty name refused\n";
}

// 2. Publish a `secret` hidden deep inside a list. This throws a `LogicError`.
try {
    Core\Topic::publish('room:lobby', [[[[new Login()]]]]);
} catch (LogicError $secretError) {
    echo "secret refused\n";
}

// 3. Publish a list nested ten thousand levels deep.
mixed $deep = [];
uint $i = 0;
while ($i < 10000) {
    $deep = [$deep];
    $i = $i + 1;
}
try {
    Core\Topic::publish('room:lobby', $deep);
    echo "deep list published\n";
} catch (Throwable $deepError) {
    echo "deep list refused\n";
}

// 4. Publish a text of ten million characters, five hundred times, and never read it.
// Each copy waits for this connection, so the program stops at its memory limit with an error.
echo "step 4\n";
string $big = Core\Str::repeat('x', 10000000);
$i = 0;
while ($i < 500) {
    Core\Topic::publish('room:lobby', $big);
    $i = $i + 1;
}
