<?nvs
// Attack: a program reads binary values, lists of values and strange names as one
// text. Each of these must return `null` or throw an error, and nothing may crash.
// hostile: timeout-ms 60000
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $found = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['mail', 'memberOf', 'objectGUID', 'objectSid'] });

if ($found != null) {
    Core\Ldap\Entry $person = $found;

    // 1. Binary values and a list of values, read as one text, ten thousand times each.
    array<string> $wrong = ['objectGUID', 'objectSid', 'memberOf'];
    uint $threw = 0;
    uint $i = 0;
    while ($i < 10000) {
        foreach ($wrong as string $name) {
            try {
                echo $person->string($name) ?? '', "\n";
            } catch (LogicError $refusal) {
                $threw = $threw + 1;
            }
        }
        $i = $i + 1;
    }
    echo '1 threw: ', $threw, "\n";

    // 2. Names a user typed. A name the entry does not have returns `null`.
    array<string> $typed = ['', '*', 'mail;binary', "mail\x00", Core\Str::repeat('x', 100000)];
    uint $empty = 0;
    foreach ($typed as string $typedName) {
        try {
            if ($person->string($typedName) == null) {
                $empty = $empty + 1;
            }
        } catch (Throwable $error) {
            echo "2 threw\n";
        }
    }
    echo '2 null: ', $empty, "\n";

    // 3. The one real text value, read two hundred thousand times.
    uint $letters = 0;
    $i = 0;
    while ($i < 200000) {
        $letters = $letters + Core\Str::length($person->string('mail') ?? '');
        $i = $i + 1;
    }
    echo '3 letters: ', $letters, "\n";
}
