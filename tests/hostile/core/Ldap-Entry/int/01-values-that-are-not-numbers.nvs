<?nvs
// Attack: a program reads text, binary values and lists of values as one whole number.
// Each of these must return `null` or throw an error, and nothing may crash.
// hostile: timeout-ms 60000
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $found = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['logonCount', 'department', 'memberOf', 'objectGUID', 'objectSid', 'whenCreated'] });

if ($found != null) {
    Core\Ldap\Entry $person = $found;

    // 1. Text, binary values, a list and a time, read as a number, ten thousand times each.
    array<string> $wrong = ['department', 'memberOf', 'objectGUID', 'objectSid', 'whenCreated'];
    uint $threw = 0;
    uint $i = 0;
    while ($i < 10000) {
        foreach ($wrong as string $name) {
            try {
                echo $person->int($name) ?? 0, "\n";
            } catch (LogicError $refusal) {
                $threw = $threw + 1;
            }
        }
        $i = $i + 1;
    }
    echo '1 threw: ', $threw, "\n";

    // 2. Names a user typed. A name the entry does not have returns `null`.
    array<string> $typed = ['', '*', 'logonCount;binary', "logonCount\x00", Core\Str::repeat('x', 100000)];
    uint $empty = 0;
    foreach ($typed as string $typedName) {
        try {
            if ($person->int($typedName) == null) {
                $empty = $empty + 1;
            }
        } catch (Throwable $error) {
            echo "2 threw\n";
        }
    }
    echo '2 null: ', $empty, "\n";

    // 3. The one real number, read two hundred thousand times.
    int $sum = 0;
    $i = 0;
    while ($i < 200000) {
        $sum = $sum + ($person->int('logonCount') ?? 0) + 1;
        $i = $i + 1;
    }
    echo '3 sum: ', $sum, "\n";
}
