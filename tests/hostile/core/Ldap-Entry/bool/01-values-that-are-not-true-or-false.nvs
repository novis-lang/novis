<?nvs
// Attack: a program reads text, numbers, binary values and lists of values as `true` or
// `false`. Each of these must return `null` or throw an error, and nothing may crash.
// hostile: timeout-ms 60000
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $found = $corp->read('CN=Administrator,CN=Users,DC=example,DC=test', { select: ['isCriticalSystemObject', 'cn', 'adminCount', 'memberOf', 'objectGUID', 'objectSid'] });

if ($found != null) {
    Core\Ldap\Entry $admin = $found;

    // 1. Text, a number, binary values and a list, read as a `bool`, ten thousand times each.
    array<string> $wrong = ['cn', 'adminCount', 'memberOf', 'objectGUID', 'objectSid'];
    uint $threw = 0;
    uint $i = 0;
    while ($i < 10000) {
        foreach ($wrong as string $name) {
            try {
                echo ($admin->bool($name) ?? false) ? "true\n" : "false\n";
            } catch (LogicError $refusal) {
                $threw = $threw + 1;
            }
        }
        $i = $i + 1;
    }
    echo '1 threw: ', $threw, "\n";

    // 2. Names a user typed. A name the entry does not have returns `null`.
    array<string> $typed = ['', '*', 'isCriticalSystemObject;binary', "isCriticalSystemObject\x00", Core\Str::repeat('x', 100000)];
    uint $empty = 0;
    foreach ($typed as string $typedName) {
        try {
            if ($admin->bool($typedName) == null) {
                $empty = $empty + 1;
            }
        } catch (Throwable $error) {
            echo "2 threw\n";
        }
    }
    echo '2 null: ', $empty, "\n";

    // 3. The one real `bool`, read two hundred thousand times.
    uint $yes = 0;
    $i = 0;
    while ($i < 200000) {
        if ($admin->bool('isCriticalSystemObject') ?? false) {
            $yes = $yes + 1;
        }
        $i = $i + 1;
    }
    echo '3 true: ', $yes, "\n";
}
