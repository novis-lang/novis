<?nvs
// Attack: a program reads text, a SID and lists of values as a UUID. Each of these
// must return `null` or throw an error, and nothing may crash.
// hostile: timeout-ms 60000
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $found = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['objectGUID', 'objectSid', 'mail', 'memberOf', 'logonCount'] });

if ($found != null) {
    Core\Ldap\Entry $person = $found;

    // 1. A SID, text, a number and a list, read as a UUID, ten thousand times each.
    array<string> $wrong = ['objectSid', 'mail', 'memberOf', 'logonCount'];
    uint $threw = 0;
    uint $i = 0;
    while ($i < 10000) {
        foreach ($wrong as string $name) {
            try {
                echo $person->uuid($name)?->toString() ?? '', "\n";
            } catch (LogicError $refusal) {
                $threw = $threw + 1;
            }
        }
        $i = $i + 1;
    }
    echo '1 threw: ', $threw, "\n";

    // 2. Names a user typed. A name the entry does not have returns `null`.
    array<string> $typed = ['', '*', 'objectGUID;binary', "objectGUID\x00", Core\Str::repeat('x', 100000)];
    uint $empty = 0;
    foreach ($typed as string $typedName) {
        try {
            if ($person->uuid($typedName) == null) {
                $empty = $empty + 1;
            }
        } catch (Throwable $error) {
            echo "2 threw\n";
        }
    }
    echo '2 null: ', $empty, "\n";

    // 3. The one real GUID, read two hundred thousand times.
    uint $letters = 0;
    $i = 0;
    while ($i < 200000) {
        $letters = $letters + Core\Str::length($person->uuid('objectGUID')?->toString() ?? '');
        $i = $i + 1;
    }
    echo '3 letters: ', $letters, "\n";
}
