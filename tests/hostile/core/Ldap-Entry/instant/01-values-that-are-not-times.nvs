<?nvs
// Attack: a program reads text, binary values, small numbers and lists of values as a time.
// Each of these must return a time, `null` or an error, and nothing may crash.
// hostile: timeout-ms 60000
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $found = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['whenCreated', 'pwdLastSet', 'department', 'memberOf', 'objectGUID', 'objectSid', 'logonCount', 'primaryGroupID'] });

if ($found != null) {
    Core\Ldap\Entry $person = $found;

    // 1. Text, binary values, small numbers and a list, read as a time, ten thousand times each.
    array<string> $wrong = ['department', 'memberOf', 'objectGUID', 'objectSid', 'logonCount', 'primaryGroupID'];
    uint $threw = 0;
    uint $times = 0;
    uint $i = 0;
    while ($i < 10000) {
        foreach ($wrong as string $name) {
            try {
                if ($person->instant($name) != null) {
                    $times = $times + 1;
                }
            } catch (LogicError $refusal) {
                $threw = $threw + 1;
            }
        }
        $i = $i + 1;
    }
    echo '1 threw: ', $threw, ', times: ', $times, "\n";

    // 2. Names a user typed. A name the entry does not have returns `null`.
    array<string> $typed = ['', '*', 'whenCreated;binary', "whenCreated\x00", Core\Str::repeat('x', 100000)];
    uint $empty = 0;
    foreach ($typed as string $typedName) {
        try {
            if ($person->instant($typedName) == null) {
                $empty = $empty + 1;
            }
        } catch (Throwable $error) {
            echo "2 threw\n";
        }
    }
    echo '2 null: ', $empty, "\n";

    // 3. The two real times, read one hundred thousand times each.
    uint $letters = 0;
    $i = 0;
    while ($i < 100000) {
        $letters = $letters + Core\Str::length($person->instant('whenCreated')?->toIso() ?? '');
        $letters = $letters + Core\Str::length($person->instant('pwdLastSet')?->toIso() ?? '');
        $i = $i + 1;
    }
    echo '3 letters: ', $letters, "\n";
}
