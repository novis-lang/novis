<?nvs
// Attack: `typeOf` is given very large and very deeply nested values, many times.
// Each call should return one case at once, because `typeOf` never looks inside a value.

// 1. An array nested 100000 levels deep. The result is `Array`.
mixed $deep = [];
uint $level = 0;
while ($level < 100000) {
    $deep = [$deep];
    $level = $level + 1;
}
echo Core\Reflect::typeOf($deep) == Core\Reflect\TypeKind::Array ? 'array' : 'wrong', "\n";

// 2. A string of 16 million characters. The result is `Text`.
mixed $long = Core\Str::repeat('x', 16000000);
echo Core\Reflect::typeOf($long) == Core\Reflect\TypeKind::Text ? 'text' : 'wrong', "\n";

// 3. An array with one million elements. The result is `Array`.
array<int> $wide = [];
int $i = 0;
while ($i < 1000000) {
    $wide[] = $i;
    $i = $i + 1;
}
mixed $many = $wide;
echo Core\Reflect::typeOf($many) == Core\Reflect\TypeKind::Array ? 'array' : 'wrong', "\n";

// 4. Two million calls over five kinds of value. Every answer is checked.
array<mixed> $values = [0, '', null, false, $deep];
array<Core\Reflect\TypeKind> $expected = [
    Core\Reflect\TypeKind::Int,
    Core\Reflect\TypeKind::Text,
    Core\Reflect\TypeKind::Null,
    Core\Reflect\TypeKind::Bool,
    Core\Reflect\TypeKind::Array,
];
uint $wrong = 0;
int $n = 0;
while ($n < 2000000) {
    if (Core\Reflect::typeOf($values[$n % 5]) != $expected[$n % 5]) {
        $wrong = $wrong + 1;
    }
    $n = $n + 1;
}
echo $wrong, "\n";
