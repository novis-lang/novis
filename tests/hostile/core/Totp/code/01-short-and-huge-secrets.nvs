<?nvs
// Attack: codes are made from secrets of every short length, from a huge secret, and many times in a row.
// Every short secret should throw a `LogicError`, and nothing should crash, hang or leak.
// hostile: timeout-ms 30000

// 1. Secrets of 1 to 15 bytes are one byte too short or more. Each one throws.
int $refused = 0;
uint $length = 1;
while ($length < 16) {
    try {
        echo Core\Totp::code(Core\Random::bytes($length)), "\n";
    } catch (LogicError $e) {
        $refused = $refused + 1;
    }
    $length = $length + 1;
}
echo $refused, " short secrets refused\n";

// 2. The shortest secret that is allowed, and a secret of 16 MB.
echo Core\Str::length(Core\Totp::code(Core\Random::bytes(16))), "\n";
echo Core\Str::length(Core\Totp::code(Core\Random::bytes(16777216))), "\n";

// 3. One hundred thousand codes from one secret. Each code is a new string.
secret bytes $secret = Core\Random::bytes(20);
uint $characters = 0;
int $i = 0;
while ($i < 100000) {
    $characters = $characters + Core\Str::length(Core\Totp::code($secret));
    $i = $i + 1;
}
echo $characters, " characters\n";
