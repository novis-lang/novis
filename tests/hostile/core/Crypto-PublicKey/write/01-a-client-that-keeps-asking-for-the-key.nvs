<?nvs
// Attack: a client asks the server to write its public key over and over, in
// every encoding and in one the key does not have. The server should keep
// answering, should throw an error it can catch for the encoding that does not
// exist, and should reach its last line.
// hostile: timeout-ms 20000

bytes $rsaSpki = Core\Encoding::fromHex('');
Core\Crypto\PublicKey $rsa = Core\Crypto\PublicKey::read(
    $rsaSpki,
    Core\Crypto\KeyKind::RsaPkcs1,
    Core\Crypto\KeyFormat::Spki,
);
Core\Crypto\PublicKey $ed25519 = Core\Crypto\PublicKey::read(
    Core\Encoding::fromHex('fcce9008a33565248561295a7ce1cccb040b6129bba8ff24744953bbc01261ac'),
    Core\Crypto\KeyKind::Ed25519,
    Core\Crypto\KeyFormat::Raw,
);

// 1. A hundred thousand requests for the encoding an RSA key does not have.
// Every one of them is an error the server gets everything back from.
int $refusals = 0;
foreach (Core\Arr::range(1, 100000) as int $round) {
    try {
        $rsa->write(Core\Crypto\KeyFormat::Raw);
    } catch (Throwable $e) {
        $refusals += 1;
    }
}
echo '1 refused ', $refusals, ' times', "\n";

// 2. Two hundred thousand documents written and let go one at a time. A server
// that kept each one would run out of memory here.
int $written = 0;
foreach (Core\Arr::range(1, 200000) as int $round) {
    $written += Core\Bytes::length($ed25519->write(Core\Crypto\KeyFormat::Jwk)) as int;
}
echo '2 wrote ', $written, ' octets', "\n";

// 3. Fifty thousand of the widest documents kept at once, which is what a
// request does when it wants the server to run out of memory.
array<bytes> $kept = [];
foreach (Core\Arr::range(1, 50000) as int $round) {
    $kept[] = $rsa->write(Core\Crypto\KeyFormat::Jwk);
}
echo '3 kept ', Core\Arr::count($kept), ' documents', "\n";

// 4. The key written in every encoding it has, after all of that. A member
// that had moved the key out of the object would answer nothing here.
echo '4 still ', Core\Bytes::length($ed25519->write(Core\Crypto\KeyFormat::Spki)), ' octets', "\n";
