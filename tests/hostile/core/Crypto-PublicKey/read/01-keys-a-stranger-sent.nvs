<?nvs
// Attack: a program reads public keys sent by somebody it does not trust. Every
// key that is not what it claims to be should throw an error the program
// catches. The program should reach its last line.
// hostile: timeout-ms 20000

// 1. Two hundred thousand filler octets read as a key document.
try {
    Core\Crypto\PublicKey::read(
        Core\Bytes::fill(200000, 3),
        Core\Crypto\KeyKind::P256,
        Core\Crypto\KeyFormat::Spki,
    );
    echo '1 read a key out of filler octets', "\n";
} catch (Throwable $e) {
    echo '1 refused', "\n";
}

// 2. A P-256 key with its last octet changed, so the point is not on the curve.
// A reader that only measures the length would take it.
try {
    Core\Crypto\PublicKey::read(
        Core\Encoding::fromHex('0468aa7eb5d775b8ab32e53b3a2b006dc42638d4d5a06d9b50c493781e2a65f3e036cb273ea410534a6e8c946ae9ea7e10318686faeeba6850b16fdb2572ff0e88'),
        Core\Crypto\KeyKind::P256,
        Core\Crypto\KeyFormat::Raw,
    );
    echo '2 read a point that is not on the curve', "\n";
} catch (Throwable $e) {
    echo '2 refused', "\n";
}

// 3. A JWK whose RSA number is five million characters long. This is what a
// request sends when it wants the server to work on one key forever.
try {
    Core\Crypto\PublicKey::read(
        ("{\"kty\":\"RSA\",\"e\":\"AQAB\",\"n\":\"" . Core\Str::repeat('A', 5000000) . "\"}") as bytes,
        Core\Crypto\KeyKind::RsaPkcs1,
        Core\Crypto\KeyFormat::Jwk,
    );
    echo '3 read a key with a five million character number', "\n";
} catch (Throwable $e) {
    echo '3 refused', "\n";
}

// 4. A JWK that is one hundred thousand open brackets. A reader that follows
// each bracket with a new call runs out of stack before it runs out of input.
try {
    Core\Crypto\PublicKey::read(
        Core\Str::repeat('[', 100000) as bytes,
        Core\Crypto\KeyKind::Ed25519,
        Core\Crypto\KeyFormat::Jwk,
    );
    echo '4 read a key out of open brackets', "\n";
} catch (Throwable $e) {
    echo '4 refused', "\n";
}

// 5. A private key sent where a public key goes. The document is a real key,
// and the member of it named `d` is the half nobody should send.
try {
    Core\Crypto\PublicKey::read(
        "{\"crv\":\"Ed25519\",\"d\":\"Nue-RPHfwV1kqA-Y2PLXn5eIB6fEYmFy87eV3H4RBIo\",\"kty\":\"OKP\",\"x\":\"_M6QCKM1ZSSFYSlafOHMywQLYSm7qP8kdElTu8ASYaw\"}" as bytes,
        Core\Crypto\KeyKind::Ed25519,
        Core\Crypto\KeyFormat::Jwk,
    );
    echo '5 read a private key as a public one', "\n";
} catch (Throwable $e) {
    echo '5 refused', "\n";
}

// 6. One real Ed25519 key read as every other kind of the roster. Only the kind
// is wrong, so a reader that trusts the octets would accept all of them.
bytes $ed25519 = Core\Encoding::fromHex('302a300506032b6570032100fcce9008a33565248561295a7ce1cccb040b6129bba8ff24744953bbc01261ac');
array<Core\Crypto\KeyKind> $wrong = [
    Core\Crypto\KeyKind::X25519,
    Core\Crypto\KeyKind::P256,
    Core\Crypto\KeyKind::RsaPkcs1,
    Core\Crypto\KeyKind::RsaPss,
];
foreach ($wrong as Core\Crypto\KeyKind $kind) {
    try {
        Core\Crypto\PublicKey::read($ed25519, $kind, Core\Crypto\KeyFormat::Spki);
        echo '6 read an Ed25519 key as another kind', "\n";
    } catch (Throwable $e) {
        echo '6 refused', "\n";
    }
}

// 7. Twenty thousand keys read from one good document and kept. A request does
// this when it wants the server to run out of memory.
array<Core\Crypto\PublicKey> $kept = [];
int $held = 0;
foreach (Core\Arr::range(1, 20000) as int $round) {
    $kept[] = Core\Crypto\PublicKey::read(
        $ed25519,
        Core\Crypto\KeyKind::Ed25519,
        Core\Crypto\KeyFormat::Spki,
    );
    $held += 1;
}
echo '7 kept ', $held, ' keys', "\n";
