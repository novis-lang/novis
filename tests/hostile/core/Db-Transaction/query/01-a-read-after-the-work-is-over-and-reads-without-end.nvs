<?nvs
// Attack: a transaction is kept after its work returned, and used to read.
// Then one transaction is asked for values that look like SQL, fifty thousand
// reads, ten thousand broken ones, and a statement of two million characters.
// Every bad call must throw, and the connection must still work afterwards.
// hostile: timeout-ms 120000

var $db = Core\Db::connect('notes');
$db->execute('create table notes (id integer primary key, text text not null)', []);
$db->execute('insert into notes (text) values (?), (?)', ['buy milk', 'call Ana']);

// 1. The transaction is carried out of the work that owned it. Reading through
// it would read outside every transaction, so it must be refused.
var $escaped = $db->transaction(fn (Core\Db\Transaction $tx): Core\Db\Transaction => $tx);
try {
    $escaped->query('select id from notes', []);
    echo "1 the late read went through\n";
} catch (Throwable $late) {
    echo "1 the late read was refused\n";
}

// 2. Values written to look like the end of one statement and the start of
// another. Each one is searched for as text, and the table is still there.
array<string> $attempts = [
    "buy milk' or '1'='1",
    "'; drop table notes; --",
    "' union select id, text from notes --",
    Core\Str::repeat("'", 10000),
];
uint $found = $db->transaction(fn (Core\Db\Transaction $tx): uint => {
    uint $rows = 0;
    foreach ($attempts as string $attempt) {
        $rows = $rows + $tx->query('select id from notes where text = ?', [$attempt])->count();
    }
    return $rows;
});
echo '2 rows found: ', $found, ', table still there: ', $db->query('select id from notes', [])->count(), "\n";

// 3. Fifty thousand reads inside one transaction. Each result is freed at
// once, and fifty thousand of them may not fill the memory.
try {
    uint $read = $db->transaction(fn (Core\Db\Transaction $tx): uint => {
        uint $seen = 0;
        uint $i = 0;
        while ($i < 50000) {
            $seen = $seen + $tx->query('select id, text from notes order by id', [])->count();
            $i = $i + 1;
        }
        return $seen;
    });
    echo '3 rows read: ', $read, "\n";
} catch (Throwable $stopped) {
    echo "3 the reads were stopped\n";
}

// 4. Ten thousand reads whose `:missing` names no value, all in one
// transaction. Every one throws, and the errors may not fill the memory.
uint $refused = $db->transaction(fn (Core\Db\Transaction $tx): uint => {
    string $byName = 'select id from notes where text = :missing';
    uint $failed = 0;
    uint $i = 0;
    while ($i < 10000) {
        try {
            $tx->query($byName, ['other' => 'x']);
        } catch (Throwable $error) {
            $failed = $failed + 1;
        }
        $i = $i + 1;
    }
    return $failed;
});
echo '4 refused: ', $refused, "\n";

// 5. A statement of two million characters. No database knows it, so it must be
// refused, and the transaction around it must still end.
try {
    $db->transaction(fn (Core\Db\Transaction $tx): void => {
        $tx->query(Core\Str::repeat('select ', 250000), []);
    });
    echo "5 the long statement ran\n";
} catch (Throwable $error) {
    echo "5 the long statement was refused\n";
}

// 6. The connection after all of that. An ordinary read still works, so no
// transaction was left open.
echo '6 still usable: ', $db->query('select id from notes', [])->count(), " rows\n";

$db->close();
