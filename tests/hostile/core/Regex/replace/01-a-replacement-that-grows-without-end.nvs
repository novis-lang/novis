<?nvs
// Attack: a program builds replacements that repeat the match many times, over very
// long texts. Each call should return a text or throw an error. The last one should
// stop at the memory limit before the new text is built.
// hostile: ends-early

class Replace
{
    public static function length(string $subject, string $pattern, string $replacement): string
    {
        try {
            return Core\Str::length(Core\Regex::replace($subject, $pattern, $replacement)) as string;
        } catch (RuntimeError $e) {
            return 'error';
        }
    }
}

// 1. A replacement with 100000 references to group 1. This prints 100000.
echo Replace::length('7', '(\d)', Core\Str::repeat('$1', 100000)), "\n";

// 2. A pattern that matches an empty text at every position of a text of one
// million characters. A "-" goes between every two characters. This prints 2000001.
echo Replace::length(Core\Str::repeat('é', 1000000), 'x*', '-'), "\n";

// 3. A pattern that needs very many steps to fail. This throws an error.
echo Replace::length(Core\Str::repeat('a', 40) . 'b', '^(a|a?)+\1$', 'x'), "\n";

// 4. References to groups that do not exist, and `$` signs that start no reference.
// The new text is "a$x$c", so this prints 5.
echo Replace::length('abc', '(b)', '$9${nope}$x$'), "\n";

// 5. 100000 replacements, and every result is freed. This prints 100000.
uint $done = 0;
uint $i = 0;
while ($i < 100000) {
    if (Core\Regex::replace('order-' . ($i % 100) as string, '(\d+)', '#$1') != '') {
        $done = $done + 1;
    }
    $i = $i + 1;
}
echo $done, "\n";

// 6. A match of 100000 characters is repeated 100000 times. The new text would need
// about 10 GB, so the program stops here with a memory limit error.
echo Replace::length(Core\Str::repeat('a', 100000), '.+', Core\Str::repeat('$0', 100000)), "\n";
