<?nvs
// Attack: a program gives a million answers, answers of ten million characters and answers
// with control characters. Each prompt should return an answer or throw an error, and the program must not crash.
// hostile: timeout-ms 60000

// Step 1: one million answers that no prompt ever reads.
array<string> $many = [];
uint $i = 0;
while ($i < 1000000) {
    $many[] = 'answer ' . $i;
    $i = $i + 1;
}
Core\Test::scriptAnswers($many);
echo "one million answers\n";

// Step 2: `ask` reads the first of them, and the rest stay waiting.
echo Core\Cli::ask('First?'), "\n";

// Step 3: an answer of ten million characters, read after all the others.
Core\Test::scriptAnswers([Core\Str::repeat('a', 10000000)]);
$i = 1;
while ($i < 1000000) {
    Core\Cli::ask('Next?');
    $i = $i + 1;
}
echo Core\Str::length(Core\Cli::ask('Long?')), "\n";

// Step 4: answers with a zero byte, a new line, a terminal escape code and a lone `\r`.
Core\Test::scriptAnswers(["a\0b", "one\ntwo", "\x1b[2J\x1b[H", "\r"]);
$i = 0;
while ($i < 4) {
    echo Core\Str::length(Core\Cli::ask('Text?')), "\n";
    $i = $i + 1;
}

// Step 5: menu numbers that are zero, negative, far too large or not numbers.
// `select` asks again for each one and then takes "1".
Core\Test::scriptAnswers(['0', '-1', '99999999999999999999999', '1e3', ' 2x', '', '1']);
array<string> $choices = ['first', 'second'];
try {
    echo Core\Cli::select('Pick?', $choices), "\n";
} catch (Throwable $error) {
    echo "select: error\n";
}

// Step 6: ten thousand answers that `confirm` does not accept, and then no answer is left.
array<string> $wrong = [];
$i = 0;
while ($i < 10000) {
    $wrong[] = 'maybe';
    $i = $i + 1;
}
Core\Test::scriptAnswers($wrong);
try {
    Core\Cli::confirm('Sure?');
    echo "confirm: answered\n";
} catch (Core\Cli\NotInteractive $unanswered) {
    echo "confirm: no answer left\n";
}

// Step 7: one hundred thousand rounds of one answer and one prompt.
$i = 0;
uint $total = 0;
while ($i < 100000) {
    Core\Test::scriptAnswers(['x' . $i]);
    $total = $total + Core\Str::length(Core\Cli::ask('Round?'));
    $i = $i + 1;
}
echo $total, "\n";
