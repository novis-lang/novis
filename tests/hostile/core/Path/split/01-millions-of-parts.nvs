<?nvs
// Attack: `Core\Path::split` is given paths with millions of parts, very long parts
// and roots in strange places. Each call should return an array, and the program must not crash.
// hostile: timeout-ms 60000

// 1. The path has two million parts of one letter each.
echo Core\Arr::count(Core\Path::split(Core\Str::repeat('a/', 2097152))), "\n";

// 2. The path is 8 MiB of separators, so only the root is left.
echo Core\Arr::count(Core\Path::split(Core\Str::repeat("/\\", 4194304))), "\n";

// 3. One part is 8 MiB long.
echo Core\Str::length(Core\Path::split('/' . Core\Str::repeat('x', 8388608))[1]), "\n";

// 4. The path has two million `..` parts, and every one of them is kept.
echo Core\Arr::count(Core\Path::split(Core\Str::repeat('../', 2097152))), "\n";

// 5. The same path is split 200 times, and every result is freed.
string $long = Core\Str::repeat('dir/', 50000);
uint $seen = 0;
int $r = 0;
while ($r < 200) {
    $seen = $seen + Core\Arr::count(Core\Path::split($long));
    $r = $r + 1;
}
echo $seen, "\n";

// 6. A network share with no name, and a drive with nothing after it.
echo Core\Arr::count(Core\Path::split("\\\\")), ' ', Core\Arr::count(Core\Path::split('C:')), "\n";

// 7. The parts have emoji, a null byte and characters from other scripts.
echo Core\Arr::count(Core\Path::split("/données/報告\u{0}/😀")), "\n";

echo 'the runtime is still standing', "\n";
