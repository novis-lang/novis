<?nvs
// Attack: a program turns the flag on and off many times next to the flags around its bit.
// `trustedToAuthForDelegation` must only report its own bit, and nothing may crash.
// hostile: timeout-ms 60000
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');

try {
    var $found = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();
    if ($found != null) {
        Core\Ldap\Ad\AccountFlags $flags = $found;

        // 1. The flag turned on and off one hundred thousand times, with the bits beside it set the other way.
        uint $wrong = 0;
        uint $i = 0;
        while ($i < 100000) {
            bool $on = $i % 2 == 0;
            var $changed = $flags->with({ trustedToAuthForDelegation: $on, noPreauthRequired: !$on, partialSecretsAccount: !$on });
            if ($changed->trustedToAuthForDelegation() != $on) {
                $wrong = $wrong + 1;
            }
            $i = $i + 1;
        }
        echo '1 wrong: ', $wrong, "\n";

        // 2. Every other delegation flag set. `trustedToAuthForDelegation` must still be `false`.
        var $others = $flags->with({ trustedForDelegation: true, notDelegated: true, noPreauthRequired: true, partialSecretsAccount: true });
        echo '2 acts without password: ', $others->trustedToAuthForDelegation() ? 'yes' : 'no', ' bits: ', $others->bits(), "\n";
    }
} catch (Throwable $error) {
    echo "threw\n";
}
