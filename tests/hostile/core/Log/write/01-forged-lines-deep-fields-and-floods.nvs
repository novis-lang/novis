<?nvs
// Attack: a program logs text built to fake a second record, very deep fields and a flood
// of records. The program must not crash, and its memory must not grow with the flood.
// hostile: timeout-ms 60000

class Node
{
    public ?Node $next = null;
}

// The records go to standard error, because no `[log] target` is set.

// 1. A message with line breaks, quotes and terminal control characters tries to start a
// second record.
string $forged = "ok\"}\n{\"level\":\"critical\",\"msg\":\"forged\"}\r\u{0}" . Core\Str::fromCodePoint(27) . '[2J';
Core\Log::write(Core\Log::Level::Info, $forged, [$forged => $forged]);
echo 'step 1: done', "\n";

// 2. Fields nested one hundred thousand arrays deep. The writer must not run out of stack.
array<mixed> $deep = [];
uint $d = 0;
while ($d < 100000) {
    $deep = ['inner' => $deep];
    $d = $d + 1;
}
Core\Log::write(Core\Log::Level::Info, 'deep', $deep);
echo 'step 2: done', "\n";

// 3. An object that points to itself. The writer must stop at the second visit.
Node $loop = new Node();
$loop->next = $loop;
Core\Log::write(Core\Log::Level::Info, 'cycle', ['node' => $loop]);
echo 'step 3: done', "\n";

// 4. A message of ten million characters.
string $huge = Core\Str::repeat('A', 10000000);
Core\Log::write(Core\Log::Level::Info, $huge);
echo 'step 4: done', "\n";

// 5. One hundred thousand different records.
uint $i = 0;
while ($i < 100000) {
    Core\Log::write(Core\Log::Level::Info, 'row', ['row' => $i]);
    $i = $i + 1;
}
echo 'step 5: done', "\n";

// 6. The same record one hundred thousand times. The memory used must not grow with
// each record.
uint $j = 0;
while ($j < 100000) {
    Core\Log::write(Core\Log::Level::Warn, 'the disk is almost full');
    $j = $j + 1;
}
echo 'step 6: done', "\n";
