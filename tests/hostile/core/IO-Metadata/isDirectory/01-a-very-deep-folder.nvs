<?nvs
// Attack: a program makes a folder 100 levels deep and calls `isDirectory` at every level.
// It also checks the root of the temporary folder and a path with `..` in it.
// Each step must return the right answer or throw an error, and must not crash.
// hostile: timeout-ms 60000

string $root = Core\Path::join(Core\IO::createTemporaryDirectory(), 'attack-metadata-is-dir');
Core\IO::makeDirectory($root);

// 1. The folder gets one level deeper 100 times. The path gets very long, so the
// operating system may not allow it. Then `makeDirectory` or `metadata` throws an `IOError`.
string $path = $root;
uint $depth = 0;
try {
    while ($depth < 100) {
        $path = Core\Path::join($path, 'level');
        Core\IO::makeDirectory($path);
        if (!Core\IO::metadata($path)->isDirectory()) {
            throw new LogicError('a folder was not a folder');
        }
        $depth = $depth + 1;
    }
} catch (IOError $e) {
    echo 'the path became too long', "\n";
}
echo 'step 1: done', "\n";

// 2. The temporary folder itself, and a path that goes down and back up with `..`.
// Both must be folders.
string $back = Core\Path::join(Core\Path::join($root, 'level'), '..');
if (!Core\IO::metadata(Core\IO::createTemporaryDirectory())->isDirectory() || !Core\IO::metadata($back)->isDirectory()) {
    throw new LogicError('a folder was not a folder');
}
echo 'step 2: done', "\n";
