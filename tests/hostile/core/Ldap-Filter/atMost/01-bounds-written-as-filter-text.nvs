<?nvs
// Attack: an upper limit from a form is written as filter text, or is not a
// number at all. Each value must stay one value, and nothing may crash.

// 1. Values that would add a filter, if they were filter text.
array<string> $values = ['9)(|(objectClass=*', '*', '-99', '', "\\", "\t"];
foreach ($values as string $value) {
    try {
        echo '1 ', Core\Ldap\Filter::atMost('badPwdCount', $value)->toString(), "\n";
    } catch (Throwable $error) {
        echo "1 threw\n";
    }
}

// 2. A value of one million characters that all need escaping.
try {
    var $long = Core\Ldap\Filter::atMost('badPwdCount', Core\Str::repeat('(', 1000000));
    echo '2 length: ', Core\Str::length($long->toString()), "\n";
} catch (Throwable $error) {
    echo "2 threw\n";
}

// 3. Attribute names that try to carry a comparison. Each one must throw an error.
array<string> $names = ['', 'badPwdCount<', 'badPwdCount<=9)(cn', '<='];
uint $refused = 0;
foreach ($names as string $name) {
    try {
        Core\Ldap\Filter::atMost($name, '1');
    } catch (LogicError $notAName) {
        $refused = $refused + 1;
    }
}
echo '3 refused: ', $refused, ' of ', Core\Arr::count($names), "\n";
