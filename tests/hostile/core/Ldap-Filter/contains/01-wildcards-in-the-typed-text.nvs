<?nvs
// Attack: a search word from a form is full of `*` and `)`, to make the
// search match everything. Each text must stay one value, and nothing may crash.

// 1. Texts that would be wildcards or new filters, if they were filter text.
array<string> $typed = ['*', '*a*', ')(|(cn=*', "\\5c", "\x01\x02"];
foreach ($typed as string $text) {
    try {
        echo '1 ', Core\Ldap\Filter::contains('description', $text)->toString(), "\n";
    } catch (Throwable $error) {
        echo "1 threw\n";
    }
}

// 2. An empty text. It must throw an error and not match everything.
try {
    Core\Ldap\Filter::contains('description', '');
    echo "2 built\n";
} catch (LogicError $empty) {
    echo "2 refused\n";
}

// 3. Ten thousand searches, each with a longer text than the one before.
uint $length = 0;
uint $i = 1;
while ($i <= 10000) {
    try {
        $length = Core\Str::length(Core\Ldap\Filter::contains('cn', Core\Str::repeat('x', $i))->toString());
    } catch (Throwable $error) {
        echo "3 threw\n";
        break;
    }
    $i = $i + 1;
}
echo '3 last length: ', $length, "\n";

// 4. Attribute names that try to carry filter text. Each one must throw an error.
array<string> $names = ['', '*', 'description=*', ' description'];
uint $refused = 0;
foreach ($names as string $name) {
    try {
        Core\Ldap\Filter::contains($name, 'a');
    } catch (LogicError $notAName) {
        $refused = $refused + 1;
    }
}
echo '4 refused: ', $refused, ' of ', Core\Arr::count($names), "\n";
