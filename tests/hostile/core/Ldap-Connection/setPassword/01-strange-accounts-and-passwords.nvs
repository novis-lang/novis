<?nvs
// Attack: a program sets strange passwords, and sets passwords on entries that are not user accounts.
// Each call must work or throw an error, and nothing may crash.
// hostile: timeout-ms 120000
// requires: samba-ad

var $corp = Core\Ldap::connect('corp-accounts');
string $unit = 'OU=Hostile Staff,DC=example,DC=test';
string $user = 'CN=Hostile User,' . $unit;

// A run that stopped early can leave the account behind, so the program deletes it first.
array<string> $leftovers = [$user, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $missing) {
    }
}
$corp->add($unit, ['objectClass' => 'organizationalUnit']);
$corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'hostile.user']);

// 1. Passwords with quotes, zero bytes, emoji and other strange text, and a very long one.
array<string> $passwords = [
    '',
    '"',
    '""',
    'Pass"word-1"',
    "Pass\x00word-1",
    "Pass\nword-1",
    'Pässwörd-Ünïcode-1',
    'Emoji-🔑🔑🔑-Pass-1',
    '\\\\\\\\Back-slash-1',
    Core\Str::repeat('Aa1-', 64),
    Core\Str::repeat('Aa1-', 16384),
];
uint $set = 0;
uint $threw = 0;
foreach ($passwords as string $password) {
    try {
        $corp->setPassword($user, $password);
        $set = $set + 1;
    } catch (Throwable $error) {
        $threw = $threw + 1;
    }
}
echo '1 set: ', $set, ', threw: ', $threw, "\n";

// 2. Entries that are not user accounts, entries that do not exist, and names that are not DNs.
array<string> $entries = [
    $unit,
    'CN=Employees,OU=Company,DC=example,DC=test',
    'DC=example,DC=test',
    'CN=Nobody,' . $unit,
    'not a name',
    '',
    'CN=' . Core\Str::repeat('a', 100000) . ',' . $unit,
];
$set = 0;
$threw = 0;
foreach ($entries as string $entry) {
    try {
        $corp->setPassword($entry, 'Hostile-Pass-2');
        $set = $set + 1;
    } catch (Throwable $error) {
        $threw = $threw + 1;
    }
}
echo '2 set: ', $set, ', threw: ', $threw, "\n";

// 3. One hundred new passwords in a row. Nothing may be left behind.
uint $i = 0;
$set = 0;
while ($i < 100) {
    try {
        $corp->setPassword($user, 'Hostile-Round-' . $i . '-Pass');
        $set = $set + 1;
    } catch (Throwable $error) {
    }
    $i = $i + 1;
}
echo '3 set: ', $set, "\n";

// 4. The account and its unit are removed again.
try {
    $corp->delete($user);
    $corp->delete($unit);
} catch (Throwable $error) {
}
echo '4 done', "\n";
