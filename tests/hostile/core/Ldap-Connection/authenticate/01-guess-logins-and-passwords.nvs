<?nvs
// Attack: a program tries strange logins and passwords, and many wrong guesses in a row.
// Each step should throw an error or work, and the connection must keep its own login.
// hostile: timeout-ms 180000
// requires: samba-ad

var $corp = Core\Ldap::connect('corp-accounts');
string $before = $corp->whoami();
string $unit = 'OU=Hostile Login,DC=example,DC=test';
string $user = 'CN=Hostile Login,' . $unit;
array<string> $leftovers = [$user, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $missing) {
    }
}
$corp->add($unit, ['objectClass' => 'organizationalUnit']);
$corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'hostile.login']);
$corp->setPassword($user, 'Hostile-Pass-19');
$corp->modify($user, [Core\Ldap\Change::replace('userAccountControl', 512)]);

// 1. Logins that are empty, not a DN, a filter, a zero byte, and one million characters long.
array<string> $logins = ['', ' ', 'not a dn', '*', '(cn=*)', "CN=Hostile Login\x00,OU=x", 'EXAMPLE\\', '@example.test', Core\Str::repeat('a', 1000000)];
uint $threw = 0;
foreach ($logins as string $login) {
    try {
        $corp->authenticate($login, 'Hostile-Pass-19');
    } catch (Throwable $error) {
        $threw = $threw + 1;
    }
}
echo '1 threw: ', $threw, "\n";

// 2. Passwords that are empty, a zero byte, and one million characters long.
array<string> $passwords = ['', "Hostile-Pass-19\x00", Core\Str::repeat('p', 1000000)];
uint $refused = 0;
foreach ($passwords as string $password) {
    try {
        $corp->authenticate($user, $password);
    } catch (Throwable $error) {
        $refused = $refused + 1;
    }
}
echo '2 refused: ', $refused, "\n";

// 3. Ten wrong guesses in a row, then the right password.
uint $wrong = 0;
uint $i = 0;
while ($i < 10) {
    try {
        $corp->authenticate($user, 'Guess-' . $i);
    } catch (Core\Ldap\LdapError $guessed) {
        $wrong = $wrong + 1;
    }
    $i = $i + 1;
}
try {
    $corp->authenticate($user, 'Hostile-Pass-19');
    echo '3 wrong: ', $wrong, ', right: accepted', "\n";
} catch (Core\Ldap\LdapError $locked) {
    echo '3 wrong: ', $wrong, ', right: refused', "\n";
}

// 4. After all of that, the connection is still logged in as its own account.
echo '4 same: ', $corp->whoami() == $before ? 'yes' : 'no', "\n";

try {
    $corp->delete($user);
    $corp->delete($unit);
} catch (Core\Ldap\LdapError $missing) {
}
