<?nvs
// Attack: a program changes a password with strange old and new passwords, many times in a row.
// Each call must work or throw an error, and nothing may crash.
// hostile: timeout-ms 120000
// requires: samba-ad

var $corp = Core\Ldap::connect('corp-accounts');
string $unit = 'OU=Hostile Changes,DC=example,DC=test';
string $user = 'CN=Hostile Changer,' . $unit;

// A run that stopped early can leave the account behind, so the program deletes it first.
array<string> $leftovers = [$user, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $missing) {
    }
}
$corp->add($unit, ['objectClass' => 'organizationalUnit']);
$corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'hostile.changer']);
$corp->setPassword($user, 'Hostile-Start-Pass-1');
$corp->modify($user, [
    Core\Ldap\Change::replace('userAccountControl', 512),
    Core\Ldap\Change::replace('pwdLastSet', 0),
]);

// 1. Old passwords that are wrong, empty, full of quotes or zero bytes, or very long.
array<string> $olds = [
    '',
    '"',
    'Hostile-Start-Pass-1"',
    "Hostile-Start-Pass-1\x00",
    'hostile-start-pass-1',
    Core\Str::repeat('Aa1-', 16384),
];
uint $changed = 0;
uint $threw = 0;
foreach ($olds as string $old) {
    try {
        $corp->changePassword($user, $old, 'Hostile-Next-Pass-2');
        $changed = $changed + 1;
    } catch (Throwable $error) {
        $threw = $threw + 1;
    }
}
echo '1 changed: ', $changed, ', threw: ', $threw, "\n";

// 2. New passwords that are empty, the same as the old one, full of quotes, or very long.
array<string> $news = [
    '',
    'Hostile-Start-Pass-1',
    '"',
    'New"Pass"Word-3',
    "New\x00Pass-3",
    'Emoji-🔑🔑-Pass-3',
    Core\Str::repeat('Aa1-', 16384),
];
$changed = 0;
$threw = 0;
string $current = 'Hostile-Start-Pass-1';
foreach ($news as string $new) {
    try {
        $corp->changePassword($user, $current, $new);
        $current = $new;
        $changed = $changed + 1;
    } catch (Throwable $error) {
        $threw = $threw + 1;
    }
}
echo '2 changed: ', $changed, ', threw: ', $threw, "\n";

// 3. Entries that are not user accounts, entries that do not exist, and names that are not DNs.
array<string> $entries = [
    $unit,
    'CN=Employees,OU=Company,DC=example,DC=test',
    'CN=Nobody,' . $unit,
    'not a name',
    '',
];
$changed = 0;
$threw = 0;
foreach ($entries as string $entry) {
    try {
        $corp->changePassword($entry, 'Hostile-Start-Pass-1', 'Hostile-Other-Pass-4');
        $changed = $changed + 1;
    } catch (Throwable $error) {
        $threw = $threw + 1;
    }
}
echo '3 changed: ', $changed, ', threw: ', $threw, "\n";

// 4. Fifty changes in a row, each from the last new password. Nothing may be left behind.
// `pwdLastSet` 0 before each change lets the user change the password again at once.
$current = 'Hostile-Round-Start';
try {
    $corp->setPassword($user, $current);
} catch (Throwable $error) {
}
uint $i = 0;
$changed = 0;
while ($i < 50) {
    string $next = 'Hostile-Round-' . $i . '-Pass';
    try {
        $corp->modify($user, [Core\Ldap\Change::replace('pwdLastSet', 0)]);
        $corp->changePassword($user, $current, $next);
        $current = $next;
        $changed = $changed + 1;
    } catch (Throwable $error) {
    }
    $i = $i + 1;
}
echo '4 changed: ', $changed, "\n";

// 5. The account and its unit are removed again.
try {
    $corp->delete($user);
    $corp->delete($unit);
} catch (Throwable $error) {
}
echo '5 done', "\n";
