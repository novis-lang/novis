<?nvs
// Attack: a program lowers its memory limit to 16 MiB and starts a profile with a path of 8 MiB.
// The call should throw an error with a short message, and stay inside the limit.

// 1. Lowers the memory limit to `16M`.
echo 'limit lowered: ', Core\Config::set('limits.memory', '16M') ? 'yes' : 'no', "\n";

// 2. Starts a profile at a path of 8 MiB. This throws an error, and its message is short.
string $path = Core\Str::repeat('a', 8388608);
try {
    Core\Debug::startProfile($path);
    echo "profile started\n";
    Core\Debug::stopProfile();
} catch (Throwable $error) {
    echo Core\Str::length($error->message) < 300 ? 'short message' : 'long message', "\n";
}
