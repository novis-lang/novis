<?nvs
// Attack: a program closes more elements than it opened, closes after the document is finished, and leaves elements open.
// Each bad call should throw a `LogicError`, and a document should only be returned when every element is closed.
// hostile: timeout-ms 20000

class Try
{
    // Runs one call and prints `ok`, or the class of the error it throws.
    public static function call(callable $step): void
    {
        try {
            $step();
            echo "ok\n";
        } catch (LogicError $error) {
            echo "LogicError\n";
        }
    }
}

Core\Xml\Writer $out = Core\Xml::writer({ indent: '  ' });

// 1. A close before the document is started. This prints LogicError.
Try::call(fn(): void => { $out->endElement(); });

$out->startDocument();

// 2. A close before any element is open. This prints LogicError.
Try::call(fn(): void => { $out->endElement(); });

// 3. 1024 elements are opened, and then 100,000 closes are tried. This prints 1024 and 98976.
int $depth = 0;
while ($depth < 1024) {
    $out->startElement('level');
    $depth = $depth + 1;
}
int $closed = 0;
int $failed = 0;
int $i = 0;
while ($i < 100000) {
    try {
        $out->endElement();
        $closed = $closed + 1;
    } catch (LogicError $error) {
        $failed = $failed + 1;
    }
    $i = $i + 1;
}
echo $closed, "\n";
echo $failed, "\n";

// 4. The document is finished and parsed again. This prints its length.
string $document = $out->endDocument();
Core\Xml::parse($document);
echo Core\Str::length($document), "\n";

// 5. A close after the document is finished. This prints LogicError.
Try::call(fn(): void => { $out->endElement(); });

// 6. A new document with an element left open. `endDocument` prints LogicError, and the writer can still close it.
Core\Xml\Writer $open = Core\Xml::writer();
$open->startDocument();
$open->startElement('root');
$open->startElement('left-open');
Try::call(fn(): void => { $open->endDocument(); });
$open->endElement();
$open->endElement();
echo $open->endDocument(), "\n";
