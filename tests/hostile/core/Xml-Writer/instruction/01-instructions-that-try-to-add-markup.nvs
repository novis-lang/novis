<?nvs
// Attack: a program writes instructions whose target or data tries to add markup, and writes very many instructions.
// Each bad call should throw a `LogicError`, and the finished document should still be valid XML.
// hostile: timeout-ms 20000

class Try
{
    // Runs one call and prints `ok`, or the class of the error it throws.
    public static function call(callable $step): void
    {
        try {
            $step();
            echo "ok\n";
        } catch (LogicError $error) {
            echo "LogicError\n";
        }
    }
}

Core\Xml\Writer $out = Core\Xml::writer({ indent: '  ' });

// 1. An instruction before `startDocument`. This prints LogicError.
Try::call(fn(): void => { $out->instruction('app', 'go'); });

$out->startDocument();

// 2. A second `xml` declaration, in three casings. Each prints LogicError.
Try::call(fn(): void => { $out->instruction('xml', 'version="1.1"'); });
Try::call(fn(): void => { $out->instruction('XmL', ''); });
Try::call(fn(): void => { $out->instruction('xML', 'encoding="UTF-16"'); });

// 3. Targets that are not XML names, or that try to close the instruction. Each prints LogicError.
Try::call(fn(): void => { $out->instruction('', 'go'); });
Try::call(fn(): void => { $out->instruction('a?><admin/><?b', 'go'); });
Try::call(fn(): void => { $out->instruction('1app', 'go'); });
Try::call(fn(): void => { $out->instruction("a\x00", 'go'); });

// 4. Data that tries to end the instruction and add an element. Each prints LogicError.
Try::call(fn(): void => { $out->instruction('app', '?><admin/><?app '); });
Try::call(fn(): void => { $out->instruction('app', "a\x01b"); });

// 5. `?>` at the very end of a long data. This prints LogicError after one scan of the data.
Try::call(fn(): void => { $out->instruction('app', Core\Str::repeat('? > ', 300000) . '?>'); });

// 6. Data that comes close to `?>` but does not contain it. Each prints ok.
Try::call(fn(): void => { $out->instruction('app', '?'); });
Try::call(fn(): void => { $out->instruction('app', Core\Str::repeat('?', 1000000)); });
Try::call(fn(): void => { $out->instruction('app', '> ?'); });
Try::call(fn(): void => { $out->instruction('xml-stylesheet', 'href="a.css"'); });

// 7. 100,000 instructions inside one element. This prints ok.
$out->startElement('page');
Try::call(fn(): void => {
    int $i = 0;
    while ($i < 100000) {
        $out->instruction('step', 'n=' . $i);
        $i = $i + 1;
    }
});

// 8. The document is finished and parsed again. This prints its length.
$out->endElement();
string $document = $out->endDocument();
Core\Xml::parse($document);
echo Core\Str::length($document), "\n";
