<?nvs
// Attack: a program writes comments that try to close the comment early and add markup, and writes very many comments.
// Each bad comment should throw a `LogicError`, and the finished document should still be valid XML.
// hostile: timeout-ms 20000

class Try
{
    // Runs one call and prints `ok`, or the class of the error it throws.
    public static function call(callable $step): void
    {
        try {
            $step();
            echo "ok\n";
        } catch (LogicError $error) {
            echo "LogicError\n";
        }
    }
}

Core\Xml\Writer $out = Core\Xml::writer();
$out->startDocument();
$out->startElement('page');

// 1. Texts that try to close the comment and add an element. Each prints LogicError.
Try::call(fn(): void => { $out->comment('--><admin/><!--'); });
Try::call(fn(): void => { $out->comment('a --> b'); });
Try::call(fn(): void => { $out->comment('-'); });
Try::call(fn(): void => { $out->comment('ends with a dash-'); });

// 2. A text with a control character XML cannot write. This prints LogicError.
Try::call(fn(): void => { $out->comment("a\x00b"); });

// 3. One million dashes. This prints LogicError after one scan of the text.
Try::call(fn(): void => { $out->comment(Core\Str::repeat('-', 1000000)); });

// 4. Two dashes at the very end of a long text. This prints LogicError.
Try::call(fn(): void => { $out->comment(Core\Str::repeat('- ', 500000) . '--x'); });

// 5. A comment of one million `<` and `&` characters. This prints ok, because they are allowed.
Try::call(fn(): void => { $out->comment(Core\Str::repeat('<&', 500000)); });

// 6. 100,000 comments inside one element. This prints ok.
Try::call(fn(): void => {
    int $i = 0;
    while ($i < 100000) {
        $out->comment('note ' . $i);
        $i = $i + 1;
    }
});

// 7. The document is finished and parsed again. This prints its length.
$out->endElement();
string $document = $out->endDocument();
Core\Xml::parse($document);
echo Core\Str::length($document), "\n";
