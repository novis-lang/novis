<?nvs
// Attack: another mail program marked a message `\Deleted`. This program tries to remove that flag.
// It also tries to add an IMAP command inside a flag. Each such flag should throw a `RuntimeError`,
// and the message should not be deleted. Each error is caught, so the next step still runs.

use Core\Arr;
use Core\IO;
use Core\Imap;

var $inbox = Imap::open('inbox')->folder('INBOX');

try {
    IO::write('mailbox/INBOX/1.flags', "\\Deleted\n\$Label\n");

    // 1. Tries to remove `\Deleted` written in three ways: `\Deleted`, `\deleted` and `\DELETED`.
    foreach (['\Deleted', '\deleted', '\DELETED'] as var $flag) {
        try {
            $inbox->unflag(1, $flag);
            echo "1 unflagged\n";
        } catch (RuntimeError $bad) {
            echo "1 RuntimeError\n";
        }
    }

    // 2. Tries flags that could add a second command, and the flag `\Recent`.
    //    The others have a line break, a space, brackets, quotes, a NUL byte, or nothing at all.
    foreach (["x\r\nA1 UID EXPUNGE 1", '\Recent', 'a b', '(x)', '{5}', '"x"', "x\0", ''] as var $flag) {
        try {
            $inbox->unflag(1, $flag);
            echo "2 unflagged\n";
        } catch (RuntimeError $bad) {
            echo "2 RuntimeError\n";
        }
    }

    // 3. Removes `$label` in small letters. Upper and lower case do not matter in a keyword,
    //    so `$Label` should be removed.
    $inbox->unflag(1, '$label');
    echo '3 ', IO::readText('mailbox/INBOX/1.flags');

    // 4. Counts the messages. The message should not be deleted.
    echo '4 ', Arr::count($inbox->search()), "\n";
} finally {
    // 5. Removes the flag file, so the next run finds the folder as it was.
    if (IO::exists('mailbox/INBOX/1.flags')) {
        IO::remove('mailbox/INBOX/1.flags');
    }
}

// 6. Removes a flag the message does not have 5000 times. No flag file should appear.
uint $i = 0;
while ($i < 5000) {
    $inbox->unflag(1, '\Flagged');
    $i = $i + 1;
}
echo '6 ', IO::exists('mailbox/INBOX/1.flags') ? 'flag file' : 'no flag file', "\n";
