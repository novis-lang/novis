<?nvs
// Attack: a test sends a copy to thousands of addresses and to addresses with a line break or no text.
// The list should keep every valid address, every wrong address should throw, and nothing may crash.
// proof: test

use Core\Mail;
use Core\Test;

class CcAttackTest
{
    #[Test]
    public function theListOfCopiesHolds(): void
    {
        // 1. Sends one message with 5000 `cc` addresses and reads them all back.
        array<string> $many = [];
        int $i = 0;
        while ($i < 5000) {
            $many[] = 'copy' . $i . '@example.com';
            $i = $i + 1;
        }
        Mail::send('site', ['ada@example.com'], 'Many', 'One message.', { cc: $many });
        Test::assertCount(Test::sentMail()[0]->cc(), 5000);
        Test::assertEquals(Test::sentMail()[0]->cc()[4999], 'copy4999@example.com');

        // 2. A `cc` address with a line break tries to add a second header. `send` throws, and no message is kept.
        bool $thrown = false;
        try {
            Mail::send('site', ['ada@example.com'], 'Hi', 'Hello', { cc: ["bo@example.com\r\nBcc: spy@example.com"] });
        } catch (RuntimeError $error) {
            $thrown = true;
        }
        Test::assertTrue($thrown);
        Test::assertCount(Test::sentMail(), 1);

        // 3. An empty `cc` address is not an address. `send` throws, and no message is kept.
        $thrown = false;
        try {
            Mail::send('site', ['ada@example.com'], 'Hi', 'Hello', { cc: [''] });
        } catch (RuntimeError $error) {
            $thrown = true;
        }
        Test::assertTrue($thrown);
        Test::assertCount(Test::sentMail(), 1);

        // 4. The same address is in `to` and in `cc`. Each list keeps it as it was given.
        Mail::send('site', ['bo@example.com'], 'Twice', 'Hello', { cc: ['bo@example.com'] });
        Test::assertEquals(Test::sentMail()[1]->to(), ['bo@example.com']);
        Test::assertEquals(Test::sentMail()[1]->cc(), ['bo@example.com']);

        // 5. Changes the list that `cc()` returned. A second read still has the first address.
        array<string> $copy = Test::sentMail()[0]->cc();
        $copy[0] = 'spy@example.com';
        Test::assertEquals(Test::sentMail()[0]->cc()[0], 'copy0@example.com');

        // 6. Reads `cc()` of one message 2000 times.
        var $first = Test::sentMail()[0];
        uint $total = 0;
        $i = 0;
        while ($i < 2000) {
            $total = $total + Core\Arr::count($first->cc());
            $i = $i + 1;
        }
        Test::assertEquals($total, 10000000);
    }
}
