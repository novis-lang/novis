<?nvs
// Attack: a stranger sends a text body that is broken, very large or hidden deep inside other parts.
// `text()` should return what it can read, or `null`, and the program should keep running.

use Core\Mail\Message;

// 1. A body in a character set that does not exist.
Message $unknown = Message::parse("Content-Type: text/plain; charset=no-such-set\n\nHello");
echo "1 ", Core\Str::length($unknown->text() ?? ''), "\n";

// 2. A base64 body with characters that are not base64.
Message $broken = Message::parse("Content-Type: text/plain\nContent-Transfer-Encoding: base64\n\n@@@!!!===SGVsbG8\n");
echo "2 ", Core\Str::length($broken->text() ?? ''), "\n";

// 3. A text part inside 40 levels of nested parts. Only 16 levels are read.
string $open = '';
string $close = '';
int $level = 0;
while ($level < 40) {
    $open = $open . "Content-Type: multipart/mixed; boundary=\"b" . $level . "\"\n\n--b" . $level . "\n";
    $close = "\n--b" . $level . "--\n" . $close;
    $level = $level + 1;
}
Message $deep = Message::parse($open . "Content-Type: text/plain\n\ndeep text" . $close);
echo "3 ", $deep->text() ?? 'null', "\n";

// 4. A body of 8 MB.
Message $large = Message::parse("Content-Type: text/plain\n\n" . Core\Str::repeat('A', 8388608));
echo "4 ", Core\Str::length($large->text() ?? ''), "\n";
