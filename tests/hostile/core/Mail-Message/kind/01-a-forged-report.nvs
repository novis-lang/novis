<?nvs
// Attack: a stranger sends messages that look like bounces but are not delivery reports.
// Only the real report in step 7 should be a `Bounce`, and every message should be read without a crash.

use Core\Mail\Message;
use Core\Str;

class Kind
{
    public static function show(string $step, string $raw): void
    {
        Message $message = Message::parse($raw);
        echo $step, ' ', $message->kind() == Message::Kind::Bounce ? 'bounce' : 'not a bounce', "\n";
    }
}

string $groups = "Reporting-MTA: dns; mx.example.net\n\nFinal-Recipient: rfc822; ada@example.org\nAction: failed\nStatus: 5.1.1\n";

// 1. The recipient lines are in a plain text message.
Kind::show('1', "From: mailer-daemon@example.org\nSubject: Undelivered Mail\n\n" . $groups);

// 2. A report with no `report-type`.
Kind::show('2', "Content-Type: multipart/report; boundary=\"b\"\n\n--b\nContent-Type: message/delivery-status\n\n" . $groups . "--b--\n");

// 3. A normal mail with a delivery status part inside.
Kind::show('3', "Content-Type: multipart/mixed; boundary=\"b\"\n\n--b\nContent-Type: message/delivery-status\n\n" . $groups . "--b--\n");

// 4. A real bounce, attached inside a normal mail.
Kind::show('4', "Content-Type: multipart/mixed; boundary=\"o\"\n\n--o\nContent-Type: message/rfc822\n\n"
    . "Content-Type: multipart/report; report-type=delivery-status; boundary=\"b\"\n\n"
    . "--b\nContent-Type: message/delivery-status\n\n" . $groups . "--b--\n--o--\n");

// 5. A delivery report whose status part is not there.
Kind::show('5', "Content-Type: multipart/report; report-type=delivery-status; boundary=\"b\"\n\n--b\nContent-Type: text/plain\n\n" . $groups . "--b--\n");

// 6. Multipart parts nested 5,000 levels deep, with the report at the bottom.
string $open = '';
string $close = '';
uint $level = 0;
while ($level < 5000) {
    $open = $open . "Content-Type: multipart/mixed; boundary=\"n" . $level . "\"\n\n--n" . $level . "\n";
    $close = "--n" . $level . "--\n" . $close;
    $level = $level + 1;
}
Kind::show('6', $open . "Content-Type: message/delivery-status\n\n" . $groups . $close);

// 7. A real report after 200,000 `Auto-Submitted` header lines.
Kind::show('7', Str::repeat("Auto-Submitted: auto-replied\n", 200000)
    . "Content-Type: multipart/report; report-type=delivery-status; boundary=\"b\"\n\n"
    . "--b\nContent-Type: message/delivery-status\n\n" . $groups . "--b--\n");

// 8. A report type of one million letters.
Kind::show('8', "Content-Type: multipart/report; report-type=" . Str::repeat('x', 1000000) . "; boundary=\"b\"\n\n--b--\n");
