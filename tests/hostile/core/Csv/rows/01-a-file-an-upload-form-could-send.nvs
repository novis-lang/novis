<?nvs
// Attack: a program reads a CSV file that somebody uploaded. It tries a quoted
// field that never ends, very many records, a closed handle and bytes that are
// not UTF-8. Each one has to give a result or an error, and none of them may
// stop the program.
// hostile: timeout-ms 30000

string $dir = Core\IO::temporaryDir();

// 1. A quoted field of eight megabytes that is never closed.
string $unclosed = Core\Path::join($dir, 'unclosed.csv');
Core\IO::write($unclosed, '"' . Core\Str::repeat('x', 8000000));
Core\IO\File $first = Core\IO::open($unclosed, Core\IO::FileMode::Read);
uint $unended = 0;
foreach (Core\Csv::rows($first) as array<string> $record) {
    $unended = $unended + 1;
}
$first->close();
echo '1 records in a file whose field never ends: ', $unended, "\n";

// 2. Two hundred thousand records, read with one record held at a time.
string $tall = Core\Path::join($dir, 'tall.csv');
Core\IO::write($tall, Core\Str::repeat("a,b,c\n", 200000));
Core\IO\File $second = Core\IO::open($tall, Core\IO::FileMode::Read);
uint $walked = 0;
foreach (Core\Csv::rows($second) as array<string> $record) {
    $walked = $walked + 1;
}
$second->close();
echo '2 records read: ', $walked, "\n";

// 3. One record of two hundred thousand fields.
string $wide = Core\Path::join($dir, 'wide.csv');
Core\IO::write($wide, Core\Str::repeat('a,', 200000) . "last\n");
Core\IO\File $third = Core\IO::open($wide, Core\IO::FileMode::Read);
uint $fields = 0;
foreach (Core\Csv::rows($third) as array<string> $record) {
    $fields = $fields + Core\Arr::count($record);
}
$third->close();
echo '3 fields in one record: ', $fields, "\n";

// 4. The handle is closed while the walk has read nothing yet.
Core\IO\File $fourth = Core\IO::open($tall, Core\IO::FileMode::Read);
var $walk = Core\Csv::rows($fourth);
$fourth->close();
try {
    uint $read = 0;
    foreach ($walk as array<string> $record) {
        $read = $read + 1;
    }
    echo '4 a closed handle was read to the end', "\n";
} catch (Throwable $error) {
    echo '4 reading a closed handle throws', "\n";
}

// 5. A dialect that asks for a line break as the separator.
Core\IO\File $fifth = Core\IO::open($tall, Core\IO::FileMode::Read);
try {
    var $refused = Core\Csv::rows($fifth, { separator: "\n" });
    echo '5 a line break was accepted as the separator', "\n";
} catch (Throwable $error) {
    echo '5 a line break as the separator throws', "\n";
}
$fifth->close();

// 6. A field that is the byte FF, which never appears in UTF-8.
string $invalid = Core\Path::join($dir, 'invalid.csv');
Core\IO\File $sixthOut = Core\IO::open($invalid, Core\IO::FileMode::Write);
$sixthOut->write(Core\Bytes::pack('CCCCC', 0x61, 0x0A, 0xFF, 0x0A, 0x62));
$sixthOut->close();
Core\IO\File $sixth = Core\IO::open($invalid, Core\IO::FileMode::Read);
try {
    foreach (Core\Csv::rows($sixth) as array<string> $record) {
        echo '6 a record was read: ', Core\Str::length($record[0]), "\n";
    }
    echo '6 the byte FF was read as text', "\n";
} catch (ParseError $notText) {
    echo '6 the byte FF throws a ParseError', "\n";
}
$sixth->close();

// 7. A field with the bytes C0 BC. This is a second, longer way to write `<`,
// and UTF-8 does not allow it.
string $overlong = Core\Path::join($dir, 'overlong.csv');
Core\IO\File $seventhOut = Core\IO::open($overlong, Core\IO::FileMode::Write);
$seventhOut->write(Core\Bytes::pack('CCCC', 0x61, 0x2C, 0xC0, 0xBC));
$seventhOut->close();
Core\IO\File $seventh = Core\IO::open($overlong, Core\IO::FileMode::Read);
try {
    foreach (Core\Csv::rows($seventh) as array<string> $record) {
        echo '7 a record was read: ', Core\Arr::count($record), "\n";
    }
    echo '7 the bytes C0 BC were read as text', "\n";
} catch (ParseError $overlongForm) {
    echo '7 the bytes C0 BC throw a ParseError', "\n";
}
$seventh->close();
