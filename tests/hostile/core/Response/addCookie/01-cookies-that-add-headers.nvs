<?nvs
// Attack: a program tries to use a cookie to add its own headers or attributes,
// and then adds cookies without end. Each bad cookie should throw an error,
// and the program should stop at its memory limit without crashing.
// hostile: ends-early
// hostile: timeout-ms 60000

uint $refused = 0;

// 1. A line break in the value tries to start a new header.
try {
    Core\Response::addCookie('sid', "abc\r\nLocation: https://example.com/");
} catch (LogicError $error) {
    $refused = $refused + 1;
}

// 2. A semicolon in the value tries to add a `Domain` attribute.
try {
    Core\Response::addCookie('sid', 'abc; Domain=example.com');
} catch (LogicError $error) {
    $refused = $refused + 1;
}

// 3. An equals sign and a space in the name try to change the value.
try {
    Core\Response::addCookie('sid=admin x', 'abc');
} catch (LogicError $error) {
    $refused = $refused + 1;
}

// 4. An empty name.
try {
    Core\Response::addCookie('', 'abc');
} catch (LogicError $error) {
    $refused = $refused + 1;
}

// 5. A semicolon in the path tries to add `SameSite=None`.
try {
    Core\Response::addCookie('sid', 'abc', { path: '/; SameSite=None' });
} catch (LogicError $error) {
    $refused = $refused + 1;
}

// 6. A byte outside ASCII in the domain.
try {
    Core\Response::addCookie('sid', 'abc', { domain: 'exämple.com' });
} catch (LogicError $error) {
    $refused = $refused + 1;
}

// 7. A `__Host-` cookie with a domain, which that prefix does not allow.
try {
    Core\Response::addCookie('__Host-sid', 'abc', { domain: 'example.com' });
} catch (LogicError $error) {
    $refused = $refused + 1;
}

// 8. A `__Secure-` cookie without `secure`.
try {
    Core\Response::addCookie('__Secure-sid', 'abc', { secure: false });
} catch (LogicError $error) {
    $refused = $refused + 1;
}

// 9. `SameSite::None` without `secure`, which every browser drops.
try {
    Core\Response::addCookie('sid', 'abc', { sameSite: Core\Response\SameSite::None, secure: false });
} catch (LogicError $error) {
    $refused = $refused + 1;
}

// 10. A negative lifetime, and then the longest one a duration can have.
try {
    Core\Response::addCookie('sid', 'abc', { maxAge: Core\Time\Duration::nanoseconds(-1000000000) });
} catch (LogicError $error) {
    $refused = $refused + 1;
}
Core\Response::addCookie('forever', 'abc', { maxAge: Core\Time\Duration::nanoseconds(9223372036854775807) });

// 11. One value of eight megabytes, which is allowed.
Core\Response::addCookie('big', Core\Str::repeat('a', 8388608));

// 12. Cookies of four kilobytes each, added until the memory limit stops the program.
string $page = Core\Str::repeat('b', 4096);
uint $added = 0;
while ($added < 1000000) {
    Core\Response::addCookie('c', $page);
    $added = $added + 1;
}
Core\Response::text('refused ' . ($refused as string) . ', added ' . ($added as string) . "\n");
