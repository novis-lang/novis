<?nvs
// Attack: a program lowers its memory limit to 16 MiB and adds a cookie whose value is 8 MiB
// with spaces. The call should throw a `LogicError` with a short message.

// 1. Lowers the memory limit to `16M`.
echo 'limit lowered: ', Core\Config::set('limits.memory', '16M') ? 'yes' : 'no', "\n";

// 2. Builds a value of 8 MiB. Every second character is a space.
string $value = Core\Str::repeat('a ', 4194304);

// 3. Adds the cookie. This throws a `LogicError`, and its message is short.
try {
    Core\Response::addCookie('note', $value);
    throw new RuntimeError('a cookie value with a space was set');
} catch (LogicError $error) {
    echo Core\Str::length($error->message) < 1000 ? 'short message' : 'long message', "\n";
}
