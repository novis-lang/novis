<?nvs
// Attack: a program tries to send files outside the one folder it may read, and
// paths that are not files. Each attempt should throw an error, and nothing outside
// the folder should be sent.
// hostile: timeout-ms 30000

class Here
{
    // `#[Core\Path]` turns the string you pass into a full path from the folder of this file.
    public static function path(#[Core\Path] string $path): string
    {
        return $path;
    }
}

// The folder of this file, as a full path. Every path below is built from it.
string $folder = Here::path('.');
uint $refused = 0;

// 1. A path that climbs out of the folder with `..`.
try {
    Core\Response::sendFile($folder . '/../../../../../Cargo.toml');
} catch (IOError $failed) {
    $refused = $refused + 1;
} catch (RuntimeError $denied) {
    $refused = $refused + 1;
}

// 2. A full path to a file outside the folder.
try {
    Core\Response::sendFile('/etc/passwd');
} catch (IOError $failed) {
    $refused = $refused + 1;
} catch (RuntimeError $denied) {
    $refused = $refused + 1;
}

// 3. The folder itself, which is not a file.
try {
    Core\Response::sendFile($folder);
} catch (LogicError $error) {
    $refused = $refused + 1;
}

// 4. A file that does not exist in the folder.
try {
    Core\Response::sendFile($folder . '/missing.txt');
} catch (IOError $failed) {
    $refused = $refused + 1;
}

// 5. A NUL byte (the byte with value 0) in the file name.
// A program written in C stops reading the name at this byte.
try {
    Core\Response::sendFile($folder . "/nvs.toml\x00.png");
} catch (IOError $failed) {
    $refused = $refused + 1;
} catch (LogicError $error) {
    $refused = $refused + 1;
} catch (RuntimeError $denied) {
    $refused = $refused + 1;
}

// 6. A file name of 100,000 letters.
try {
    Core\Response::sendFile($folder . '/' . Core\Str::repeat('a', 100000));
} catch (IOError $failed) {
    $refused = $refused + 1;
} catch (RuntimeError $denied) {
    $refused = $refused + 1;
}

// 7. The same allowed file is sent 30,000 times. The browser gets only the file of the last call.
// If each call kept its path in memory, the 1 MB memory limit in `nvs.toml` would stop the request.
uint $sent = 0;
while ($sent < 30000) {
    Core\Response::sendFile($folder . '/nvs.toml');
    $sent = $sent + 1;
}
