<?nvs
// Attack: a server sends bodies at the size limit and past it, to paths that are taken,
// missing or not valid. `saveTo` must write every byte or throw an error. A failed save
// must leave no file behind.
// hostile: timeout-ms 30000

// Every reply comes from a table, so nothing is sent over a network.
Core\Test::answerHttp('https://files.example.com/empty', 200, { body: '' });
Core\Test::answerHttp('https://files.example.com/ten', 200, { body: '0123456789' });
Core\Test::answerHttp('https://files.example.com/large', 200, { body: Core\Str::repeat('z', 8000000) });
Core\Test::answerHttp('https://files.example.com/many/*', 200, { body: Core\Str::repeat('m', 500) });

string $dir = Core\IO::temporaryDir();

// 1. An empty body with a limit of 0. The file must exist and be empty.
string $empty = Core\Path::join($dir, 'empty.bin');
Core\Http\Client::stream(Core\Http\Method::Get, 'https://files.example.com/empty')->saveTo($empty, 0);
if (Core\IO::size($empty) != 0) {
    throw new LogicError('an empty body wrote bytes');
}
echo 'step 1: done', "\n";

// 2. A body of 10 bytes with a limit of 10 must be saved whole.
string $exact = Core\Path::join($dir, 'exact.bin');
Core\Http\Client::stream(Core\Http\Method::Get, 'https://files.example.com/ten')->saveTo($exact, 10);
if (Core\IO::read($exact) != '0123456789') {
    throw new LogicError('a body at the limit was not saved whole');
}
echo 'step 2: done', "\n";

// 3. The same body with a limit of 9 must throw, and leave no file.
string $over = Core\Path::join($dir, 'over.bin');
try {
    Core\Http\Client::stream(Core\Http\Method::Get, 'https://files.example.com/ten')->saveTo($over, 9);
    throw new LogicError('a body past the limit was saved');
} catch (RuntimeError $tooLarge) {
}
if (Core\IO::exists($over)) {
    throw new LogicError('a failed save left a file behind');
}
echo 'step 3: done', "\n";

// 4. A path where a file already exists must throw, and the file must not change.
try {
    Core\Http\Client::stream(Core\Http\Method::Get, 'https://files.example.com/ten')->saveTo($exact, 10);
    throw new LogicError('an existing file was replaced');
} catch (IOError $alreadyThere) {
}
if (Core\IO::read($exact) != '0123456789') {
    throw new LogicError('a refused save changed the existing file');
}
echo 'step 4: done', "\n";

// 5. Paths that cannot be created: a missing directory, a directory itself, and a NUL byte.
array<string> $bad = [
    Core\Path::join($dir, 'no-such-dir/deeper/file.bin'),
    $dir,
    Core\Path::join($dir, "nul\0byte.bin"),
];
foreach ($bad as string $badPath) {
    try {
        Core\Http\Client::stream(Core\Http\Method::Get, 'https://files.example.com/ten')->saveTo($badPath, 10);
        throw new LogicError('a path that cannot be created was written');
    } catch (IOError $notCreated) {
    } catch (RuntimeError $notAllowed) {
    }
}
echo 'step 5: done', "\n";

// 6. A body that another reader already took must throw, and write nothing.
string $taken = Core\Path::join($dir, 'taken.bin');
var $once = Core\Http\Client::stream(Core\Http\Method::Get, 'https://files.example.com/ten');
$once->chunks();
try {
    $once->saveTo($taken, 10);
    throw new LogicError('a body was saved after another reader took it');
} catch (LogicError $readTwice) {
}
if (Core\IO::exists($taken)) {
    throw new LogicError('a refused save left a file behind');
}
echo 'step 6: done', "\n";

// 7. A body of 8000000 bytes. The file must have exactly that size.
string $large = Core\Path::join($dir, 'large.bin');
Core\Http\Client::stream(Core\Http\Method::Get, 'https://files.example.com/large')->saveTo($large, 8000000);
if (Core\IO::size($large) != 8000000) {
    throw new LogicError('the large body was not saved whole');
}
echo 'step 7: done', "\n";

// 8. 3000 saves, and every second one is past its limit. No file may be left from a failed save.
uint $n = 0;
uint $failed = 0;
while ($n < 3000) {
    string $manyPath = Core\Path::join($dir, Core\Str::format('many-%d.bin', $n));
    uint $limit = 499;
    if ($n % 2 == 0) {
        $limit = 500;
    }
    try {
        Core\Http\Client::stream(Core\Http\Method::Get, Core\Str::format('https://files.example.com/many/%d', $n))->saveTo($manyPath, $limit);
    } catch (RuntimeError $pastLimit) {
        $failed = $failed + 1;
        if (Core\IO::exists($manyPath)) {
            throw new LogicError('a failed save left a file behind');
        }
    }
    $n = $n + 1;
}
if ($failed != 1500) {
    throw new LogicError(Core\Str::format('%d saves failed', $failed));
}
echo 'step 8: done', "\n";
