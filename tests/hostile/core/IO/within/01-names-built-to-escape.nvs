<?nvs
// Attack: file names built to leave a folder are checked with `Core\IO::within`. Each one must
// be refused with an error, or return a path that is still inside the folder.
// hostile: timeout-ms 60000

string $base = Core\IO::temporaryDir();
Core\IO::makeDir(Core\Path::join($base, 'inside'));
Core\IO::write(Core\Path::join($base, 'inside', 'a.txt'), 'a');
// The folder's own full path. Every allowed answer must start with it.
string $root = Core\IO::within($base, '');

class Guard
{
    // Checks one name. Returns 1 when it is refused, and 0 when it is allowed and stays inside.
    public static function check(string $base, string $root, string $name): int
    {
        try {
            string $answer = Core\IO::within($base, $name);
            if (!Core\Str::startsWith($answer, $root)) {
                throw new LogicError('an allowed name left the folder');
            }
            return 0;
        } catch (RuntimeError $refused) {
            return 1;
        } catch (IOError $failed) {
            return 1;
        }
    }
}

// 1. Ten thousand `../` in a row. This must be refused.
if (Guard::check($base, $root, Core\Str::repeat('../', 10000)) != 1) {
    throw new LogicError('ten thousand `../` were allowed');
}
echo 'step 1: done', "\n";

// 2. Five thousand folders that do not exist, and then one more `..` than that.
if (Guard::check($base, $root, Core\Str::repeat('x/', 5000) . Core\Str::repeat('../', 5001) . 'a.txt') != 1) {
    throw new LogicError('a climb past the folder through missing folders was allowed');
}
echo 'step 2: done', "\n";

// 3. A name of two hundred thousand characters. It may be allowed or refused, but must stay inside.
Guard::check($base, $root, Core\Str::repeat('a', 200000));
Guard::check($base, $root, Core\Str::repeat('inside/', 30000));
echo 'step 3: done', "\n";

// 4. Names that only look like they stay inside: a sibling folder whose name starts the same way,
// a backslash, a NUL byte, a doubled separator and a name that is only dots.
array<string> $tricks = [
    '../' . Core\Path::basename($base) . '-other/a.txt',
    "inside/..\\..\\..\\a.txt",
    "inside/a.txt\0/../../../x",
    'inside//..//..//x',
    '...',
    'inside/./../../x',
];
foreach ($tricks as string $trick) {
    Guard::check($base, $root, $trick);
}
echo 'step 4: done', "\n";

// 5. The same escape twenty thousand times. Every call must be refused, and nothing may pile up.
uint $refused = 0;
uint $i = 0;
while ($i < 20000) {
    $refused = $refused + Guard::check($base, $root, 'inside/../../' . Core\Path::basename($base) . '/../x') as uint;
    $i = $i + 1;
}
if ($refused != 20000) {
    throw new LogicError('an escape was allowed in the loop');
}
echo 'step 5: done', "\n";

// 6. A base that is a file, and a base that does not exist. Neither may let a name out.
Guard::check(Core\Path::join($base, 'inside', 'a.txt'), $root, '../../x');
Guard::check(Core\Path::join($base, 'missing'), $root, '../../x');
echo 'step 6: done', "\n";

// 7. Names that Windows reads as another file or as a network path: a network share, a device,
// a stream, a trailing dot or space, and a short 8.3 name. Each one must be refused quickly.
array<string> $aliases = [
    "\\\\10.255.255.1\\share\\x.txt",
    '//10.255.255.1/share/x.txt',
    "\\\\?\\UNC\\10.255.255.1\\share\\x.txt",
    "\\\\.\\pipe\\probe",
    'inside/a.txt::$DATA',
    'inside/a.txt.',
    'inside/a.txt ',
    'INSIDE~1/a.txt',
];
foreach ($aliases as string $alias) {
    if (Guard::check($base, $root, $alias) != 1) {
        throw new LogicError('a name Windows reads as another file was allowed');
    }
}
echo 'step 7: done', "\n";
