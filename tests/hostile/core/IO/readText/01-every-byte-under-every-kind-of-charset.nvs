<?nvs
// Attack: a program reads files with every possible byte under many character sets, broken UTF-16,
// endless escape codes and a very large file. Each read must work or throw an error, and must not crash.
// hostile: timeout-ms 60000

string $dir = Core\Path::join(Core\IO::temporaryDir(), 'attack');
Core\IO::makeDir($dir);
string $path = Core\Path::join($dir, 'input.txt');

// 1. All 256 byte values, each one repeated 100 times, read under ten character sets. Each read
// returns a string or throws a `RuntimeError`.
array<bytes> $everyByte = [];
uint $value = 0;
while ($value < 256) {
    $everyByte[] = Core\Bytes::fill(100, $value);
    $value = $value + 1;
}
Core\IO::writeStream($path, $everyByte, { overwrite: true });
array<Core\Charset> $charsets = [
    Core\Charset::Utf8, Core\Charset::Utf16Le, Core\Charset::Utf16Be, Core\Charset::Ascii,
    Core\Charset::Latin1, Core\Charset::Gb18030, Core\Charset::Big5, Core\Charset::ShiftJis,
    Core\Charset::EucKr, Core\Charset::Iso2022Jp,
];
foreach ($charsets as Core\Charset $charset) {
    try {
        Core\IO::readText($path, { charset: $charset });
    } catch (RuntimeError $notThisCharset) {
    }
}
echo 'step 1: done', "\n";

// 2. UTF-16 that is broken: an odd number of bytes, and half of a character pair with nothing after
// it. Both must throw a `RuntimeError`.
array<array<bytes>> $broken = [[Core\Bytes::fill(3, 65)], [Core\Bytes::fill(1, 0), Core\Bytes::fill(1, 216)]];
foreach ($broken as array<bytes> $content) {
    Core\IO::writeStream($path, $content, { overwrite: true });
    try {
        Core\IO::readText($path, { charset: Core\Charset::Utf16Le });
        throw new LogicError('broken UTF-16 was read');
    } catch (RuntimeError $notText) {
    }
}
echo 'step 2: done', "\n";

// 3. One million escape codes that switch ISO-2022-JP between its modes, with no text between them.
string $switch = "\x1b" . '$B' . "\x1b" . '(B';
Core\IO::write($path, Core\Str::repeat($switch, 1000000));
try {
    Core\IO::readText($path, { charset: Core\Charset::Iso2022Jp });
} catch (RuntimeError $tooManyCodes) {
}
echo 'step 3: done', "\n";

// 4. A file of fifty million characters read as GB18030. `readText` returns all of it, or throws
// a `RuntimeError` when the file is larger than the program may read at once.
Core\IO::write($path, Core\Str::repeat('z', 50000000));
try {
    if (Core\Str::length(Core\IO::readText($path, { charset: Core\Charset::Gb18030 })) != 50000000) {
        throw new LogicError('the large file was cut');
    }
} catch (RuntimeError $tooLarge) {
}
echo 'step 4: done', "\n";

// 5. A folder and a missing file. Both must throw an `IOError`.
array<string> $bad = [$dir, Core\Path::join($dir, 'missing.txt')];
foreach ($bad as string $badPath) {
    try {
        Core\IO::readText($badPath, { charset: Core\Charset::Latin1 });
        throw new LogicError('a path that is not a file was read');
    } catch (IOError $refused) {
    }
}
echo 'step 5: done', "\n";
