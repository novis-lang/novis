<?nvs
// Attack: a program reads a very large file, reads one file many times, and reads bytes that are
// not text and paths that are not files. Each read must work or throw an error, and must not crash.
// hostile: timeout-ms 60000

string $dir = Core\Path::join(Core\IO::temporaryDir(), 'attack');
Core\IO::makeDir($dir);
string $path = Core\Path::join($dir, 'input.txt');

// 1. A file of fifty million characters. `read` returns all of it, or throws a `RuntimeError`
// when the file is larger than the program may read at once.
Core\IO::write($path, Core\Str::repeat('x', 50000000));
try {
    if (Core\Str::length(Core\IO::read($path)) != 50000000) {
        throw new LogicError('the large file was cut');
    }
} catch (RuntimeError $tooLarge) {
}
echo 'step 1: done', "\n";

// 2. A file of one million characters is read a thousand times. Only the length is kept, so the
// memory for each read must be freed.
Core\IO::write($path, Core\Str::repeat('y', 1000000));
uint $total = 0;
uint $i = 0;
while ($i < 1000) {
    $total = $total + Core\Str::length(Core\IO::read($path));
    $i = $i + 1;
}
if ($total != 1000000000) {
    throw new LogicError('a read returned the wrong length');
}
echo 'step 2: done', "\n";

// 3. A byte that is not text at the end of a file. `read` must throw a `RuntimeError`.
array<bytes> $parts = ['text' as bytes, Core\Bytes::fill(1, 255)];
Core\IO::writeStream($path, $parts, { overwrite: true });
try {
    Core\IO::read($path);
    throw new LogicError('a file that is not text was read');
} catch (RuntimeError $notText) {
}
echo 'step 3: done', "\n";

// 4. Paths that are not a readable file: a folder, a missing file, a null byte and a very
// long name. Each must throw an `IOError`.
array<string> $bad = [
    $dir,
    Core\Path::join($dir, 'missing.txt'),
    Core\Path::join($dir, "nul\0byte"),
    Core\Path::join($dir, Core\Str::repeat('a', 100000)),
];
foreach ($bad as string $badPath) {
    try {
        Core\IO::read($badPath);
        throw new LogicError('a path that is not a file was read');
    } catch (IOError $refused) {
    }
}
// An empty name is not an absolute path, so it throws a `RuntimeError`.
bool $emptyThrew = false;
try {
    Core\IO::read('');
} catch (RuntimeError $relative) {
    $emptyThrew = Core\Str::contains($relative->message, 'needs an absolute path');
}
if (!$emptyThrew) {
    throw new LogicError('an empty name did not throw the relative-path error');
}
echo 'step 4: done', "\n";
