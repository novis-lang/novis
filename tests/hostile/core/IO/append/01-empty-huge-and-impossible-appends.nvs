<?nvs
// Attack: a program adds empty text many times, one very large text, and text to paths
// that cannot be a file. `append` must add exactly the bytes it gets or throw an error.
// hostile: timeout-ms 30000

string $dir = Core\IO::temporaryDir();

// 1. Empty text, added 100000 times. The file must exist and be empty.
string $empty = Core\Path::join($dir, 'empty.log');
int $i = 0;
while ($i < 100000) {
    Core\IO::append($empty, '');
    $i = $i + 1;
}
if (Core\IO::size($empty) != 0) {
    throw new LogicError('empty text added bytes');
}
echo 'step 1: done', "\n";

// 2. One text of 8000000 bytes, then one more byte. The size must be exact.
string $big = Core\Path::join($dir, 'big.log');
Core\IO::append($big, Core\Str::repeat('x', 8000000));
Core\IO::append($big, 'y');
if (Core\IO::size($big) != 8000001) {
    throw new LogicError('a large append lost or added bytes');
}
echo 'step 2: done', "\n";

// 3. 20000 short lines to one file. Every line must be there, in order.
string $lines = Core\Path::join($dir, 'lines.log');
$i = 0;
while ($i < 20000) {
    Core\IO::append($lines, Core\Str::format("%d\n", $i));
    $i = $i + 1;
}
array<string> $read = Core\Str::lines(Core\IO::read($lines));
if (Core\Arr::count($read) != 20000 || $read[19999] != '19999') {
    throw new LogicError('an append was lost or out of order');
}
echo 'step 3: done', "\n";

// 4. Paths that cannot be a file: a directory, a missing directory, a NUL byte and a very long name.
array<string> $bad = [
    $dir,
    Core\Path::join($dir, 'no-such-dir/deeper/file.log'),
    Core\Path::join($dir, "nul\0byte.log"),
    Core\Path::join($dir, Core\Str::repeat('n', 100000)),
];
foreach ($bad as string $badPath) {
    try {
        Core\IO::append($badPath, 'text');
        throw new LogicError('an append to an impossible path succeeded');
    } catch (IOError $refused) {
    }
}
if (Core\IO::exists(Core\Path::join($dir, 'no-such-dir'))) {
    throw new LogicError('a refused append created a directory');
}
echo 'step 4: done', "\n";
