<?nvs
// Attack: a program reads files with a million lines, one very long line, only line breaks, and
// bytes that are not text. `lines` must return every line or throw an error, and must not crash.
// hostile: timeout-ms 60000

string $dir = Core\Path::join(Core\IO::temporaryDir(), 'attack');
Core\IO::makeDir($dir);
string $path = Core\Path::join($dir, 'input.txt');

// 1. A million short lines. Every line must be read, once.
Core\IO::write($path, Core\Str::repeat("x\n", 1000000));
uint $count = 0;
foreach (Core\IO::lines($path) as string $line) {
    $count = $count + 1;
}
if ($count != 1000000) {
    throw new LogicError('a line was lost or added');
}
echo 'step 1: done', "\n";

// 2. One line of twenty million characters with no line break. It is one line.
Core\IO::write($path, Core\Str::repeat('y', 20000000));
$count = 0;
foreach (Core\IO::lines($path) as string $line) {
    if (Core\Str::length($line) != 20000000) {
        throw new LogicError('the long line was cut');
    }
    $count = $count + 1;
}
if ($count != 1) {
    throw new LogicError('the long line was split');
}
echo 'step 2: done', "\n";

// 3. Only line breaks: "\r\n", "\n" and "\r", repeated. Each break ends one empty line.
Core\IO::write($path, Core\Str::repeat("\r\n\n\r", 100000));
$count = 0;
foreach (Core\IO::lines($path) as string $line) {
    if ($line != '') {
        throw new LogicError('an empty line has content');
    }
    $count = $count + 1;
}
if ($count != 300000) {
    throw new LogicError('a line break was counted wrong');
}
echo 'step 3: done', "\n";

// 4. A byte that is not text in the middle of the file. `lines` must throw an error.
array<bytes> $parts = ["ok\n" as bytes, Core\Bytes::fill(1, 255), "\n" as bytes];
Core\IO::writeStream($path, $parts, { overwrite: true });
bool $thrown = false;
try {
    Core\IO::lines($path);
} catch (RuntimeError $notText) {
    $thrown = true;
}
if (!$thrown) {
    throw new LogicError('a file that is not text was read as lines');
}
echo 'step 4: done', "\n";

// 5. Paths that are not a readable file. Each must throw an `IOError`.
array<string> $bad = [$dir, Core\Path::join($dir, 'missing.txt'), Core\Path::join($dir, "nul\0byte")];
foreach ($bad as string $badPath) {
    try {
        Core\IO::lines($badPath);
        throw new LogicError('a path that is not a file was read');
    } catch (IOError $refused) {
    }
}
// An empty name is not an absolute path, so it throws a `RuntimeError`.
bool $emptyThrew = false;
try {
    Core\IO::lines('');
} catch (RuntimeError $relative) {
    $emptyThrew = Core\Str::contains($relative->message, 'needs an absolute path');
}
if (!$emptyThrew) {
    throw new LogicError('an empty name did not throw the relative-path error');
}
echo 'step 5: done', "\n";
