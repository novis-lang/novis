<?nvs
// Attack: a program decodes bytes it wrote by hand. They name a generator's
// class, an open file's class and a function value's class. `encode` cannot
// write any of these values, so every `decode` below should throw a `ParseError`.

class Counter
{
    public static function upTo(int $n): Iterator<int>
    {
        yield $n;
    }
}

class Maker
{
    public function adder(): callable
    {
        return fn(int $x): int => $x + 1;
    }
}

class Forge
{
    // Returns one byte with the value `$value`.
    public static function byte(uint $value): bytes
    {
        return Core\Bytes::fill(1, $value);
    }

    // Returns the length of `$text` as one byte, then the text.
    public static function text(string $text): bytes
    {
        bytes $raw = $text as bytes;
        return Core\Bytes::join([Forge::byte(Core\Bytes::length($raw)), $raw]);
    }

    // Returns a payload with one object of class `$class`. It has a property
    // for each name in `$names`, and `$values` is the bytes of their values.
    public static function object(string $class, array<string> $names, bytes $values): bytes
    {
        array<bytes> $parts = ['NVS' as bytes, Forge::byte(27), Forge::byte(1), Forge::byte(9)];
        $parts[] = Forge::text($class);
        $parts[] = Forge::byte(Core\Arr::count($names));
        foreach ($names as string $name) {
            $parts[] = Forge::text($name);
        }
        $parts[] = $values;
        return Core\Bytes::join($parts);
    }

    // Returns the bytes of the whole number `$value`, from 0 to 255.
    public static function int(uint $value): bytes
    {
        return Core\Bytes::join([Forge::byte(2), Forge::byte($value), Core\Bytes::fill(7, 0)]);
    }

    // Returns the bytes of the string `$value`.
    public static function string(string $value): bytes
    {
        return Core\Bytes::join([Forge::byte(6), Forge::text($value)]);
    }

    // Decodes `$payload` and prints whether it threw a `ParseError`.
    public static function decode(string $step, bytes $payload): void
    {
        bytes $trusted = Core\Taint::assertTrustedBytes($payload, 'this attack wrote the bytes');
        try {
            Core\Serialize::decode($trusted);
            echo $step, ": decoded\n";
        } catch (ParseError $e) {
            echo $step, ": ParseError\n";
        }
    }
}

// Step 1: the generator's class, with a string in every property.
Forge::decode('step 1', Forge::object(
    'Counter::upTo$gen',
    ['state', 'n', 'current', 'key'],
    Core\Bytes::join([Forge::string('a'), Forge::string('b'), Forge::string('c'), Forge::string('d')]),
));

// Step 2: an open file's class, with the number 1 as the first property.
// On another side, 1 could be the number of a file this program never opened.
Forge::decode('step 2', Forge::object(
    'Core\IO\File',
    ['handle', 'path', 'mode'],
    Core\Bytes::join([Forge::int(1), Forge::string('/etc/passwd'), Forge::string('w')]),
));

// Step 3: the class of the function value in `Maker::adder`, with no properties.
Forge::decode('step 3', Forge::object('Maker$fn0', [], Core\Bytes::fill(0, 0)));

// Step 4: the same class, with the two properties a function value has.
Forge::decode('step 4', Forge::object(
    'Maker$fn0',
    ['arity', 'params'],
    Core\Bytes::join([Forge::int(1), Forge::int(0)]),
));
