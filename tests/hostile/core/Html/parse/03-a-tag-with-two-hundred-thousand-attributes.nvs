<?nvs
// Attack: one tag with two hundred thousand attributes is parsed. The program
// should finish quickly, and must not crash the runtime.
// proof: gap nvs-stdlib/element-with-many-attributes-costs-time

// 1. Builds the attributes `a0=0 a1=1 a2=2` and so on.
string $attributes = '';
int $i = 0;
while ($i < 200000) {
    $attributes = $attributes . ' a' . $i . '=' . $i;
    $i = $i + 1;
}

// 2. Parses one paragraph that has all of them.
var $wide = Core\Html::parse('<p' . $attributes . '>x');
echo 'step 2: ', Core\Str::length($wide->text()), "\n";
