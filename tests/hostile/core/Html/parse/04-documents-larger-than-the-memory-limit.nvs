<?nvs
// Attack: a client sends HTML documents of eight megabytes that are made of many
// small elements. The elements need much more memory than the text. The last
// document needs more memory than a request may use, so the program should stop
// there with `FATAL`.
// hostile: timeout-ms 30000
// hostile: ends-early 3 FATAL

// 1. One list with one hundred thousand empty items. This fits in memory.
var $small = Core\Html::parse('<ul>' . Core\Str::repeat('<li>', 100000) . '</ul>');
echo '1 children: ', Core\Arr::count($small->children()), "\n";

// 2. One paragraph with one hundred thousand short attributes. This fits in memory too.
string $attributes = '';
for (int $n = 0; $n < 100000; $n++) {
    $attributes = $attributes . ' a' . $n . '=""';
}
var $wide = Core\Html::parse('<p' . $attributes . '>x');
echo '2 children: ', Core\Arr::count($wide->children()), "\n";

// 3. Eight megabytes of line breaks, two million of them. The elements need
// more than the memory limit, so the program stops while it reads them.
echo "step 3\n";
var $huge = Core\Html::parse(Core\Str::repeat('<br>', 2000000));
echo '3 children: ', Core\Arr::count($huge->children()), "\n";
