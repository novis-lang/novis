<?nvs
// Attack: a program tries to switch itself into development mode, where errors show
// more details. Nothing here allows that, so the mode must stay `Production`.

// `Core\Config::set('mode', ...)` does not compile, because a program may not change `mode`.
// This program keeps the name in a variable. The compiler does not check a variable, so `set` runs and returns `false`.

// 1. The program tries to set development mode. The mode cannot go past its ceiling,
// so `set` returns `false`.
string $key = 'mode';
echo 'development allowed: ', Core\Config::set($key, 'development') ? 'yes' : 'no', "\n";

// 2. The program tries modes that do not exist, and a name of one million characters.
// None of them is a mode, so each call returns `false`.
array<string> $names = ['staging', 'DEVELOPMENT', ' development', "development\0", Core\Str::repeat('d', 1000000)];
foreach ($names as string $name) {
    echo 'strange mode allowed: ', Core\Config::set($key, $name) ? 'yes' : 'no', "\n";
}

// 3. The loop checks the mode one million times. Each result must be `Production`,
// so the last line prints `0`.
uint $development = 0;
uint $round = 0;
while ($round < 1000000) {
    if (Core\Env::mode() == Core\Env::Mode::Development) {
        $development = $development + 1;
    }
    $round = $round + 1;
}
echo 'answers that said development: ', $development, "\n";
