<?nvs
// Attack: a program builds bit filters with names that try to add a test, and
// with the largest and smallest numbers. Each bad name should throw a `LogicError`.

// 1. Names with filter characters, a backslash and a very long name.
array<string> $names = ['cn=*)(uid=*', '(cn', 'cn\\2a', 'cn;;', Core\Str::repeat('a', 1000000)];
foreach ($names as string $name) {
    try {
        var $filter = Core\Ldap\Ad::bitOr($name, 2);
        echo '1 length: ', Core\Str::length($filter->toString()), "\n";
    } catch (LogicError $refusal) {
        echo "1 refused\n";
    }
}

// 2. The smallest, the largest and a negative number.
array<int> $numbers = [0, -1, 9223372036854775807, -9223372036854775807 - 1];
foreach ($numbers as int $bits) {
    try {
        echo '2 ', Core\Ldap\Ad::bitOr('groupType', $bits)->toString(), "\n";
    } catch (Throwable $error) {
        echo "2 threw\n";
    }
}
