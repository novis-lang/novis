<?nvs
// Attack: the program copies the first key of very large arrays and of a very long key.
// It also reads the first key while an array gets shorter. Every step should finish
// or throw an error. The runtime should not crash.
// hostile: timeout-ms 60000

// 1. The first key of a list of 400000 entries.
array<int> $long = [];
int $i = 0;
while ($i < 400000) {
    $long[] = $i;
    $i = $i + 1;
}
echo 'step 1: ', Core\Arr::firstKey($long) ?? 'none', '|', "\n";

// 2. A first key of one million characters is copied 1000 times and freed after each copy.
array<int> $wide = [];
$wide[Core\Str::repeat('k', 1000000)] = 1;
uint $seen = 0;
int $r = 0;
while ($r < 1000) {
    $seen = $seen + Core\Str::length(Core\Arr::firstKey($wide) ?? '');
    $r = $r + 1;
}
echo 'step 2: ', $seen, '|', "\n";

// 3. A key that contains a zero byte in the middle.
array<int> $odd = [];
$odd["a\0b"] = 1;
echo 'step 3: ', Core\Str::length(Core\Arr::firstKey($odd) ?? ''), '|', "\n";

// 4. The front entry is removed 2000 times, and the first key is read after
//    every removal.
array<int> $shrinking = [];
int $n = 0;
while ($n < 2000) {
    $shrinking[] = $n;
    $n = $n + 1;
}
uint $read = 0;
while (!Core\Arr::isEmpty($shrinking)) {
    $read = $read + Core\Str::length(Core\Arr::firstKey($shrinking) ?? '');
    $shrinking = Core\Arr::withoutFirst($shrinking);
}
echo 'step 4: ', $read, '|', "\n";

// 5. An array with no entries has no first key.
array<int> $empty = [];
echo 'step 5: ', Core\Arr::firstKey($empty) ?? 'none', '|', "\n";

echo 'the runtime is still standing', "\n";
