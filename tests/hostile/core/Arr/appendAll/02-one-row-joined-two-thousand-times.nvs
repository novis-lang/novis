<?nvs
// Attack: a program joins one row of numbers to itself 2000 times in one call.
// The input is small, but the result is not, so the program should stop at its memory limit.
// hostile: timeout-ms 20000
// hostile: ends-early 1 FATAL

// 1. One row of 100000 numbers, stored 2000 times in one array. The result
// would have 200 million entries, so the memory limit stops the program here.
echo "step 1\n";
array<int> $row = Core\Arr::range(1, 100000);
array<array<int>> $rows = Core\Arr::fill(2000, $row);
echo Core\Arr::count(Core\Arr::appendAll($row, ...$rows)), "\n";
