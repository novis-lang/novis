<?nvs
// Attack: `Core\Arr::prepend` copies the whole array and gives every entry a
// new key. Each step below asks it for a copy it should not be able to make.
// Every step should finish, and the last one should stop the program at its
// memory limit. The runtime must not crash.
// hostile: timeout-ms 60000
// hostile: ends-early 5 FATAL

// 1. The array uses the largest whole number there is as a key. Every key is
// renumbered here, so the result is a list of two entries.
array<string> $taken = ['9223372036854775807' => 'a'];
echo 'step 1: ', Core\Str::join(Core\Arr::keys(Core\Arr::prepend($taken, 'b')), ','), "\n";

// 2. Two thousand calls in a row, each one copying a list that is one entry
// longer than the last.
array<int> $growing = [];
int $round = 0;
while ($round < 2000) {
    $growing = Core\Arr::prepend($growing, $round);
    $round = $round + 1;
}
echo 'step 2: ', Core\Arr::count($growing), "\n";

// 3. One call that puts 400000 values in front.
array<int> $wide = [];
int $i = 0;
while ($i < 400000) {
    $wide[] = $i;
    $i = $i + 1;
}
echo 'step 3: ', Core\Arr::count(Core\Arr::prepend($wide, ...$wide)), "\n";

// 4. A value of ten million characters is put in front of an array of words.
array<string> $words = ['one', 'two'];
echo 'step 4: ', Core\Arr::count(Core\Arr::prepend($words, Core\Str::repeat('a', 10000000))), "\n";

// 5. Fifty thousand rounds, each putting the array in front of itself. The
// copies grow with every round, so the program should stop at its memory limit.
echo "step 5\n";
array<mixed> $nested = ['a'];
int $depth = 0;
while ($depth < 50000) {
    $nested = Core\Arr::prepend($nested, $nested);
    $depth = $depth + 1;
}
echo 'step 5: ', Core\Arr::count($nested), "\n";
