<?nvs
// Attack: `Core\Arr::mapKeys` runs a function the program wrote, once per entry,
// and builds every key it returns. Each step below gives it a function written
// to break that walk. Every step should finish, and the last one should stop the
// program at its memory limit. The runtime must not crash.
// hostile: timeout-ms 60000
// hostile: ends-early

class Attack
{
    public static uint $depth = 0;

    // Throws instead of naming a key for the entry it is given.
    public static function refuse(int $n): string
    {
        throw new LogicError('no');
    }

    // Re-keys a one-entry array with a function that does the same again, until
    // the runtime stops it.
    public static function deeper(int $n): string
    {
        Attack::$depth = Attack::$depth + 1;
        return Core\Str::format('%d', Core\Arr::count(
            Core\Arr::mapKeys([$n], fn(int $m) => Attack::deeper($m)),
        ));
    }
}

// 1. The function throws on the first entry. Half a result is built and then
// thrown away. The error is caught, and nothing of it is left behind.
array<int> $numbers = [4, 11, 7, 20];
try {
    array<int> $never = Core\Arr::mapKeys($numbers, fn(int $n) => Attack::refuse($n));
    echo 'step 1: ', Core\Arr::count($never), "\n";
} catch (LogicError $refused) {
    echo 'step 1: threw', "\n";
}

// 2. The function re-keys an array of its own, as deeply as it can. The runtime
// stops it at its recursion limit, and that error is caught.
try {
    array<int> $nested = Core\Arr::mapKeys([1], fn(int $n) => Attack::deeper($n));
    echo 'step 2: ', Core\Arr::count($nested), "\n";
} catch (RecursionError $stopped) {
    echo 'step 2: stopped after ', Attack::$depth, ' calls', "\n";
}

// 3. All 400000 entries are given one and the same key of 5000 characters. The
// result has a single entry, and the other 399999 keys are freed again.
array<int> $wide = [];
int $i = 0;
while ($i < 400000) {
    $wide[] = $i;
    $i = $i + 1;
}
array<int> $collapsed = Core\Arr::mapKeys($wide, fn(int $n) => Core\Str::repeat('a', 5000));
echo 'step 3: ', Core\Arr::count($collapsed), "\n";

// 4. Every entry is given a key of its own, ten million characters long. The
// program should stop at its memory limit.
array<int> $huge = Core\Arr::mapKeys($wide, fn(int $n)
    => Core\Str::repeat('b', 10000000) . Core\Str::format('%d', $n));
echo 'step 4: ', Core\Arr::count($huge), "\n";
