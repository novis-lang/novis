<?nvs
// Attack: a program compares two large arrays with its own comparator, which
// makes every entry of the first array meet every entry of the second. The
// last step should stop at the memory limit with an error, and the program
// must not crash.
// hostile: timeout-ms 20000
// hostile: ends-early 6 FATAL

// 1. Nothing at all, on both sides.
echo Core\Arr::count(Core\Arr::diff([], [])), "\n";

// 2. The number 3 and the text "3". They are different values, so neither one
// removes the other and both entries are kept.
array<string|int> $spelled = ['3', '4'];
array<string|int> $numbers = [3, 4];
echo Core\Arr::count(Core\Arr::diff($spelled, $numbers)), "\n";

// 3. An array compared with itself. Every entry is in both, so the result is
// empty, and nothing may be freed while it is still being read.
array<int> $wide = Core\Arr::range(1, 10000);
echo Core\Arr::count(Core\Arr::diff($wide, $wide)), "\n";

// 4. A comparator that says every pair is the same. The comparator replaces
// the comparison, so it runs once for every pair: 500 times 500 calls here.
array<int> $left = Core\Arr::range(1, 500);
array<int> $right = Core\Arr::range(1, 500);
echo Core\Arr::count(Core\Arr::diff($left, $right, {
    comparator: fn(int $a, int $b): int => 0,
})), "\n";

// 5. A `by` function that answers the same text for every entry, so ten
// thousand entries are compared as one value.
echo Core\Arr::count(Core\Arr::diff($wide, $left, {
    by: fn(int $value): string => 'same',
})), "\n";

// 6. Two lists of one million numbers with nothing in common. Keeping every
// result needs more memory than the program has, so it stops here with an error.
echo "step 6\n";
array<int> $huge = Core\Arr::range(1, 1000000);
array<int> $other = Core\Arr::range(2000000, 3000000);
array<array<int>> $kept = [];
uint $k = 0;
while ($k < 1000) {
    $kept[] = Core\Arr::diff($huge, $other);
    $k = $k + 1;
}
echo "kept all\n";
