<?nvs
// Attack: the last value is read from very large arrays, and read again and
// again from the same one, so that the work of finding it is paid every time.
// Every step should finish or throw an error, and the runtime must not crash.
// hostile: timeout-ms 60000

// 1. The last value of a list of 400000 entries.
array<int> $long = [];
int $i = 0;
while ($i < 400000) {
    $long[] = $i;
    $i = $i + 1;
}
echo 'step 1: ', Core\Arr::last($long) ?? -1, '|', "\n";

// 2. The last value of a list of 50000 entries, read 200 times.
array<int> $mid = [];
int $m = 0;
while ($m < 50000) {
    $mid[] = $m;
    $m = $m + 1;
}
int $sum = 0;
int $r = 0;
while ($r < 200) {
    $sum = $sum + (Core\Arr::last($mid) ?? 0);
    $r = $r + 1;
}
echo 'step 2: ', $sum, '|', "\n";

// 3. A last value of one million characters, read and dropped 1000 times.
array<string> $wide = ['first', Core\Str::repeat('v', 1000000)];
uint $seen = 0;
int $w = 0;
while ($w < 1000) {
    $seen = $seen + Core\Str::length(Core\Arr::last($wide) ?? '');
    $w = $w + 1;
}
echo 'step 3: ', $seen, '|', "\n";

// 4. The last entry is removed 2000 times, and the last value is read after
//    every removal.
array<int> $shrinking = [];
int $n = 0;
while ($n < 2000) {
    $shrinking[] = $n;
    $n = $n + 1;
}
int $tail = 0;
while (!Core\Arr::isEmpty($shrinking)) {
    $tail = $tail + (Core\Arr::last($shrinking) ?? 0);
    $shrinking = Core\Arr::withoutLast($shrinking);
}
echo 'step 4: ', $tail, '|', "\n";

// 5. The last value is an array. The array it came from is emptied, and the
//    value is read afterwards.
array<array<int>> $outer = [[7, 8], [9, 10]];
?array<int> $held = Core\Arr::last($outer);
$outer = [];
if ($held != null) {
    echo 'step 5: ', $held[1], '|', "\n";
}

// 6. An array with no entries has no last value.
array<int> $empty = [];
echo 'step 6: ', Core\Arr::last($empty) ?? -1, '|', "\n";

echo 'the runtime is still standing', "\n";
