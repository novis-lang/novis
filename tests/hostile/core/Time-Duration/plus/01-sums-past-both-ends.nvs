<?nvs
// Attack: `plus` gets the largest and smallest durations there are, and one million sums.
// A sum that does not fit should throw a `RuntimeError`, and nothing should crash or leak.

Core\Time\Duration $largest = Core\Time\Duration::nanoseconds(9223372036854775807);
Core\Time\Duration $smallest = Core\Time\Duration::nanoseconds(-9223372036854775807 - 1);
Core\Time\Duration $one = Core\Time\Duration::nanoseconds(1);

// 1. Each end plus each end, and each end plus one nanosecond in both directions.
array<Core\Time\Duration> $values = [$largest, $smallest, $one, $one->negated()];
int $built = 0;
int $refused = 0;
foreach ($values as Core\Time\Duration $left) {
    foreach ($values as Core\Time\Duration $right) {
        try {
            $left->plus($right);
            $built = $built + 1;
        } catch (RuntimeError $e) {
            $refused = $refused + 1;
        }
    }
}
echo $built, ' built, ', $refused, " refused\n";

// 2. A sum grows one step at a time until it no longer fits.
Core\Time\Duration $sum = 1ns;
int $steps = 0;
try {
    while (true) {
        $sum = $sum->plus($sum);
        $steps = $steps + 1;
    }
} catch (RuntimeError $e) {
    echo $steps, " doublings fit\n";
}

// 3. One million sums are built, one at a time. Each one is freed again.
Core\Time\Duration $total = 0s;
int $round = 0;
while ($round < 1000000) {
    $total = $total->plus(Core\Time\Duration::milliseconds($round % 1000 - 500));
    $round = $round + 1;
}
echo $total->toMilliseconds(), "\n";
