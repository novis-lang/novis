<?nvs
// Attack: `multipliedBy` gets the largest and smallest factors there are, and one million products.
// A product that does not fit should throw a `RuntimeError`, and nothing should crash or leak.

// 1. One nanosecond and one day are multiplied by factors at the ends of `int`.
array<int> $factors = [9223372036854775807, -9223372036854775807 - 1, 106751, 106752, -106752, 0, 1, -1];
int $built = 0;
int $refused = 0;
foreach ($factors as int $f) {
    try {
        Core\Time\Duration::nanoseconds(1)->multipliedBy($f);
        $built = $built + 1;
    } catch (RuntimeError $e) {
        $refused = $refused + 1;
    }
    try {
        1d->multipliedBy($f);
        $built = $built + 1;
    } catch (RuntimeError $g) {
        $refused = $refused + 1;
    }
}
echo $built, ' built, ', $refused, " refused\n";

// 2. The smallest duration is multiplied by -1. The result does not fit, so this throws.
try {
    Core\Time\Duration::nanoseconds(-9223372036854775807 - 1)->multipliedBy(-1);
} catch (RuntimeError $h) {
    echo "product refused\n";
}

// 3. One million products are built, one at a time. Each one is freed again.
int $round = 0;
int $total = 0;
while ($round < 1000000) {
    $total = $total + 1s->multipliedBy($round - 500000)->toSeconds() % 7;
    $round = $round + 1;
}
echo $total, "\n";
