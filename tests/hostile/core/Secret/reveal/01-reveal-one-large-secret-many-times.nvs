<?nvs
// Attack: a program reveals one secret of 16 million characters thousands of times
// and keeps every result. Each result should share the same text, so memory stays
// small, and changing one result must not change the secret or the others.

// A secret of 16 million characters.
secret string $big = Core\Str::repeat('k', 16000000);

// Step 1: reveal the secret 100,000 times and drop each result at once.
uint $i = 0;
uint $seen = 0;
while ($i < 100000) {
    string $plain = Core\Secret::reveal($big, 'the loop checks every revealed value');
    $seen = $seen + Core\Str::length($plain) % 7;
    $i = $i + 1;
}
echo 'step 1: ', $seen, "\n";

// Step 2: keep 10,000 results in one array. If each result were a copy,
// this would need 160 gigabytes.
array<string> $kept = [];
$i = 0;
while ($i < 10000) {
    $kept[] = Core\Secret::reveal($big, 'the cache keeps every revealed value');
    $i = $i + 1;
}
echo 'step 2: ', Core\Arr::count($kept), "\n";

// Step 3: change one kept result. The secret and the other results stay the same length.
$kept[0] = $kept[0] . '!';
string $check = Core\Secret::reveal($big, 'the test compares the lengths');
echo 'step 3: ', Core\Str::length($kept[0]), ' ', Core\Str::length($kept[1]), ' ', Core\Str::length($check), "\n";

// Step 4: the reason is 16 million characters long. The program never reads it.
string $longReason = Core\Str::repeat('because ', 2000000);
string $small = Core\Secret::reveal('pin-4821', $longReason);
echo 'step 4: ', $small, "\n";

// Step 5: free the kept results, and reveal an empty secret.
$kept = [];
secret string $empty = '';
echo 'step 5: ', Core\Str::length(Core\Secret::reveal($empty, 'an empty secret is allowed')), "\n";
