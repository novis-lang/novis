<?nvs
// Attack: a program reveals 16 megabytes of secret bytes thousands of times and
// keeps every result. The bytes include every value from 0 to 255. Each result
// should share the same bytes, and changing one result must not change the others.

// 16 megabytes that contain every byte value, many times over.
bytes $pattern = Core\Encoding::fromHex('00ff8041c2fe0d0affc0809b7f00e0fd');
secret bytes $big = Core\Bytes::repeat($pattern, 1000000);

// Step 1: reveal the bytes 100,000 times and drop each result at once.
uint $i = 0;
uint $seen = 0;
while ($i < 100000) {
    bytes $raw = Core\Secret::revealBytes($big, 'the loop checks every revealed key');
    $seen = $seen + Core\Bytes::length($raw) % 7;
    $i = $i + 1;
}
echo 'step 1: ', $seen, "\n";

// Step 2: keep 10,000 results in one array. If each result were a copy,
// this would need 160 gigabytes.
array<bytes> $kept = [];
$i = 0;
while ($i < 10000) {
    $kept[] = Core\Secret::revealBytes($big, 'the cache keeps every revealed key');
    $i = $i + 1;
}
echo 'step 2: ', Core\Arr::count($kept), "\n";

// Step 3: change one kept result. The secret and the other results stay the same.
$kept[0] = Core\Bytes::join([$kept[0], $pattern]);
bytes $check = Core\Secret::revealBytes($big, 'the test compares the lengths');
echo 'step 3: ', Core\Bytes::length($kept[0]), ' ', Core\Bytes::length($kept[1]), ' ', Core\Bytes::length($check), "\n";
echo 'step 3: ', Core\Encoding::toHex(Core\Bytes::slice($check, 0, 16)), "\n";

// Step 4: free the kept results, and reveal an empty key.
$kept = [];
secret bytes $empty = '' as bytes;
echo 'step 4: ', Core\Bytes::length(Core\Secret::revealBytes($empty, 'an empty key is allowed')), "\n";
