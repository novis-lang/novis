<?nvs
// Attack: the core count is read many times and used in arithmetic that goes
// past the ends of `uint`. Every step should give a correct number or throw
// an error, and the program should run to its last line.

uint $cores = Core\Os::cpuCount();

// 1. The count is read 20000 times. Every reading must be the same. This prints 1.
uint $same = 0;
uint $i = 0;
while ($i < 20000) {
    if (Core\Os::cpuCount() == $cores) {
        $same = $same + 1;
    }
    $i = $i + 1;
}
echo $same == 20000 ? 1 : 0, "\n";

// 2. More cores are taken away than the machine has. The result would be below
//    0, so this throws an `ArithmeticError`.
try {
    echo $cores - 100000, "\n";
} catch (ArithmeticError $e) {
    echo 'caught: ', $e->message, "\n";
}

// 3. The count is multiplied past the largest `uint`. This throws an
//    `ArithmeticError`.
uint $largest = 18446744073709551615;
try {
    echo $largest * $cores + $largest, "\n";
} catch (ArithmeticError $e) {
    echo 'caught: ', $e->message, "\n";
}

// 4. A job number is divided by the count minus itself, which is 0. This
//    throws an `ArithmeticError`.
try {
    echo 7 % ($cores - $cores), "\n";
} catch (ArithmeticError $e) {
    echo 'caught: ', $e->message, "\n";
}

// 5. A list gets one entry per core, 100000 times over. Its length must be
//    exactly the count times 100000. This prints 1.
array<uint> $slots = [];
uint $round = 0;
while ($round < 100000) {
    uint $core = 0;
    while ($core < $cores) {
        $slots[] = $core;
        $core = $core + 1;
    }
    $round = $round + 1;
}
echo Core\Arr::count($slots) == $cores * 100000 ? 1 : 0, "\n";
