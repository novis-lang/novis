<?nvs
// Attack: a request removes strange keys, and removes large values many times.
// Every removed value must be freed, and nothing may crash.
// hostile: timeout-ms 60000
// requires: redis

// 1. The request removes a key before it saves anything. The call opens an empty session and does not throw.
Core\Session::remove('user');
echo 'first remove: ', Core\Session::get('user') ?? '(none)', "\n";

// 2. The request removes an empty key, a key of 1 MB and a key with a zero byte.
// Nothing was saved under them, so the session does not change.
string $long = Core\Str::repeat('k', 1048576);
Core\Session::setShortLived('user', 'ada');
Core\Session::remove('');
Core\Session::remove($long);
Core\Session::remove("user\0admin");
echo 'user: ', Core\Session::get('user') ?? '(none)', "\n";

// 3. The request saves a key of 1 MB and removes it again.
Core\Session::setLongLived($long, 'x');
Core\Session::remove($long);
echo 'long key: ', Core\Session::get($long) ?? '(none)', "\n";

// 4. The request saves a value of 1 MB and removes it. It does this 50 times, with both lifetimes.
string $big = Core\Str::repeat('x', 1048576);
uint $i = 0;
while ($i < 50) {
    Core\Session::setShortLived('big', $big);
    Core\Session::remove('big');
    Core\Session::setLongLived('big', $big);
    Core\Session::remove('big');
    $i = $i + 1;
}
echo 'big: ', Core\Session::get('big') ?? '(none)', "\n";

// 5. The request saves 500 keys and removes them one by one, then removes them all again.
uint $key = 0;
while ($key < 500) {
    Core\Session::setLongLived('item-' . $key, $key);
    $key = $key + 1;
}
uint $round = 0;
while ($round < 2) {
    uint $k = 0;
    while ($k < 500) {
        Core\Session::remove('item-' . $k);
        $k = $k + 1;
    }
    $round = $round + 1;
}
echo 'item-0: ', Core\Session::get('item-0') ?? '(none)', "\n";

// 6. The request deletes the whole session and then removes a key. The session is empty, so nothing changes.
Core\Session::clearAll();
Core\Session::remove('user');
echo 'after clearAll: ', Core\Session::get('user') ?? '(none)', "\n";
