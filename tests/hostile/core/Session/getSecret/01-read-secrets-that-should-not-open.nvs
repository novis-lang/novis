<?nvs
// Attack: a request reads secrets with wrong keys and plants fake secrets with `set()`.
// Every read must return `null` or throw an error, and nothing may crash or leak.
// hostile: timeout-ms 60000

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];
secret string $token = 'sk-live-7';

// 1. The request reads a secret in a session it never started. This throws a `RuntimeError`.
try {
    Core\Session::getSecret('token', $keys);
    echo "read a session that was never started\n";
} catch (RuntimeError $e) {
    echo "not started: RuntimeError\n";
}

Core\Session::start();
Core\Session::setSecret('token', $token, $keys);

// 2. The key list is empty. This throws a `LogicError`.
try {
    array<secret bytes> $empty = [];
    Core\Session::getSecret('token', $empty);
    echo "read with no key\n";
} catch (LogicError $emptyError) {
    echo "empty list: LogicError\n";
}

// 3. The first key is seven bytes long. This throws a `LogicError`.
try {
    array<secret bytes> $short = ['raw-key' as bytes];
    Core\Session::getSecret('token', $short);
    echo "read with a short key\n";
} catch (LogicError $shortError) {
    echo "short key: LogicError\n";
}

// 4. The request uses `set()` to write text where the secret is saved. The result is `null`.
Core\Session::set("\x00secret\x00planted", 'forged');
echo 'planted text: ', Core\Session::getSecret('planted', $keys) == null ? 'null' : 'a value', "\n";

// 5. The request writes 64 bytes over the saved secret. They do not decrypt, so the result is `null`.
Core\Session::set("\x00secret\x00token", Core\Str::repeat('z', 64) as bytes);
echo 'replaced bytes: ', Core\Session::getSecret('token', $keys) == null ? 'null' : 'a value', "\n";

// 6. The request reads a name one million characters long that nothing saved.
string $longName = Core\Str::repeat('k', 1000000);
echo 'long name: ', Core\Session::getSecret($longName, $keys) == null ? 'null' : 'a value', "\n";

// 7. The key list has 10000 wrong keys. Every key is tried, and the result is `null`.
array<secret bytes> $many = [];
uint $i = 0;
while ($i < 10000) {
    $many[] = Core\Crypto::generateKey();
    $i = $i + 1;
}
Core\Session::setSecret('token', $token, $keys);
echo 'many wrong keys: ', Core\Session::getSecret('token', $many) == null ? 'null' : 'a value', "\n";

// 8. The request reads a name nothing saved 100000 times, then reads the real secret.
uint $n = 0;
while ($n < 100000) {
    Core\Session::getSecret('never-written', $keys);
    $n = $n + 1;
}
echo 'then: ', (Core\Session::getSecret('token', $keys) ?? '') == $token ? 'the secret' : 'null', "\n";
