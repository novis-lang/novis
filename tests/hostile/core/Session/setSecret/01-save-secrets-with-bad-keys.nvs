<?nvs
// Attack: a request saves secrets with bad key lists, huge values and many keys.
// Every bad key list must throw an error, and nothing may crash or leak.
// hostile: timeout-ms 60000

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];
secret string $token = 'sk-live-7';

// 1. The request saves a secret in a session it never started. This throws a `RuntimeError`.
try {
    Core\Session::setSecret('token', $token, $keys);
    echo "saved in a session that was never started\n";
} catch (RuntimeError $e) {
    echo "not started: RuntimeError\n";
}

Core\Session::start();

// 2. The key list is empty. This throws a `LogicError`, and nothing is saved.
try {
    array<secret bytes> $empty = [];
    Core\Session::setSecret('token', $token, $empty);
    echo "saved with no key\n";
} catch (LogicError $emptyError) {
    echo "empty list: LogicError\n";
}

// 3. The first key is seven bytes long. A key must be 32 bytes, so this throws a `LogicError`.
try {
    array<secret bytes> $short = ['raw-key' as bytes];
    Core\Session::setSecret('token', $token, $short);
    echo "saved with a short key\n";
} catch (LogicError $shortError) {
    echo "short key: LogicError\n";
}
echo 'after the bad lists: ', Core\Session::getSecret('token', $keys) == null ? 'null' : 'a value', "\n";

// 4. The request saves 2000 secrets, then saves a new secret under each of them.
uint $round = 0;
while ($round < 2) {
    uint $i = 0;
    while ($i < 2000) {
        Core\Session::setSecret('item-' . $i, $token, $keys);
        $i = $i + 1;
    }
    $round = $round + 1;
}
echo 'item-1999: ', Core\Session::getSecret('item-1999', $keys) == null ? 'null' : 'a value', "\n";

// 5. The secret is ten million characters long. The call saves it or stops at the memory limit.
try {
    Core\Session::setSecret('huge', Core\Str::repeat('x', 10000000), $keys);
    echo 'huge: ', Core\Session::getSecret('huge', $keys) == null ? 'null' : 'a value', "\n";
} catch (Throwable $hugeError) {
    echo "huge: stopped\n";
}

// 6. The key name is one million characters long.
string $longName = Core\Str::repeat('k', 1000000);
Core\Session::setSecret($longName, $token, $keys);
echo 'long name: ', Core\Session::getSecret($longName, $keys) == null ? 'null' : 'a value', "\n";

// 7. The request ends the session and then saves a secret. This throws a `RuntimeError`.
Core\Session::destroy();
try {
    Core\Session::setSecret('token', $token, $keys);
    echo "saved in a session that was destroyed\n";
} catch (RuntimeError $e) {
    echo "destroyed: RuntimeError\n";
}
