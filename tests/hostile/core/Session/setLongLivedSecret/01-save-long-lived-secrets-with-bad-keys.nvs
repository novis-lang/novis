<?nvs
// Attack: a request saves long-lived secrets with bad key lists, huge values and many keys.
// Every bad key list must throw an error, and every clear must delete what it says.
// hostile: timeout-ms 60000
// requires: redis

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];
secret string $token = 'sk-live-7';

// 1. The first call of the request uses an empty key list. This throws a `LogicError`.
try {
    array<secret bytes> $empty = [];
    Core\Session::setLongLivedSecret('token', $token, $empty);
    echo "saved with no key\n";
} catch (LogicError $emptyError) {
    echo "empty list: LogicError\n";
}

// 2. The first key is seven bytes long. A key must be 32 bytes, so this throws a `LogicError`.
try {
    array<secret bytes> $short = ['raw-key' as bytes];
    Core\Session::setLongLivedSecret('token', $token, $short);
    echo "saved with a short key\n";
} catch (LogicError $shortError) {
    echo "short key: LogicError\n";
}
echo 'after the bad lists: ', Core\Session::getSecret('token', $keys) == null ? 'null' : 'a value', "\n";

// 3. The request saves 2000 secrets, then saves a new secret under each of them.
uint $round = 0;
while ($round < 2) {
    uint $i = 0;
    while ($i < 2000) {
        Core\Session::setLongLivedSecret('item-' . $i, $token, $keys);
        $i = $i + 1;
    }
    $round = $round + 1;
}
echo 'item-1999: ', Core\Session::getSecret('item-1999', $keys) == null ? 'null' : 'a value', "\n";

// 4. The secret is ten million characters long. The call saves it or stops at the memory limit.
try {
    Core\Session::setLongLivedSecret('huge', Core\Str::repeat('x', 10000000), $keys);
    echo 'huge: ', Core\Session::getSecret('huge', $keys) == null ? 'null' : 'a value', "\n";
} catch (Throwable $hugeError) {
    echo "huge: stopped\n";
}

// 5. The key name is one million characters long.
string $longName = Core\Str::repeat('k', 1000000);
Core\Session::setLongLivedSecret($longName, $token, $keys);
echo 'long name: ', Core\Session::getSecret($longName, $keys) == null ? 'null' : 'a value', "\n";

// 6. A short-lived write replaces a long-lived secret under the same key. Sign-out deletes it.
Core\Session::setShortLivedSecret('item-0', $token, $keys);
Core\Session::clearShortLived();
echo 'item-0 after sign-out: ', Core\Session::getSecret('item-0', $keys) == null ? 'null' : 'a value', "\n";
echo 'item-1 after sign-out: ', Core\Session::getSecret('item-1', $keys) == null ? 'null' : 'a value', "\n";

// 7. The request deletes the long-lived values. Every long-lived secret is deleted.
Core\Session::clearLongLived();
echo 'after clearLongLived: ', Core\Session::getSecret('item-1', $keys) == null ? 'null' : 'a value', "\n";

// 8. The request deletes the session and saves a secret again. The old secret stays deleted.
Core\Session::setLongLivedSecret('token', $token, $keys);
Core\Session::clearAll();
Core\Session::setLongLivedSecret('fresh', $token, $keys);
echo 'old: ', Core\Session::getSecret('token', $keys) == null ? 'null' : 'a value', "\n";
echo 'fresh: ', Core\Session::getSecret('fresh', $keys) == null ? 'null' : 'a value', "\n";
