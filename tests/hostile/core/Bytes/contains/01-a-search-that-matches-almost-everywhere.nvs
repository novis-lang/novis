<?nvs
// Attack: a value of five million bytes is searched for 5001 bytes that almost
// match at every position. The search has to read thousands of bytes at each
// of five million places. It must give the right answer, and the program must
// keep running.
// hostile: timeout-ms 20000

bytes $empty = '' as bytes;
bytes $short = 'ab' as bytes;

// 1. An empty value is found in every value. A longer value is never found.
//    This prints "true", "true", "true" and then "false".
echo Core\Bytes::contains($empty, $empty) ? 'true' : 'false', "\n";
echo Core\Bytes::contains($short, $empty) ? 'true' : 'false', "\n";
echo Core\Bytes::contains($short, $short) ? 'true' : 'false', "\n";
echo Core\Bytes::contains($short, 'abc' as bytes) ? 'true' : 'false', "\n";

// 2. Five million `a` bytes are searched for 5000 `a` bytes and a `b`. Each
//    position matches 5000 bytes and then fails, so this prints "false".
bytes $flat = Core\Bytes::fill(5000000, 97);
bytes $almost = Core\Bytes::join([Core\Bytes::fill(5000, 97), 'b' as bytes]);
echo Core\Bytes::contains($flat, $almost) ? 'true' : 'false', "\n";

// 3. The same search over a value whose last byte is the one that was missing.
//    The bytes are found at the very end, so this prints "true".
bytes $ending = Core\Bytes::join([Core\Bytes::fill(4999999, 97), 'b' as bytes]);
echo Core\Bytes::contains($ending, $almost) ? 'true' : 'false', "\n";

// 4. A search that reads every byte of a 1000-byte value runs 200000 times.
//    The result must be false every time, so this prints 0.
bytes $page = Core\Bytes::fill(1000, 97);
uint $found = 0;
uint $i = 0;
while ($i < 200000) {
    if (Core\Bytes::contains($page, $short)) {
        $found = $found + 1;
    }
    $i = $i + 1;
}
echo $found, "\n";
