<?nvs
// Attack: failed jobs are saved under queue names that almost match, the queue name has a
// zero byte, and 200000 jobs of one queue fail. `deadLettered()` should return a number or
// throw an error. The program must not crash.
use Core\Queue;

var $db = Core\Db::connect('jobs');
var $jobs = <<<'SQL'
create table nvs_jobs (id integer primary key autoincrement, queue varchar(255) not null,
    script text not null, args text, state smallint not null, attempts integer not null,
    max_attempts integer not null, backoff_ms bigint not null, run_at bigint not null,
    tag varchar(255), dedupe_key varchar(255), dedupe_pending varchar(255),
    created_at bigint not null, claimed_at bigint, errors text, grants text, limits text,
    constraint nvs_jobs_dedupe unique (dedupe_pending))
SQL;
var $dead = <<<'SQL'
create table nvs_dead_jobs (id bigint not null, queue varchar(255) not null,
    script text not null, args text, attempts integer not null, max_attempts integer not null,
    backoff_ms bigint not null, run_at bigint not null, tag varchar(255),
    dedupe_key varchar(255), created_at bigint not null, failed_at bigint not null,
    errors text not null, primary key (id))
SQL;
$db->execute($jobs, []);
$db->execute($dead, []);

$db->execute(<<<'SQL'
insert into nvs_dead_jobs (id, queue, script, attempts, max_attempts, backoff_ms,
    run_at, created_at, failed_at, errors)
values (1, 'q', 'jobs/a.nvs', 5, 5, 1000, 0, 0, 0, '[]'),
       (2, 'Q', 'jobs/a.nvs', 5, 5, 1000, 0, 0, 0, '[]'),
       (3, 'q ', 'jobs/a.nvs', 5, 5, 1000, 0, 0, 0, '[]'),
       (4, 'q' || char(0), 'jobs/a.nvs', 5, 5, 1000, 0, 0, 0, '[]'),
       (5, x'71', 'jobs/a.nvs', 5, 5, 1000, 0, 0, 0, '[]')
SQL, []);

// 1. The queue name is SQL that tries to count the failed jobs of every queue.
try {
    echo '1: ', Queue::stats("q' or '1'='1")->deadLettered(), "\n";
} catch (Throwable $e) {
    echo "1: error\n";
}

// 2. Other rows have the names `Q`, `q ` with a space, and `q` with a zero byte after it.
try {
    echo '2: ', Queue::stats('q')->deadLettered(), "\n";
} catch (Throwable $e) {
    echo "2: error\n";
}

// 3. The queue name is `q` with a zero byte after it.
try {
    echo '3: ', Queue::stats("q\0")->deadLettered(), "\n";
} catch (Throwable $e) {
    echo "3: error\n";
}

// 4. The queue name is the SQL pattern `%`, which matches every name in a `like`.
try {
    echo '4: ', Queue::stats('%')->deadLettered(), "\n";
} catch (Throwable $e) {
    echo "4: error\n";
}

// 5. The queue name has 100000 characters.
try {
    echo '5: ', Queue::stats(Core\Str::repeat('q', 100000))->deadLettered(), "\n";
} catch (Throwable $e) {
    echo "5: error\n";
}

// 6. The dead-letter table has 200000 jobs of the queue.
$db->execute('delete from nvs_dead_jobs', []);
$db->execute(<<<'SQL'
with recursive n(i) as (select 1 union all select i + 1 from n where i < 200000)
insert into nvs_dead_jobs (id, queue, script, attempts, max_attempts, backoff_ms, run_at,
    created_at, failed_at, errors)
select i, 'q', 'jobs/a.nvs', 5, 5, 1000, 0, 0, 0, '[]' from n
SQL, []);
try {
    echo '6: ', Queue::stats('q')->deadLettered(), "\n";
} catch (Throwable $e) {
    echo "6: error\n";
}

// 7. `deadLettered()` is called 1000000 times on one result.
var $stats = Queue::stats('q');
uint $total = 0;
int $i = 0;
while ($i < 1000000) {
    $total = ($total + $stats->deadLettered()) % 1000003;
    $i = $i + 1;
}
echo '7: ', $total, "\n";
