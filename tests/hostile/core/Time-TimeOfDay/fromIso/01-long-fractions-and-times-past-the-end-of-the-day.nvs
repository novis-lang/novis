<?nvs
// Attack: `Core\Time\TimeOfDay::fromIso` gets very long texts, times past the end of the day, and many bad texts.
// Each bad text should throw a `ParseError`, and nothing should crash or leak.

int $refused = 0;

// 1. A valid time with one million digits after the decimal point, and ten digits.
string $digits = Core\Str::repeat('9', 1000000);
try {
    Core\Time\TimeOfDay::fromIso('09:30:00.' . $digits);
} catch (ParseError $fraction) {
    $refused = $refused + 1;
}
string $ten = '09:30:00.1234567890';
try {
    Core\Time\TimeOfDay::fromIso($ten);
} catch (ParseError $tenError) {
    $refused = $refused + 1;
}

// 2. One million digits as the hour, and ten million bytes of text that is not a time.
try {
    Core\Time\TimeOfDay::fromIso($digits . ':30');
} catch (ParseError $hour) {
    $refused = $refused + 1;
}
try {
    Core\Time\TimeOfDay::fromIso(Core\Str::repeat(':', 10000000));
} catch (ParseError $junk) {
    $refused = $refused + 1;
}

// 3. The hour 24, the minute 60 and the leap second 60.
// Each text is in a variable, so it is read when the program runs.
string $midnight = '24:00';
try {
    Core\Time\TimeOfDay::fromIso($midnight);
} catch (ParseError $midnightError) {
    $refused = $refused + 1;
}
string $minute = '23:60';
try {
    Core\Time\TimeOfDay::fromIso($minute);
} catch (ParseError $minuteError) {
    $refused = $refused + 1;
}
string $leap = '23:59:60';
try {
    Core\Time\TimeOfDay::fromIso($leap);
} catch (ParseError $leapError) {
    $refused = $refused + 1;
}

// 4. Texts with a wrong shape: one digit, a dot with no digits, an offset, a sign and an empty text.
array<string> $malformed = ['9:30', '09:30:00.', '09:30Z', '-09:30', '0930', '09:30:', ''];
foreach ($malformed as string $text) {
    try {
        Core\Time\TimeOfDay::fromIso($text);
    } catch (ParseError $shape) {
        $refused = $refused + 1;
    }
}
echo $refused, " refused\n";

// 5. The first and the last time of the day, with all nine fraction digits.
echo Core\Time\TimeOfDay::fromIso('00:00:00.000000000')->format('HH:mm:ss.SSS'), "\n";
echo Core\Time\TimeOfDay::fromIso('23:59:59.999999999')->nanoseconds(), "\n";

// 6. Many bad texts in a loop. Every error is caught and freed.
uint $i = 0;
int $caught = 0;
while ($i < 100000) {
    try {
        Core\Time\TimeOfDay::fromIso((24 + $i % 76) as string . ':00');
    } catch (ParseError $tooLate) {
        $caught = $caught + 1;
    }
    $i = $i + 1;
}
echo $caught, " caught\n";

// 7. Many times are read in a loop. Every one is freed.
uint $total = 0;
uint $j = 0;
while ($j < 100000) {
    string $clock = '12:' . Core\Str::padStart(($j % 60) as string, 2, '0') . ':00.' . ($j as string);
    $total = $total + Core\Time\TimeOfDay::fromIso($clock)->minute();
    $j = $j + 1;
}
echo $total, "\n";
