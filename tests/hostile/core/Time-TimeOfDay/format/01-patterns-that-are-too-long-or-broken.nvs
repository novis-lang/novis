<?nvs
// Attack: `format` gets a very long pattern, broken patterns and patterns with date letters.
// The broken ones should throw a `LogicError`, and nothing should crash or leak.

Core\Time\TimeOfDay $t = Core\Time\TimeOfDay::at(23, 59, { second: 59, nanos: 999999999 });

// 1. A pattern of 100,000 letters is used.
string $long = '';
int $n = 0;
while ($n < 100000) {
    $long = $long . 'H';
    $n = $n + 1;
}
try {
    echo Core\Str::length($t->format($long)), "\n";
} catch (LogicError $e) {
    echo $e->message, "\n";
}

// 2. Patterns with an open quote, a date letter or a zone letter are used.
array<string> $broken = ["'HH:mm", 'HH:mm dd', 'HH:mm VV', 'HH:mm XXX', 'GGGG', 'SSSSSSSSSSSS'];
foreach ($broken as string $pattern) {
    try {
        echo $t->format($pattern), "\n";
    } catch (LogicError $e) {
        echo $e->message, "\n";
    }
}

// 3. The last nanosecond of the day is shown one million times. Each text is freed again.
uint $length = 0;
int $i = 0;
while ($i < 1000000) {
    $length = $length + Core\Str::length($t->format('HH:mm:ss.SSSSSSSSS'));
    $i = $i + 1;
}
echo $length, "\n";
