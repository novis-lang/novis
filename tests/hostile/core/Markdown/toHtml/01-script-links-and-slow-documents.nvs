<?nvs
// Attack: a user writes Markdown that tries to run a script in the page, and Markdown written to
// make the conversion slow. Every result should be free of scripts, and every document should
// be converted in a short time.

class Check
{
    // Prints `safe` when the HTML has no script element, no event attribute and no unsafe URL.
    // A URL in plain text is safe, so only the attribute values are checked.
    public static function report(string $label, Core\Html\Markup $html): void
    {
        string $text = Core\Str::lower(Core\Html::toSource($html, "the attack looks for a script in the HTML"));
        bool $unsafe = Core\Str::contains($text, '<script')
            || Core\Str::contains($text, '<iframe')
            || Core\Str::contains($text, '="javascript:')
            || Core\Str::contains($text, '="vbscript:')
            || Core\Str::contains($text, '="data:')
            || Core\Str::contains($text, ' onerror=')
            || Core\Str::contains($text, ' onclick=');
        echo $label, ': ', $unsafe ? 'UNSAFE' : 'safe', "\n";
    }
}

// 1. Links whose URL is a script, written in many ways that hide the word `javascript`.
array<string> $links = [
    "[a](javascript:alert(1))\n",
    "[a](JaVaScRiPt:alert(1))\n",
    "[a](javascript&#58;alert(1))\n",
    "[a](jav%61script:alert(1))\n",
    "[a](javasc\nript:alert(1))\n",
    "[a](%20javascript%3Aalert(1))\n",
    "[a][r]\n\n[r]: javascript%3Aalert%281%29\n",
    "<javascript:alert(1)>\n",
    "[a](vbscript:msgbox(1))\n",
    "![a](data:text/html,<script>alert(1)</script>)\n",
];
foreach ($links as string $doc) {
    Check::report('link', Core\Markdown::toHtml($doc));
}

// 2. HTML in the document that tries to run a script or load another page.
array<string> $raw = [
    "a <script>alert(1)</script> <iframe src=\"https://example.com\">\n",
    "<img src=x onerror=alert(1)>\n",
    "<div>\n<script\n\n<span src=\"/evil.js\">\n",
    "## x\"><script>alert(1)</script><a href=\"\n",
    "[^<script>alert(1)</script>]\n\n[^<script>alert(1)</script>]: x\n",
    "<a href=\"javascript:alert(1)\" onclick=\"alert(2)\">x</a>\n",
];
foreach ($raw as string $doc) {
    Check::report('html', Core\Markdown::toHtml($doc));
}

// 3. A callback returns a script URL for every link and image. It is checked like a URL in the document.
Check::report('callback', Core\Markdown::toHtml(
    "[a](/home) ![b](/cat.png)\n",
    link: fn (string $url): ?string => 'javascript:alert(1)',
    image: fn (string $url): ?string => 'data:text/html,x',
));

// 4. Documents of about 400 KB that are slow in other Markdown converters.
// Each one should be converted quickly, and the program should go on.
array<string> $slow = [
    Core\Str::repeat('[a', 100000),
    Core\Str::repeat('a]', 100000),
    Core\Str::repeat('*a_ ', 100000),
    Core\Str::repeat('*', 400000) . 'a',
    Core\Str::repeat('[', 200000) . Core\Str::repeat(']', 200000),
    Core\Str::repeat('`', 200000) . 'a' . Core\Str::repeat('`', 199999),
    Core\Str::repeat('![a](', 80000),
];
foreach ($slow as string $doc) {
    Core\Html\Markup $html = Core\Markdown::toHtml($doc);
    echo 'slow: ', Core\Str::length(Core\Html::toSource($html, "the attack prints the size of the HTML")), " characters\n";
}

// 5. Many uses of one long link reference. The HTML may grow only a little past the document.
string $blowup = '[x]: /' . Core\Str::repeat('u', 10000) . "\n\n" . Core\Str::repeat('[x] ', 50000);
Core\Html\Markup $big = Core\Markdown::toHtml($blowup);
echo 'document: ', Core\Str::length($blowup), " characters\n";
echo 'references: ', Core\Str::length(Core\Html::toSource($big, "the attack prints the size of the HTML")), " characters\n";
