<?nvs
// Attack: a program tries to open messages it forged. It changes one byte at
// every position, cuts the message at every length, and hands over ten
// thousand random buffers. Not one of them may open. The last step opens a
// sealed message of sixteen megabytes.

secret bytes $key = Core\Crypto::generateKey();
bytes $sealed = Core\Crypto::seal('pay 100 to Ada' as bytes, $key, Core\Crypto\Cipher::XChaCha20Poly1305);
int $length = Core\Bytes::length($sealed) as int;

// 1. One byte is changed at every position of the message, to every other
// value that byte can take. Each error is caught here.
uint $opened = 0;
int $at = 0;
while ($at < $length) {
    uint $original = Core\Bytes::at($sealed, $at);
    uint $value = 0;
    while ($value < 256) {
        if ($value != $original) {
            bytes $forged = Core\Bytes::join(
                [
                    Core\Bytes::slice($sealed, 0, $at),
                    Core\Bytes::fill(1, $value),
                    Core\Bytes::slice($sealed, $at + 1, $length - $at - 1),
                ],
                '' as bytes,
            );
            try {
                Core\Crypto::open($forged, $key, Core\Crypto\Cipher::XChaCha20Poly1305);
                $opened = $opened + 1;
            } catch (Throwable $e) {
            }
        }
        $value = $value + 1;
    }
    $at = $at + 1;
}
echo '1 changed messages that opened: ', $opened, "\n";

// 2. The message cut at every length, from nothing up to one byte short.
uint $shortOpened = 0;
int $cut = 0;
while ($cut < $length) {
    try {
        Core\Crypto::open(Core\Bytes::slice($sealed, 0, $cut), $key, Core\Crypto\Cipher::XChaCha20Poly1305);
        $shortOpened = $shortOpened + 1;
    } catch (Throwable $e) {
    }
    $cut = $cut + 1;
}
echo '2 cut messages that opened: ', $shortOpened, "\n";

// 3. Ten thousand random buffers of the right length, and the same buffers
// read under the other cipher.
uint $randomOpened = 0;
uint $i = 0;
while ($i < 10000) {
    bytes $noise = Core\Random::bytes(Core\Bytes::length($sealed));
    try {
        Core\Crypto::open($noise, $key, Core\Crypto\Cipher::XChaCha20Poly1305);
        $randomOpened = $randomOpened + 1;
    } catch (Throwable $e) {
    }
    try {
        Core\Crypto::open($noise, $key, Core\Crypto\Cipher::Aes256Gcm);
        $randomOpened = $randomOpened + 1;
    } catch (Throwable $e) {
    }
    $i = $i + 1;
}
echo '3 random buffers that opened: ', $randomOpened, "\n";

// 4. Keys of the wrong width. Each error is caught here.
array<uint> $widths = [0, 1, 31, 33];
foreach ($widths as uint $width) {
    try {
        Core\Crypto::open($sealed, Core\Bytes::fill($width, 65), Core\Crypto\Cipher::XChaCha20Poly1305);
        echo '4 opened under a key of ', $width, ' bytes', "\n";
    } catch (Throwable $e) {
        echo '4 refused a key of ', $width, ' bytes', "\n";
    }
}

// 5. A sealed message of sixteen megabytes, opened with one byte changed and
// then left alone. The plaintext and the sealed bytes are held at once.
bytes $bigSealed = Core\Crypto::seal(Core\Bytes::fill(16000000, 65), $key, Core\Crypto\Cipher::Aes256Gcm);
try {
    Core\Crypto::open(Core\Bytes::slice($bigSealed, 0, 15999999), $key, Core\Crypto\Cipher::Aes256Gcm);
    echo '5 a cut message of sixteen megabytes opened', "\n";
} catch (Throwable $e) {
    echo '5 refused a cut message of sixteen megabytes', "\n";
}
echo '5 opened ', Core\Bytes::length(Core\Crypto::open($bigSealed, $key, Core\Crypto\Cipher::Aes256Gcm)), ' bytes', "\n";
