<?nvs
// Attack: a class is given 40 attributes with the same fields as the attribute the
// program reads, but under another name. None of them is a match, so the result is
// `null`. The program should run to its last line and stay inside its memory limit.

repeatable attribute Near on class { a: int, b: string, c: int, d: bool }
attribute Hit on class { a: int, b: string, c: int, d: bool }
attribute Deep on class { l1: { l2: { l3: { l4: { l5: { l6: { l7: { l8: { l9: { l10: { l11: { l12: int } } } } } } } } } } } }
attribute DeepText on class { l1: { l2: { l3: { l4: { l5: { l6: { l7: { l8: { l9: { l10: { l11: { l12: string } } } } } } } } } } } }

// 1. 40 near misses. Each `Near` has the fields of `Hit`. The reads below read `Hit`,
//    so no payload matches and the result is `null`.
#[Near(a: 1, b: 'b1', c: 1, d: true), Near(a: 2, b: 'b2', c: 2, d: true), Near(a: 3, b: 'b3', c: 3, d: true), Near(a: 4, b: 'b4', c: 4, d: true)]
#[Near(a: 5, b: 'b5', c: 5, d: true), Near(a: 6, b: 'b6', c: 6, d: true), Near(a: 7, b: 'b7', c: 7, d: true), Near(a: 8, b: 'b8', c: 8, d: true)]
#[Near(a: 9, b: 'b9', c: 9, d: true), Near(a: 10, b: 'b10', c: 10, d: true), Near(a: 11, b: 'b11', c: 11, d: true), Near(a: 12, b: 'b12', c: 12, d: true)]
#[Near(a: 13, b: 'b13', c: 13, d: true), Near(a: 14, b: 'b14', c: 14, d: true), Near(a: 15, b: 'b15', c: 15, d: true), Near(a: 16, b: 'b16', c: 16, d: true)]
#[Near(a: 17, b: 'b17', c: 17, d: true), Near(a: 18, b: 'b18', c: 18, d: true), Near(a: 19, b: 'b19', c: 19, d: true), Near(a: 20, b: 'b20', c: 20, d: true)]
#[Near(a: 21, b: 'b21', c: 21, d: true), Near(a: 22, b: 'b22', c: 22, d: true), Near(a: 23, b: 'b23', c: 23, d: true), Near(a: 24, b: 'b24', c: 24, d: true)]
#[Near(a: 25, b: 'b25', c: 25, d: true), Near(a: 26, b: 'b26', c: 26, d: true), Near(a: 27, b: 'b27', c: 27, d: true), Near(a: 28, b: 'b28', c: 28, d: true)]
#[Near(a: 29, b: 'b29', c: 29, d: true), Near(a: 30, b: 'b30', c: 30, d: true), Near(a: 31, b: 'b31', c: 31, d: true), Near(a: 32, b: 'b32', c: 32, d: true)]
#[Near(a: 33, b: 'b33', c: 33, d: true), Near(a: 34, b: 'b34', c: 34, d: true), Near(a: 35, b: 'b35', c: 35, d: true), Near(a: 36, b: 'b36', c: 36, d: true)]
#[Near(a: 37, b: 'b37', c: 37, d: true), Near(a: 38, b: 'b38', c: 38, d: true), Near(a: 39, b: 'b39', c: 39, d: true), Near(a: 40, b: 'b40', c: 40, d: true)]
class AllMisses
{}

// 2. The same 40 near misses with one real match at the end. Exactly one result
//    comes back, and a second `Hit` would stop the program from compiling.
#[Near(a: 1, b: 'b1', c: 1, d: true), Near(a: 2, b: 'b2', c: 2, d: true), Near(a: 3, b: 'b3', c: 3, d: true), Near(a: 4, b: 'b4', c: 4, d: true)]
#[Near(a: 5, b: 'b5', c: 5, d: true), Near(a: 6, b: 'b6', c: 6, d: true), Near(a: 7, b: 'b7', c: 7, d: true), Near(a: 8, b: 'b8', c: 8, d: true)]
#[Near(a: 9, b: 'b9', c: 9, d: true), Near(a: 10, b: 'b10', c: 10, d: true), Near(a: 11, b: 'b11', c: 11, d: true), Near(a: 12, b: 'b12', c: 12, d: true)]
#[Near(a: 13, b: 'b13', c: 13, d: true), Near(a: 14, b: 'b14', c: 14, d: true), Near(a: 15, b: 'b15', c: 15, d: true), Near(a: 16, b: 'b16', c: 16, d: true)]
#[Near(a: 17, b: 'b17', c: 17, d: true), Near(a: 18, b: 'b18', c: 18, d: true), Near(a: 19, b: 'b19', c: 19, d: true), Near(a: 20, b: 'b20', c: 20, d: true)]
#[Near(a: 21, b: 'b21', c: 21, d: true), Near(a: 22, b: 'b22', c: 22, d: true), Near(a: 23, b: 'b23', c: 23, d: true), Near(a: 24, b: 'b24', c: 24, d: true)]
#[Near(a: 25, b: 'b25', c: 25, d: true), Near(a: 26, b: 'b26', c: 26, d: true), Near(a: 27, b: 'b27', c: 27, d: true), Near(a: 28, b: 'b28', c: 28, d: true)]
#[Near(a: 29, b: 'b29', c: 29, d: true), Near(a: 30, b: 'b30', c: 30, d: true), Near(a: 31, b: 'b31', c: 31, d: true), Near(a: 32, b: 'b32', c: 32, d: true)]
#[Near(a: 33, b: 'b33', c: 33, d: true), Near(a: 34, b: 'b34', c: 34, d: true), Near(a: 35, b: 'b35', c: 35, d: true), Near(a: 36, b: 'b36', c: 36, d: true)]
#[Near(a: 37, b: 'b37', c: 37, d: true), Near(a: 38, b: 'b38', c: 38, d: true), Near(a: 39, b: 'b39', c: 39, d: true), Near(a: 40, b: 'b40', c: 40, d: true)]
#[Hit(a: 99, b: 'b99', c: 99, d: true)]
class OneHit
{}

// 3. A payload nested twelve levels deep. The read below names another attribute
//    with the same nesting. Deep nesting can exhaust the stack.
#[Deep(l1: { l2: { l3: { l4: { l5: { l6: { l7: { l8: { l9: { l10: { l11: { l12: 7 } } } } } } } } } } })]
class Nested
{}

class Attack
{
    public static function run(uint $rounds): int
    {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // 4. 40 payloads are checked, and the result is `null`.
            var $missed = Core\Attributes::get<Hit>(AllMisses::constructor);
            if ($missed == null) {
                $total = $total + 1;
            }

            // 5. The same check over a list whose last entry matches.
            var $hit = Core\Attributes::get<Hit>(OneHit::constructor);
            if ($hit != null) {
                $total = $total + $hit->a;
            }

            // 6. The deep payload is a `Deep`. This reads `DeepText`, so the result is `null`.
            var $deep = Core\Attributes::get<DeepText>(Nested::constructor);
            if ($deep == null) {
                $total = $total + 1;
            }

            $i = $i + 1;
        }
        return $total;
    }
}

// 7. Every read above, run 200000 times. A program that kept a copy of each
//    result would grow until it reached its memory limit.
echo Attack::run(200000), "\n";
echo "still standing\n";
