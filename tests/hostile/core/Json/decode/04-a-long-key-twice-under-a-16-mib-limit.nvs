<?nvs
// Attack: a program lowers its memory limit to 16 MiB and decodes an object with one very long
// key written twice. The call should throw a `ParseError` with a short message.

// 1. Lowers the memory limit to `16M`.
echo 'limit lowered: ', Core\Config::set('limits.memory', '16M') ? 'yes' : 'no', "\n";

// 2. Builds a key of 2 MiB and a document of 4 MiB that has this key twice.
string $key = Core\Str::repeat('k', 2097152);
string $document = '{"' . $key . '":1,"' . $key . '":2}';

// 3. Decodes the document. This throws a `ParseError`, and its message is short.
try {
    Core\Json::decode($document);
    throw new RuntimeError('a repeated key was decoded');
} catch (ParseError $error) {
    echo Core\Str::length($error->message) < 1000 ? 'short message' : 'long message', "\n";
}
