<?nvs
// Attack: a program reads documents into a class that are nested very deep, very long, full of
// wrong fields, or not objects at all. Each call must return a value or throw an error, and must
// not crash.

#[Core\Json\Derive]
class Point
{
    public int $x;
    public string $label;

    public function constructor(int $x, string $label)
    {
        $this->x = $x;
        $this->label = $label;
    }
}

// 1. Arrays nested one hundred thousand levels deep, at the top and inside a field. The limit is
// 512 levels by default, so each call must throw a `ParseError`.
array<string> $deep = [
    Core\Str::repeat('[', 100000),
    "{\"x\":" . Core\Str::repeat('[', 100000),
];
foreach ($deep as string $tooDeep) {
    try {
        Core\Json::decodeAs<Point>($tooDeep);
        throw new LogicError('a document deeper than the limit was decoded');
    } catch (ParseError $refused) {
    }
}
echo 'step 1: done', "\n";

// 2. Texts that are not one JSON object: a number, a string, `null`, an array and broken text.
// Each call must throw a `ParseError`.
array<string> $notObjects = ['7', "\"x\"", 'null', "[{\"x\":1,\"label\":\"a\"}]", "{\"x\":1,"];
foreach ($notObjects as string $text) {
    try {
        Core\Json::decodeAs<Point>($text);
        throw new LogicError('a text that is not one object was decoded');
    } catch (ParseError $notAnObject) {
    }
}
echo 'step 2: done', "\n";

// 3. An object with the two right fields and one hundred thousand other keys. The same key is
// also written twice. The call must return a `Point` or throw a `ParseError`.
string $crowded = "{\"x\":1,\"label\":\"a\"" . Core\Str::repeat(",\"extra\":[1,2,3]", 100000) . '}';
array<string> $odd = [$crowded, "{\"x\":1,\"x\":\"two\",\"label\":\"a\"}"];
foreach ($odd as string $text) {
    try {
        Core\Json::decodeAs<Point>($text);
    } catch (ParseError $rejected) {
    }
}
echo 'step 3: done', "\n";

// 4. A list of one hundred thousand points must give one hundred thousand instances.
string $many = '[' . Core\Str::repeat("{\"x\":1,\"label\":\"p\"},", 99999) . "{\"x\":1,\"label\":\"p\"}]";
if (Core\Arr::count(Core\Json::decodeAs<array<Point>>($many)) != 100000) {
    throw new LogicError('the long list lost elements');
}
echo 'step 4: done', "\n";

// 5. A list of one hundred thousand wrong elements. The call must throw one `ParseError` and
// report only the first wrong element, so the error stays small.
string $wrong = '[' . Core\Str::repeat("{\"x\":\"no\"},", 99999) . "{\"x\":\"no\"}]";
try {
    Core\Json::decodeAs<array<Point>>($wrong);
    throw new LogicError('a list of wrong elements was decoded');
} catch (ParseError $bad) {
    if (Core\Arr::count($bad->issues) > 2) {
        throw new LogicError('the error reported more than the first element');
    }
}
echo 'step 5: done', "\n";

// 6. A `maxDepth` of 0 and one above 1024. Each call must throw a `LogicError`.
array<uint> $depths = [0, 1025];
foreach ($depths as uint $depth) {
    try {
        Core\Json::decodeAs<Point>("{\"x\":1,\"label\":\"a\"}", { maxDepth: $depth });
        throw new RuntimeError('a maxDepth outside 1 to 1024 was accepted');
    } catch (LogicError $outside) {
    }
}
echo 'step 6: done', "\n";

// 7. A list of one thousand points is read one thousand times. Only the count is kept, so the
// memory of each result must be freed.
string $medium = '[' . Core\Str::repeat("{\"x\":2,\"label\":\"q\"},", 999) . "{\"x\":2,\"label\":\"q\"}]";
uint $total = 0;
uint $i = 0;
while ($i < 1000) {
    $total = $total + Core\Arr::count(Core\Json::decodeAs<array<Point>>($medium));
    $i = $i + 1;
}
if ($total != 1000000) {
    throw new LogicError('a decode returned the wrong count');
}
echo 'step 7: done', "\n";
