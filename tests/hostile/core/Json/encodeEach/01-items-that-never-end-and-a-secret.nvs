<?nvs
// Attack: a program encodes a list that contains a secret, and a list that never ends.
// The secret should throw an error, and the CPU-time limit should stop the endless list.
// hostile: timeout-ms 30000
// hostile: ends-early 4 FATAL

#[Core\Json\Derive]
class Account
{
    public string $name;
    public secret string $password;

    public function constructor(string $name, secret string $password)
    {
        $this->name = $name;
        $this->password = $password;
    }
}

class Items
{
    // This generator gives two plain accounts, then one account whose password is a secret.
    public static function accounts(): Iterator<mixed>
    {
        yield ['name' => 'first'];
        yield ['name' => 'second'];
        yield new Account('third', 'hunter2');
    }

    // This generator gives the number 1 again and again. It has no end.
    public static function endless(): Iterator<int>
    {
        while (true) {
            yield 1;
        }
    }
}

// 1. Encodes the list with the secret. The error is caught, so the next step still runs.
uint $pieces = 0;
try {
    foreach (Core\Json::encodeEach(Items::accounts()) as tainted bytes $piece) {
        $pieces = $pieces + 1;
    }
    echo '1 the secret was encoded', "\n";
} catch (Throwable $error) {
    echo '1 the secret throws an error after ', $pieces, " pieces\n";
}

// 2. Reads ten pieces of the endless list, then stops the loop. Each piece is at most 64 KiB.
uint $read = 0;
uint $largest = 0;
foreach (Core\Json::encodeEach(Items::endless(), { lines: true }) as tainted bytes $piece) {
    if (Core\Bytes::length($piece) > $largest) {
        $largest = Core\Bytes::length($piece);
    }
    $read = $read + 1;
    if ($read == 10) {
        break;
    }
}
echo '2 pieces read: ', $read, ', largest piece at most 64 KiB: ', $largest <= 65536 ? 'yes' : 'no', "\n";

// 3. Lowers the CPU-time limit to 1 second. The limit counts from the start of the program.
echo 'limit lowered: ', Core\Config::set('limits.cpu_time', '1s') ? 'yes' : 'no', "\n";

// 4. Reads every piece of the endless list. The CPU-time limit stops the program here.
echo "step 4\n";
uint $total = 0;
foreach (Core\Json::encodeEach(Items::endless()) as tainted bytes $piece) {
    $total = $total + Core\Bytes::length($piece);
}
echo '4 the endless list ended after ', $total, " bytes\n";
