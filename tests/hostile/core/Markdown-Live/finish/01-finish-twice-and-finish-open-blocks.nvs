<?nvs
// Attack: a program finishes a text twice, finishes texts that end in the middle of a block, and
// finishes a text with many footnotes. Each late call should throw an error, and the HTML should be
// the same as converting the whole text at once.

class Check
{
    // Prints whether the pieces, converted while they arrive, give the HTML of the whole text.
    public static function same(string $name, array<string> $pieces): void
    {
        Core\Markdown\Live $live = Core\Markdown::live();
        Core\Html\Markup $page = '' as Core\Html\Markup;
        foreach ($pieces as string $piece) {
            $page = $page + $live->push($piece)->done();
        }
        $page = $page + $live->finish();
        string $whole = Core\Html::toSource(Core\Markdown::toHtml(Core\Str::join($pieces, '')), 'the attack compares the HTML');
        echo $name, ': ', Core\Html::toSource($page, 'the attack compares the HTML') == $whole ? 'same' : 'different', "\n";
    }
}

// 1. `finish` with no text at all. This returns empty HTML.
Core\Markdown\Live $empty = Core\Markdown::live();
echo 'empty: [', $empty->finish(), "]\n";

// 2. A second `finish` and a `push` after `finish`. Each throws a `RuntimeError`, which is caught.
try {
    $empty->finish();
    echo "second finish: accepted\n";
} catch (RuntimeError $e) {
    echo "second finish: closed\n";
}
try {
    $empty->push("late text\n");
    echo "push after finish: accepted\n";
} catch (RuntimeError $e) {
    echo "push after finish: closed\n";
}

// 3. Texts that end inside a code block, a list, an HTML tag, a table and a `**` that is never closed.
Check::same('open code block', ["```php\necho 1;\n", "echo 2;"]);
Check::same('open list', ["- one\n- tw", "o\n  - three"]);
Check::same('open tag', ["<div>\n\nText", " inside <b>bold"]);
Check::same('open table', ["| a | b |\n|---|", "---|\n| 1 |"]);
Check::same('open bold', ["Some **bold", " text"]);

// 4. Five thousand footnotes, each defined before it is used. `finish` writes all of them at the end.
string $notes = '';
string $text = '';
uint $i = 0;
while ($i < 5000) {
    $notes = $notes . "[^n" . $i . "]: Note " . $i . ".\n\n";
    $text = $text . "Fact " . $i . ".[^n" . $i . "]\n\n";
    $i = $i + 1;
}
Check::same('many footnotes', [$notes, $text]);

// 5. A text with a link that has no address, finished without its definition. The link is plain text.
Core\Markdown\Live $missing = Core\Markdown::live();
$missing->push("See [the guide].");
echo 'missing address: ', $missing->finish();
