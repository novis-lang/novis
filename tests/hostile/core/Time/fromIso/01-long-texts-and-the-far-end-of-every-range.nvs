<?nvs
// Attack: `Core\Time::fromIso` gets very long texts, texts at the far end of every range, and many bad texts.
// Each bad text should throw a `ParseError`, and nothing should crash or leak.

int $refused = 0;

// 1. A valid timestamp with one million digits after the decimal point.
string $digits = Core\Str::repeat('9', 1000000);
try { Core\Time::fromIso('2024-06-01T09:30:00.' . $digits . 'Z'); } catch (ParseError $fraction) { $refused = $refused + 1; }

// 2. One million digits as the year, and ten million bytes of text that is not a date.
try { Core\Time::fromIso($digits . '-06-01T09:30:00Z'); } catch (ParseError $year) { $refused = $refused + 1; }
try { Core\Time::fromIso(Core\Str::repeat('T', 10000000)); } catch (ParseError $junk) { $refused = $refused + 1; }

// 3. The first second past each end of the timestamp range, and a year past 9999.
try { Core\Time::fromIso('9999-12-30T22:00:01Z'); } catch (ParseError $high) { $refused = $refused + 1; }
try { Core\Time::fromIso('-009999-01-02T01:59:58Z'); } catch (ParseError $low) { $refused = $refused + 1; }
try { Core\Time::fromIso('+010000-01-01T00:00:00Z'); } catch (ParseError $yearHigh) { $refused = $refused + 1; }

// 4. Offsets too large, and an empty text.
try { Core\Time::fromIso('2024-06-01T09:30:00+99:00'); } catch (ParseError $offsetHigh) { $refused = $refused + 1; }
try { Core\Time::fromIso('2024-06-01T09:30:00-99:99'); } catch (ParseError $offsetLow) { $refused = $refused + 1; }
try { Core\Time::fromIso(''); } catch (ParseError $empty) { $refused = $refused + 1; }
echo $refused, " refused\n";

// 5. The last second at each end of the range, with the largest offsets.
echo Core\Time::fromIso('9999-12-30T22:00:00Z')->toIso(), "\n";
echo Core\Time::fromIso('-009999-01-02T01:59:59Z')->toIso(), "\n";
echo Core\Time::fromIso('2024-06-01T09:30:00+25:59')->toIso(), "\n";
echo Core\Time::fromIso('2024-06-01T09:30:00-25:59')->toIso(), "\n";

// 6. Many bad texts in a loop. Every error is caught and freed.
uint $i = 0;
int $caught = 0;
while ($i < 100000) {
    try {
        Core\Time::fromIso('2024-06-01T09:30:' . ($i % 100) as string);
    } catch (ParseError $noOffset) {
        $caught = $caught + 1;
    }
    $i = $i + 1;
}
echo $caught, " caught\n";

// 7. Many instants are read in a loop. Every one is freed.
int $total = 0;
uint $j = 0;
while ($j < 100000) {
    string $text = '2024-06-01T09:30:' . Core\Str::padStart(($j % 60) as string, 2, '0') . '.' . ($j as string) . '+02:00';
    $total = $total + Core\Time::fromIso($text)->toEpochSeconds() % 1000;
    $j = $j + 1;
}
echo $total, "\n";
