<?nvs
// Attack: `Core\Time::parse` gets very long patterns, broken quotes, huge numbers and times past both ends of the range.
// Each bad pattern should throw a `LogicError`, each bad text a `ParseError`, and nothing should crash or leak.

var $utc = Core\Time\Zone::of('UTC');
int $badPattern = 0;
int $badText = 0;

// 1. One pattern that repeats every date and time letter a thousand times.
array<string> $letters = ['G', 'y', 'u', 'Q', 'w', 'W', 'F', 'E', 'M', 'L', 'd', 'D', 'a', 'h', 'H', 'k', 'K', 'm', 's', 'S', 'A', 'g', 'B', 'b', 'e', 'c'];
string $everyLetter = '';
foreach ($letters as string $letter) {
    $everyLetter = $everyLetter . Core\Str::repeat($letter, 1000) . ' ';
}
try { Core\Time::parse('2024-06-05', $everyLetter, $utc); } catch (LogicError $letterPattern) { $badPattern = $badPattern + 1; } catch (ParseError $letterText) { $badText = $badText + 1; }

// 2. Quotes that never close, and one million quoted characters.
try { Core\Time::parse('2024', "yyyy '" . Core\Str::repeat('x', 1000000), $utc); } catch (LogicError $open) { $badPattern = $badPattern + 1; }
try { Core\Time::parse('2024', Core\Str::repeat("'", 1000001), $utc); } catch (LogicError $odd) { $badPattern = $badPattern + 1; } catch (ParseError $oddText) { $badText = $badText + 1; }
try { Core\Time::parse('2024', "'" . Core\Str::repeat('x', 1000000) . "'yyyy", $utc); } catch (ParseError $longLiteral) { $badText = $badText + 1; }

// 3. A year field one million letters wide, with one million digits of text.
string $digits = Core\Str::repeat('9', 1000000);
try { Core\Time::parse($digits, Core\Str::repeat('y', 1000000), $utc); } catch (ParseError $hugeYear) { $badText = $badText + 1; }
try { Core\Time::parse('2024-06-05 12:00:00.' . $digits, 'yyyy-MM-dd HH:mm:ss.' . Core\Str::repeat('S', 1000000), $utc); } catch (ParseError $hugeFraction) { $badText = $badText + 1; }
try { Core\Time::parse($digits, 'g', $utc); } catch (ParseError $hugeJulian) { $badText = $badText + 1; }

// 4. Ten million bytes of text, and a pattern that names a time zone.
try { Core\Time::parse(Core\Str::repeat('é', 5000000), 'yyyy-MM-dd', $utc); } catch (ParseError $junk) { $badText = $badText + 1; }
try { Core\Time::parse('2024-06-05 UTC', 'yyyy-MM-dd ' . Core\Str::repeat('V', 2), $utc); } catch (LogicError $zonal) { $badPattern = $badPattern + 1; }
echo $badPattern, ' bad patterns, ', $badText, " bad texts\n";

// 5. The first minute past each end of the range. The message names the range.
int $plain = 0;
array<string> $past = ['9999-12-30 22:01', '9999-12-31 23:59', '-9999-01-01 00:00', '-9999-01-02 01:59'];
foreach ($past as string $pastText) {
    try {
        Core\Time::parse($pastText,'uuuu-MM-dd HH:mm', $utc);
    } catch (ParseError $outside) {
        if (Core\Str::startsWith($outside->message, "Core\\Time::parse(): the time is outside ")) {
            $plain = $plain + 1;
        }
    }
}
echo $plain, " of 4 name the range\n";
echo Core\Time::parse('9999-12-30 22:00', 'uuuu-MM-dd HH:mm', $utc)->format('uuuu-MM-dd HH:mm XXX'), "\n";

// 6. Many bad texts in a loop. Every error is caught and freed.
uint $i = 0;
int $caught = 0;
while ($i < 100000) {
    try {
        Core\Time::parse('2024-06-05 ' . ($i % 100) as string, 'yyyy-MM-dd HH:mm', $utc);
    } catch (ParseError $short) {
        $caught = $caught + 1;
    }
    $i = $i + 1;
}
echo $caught, " caught\n";

// 7. Many times are read in a loop. Every one is freed.
var $berlin = Core\Time\Zone::of('Europe/Berlin');
int $total = 0;
uint $j = 0;
while ($j < 100000) {
    string $text = '2024-03-31 0' . ($j % 4) as string . ':' . Core\Str::padStart(($j % 60) as string, 2, '0');
    $total = $total + Core\Time::parse($text, 'yyyy-MM-dd HH:mm', $berlin)->toInstant()->toEpochSeconds() % 1000;
    $j = $j + 1;
}
echo $total, "\n";
