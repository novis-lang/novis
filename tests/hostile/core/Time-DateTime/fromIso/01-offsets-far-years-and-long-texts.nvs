<?nvs
// Attack: `Core\Time\DateTime::fromIso` gets texts with an offset, years past both ends of the range and very long texts.
// Each bad text should throw a `ParseError`, and nothing should crash or leak.

var $berlin = Core\Time\Zone::of('Europe/Berlin');
int $refused = 0;

// 1. Texts with `Z` or an offset. Each text is in a variable, so it is read when the program runs.
array<string> $offsets = ['2024-06-01T09:30:00Z', '2024-06-01 09:30+02:00', '2024-06-01T09:30:00.5-05:00', '2024-06-01Z', '2024-06-01T09:30+99:99'];
foreach ($offsets as string $offset) {
    try {
        Core\Time\DateTime::fromIso($offset, $berlin);
    } catch (ParseError $offsetError) {
        $refused = $refused + 1;
    }
}

// 2. Years past each end of the range, and years with too many digits.
array<string> $years = ['9999-12-31 23:59', '-9999-01-01', '+010000-01-01', '99999-01-01', '-009999-01-01T00:00'];
foreach ($years as string $year) {
    try {
        Core\Time\DateTime::fromIso($year, $berlin);
    } catch (ParseError $yearError) {
        $refused = $refused + 1;
    }
}

// 3. One million digits after the decimal point, then one million digits as the year.
string $digits = Core\Str::repeat('9', 1000000);
try {
    Core\Time\DateTime::fromIso('2024-06-01T09:30:00.' . $digits, $berlin);
} catch (ParseError $fraction) {
    $refused = $refused + 1;
}
try {
    Core\Time\DateTime::fromIso($digits . '-06-01', $berlin);
} catch (ParseError $longYear) {
    $refused = $refused + 1;
}

// 4. Ten million bytes that are not a date, a valid date with a long tail, and an empty text.
try {
    Core\Time\DateTime::fromIso(Core\Str::repeat('T', 10000000), $berlin);
} catch (ParseError $junk) {
    $refused = $refused + 1;
}
try {
    Core\Time\DateTime::fromIso('2024-06-01 09:30' . Core\Str::repeat(' ', 1000000), $berlin);
} catch (ParseError $tail) {
    $refused = $refused + 1;
}
string $empty = '';
try {
    Core\Time\DateTime::fromIso($empty, $berlin);
} catch (ParseError $emptyError) {
    $refused = $refused + 1;
}
echo $refused, " refused\n";

// 5. Many texts with an offset in a loop. Every error is caught and freed.
uint $i = 0;
int $caught = 0;
while ($i < 100000) {
    try {
        Core\Time\DateTime::fromIso('2024-06-01T09:30:00+0' . ($i % 10) as string . ':00', $berlin);
    } catch (ParseError $loopError) {
        $caught = $caught + 1;
    }
    $i = $i + 1;
}
echo $caught, " caught\n";

// 6. Many local times are read in a loop, some in the hour the clocks skip. Every one is freed.
int $total = 0;
uint $j = 0;
while ($j < 100000) {
    string $text = '2024-03-31 0' . ($j % 4) as string . ':' . Core\Str::padStart(($j % 60) as string, 2, '0');
    $total = $total + Core\Time\DateTime::fromIso($text, $berlin)->toInstant()->toEpochSeconds() % 1000;
    $j = $j + 1;
}
echo $total, "\n";
