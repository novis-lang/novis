<?nvs
// Attack: `Core\Time\DateTime::at` gets parts with the largest values they can have, and many dates are built in a loop.
// Each bad call should throw a `RuntimeError`, and the loop should finish without a leak.

use Core\Time\Date;
use Core\Time\DateTime;
use Core\Time\TimeOfDay;

var $utc = Core\Time\Zone::UTC;
var $midnight = TimeOfDay::at(0, 0);
var $newYear = Date::at(2024, 1, 1);
int $refused = 0;

// 1. The largest and smallest whole numbers as the year.
try {
    DateTime::at(Date::at(9223372036854775807, 1, 1), $midnight, $utc);
} catch (RuntimeError $yearHigh) {
    $refused = $refused + 1;
}
try {
    DateTime::at(Date::at(-9223372036854775807, 1, 1), $midnight, $utc);
} catch (RuntimeError $yearLow) {
    $refused = $refused + 1;
}

// 2. The largest unsigned whole number in each of the other parts.
try {
    DateTime::at(Date::at(2024, 18446744073709551615, 1), $midnight, $utc);
} catch (RuntimeError $month) {
    $refused = $refused + 1;
}
try {
    DateTime::at(Date::at(2024, 1, 18446744073709551615), $midnight, $utc);
} catch (RuntimeError $day) {
    $refused = $refused + 1;
}
try {
    DateTime::at($newYear, TimeOfDay::at(18446744073709551615, 0), $utc);
} catch (RuntimeError $hour) {
    $refused = $refused + 1;
}
try {
    DateTime::at($newYear, TimeOfDay::at(0, 18446744073709551615), $utc);
} catch (RuntimeError $minute) {
    $refused = $refused + 1;
}
try {
    DateTime::at($newYear, TimeOfDay::at(0, 0, { second: 18446744073709551615 }), $utc);
} catch (RuntimeError $second) {
    $refused = $refused + 1;
}
try {
    DateTime::at($newYear, TimeOfDay::at(0, 0, { nanos: 18446744073709551615 }), $utc);
} catch (RuntimeError $nanos) {
    $refused = $refused + 1;
}

// 3. The last moment of year 9999 in the zone furthest east, and the first day of year -9999 in the zone furthest west.
try {
    DateTime::at(Date::at(9999, 12, 31), TimeOfDay::at(23, 59, { second: 59, nanos: 999999999 }), 'Pacific/Kiritimati');
} catch (RuntimeError $east) {
    $refused = $refused + 1;
}
try {
    DateTime::at(Date::at(-9999, 1, 1), $midnight, 'Etc/GMT+12');
} catch (RuntimeError $west) {
    $refused = $refused + 1;
}
echo $refused, " refused\n";

// 4. Many dates are built on a morning when the clocks jump forward. Every one is freed.
int $seconds = 0;
uint $i = 0;
while ($i < 200000) {
    $seconds = $seconds + DateTime::at(Date::at(2024, 3, 31), TimeOfDay::at(2, $i % 60), 'Europe/Berlin')->toInstant()->toEpochSeconds() % 3600;
    $i = $i + 1;
}
echo $seconds, "\n";
