<?nvs
// Attack: `daysInMonth` is read for every month of 400 years, and at both ends of the range in the widest offsets.
// The days should add up to the calendar's 146,097 days, and nothing should crash or leak.

// 1. Every month from 2000 to 2399. 400 years of the calendar have 146,097 days.
var $month = Core\Time\DateTime::fromIso('2000-01-15', 'UTC');
uint $days = 0;
int $i = 0;
while ($i < 4800) {
    $days = $days + $month->plus($i, Core\Unit::Month)->daysInMonth();
    $i = $i + 1;
}
echo $days, " days\n";

// 2. The first and the last moment of the range, in three zones. Each month is January or December.
// This prints 31 six times.
var $first = Core\Time\Instant::fromIso('-9999-01-02T01:59:59Z');
var $last = Core\Time\Instant::fromIso('9999-12-30T22:00:00Z');
array<Core\Time\Zone> $zones = [Core\Time\Zone::UTC, Core\Time\Zone::fixed(25h59m59s), Core\Time\Zone::fixed(25h59m59s->negated())];
foreach ($zones as Core\Time\Zone $zone) {
    echo $first->in($zone)->daysInMonth(), ' ', $last->in($zone)->daysInMonth(), "\n";
}

// 3. One moment on the last evening of February 2024 is read in 200 offsets.
// West of UTC it is still February, and far east it is already March.
var $evening = Core\Time\Instant::fromIso('2024-02-29T20:00:00Z');
int $february = 0;
int $march = 0;
int $minutes = -1500;
while ($minutes < 1500) {
    uint $n = $evening->in(Core\Time\Zone::fixed(Core\Time\Duration::minutes($minutes)))->daysInMonth();
    if ($n == 29) {
        $february = $february + 1;
    } else if ($n == 31) {
        $march = $march + 1;
    }
    $minutes = $minutes + 15;
}
echo $february, ' in February, ', $march, " in March\n";
