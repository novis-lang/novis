<?nvs
// Attack: `plus` gets the longest durations there are, again and again, until the result is
// after the last instant. Steps 1 and 2 should throw a `RuntimeError`, and nothing should crash or leak.

Core\Time\Duration $longest = Core\Time\Duration::nanoseconds(9223372036854775807);
Core\Time\Duration $mostNegative = Core\Time\Duration::nanoseconds(-9223372036854775807 - 1);
Core\Time\Instant $first = Core\Time::fromIso('-009999-01-02T01:59:59Z');

// 1. The longest duration is added until the result is after the year 9999.
Core\Time\Instant $at = $first;
int $steps = 0;
try {
    while ($steps < 1000) {
        $at = $at->plus($longest);
        $steps = $steps + 1;
    }
} catch (RuntimeError $e) {
    echo $steps, ' steps: ', $e->message, "\n";
}

// 2. The most negative duration moves the first instant back, before the start of the range.
try {
    echo $first->plus($mostNegative)->toIso(), "\n";
} catch (RuntimeError $e) {
    echo $e->message, "\n";
}

// 3. One million new instants are made. Each one is freed again.
Core\Time\Instant $clock = Core\Time::fromEpoch(0);
int $round = 0;
while ($round < 1000000) {
    $clock = $clock->plus(Core\Time\Duration::nanoseconds(($round % 3 - 1) * 9223372036));
    $round = $round + 1;
}
echo $clock->toIso(), "\n";
