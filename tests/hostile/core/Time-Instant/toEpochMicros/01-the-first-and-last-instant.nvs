<?nvs
// Attack: the microseconds of the first and the last instant are read. These are the largest
// numbers the method can return. It should return them and not crash or leak.

// 1. The first and the last instant give the smallest and the largest number.
Core\Time\Instant $first = Core\Time::fromIso('-009999-01-02T01:59:59Z');
Core\Time\Instant $last = Core\Time::fromIso('9999-12-30T22:00:00.999999999Z');
echo $first->toEpochMicros(), ' ', $last->toEpochMicros(), "\n";

// 2. The largest number is multiplied by 1000, as a program does to get nanoseconds.
// That does not fit in an `int`, so this step should throw an error.
try {
    echo $last->toEpochMicros() * 1000, "\n";
} catch (ArithmeticError $e) {
    echo $e->message, "\n";
}

// 3. One million instants near the first one are made and read. Each one is freed again.
int $sum = 0;
int $round = 0;
while ($round < 1000000) {
    $sum = $sum + $first->plus(Core\Time\Duration::nanoseconds($round * 7919))->toEpochMicros() % 7;
    $round = $round + 1;
}
echo $sum, "\n";
