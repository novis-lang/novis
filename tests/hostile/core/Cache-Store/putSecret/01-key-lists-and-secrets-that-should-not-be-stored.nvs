<?nvs
// Attack: a request stores secrets with key lists, names and lifetimes that
// should not work. Every write should either work or stop with an error, and
// the program must keep running.
// hostile: timeout-ms 60000

var $cache = Core\Cache::local();
secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];
secret string $token = 'sk-8f2c41';

// 1. An empty key list. There is no key to seal with, so the write must stop
//    with an error.
try {
    array<secret bytes> $empty = [];
    $cache->putSecret('empty-list', $token, 1h, $empty);
    echo "step 1 stored a secret with no key\n";
} catch (Throwable $e) {
    echo "step 1 stopped\n";
}

// 2. A key list holding seven bytes of text. That is too short to be a key, so
//    the write must stop with an error.
try {
    array<secret bytes> $short = ['raw-key' as bytes];
    $cache->putSecret('short-key', $token, 1h, $short);
    echo "step 2 stored a secret under seven bytes\n";
} catch (Throwable $e) {
    echo "step 2 stopped\n";
}

// 3. A key list of ten thousand keys. Only the first one seals, so the write
//    must not walk the whole list.
try {
    array<secret bytes> $many = [];
    uint $made = 0;
    while ($made < 10000) {
        $many = Core\Arr::append($many, Core\Crypto::generateKey());
        $made = $made + 1;
    }
    $cache->putSecret('many-keys', $token, 1h, $many);
    var $back = $cache->getSecret('many-keys', $many) ?? 'absent';
    echo 'step 3 answered ', $back == $token ? 'the secret' : 'a miss', "\n";
} catch (Throwable $e) {
    echo "step 3 stopped\n";
}

// 4. A name of one million characters. The store may keep the entry or forget
//    it as too large, and must answer for the name either way.
try {
    string $long = Core\Str::repeat('k', 1000000);
    $cache->putSecret($long, $token, 1h, $keys);
    var $held = $cache->getSecret($long, $keys);
    echo 'step 4 answered ', $held == null ? 'a miss' : 'the secret', "\n";
} catch (Throwable $e) {
    echo "step 4 stopped\n";
}

// 5. A secret of ten million characters. Sealing it copies it, so the write
//    must either work or stop at the memory limit.
try {
    secret string $huge = Core\Str::repeat('x', 10000000);
    $cache->putSecret('huge', $huge, 1h, $keys);
    var $stored = $cache->getSecret('huge', $keys);
    echo 'step 5 answered ', $stored == null ? 'a miss' : 'the secret', "\n";
} catch (Throwable $e) {
    echo "step 5 stopped\n";
}

// 6. A lifetime of zero. The entry is already over, so the read after it must
//    be a miss.
$cache->putSecret('already-old', $token, 0s, $keys);
echo 'step 6 left ', $cache->getSecret('already-old', $keys) == null ? 'a miss' : 'the secret', "\n";

// 7. One name written one hundred thousand times. A rewrite must cost the room
//    of one entry, so the store must still answer afterwards.
uint $i = 0;
while ($i < 100000) {
    $cache->putSecret('one-name', $token, 1h, $keys);
    $i = $i + 1;
}
$cache->putSecret('after', $token, 1h, $keys);
echo 'step 7 then wrote and read ',
    ($cache->getSecret('after', $keys) ?? '') == $token ? 'the secret' : 'a miss', "\n";
