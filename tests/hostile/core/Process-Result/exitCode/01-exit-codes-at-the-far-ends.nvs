<?nvs
// Attack: programs end with the largest, the smallest and out-of-range exit codes, and one
// result is read many times. Each exit code should be a number. The runtime must not crash.

class Attack
{
    // Runs a shell command: `/bin/sh` on Linux and macOS, `cmd.exe` on Windows.
    public static function shell(string $unix, string $windows): Core\Process\Result
    {
        if (Core\Path::SEPARATOR == "\\") {
            return Core\Process::run("C:\\Windows\\System32\\cmd.exe", ['/c', $windows]);
        }
        return Core\Process::run('/bin/sh', ['-c', $unix]);
    }
}

// 1. The largest and the smallest exit codes each platform can report, and one past each end.
array<array<string>> $cases = [
    ['exit 255', 'exit 2147483647'],
    ['exit 256', 'exit 4294967295'],
    ['exit 0', 'exit -2147483648'],
    ['exit -1', 'exit -1'],
    ['exit 99999999999999999999', 'exit 99999999999999999999'],
];
foreach ($cases as array<string> $case) {
    echo $case[0], ' / ', $case[1], ': ', Attack::shell($case[0], $case[1])->exitCode(), "\n";
}

// 2. A program that a signal or `kill()` stopped. On Linux and macOS the exit code is `-1`.
var $stopped = Core\Path::SEPARATOR == "\\"
    ? Core\Process::spawn("C:\\Windows\\System32\\cmd.exe", ['/c', 'ping -n 60 127.0.0.1 >nul'])
    : Core\Process::spawn('/bin/sh', ['-c', 'exec sleep 60']);
$stopped->kill();
echo 'stopped: ', $stopped->wait()->exitCode(), "\n";

// 3. A program that stops itself with a signal. Windows has no signals, so it ends with `9`.
echo 'signal: ', Attack::shell('kill -9 $$', 'exit 9')->exitCode(), "\n";

// 4. One result is read 100000 times. Every read should return the same number.
var $result = Attack::shell('exit 3', 'exit 3');
int $reads = 0;
int $different = 0;
while ($reads < 100000) {
    if ($result->exitCode() != 3) {
        $different = $different + 1;
    }
    $reads = $reads + 1;
}
echo $reads, ' reads, ', $different, " different\n";

echo "the runtime is still standing\n";
