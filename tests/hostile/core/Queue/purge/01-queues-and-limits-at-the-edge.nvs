<?nvs
// Attack: the program purges a queue it may not purge, running jobs, huge limits, huge tags
// and broken rows. Each call should return a count or throw an error. The program must not crash.
use Core\Queue;
use Core\Queue\State;

var $db = Core\Db::connect('jobs');
var $jobs = <<<'SQL'
create table nvs_jobs (id integer primary key autoincrement, queue varchar(255) not null,
    script text not null, args text, state smallint not null, attempts integer not null,
    max_attempts integer not null, backoff_ms bigint not null, run_at bigint not null,
    tag varchar(255), dedupe_key varchar(255), dedupe_pending varchar(255),
    created_at bigint not null, claimed_at bigint, errors text, grants text, limits text,
    constraint nvs_jobs_dedupe unique (dedupe_pending))
SQL;
var $dead = <<<'SQL'
create table nvs_dead_jobs (id bigint not null, queue varchar(255) not null,
    script text not null, args text, attempts integer not null, max_attempts integer not null,
    backoff_ms bigint not null, run_at bigint not null, tag varchar(255),
    dedupe_key varchar(255), created_at bigint not null, failed_at bigint not null,
    errors text not null, primary key (id))
SQL;
$db->execute($jobs, []);
$db->execute($dead, []);

// 1. The name of the queue is built while the program runs, and the program may not purge it.
string $other = Core\Str::repeat('other', 1);
Queue::push('jobs/a.nvs', { queue: $other });
try {
    echo '1: ', Queue::purge($other, { state: State::Pending }), "\n";
} catch (Throwable $e) {
    echo "1: error\n";
}

// 2. The state is `Claimed`, and a worker is running those jobs.
try {
    echo '2: ', Queue::purge('q', { state: State::Claimed }), "\n";
} catch (Throwable $e) {
    echo "2: error\n";
}

// 3. The limit is 0, and then the largest `uint`.
Queue::push('jobs/a.nvs', { queue: 'q' });
uint $largest = 9223372036854775807;
$largest = $largest * 2 + 1;
try {
    echo '3: ', Queue::purge('q', { state: State::Pending, limit: 0 }), "\n";
} catch (Throwable $e) {
    echo "3: error\n";
}
try {
    echo '3: ', Queue::purge('q', { state: State::Pending, limit: $largest }), "\n";
} catch (Throwable $e) {
    echo "3: error\n";
}

// 4. The tag is one million characters long.
try {
    echo '4: ', Queue::purge('q', { tag: Core\Str::repeat('t', 1000000) }), "\n";
} catch (Throwable $e) {
    echo "4: error\n";
}

// 5. The time is far in the future, and then far in the past.
try {
    var $late = Core\Time::fromIso('9999-12-31T23:59:59Z');
    echo '5: ', Queue::purge('q', { state: State::Pending, before: $late }), "\n";
} catch (Throwable $e) {
    echo "5: error\n";
}
try {
    var $early = Core\Time::fromIso('0001-01-01T00:00:00Z');
    echo '5: ', Queue::purge('q', { state: State::Pending, before: $early }), "\n";
} catch (Throwable $e) {
    echo "5: error\n";
}

// 6. A row says a worker is running the job, and another has text in its state column.
Queue::push('jobs/a.nvs', { queue: 'q' });
Queue::push('jobs/a.nvs', { queue: 'q' });
$db->execute("update nvs_jobs set state = 1 where queue = 'q'", []);
$db->execute("update nvs_jobs set state = 'lost' where id = (select max(id) from nvs_jobs)", []);
try {
    echo '6: ', Queue::purge('q', { state: State::Pending }), ' ', Queue::purge('q'), "\n";
} catch (Throwable $e) {
    echo "6: error\n";
}

// 7. 5000 jobs are added, and then deleted 1000 at a time.
int $i = 0;
while ($i < 5000) {
    Queue::push('jobs/a.nvs', { queue: 'q', args: ['n' => $i] });
    $i = $i + 1;
}
uint $total = 0;
uint $deleted = Queue::purge('q', { state: State::Pending });
while ($deleted > 0) {
    $total = $total + $deleted;
    $deleted = Queue::purge('q', { state: State::Pending });
}
echo '7: ', $total, "\n";

// 8. The tables are gone, and `purge` is called 20000 times.
$db->execute('drop table nvs_jobs', []);
$db->execute('drop table nvs_dead_jobs', []);
int $errors = 0;
$i = 0;
while ($i < 20000) {
    try {
        Queue::purge('q');
    } catch (Throwable $e) {
        $errors = $errors + 1;
    }
    $i = $i + 1;
}
echo '8: ', $errors, "\n";
