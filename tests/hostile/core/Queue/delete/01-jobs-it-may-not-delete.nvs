<?nvs
// Attack: the program deletes jobs it may not delete, a running job, and changed rows.
// Each call should return `false` or throw an error. The program must not crash.
// It sends about 25000 statements to the database, so it may run for up to 30 seconds.
// hostile: timeout-ms 30000
use Core\Queue;

var $db = Core\Db::connect('jobs');
var $jobs = <<<'SQL'
create table nvs_jobs (id integer primary key autoincrement, queue varchar(255) not null,
    script text not null, args text, state smallint not null, attempts integer not null,
    max_attempts integer not null, backoff_ms bigint not null, run_at bigint not null,
    tag varchar(255), dedupe_key varchar(255), dedupe_pending varchar(255),
    created_at bigint not null, claimed_at bigint, errors text, grants text, limits text,
    constraint nvs_jobs_dedupe unique (dedupe_pending))
SQL;
var $dead = <<<'SQL'
create table nvs_dead_jobs (id bigint not null, queue varchar(255) not null,
    script text not null, args text, attempts integer not null, max_attempts integer not null,
    backoff_ms bigint not null, run_at bigint not null, tag varchar(255),
    dedupe_key varchar(255), created_at bigint not null, failed_at bigint not null,
    errors text not null, primary key (id))
SQL;
$db->execute($jobs, []);
$db->execute($dead, []);

// 1. The job is in the queue `other`, and the program may only delete from `q`.
var $other = Queue::push('jobs/a.nvs', { queue: 'other' });
try {
    echo '1: ', Queue::delete($other) ? 'true' : 'false', "\n";
} catch (Throwable $e) {
    echo "1: error\n";
}

// 2. An SQL update changes the queue of the row to `q`.
$db->execute("update nvs_jobs set queue = 'q'", []);
try {
    echo '2: ', Queue::delete($other) ? 'true' : 'false', "\n";
} catch (Throwable $e) {
    echo "2: error\n";
}

// 3. The row says a worker is running the job.
var $job = Queue::push('jobs/a.nvs', { queue: 'q' });
$db->execute('update nvs_jobs set state = 1', []);
try {
    echo '3: ', Queue::delete($job) ? 'true' : 'false', "\n";
} catch (Throwable $e) {
    echo "3: error\n";
}

// 4. The state column has text in place of a number.
$db->execute("update nvs_jobs set state = 'lost'", []);
try {
    echo '4: ', Queue::delete($job) ? 'true' : 'false', "\n";
} catch (Throwable $e) {
    echo "4: error\n";
}

// 5. 5000 new jobs are added, and each one is deleted twice.
int $deleted = 0;
int $i = 0;
while ($i < 5000) {
    var $next = Queue::push('jobs/a.nvs', { queue: 'q', args: ['n' => $i] });
    if (Queue::delete($next)) {
        $deleted = $deleted + 1;
    }
    if (Queue::delete($next)) {
        $deleted = $deleted + 1;
    }
    $i = $i + 1;
}
echo '5: ', $deleted, "\n";

// 6. The tables are gone, and the same job is deleted 20000 times.
$db->execute('drop table nvs_jobs', []);
$db->execute('drop table nvs_dead_jobs', []);
int $errors = 0;
$i = 0;
while ($i < 20000) {
    try {
        Queue::delete($job);
    } catch (Throwable $e) {
        $errors = $errors + 1;
    }
    $i = $i + 1;
}
echo '6: ', $errors, "\n";
