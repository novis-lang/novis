<?nvs
// Attack: a program builds the name of a secret setting at run time, so the
// result would be a plain string it could print. Every attempt below should
// throw `LogicError`, and no password should appear in the output.

// 1. A password name made by joining two strings.
string $block = 'db.main';
try {
    string $value = Core\Config::get($block . '.password') ?? 'null';
    echo 'joined: ', $value, "\n";
} catch (LogicError $e) {
    echo "joined: LogicError\n";
}

// 2. The CSRF key name taken from an array.
array<string> $names = ['log.level', 'http.csrf_key'];
try {
    string $key = Core\Config::get($names[1]) ?? 'null';
    echo 'from an array: ', $key, "\n";
} catch (LogicError $e) {
    echo "from an array: LogicError\n";
}

// 3. Every secret setting, each in a block with a name nobody configured.
array<string> $secrets = [
    'db.anything.password',
    'ldap.anything.password',
    'mail.anything.password',
    'http.client.proxy.password',
    'cache.shared.password',
];
int $thrown = 0;
foreach ($secrets as string $name) {
    try {
        Core\Config::get($name);
    } catch (LogicError $e) {
        $thrown = $thrown + 1;
    }
}
echo 'thrown: ', $thrown, ' of ', Core\Arr::count($secrets), "\n";

// 4. A name that only looks like a secret. It is not one, so it returns `null`.
echo 'look-alike: ', Core\Config::get($block . '.password.' . 'x') ?? 'null', "\n";
