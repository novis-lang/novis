<?nvs
// Attack: a program tries to read a secret with `Core\Config::get` or `Core\Config::all`.
// Those methods return a plain string, so each step below should find no secret.

// 1. Reads the secret by its full name. This prints `name: null`.
string $name = 'api_key';
echo 'name: ', Core\Config::get('secrets.' . $name) ?? 'null', "\n";

// 2. Reads the secret by a name written in the call. This prints `literal: null`.
echo 'literal: ', Core\Config::get('secrets.api_key') ?? 'null', "\n";

// 3. Looks for a secret in the list of every setting. This prints `all: 0`.
uint $found = 0;
foreach (Core\Config::all() as string $key => string $value) {
    if (Core\Str::startsWith($key, 'secrets.')) {
        $found = $found + 1;
    }
}
echo 'all: ', $found, "\n";
