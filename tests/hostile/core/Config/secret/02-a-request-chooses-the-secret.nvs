<?nvs
// Attack: a request tries to choose which secret the program reads.
// The name of a secret must come from the program, so every step does not compile.
// hostile: expect-refusal

// 1. Reads the secret named by the query string.
var $fromQuery = Core\Config::secret(Core\Request::query('name') ?? '');

// 2. Reads the secret named by a tainted variable.
tainted string $chosen = 'db_password';
var $fromVariable = Core\Config::secret($chosen);

// 3. Joins the tainted name to a fixed prefix, and reads that secret.
var $joined = Core\Config::secret('db_' . $chosen);
