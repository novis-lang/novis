<?nvs
// Attack: a program reads an API key with `Core\Config::secret` and tries to show it.
// Each step sends the key to a page, a log or a response, so this does not compile.
// hostile: expect-refusal

var $key = Core\Config::secret('api_key') ?? '';

// 1. Prints the key with `echo` and with `print`.
echo $key, "\n";
print $key;

// 2. Writes the key into a log record.
Core\Log::write(Core\Log::Level::Info, 'loaded the key', ['key' => $key]);

// 3. Sends the key as the body of a response.
Core\Response::text($key);

// 4. Puts the key inside a longer string, and prints that string.
echo "the key is {$key}\n";

// 5. Stores the key in a plain `string` variable, so it could be printed later.
string $plain = Core\Config::secret('api_key') ?? '';
