<?nvs
// Attack: a program builds links from text that a visitor chose. The text is very long,
// tries to leave its segment, or is nested very deep. Each link should be built or throw
// an error, and the program must not crash.

class Files
{
    #[Core\Route(path: "/files/{name}", method: Core\Http\Method::Get, name: "Files::show")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(string $name, #[Core\Query] string $q = ''): string
    { return 'one file'; }

    #[Core\Route(path: "/docs/{rest...}", method: Core\Http\Method::Get, name: "Files::docs")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function docs(string $rest): string
    { return 'a page'; }
}

// 1. A capture of one million characters.
string $long = Core\Router::url('Files::show', ['name' => Core\Str::repeat('a', 1000000)]);
echo 'long: ', Core\Str::length($long), "\n";

// 2. Text that tries to leave its segment and its query value.
echo Core\Router::url('Files::show', ['name' => '../../etc/passwd?x=1#top', 'q' => 'a&b=c#d']), "\n";

// 3. A rest capture with one hundred thousand `../` steps. A browser would move
// that link to another path, so this throws a `RuntimeError`.
try {
    Core\Router::url('Files::docs', ['rest' => Core\Str::repeat('../', 100000)]);
    echo 'dots: built', "\n";
} catch (RuntimeError $e) {
    echo 'dots: error', "\n";
}

// 4. A rest capture with one hundred thousand segments.
string $deep = Core\Router::url('Files::docs', ['rest' => Core\Str::repeat('a/', 100000)]);
echo 'deep: ', Core\Str::length($deep), "\n";

// 5. A query value that is an array nested ten thousand levels deep.
array<mixed> $nested = ['end' => 1];
uint $level = 0;
while ($level < 10000) {
    $nested = ['x' => $nested];
    $level = $level + 1;
}
try {
    string $link = Core\Router::url('Files::show', ['name' => 'n', 'q' => $nested]);
    echo 'nested: ', Core\Str::length($link), "\n";
} catch (RuntimeError $e) {
    echo 'nested: error', "\n";
}

// 6. A `$params` array without the capture that the path needs. This throws a `RuntimeError`.
array<mixed> $empty = [];
try {
    Core\Router::url('Files::show', $empty);
    echo 'missing: built', "\n";
} catch (RuntimeError $e) {
    echo 'missing: error', "\n";
}

// 7. Many links in a loop, to check that no memory is lost.
uint $built = 0;
uint $i = 0;
while ($i < 100000) {
    string $each = Core\Router::url('Files::show', ['name' => 'report ' . ($i as string)]);
    $built = $built + Core\Str::length($each);
    $i = $i + 1;
}
echo $built, ' characters', "\n";
