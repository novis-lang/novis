<?nvs
// Attack: a visitor changes the path of an admin page to get the public rule for it.
// The settings route should always have the admin rule, and nothing may crash.
namespace App;

use RuntimeError;

enum Role
{ Admin }

class Site
{
    #[Core\Route(path: "/pages/{slug}", method: Core\Http\Method::Get, name: "Site::page")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function page(string $slug): string
    { return 'a page'; }

    #[Core\Route(path: "/pages/admin/settings", method: Core\Http\Method::Get, name: "Site::settings")]
    #[Core\Access(allow: Role::Admin)]
    public function settings(): string
    { return 'the settings'; }
}

// 1. Paths that a visitor writes to reach the settings page. `%2F` is one segment,
// so that path matches `Site::page` and not `Site::settings`.
array<string> $paths = [
    '/pages/admin/settings',
    '/pages/admin%2Fsettings',
    '/pages/admin/settings/',
    '//pages/admin/settings',
    '/pages/./admin/settings',
    '/pages/admin/../admin/settings',
    '/PAGES/admin/settings',
    '/pages/admin/settings%00',
    '/pages/admin%2fsettings',
];
foreach ($paths as string $path) {
    try {
        ?Core\Router\Match $found = Core\Router::match(Core\Http\Method::Get, $path);
        if ($found == null) {
            echo $path, ' -> no route', "\n";
        } else {
            echo $path, ' -> ', $found->name() ?? 'no name', ' ', $found->access() ?? 'denied', "\n";
        }
    } catch (RuntimeError $e) {
        echo $path, ' -> error', "\n";
    }
}

// 2. The rule is read one million times. It never changes.
?Core\Router\Match $admin = Core\Router::match(Core\Http\Method::Get, '/pages/admin/settings');
uint $same = 0;
if ($admin != null) {
    Core\Router\Match $settings = $admin;
    uint $i = 0;
    while ($i < 1000000) {
        if ($settings->access() == 'App\\Role::Admin') {
            $same = $same + 1;
        }
        $i = $i + 1;
    }
}
echo $same, "\n";
