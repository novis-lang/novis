<?nvs
// Attack: `previous` looks for every weekday from the first days of the calendar. Some of those days are before the year -9999.
// Those calls should throw a `RuntimeError`. Every other call should return the right weekday, and nothing should leak.

use Core\Time\Weekday;

array<Weekday> $weekdays = [
    Weekday::Monday, Weekday::Tuesday, Weekday::Wednesday, Weekday::Thursday,
    Weekday::Friday, Weekday::Saturday, Weekday::Sunday,
];

// 1. Each of the first seven days looks for each weekday.
// -9999-01-01 is a Monday and the first day of the calendar. No date comes before it.
int $found = 0;
int $thrown = 0;
var $day = Core\Time\Date::at(-9999, 1, 1);
int $i = 0;
while ($i < 7) {
    foreach ($weekdays as Weekday $wanted) {
        try {
            if ($day->previous($wanted)->weekday() == $wanted) {
                $found = $found + 1;
            }
        } catch (RuntimeError $tooEarly) {
            $thrown = $thrown + 1;
        }
    }
    $day = $day->plus(1, Core\Unit::Day);
    $i = $i + 1;
}
echo $found, ' found, ', $thrown, " thrown\n";

// 2. One hundred thousand steps back to the previous Monday, from the year 2000.
// Each step is exactly seven days, so this prints 100000.
var $monday = Core\Time\Date::at(2000, 1, 3);
int $sevenDays = 0;
int $step = 0;
while ($step < 100000) {
    var $before = $monday->previous(Weekday::Monday);
    if ($monday->difference($before, Core\Unit::Day) == -7) {
        $sevenDays = $sevenDays + 1;
    }
    $monday = $before;
    $step = $step + 1;
}
echo $sevenDays, "\n";
