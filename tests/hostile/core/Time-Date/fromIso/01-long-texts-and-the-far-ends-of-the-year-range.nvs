<?nvs
// Attack: `Core\Time\Date::fromIso` gets very long texts, years past both ends of the range, and many bad texts.
// Each bad text should throw a `ParseError`, and nothing should crash or leak.

int $refused = 0;

// 1. One million digits as the year, and ten million bytes of text that is not a date.
string $digits = Core\Str::repeat('9', 1000000);
try {
    Core\Time\Date::fromIso($digits . '-03-01');
} catch (ParseError $year) {
    $refused = $refused + 1;
}
try {
    Core\Time\Date::fromIso(Core\Str::repeat('-', 10000000));
} catch (ParseError $junk) {
    $refused = $refused + 1;
}

// 2. A valid date followed by one million more digits.
try {
    Core\Time\Date::fromIso('2024-03-01' . $digits);
} catch (ParseError $tail) {
    $refused = $refused + 1;
}

// 3. Years past both ends of the range, and years with more than four digits.
// Each text is in a variable, so it is read when the program runs.
array<string> $far = ['10000-01-01', '+10000-01-01', '-10000-12-31', '+009999-12-31', '-009999-01-01'];
foreach ($far as string $farText) {
    try {
        Core\Time\Date::fromIso($farText);
    } catch (ParseError $farError) {
        $refused = $refused + 1;
    }
}

// 4. Other ISO 8601 forms, days and months that do not exist, spaces, and an empty text.
array<string> $bad = ['20240301', '2024-W09-5', '2024-061', '2023-02-29', '2024-00-10', '2024-13-01', '2024-04-31', '2024-03-00', ' 2024-03-01', '2024-03-01 ', '2024-03-01T00:00', ''];
foreach ($bad as string $badText) {
    try {
        Core\Time\Date::fromIso($badText);
    } catch (ParseError $badError) {
        $refused = $refused + 1;
    }
}
echo $refused, " refused\n";

// 5. The first and the last day of the range are read.
echo Core\Time\Date::fromIso('-9999-01-01')->format('yyyy-MM-dd'), "\n";
echo Core\Time\Date::fromIso('9999-12-31')->format('yyyy-MM-dd'), "\n";

// 6. Many bad texts in a loop. Every error is caught and freed.
uint $i = 0;
int $caught = 0;
while ($i < 100000) {
    try {
        Core\Time\Date::fromIso('2024-02-' . (30 + $i % 70) as string);
    } catch (ParseError $noSuchDay) {
        $caught = $caught + 1;
    }
    $i = $i + 1;
}
echo $caught, " caught\n";

// 7. Many dates are read in a loop. Every one is freed.
int $total = 0;
uint $j = 0;
while ($j < 100000) {
    string $text = '2024-03-' . Core\Str::padStart(($j % 31 + 1) as string, 2, '0');
    $total = $total + Core\Time\Date::fromIso($text)->day() as int;
    $j = $j + 1;
}
echo $total, "\n";
