<?nvs
// Attack: `difference` counts from the first day of the calendar to the last, in every unit and in both directions.
// Every count should be exact, with no overflow, and swapping the two dates should only change the sign.

use Core\Unit;

var $first = Core\Time\Date::at(-9999, 1, 1);
var $last = Core\Time\Date::at(9999, 12, 31);

// 1. The largest count in each unit, then the same count from the other end.
echo $first->difference($last, Unit::Day), ' ', $last->difference($first, Unit::Day), "\n";
echo $first->difference($last, Unit::Week), ' ', $last->difference($first, Unit::Week), "\n";
echo $first->difference($last, Unit::Month), ' ', $last->difference($first, Unit::Month), "\n";
echo $first->difference($last, Unit::Quarter), ' ', $last->difference($first, Unit::Quarter), "\n";
echo $first->difference($last, Unit::Year), ' ', $last->difference($first, Unit::Year), "\n";

// 2. A date to itself is 0 in every unit. This prints 0 0 0 0 0.
echo $last->difference($last, Unit::Day), ' ', $last->difference($last, Unit::Week), ' ',
    $last->difference($last, Unit::Month), ' ', $last->difference($last, Unit::Quarter), ' ',
    $last->difference($last, Unit::Year), "\n";

// 3. A step of one day, repeated many times, counts as exactly that many days.
var $start = Core\Time\Date::at(2023, 12, 25);
int $right = 0;
var $day = $start;
int $i = 1;
while ($i <= 10000) {
    $day = $day->plus(1, Unit::Day);
    if ($day->difference($start, Unit::Day) == -$i) {
        $right = $right + 1;
    }
    $i = $i + 1;
}
echo $right, " of 10000 right\n";
