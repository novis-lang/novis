<?nvs
// Attack: a job is pushed to a queue whose name has characters that change a URL, and its id is put in a link.
// The link should contain the id string exactly, with no escaping, and the string should parse back to the same id.
use Core\Queue;
use Core\Queue\Id;

var $db = Core\Db::connect('jobs');
var $jobs = <<<'SQL'
create table nvs_jobs (id integer primary key autoincrement, queue varchar(255) not null,
    script text not null, args text, state smallint not null, attempts integer not null,
    max_attempts integer not null, backoff_ms bigint not null, run_at bigint not null,
    tag varchar(255), dedupe_key varchar(255), dedupe_pending varchar(255),
    created_at bigint not null, claimed_at bigint, errors text, grants text, limits text,
    non_transactional smallint, token text, constraint nvs_jobs_dedupe unique (dedupe_pending))
SQL;
$db->execute($jobs, []);

class Exports
{
    #[Core\Route(path: '/exports/{job}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function show(Id $job): void
    {
        echo $job->format(), "\n";
    }
}

class Check
{
    // Pushes a job to the queue `$queue` and prints whether its link and query string are exact.
    public static function queue(string $step, string $queue): void
    {
        try {
            var $job = Queue::push('jobs/a.nvs', { queue: $queue });
            string $text = $job->format();
            bool $link = Core\Router::url(Exports::show, ['job' => $job]) == '/exports/' . $text;
            bool $query = Core\Uri::buildQuery(['job' => $job]) == 'job=' . $text;
            bool $same = Id::parse($text)->format() == $text && $text == $job->toString();
            echo $step, $link ? ' link exact' : ' LINK CHANGED', $query ? ' query exact' : ' QUERY CHANGED';
            echo $same ? ' same' : ' DIFFERENT', "\n";
        } catch (Throwable $e) {
            echo $step, ": push threw an error\n";
        }
    }
}

// 1. A queue name with a slash, a question mark and a hash, which separate the parts of a URL.
Check::queue('1', 'a/b?c#d');

// 2. A queue name with the characters that separate the pairs of a query string.
Check::queue('2', 'x&job=1.AAAAAAAAAAAAAAAAAAAAAA.YQ');

// 3. A queue name that looks like a path to another directory.
Check::queue('3', '../../admin');

// 4. A queue name with a percent sign, a space, a new line and a NUL character.
Check::queue('4', "%2F %0A\n\0end");

// 5. A queue name of 255 emoji, which each take four bytes.
Check::queue('5', Core\Str::repeat("\u{1F600}", 255));

// 6. The id of one job is written into a link 100000 times. Each string is freed.
// This prints 100000.
var $job = Queue::push('jobs/a.nvs', { queue: 'many' });
string $expected = '/exports/' . $job->format();
int $exact = 0;
int $i = 0;
while ($i < 100000) {
    if (Core\Router::url(Exports::show, ['job' => $job]) == $expected) {
        $exact = $exact + 1;
    }
    $i = $i + 1;
}
echo $exact, "\n";
