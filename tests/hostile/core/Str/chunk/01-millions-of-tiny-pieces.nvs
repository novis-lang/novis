<?nvs
// Attack: `Core\Str::chunk` divides very long strings into millions of pieces, and gets sizes at both ends of the range.
// Each call should return an array or throw an error, and must not crash or hang.
// hostile: timeout-ms 20000

class Attack
{
    /// 1. Divides 4 MiB into pieces of one character, which gives millions of strings.
    public static function onePerCharacter(uint $mib): uint
    {
        var $s = Core\Str::repeat(Core\Str::repeat('a', 1048576), $mib);
        return Core\Arr::count(Core\Str::chunk($s, 1));
    }

    /// 2. Divides one character with thousands of accents on it. It stays one piece.
    public static function oneLongCharacter(uint $marks): uint
    {
        var $s = 'e' . Core\Str::repeat("\u{301}", $marks);
        return Core\Arr::count(Core\Str::chunk($s, 1));
    }

    /// 3. Divides many flags into pieces of one, where each flag is two code points.
    public static function flags(uint $count): uint
    {
        var $s = Core\Str::repeat("\u{1F1E9}\u{1F1EA}", $count);
        return Core\Arr::count(Core\Str::chunk($s, 1));
    }

    /// 4. Uses the largest possible size. The whole string is one piece.
    public static function largestSize(): uint
    {
        return Core\Arr::count(Core\Str::chunk('abc', 18446744073709551615));
    }

    /// 5. Uses a size of 0 many times. Each call throws an error.
    public static function zeroSize(uint $rounds): uint
    {
        uint $thrown = 0;
        uint $i = 0;
        while ($i < $rounds) {
            try {
                Core\Str::chunk('abc', 0);
            } catch (RuntimeError $error) {
                $thrown = $thrown + 1;
            }
            $i = $i + 1;
        }
        return $thrown;
    }
}

echo Attack::onePerCharacter(4), "\n";
echo Attack::oneLongCharacter(100000), "\n";
echo Attack::flags(500000), "\n";
echo Attack::largestSize(), "\n";
echo Attack::zeroSize(100000), "\n";
