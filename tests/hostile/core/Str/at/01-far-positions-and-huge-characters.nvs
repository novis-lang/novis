<?nvs
// Attack: `Core\Str::at` is called with the largest positions an `int` can have, on very
// long strings and on one character built from many parts. Each call should return a
// character or throw an error, and must not crash or hang.
// hostile: timeout-ms 20000

class Attack
{
    /// 1. Uses the smallest and the largest `int` as the position.
    public static function extremePositions(): string
    {
        string $out = '';
        array<int> $positions = [-9223372036854775807 - 1, 9223372036854775807, -4, 3];
        foreach ($positions as int $position) {
            try {
                $out = $out . Core\Str::at('abc', $position);
            } catch (RuntimeError $error) {
                $out = $out . '!';
            }
        }
        return $out;
    }

    /// 2. Reads the last character of 16 MiB, counting from the end and from the start.
    public static function farEndOfALongString(uint $mib): string
    {
        var $s = Core\Str::repeat(Core\Str::repeat("\u{e9}", 524288), $mib) . 'z';
        int $last = Core\Str::length($s) as int - 1;
        return Core\Str::at($s, -1) . Core\Str::at($s, $last) . Core\Str::at($s, 0 - $last - 1);
    }

    /// 3. Asks for one past the end of 16 MiB, so the error message counts the whole string.
    public static function onePastTheEnd(uint $mib): string
    {
        var $s = Core\Str::repeat(Core\Str::repeat('a', 1048576), $mib);
        int $length = Core\Str::length($s) as int;
        string $out = '';
        array<int> $positions = [$length, 0 - $length - 1];
        foreach ($positions as int $position) {
            try {
                $out = $out . Core\Str::at($s, $position);
            } catch (RuntimeError $error) {
                $out = $out . '!';
            }
        }
        return $out;
    }

    /// 4. Reads one character made of a letter and 500000 accents.
    public static function oneHugeCharacter(uint $accents): uint
    {
        var $s = 'e' . Core\Str::repeat("\u{301}", $accents) . 'x';
        return Core\Str::length(Core\Str::at($s, 0)) + Core\Str::length(Core\Str::at($s, -1));
    }

    /// 5. Reads every character of a string of emoji one by one, keeping no result.
    public static function everyEmoji(uint $count): uint
    {
        var $s = Core\Str::repeat("\u{1f469}\u{200d}\u{1f4bb}", $count);
        uint $seen = 0;
        int $i = 0;
        while ($i < $count as int) {
            Core\Str::at($s, $i);
            $seen = $seen + 1;
            $i = $i + 1;
        }
        return $seen;
    }
}

echo Attack::extremePositions(), "\n";
echo Attack::farEndOfALongString(16), "\n";
echo Attack::onePastTheEnd(16), "\n";
echo Attack::oneHugeCharacter(500000), "\n";
echo Attack::everyEmoji(3000), "\n";
