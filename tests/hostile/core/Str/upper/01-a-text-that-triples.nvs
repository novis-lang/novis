<?nvs
// Attack: `Core\Str::upper` gets very long texts, and letters that need three times the bytes in upper case.
// The last step should stop the program at its memory limit with an error, and nothing may crash or hang.
// hostile: timeout-ms 20000
// hostile: ends-early

class Attack
{
    /// 1. Changes a text of ten million lower-case letters.
    public static function aLongText(uint $size): uint
    {
        return Core\Str::length(Core\Str::upper(Core\Str::repeat('äb', $size)));
    }

    /// 2. Changes a text of `ΐ`, which needs two bytes in lower case and six in upper case.
    public static function aTextThatTriples(uint $size): uint
    {
        return Core\Str::length(Core\Str::upper(Core\Str::repeat('ΐ', $size)));
    }

    /// 3. Changes a text of `ß`, where every letter becomes two letters.
    public static function everyLetterDoubles(uint $size): uint
    {
        return Core\Str::length(Core\Str::upper(Core\Str::repeat('ß', $size)));
    }

    /// 4. Changes a short word one million times and keeps none of the results.
    public static function manySmallCalls(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length(Core\Str::upper('straße'));
            $i = $i + 1;
        }
        return $total;
    }

    /// 5. Changes a text of `ΐ` so long that the text fits, but its upper-case copy does not.
    /// The memory limit stops the program here.
    public static function tooLarge(uint $size): uint
    {
        return Core\Str::length(Core\Str::upper(Core\Str::repeat('ΐ', $size)));
    }
}

echo Attack::aLongText(5000000), "\n";
echo Attack::aTextThatTriples(5000000), "\n";
echo Attack::everyLetterDoubles(5000000), "\n";
echo Attack::manySmallCalls(1000000), "\n";
echo Attack::tooLarge(40000000), "\n";
