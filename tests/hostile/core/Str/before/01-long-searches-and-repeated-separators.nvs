<?nvs
// Attack: `Core\Str::before` searches very long strings in the slowest ways a caller can
// choose. Each search should return a result or stop at a limit, and must not crash or hang.
// hostile: timeout-ms 20000

class Attack
{
    /// 1. Searches 32 MiB for a separator that is not there, then copies 32 MiB out.
    public static function bigMissAndBigCopy(uint $mib): string
    {
        var $s = Core\Str::repeat(Core\Str::repeat('a', 1048576), $mib);
        ?string $missing = Core\Str::before($s, 'b');
        ?string $all = Core\Str::before($s . 'x', 'x');
        return ($missing ?? '(none)') . ' ' . Core\Str::length($all ?? '');
    }

    /// 2. Asks for the last "a" in a string of nothing but "a", so every character is a match.
    public static function everyCharacterMatches(uint $count): uint
    {
        var $s = Core\Str::repeat('a', $count);
        return Core\Str::length(Core\Str::before($s, 'a', { last: true }) ?? '');
    }

    /// 3. Searches for a long separator that almost matches at every position.
    public static function nearMissEverywhere(uint $count): string
    {
        var $s = Core\Str::repeat('a', $count);
        var $needle = 'b' . Core\Str::repeat('a', 5000);
        ?string $first = Core\Str::before($s, $needle);
        ?string $last = Core\Str::before($s, $needle, { last: true });
        return ($first ?? '(none)') . ' ' . ($last ?? '(none)');
    }

    /// 4. Uses an empty separator, and a separator longer than the string.
    public static function degenerateSeparators(uint $count): string
    {
        var $s = Core\Str::repeat("\u{e9}", $count);
        ?string $empty = Core\Str::before($s, '', { last: true });
        ?string $longer = Core\Str::before('ab', 'abc');
        return Core\Str::length($empty ?? '') . ' ' . ($longer ?? '(none)');
    }

    /// 5. Splits an accented letter: the separator is only its combining accent.
    public static function halfOfACharacter(uint $rounds): uint
    {
        uint $found = 0;
        uint $i = 0;
        while ($i < $rounds) {
            ?string $head = Core\Str::before("cafe\u{301}!", "\u{301}");
            if ($head != null) {
                $found = $found + 1;
            }
            $i = $i + 1;
        }
        return $found;
    }
}

echo Attack::bigMissAndBigCopy(32), "\n";
echo Attack::everyCharacterMatches(2000000), "\n";
echo Attack::nearMissEverywhere(2000000), "\n";
echo Attack::degenerateSeparators(1000000), "\n";
echo Attack::halfOfACharacter(100000), "\n";
