<?nvs
// Attack: a program lowers its memory limit to 16 MiB and asks for the help of a command named with 8 MiB.
// The call should throw an error with a short message, and stay inside the limit.

class Tool
{
    #[Core\Command(name: 'deploy', about: 'Push the current build')]
    public static function deploy(string $target): uint
    {
        return 0;
    }
}

// 1. Lowers the memory limit to `16M`.
echo 'limit lowered: ', Core\Config::set('limits.memory', '16M') ? 'yes' : 'no', "\n";

// 2. Asks for a command named with 8 MiB of letters. This throws a `LogicError`, and its message is short.
string $name = Core\Str::repeat('a', 8388608);
try {
    echo Core\Command::help($name), "\n";
} catch (Throwable $error) {
    echo Core\Str::length($error->message) < 200 ? 'short message' : 'long message', "\n";
}
