<?nvs
// Attack: a program lowers its memory limit to 16 MiB and reads a group with a name of 8 MiB.
// The call should throw an error with a short message, and stay inside the limit.

// 1. Lowers the memory limit to `16M`.
echo 'limit lowered: ', Core\Config::set('limits.memory', '16M') ? 'yes' : 'no', "\n";

// 2. Reads a group named with 8 MiB of letters. The pattern has no such group,
// so this throws an error, and its message is short.
var $found = Core\Regex::match('key=value', '(?<name>\w+)=(\w+)');
if ($found != null) {
    Core\Regex\Match $m = $found;
    string $name = Core\Str::repeat('a', 8388608);
    try {
        echo $m->group($name) ?? 'null', "\n";
    } catch (Throwable $error) {
        echo Core\Str::length($error->message) < 200 ? 'short message' : 'long message', "\n";
    }
}
