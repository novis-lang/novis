<?nvs
// Attack: `Core\Math::acosh` is given numbers just below its range, numbers that
// are not ordinary, and a million calls in a loop. It should return `NaN` where
// no result exists, and the program should run to its last line.

// 1. The smallest step below 1.0, and 1.0 itself.
echo Core\Math::acosh(0.9999999999999999), "\n";
echo Core\Math::acosh(1.0), "\n";
echo Core\Math::acosh(1.0000000000000002), "\n";

// 2. The largest numbers, where a careless formula overflows to infinity.
echo Core\Math::acosh(Core\Math::FLOAT_MAX), "\n";
echo Core\Math::acosh(1.0e300), "\n";

// 3. Values that are not ordinary numbers.
echo Core\Math::acosh(Core\Math::NAN), "\n";
echo Core\Math::acosh(Core\Math::INFINITY), "\n";
echo Core\Math::acosh(-Core\Math::INFINITY), "\n";
echo Core\Math::acosh(-Core\Math::FLOAT_MAX), "\n";
echo Core\Math::acosh(Core\Math::FLOAT_MIN), "\n";
echo Core\Math::acosh(-0.0), "\n";

// 4. A million calls. Each result feeds the next one, and none is kept.
float $value = 2.0;
int $round = 0;
while ($round < 1000000) {
    $value = Core\Math::cosh(Core\Math::acosh($value));
    $round = $round + 1;
}
echo Core\Math::isNan($value) ? "NaN\n" : "a number\n";
