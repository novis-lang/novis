<?nvs
// Attack: `Core\Math::truncate` is given the far ends of `float`, the smallest numbers next to
// zero, `NaN`, the infinities and a million calls. Every call should return a number, and the
// program should run to its end.

// 1. The largest and smallest `float` values.
echo Core\Math::truncate(Core\Math::FLOAT_MAX), "\n";
echo Core\Math::truncate(-Core\Math::FLOAT_MAX), "\n";

// 2. The smallest numbers next to zero, and both zeros.
echo Core\Math::truncate(5e-324), ' ', Core\Math::truncate(-5e-324), "\n";
echo Core\Math::truncate(0.0), ' ', Core\Math::truncate(-0.0), "\n";
echo Core\Math::truncate(0.9999999999999999), ' ', Core\Math::truncate(-0.9999999999999999), "\n";

// 3. The first `float` values that have no fractional part, and whole numbers past `int`.
echo Core\Math::truncate(4503599627370495.5), ' ', Core\Math::truncate(4503599627370497.0), "\n";
echo Core\Math::truncate(9.3e18), ' ', Core\Math::truncate(-9.3e18), "\n";

// 4. Values that are not ordinary numbers.
echo Core\Math::truncate(Core\Math::NAN), "\n";
echo Core\Math::truncate(Core\Math::INFINITY), ' ', Core\Math::truncate(-Core\Math::INFINITY), "\n";

// 5. The smallest and biggest `int`, given where a `float` is expected. These conversions
// throw an error, because the `int` is too far from zero to convert exactly.
array<int> $ends = [Core\Math::INT_MIN, Core\Math::INT_MAX];
foreach ($ends as int $end) {
    try {
        echo Core\Math::truncate($end), "\n";
    } catch (ArithmeticError $tooBig) {
        echo "not a float\n";
    }
}

// 6. A million calls. Each result feeds the next one.
float $total = 0.0;
int $round = 0;
while ($round < 1000000) {
    $total = Core\Math::truncate($total * 0.5 + 7.9);
    $round = $round + 1;
}
echo $total, "\n";
