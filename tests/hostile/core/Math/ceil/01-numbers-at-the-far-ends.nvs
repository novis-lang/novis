<?nvs
// Attack: `Core\Math::ceil` is given the biggest and smallest numbers, and values that are
// not ordinary. It is also given the biggest numbers that still have a fraction, and a
// million calls. Every call should return a number, and the program should run to its end.

// 1. The biggest numbers, positive and negative.
echo Core\Math::ceil(Core\Math::FLOAT_MAX), "\n";
echo Core\Math::ceil(-Core\Math::FLOAT_MAX), "\n";

// 2. The smallest numbers, and zero with a minus sign.
echo Core\Math::ceil(Core\Math::FLOAT_MIN), "\n";
echo Core\Math::ceil(-Core\Math::FLOAT_MIN), "\n";
echo Core\Math::ceil(-0.0), "\n";

// 3. The biggest numbers that still have a fraction.
echo Core\Math::ceil(4503599627370495.5), "\n";
echo Core\Math::ceil(-4503599627370495.5), "\n";

// 4. Values that are not ordinary numbers.
echo Core\Math::ceil(Core\Math::NAN), "\n";
echo Core\Math::ceil(Core\Math::INFINITY), "\n";
echo Core\Math::ceil(-Core\Math::INFINITY), "\n";

// 5. A million calls. Each result feeds the next one, and none is kept.
float $value = 0.5;
int $round = 0;
while ($round < 1000000) {
    $value = Core\Math::ceil($value) / 3.0;
    $round = $round + 1;
}
echo Core\Math::isNan($value) ? "NaN\n" : "a number\n";
