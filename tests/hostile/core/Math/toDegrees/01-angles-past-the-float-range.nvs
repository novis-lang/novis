<?nvs
// Attack: `Core\Math::toDegrees` is given angles whose result is too big for a `float`, the
// smallest angles, and values that are not ordinary numbers. It is also called a million times.
// Every call should return a number, an infinity or `NaN`, and the program should run to its end.

// 1. The biggest angles. The result is too big for a `float`, so these print INF and -INF.
echo Core\Math::toDegrees(Core\Math::FLOAT_MAX), "\n";
echo Core\Math::toDegrees(-Core\Math::FLOAT_MAX), "\n";

// 2. A very big angle whose result still fits in a `float`.
echo Core\Math::toDegrees(Core\Math::FLOAT_MAX / 60.0), "\n";

// 3. The smallest angles. The last one is too small to keep, so the result is 0.
echo Core\Math::toDegrees(Core\Math::FLOAT_MIN), "\n";
echo Core\Math::toDegrees(Core\Math::FLOAT_MIN / 4503599627370496.0), "\n";
echo Core\Math::toDegrees(-0.0), "\n";

// 4. Values that are not ordinary numbers.
echo Core\Math::toDegrees(Core\Math::NAN), "\n";
echo Core\Math::toDegrees(Core\Math::INFINITY), "\n";
echo Core\Math::toDegrees(-Core\Math::INFINITY), "\n";

// 5. A million calls. Each result feeds the next one, and none is kept.
float $value = 0.5;
int $round = 0;
while ($round < 1000000) {
    $value = Core\Math::toDegrees($value) * 0.01 + 1.0;
    $round = $round + 1;
}
echo Core\Math::round($value, { precision: 6 }), "\n";
