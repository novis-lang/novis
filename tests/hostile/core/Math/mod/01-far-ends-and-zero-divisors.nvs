<?nvs
// Attack: `Core\Math::mod` is given the far ends of `float`, values that are not ordinary
// numbers, divisors that are zero and a million calls. Each division by zero should throw
// an error that the program catches, and the program should run to its end.

// 1. The largest and smallest numbers, as the first value and as the second.
echo Core\Math::mod(Core\Math::FLOAT_MAX, 3.0), "\n";
echo Core\Math::mod(-Core\Math::FLOAT_MAX, 1e-300), "\n";
echo Core\Math::mod(1e-300, Core\Math::FLOAT_MAX), "\n";
echo Core\Math::mod(Core\Math::FLOAT_MAX, 1.0 / Core\Math::FLOAT_MAX), "\n";

// 2. Values that are not ordinary numbers.
echo Core\Math::mod(Core\Math::INFINITY, Core\Math::INFINITY), "\n";
echo Core\Math::mod(Core\Math::NAN, 2.0), "\n";
echo Core\Math::mod(2.0, Core\Math::NAN), "\n";
echo Core\Math::mod(-0.0, 5.0), "\n";

// 3. Zero divisors: zero, negative zero, and a product so small that it becomes zero.
// Each call throws an error.
array<float> $divisors = [0.0, -0.0, 1e-300 * 1e-300];
array<float> $values = [1.0, Core\Math::INFINITY, Core\Math::NAN];
foreach ($divisors as float $divisor) {
    foreach ($values as float $value) {
        try {
            echo Core\Math::mod($value, $divisor), "\n";
        } catch (ArithmeticError $e) {
            echo "zero divisor\n";
        }
    }
}

// 4. A million calls. Each result feeds the next one.
float $total = 0.0;
int $round = 0;
while ($round < 1000000) {
    $total = Core\Math::mod($total * 3.0 + 1.0, 1000.0);
    $round = $round + 1;
}
echo $total, "\n";
