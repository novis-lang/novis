<?nvs
// Attack: `Core\Math::clamp` is given the far ends of each type, values that cannot be
// compared, empty ranges, a very long string and a million calls. Each bad call should
// throw an error that the program catches, and the program should run to its end.

class Box
{
}

// 1. The biggest and smallest whole numbers, as the value and as the range.
echo Core\Math::clamp(Core\Math::INT_MIN, Core\Math::INT_MIN, Core\Math::INT_MAX), "\n";
echo Core\Math::clamp(Core\Math::INT_MAX, 0, 0), "\n";
echo Core\Math::clamp(Core\Math::INT_MIN, Core\Math::INT_MAX, Core\Math::INT_MAX), "\n";

// 2. Values that are not ordinary numbers, as the value and as the range.
echo Core\Math::clamp(Core\Math::NAN, 0.0, 1.0), "\n";
echo Core\Math::clamp(Core\Math::INFINITY, -Core\Math::FLOAT_MAX, Core\Math::FLOAT_MAX), "\n";
echo Core\Math::isNan(Core\Math::clamp(0.5, Core\Math::NAN, Core\Math::NAN)) ? "NaN\n" : "a number\n";
echo Core\Math::clamp(-0.0, 0.0, 0.0), "\n";

// 3. A string of one million characters, kept between two short strings.
string $long = Core\Str::repeat('m', 1000000);
echo Core\Str::length(Core\Math::clamp($long, 'a', 'z')), "\n";
echo Core\Math::clamp($long, 'a', 'b'), "\n";

// 4. Ranges with no values in them. Each call throws an error.
try {
    echo Core\Math::clamp(0, 1, 0), "\n";
} catch (RuntimeError $e) {
    echo "empty range\n";
}
try {
    echo Core\Math::clamp(0, Core\Math::INT_MAX, Core\Math::INT_MIN), "\n";
} catch (RuntimeError $e) {
    echo "empty range\n";
}

// 5. Values that cannot be compared: an array, an object, and a number with a string.
array<mixed> $values = [[1, 2], new Box(), '5', null, true];
foreach ($values as mixed $value) {
    try {
        mixed $low = 0;
        mixed $high = 10;
        echo Core\Math::clamp($value, $low, $high), "\n";
    } catch (RuntimeError $e) {
        echo "no order\n";
    }
}

// 6. A million calls. Each result feeds the next one, and none is kept.
int $total = 0;
int $round = 0;
while ($round < 1000000) {
    $total = Core\Math::clamp($total * 3 + $round, -1000, 1000) - 500;
    $round = $round + 1;
}
echo $total, "\n";
