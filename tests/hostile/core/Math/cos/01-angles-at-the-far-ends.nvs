<?nvs
// Attack: `Core\Math::cos` is given the biggest and smallest angles, very large angles, and
// values that are not ordinary numbers. It is also called a million times. Every call should
// return a number or `NaN`, and the program should run to its end.

// 1. The biggest angles, positive and negative.
echo Core\Math::cos(Core\Math::FLOAT_MAX), "\n";
echo Core\Math::cos(-Core\Math::FLOAT_MAX), "\n";

// 2. Very large angles, where the angle must be reduced exactly before the cosine.
echo Core\Math::cos(1.0e22), "\n";
echo Core\Math::cos(4503599627370496.0), "\n";

// 3. The smallest angles, and zero with a minus sign.
echo Core\Math::cos(Core\Math::FLOAT_MIN), "\n";
echo Core\Math::cos(-Core\Math::FLOAT_MIN), "\n";
echo Core\Math::cos(-0.0), "\n";

// 4. Values that are not ordinary numbers. Each one gives `NaN`.
echo Core\Math::cos(Core\Math::NAN), "\n";
echo Core\Math::cos(Core\Math::INFINITY), "\n";
echo Core\Math::cos(-Core\Math::INFINITY), "\n";

// 5. A million calls. Each result feeds the next one, and none is kept.
float $value = 0.5;
int $round = 0;
while ($round < 1000000) {
    $value = Core\Math::cos($value);
    $round = $round + 1;
}
echo Core\Math::round($value, { precision: 6 }), "\n";
