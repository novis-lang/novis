<?nvs
// Attack: `Core\Math::sinh` is given numbers whose result is too big for a `float`, and values
// that are not ordinary numbers. It is also called a million times. Every call should return a
// number, an infinity or `NaN`, and the program should run to its end.

// 1. The last numbers with a finite result, and the first ones past them.
echo Core\Math::sinh(710.0), "\n";
echo Core\Math::sinh(710.5), "\n";
echo Core\Math::sinh(-710.5), "\n";

// 2. The biggest numbers, positive and negative.
echo Core\Math::sinh(Core\Math::FLOAT_MAX), "\n";
echo Core\Math::sinh(-Core\Math::FLOAT_MAX), "\n";

// 3. The smallest numbers, and zero with a minus sign.
echo Core\Math::sinh(Core\Math::FLOAT_MIN), "\n";
echo Core\Math::sinh(-Core\Math::FLOAT_MIN), "\n";
echo Core\Math::sinh(-0.0), "\n";

// 4. Values that are not ordinary numbers.
echo Core\Math::sinh(Core\Math::NAN), "\n";
echo Core\Math::sinh(Core\Math::INFINITY), "\n";
echo Core\Math::sinh(-Core\Math::INFINITY), "\n";

// 5. A million calls. Each result feeds the next one, and none is kept.
float $value = 0.5;
int $round = 0;
while ($round < 1000000) {
    $value = Core\Math::sinh($value) - 0.5;
    $round = $round + 1;
}
echo Core\Math::isFinite($value) ? "a number\n" : "not a number\n";
