<?nvs
// Attack: a program asks for passwords where nobody can answer, and then answers
// itself with lines nothing should accept. Every step must end at once, with an
// error or with an answer, and the program must run to the end.
// hostile: timeout-ms 60000

// 1. There is no terminal here, and this member has no default. The call must
//    stop with an error instead of waiting for an answer nobody can give.
try {
    Core\Cli::secret('your password?');
    echo "step 1 was answered\n";
} catch (Core\Cli\NotInteractive $nobody) {
    echo "step 1 stopped at once\n";
}

// 2. A question made of control characters. They must not reach the terminal as
//    commands, and the call must still stop with an error.
string $sneaky = "\u{1B}]0;rm -rf /\u{7}your password?";
try {
    Core\Cli::secret($sneaky);
    echo "step 2 was answered\n";
} catch (Core\Cli\NotInteractive $nobody) {
    echo "step 2 stopped at once\n";
}

// 3. A question of nearly ten million characters. The program must keep going.
string $huge = Core\Str::repeat('your password? ', 650000);
try {
    Core\Cli::secret($huge);
    echo "step 3 was answered\n";
} catch (Core\Cli\NotInteractive $nobody) {
    echo "step 3 stopped at once\n";
}

// 4. An answer of a million characters. It comes back whole, and the length is
//    the only thing this program reads from it.
Core\Test::scriptAnswers([Core\Str::repeat('p', 1000000)]);
secret tainted string $long = Core\Cli::secret('your password?');
echo 'step 4 length ', Core\Str::length(Core\Secret::reveal($long, 'measuring the attack')), "\n";

// 5. An answer made of escape sequences and a zero byte. It is a password like
//    any other, so it comes back unchanged and nothing is run.
Core\Test::scriptAnswers(["\u{1B}[2J\u{0}\u{7}\u{1B}]0;whoami\u{7}"]);
secret tainted string $control = Core\Cli::secret('your password?');
echo 'step 5 length ', Core\Str::length(Core\Secret::reveal($control, 'measuring the attack')), "\n";

// 6. An empty answer. An empty line is still a line somebody typed, so it comes
//    back as an empty password.
Core\Test::scriptAnswers(['']);
secret tainted string $empty = Core\Cli::secret('your password?');
echo 'step 6 length ', Core\Str::length(Core\Secret::reveal($empty, 'measuring the attack')), "\n";

// 7. One hundred thousand questions in a row, so that anything a password kept
//    behind would grow.
uint $i = 0;
uint $stopped = 0;
while ($i < 100000) {
    try {
        Core\Cli::secret('your password?');
    } catch (Core\Cli\NotInteractive $nobody) {
        $stopped = $stopped + 1;
    }
    $i = $i + 1;
}
echo 'step 7 stopped ', $stopped, " times\n";
