<?nvs
// Attack: text built to make the column count crash, wrap around, or paint
// something on the screen. Every step must return a number, and the program must
// run to the end.
// hostile: timeout-ms 60000

// 1. A text of twelve million characters. Measuring it must not crash.
string $huge = Core\Str::repeat('order ', 2000000);
echo 'step 1 ', Core\Cli::displayWidth($huge), "\n";

// 2. One letter carrying a hundred thousand marks. The marks add no columns, so
//    the answer is 1.
string $stacked = 'e' . Core\Str::repeat("\u{301}", 100000);
echo 'step 2 ', Core\Cli::displayWidth($stacked), "\n";

// 3. Escape sequences that would clear the screen and rename the window if a
//    terminal ran them. They are text here and only text.
string $paint = "\u{1B}[2J\u{1B}]0;rm -rf /\u{7}";
echo 'step 3 ', Core\Cli::displayWidth($paint), "\n";

// 4. A million tabs. Each one moves to the next stop, and the count must not
//    wrap around.
string $tabs = Core\Str::repeat("\t", 1000000);
echo 'step 4 ', Core\Cli::displayWidth($tabs), "\n";

// 5. A hundred thousand measurements in a row, so that anything a measurement
//    kept behind would grow.
uint $i = 0;
uint $columns = 0;
while ($i < 100000) {
    $columns = $columns + Core\Cli::displayWidth('注文 order 🎧');
    $i = $i + 1;
}
echo 'step 5 columns ', $columns, "\n";
