<?nvs
// Attack: somebody changed the saved algorithm numbers, so they name the wrong algorithm or no algorithm.
// Each one should throw an error or give `null`, and a good passkey should still read back its own algorithm.
// hostile: timeout-ms 60000

class Try
{
    // Converts the saved number and creates the passkey. It returns the number of the algorithm, or `error`.
    // The error is caught, so the next number still runs.
    public static function algorithm(int $number, bytes $publicKey): string
    {
        try {
            Core\Passkey\Credential::Algorithm $algorithm = $number as Core\Passkey\Credential::Algorithm;
            Core\Passkey\Credential $passkey = Core\Passkey\Credential::of(Core\Encoding::fromHex('0a0b'), $publicKey, $algorithm, 0);
            return ($passkey->algorithm() as int) as string;
        } catch (RuntimeError $notACase) {
            return 'error';
        } catch (LogicError $wrongKey) {
            return 'error';
        }
    }
}

bytes $raw = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256)->publicKey()->write(Core\Crypto\PublicKey::Format::Raw);
bytes $es256 = Core\Bytes::join([
    Core\Encoding::fromHex('a5010203262001215820'),
    Core\Bytes::slice($raw, 1, 32),
    Core\Encoding::fromHex('225820'),
    Core\Bytes::slice($raw, 33, 32),
]);
bytes $ed25519 = Core\Encoding::fromHex('a4010103272006215820fcce9008a33565248561295a7ce1cccb040b6129bba8ff24744953bbc01261ac');

// 1. Each key with its own algorithm, and with the other one. Only its own algorithm is allowed.
echo 'ES256 key: ', Try::algorithm(0, $es256), ' ', Try::algorithm(1, $es256), "\n";
echo 'Ed25519 key: ', Try::algorithm(1, $ed25519), ' ', Try::algorithm(0, $ed25519), "\n";

// 2. Numbers that no case has: the COSE numbers of the algorithms, the next case, and the largest and smallest `int`.
array<int> $numbers = [-7, -8, -19, 2, 9223372036854775807, -9223372036854775807 - 1];
foreach ($numbers as int $number) {
    ?Core\Passkey\Credential::Algorithm $maybe = $number as ?Core\Passkey\Credential::Algorithm;
    echo $number, ': ', Try::algorithm($number, $ed25519), ', ', $maybe == null ? 'null' : 'a case', "\n";
}

// 3. One passkey of each algorithm, each read a million times.
Core\Passkey\Credential $first = Core\Passkey\Credential::of(Core\Encoding::fromHex('0a0b'), $es256, Core\Passkey\Credential::Algorithm::ES256, 0);
Core\Passkey\Credential $second = Core\Passkey\Credential::of(Core\Encoding::fromHex('0a0c'), $ed25519, Core\Passkey\Credential::Algorithm::Ed25519, 0);
int $es = 0;
int $ed = 0;
int $n = 0;
while ($n < 1000000) {
    Core\Passkey\Credential $passkey = $n % 2 == 0 ? $first : $second;
    if ($passkey->algorithm() == Core\Passkey\Credential::Algorithm::ES256) {
        $es = $es + 1;
    } else {
        $ed = $ed + 1;
    }
    $n = $n + 1;
}
echo 'reads: ', $es, ' ES256 and ', $ed, " Ed25519\n";
