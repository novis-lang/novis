<?nvs
// Attack: somebody changes the saved passkey of an account, so that it signs in with another key.
// Every changed record below should throw an error, and nothing should crash, hang or leak.
// hostile: timeout-ms 60000

class Load
{
    // Creates the passkey, and returns `1` when that works and `0` when it throws.
    // The error is caught, so the next record still runs.
    public static function ok(bytes $id, bytes $publicKey, Core\Passkey\Credential::Algorithm $algorithm, int $signCount): int
    {
        try {
            Core\Passkey\Credential::of($id, $publicKey, $algorithm, $signCount);
            return 1;
        } catch (LogicError $e) {
            return 0;
        }
    }
}

Core\Passkey\Credential::Algorithm $ed = Core\Passkey\Credential::Algorithm::Ed25519;
Core\Passkey\Credential::Algorithm $es = Core\Passkey\Credential::Algorithm::ES256;
bytes $id = Core\Encoding::fromHex('6b1f0c9a24d35e7781a4c2f0e93b5d16');
string $x = '6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296';
string $y = '4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5';
bytes $edKey = Core\Encoding::fromHex('a4010103272006215820d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a');
bytes $esKey = Core\Encoding::fromHex('a5010203262001215820' . $x . '225820' . $y);
echo 'correct records: ', Load::ok($id, $edKey, $ed, 0) + Load::ok($id, $esKey, $es, 0), " created\n";

// 1. Each key with the other algorithm.
echo 'other algorithm: ', Load::ok($id, $edKey, $es, 0) + Load::ok($id, $esKey, $ed, 0), " created\n";

// 2. Keys that are not COSE keys: empty, random bytes, cut short, and with one more byte at the end.
array<bytes> $broken = [
    Core\Encoding::fromHex(''),
    Core\Random::bytes(42),
    Core\Bytes::slice($edKey, 0, 41),
    Core\Bytes::join([$edKey, Core\Encoding::fromHex('00')]),
    Core\Encoding::fromHex('a0'),
    Core\Encoding::fromHex('ff'),
];
int $created = 0;
foreach ($broken as bytes $key) {
    $created = $created + Load::ok($id, $key, $ed, 0) + Load::ok($id, $key, $es, 0);
}
echo 'broken keys: ', $created, " created\n";

// 3. Keys that are COSE keys but wrong: a point not on the curve, a short Ed25519 key, and RS256.
array<bytes> $wrong = [
    Core\Encoding::fromHex('a5010203262001215820' . $x . '225820' . Core\Str::repeat('00', 32)),
    Core\Encoding::fromHex('a5010203262002215820' . $x . '225820' . $y),
    Core\Encoding::fromHex('a401010327200621581f' . Core\Str::repeat('11', 31)),
    Core\Encoding::fromHex('a4010103272007215820' . Core\Str::repeat('11', 32)),
    Core\Encoding::fromHex('a3010303390100205820' . Core\Str::repeat('11', 32)),
];
$created = 0;
foreach ($wrong as bytes $key) {
    $created = $created + Load::ok($id, $key, $ed, 0) + Load::ok($id, $key, $es, 0);
}
echo 'wrong keys: ', $created, " created\n";

// 4. A key nested 100000 levels deep, and a key of 16 MB.
$created = Load::ok($id, Core\Bytes::join([Core\Bytes::fill(100000, 0x81), $edKey]), $ed, 0);
$created = $created + Load::ok($id, Core\Bytes::fill(16777216, 0x41), $ed, 0);
echo 'deep and huge keys: ', $created, " created\n";

// 5. Sign counters by one past each end, and the smallest and largest `int`.
array<int> $counts = [-1, 4294967296, -9223372036854775807 - 1, 9223372036854775807];
$created = 0;
foreach ($counts as int $count) {
    $created = $created + Load::ok($id, $edKey, $ed, $count);
}
echo 'counters out of range: ', $created, " created\n";

// 6. Ids of 0 bytes, 1024 bytes and 16 MB. Only 1 to 1023 bytes are allowed.
array<uint> $sizes = [0, 1024, 16777216];
$created = 0;
foreach ($sizes as uint $size) {
    $created = $created + Load::ok(Core\Bytes::fill($size, 7), $edKey, $ed, 0);
}
echo 'ids of the wrong size: ', $created, " created\n";

// 7. 200000 records, half of them with the wrong algorithm.
$created = 0;
int $n = 0;
while ($n < 200000) {
    $created = $created + Load::ok($id, $edKey, $n % 2 == 0 ? $ed : $es, $n);
    $n = $n + 1;
}
echo $created, ' of ', $n, " records created\n";
