<?nvs
// Attack: a program lowers its memory limit to 16 MiB and sets a gauge with a name of 8 MiB.
// A name is at most 1 KiB, so the call should throw an error and keep nothing.

// 1. Lowers the memory limit to `16M`.
echo 'limit lowered: ', Core\Config::set('limits.memory', '16M') ? 'yes' : 'no', "\n";

// 2. A name of 8 MiB. This throws a `LogicError`, and its message is short.
string $long = Core\Str::repeat('a', 8388608);
try {
    Core\Metrics::gauge($long, 1.0);
    echo "set\n";
} catch (LogicError $error) {
    echo Core\Str::length($error->message) < 200 ? 'short message' : 'long message', "\n";
}
