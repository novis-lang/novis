<?nvs
// Attack: a program with many pages builds its page list with the routes
// twenty thousand times in a row. Every list must be freed again, so the
// program should stay inside its memory limit and run to its last line.

type Route = {path: string};

interface Page
{
    public function render(): string;
}

// 1. Many pages, most with a route and some without, so both kinds of row are built.
class P01 implements Page
{ #[Route(path: "/p01")] public function render(): string
{ return 'p01'; } }
class P02 implements Page
{ public function render(): string
{ return 'p02'; } }
class P03 implements Page
{ #[Route(path: "/p03")] public function render(): string
{ return 'p03'; } }
class P04 implements Page
{ #[Route(path: "/p04")] public function render(): string
{ return 'p04'; } }
class P05 implements Page
{ public function render(): string
{ return 'p05'; } }
class P06 implements Page
{ #[Route(path: "/p06")] public function render(): string
{ return 'p06'; } }
class P07 implements Page
{ #[Route(path: "/p07")] public function render(): string
{ return 'p07'; } }
class P08 implements Page
{ #[Route(path: "/p08")] public function render(): string
{ return 'p08'; } }
class P09 implements Page
{ public function render(): string
{ return 'p09'; } }
class P10 implements Page
{ #[Route(path: "/p10")] public function render(): string
{ return 'p10'; } }
class P11 implements Page
{ #[Route(path: "/p11")] public function render(): string
{ return 'p11'; } }
class P12 implements Page
{ #[Route(path: "/p12")] public function render(): string
{ return 'p12'; } }
class P13 implements Page
{ public function render(): string
{ return 'p13'; } }
class P14 implements Page
{ #[Route(path: "/p14")] public function render(): string
{ return 'p14'; } }
class P15 implements Page
{ #[Route(path: "/p15")] public function render(): string
{ return 'p15'; } }
class P16 implements Page
{ #[Route(path: "/p16")] public function render(): string
{ return 'p16'; } }
class P17 implements Page
{ public function render(): string
{ return 'p17'; } }
class P18 implements Page
{ #[Route(path: "/p18")] public function render(): string
{ return 'p18'; } }
class P19 implements Page
{ #[Route(path: "/p19")] public function render(): string
{ return 'p19'; } }
class P20 implements Page
{ #[Route(path: "/p20")] public function render(): string
{ return 'p20'; } }

// 2. The list is built again and again. Each list holds twenty instances and
//    twenty rows, and all of it is freed before the next round.
uint $rounds = 0;
uint $routed = 0;
while ($rounds < 20000) {
    foreach (Core\Program::implementingWith<Page, Route>('render') as {instance: Page, attribute: ?Route} $row) {
        if ($row->attribute != null) {
            $routed = $routed + 1;
        }
    }
    $rounds = $rounds + 1;
}

// 3. The count is the same every round: 15 routed pages, 20000 times.
echo $routed, "\n";
