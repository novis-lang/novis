<?nvs
// Attack: a program starts its event stream again and again, and sets a status before many attempts.
// Every error should be caught. Memory should grow only by what the program keeps.

// 1. Set a status and then start the stream, one hundred thousand times.
// Every attempt throws an error, and the program catches it.
array<uint> $statuses = [200, 204, 404, 503];
uint $refused = 0;
uint $i = 0;
while ($i < 100000) {
    Core\Response::setStatus($statuses[$i % 4]);
    try {
        Core\Sse::stream();
    } catch (LogicError $e) {
        $refused = $refused + 1;
    }
    $i = $i + 1;
}

// 2. Start the stream one million times and keep nothing.
$i = 0;
while ($i < 1000000) {
    Core\Sse::stream();
    $i = $i + 1;
}

// 3. Start the stream one hundred thousand times and keep every object in an array.
array<Core\Sse> $kept = [];
$i = 0;
while ($i < 100000) {
    $kept[] = Core\Sse::stream();
    $i = $i + 1;
}

// 4. Send one event through the first object and one through the last.
$kept[0]->send('first');
$kept[99999]->send('last ' . $refused);
