<?nvs
// Attack: a `secret` value is bound into a statement that SQLite refuses. SQLite quotes the bad
// value in its error text. The error's `message` and `serverMessage` should not contain the value.

var $db = Core\Db::connect('notes');
$db->execute('create table notes (path text)', []);

string $plain = 'sk-8f2c41';
secret string $token = $plain;
bool $leaked = false;

// 1. Binds the secret as a JSON path. The path is not valid, so the statement fails.
try {
    $db->query("select json_extract('{}', ?)", [$token]);
} catch (Core\Db\DbError $error) {
    $leaked = Core\Str::contains($error->message, $plain)
        || Core\Str::contains($error->serverMessage ?? '', $plain);
    echo '1 leaked: ', $leaked ? 'yes' : 'no', "\n";
}

// 2. Binds the secret inside a batch of rows with `executeMany`.
try {
    $db->executeMany("insert into notes (path) values (json_extract('{}', ?))", [[$token]]);
} catch (Core\Db\DbError $error) {
    $leaked = Core\Str::contains($error->message, $plain)
        || Core\Str::contains($error->serverMessage ?? '', $plain);
    echo '2 leaked: ', $leaked ? 'yes' : 'no', "\n";
}

// 3. Binds a string built from the secret. The result of `.` is secret too.
try {
    $db->query("select json_extract('{}', ?)", ['path ' . $token]);
} catch (Core\Db\DbError $error) {
    $leaked = Core\Str::contains($error->message, $plain)
        || Core\Str::contains($error->serverMessage ?? '', $plain);
    echo '3 leaked: ', $leaked ? 'yes' : 'no', "\n";
}
