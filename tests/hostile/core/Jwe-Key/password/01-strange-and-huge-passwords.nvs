<?nvs
// Attack: a program makes keys from an empty password, a password with zero bytes, a password of
// sixteen million characters, and many passwords in a loop. Nothing may crash or hang.
// hostile: timeout-ms 30000

// 1. An empty password gives a key. Its token opens only with the empty password.
string $empty = Core\Jwe::encrypt('a note', Core\Jwe\Key::password(''));
if (Core\Jwe::decrypt($empty, [Core\Jwe\Key::password('')]) != 'a note') {
    throw new LogicError('the empty password did not open its token');
}
try {
    Core\Jwe::decrypt($empty, [Core\Jwe\Key::password(' ')]);
    throw new LogicError('a space opened a token of the empty password');
} catch (RuntimeError $space) {
}
echo 'step 1: done', "\n";

// 2. A password with a zero byte in the middle is different from the text before the zero byte.
string $zero = "abc\0def";
string $cut = Core\Jwe::encrypt('a note', Core\Jwe\Key::password($zero));
try {
    Core\Jwe::decrypt($cut, [Core\Jwe\Key::password('abc')]);
    throw new LogicError('the text before the zero byte opened the token');
} catch (RuntimeError $shorter) {
}
echo 'step 2: done', "\n";

// 3. A password of sixteen million characters is used once to encrypt and once to decrypt.
string $huge = Core\Str::repeat('ü', 16000000);
string $token = Core\Jwe::encrypt('a note', Core\Jwe\Key::password($huge));
if (Core\Jwe::decrypt($token, [Core\Jwe\Key::password($huge)]) != 'a note') {
    throw new LogicError('the long password did not open its token');
}
echo 'step 3: done', "\n";

// 4. One hundred thousand password keys are made and thrown away. The memory of each must be freed.
uint $i = 0;
while ($i < 100000) {
    Core\Jwe\Key::password('password ' . $i);
    $i = $i + 1;
}
echo 'step 4: done', "\n";
