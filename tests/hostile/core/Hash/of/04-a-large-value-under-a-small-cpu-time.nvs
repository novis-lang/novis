<?nvs
// Attack: a request hashes a large value again and again under a small CPU-time limit.
// One hash of the value takes most of the limit. The request should stop at the limit,
// even when the limit passes in the middle of one hash.
// hostile: ends-early 2 FATAL

// 1. Builds a string of 32 MiB.
echo "step 1\n";
string $large = Core\Str::repeat('a', 33554432);

// 2. Lowers the CPU-time limit to 300 ms. Then it hashes the string with SHA-3 until the limit stops it.
echo "step 2\n";
Core\Config::set('limits.cpu_time', '300ms');
while (true) {
    Core\Hash::of($large, Core\Hash::Digest::Sha3_512);
}
