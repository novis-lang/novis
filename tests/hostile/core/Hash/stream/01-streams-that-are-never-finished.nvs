<?nvs
// Attack: a program opens streams under every algorithm and never finishes most of them. Every
// open stream should be freed with its variable. The program must stop at its memory limit.
// hostile: ends-early

// A lower memory limit, so the last step reaches the limit quickly.
Core\Config::set('memory', '64M');

// 1. A stream under every algorithm, finished with nothing fed. Each digest has its normal size.
array<Core\Digest> $all = [
    Core\Digest::Crc32, Core\Digest::Md5, Core\Digest::Sha1, Core\Digest::Sha256,
    Core\Digest::Sha384, Core\Digest::Sha512, Core\Digest::Sha224, Core\Digest::Sha512_224,
    Core\Digest::Sha512_256, Core\Digest::Sha3_224, Core\Digest::Sha3_256, Core\Digest::Sha3_384,
    Core\Digest::Sha3_512, Core\Digest::Crc32c, Core\Digest::Blake3,
];
foreach ($all as Core\Digest $digest) {
    Core\Hash\Stream $empty = Core\Hash::stream($digest);
    echo 'empty: ', Core\Bytes::length($empty->finish()), " bytes\n";
}

// 2. One hundred thousand streams are opened and fed, and none is finished. Each one is
// freed when the variable gets the next stream, so memory use must stay flat.
string $piece = Core\Str::repeat('p', 1000);
uint $round = 0;
while ($round < 100000) {
    Core\Hash\Stream $abandoned = Core\Hash::stream(Core\Digest::Sha512);
    $abandoned->update($piece);
    $round = $round + 1;
}
echo "abandoned streams: freed\n";

// 3. Every stream is kept, and each one keeps its own text. This step ends the program at
// its memory limit.
array<Core\Hash\Stream> $kept = [];
uint $n = 0;
while (true) {
    Core\Hash\Stream $stream = Core\Hash::stream(Core\Digest::Blake3);
    $stream->update(Core\Str::repeat('k', 1000) . $n);
    $kept[] = $stream;
    $n = $n + 1;
}
