<?nvs
// Attack: a client sends a path that tries to climb out of the web folder, and the program keeps every path it reads.
// The path should come back exactly as sent. The program should stop at its memory limit.
// hostile: ends-early 3 FATAL

// 1. Reads the path. It has `..` parts, encoded slashes and an encoded zero byte.
tainted string $path = Core\Request::path();
echo 'length: ', Core\Str::length($path), "\n";

// 2. Reads the path many times. Every read returns the same text.
uint $same = 0;
uint $i = 0;
while ($i < 100000) {
    if (Core\Request::path() == $path) {
        $same = $same + 1;
    }
    $i = $i + 1;
}
echo 'same answer: ', $same, "\n";

// 3. Keeps every path without end. This stops at the memory limit.
echo "step 3\n";
array<tainted string> $kept = [];
while (true) {
    $kept[] = Core\Request::path();
}
