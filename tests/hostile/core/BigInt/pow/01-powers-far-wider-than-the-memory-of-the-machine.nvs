<?nvs
// Attack: `pow` is asked for answers far wider than the memory of the machine,
// and then for hundreds of thousands of small ones. Every answer that is too
// wide should throw an error, and the program should run to its last line.
// hostile: timeout-ms 20000

// 1. Powers whose answer would be wider than one call may produce. Each one
//    throws an `ArithmeticError` before it multiplies anything.
array<uint> $powers = [600000, 1000000, 4294967296, 9223372036854775807];
foreach ($powers as uint $power) {
    try {
        var $answer = Core\BigInt::of(2)->pow($power);
        echo 'built ', Core\Str::length($answer->toString()), " digits\n";
    } catch (ArithmeticError $tooWide) {
        echo "refused\n";
    }
}

// 2. A number of ten thousand digits is squared, which is allowed, and then
//    raised to the power 1000, which is not.
var $wide = Core\BigInt::parse(Core\Str::repeat('9', 10000));
echo Core\Str::length($wide->pow(2)->toString()), "\n";
try {
    var $wider = $wide->pow(1000);
    echo 'built ', Core\Str::length($wider->toString()), " digits\n";
} catch (ArithmeticError $stillTooWide) {
    echo "refused\n";
}

// 3. The power 0 and the power 1 on that same wide number. Both answer at
//    once and neither builds anything larger.
echo $wide->pow(0), "\n";
echo Core\Str::length($wide->pow(1)->toString()), "\n";

// 4. Two hundred thousand small powers, each thrown away again. The memory the
//    program holds must not grow with the rounds.
uint $round = 0;
int $signs = 0;
while ($round < 200000) {
    $signs = $signs + Core\BigInt::of(-3)->pow(7)->sign();
    $round = $round + 1;
}
echo $signs, "\n";
