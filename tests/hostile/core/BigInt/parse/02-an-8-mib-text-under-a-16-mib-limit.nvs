<?nvs
// Attack: a program lowers its memory limit to 16 MiB and parses a text of 8 MiB.
// The call should throw an error with a short message, and stay inside the limit.

// 1. Lowers the memory limit to `16M`.
echo 'limit lowered: ', Core\Config::set('limits.memory', '16M') ? 'yes' : 'no', "\n";

// 2. Parses 8 MiB of letters. This throws a `ParseError`, and its message is short.
string $text = Core\Str::repeat('a', 8388608);
try {
    echo Core\BigInt::parse($text), "\n";
} catch (Throwable $error) {
    echo Core\Str::length($error->message) < 200 ? 'short message' : 'long message', "\n";
}
