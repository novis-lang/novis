<?nvs
// Attack: base64 text is bent in every way that might still decode. A program
// that compares the text sees two different texts. If both gave the same
// bytes, an attacker could send again what was already refused once. Every
// bent text below should be refused, and every error here is caught.
// hostile: timeout-ms 30000

// 1. "YWJjZA==" and "YWJjZB==" differ only in bits the last symbol carries
// that no byte reads. Only the first should be read.
echo 'step 1: ', Core\Encoding::toHex(Core\Encoding::fromBase64('YWJjZA==')), "\n";
try {
    string $second = Core\Encoding::toHex(Core\Encoding::fromBase64('YWJjZB=='));
    echo 'step 1: a second spelling gave ', $second, "\n";
} catch (RuntimeError $secondSpelling) {
    echo 'step 1 stopped: ', $secondSpelling->message, "\n";
}

// 2. Every printable character in turn as the last symbol of a full group.
// The alphabet holds 64 of the 94.
uint $accepted = 0;
uint $octet = 33;
while ($octet < 127) {
    string $symbol = Core\Encoding::decodeText(Core\Bytes::fill(1, $octet), Core\Charset::Ascii);
    try {
        Core\Encoding::fromBase64('YWJ' . $symbol);
        $accepted = $accepted + 1;
    } catch (RuntimeError $outsideTheAlphabet) {
        $octet = $octet;
    }
    $octet = $octet + 1;
}
echo 'step 2: ', $accepted, " of 94 printable characters are base64 symbols\n";

// 3. Padding written in every wrong amount, and in the middle. An attacker
// puts it there to make two texts look different and read the same.
array<string> $padded = ['YWJjZA=', 'YWJjZA===', '=', '====', 'YW==Jj', 'YWJjZA==Jj'];
uint $refused = 0;
foreach ($padded as string $text) {
    try {
        Core\Encoding::fromBase64($text);
    } catch (RuntimeError $badPadding) {
        $refused = $refused + 1;
    }
}
echo 'step 3: ', $refused, " of 6 wrong paddings refused\n";

// 4. The whitespace an older reader used to skip. Each of these is a text a
// filter would compare as different, so each should be refused.
array<string> $spaced = ['YWJj ZA==', "YWJj\nZA==", "YWJj\tZA==", "YWJjZA==\n"];
uint $stopped = 0;
foreach ($spaced as string $loose) {
    try {
        Core\Encoding::fromBase64($loose);
    } catch (RuntimeError $whitespace) {
        $stopped = $stopped + 1;
    }
}
echo 'step 4: ', $stopped, " of 4 loose texts refused\n";

// 5. Eight million symbols of valid base64, read in one call. Every 4 symbols
// carry 3 bytes, so the answer is six million bytes.
string $long = Core\Str::repeat('YWJjZGVm', 1000000);
echo 'step 5: ', Core\Bytes::length(Core\Encoding::fromBase64($long)), "\n";

// 6. The same long text with one symbol taken off the end. It no longer ends
// on a whole group, so it should be refused.
try {
    Core\Encoding::fromBase64(Core\Str::slice($long, 0, 7999999));
    echo "step 6: the text was read\n";
} catch (RuntimeError $cutShort) {
    echo 'step 6 stopped: ', $cutShort->message, "\n";
}

// 7. One hundred thousand reads in a row, each round choosing its text from
// the size of the round before.
array<string> $texts = ['YWJjZA==', 'YWJj', 'YWJjZGVm', 'YQ=='];
uint $total = 0;
uint $round = 0;
while ($round < 100000) {
    $total = $total + Core\Bytes::length(Core\Encoding::fromBase64($texts[($total + $round) % 4]));
    $round = $round + 1;
}
echo 'step 7: ', $round, ' texts read, ', $total, " bytes in all\n";

echo "the runtime is still standing\n";
