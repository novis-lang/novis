<?nvs
// Attack: base32 text is bent in every way that might still decode. Two
// different texts must never give the same bytes. A program that stored a
// secret under its written form would otherwise hold one secret twice. Every
// bent text should be refused, and every error here is caught.
// hostile: timeout-ms 30000

// 1. "MZXW6" and "MZXW7" differ only in a spare bit the last symbol carries,
// which has to be zero. Only the first should be read.
echo 'step 1: ', Core\Encoding::toHex(Core\Encoding::fromBase32('MZXW6')), "\n";
try {
    string $second = Core\Encoding::toHex(Core\Encoding::fromBase32('MZXW7'));
    echo 'step 1: a second spelling gave ', $second, "\n";
} catch (RuntimeError $secondSpelling) {
    echo 'step 1 stopped: ', $secondSpelling->message, "\n";
}

// 2. Every printable character in turn as the last symbol of a full group.
// The alphabet holds 58 of the 94, counting both cases of each letter.
uint $accepted = 0;
uint $octet = 33;
while ($octet < 127) {
    string $symbol = Core\Encoding::decodeText(Core\Bytes::fill(1, $octet), Core\Charset::Ascii);
    try {
        Core\Encoding::fromBase32('MZXW6YT' . $symbol);
        $accepted = $accepted + 1;
    } catch (RuntimeError $outsideTheAlphabet) {
        $octet = $octet;
    }
    $octet = $octet + 1;
}
echo 'step 2: ', $accepted, " of 94 printable characters are base32 symbols\n";

// 3. Padding written in every wrong amount. A group takes padding in full or
// not at all, so each of these should be refused.
array<string> $padded = ['MZXW6=', 'MZXW6==', 'MZXW6====', 'MZXW6=========', '=', '========'];
uint $refused = 0;
foreach ($padded as string $text) {
    try {
        Core\Encoding::fromBase32($text);
    } catch (RuntimeError $badPadding) {
        $refused = $refused + 1;
    }
}
echo 'step 3: ', $refused, " of 6 wrong paddings refused\n";

// 4. A padding character in the middle, where an attacker would put it to make
// two texts look different and decode the same.
try {
    Core\Encoding::fromBase32('MZ=XW6YT');
    echo "step 4: the text was read\n";
} catch (RuntimeError $inTheMiddle) {
    echo 'step 4 stopped: ', $inTheMiddle->message, "\n";
}

// 5. Eight million symbols of valid base32, read in one call. Every 8 symbols
// carry 5 bytes, so the answer is five million bytes.
string $long = Core\Str::repeat('MZXW6YTB', 1000000);
echo 'step 5: ', Core\Bytes::length(Core\Encoding::fromBase32($long)), "\n";

// 6. The same long text with two symbols taken off the end. Its last group is
// short, and the message should name where that group starts.
try {
    Core\Encoding::fromBase32(Core\Str::slice($long, 0, 7999998));
    echo "step 6: the text was read\n";
} catch (RuntimeError $cutShort) {
    echo 'step 6 stopped: ', $cutShort->message, "\n";
}

// 7. One hundred thousand reads in a row, each round choosing its text from the
// size of the round before.
array<string> $texts = ['MZXW6YTB', 'mzxw6ytb', 'MZXW6===', 'NBSWY3DP'];
uint $total = 0;
uint $round = 0;
while ($round < 100000) {
    $total = $total + Core\Bytes::length(Core\Encoding::fromBase32($texts[$total % 4]));
    $round = $round + 1;
}
echo 'step 7: ', $round, ' texts read, ', $total, " bytes in all\n";

echo "the runtime is still standing\n";
