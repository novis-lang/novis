<?nvs
// Attack: a program signs claims that are very deep, that point back to themselves or that are
// very large, and uses bad keys and lifetimes. Each call must return a token or throw an error.
// hostile: timeout-ms 30000

#[Core\Json\Derive]
final class Node
{
    public string $name;
    public ?Node $next;

    public function constructor(string $name, ?Node $next)
    {
        $this->name = $name;
        $this->next = $next;
    }
}

#[Core\Json\Derive]
final class Blob
{
    public string $sub;
    public string $data;

    public function constructor(string $sub, string $data)
    {
        $this->sub = $sub;
        $this->data = $data;
    }
}

final class Plain
{
    public string $sub;

    public function constructor(string $sub)
    {
        $this->sub = $sub;
    }
}

Core\Crypto\KeyPair $pair = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519);

// 1. A chain of one hundred thousand objects, each inside the one before. This is far deeper
// than the JSON encoder allows, so the call throws a `LogicError`.
?Node $chain = null;
uint $n = 0;
while ($n < 100000) {
    $chain = new Node('n' . $n, $chain);
    $n = $n + 1;
}
try {
    Core\Jwt::signObject($chain as Node, 1h, $pair);
    throw new RuntimeError('a chain of one hundred thousand objects was signed');
} catch (LogicError $tooDeep) {
}
echo 'step 1: done', "\n";

// 2. An object that points to itself. The encoder never ends on it, so the call throws a
// `LogicError`.
Node $loop = new Node('loop', null);
$loop->next = $loop;
try {
    Core\Jwt::signObject($loop, 1h, $pair);
    throw new RuntimeError('an object that points to itself was signed');
} catch (LogicError $cycle) {
}
$loop->next = null;
echo 'step 2: done', "\n";

// 3. One claim of sixteen million characters is signed. The payload of the token must have
// all of it.
string $long = Core\Str::repeat('é', 16000000);
string $big = Core\Jwt::signObject(new Blob('1', $long), 1h, $pair);
if (Core\Str::length($big) < 32000000) {
    throw new LogicError('the long claim was cut');
}
echo 'step 3: done', "\n";

// 4. Each of these calls must throw a `LogicError`: a class without `#[Core\Json\Derive]`,
// a field named `exp`, a lifetime of zero, a negative lifetime and an `X25519` key pair.
uint $refused = 0;
try {
    Core\Jwt::signObject(new Plain('1'), 1h, $pair);
} catch (LogicError $noJson) {
    $refused = $refused + 1;
}
try {
    Core\Jwt::signObject(Core\Arr::shapeAs<{exp: int}>(['exp' => 9999999999]), 1h, $pair);
} catch (LogicError $exp) {
    $refused = $refused + 1;
}
try {
    Core\Jwt::signObject(new Blob('1', 'x'), 0s, $pair);
} catch (LogicError $zero) {
    $refused = $refused + 1;
}
try {
    Core\Jwt::signObject(new Blob('1', 'x'), Core\Time\Duration::seconds(1)->negated(), $pair);
} catch (LogicError $negative) {
    $refused = $refused + 1;
}
try {
    Core\Jwt::signObject(
        new Blob('1', 'x'),
        1h,
        Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519),
    );
} catch (LogicError $agreesOnly) {
    $refused = $refused + 1;
}
if ($refused != 5) {
    throw new LogicError('a bad claims object, lifetime or key signed a token');
}
echo 'step 4: done', "\n";

// 5. A short token is signed twenty thousand times. Only the length is kept, so the memory of
// each token must be freed.
uint $first = Core\Str::length(Core\Jwt::signObject(new Blob('7', 'x'), 1h, $pair));
uint $i = 0;
while ($i < 20000) {
    Core\Jwt::signObject(new Blob('7', 'x'), 1h, $pair);
    $i = $i + 1;
}
echo 'step 5: done ', $first > 0 ? 'ok' : 'empty', "\n";
