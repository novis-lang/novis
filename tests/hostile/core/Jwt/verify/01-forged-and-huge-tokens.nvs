<?nvs
// Attack: a client sends forged, broken and very large tokens. Each one must throw a
// `RuntimeError`, and the program must not crash.
// hostile: timeout-ms 30000

secret bytes $key = Core\Crypto::generateKey();
string $token = Core\Jwt::sign(['sub' => '42'], 1h, $key);
array<string> $parts = Core\Str::split($token, '.');

class Check
{
    // Returns 1 when `verify` throws a `RuntimeError`. Any other result stops the program.
    public static function refused(string $token, secret bytes $key): uint
    {
        try {
            Core\Jwt::verify($token, $key);
        } catch (RuntimeError $refused) {
            return 1;
        }
        throw new LogicError('a forged token was accepted');
    }

    public static function part(string $json): string
    {
        return Core\Encoding::toBase64Url(Core\Encoding::encodeText($json, Core\Charset::Utf8));
    }
}

// 1. Tokens with the wrong number of parts, or with empty parts.
uint $n = 0;
array<string> $shapes = ['', '.', '..', '...', 'a.b', 'a.b.c.d', $token . '.', '.' . $token];
foreach ($shapes as string $broken) {
    $n = $n + Check::refused($broken, $key);
}
echo 'step 1: done ', $n, "\n";

// 2. Headers that name no algorithm, the algorithm `none`, or a different spelling of `HS256`.
$n = 0;
array<string> $headers = ['{}', '{"alg":"none"}', '{"alg":"hs256"}', '{"alg":"HS256 "}', '{"alg":["HS256"]}', 'null'];
foreach ($headers as string $header) {
    $n = $n + Check::refused(Check::part($header) . '.' . $parts[1] . '.' . $parts[2], $key);
}
echo 'step 2: done ', $n, "\n";

// 3. A header of one hundred thousand nested JSON lists. It must be refused, and the reader must
// not run out of stack.
string $deep = Core\Str::repeat('[', 100000) . Core\Str::repeat(']', 100000);
$n = Check::refused(Check::part($deep) . '.' . $parts[1] . '.' . $parts[2], $key);
echo 'step 3: done ', $n, "\n";

// 4. A token of thirty million characters. It is read and refused.
string $huge = Core\Str::repeat('A', 10000000);
$n = Check::refused($huge . '.' . $huge . '.' . $huge, $key);
echo 'step 4: done ', $n, "\n";

// 5. The claims are changed and the old signature is kept.
$n = Check::refused($parts[0] . '.' . Check::part('{"sub":"1","exp":9999999999}') . '.' . $parts[2], $key);
echo 'step 5: done ', $n, "\n";

// 6. A valid token is checked one hundred thousand times. Only the count is kept, so the memory
// of each result must be freed.
uint $claims = 0;
uint $i = 0;
while ($i < 100000) {
    $claims = $claims + Core\Arr::count(Core\Jwt::verify($token, $key));
    $i = $i + 1;
}
echo 'step 6: done ', $claims, "\n";

// 7. A key one byte too short throws a `LogicError`.
try {
    Core\Jwt::verify($token, Core\Random::bytes(31));
    throw new RuntimeError('a key of 31 bytes checked a token');
} catch (LogicError $short) {
}
echo 'step 7: done', "\n";
