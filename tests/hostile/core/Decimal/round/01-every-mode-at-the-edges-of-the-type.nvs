<?nvs
// Attack: every rounding mode is asked for scales no `decimal` holds, and is
// given the widest and the narrowest values the type can write. Every attempt
// should return an answer or throw an error. The runtime should still be
// standing at the end.
// hostile: timeout-ms 30000

array<Core\RoundMode> $modes = [
    Core\RoundMode::HalfUp,
    Core\RoundMode::HalfDown,
    Core\RoundMode::HalfEven,
    Core\RoundMode::HalfOdd,
    Core\RoundMode::Up,
    Core\RoundMode::Down,
];

// 1. One digit more than the 28 a `decimal` holds, under each mode. Every
// mode refuses the scale. The errors are caught, so the steps after this one
// still run.
uint $refused = 0;
foreach ($modes as Core\RoundMode $mode) {
    try {
        Core\Decimal::round(1.5, $mode, 29);
    } catch (ArithmeticError $tooManyDigits) {
        $refused = $refused + 1;
    }
}
echo 'step 1: ', $refused, " of 6 modes refused scale 29\n";

// 2. The largest scale a whole number can be written as. The same refusal,
// from the other end of the range.
try {
    Core\Decimal::round(1.5, Core\RoundMode::HalfUp, 18446744073709551615);
    echo "step 2: the value was rounded\n";
} catch (ArithmeticError $far) {
    echo 'step 2 stopped: ', $far->message, "\n";
}

// 3. The largest value a `decimal` holds, rounded to a whole number. It is
// already whole, so every mode gives the value itself.
decimal $wide = 79228162514264337593543950335;
echo 'step 3: ', Core\Decimal::round($wide, Core\RoundMode::Up), "\n";

// 4. The same value asked for at 28 digits after the point. The digits before
// the point and the digits after it do not fit in one number together.
try {
    Core\Decimal::round($wide, Core\RoundMode::HalfEven, 28);
    echo "step 4: the value was rounded\n";
} catch (ArithmeticError $doesNotFit) {
    echo 'step 4 stopped: ', $doesNotFit->message, "\n";
}

// 5. The smallest value a `decimal` can write, and the same value below zero.
// `Up` moves away from zero, so both grow into a whole unit.
decimal $tiny = 0.0000000000000000000000000001;
echo 'step 5: ', Core\Decimal::round($tiny, Core\RoundMode::Up), ' ',
    Core\Decimal::round(-$tiny, Core\RoundMode::Up), "\n";

// 6. A value of 28 nines, rounded at every scale from 28 down to 0. Each step
// keeps one digit fewer, and the carry runs through all of them.
decimal $long = -0.9999999999999999999999999999;
uint $scale = 29;
while ($scale > 0) {
    $scale = $scale - 1;
    $long = Core\Decimal::round($long, Core\RoundMode::HalfUp, $scale);
}
echo 'step 6: ', $long, "\n";

// 7. One million roundings in a row, each one rounding the answer the round
// before it gave.
decimal $carried = 0.0;
decimal $added = 1.9995;
uint $round = 0;
while ($round < 1000000) {
    $carried = Core\Decimal::round($carried + $added, Core\RoundMode::HalfEven, 3);
    $round = $round + 1;
}
echo 'step 7: ', $round, ' roundings made, last answer ', $carried, "\n";

echo "the runtime is still standing\n";
