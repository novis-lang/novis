<?nvs
// Attack: an exact division is given divisors at both ends of the range, a
// zero, and quotients that repeat forever. Every attempt should return an
// exact answer or throw an error. The runtime should still be standing at the
// end.
// hostile: timeout-ms 30000

// 1. Dividing by zero. The error is caught, so the steps after this one still
// run.
try {
    Core\Decimal::divExact(1.00, 0);
    echo "step 1: the division was made\n";
} catch (ArithmeticError $byZero) {
    echo 'step 1 stopped: ', $byZero->message, "\n";
}

// 2. A quotient with no end. One third of one has no last digit, so there is
// no exact answer to give.
try {
    Core\Decimal::divExact(1, 3);
    echo "step 2: the division was made\n";
} catch (ArithmeticError $repeats) {
    echo 'step 2 stopped: ', $repeats->message, "\n";
}

// 3. The smallest divisor a `decimal` can write. The quotient is the largest
// whole number the type holds, so this one still has an exact answer.
decimal $tiny = 0.0000000000000000000000000001;
echo 'step 3: ', Core\Decimal::divExact(1, $tiny), "\n";

// 4. The largest value a `decimal` holds, divided by the smallest. The other
// end of the same boundary.
decimal $wide = 79228162514264337593543950335;
try {
    Core\Decimal::divExact($wide, $tiny);
    echo "step 4: the division was made\n";
} catch (ArithmeticError $overflowed) {
    echo 'step 4 stopped: ', $overflowed->message, "\n";
}

// 5. The last quotient that does fit, and the first that does not. Dividing by
// two adds one digit each time, so the twenty-eighth is the last one.
decimal $carried = 1;
uint $step = 0;
while ($step < 28) {
    $carried = Core\Decimal::divExact($carried, 2);
    $step = $step + 1;
}
echo 'step 5: ', $carried, "\n";
try {
    Core\Decimal::divExact($carried, 2);
    echo "step 5b: the division was made\n";
} catch (ArithmeticError $oneTooFar) {
    echo 'step 5b stopped: ', $oneTooFar->message, "\n";
}

// 6. Two million divisions in a row, each one exact and each one dividing the
// answer the round before it gave.
decimal $counted = 0;
uint $round = 0;
while ($round < 2000000) {
    $counted = Core\Decimal::divExact($counted * 2 + 2, 2);
    $round = $round + 1;
}
echo 'step 6: ', $round, ' divisions made, last answer ', $counted, "\n";

echo "the runtime is still standing\n";
