<?nvs
// Attack: a program adds a very large amount of work to run after the response.
// Some of it throws, waits past its time limit or tries to add more work.
// Each bad closure should stop cleanly, and the closures after it should still run.
// hostile: timeout-ms 30000

// Step 1: a task started by `Core\Task::all` tries to add work. This is not
// allowed, and the error is caught so the next steps still run.
var $fromTask = Core\Task::all({
    tried: fn (): string => {
        try {
            Core\Task::afterResponse(fn (): void => {
                echo "never\n";
            });
            return 'allowed';
        } catch (RuntimeError $e) {
            return 'not allowed';
        }
    },
});
echo 'step 1: ', $fromTask->tried, "\n";

// Step 2: add 100,000 closures. Each one uses the same text of 16 million
// characters, so the closures share it and memory stays small.
string $big = Core\Str::repeat('w', 16000000);
uint $i = 0;
while ($i < 100000) {
    Core\Task::afterResponse(fn (): void => {
        uint $size = Core\Str::length($big);
    });
    $i = $i + 1;
}
echo 'step 2: added ', $i, "\n";

// Step 3: a closure throws an error. The error is written to the log,
// and the next closure still runs.
Core\Task::afterResponse(fn (): void => {
    throw new RuntimeError('the webhook failed');
});
Core\Task::afterResponse(fn (): void => {
    echo "step 3: the closure after the error ran\n";
});

// Step 4: a closure tries to add one more closure. This is not allowed,
// and the error is caught inside the closure.
Core\Task::afterResponse(fn (): void => {
    try {
        Core\Task::afterResponse(fn (): void => {
            echo "never either\n";
        });
        echo "step 4: allowed\n";
    } catch (RuntimeError $e) {
        echo "step 4: not allowed\n";
    }
});

// Step 5: closures wait longer than their time limit: 5 milliseconds, zero,
// and a negative time. Each one is stopped, and the next closure still runs.
Core\Task::afterResponse(fn (): void => {
    Core\Time::sleep(10s);
    echo "step 5: never\n";
}, { deadline: 5ms });
Core\Task::afterResponse(fn (): void => {
    Core\Time::sleep(10s);
    echo "step 5: never\n";
}, { deadline: 0s });
Core\Task::afterResponse(fn (): void => {
    Core\Time::sleep(10s);
    echo "step 5: never\n";
}, { deadline: 1000000s->negated() });
Core\Task::afterResponse(fn (): void => {
    echo "step 5: the closure after the stopped ones ran\n";
});

// Step 6: the program ends normally, and all the work above runs now.
echo "step 6: the response is done\n";
