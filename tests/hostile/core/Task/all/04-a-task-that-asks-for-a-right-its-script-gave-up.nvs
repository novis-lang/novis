<?nvs
// Attack: a script is started with fewer rights than the program has. Its tasks try
// to use a right the script gave up. Every try should be refused.

// `Here::path` returns its argument as a full path. A relative path written in quotes
// starts at the folder of this file.
class Here
{
    public static function path(#[Core\Path] string $path): string
    {
        return $path;
    }
}

// 1. The script may only read files. Its tasks connect to the network, in groups
// nested 50 deep, and one task starts a script with more rights.
string $job = Here::path('jobs/asks-from-its-tasks.nvs');
var $run = spawn script $job with(grants: ['fs.read'], output: 'capture');
var $done = await $run;
echo $done->output;

// 2. The same script, started 100 times at once. No start may give its tasks a right.
uint $allowed = 0;
uint $i = 0;
while ($i < 100) {
    var $next = spawn script $job with(grants: ['fs.read'], output: 'capture');
    var $again = await $next;
    if (Core\Str::contains($again->output as string, 'allowed')) {
        $allowed = $allowed + 1;
    }
    $i = $i + 1;
}
echo 'starts with a right: ', $allowed, "\n";
