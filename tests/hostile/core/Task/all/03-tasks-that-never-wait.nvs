<?nvs
// Attack: two tasks count in a loop that never ends and never waits. The deadline
// of the call should stop both tasks, and no task should still count after the call returns.
// hostile: timeout-ms 5000

class Counter
{
    public static int $count = 0;
}

// 1. Lowers the CPU limit of this request to 200 milliseconds, so a missed deadline ends the program.
echo 'CPU limit: ', Core\Config::set('limits.cpu_time', '200ms') ? 'lowered' : 'not changed', "\n";

// 2. Starts the two tasks with a deadline of 50 milliseconds, and catches the `TimeoutError`.
echo "step 2\n";
try {
    Core\Task::all({
        a: fn(): int => {
            while (true) {
                Counter::$count += 1;
            }
            return Counter::$count;
        },
        b: fn(): int => {
            while (true) {
                Counter::$count += 1;
            }
            return Counter::$count;
        },
    }, { deadline: 50ms });
    echo "the tasks returned\n";
} catch (TimeoutError $e) {
    echo "the deadline stopped the tasks\n";
}

// 3. Waits 20 milliseconds and checks that the count did not change.
echo "step 3\n";
int $before = Counter::$count;
Core\Time::sleep(20ms);
echo 'still counting: ', Counter::$count == $before ? 'no' : 'yes', "\n";
