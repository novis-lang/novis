<?nvs
namespace Novis\Rest;

// The client credentials grant: a client requests a token for itself, with no user.
// A server application uses it to call another service.
final class ClientCredentials
{
    // Returns a token for `$scope`. The token is kept in the memory cache of this
    // process until 30 seconds before it expires, so most calls send no request.
    // `$keys` encrypt the token in the cache. `Core\Crypto::generateKey()` creates one.
    // A DPoP token is only returned to a client with the same DPoP key.
    public static function token(Client $client, string $scope, array<secret bytes> $keys): Token
    {
        Core\Cache\Store $cache = Core\Cache::memory();
        string $key = ClientCredentials::cacheKey($client, $scope);

        ?secret string $cached = $cache->getSecret($key . '.token', $keys);
        ?tainted string $details = $cache->get($key . '.details') as ?tainted string;
        if ($cached != null && $details != null) {
            ?Token $hit = ClientCredentials::rebuild($cached, $details);
            if ($hit != null && !$hit->isExpired()) {
                return $hit;
            }
        }

        Token $token = ClientCredentials::request($client, $scope);
        int $seconds = $token->expiresAt->toEpochSeconds() - Core\Time::now()->toEpochSeconds() - 30;
        if ($seconds > 0) {
            Core\Time\Duration $ttl = Core\Time\Duration::seconds($seconds);
            $cache->putSecret($key . '.token', $token->accessToken, $ttl, $keys);
            string $text = $token->type . ' ' . $token->expiresAt->toEpochSeconds() . ' ' . $token->scope;
            $cache->put($key . '.details', $text, { ttl: $ttl });
        }
        return $token;
    }

    // Requests a new token for `$scope` and does not use the cache.
    // An empty `$scope` sends no `scope`, so the server uses its default.
    public static function request(Client $client, string $scope): Token
    {
        array<secret string> $form = ['grant_type' => 'client_credentials'];
        if ($scope != '') {
            $form['scope'] = $scope;
        }
        return $client->requestToken($form);
    }

    // The key is a hash of the token endpoint, the client id, the scope and the DPoP key.
    private static function cacheKey(Client $client, string $scope): string
    {
        ?DPoP $dpop = $client->dpop();
        string $thumbprint = '';
        if ($dpop != null) {
            $thumbprint = $dpop->thumbprint();
        }
        string $text = $client->tokenEndpoint . "\n" . $client->clientId . "\n" . $scope . "\n" . $thumbprint;
        return 'novis-rest.client-credentials.' . Core\Encoding::toHex(Core\Hash::of($text, Core\Hash::Digest::Sha256));
    }

    // `$details` is the token type, the expiry in seconds and the scope, separated by spaces.
    // The text is checked before it is used, like any value read back from a cache.
    private static function rebuild(secret string $accessToken, tainted string $details): ?Token
    {
        if (!Core\Regex::matches($details, '^(Bearer|DPoP) [0-9]{1,12} [\x21\x23-\x5B\x5D-\x7E ]*$')) {
            return null;
        }
        string $checked = Core\Taint::assertTrusted($details, 'the text is a token type, a number and a scope');
        array<string> $parts = Core\Str::split($checked, ' ', { limit: 3 });
        if (Core\Arr::count($parts) != 3) {
            return null;
        }
        ?int $expiry = $parts[1] as ?int;
        if ($expiry == null) {
            return null;
        }
        return new Token($accessToken, $parts[0], Core\Time::fromEpoch($expiry), null, $parts[2]);
    }
}
