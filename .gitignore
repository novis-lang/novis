# Rust build output
/target
**/target
*.pdb

# Cargo
Cargo.lock.bak

# Novis artifact cache (content-addressed native code; never committed)
/.nvs-cache
*.nvso

# Insta snapshot review leftovers
*.snap.new
*.pending-snap

# Fuzzing
/fuzz/target
/fuzz/corpus
/fuzz/artifacts

# Local-only real-world PHP corpus for the M1 corpus-parse test
# (crates/nvs-syntax/tests/corpus_parse.rs) — never committed.
/php-src

# Profiling / benchmark output
/benches/results
perf.data*
flamegraph.svg
*.profraw

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.iml
*.swp
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Local developer config (nvs.toml is server config; keep local overrides out)
/nvs.local.toml
/.env

# Machine-local agent/tool settings
.claude/settings.local.json

# Bytecode from importing a repo script under tools/
__pycache__/

# Unattended loop run artifacts (see docs/agent/coordinator.md). Everything the
# driver writes at run time lives under one directory, so this is one line.
/.loop/

# The CA copied out of the database matrix's containers by a test that wants to
# verify the chain rather than merely encrypt (tests/db/compose.yaml's header).
/tests/db/ca.crt

# Scratch commit-message file (AGENTS.md: a multi-line message goes through a
# file, never an inline `-m`); never part of the tree it describes.
/.agent-tmp/

a.out