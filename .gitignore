# Rust build output
/target
**/target
*.pdb

# Cargo
Cargo.lock.bak

# MWL artifact cache (content-addressed native code; never committed)
/.mwl-cache
*.mwlo

# Insta snapshot review leftovers
*.snap.new
*.pending-snap

# Fuzzing
/fuzz/target
/fuzz/corpus
/fuzz/artifacts

# Local-only real-world PHP corpus for the M1 corpus-parse test
# (crates/mwl-syntax/tests/corpus_parse.rs) — never committed.
/php-src

# Profiling / benchmark output
/benches/results
perf.data*
flamegraph.svg
*.profraw

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.iml
*.swp
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Local developer config (mwl.toml is server config; keep local overrides out)
/mwl.local.toml
/.env

# Machine-local agent/tool settings
.claude/settings.local.json

# Bytecode from importing a repo script (brief.py's --check mode is imported by tests)
__pycache__/

# Unattended loop run artifacts (see AGENT_COORDINATOR_PROMPT.md)
.claude/loop-log.md
.claude/loop-logs/
.claude/loop-status.txt
.claude/loop-stop

# Scratch commit-message file (CLAUDE.md: a multi-line message goes through a
# file, never an inline `-m`); never part of the tree it describes.
.claude/commitmsg.txt
