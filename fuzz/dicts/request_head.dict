# The tokens a request head is built from, for `request_head`. The line endings
# are escapes, because the repository checks every text file out with LF.
crlf="\x0D\x0A"
end_of_head="\x0D\x0A\x0D\x0A"
lf="\x0A"
cr="\x0D"
get="GET / HTTP/1.1\x0D\x0A"
post="POST / HTTP/1.1\x0D\x0A"
host="Host: a\x0D\x0A"
length="Content-Length: "
length_lower="content-length:"
encoding="Transfer-Encoding: "
chunked="chunked"
gzip_chunked="gzip, chunked"
comma=", "
fold="\x0D\x0A\x09"
last_chunk="0\x0D\x0A\x0D\x0A"
chunk="5\x0D\x0Ahello\x0D\x0A"
extension=";x=y"
expect="Expect: 100-continue\x0D\x0A"
