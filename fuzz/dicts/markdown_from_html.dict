# The tokens HTML documents are built from, for `markdown_from_html`, and a
# few of Markdown's, since the target reads its input as both.
lf="\x0A"
blank="\x0A\x0A"
p="<p>"
p_end="</p>"
br="<br>"
div="<div>"
div_end="</div>"
span="<span>"
h1="<h1>"
h3="<h3>"
em="<em>"
strong="<strong>"
b="<b>"
i="<i>"
del="<del>"
code="<code>"
code_lang="<code class=\"language-rust\">"
pre="<pre>"
pre_end="</pre>"
blockquote="<blockquote>"
ul="<ul>"
ol="<ol start=\"7\">"
li="<li>"
li_end="</li>"
dl="<dl><dt>"
dd="<dd>"
hr="<hr>"
a="<a href=\"/u\">"
a_title="<a href=\"/u\" title=\"t\">"
a_end="</a>"
img="<img src=\"/i.png\" alt=\"a\">"
table="<table>"
thead="<thead>"
tbody="<tbody>"
tr="<tr>"
th="<th>"
td="<td>"
td_align="<td align=\"center\">"
colspan="<td colspan=\"2\">"
input="<input type=\"checkbox\" disabled checked>"
script="<script>"
style="<style>"
comment="<!-- "
entity="&amp;"
lt="&lt;"
nbsp="&nbsp;"
backtick="`"
fence="```"
star="*"
under="_"
hash="# "
dash="- "
pipe="|"
bracket="["
escape="\\"
js="javascript:"
