# The tokens CommonMark and GFM documents are built from, for `markdown`.
# CI and `bun nv fuzz` pass this file to `markdown_comrak` too. The first byte
# of a `markdown` input is the piece size.
lf="\x0A"
crlf="\x0D\x0A"
blank="\x0A\x0A"
tab="\x09"
nul="\x00"
indent="    "
heading="# "
heading6="###### "
setext="\x0A===\x0A"
setext2="\x0A---\x0A"
rule="\x0A***\x0A"
quote="> "
bullet="- "
star="* "
plus="+ "
ordered="1. "
ordered_paren="1) "
task="- [ ] "
task_done="- [x] "
fence="```"
fence_tilde="~~~"
fence_lang="```rust\x0A"
emphasis="*"
strong="**"
under="_"
strike="~~"
code="`"
link="[a](/u)"
link_title="[a](/u \"t\")"
image="![a](/i.png)"
ref_use="[a]"
ref_full="[b][a]"
ref_def="[a]: /u\x0A"
ref_def_title="[a]: /u 't'\x0A"
footnote_use="[^1]"
footnote_def="[^1]: note\x0A"
autolink="<https://example.com>"
email="<a@example.com>"
www="www.example.com"
http="https://example.com/a?b"
table_head="| a | b |\x0A"
table_rule="|---|:-:|\x0A"
table_row="| 1 | 2 |\x0A"
pipe="|"
escape="\\"
hard_break="  \x0A"
entity="&amp;"
entity_num="&#65;"
entity_hex="&#x41;"
html_div="<div>"
html_div_end="</div>"
html_span="<span a=\"1\">"
html_comment="<!-- "
html_comment_end=" -->"
html_script="<script>"
html_pre="<pre>"
html_table="<table><tr><td>"
cdata="<![CDATA["
processing="<?"
declaration="<!X"
js="javascript:"
data="data:"
scheme_relative="//"
