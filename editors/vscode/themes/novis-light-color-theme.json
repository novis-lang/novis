{
  "$schema": "vscode://schemas/color-theme",
  "name": "Novis Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#1F1F1F",
    "editorCursor.foreground": "#000000",
    "editor.lineHighlightBackground": "#F5F8FE",
    "editor.selectionBackground": "#A6D2FF",
    "editor.inactiveSelectionBackground": "#D5E4F7",
    "editor.wordHighlightBackground": "#E4E4FF",
    "editor.findMatchHighlightBackground": "#FFE29A",
    "editorLineNumber.foreground": "#AEB3C2",
    "editorLineNumber.activeForeground": "#767A8A",
    "editorIndentGuide.background1": "#EBECF0",
    "editorIndentGuide.activeBackground1": "#C9CCD6",
    "editorWhitespace.foreground": "#D3D5DB",
    "editorBracketMatch.background": "#DBE6F5",
    "editorBracketMatch.border": "#B4C4DE"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8C8C8C", "fontStyle": "italic" }
    },
    {
      "scope": ["comment.line.documentation", "comment.block.documentation"],
      "settings": { "foreground": "#5F7F64", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#067D17" }
    },
    {
      "scope": ["meta.embedded", "meta.template.expression"],
      "settings": { "foreground": "#1F1F1F" }
    },
    {
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": { "foreground": "#0037A6" }
    },
    {
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#1750EB" }
    },
    {
      "scope": ["constant.language"],
      "settings": { "foreground": "#0033B3" }
    },
    {
      "scope": ["constant.other", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#871094", "fontStyle": "italic" }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.nvs"
      ],
      "settings": { "foreground": "#0033B3" }
    },
    {
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#1F1F1F" }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": { "foreground": "#36598A" }
    },
    {
      "scope": ["punctuation.section.embedded.begin", "punctuation.section.embedded.end"],
      "settings": { "foreground": "#0033B3" }
    },
    {
      "scope": ["variable.language"],
      "settings": { "foreground": "#0033B3" }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": { "foreground": "#871094" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": { "foreground": "#1F1F1F" }
    },
    {
      "scope": ["entity.name.type.interface"],
      "settings": { "foreground": "#1F1F1F", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#795E26" }
    },
    {
      "scope": [
        "meta.attribute",
        "punctuation.definition.attribute",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.decorator"
      ],
      "settings": { "foreground": "#9E880D" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#0033B3" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#174AD4" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#0033B3", "fontStyle": "bold" }
    },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline"], "settings": { "fontStyle": "underline" } },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#067D17" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#2A5DB0" }
    },
    { "scope": ["markup.quote"], "settings": { "foreground": "#8C8C8C" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#067D17" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#C7222D" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#2A5DB0" } },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#F50000" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#1F1F1F",
    "class": "#1F1F1F",
    "interface": { "foreground": "#1F1F1F", "italic": true },
    "enum": "#1F1F1F",
    "type": "#1F1F1F",
    "typeParameter": "#1F1F1F",
    "struct": "#1F1F1F",
    "method": "#795E26",
    "function": "#795E26",
    "property": "#871094",
    "enumMember": { "foreground": "#871094", "italic": true },
    "decorator": "#9E880D",
    "parameter": "#36598A",
    "variable": "#36598A",
    "*.tainted": { "underline": true },
    "*.secret": { "italic": true }
  }
}
