<?nvs
// The file the concealment is asserted over, and the only fixture with more than one thing to conceal.
//
// Two `secret` literals, because one proves nothing about a reveal: `nvs.revealSecret` uncovers the range
// it is fired on and leaves every other one covered (`rule:ide/reveal-is-explicit-and-window-local`), and
// a file with a single literal in it cannot tell that apart from uncovering the document. Both are used,
// so each is a binding the server answers a range for rather than a name the resolver never sees.
//
// The `tainted` declaration is here for the decoration that must *not* be drawn: with `nvs.taint.mark`
// at its default the marker is handed no ranges at all (`rule:ide/tainted-has-no-default-decoration`), and
// that assertion is empty of meaning unless there is something in the file the setting would mark.

secret string $token = 'sk-live-7c9f4d2b8a1e';
secret string $signing = 'correct horse battery staple';

string $stored = Core\Password::hash($token);
if (Core\Password::verify($signing, $stored)) {
    echo 'the two literals differ', "\n";
}

tainted string $submitted = '<p>Great post!</p><script>alert(1)</script>';
Core\Html\Markup $clean = Core\Html::sanitize($submitted);
echo Core\Html::toSource($clean, 'the fixture shows what it sanitized'), "\n";
