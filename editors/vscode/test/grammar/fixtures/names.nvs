<?nvs
namespace App\Orders;

use App\Shared\Base;

final class Order extends Base implements \App\Shared\Priced, Feed<Line> by $feed {
    enum Status { Draft, Paid }

    public string $label = "unnamed";

    public function total(uint $count): decimal {
        $sum = $this->subtotal;
        $rate = self::RATE;
        $made = App\Shared\Money::of($count)->convert<Line>();
        $sorter = Ledger::compare;
        $limit = Ledger::LIMIT;
        parent::reset();
        return $sum->plus($rate)?->rounded;
    }
}

interface Reader extends Countable,
    Sized {}
enum Suit {}

function checkout($order) {
    $named = $order::class;
    echo "{$order->label} pays";
}

$anon = function ($amount) { return $amount; };
$short = fn($x) => $x;
?>
