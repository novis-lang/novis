final class Order extends Base implements Iterable by $rows {
    public const int LIMIT = 10;
    private readonly secret string $token;
    protected tainted string $input;

    public static function total(uint $n, decimal $amount): float {
        $sum = self::LIMIT;
        return $n is uint ? $sum as float : parent::total($n, $amount);
    }

    public string $name { get => $this->raw; set { } }
    public private(set) bool $open;
}

