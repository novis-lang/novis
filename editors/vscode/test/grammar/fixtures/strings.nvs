<?nvs
$single = 'no $plain and no {$complex} in a single-quoted string';
$escaped = 'an escaped \' quote and an escaped \\ backslash';
$literal = 'a literal \n is two characters';
$double = "hello $who, and $byword[label], $bynum[0], $byvar[$key]";
$reach = "a property $user->email, and a complex {$order->total} slot";
$escapes = "escapes: \n \t \" \$ \101 \x41 \u{1F600}";
$asis = "a \q is no escape, and \u{ is a broken one";
