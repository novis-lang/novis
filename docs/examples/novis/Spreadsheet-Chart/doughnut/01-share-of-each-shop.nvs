<?nvs
// Shows a doughnut chart of the share of each shop in the sales.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Shops');
$sheet->addAll([
    ['shop' => 'North', 'sales' => 340],
    ['shop' => 'South', 'sales' => 210],
    ['shop' => 'East', 'sales' => 95],
]);

// A doughnut chart is a pie chart with a hole in the middle.
var $chart = Chart::doughnut({ title: 'Share of sales' })
    ->series($sheet->column('sales'), { categories: $sheet->column('shop') });
$sheet->chart('D2', $chart);
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

// `Core\Zip::read` returns the XML of the chart. These lines check what it contains.
var $xml = Core\Zip::read($file, 'xl/charts/chart1.xml') as string;
echo Core\Str::contains($xml, '<c:doughnutChart>') ? 'a doughnut chart' : 'another type', "\n";
echo Core\Str::contains($xml, '<c:holeSize val="50"/>') ? 'the hole is half the size of the doughnut' : 'another hole', "\n";
