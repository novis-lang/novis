<?nvs
// Shows the error for a doughnut chart combined with a pie chart.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->addSheet('Shops');
$sheet->addRows([['shop' => 'North', 'sales' => 340, 'costs' => 200], ['shop' => 'South', 'sales' => 210, 'costs' => 150]]);

// Only column, line and area charts combine, so `Sheet::addChart` throws a `LogicError`.
var $chart = Chart::doughnut()->withSeries($sheet->column('sales'))->combinedWith(Chart::pie()->withSeries($sheet->column('costs')));
try {
    $sheet->addChart('E2', $chart);
} catch (LogicError $e) {
    echo $e->message, "\n";
}
