<?nvs
// Shows the error for an area chart combined with another area chart.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->addSheet('Orders');
$sheet->addRows([['quarter' => 'Q1', 'shop' => 310, 'web' => 120], ['quarter' => 'Q2', 'shop' => 290, 'web' => 180]]);

// A combined chart has two different types, so `Sheet::addChart` throws a `LogicError`.
var $chart = Chart::area()->withSeries($sheet->column('shop'))->combinedWith(Chart::area()->withSeries($sheet->column('web')));
try {
    $sheet->addChart('E2', $chart);
} catch (LogicError $e) {
    echo $e->message, "\n";
}

// Two series in one area chart are allowed.
$sheet->addChart('E2', Chart::area()->withSeries($sheet->column('shop'))->withSeries($sheet->column('web')));
echo "the area chart with two series is added\n";
