<?nvs
// Shows columns of the real sales and an area of the target in one chart.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Sales');
$sheet->addAll([
    ['month' => 'January', 'sales' => 1200, 'target' => 1300],
    ['month' => 'February', 'sales' => 1450, 'target' => 1400],
]);

// `combine` draws the area on the same axes as the columns.
var $target = Chart::area()->series($sheet->column('target'), { categories: $sheet->column('month'), name: 'Target' });
var $chart = Chart::column({ title: 'Sales and target' })
    ->series($sheet->column('sales'), { categories: $sheet->column('month'), name: 'Sales' })
    ->combine($target);
$sheet->chart('E2', $chart);
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

var $xml = Core\Zip::read($file, 'xl/charts/chart1.xml') as string;
echo Core\Str::contains($xml, '<c:barChart>') ? 'columns' : 'no columns', "\n";
echo Core\Str::contains($xml, '<c:areaChart>') ? 'and an area' : 'and no area', "\n";
