<?nvs
// Shows an area chart of the orders of a shop in each quarter.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Orders');
$sheet->addAll([
    ['quarter' => 'Q1', 'orders' => 310],
    ['quarter' => 'Q2', 'orders' => 290],
    ['quarter' => 'Q3', 'orders' => 405],
    ['quarter' => 'Q4', 'orders' => 520],
]);

// An area chart is a line chart with the space under the line filled.
var $chart = Chart::area({ title: 'Orders per quarter', legend: 'hidden' })
    ->series($sheet->column('orders'), { categories: $sheet->column('quarter'), color: '#2CA02C' });
$sheet->chart('D2', $chart);
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

// `Core\Zip::read` returns the XML of the chart. These lines check what it contains.
var $xml = Core\Zip::read($file, 'xl/charts/chart1.xml') as string;
echo Core\Str::contains($xml, '<c:areaChart>') ? 'an area chart' : 'another type', "\n";
echo Core\Str::contains($xml, '<c:f>Orders!$B$2:$B$5</c:f>') ? 'the values are B2:B5' : 'other values', "\n";
