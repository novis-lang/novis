<?nvs
// Shows the error for a line chart that has no series.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->addSheet('Blog');
$sheet->addRow(['day' => 'Monday', 'visitors' => 420]);

// A chart needs at least one series, so `Sheet::addChart` throws a `LogicError`.
try {
    $sheet->addChart('D2', Chart::line({ title: 'Visitors' }));
} catch (LogicError $e) {
    echo $e->message, "\n";
}
