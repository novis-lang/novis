<?nvs
// Shows a scatter chart of the price of each product and the units sold.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Products');
$sheet->addAll([
    ['price' => 4.5, 'sold' => 120],
    ['price' => 9.0, 'sold' => 75],
    ['price' => 15.0, 'sold' => 30],
]);

// Each row is one point. `categories` are the x values and the series values are the y values.
var $chart = Chart::scatter({ xTitle: 'Price', yTitle: 'Units sold', legend: 'hidden' })
    ->series($sheet->column('sold'), { categories: $sheet->column('price') });
$sheet->chart('D2', $chart);
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

// `Core\Zip::read` returns the XML of the chart. These lines check what it contains.
var $xml = Core\Zip::read($file, 'xl/charts/chart1.xml') as string;
echo Core\Str::contains($xml, '<c:scatterChart>') ? 'a scatter chart' : 'another type', "\n";
echo Core\Str::contains($xml, '<c:xVal><c:numRef><c:f>Products!$A$2:$A$4</c:f>') ? 'x is the price, A2:A4' : 'another x', "\n";
