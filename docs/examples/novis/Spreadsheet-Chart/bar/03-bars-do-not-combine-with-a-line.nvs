<?nvs
// Shows the error for a bar chart combined with a line.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Shops');
$sheet->addAll([['shop' => 'North', 'sales' => 340, 'costs' => 200], ['shop' => 'South', 'sales' => 210, 'costs' => 150]]);

// Only column, line and area charts combine. `Sheet::chart` throws a `LogicError` for bars.
var $chart = Chart::bar()->series($sheet->column('sales'))->combine(Chart::line()->series($sheet->column('costs')));
try {
    $sheet->chart('E2', $chart);
} catch (LogicError $e) {
    echo $e->message, "\n";
}
