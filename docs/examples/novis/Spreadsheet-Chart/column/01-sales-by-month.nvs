<?nvs
// Shows a column chart of the sales of each month.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Sales');
$sheet->addAll([
    ['month' => 'January', 'sales' => 1200],
    ['month' => 'February', 'sales' => 1450],
    ['month' => 'March', 'sales' => 1380],
]);

// The months are the labels under the columns.
var $chart = Chart::column({ title: 'Sales by month' })
    ->series($sheet->column('sales'), { categories: $sheet->column('month'), name: 'Sales' });
$sheet->chart('D2', $chart);
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

// `Core\Zip::read` returns the XML of the chart. These lines check what it contains.
var $xml = Core\Zip::read($file, 'xl/charts/chart1.xml') as string;
echo Core\Str::contains($xml, '<c:barDir val="col"/>') ? 'vertical bars' : 'another type', "\n";
echo Core\Str::contains($xml, '<a:t>Sales by month</a:t>') ? 'the title is written' : 'no title', "\n";
