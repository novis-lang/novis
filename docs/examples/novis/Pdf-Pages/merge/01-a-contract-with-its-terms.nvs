<?nvs
// Shows a contract on a letterhead PDF, with the terms of the shop added at the end.
use Novis\Pdf\Document;
use Novis\Pdf\Pages;
use Novis\Pdf\Reader;

// The letterhead and the terms are PDF files that the shop already has.
var $letterhead = Document::fromHtml('<p>Shop, 1 Example Street</p>')->render()->bytes;
var $terms = Document::fromHtml('<style>p { break-after: page }</style>'
    . '<p>Terms, part 1</p><p>Terms, part 2</p>')->render()->bytes;

// `background-image` draws the letterhead behind every page of the contract.
var $contract = Document::fromHtml('<style>@page { background-image: url(letterhead.pdf) }</style>'
    . '<h1>Contract</h1><p>Ada Lovelace rents a bike for one week.</p>')
    ->asset('letterhead.pdf', $letterhead)
    ->render()
    ->bytes;

// The new file is the contract and then every page of the terms.
var $reader = Reader::open(Pages::merge([Pages::of($contract), Pages::of($terms)]));
for (uint $page = 1; $page <= $reader->pageCount; $page++) {
    echo 'page ', $page, ': ', Core\Str::replace($reader->text($page), "\n", ' / '), "\n";
}
