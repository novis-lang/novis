<?nvs
// Shows how to save the same orders as a CSV file.
use Novis\Spreadsheet\Workbook;

string $path = Core\Path::join(Core\IO::temporaryDir(), 'orders.csv');
array<array<mixed>> $orders = [
    ['order' => 1042, 'customer' => 'Ada', 'total' => 19.9],
    ['order' => 1043, 'customer' => 'Alan', 'total' => 5.0],
];

// The path ends in `.csv`, so the file is CSV. `size` is the length of the file in bytes.
var $written = Workbook::fromRows($orders)->save($path);
echo $written->size, " bytes\n";
echo Core\IO::readText($path);
