<?nvs
use Novis\Spreadsheet\Reader;
// Shows how to save a list of orders as an Excel file and read it back.
use Novis\Spreadsheet\Workbook;

string $path = Core\Path::join(Core\IO::temporaryDir(), 'orders.xlsx');
array<array<mixed>> $orders = [
    ['order' => 1042, 'customer' => 'Ada', 'total' => 19.9],
    ['order' => 1043, 'customer' => 'Alan', 'total' => 5.0],
];

// `save` returns a `Written`. Its `rows` has the number of rows of each sheet.
var $written = Workbook::fromRows($orders, { sheet: 'Orders' })->save($path);
echo $written->rows['Orders'], " orders saved\n";

// `header: true` uses the first row as the keys of each row.
foreach (Reader::open(Core\IO::open($path, Core\IO::FileMode::Read))->rows('Orders', { header: true }) as var $row) {
    echo $row->values['order'], ': ', $row->values['customer'], "\n";
}
