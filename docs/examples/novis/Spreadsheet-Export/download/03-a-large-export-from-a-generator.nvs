<?nvs
// Shows how to send rows from a generator, so the program never has every row in memory.
use Novis\Spreadsheet\Workbook;

class Shop
{
    // This generator gives one order at a time. A real program reads them from a database.
    public static function orders(int $count): Iterator<array<mixed>>
    {
        for (int $order = 1; $order <= $count; $order++) {
            yield ['order' => $order, 'total' => $order * 2.5];
        }
    }
}

// The browser gets each part of the file while the rows are still being written.
Workbook::fromRows(Shop::orders(4))->download('orders.csv');
