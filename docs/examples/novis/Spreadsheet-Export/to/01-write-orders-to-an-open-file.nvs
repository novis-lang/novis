<?nvs
// Shows how to write an orders export to a file that your program opened.
use Novis\Spreadsheet\Workbook;

string $path = Core\Path::join(Core\IO::temporaryDir(), 'orders.csv');
Core\IO\File $file = Core\IO::open($path, Core\IO::FileMode::Write);

// An open file has no name to read the format from, so `format: "csv"` sets it.
Workbook::fromRows([['order' => 1042, 'total' => 19.9], ['order' => 1043, 'total' => 5.0]], { format: 'csv' })->to($file);

// `to` does not close the file. Your program closes it.
$file->close();
echo Core\IO::readText($path);
