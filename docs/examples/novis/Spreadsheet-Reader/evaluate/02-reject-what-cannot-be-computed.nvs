<?nvs
// Shows how to find the cells of an upload that `evaluate` cannot compute.
use Novis\Spreadsheet\Formula;
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

class Import
{
    // This method returns one line for each cell that has no computed result.
    public static function check(tainted bytes $upload): array<tainted string>
    {
        array<tainted string> $lines = [];
        foreach (Reader::open($upload)->evaluate() as var $missed) {
            $lines[] = "{$missed->cell} is {$missed->kind}: {$missed->text}";
        }
        return $lines;
    }
}

// This makes the upload. In a real program the bytes come from the request.
var $book = Workbook::createInMemory();
$book->sheet('Plan')->add(['day' => Formula::of('=TODAY()', {cached: 45306}), 'next' => Formula::of('=A2+1')]);
foreach (Import::check($book->finish()->bytes ?? Core\Bytes::fill(0, 0)) as tainted string $line) {
    echo $line, "\n";
}
