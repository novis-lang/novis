<?nvs
// Shows how the option `merged: 'fill'` gives the value of a merged area to each of its cells.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

// The shop name `South` is in A3, and A3:A4 is merged. So in Excel it is next to both months.
var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Sales');
$sheet->merge('A3:A4');
$sheet->addAll([['Shop', 'Month'], ['North', 'May'], ['South', 'May'], [null, 'June']]);
var $reader = Reader::open($book->finish()->bytes ?? Core\Bytes::fill(0, 0));

// By default, only the top-left cell has the value. The shop of row 4 is `null`.
foreach ($reader->rows('Sales', { header: true }) as var $row) {
    echo $row->number, ': ', $row->values['Shop'] ?? 'null', ' ', $row->values['Month'], "\n";
}

// With `merged: 'fill'`, row 4 also has the shop `South`.
foreach ($reader->rows('Sales', { header: true, merged: 'fill' }) as var $row) {
    echo $row->number, ': ', $row->values['Shop'] ?? 'null', ' ', $row->values['Month'], "\n";
}
