<?nvs
// Shows how to check that a sheet has no merged cells before a row by row import.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
$book->sheet('Plain')->addAll([['Item', 'Price'], ['Widget', 2.5]]);
$book->sheet('Layout')->merge('A1:B1')->addAll([['Price list'], ['Widget', 2.5]]);
var $reader = Reader::open($book->finish()->bytes ?? Core\Bytes::fill(0, 0));

// `merged` takes the position of the sheet. An empty list means the sheet has no merged cells.
foreach ($reader->sheets() as var $info) {
    uint $count = Core\Arr::count($reader->merged($info->position as int));
    echo $info->name, ': ', $count == 0 ? 'ready to import' : "merged areas: {$count}", "\n";
}
