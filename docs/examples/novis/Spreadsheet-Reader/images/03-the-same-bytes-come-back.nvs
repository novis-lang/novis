<?nvs
// Shows that `image` has the same bytes as the picture that was put in the file.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

bytes $logo = Core\Encoding::fromBase64('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7');
var $book = Workbook::createInMemory();
$book->sheet('Cover')->image('A1', $logo)->add(['Shop price list']);
var $reader = Reader::open($book->finish()->bytes ?? Core\Bytes::fill(0, 0));

// The bytes are `tainted`, because they come from the file. Check them before you save or show them.
foreach ($reader->images('Cover') as var $image) {
    echo $image->format, ' at ', $image->at, ': ', $image->image == $logo ? 'the same bytes' : 'other bytes', "\n";
    echo 'link: ', $image->link ?? 'none', "\n";
}
