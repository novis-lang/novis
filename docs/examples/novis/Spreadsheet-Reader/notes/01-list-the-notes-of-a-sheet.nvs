<?nvs
// Shows how to list the notes of a sheet, with the cell, the text and the author of each note.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Prices');
$sheet->note('B2', 'Price from the new supplier.', { author: 'Ann' })->note('B3', 'Check this price.', { author: 'Ben' });
$sheet->addAll([['Item', 'Price'], ['Widget', 2.5], ['Gadget', 4.0]]);
var $reader = Reader::open($book->finish()->bytes ?? Core\Bytes::fill(0, 0));

// `noted` is the cell of the note, `note` is its text, and `author` is who wrote it.
foreach ($reader->notes('Prices') as var $note) {
    echo $note->noted, ' (', $note->author ?? 'no author', '): ', $note->note, "\n";
}
