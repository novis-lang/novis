<?nvs
// Shows how to show each row of an import together with the notes in that row.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Orders');
$sheet->note('C3', 'Paid by bank transfer.');
$sheet->addAll([['Order', 'Customer', 'Total'], [1001, 'Shop', 120], [1002, 'Blog', 80]]);
var $reader = Reader::open($book->finish()->bytes ?? Core\Bytes::fill(0, 0));

// This map has the notes by cell, such as `C3`.
array<tainted string> $notes = [];
foreach ($reader->notes('Orders') as var $note) {
    $notes[$note->noted] = $note->note;
}

// A cell name is the column letter and the row number. So the note of the total is at `C` and `$row->number`.
foreach ($reader->rows('Orders', { header: true }) as var $row) {
    echo 'order ', $row->values['Order'], ': ', $notes["C{$row->number}"] ?? 'no note', "\n";
}
