<?nvs
// Shows how to put a QR code into an HTML page, so a phone can open the page.
use Novis\Image\QrCode;

string $link = 'https://example.com/blog/hello';
string $code = QrCode::svg($link);

// The SVG document is a string, so it goes straight into the HTML.
string $html = "<figure>{$code}<figcaption>Scan to read the post</figcaption></figure>";

// This prints the start of the page and checks that the SVG is inside it.
echo Core\Str::slice($html, 0, 12), "\n";
echo Core\Str::contains($html, '</svg><figcaption>') ? 'the code is in the page' : 'no code', "\n";
