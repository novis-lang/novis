<?nvs
// Shows the value of `string` before the first chapter and on a page with no chapter title.
use Novis\Pdf\Document;
use Novis\Pdf\Page;

// Page 1 is a title page. Page 3 has no `h2`, because the long text of page 2 goes on.
var $html = '<style>h1 { break-after: page } h2 { string-set: chapter content() }</style>'
    . '<h1>Shop handbook</h1><h2>Orders</h2>'
    . Core\Str::repeat('<p>Each order has a number. Search for the number to find the order.</p>', 40);

// Before the first `h2`, the result is `null`.
var $header = fn(Page $page): Core\Html\Markup => {
    ?string $title = $page->string('chapter');
    echo 'page ', $page->number, ': ', $title ?? 'null', "\n";
    return html`<p>{$title ?? 'Shop handbook'}</p>`;
};

Document::fromHtml($html)->header($header)->render();
