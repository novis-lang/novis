<?nvs
// Shows that one tag can use different data for different services.
use Novis\Intl\Locale;
use Novis\Intl\Service;

// German has its own date rules. This prints de.
echo Locale::resolve(["de-AT"], Service::Dates)[0], "\n";

// German sorts text with the general rules. This prints und.
echo Locale::resolve(["de-AT"], Service::Collation)[0], "\n";
