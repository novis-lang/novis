<?nvs
// Shows how a summary sheet links to the sheet with the details.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $summary = $book->sheet('Summary');
$summary->add(['Orders', 'See the list']);

// A target without `http:` is a cell of the workbook. `external` is `false` for it.
$summary->link('B1', 'Orders!A1');
$book->sheet('Orders')->addAll([['order' => 1042], ['order' => 1043]]);
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

foreach (Reader::open($file)->links('Summary') as var $link) {
    echo $link->anchor, ' -> ', $link->target, ', external: ', $link->external ? 'yes' : 'no', "\n";
}
