<?nvs
// Shows how to add a styled header row with `add`, and then the other rows with `addAll`.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Style;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Products');

// `add` takes options, so the header row gets its own style.
$sheet->add(['Product', 'Price'], { style: Style::of({ bold: true, fill: '#DDEBF7' }) });
$sheet->addAll([['Widget', 2.5], ['Gadget', 4.0]]);
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

// The rows have no keys, so the reader keys each value by its column letter.
foreach (Reader::open($file)->rows('Products') as var $row) {
    echo $row->number, ': ', $row->values['A'], ' ', $row->values['B'], "\n";
}
