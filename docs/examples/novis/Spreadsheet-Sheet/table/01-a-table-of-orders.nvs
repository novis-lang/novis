<?nvs
// Shows how to make the orders of a sheet an Excel table with a name.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Orders');
$sheet->addAll([
    ['order' => 1042, 'customer' => 'Ann', 'total' => 19.9],
    ['order' => 1043, 'customer' => 'Ben', 'total' => 5.5],
]);

// Row 1 is the header row, and the orders are in rows 2 and 3.
$sheet->table('A1:C3', { name: 'Orders', style: 'TableStyleMedium2' });
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

foreach (Reader::open($file)->tables('Orders') as var $table) {
    echo $table->name, ' covers ', $table->table, "\n";
}
