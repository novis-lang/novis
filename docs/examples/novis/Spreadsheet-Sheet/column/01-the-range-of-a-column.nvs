<?nvs
// Shows how to find the range of a column after the last row.
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Orders');
$sheet->add(['order' => 1042, 'total' => 19.9]);
$sheet->add(['order' => 1043, 'total' => 5.5]);
$sheet->add(['order' => 1044, 'total' => 12.0]);

// Row 1 is the header row, so the data is in rows 2 to 4. This prints `B2:B4`.
echo $sheet->column('total'), "\n";
