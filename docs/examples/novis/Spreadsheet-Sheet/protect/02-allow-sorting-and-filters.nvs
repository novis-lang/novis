<?nvs
// Shows how to lock a sheet and still let a person sort it and use its filters.
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Orders');
$sheet->addAll([['order' => 1042, 'total' => 19.9], ['order' => 1043, 'total' => 5.5]]);
$sheet->protect({ allow: ['sort', 'autoFilter'] });
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

// `Core\Zip::read` returns the XML of the sheet. In it, `sort="0"` means sorting is not locked.
var $xml = Core\Zip::read($file, 'xl/worksheets/sheet1.xml') as string;
echo Core\Str::contains($xml, 'sort="0"') ? 'a person can sort' : 'sorting is locked', "\n";
echo Core\Str::contains($xml, 'autoFilter="0"') ? 'a person can filter' : 'filters are locked', "\n";

// A name that is not on the list throws a `LogicError`.
try {
    $book = Workbook::createInMemory();
    $book->sheet('Orders')->protect({ allow: ['everything'] });
} catch (LogicError $e) {
    echo $e->message, "\n";
}
