<?nvs
// Shows how to write a monthly report with a total row and a column chart.
use Novis\Spreadsheet\Chart;
use Novis\Spreadsheet\Formula;
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $sheet = $book->sheet('Sales');
$sheet->addAll([
    ['month' => 'January', 'sales' => 1200],
    ['month' => 'February', 'sales' => 1450],
    ['month' => 'March', 'sales' => 1380],
]);

// The chart uses the months only, so its ranges are taken before the total row.
var $chart = Chart::column({ title: 'Sales by month', legend: 'hidden' })
    ->series($sheet->column('sales'), { categories: $sheet->column('month'), name: 'Sales' });
$sheet->add(['month' => 'Total', 'sales' => Formula::of('=SUM(' . $sheet->column('sales') . ')', { cached: 4030 })]);
$sheet->chart('D2', $chart, { width: 600.0 });

var $written = $book->finish();
bytes $file = $written->bytes ?? Core\Bytes::fill(0, 0);
echo $written->rows['Sales'], " rows\n";

// `Core\Zip::read` returns the XML of the chart. This line checks the range of its values.
var $xml = Core\Zip::read($file, 'xl/charts/chart1.xml') as string;
echo Core\Str::contains($xml, '<c:f>Sales!$B$2:$B$4</c:f>') ? 'the chart shows rows 2 to 4' : 'other rows', "\n";
