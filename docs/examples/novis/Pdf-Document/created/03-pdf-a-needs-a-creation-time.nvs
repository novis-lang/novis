<?nvs
// Shows that a PDF/A file needs `created`.
use Novis\Pdf\Document;

var $archive = Document::fromHtml("<html lang=\"en\"><head><title>Contract</title></head>"
    . '<body><h1>Contract</h1><p>Shop rents a stand to Blog for one year.</p></body></html>')
    ->standard(Document::Standard::PdfA2b);

// Without a creation time, `render` throws a `LogicError`.
try {
    $archive->render();
} catch (LogicError $e) {
    echo "LogicError\n";
}

// With one, the file renders. This prints the page count.
echo $archive->created(Core\Time::fromIso('2026-03-01T09:30:00Z'))->render()->pageCount, " page\n";
