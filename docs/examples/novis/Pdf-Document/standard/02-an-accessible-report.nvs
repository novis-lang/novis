<?nvs
// Shows a report made as a PDF/UA file, which a screen reader can read aloud.
use Novis\Pdf\Document;

// PDF/UA needs a `<title>`, and each image needs `alt` text.
string $chart = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"80\">"
    . "<rect width=\"60\" height=\"80\" fill=\"#888\"/><rect x=\"80\" width=\"60\" height=\"50\" fill=\"#888\"/></svg>";
string $html = "<html lang=\"en\"><head><title>Sales report</title></head><body>"
    . "<h1>Sales report</h1><img src=\"chart.svg\" alt=\"Sales fell from 80 to 50 orders.\">"
    . '<table><tr><th>Month</th><th>Orders</th></tr><tr><td>May</td><td>80</td></tr>'
    . '<tr><td>June</td><td>50</td></tr></table></body></html>';

var $rendered = Document::fromHtml($html)
    ->asset('chart.svg', $chart as bytes)
    ->standard(Document::Standard::PdfUa1)
    ->render();

// This prints the page count of the finished file.
echo $rendered->pageCount, " page\n";
