<?nvs
// Shows the error a render throws when the document does not meet its standard.
use Novis\Pdf\Document;

string $html = "<html lang=\"en\"><head><title>Price list</title></head>"
    . "<body><img src=\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10'/>\">"
    . '<p>Tea 2.50 EUR</p></body></html>';

// The image has no `alt` text, so the file is not PDF/UA.
// `render` throws a `LogicError` that says what is wrong.
try {
    Document::fromHtml($html)->standard(Document::Standard::PdfUa1)->render();
} catch (LogicError $e) {
    echo $e->message, "\n";
}

// PDF/A needs a creation time. This document has none, so `render` throws.
try {
    Document::fromHtml('<p>Tea 2.50 EUR</p>')->standard(Document::Standard::PdfA3b)->render();
} catch (LogicError $e) {
    echo $e->message, "\n";
}
