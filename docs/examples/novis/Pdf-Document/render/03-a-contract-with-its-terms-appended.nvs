<?nvs
// Shows a contract and its terms, rendered from two documents and put into one PDF file.
use Novis\Pdf\Document;
use Novis\Pdf\Pages;
use Novis\Pdf\Reader;

// The terms are the same for every contract, so the program renders them once.
bytes $terms = Document::fromHtml('<h1>Terms</h1><p>The rent is due on the first day of each month.</p>')
    ->render()->bytes;

// Each contract is a new render with the name of the customer.
string $customer = 'Blog';
bytes $contract = Document::fromHtml(html`<h1>Contract</h1><p>Shop rents a stand to {$customer} for one year.</p>`)
    ->render()->bytes;

// `Pages::merge` puts every page of both files into one file, in order.
bytes $file = Pages::merge([Pages::of($contract), Pages::of($terms)]);

// This prints the first line of each page.
var $reader = Reader::open($file);
for (uint $n = 1; $n <= $reader->pageCount; $n++) {
    echo 'page ', $n, ': ', Core\Str::before($reader->text($n), "\n") ?? '', "\n";
}
