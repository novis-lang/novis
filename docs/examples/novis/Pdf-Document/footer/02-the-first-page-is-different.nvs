<?nvs
// Shows a letter with the bank details on page 1 and a page number on the other pages.
use Novis\Pdf\Document;
use Novis\Pdf\Page;
use Novis\Pdf\Reader;

string $html = '<h1>Dear customer,</h1>'
    . Core\Str::repeat('<p>Thank you for your order. Your parcel leaves the shop today.</p>', 70);

var $footer = fn(Page $page): Core\Html\Markup => $page->isFirst()
    ? html`<p>Shop, IBAN DE02 1203 0000 0000 2020 51</p>`
    : html`<p>Page {$page->number} of {$page->count}</p>`;

// This prints the last line of each page, which is its footer.
var $reader = Reader::open(Document::fromHtml($html)->footer($footer)->render()->bytes);
for (uint $n = 1; $n <= $reader->pageCount; $n++) {
    array<string> $lines = Core\Str::split($reader->text($n), "\n");
    echo 'page ', $n, ': ', $lines[Core\Arr::count($lines) - 1], "\n";
}
