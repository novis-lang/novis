<?nvs
// Shows statements for two customers, each with its own password.
use Novis\Pdf\Document;

var $statement = Document::fromHtml('<h1>Statement for March</h1><p>Balance: 2387.50 EUR</p>');

// `password` returns a new document, so one document can give a file for each customer.
bytes $ada = $statement->password('ada-7731')->render()->bytes;
bytes $grace = $statement->password('grace-1906')->render()->bytes;

// The same document and the same password give the same bytes.
// A different password gives a different file. This prints `same` and then `different`.
bytes $again = $statement->password('ada-7731')->render()->bytes;
echo $again == $ada ? 'same' : 'different', "\n";
echo $ada == $grace ? 'same' : 'different', "\n";
