<?nvs
// Shows a bank statement that a customer opens with a password.
use Novis\Pdf\Document;
use Novis\Pdf\Reader;

string $html = '<h1>Statement for March</h1><table>'
    . '<tr><td>1 March</td><td>Shop</td><td>-12.50 EUR</td></tr>'
    . '<tr><td>3 March</td><td>Salary</td><td>2400.00 EUR</td></tr></table>';

// `password` encrypts the file with AES-256.
// A PDF viewer asks for the password before it shows the pages.
var $statement = Document::fromHtml($html)->password('Ada-1815-12-10')->render();
echo $statement->pageCount, " page\n";
echo Core\Bytes::contains($statement->bytes, '/Encrypt' as bytes) ? 'encrypted' : 'not encrypted', "\n";

// `Reader` cannot read an encrypted file, so it throws a `ParseError`.
try {
    Reader::open($statement->bytes);
} catch (ParseError $e) {
    echo $e->message, "\n";
}
