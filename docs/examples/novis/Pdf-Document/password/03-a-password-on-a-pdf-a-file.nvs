<?nvs
// Shows the error for a password on a PDF/A file.
use Novis\Pdf\Document;

string $html = "<html lang=\"en\"><head><title>Statement</title></head>"
    . '<body><h1>Statement for March</h1></body></html>';

// PDF/A does not allow encryption, so `render` throws a `LogicError`.
try {
    Document::fromHtml($html)
        ->standard(Document::Standard::PdfA2b)
        ->created(Core\Time::fromIso('2026-03-31T18:00:00Z'))
        ->password('ada-7731')
        ->render();
} catch (LogicError $e) {
    echo $e->message, "\n";
}
