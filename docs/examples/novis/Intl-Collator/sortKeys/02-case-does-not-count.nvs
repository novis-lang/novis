<?nvs
// Shows how to make keys that are the same for upper and lower case.
use Novis\Intl\Collator;
use Novis\Intl\Strength;

array<string> $tags = ["Apple", "apple"];

// With the default strength, case counts. This prints different.
array<bytes> $keys = Collator::sortKeys($tags, "en");
echo Core\Bytes::compare($keys[0], $keys[1]) == 0 ? "same" : "different", "\n";

// With `Strength::Primary`, case does not count. This prints same.
array<bytes> $loose = Collator::sortKeys($tags, "en", {strength: Strength::Primary});
echo Core\Bytes::compare($loose[0], $loose[1]) == 0 ? "same" : "different", "\n";
