<?nvs
// Shows how to check the page count of each upload before the shop stores it.
use Novis\Pdf\Document;
use Novis\Pdf\Reader;

uint $maxPages = 3;

// Two uploads: a receipt with one page and a catalogue with five pages.
var $receipt = Document::fromHtml('<p>Receipt 1042</p>')->render()->bytes;
var $catalogue = Document::fromHtml('<style>p { break-after: page }</style>'
    . '<p>Bikes</p><p>Helmets</p><p>Lights</p><p>Locks</p><p>Bells</p>')->render()->bytes;

// This loop prints `accepted` for the receipt and `too long` for the catalogue.
array<bytes> $uploads = [$receipt, $catalogue];
foreach ($uploads as bytes $upload) {
    var $reader = Reader::open($upload);
    if ($reader->pageCount > $maxPages) {
        echo 'page count ', $reader->pageCount, ": too long\n";
    } else {
        echo 'page count ', $reader->pageCount, ": accepted\n";
    }
}
