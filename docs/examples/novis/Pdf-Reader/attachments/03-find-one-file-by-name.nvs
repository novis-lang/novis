<?nvs
// Shows how to find one attached file by its name and read its content as text.
use Novis\Pdf\Document;
use Novis\Pdf\Reader;

string $xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
    . "<rsm:CrossIndustryInvoice xmlns:rsm=\"urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100\""
    . " xmlns:ram=\"urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100\">"
    . '<rsm:ExchangedDocument><ram:ID>Shop-8</ram:ID><ram:TypeCode>380</ram:TypeCode></rsm:ExchangedDocument>'
    . '</rsm:CrossIndustryInvoice>';
var $invoice = Document::fromHtml(
    "<html lang=\"en\"><head><title>Invoice Shop-8</title></head>"
        . '<body><p>Invoice Shop-8</p></body></html>',
)
    ->standard(Document::Standard::PdfA3b)
    ->created(Core\Time::fromIso('2026-01-01T00:00:00Z'))
    ->invoiceXml($xml)
    ->render()
    ->bytes;

// The data of a file is bytes. `as string` converts it to text.
// This prints whether the file `factur-x.xml` contains the invoice number.
foreach (Reader::open($invoice)->attachments() as var $file) {
    if ($file->name == 'factur-x.xml') {
        string $content = $file->data as string;
        echo $file->name, ' contains Shop-8: ', Core\Str::contains($content, 'Shop-8') ? 'yes' : 'no', "\n";
    }
}
