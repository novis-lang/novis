<?nvs
// Shows how to sort uploaded PDF files into electronic invoices and other files.
use Novis\Pdf\Document;
use Novis\Pdf\Reader;

string $xml = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
    . "<rsm:CrossIndustryInvoice xmlns:rsm=\"urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100\""
    . " xmlns:ram=\"urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100\">"
    . '<rsm:ExchangedDocument><ram:ID>Shop-9</ram:ID><ram:TypeCode>380</ram:TypeCode></rsm:ExchangedDocument>'
    . '</rsm:CrossIndustryInvoice>';
var $invoice = Document::fromHtml(
    "<html lang=\"en\"><head><title>Invoice Shop-9</title></head>"
        . '<body><p>Invoice Shop-9</p></body></html>',
)
    ->standard(Document::Standard::PdfA3b)
    ->created(Core\Time::fromIso('2026-01-01T00:00:00Z'))
    ->invoiceXml($xml)
    ->render()
    ->bytes;
var $scan = Document::fromHtml('<p>Scanned delivery note</p>')->render()->bytes;

// A file with invoice XML goes to accounting. Any other file goes to the inbox.
// This prints `accounting` for the invoice and `inbox` for the delivery note.
array<bytes> $uploads = [$invoice, $scan];
foreach ($uploads as bytes $upload) {
    if (Reader::open($upload)->invoiceXml() == null) {
        echo "inbox\n";
    } else {
        echo "accounting\n";
    }
}
