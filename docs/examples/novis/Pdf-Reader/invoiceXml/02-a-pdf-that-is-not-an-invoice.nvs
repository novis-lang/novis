<?nvs
// Shows the result for a PDF file that is not an electronic invoice.
use Novis\Pdf\Document;
use Novis\Pdf\Reader;

var $letter = Document::fromHtml('<p>Thank you for your order.</p>')->render()->bytes;

// The letter has no invoice XML, so the result is `null` and this prints `no invoice XML`.
?string $xml = Reader::open($letter)->invoiceXml();
echo $xml ?? 'no invoice XML', "\n";
