<?nvs
// Shows the errors `render` throws when the data does not fit the type of barcode.
use Novis\Image\Barcode;

// The last digit of an EAN-13 is a check digit. For these 12 digits it is 1, so 2 throws a `LogicError`.
try {
    Barcode::render('4006381333932', Barcode::Symbology::Ean13);
    echo "made a barcode\n";
} catch (LogicError $e) {
    echo $e->message, "\n";
}

// Code 128 contains only plain ASCII characters, so `ö` throws a `LogicError`.
try {
    Barcode::render('Größe 42', Barcode::Symbology::Code128);
    echo "made a barcode\n";
} catch (LogicError $e) {
    echo $e->message, "\n";
}
