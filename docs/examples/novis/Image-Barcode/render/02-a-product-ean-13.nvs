<?nvs
// Shows how to make the EAN-13 barcode of a product, with its number printed under the bars.
use Novis\Image\Barcode;
use Novis\Image\Format;
use Novis\Image\Image;

// `module: 3` makes the thinnest bar 3 pixels wide.
// `margin: 5` adds a white border 5 thin bars wide on each side.
bytes $code = Barcode::render('4006381333931', Barcode::Symbology::Ean13, {
    height: 60,
    module: 3,
    margin: 5,
    text: true,
    format: Format::Webp,
});

// This prints the size of the image and the WebP MIME type.
var $info = Image::info($code);
echo $info->width, ' by ', $info->height, " pixels\n";
echo Image::mime($info->format), "\n";
