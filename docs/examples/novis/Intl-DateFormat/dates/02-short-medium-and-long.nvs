<?nvs
// Shows the three lengths of a date.
use Novis\Intl\DateFormat;

var $start = Core\Time\Date::at(2026, 3, 1);
array<DateFormat::Length> $lengths = [DateFormat::Length::Short, DateFormat::Length::Medium, DateFormat::Length::Long];

// This prints 01.03.26, then 01.03.2026, then 1. März 2026.
foreach ($lengths as DateFormat::Length $length) {
    echo DateFormat::dates([$start], 'de', { length: $length })[0], "\n";
}
