<?nvs
use Novis\Image\Color;
use Novis\Image\Format;
// Shows that `keepingMetadata` keeps the EXIF data in every file that `encodeVariants` writes.
use Novis\Image\Image;

// This JPEG has an EXIF block, like a photo from a phone. The block has orientation 6.
tainted bytes $jpeg = Image::create(400, 200, Color::hex('#336699'))->withFormat(Format::Jpeg)->encode();
bytes $exif = Core\Encoding::fromHex('ffe1002245786966000049492a0008000000010012010300010000000600000000000000');
array<tainted bytes> $parts = [Core\Bytes::slice($jpeg, 0, 2), $exif, Core\Bytes::slice($jpeg, 2)];
tainted bytes $photo = Core\Bytes::join($parts);

Image $kept = Image::open($photo, { autoOrient: false })->keepingMetadata();
array<tainted bytes> $files = $kept->encodeVariants([{ width: 200 }, { width: 100 }]);

// Both smaller files still have orientation 6. This prints 200 6 and 100 6.
foreach ($files as tainted bytes $file) {
    var $info = Image::info($file);
    echo $info->width, ' ', $info->orientation, "\n";
}
