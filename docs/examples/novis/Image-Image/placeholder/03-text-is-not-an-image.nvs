<?nvs
// Shows the error `Image::placeholder` throws for bytes that are not an image.
use Novis\Image\Image;
use Novis\Image\PlaceholderKind;

bytes $upload = "<html>not a picture</html>" as bytes;

// The bytes are not an image, so this throws a `ParseError`.
try {
    echo Image::placeholder($upload, PlaceholderKind::BlurHash), "\n";
} catch (ParseError $e) {
    echo "ParseError: the upload is not an image\n";
}
