<?nvs
// Shows how to write the same image as WebP for new browsers and as JPEG for old ones.
use Novis\Image\Image;
use Novis\Image\Color;
use Novis\Image\Format;
use Novis\Image\Fit;

Image $photo = Image::create(640, 480, Color::hex("#336699"));

// Both entries resize to a 300 by 300 square. Each one has its own format.
array<bytes> $files = $photo->variants([
    {width: 300, height: 300, fit: Fit::Cover, format: Format::Webp, quality: 80},
    {width: 300, height: 300, fit: Fit::Cover, format: Format::Jpeg, quality: 85},
]);

// This prints image/webp 300x300 and image/jpeg 300x300.
foreach ($files as bytes $file) {
    var $info = Image::info($file);
    echo Image::mime($info->format), " ", $info->width, "x", $info->height, "\n";
}
