<?nvs
use Novis\Image\Color;
use Novis\Image\Format;
// Shows how to turn a PNG upload into a JPEG file with a chosen quality.
use Novis\Image\Image;

// These PNG bytes replace a file that a user uploaded.
tainted bytes $upload = Image::create(200, 100, Color::hex('#336699'))->withFormat(Format::Png)->encode();

// `withFormat` chooses JPEG with quality 80. This prints image/jpeg and jpg.
tainted bytes $jpeg = Image::open($upload)->withFormat(Format::Jpeg, { quality: 80 })->encode();
var $info = Image::info($jpeg);
echo Image::mime($info->format), "\n";
echo Image::extension($info->format), "\n";
