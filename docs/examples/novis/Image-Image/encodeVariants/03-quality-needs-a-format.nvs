<?nvs
use Novis\Image\Color;
use Novis\Image\Format;
// Shows that an entry with a `quality` needs a `format`.
use Novis\Image\Image;

Image $photo = Image::create(200, 200, Color::hex('#336699'));

// The entry has a quality and no format, so `encodeVariants` throws a `LogicError`.
try {
    $photo->encodeVariants([{ width: 100, quality: 60 }]);
} catch (LogicError $e) {
    echo $e->message, "\n";
}

// After `withFormat`, every entry has a format. This prints 1.
array<tainted bytes> $files = $photo->withFormat(Format::Jpeg)->encodeVariants([{ width: 100, quality: 60 }]);
echo Core\Arr::count($files), "\n";
