<?nvs
// Shows how a test checks that a JPEG thumbnail still looks like the original PNG.
use Novis\Image\Format;
use Novis\Image\Image;

// A pattern of 4 by 4 grey pixels, made 64 by 64 pixels wide.
Image $photo = Image::fromRaw({
    width: 4,
    height: 4,
    pixels: Core\Encoding::fromHex(
        "202020ffe0e0e0ff606060ffa0a0a0ff" .
        "909090ff303030ffd0d0d0ff505050ff" .
        "f0f0f0ff707070ff101010ffc0c0c0ff" .
        "404040ffb0b0b0ff808080ff000000ff"
    ),
})->resize({ width: 64, height: 64 });

// JPEG changes some pixels a little, so the images are not identical.
bytes $jpeg = $photo->format(Format::Jpeg, { quality: 90 })->encode();
var $diff = Image::compare($photo, $jpeg);

echo "identical: ", $diff->identical ? "yes" : "no", "\n";
echo "similarity: ", Core\Math::round($diff->ssim, { precision: 3 }), "\n";
echo "looks the same: ", $diff->ssim >= 0.95 ? "yes" : "no", "\n";
