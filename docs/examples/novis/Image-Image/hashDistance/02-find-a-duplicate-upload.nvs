<?nvs
// Shows how a shop checks whether a new product photo is already in its catalogue.
use Novis\Image\HashKind;
use Novis\Image\Image;

// A pattern of 4 by 4 grey pixels, made 64 by 64 pixels wide, is the saved photo.
Image $photo = Image::fromRaw({
    width: 4,
    height: 4,
    pixels: Core\Encoding::fromHex(
        "202020ffe0e0e0ff606060ffa0a0a0ff" .
        "909090ff303030ffd0d0d0ff505050ff" .
        "f0f0f0ff707070ff101010ffc0c0c0ff" .
        "404040ffb0b0b0ff808080ff000000ff"
    ),
})->resize({ width: 64, height: 64 });
bytes $saved = Image::hash($photo->encode(), HashKind::Perceptual);

// The first upload is the same photo at a smaller size. The second is a grey image.
array<bytes> $uploads = [
    $photo->resize({ width: 32, height: 32 })->encode(),
    Image::create(64, 64)->grayscale()->encode(),
];

// A distance of 10 or less out of 64 bits counts as the same photo.
// This prints "duplicate" and then "new photo".
foreach ($uploads as bytes $upload) {
    uint $distance = Image::hashDistance($saved, Image::hash($upload, HashKind::Perceptual));
    echo $distance <= 10 ? "duplicate" : "new photo", "\n";
}
