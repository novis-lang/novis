<?nvs
// Shows how to send a list of orders to the browser as a file to download.
use Novis\Spreadsheet\Workbook;

// The name ends in `.csv`, so the file is CSV. A name such as `orders.xlsx` makes an Excel file.
var $book = Workbook::createForDownload('orders.csv');

// The keys of the first row are the header of the file.
$book->sheet('Orders')->addAll([
    ['order' => 1042, 'customer' => 'Ada', 'total' => 19.9],
    ['order' => 1043, 'customer' => 'Alan', 'total' => 5.0],
    ['order' => 1044, 'customer' => 'Grace', 'total' => 12.5],
]);

// `finish` sends the end of the file. The output below is the file the browser gets.
$book->finish();
