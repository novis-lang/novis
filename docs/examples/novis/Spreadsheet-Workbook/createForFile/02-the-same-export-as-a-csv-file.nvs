<?nvs
// Shows that a path that ends in `.csv` makes a CSV file.
use Novis\Spreadsheet\Workbook;

string $path = Core\Path::join(Core\IO::temporaryDir(), 'orders.csv');

var $book = Workbook::createForFile($path);
$book->sheet('Orders')->addAll([
    ['order' => 1042, 'customer' => 'Ada', 'total' => 19.9],
    ['order' => 1043, 'customer' => 'Alan', 'total' => 5.0],
]);
$book->finish();

// This prints the text of the file.
echo Core\IO::readText($path);
