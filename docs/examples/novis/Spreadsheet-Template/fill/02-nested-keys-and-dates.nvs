<?nvs
// Shows how a placeholder such as `{{customer.name}}` finds a value inside nested arrays.
use Novis\Spreadsheet\Cell;
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Style;
use Novis\Spreadsheet\Template;
use Novis\Spreadsheet\Workbook;

// The date cell of the template has a date format. `fill` keeps the format of each cell.
var $design = Workbook::createInMemory();
$design->sheet('Invoice')->addAll([
    ['Customer', '{{customer.name}}'],
    ['City', '{{customer.address.city}}'],
    ['Date', Cell::of('{{date}}', Style::of({ format: 'yyyy-mm-dd' }))],
    ['Paid', '{{paid}}'],
]);
bytes $template = $design->finish()->bytes ?? Core\Bytes::fill(0, 0);

// Each dot in a placeholder is one level of the array.
// A date from `Core\Time` is written as a date, and `true` is written as a boolean.
bytes $invoice = Template::open($template)->fill([
    'customer' => ['name' => 'Shop', 'address' => ['city' => 'Berlin']],
    'date' => Core\Time\Date::at(2024, 5, 31),
    'paid' => true,
])->bytes();

foreach (Reader::open($invoice)->rows('Invoice') as var $row) {
    mixed $value = $row->values['B'];
    if ($value is Core\Time\Date) {
        echo $row->values['A'], ': the date ', $value->format('yyyy-MM-dd'), "\n";
    } else {
        echo $row->values['A'], ': ', Core\Json::encode($value), "\n";
    }
}
