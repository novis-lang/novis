<?nvs
// Shows how to highlight one cell of a row, such as an order that is late.
use Novis\Spreadsheet\Cell;
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Style;
use Novis\Spreadsheet\Workbook;

var $late = Style::of({ fill: '#FFC7CE', color: '#9C0006' });

// Only the `status` cell of the second order has the style. The value is written as usual.
bytes $file = Workbook::fromRows([
    ['order' => 1042, 'status' => 'shipped'],
    ['order' => 1043, 'status' => Cell::of('late', $late)],
])->bytes();

foreach (Reader::open($file)->rows('Sheet1', { header: true }) as var $row) {
    echo $row->values['order'], ': ', $row->values['status'], "\n";
}
