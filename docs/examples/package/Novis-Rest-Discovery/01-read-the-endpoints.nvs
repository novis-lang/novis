<?nvs
// Shows how a program reads the endpoints of a login server and creates a client for it.
autoload 'Novis\Rest' from '../../../../packages/rest/src';

// `Core\Test::answerHttp` gives a fixed reply, so this example uses no network.
Core\Test::answerHttp('https://login.example.com/.well-known/openid-configuration', 200, {
    json: [
        'issuer' => 'https://login.example.com',
        'token_endpoint' => 'https://login.example.com/oauth/token',
        'authorization_endpoint' => 'https://login.example.com/oauth/authorize',
        'jwks_uri' => 'https://login.example.com/oauth/keys',
    ],
});

// `fetch` reads the metadata document of the server and checks it.
Novis\Rest\Discovery $server = Novis\Rest\Discovery::fetch('https://login.example.com');
echo $server->tokenEndpoint, "\n";
echo $server->authorizationEndpoint, "\n";

// `publicClient` returns a client without a secret. It sends its requests to the token endpoint.
Novis\Rest\Client $client = $server->publicClient('shop');
echo $client->tokenEndpoint, "\n";
