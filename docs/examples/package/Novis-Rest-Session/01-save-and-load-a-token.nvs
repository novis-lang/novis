<?nvs
// Shows how a page saves a user's token in the session and reads it back on a later request.
// requires: redis
autoload 'Novis\Rest' from '../../../../packages/rest/src';

// `Core\Test::answerHttp` gives a fixed reply, so this example uses no network.
Core\Test::answerHttp('https://login.example.com/oauth/token', 200, {
    json: ['access_token' => 'at-1', 'token_type' => 'Bearer', 'expires_in' => 600, 'refresh_token' => 'rt-1', 'scope' => 'read'],
});

// A real program loads its secret and its keys from its configuration.
secret string $clientSecret = 's3cret';
Novis\Rest\Client $client = Novis\Rest\Client::confidential('https://login.example.com/oauth/token', 'shop', $clientSecret);
array<secret bytes> $keys = [Core\Crypto::generateKey()];

Core\Session::start();

// `save` encrypts both tokens with the first key and saves them in the session.
Novis\Rest\Token $token = $client->requestToken(['grant_type' => 'client_credentials', 'scope' => 'read']);
Novis\Rest\Session::save($token, $keys);

// `load` reads the token back with the same keys. This prints `Bearer read`.
?Novis\Rest\Token $loaded = Novis\Rest\Session::load($keys);
if ($loaded != null) {
    echo $loaded->type, ' ', $loaded->scope, "\n";
}

// The session has the refresh token too. This prints `refresh token: yes`.
echo 'refresh token: ', $loaded?->refreshToken == null ? 'no' : 'yes', "\n";
