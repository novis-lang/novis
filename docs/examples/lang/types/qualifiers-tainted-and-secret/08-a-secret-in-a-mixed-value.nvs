<?nvs
// Shows how to keep a secret in a `mixed` value: you write `secret mixed`.

class Settings
{
    // A setting can be a number, some text or a secret.
    // `secret mixed` can contain every one of them.
    public static function find(string $name): secret mixed
    {
        secret string $apiKey = 'sk-test-4471';
        if ($name == 'apiKey') {
            return $apiKey;
        }
        if ($name == 'port') {
            return 8080;
        }
        return 'mail.example.com';
    }
}

// A value read from `secret mixed` is secret too.
// `as string` gives a `secret tainted string`, so `echo` does not compile with it.
secret tainted string $key = Settings::find('apiKey') as string;

// `Core\Secret::reveal` gives a plain value. The reason says why you may use it.
tainted string $shown = Core\Secret::reveal($key, 'show the length only');
echo 'The key has ', Core\Str::length($shown), " characters\n";

// A conversion to a number needs `Core\Secret::reveal` first.
// This prints `8080`.
secret tainted string $port = Settings::find('port') as string;
echo Core\Secret::reveal($port, 'a port number is not confidential') as int, "\n";
