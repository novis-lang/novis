<?nvs
// A basket of prices, shown one line at a time and then added up.
// `array<int>` is a list of whole numbers, so every value you add to it is an `int`.
// The `foreach` loop gives each value the type `int` too.

array<int> $prices = [1299, 450];
$prices[] = 780;

int $total = 0;
foreach ($prices as int $price) {
    echo $price, "\n";
    $total = $total + $price;
}

echo "total ", $total, " over ", Core\Arr::count($prices), " items\n";
