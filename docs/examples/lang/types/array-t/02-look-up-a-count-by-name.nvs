<?nvs
// Stock counts kept under the name of the thing being counted.
// Keys are text, so the loop takes its key as text whatever it looks like.
// Asking for a name that was never stored would stop the program, so a name
// that may be missing is checked for first.

array<int> $stock = ["apples" => 3, "pears" => 0];
$stock["figs"] = 7;

foreach ($stock as string $name => int $count) {
    echo $name, ": ", $count, "\n";
}

array<string> $asked = ["pears", "plums"];
foreach ($asked as string $wanted) {
    echo $wanted, Core\Arr::hasKey($stock, $wanted) ? " is stocked\n" : " is not stocked\n";
}
