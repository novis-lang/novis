<?nvs
// Whole numbers come in two kinds. An `int` can go below zero; a `uint`
// cannot, and in exchange it counts twice as high. Neither of them quietly
// wraps round when it runs out of room -- it stops with an error instead, so
// a total that is too big is never silently a small one.

int $balance = -250;
uint $stock = 18446744073709551615;

echo $balance + 100, "\n";
echo $stock, "\n";

try {
    echo $stock + 1, "\n";
} catch (ArithmeticError $e) {
    echo "out of room: ", $e->message, "\n";
}

bool $owing = $balance < 0;
echo $owing ? "owing" : "clear", "\n";
