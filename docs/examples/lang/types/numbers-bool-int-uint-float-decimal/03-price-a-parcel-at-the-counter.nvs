<?nvs
// A parcel being priced up at the counter: how many things are in it, what
// each one costs, and what the lot weighs. The count is a whole number, the
// money is decimal so nothing drifts by a penny, and the weight is a float
// because the scale is not exact either. Money and weights never end up in
// the same sum.

uint $items = 3;
decimal $each = 12.75;
float $kilos = 0.84;

decimal $goods = $each * $items;
decimal $postage = 2.50;
if ($kilos > 0.5) {
    $postage = 4.90;
}
decimal $due = $goods + $postage;

echo $items, " items at ", $each, " each = ", $goods, "\n";
echo "postage ", $postage, " for ", $kilos * 1000, " g\n";
echo "due ", $due, "\n";
