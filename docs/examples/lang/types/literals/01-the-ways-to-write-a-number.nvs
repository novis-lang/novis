<?nvs
// The same number can be written in more than one way. Underscores between
// the digits are there for your eyes only, and a number can be given in base
// sixteen, base two or base eight.

int $seats = 1_000_000;
int $mask = 0xFF;
int $flags = 0b1011;
int $mode = 0o644;

echo $seats, " ", $mask, " ", $flags, " ", $mode, "\n";

// A zero at the front is only a zero. `017` is seventeen here. In PHP and in
// C the same digits mean fifteen, so this is worth knowing if you arrive
// from either.
int $seventeen = 017;

echo $seventeen, "\n";

// A number with a dot or an exponent in it is a float. The digits before the
// dot or after it may be left out.
float $half = .5;
float $five = 5.;
float $thousand = 1e3;

echo $half, " ", $five, " ", $thousand, "\n";
