<?nvs
// Picks a report format from a setting. The setting is text, and the program needs a class.
// `as class<Renders>` converts the text to a class reference once.
// The program then uses `$format` to create the report and to call the static method `extension`.

interface Renders {
    public function render(array<string> $rows): string;
    public static function extension(): string;
}

class CsvReport implements Renders {
    public function render(array<string> $rows): string {
        return Core\Str::join($rows, ",");
    }
    public static function extension(): string {
        return "csv";
    }
}

class LinesReport implements Renders {
    public function render(array<string> $rows): string {
        return Core\Str::join($rows, "\n");
    }
    public static function extension(): string {
        return "txt";
    }
}

array<string> $rows = ["north", "south"];
string $setting = "CsvReport";

class<Renders> $format = $setting as class<Renders>;
Renders $report = new $format();

echo $format::extension(), "\n";
echo $report->render($rows), "\n";
echo ($report is CsvReport) ? "wrote a spreadsheet\n" : "wrote plain text\n";
