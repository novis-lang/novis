<?nvs
// What this looks like at work: filling orders out of one stock figure. The
// method both answers how much it shipped and updates the figure the caller
// is holding, so the two can never drift apart. Both ends say `inout`, so a
// reader of the call knows the variable is about to change.

class Stock
{
    public static function take(inout int $available, int $wanted): int
    {
        int $given = $wanted < $available ? $wanted : $available;
        $available = $available - $given;

        return $given;
    }
}

int $available = 15;
array<int> $orders = [4, 4, 5];

foreach ($orders as int $order) {
    int $shipped = Stock::take(inout $available, $order);
    echo "order for ", $order, ": shipped ", $shipped, ", left ", $available, "\n";
}

// The parameter may be named at the call like any other.
echo "one more: ", Stock::take(inout available: $available, wanted: 2), "\n";
echo "left: ", $available, "\n";
