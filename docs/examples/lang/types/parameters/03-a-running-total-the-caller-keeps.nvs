<?nvs
// Fills orders from one stock count. `take` returns how much it shipped, and it also
// changes the caller's variable `$available`. The method and the call both write `inout`,
// so a reader of the call can see that the variable will change.

class Stock
{
    public static function take(inout int $available, int $wanted): int
    {
        var $given = $wanted < $available ? $wanted : $available;
        $available = $available - $given;

        return $given;
    }
}

var $available = 15;
var $orders = [4, 4, 5];

foreach ($orders as var $order) {
    var $shipped = Stock::take(inout $available, $order);
    echo "order for ", $order, ": shipped ", $shipped, ", left ", $available, "\n";
}

// You can also write the parameter's name at the call, as with any other parameter.
echo "one more: ", Stock::take(inout available: $available, wanted: 2), "\n";
echo "left: ", $available, "\n";
