<?nvs
// You can write an argument with its parameter's name in front of it.
// You can then leave out any parameter that has a default value.
// The call is also easier to read, because each value has its name beside it.

class Slot
{
    public static function book(string $who, string $day = "Monday", string $time = "09:00", int $minutes = 30): string
    {
        return $who . " on " . $day . " at " . $time . " for " . ($minutes as string) . " minutes";
    }
}

echo Slot::book("Ada"), "\n";

// Only `minutes` is given. The other parameters use their default values.
echo Slot::book("Ada", minutes: 60), "\n";

// You can write named arguments in any order. Here `time` comes before `day`,
// but the method declares `day` first.
echo Slot::book("Ada", time: "14:00", day: "Friday"), "\n";

// You can name every argument. An argument without a name must come before the named ones.
echo Slot::book(who: "Ada", day: "Friday"), "\n";

// Methods from `Core` accept named arguments too. This prints `007`.
echo Core\Str::padStart("7", length: 3, padding: "0"), "\n";
