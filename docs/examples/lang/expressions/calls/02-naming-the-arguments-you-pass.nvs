<?nvs
// Shows the ways an argument list is written: by position, by name in any
// order, and as a list poured into a method that takes any number of
// arguments.

class Ticket {
    // The last two parameters have a default, so a caller may write one
    // argument or all three.
    public static function price(int $seats, int $each = 20, int $booking = 3): int {
        return $seats * $each + $booking;
    }

    // `...$prices` collects everything left over into one array.
    public static function cheapest(int ...$prices): int {
        int $best = 0;

        foreach ($prices as int $price) {
            if ($best == 0 || $price < $best) {
                $best = $price;
            }
        }

        return $best;
    }
}

// By position: the arguments line up with the parameters, left to right.
// This prints 43.
echo Ticket::price(2, 20, 3), "\n";

// By name, in whatever order reads best, and how you leave out a parameter in
// the middle: `each` keeps its default of 20. This prints 26.
echo Ticket::price(booking: 6, seats: 1), "\n";

// As many arguments as you have to hand. This prints 26.
echo Ticket::cheapest(43, 26, 33), "\n";

// A list you already hold goes into the same method in one piece, with `...`.
// This prints 26.
array<int> $offers = [43, 26, 33];
echo Ticket::cheapest(...$offers), "\n";
