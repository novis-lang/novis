<?nvs
// Shows the ways to write the arguments of a call: by position, by name in
// any order, and as an array passed to a method that takes any number of
// arguments.

class Ticket
{
    // The last two parameters have a default, so a caller may write one
    // argument or all three.
    public static function price(int $seats, int $each = 20, int $booking = 3): int
    {
        return $seats * $each + $booking;
    }

    // `...$prices` collects everything left over into one array.
    public static function cheapest(int ...$prices): int
    {
        int $best = 0;

        foreach ($prices as int $price) {
            if ($best == 0 || $price < $best) {
                $best = $price;
            }
        }

        return $best;
    }
}

// By position: the first argument is for the first parameter, and so on.
// This prints 43.
echo Ticket::price(2, 20, 3), "\n";

// By name, in any order. The parameter `each` in the middle is left out, so
// it has its default of 20. This prints 26.
echo Ticket::price(booking: 6, seats: 1), "\n";

// Any number of arguments. This prints 26.
echo Ticket::cheapest(43, 26, 33), "\n";

// `...` passes each value of an array as one argument. This prints 26.
array<int> $offers = [43, 26, 33];
echo Ticket::cheapest(...$offers), "\n";
