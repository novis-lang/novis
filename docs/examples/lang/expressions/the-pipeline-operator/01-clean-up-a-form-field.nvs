<?nvs
// Shows how to clean up an email address from a signup form in two steps.
// `|>` gives the value on its left to the step on its right. `$_` marks where
// the value goes. The steps run from left to right.
// The first address prints as ada@example.com.

array<string> $submitted = ["  Ada@Example.COM ", "BOB@example.com", " carol@Example.Com  "];

foreach ($submitted as string $raw) {
    string $email = $raw |> Core\Str::trim($_) |> Core\Str::lower($_);
    echo $email, "\n";
}
