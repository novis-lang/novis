<?nvs
// Shows how to declare an attribute, attach it to a class and read it back.

// `attribute Table on class` declares an attribute that a class may carry.
// The fields in the braces are the values each use must give.
attribute Table on class { name: string }

#[Table(name: 'users')]
class User
{
    public string $email = '';
}

// `Core\Attributes::get` returns the values attached to the class, or `null`
// when the class has none. `User::constructor` names the class itself.
var $table = Core\Attributes::get<Table>(User::constructor);
if ($table != null) {
    // This prints `users`.
    echo $table->name, "\n";
}

// A class with no attribute on it. The result is `null`.
class Session
{}

var $none = Core\Attributes::get<Table>(Session::constructor);
echo $none == null ? "no table name\n" : "a table name\n";
