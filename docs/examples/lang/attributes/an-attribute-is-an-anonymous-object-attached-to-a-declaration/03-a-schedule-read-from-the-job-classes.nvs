<?nvs
// A nightly schedule that reads itself from the job classes. Each class says
// how often it runs, so adding a job means writing one class. There is no
// second list to keep up to date.

class Every
{
    public const int HOUR = 60;
    public const int QUARTER_HOUR = 15;
}

// Only a class that implements `Job` may use the attribute `Meta`. Outside
// `Job`, you write the names as `Job::Level` and `Job::Meta`.
interface Job
{
    enum Level: int
    {
        Normal = 1,
        Urgent = 2,
    }

    attribute Meta on class { name: string, everyMinutes: int, level: Level }
}

// A class constant and an enum case are both allowed in an attribute, because
// their values are known while the program is compiled.
#[Meta(name: 'send invoices', everyMinutes: Every::HOUR, level: Job::Level::Normal)]
class SendInvoices implements Job
{
    public static function run(): string
    {
        return '12 invoices sent';
    }
}

#[Meta(name: 'clean sessions', everyMinutes: Every::QUARTER_HOUR, level: Job::Level::Normal)]
class CleanSessions implements Job
{
    public static function run(): string
    {
        return '84 sessions removed';
    }
}

#[Meta(name: 'charge cards', everyMinutes: Every::HOUR, level: Job::Level::Urgent)]
class ChargeCards implements Job
{
    public static function run(): string
    {
        return '3 cards charged';
    }
}

var $schedule = [
    Core\Attributes::get<Job::Meta>(SendInvoices::constructor) ?? throw new RuntimeError('no job'),
    Core\Attributes::get<Job::Meta>(CleanSessions::constructor) ?? throw new RuntimeError('no job'),
    Core\Attributes::get<Job::Meta>(ChargeCards::constructor) ?? throw new RuntimeError('no job'),
];

foreach ($schedule as var $job) {
    string $mark = $job->level == Job::Level::Urgent ? ' (urgent)' : '';
    echo $job->name, ': every ', $job->everyMinutes as string, ' minutes', $mark, "\n";
}
