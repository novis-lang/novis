<?nvs
// Shows that `get` needs at most one attribute of the kind you name. `Engine`
// has two `Tag` attributes, so this program does not compile. Use `all` instead.
// proof: compile-error

repeatable attribute Tag on class { label: string }

#[Tag(label: 'fast')]
#[Tag(label: 'safe')]
class Engine
{}

var $tag = Core\Attributes::get<Tag>(Engine::constructor);
