<?nvs
// Shows how to read every attribute of one kind attached to one declaration.
// `Core\Attributes::all` returns them in the order they are written.

// `repeatable` allows more than one `Tag` on the same method.
repeatable attribute Tag on method { name: string }

class Article
{
    #[Tag(name: 'news')]
    #[Tag(name: 'sport')]
    #[Tag(name: 'local')]
    public function publish(): int
    {
        return 1;
    }

    public function archive(): int
    {
        return 2;
    }
}

// This prints `news`, `sport` and `local`, one per line, in that order.
var $tags = Core\Attributes::all<Tag>(Article::publish);
foreach ($tags as var $tag) {
    echo $tag->name, "\n";
}

// `archive` has no attribute. The result is an empty list, so this prints 0.
var $none = Core\Attributes::all<Tag>(Article::archive);
echo Core\Arr::count($none), "\n";
