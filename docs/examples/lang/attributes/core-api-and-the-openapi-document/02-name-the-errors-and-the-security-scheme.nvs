<?nvs
// Shows how to say which errors an operation returns, and which security
// scheme it needs. Each entry in `errors:` becomes one response in the
// generated API document. Novis checks that the class you name is a class this
// program declares.

class NotFound extends RuntimeError {}

class Payments {
    /// Show one payment. Returns the amount in cents.
    #[Core\Route(path: "/payments/{id}", method: Core\Http\Method::Get, name: "Payments::show")]
    #[Core\Access(allow: Core\Audience::Public)]
    #[Core\Api(
        tags: ["Payments"],
        // A client of this API sends a bearer token with every request.
        security: ["bearer"],
        errors: [{status: 404, type: NotFound::class}],
    )]
    public function show(uint $id): uint {
        if ($id == 0) {
            throw new NotFound("there is no payment 0");
        }
        return $id * 100;
    }
}

Payments $payments = new Payments();
// This prints `700`.
echo $payments->show(7), "\n";

// The error the document names is an ordinary error. Your code throws it and
// catches it in the usual way.
try {
    echo $payments->show(0), "\n";
} catch (NotFound $error) {
    echo "not found: ", $error->message, "\n";
}
