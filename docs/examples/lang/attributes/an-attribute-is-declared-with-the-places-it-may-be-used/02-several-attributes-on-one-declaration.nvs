<?nvs
// Shows several attributes on one declaration, and an attribute on a property
// and on a parameter.

// `repeatable` allows more than one `Tag` on the same declaration.
// `on class, property` lists where a `Tag` may be written.
repeatable attribute Tag on class, property { label: string }

// A second attribute, for parameters only.
attribute Inject on parameter { from: string }

#[Tag(label: 'billing')]
#[Tag(label: 'nightly')]
class Invoice
{
    #[Tag(label: 'money')]
    public int $cents = 0;

    public function send(#[Inject(from: 'config')] string $to): string
    {
        return $to;
    }
}

// `Core\Attributes::all` returns every `Tag` on the class, in the order you
// wrote them. This prints 2, `billing` and `nightly`.
var $tags = Core\Attributes::all<Tag>(Invoice::constructor);
echo Core\Arr::count($tags), "\n";
foreach ($tags as var $tag) {
    echo $tag->label, "\n";
}

// The second argument is the name of the property or the parameter.
// This prints `money`.
var $onProperty = Core\Attributes::get<Tag>(Invoice::constructor, 'cents');
if ($onProperty != null) {
    echo $onProperty->label, "\n";
}

// The parameter `$to` of the method `send` has an `Inject`. This prints `config`.
var $onParameter = Core\Attributes::get<Inject>(Invoice::send, 'to');
if ($onParameter != null) {
    echo $onParameter->from, "\n";
}
