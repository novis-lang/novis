<?nvs
// Shows that `implementingWith` reads only the attribute you name. `Menu` and
// `Footer` have the same field, and each call finds only its own attribute.

attribute Menu on method { title: string }
attribute Footer on method { title: string }

interface Page
{
    public function render(): string;
}

class Contact implements Page
{
    #[Menu(title: 'Contact us')]
    public function render(): string
    {
        return '/contact';
    }
}

class Imprint implements Page
{
    #[Footer(title: 'Imprint')]
    public function render(): string
    {
        return '/imprint';
    }
}

// `Imprint` has no `Menu`, so its `attribute` is `null`.
// This prints `/contact -> Contact us` and then `/imprint -> (not in the menu)`.
foreach (Core\Program::implementingWith<Page, Menu>('render') as var $row) {
    echo $row->instance->render(), ' -> ', $row->attribute?->title ?? '(not in the menu)', "\n";
}

// The same pages, read for `Footer`. This time, only `Imprint` has a title.
foreach (Core\Program::implementingWith<Page, Footer>('render') as var $row) {
    echo $row->instance->render(), ' -> ', $row->attribute?->title ?? '(not in the footer)', "\n";
}
