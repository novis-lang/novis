<?nvs
// Shows how to reach every class that implements an interface.
// `Core\Program::implementing` gives you one new object per class. Novis finds
// the classes while it compiles your program, so a new class joins the list by
// existing.

interface Check {
    public function describe(): string;
}

class DiskSpace implements Check {
    public function describe(): string {
        return "disk space is fine";
    }
}

class Certificates implements Check {
    public function describe(): string {
        return "certificates are valid";
    }
}

class Backups implements Check {
    public function describe(): string {
        return "backups ran last night";
    }
}

// The list is sorted by class name, so `Backups` comes first. The order never
// depends on the order the classes are written in.
foreach (Core\Program::implementing<Check>() as Check $check) {
    echo $check->describe(), "\n";
}
