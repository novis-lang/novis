<?nvs
// `require` runs the file each time your program reaches it, so one file prints
// each section of the report. The program passes the section data in the
// `Section` class from `parts/section.nvs`. Variables are not shared between files.

echo "Support, this morning\n\n";

Section::$title = "Open tickets";
Section::$rows = ["#41 printer jam", "#42 badge reader"];
require 'parts/section.nvs';

Section::$title = "Waiting on a customer";
Section::$rows = ["#38 refund address"];
require 'parts/section.nvs';
