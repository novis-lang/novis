<?nvs
// Shows how a doc comment points at a file, or at one heading of a Markdown file.

/// Pays money back to a customer.
///
/// @see notes/refunds.md
final class Refund
{
    // `#how-a-refund-is-calculated` names a heading of `notes/refunds.md`.
    // The compiler checks that the file has this heading.
    /// Adds up the returned lines and returns the refund in cents.
    ///
    /// @see notes/refunds.md#how-a-refund-is-calculated
    public static function amount(array<int> $lines): int
    {
        int $sum = 0;
        foreach ($lines as int $line) {
            $sum = $sum + $line;
        }
        return $sum;
    }
}

array<int> $returned = [1250, 399];

// This prints 1649.
echo Refund::amount($returned), "\n";
