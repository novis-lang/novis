<?nvs
// One prefix can list several folders. `autoload` searches them in order and
// uses the first file it finds. Put the folder with your own fixes first.
// A class you did not fix is still loaded from the installed package.

autoload 'Acme' from './fixes', './vendor';

use Acme\Pdf\Writer;
use Acme\Pdf\Reader;

echo Writer::describe(), "\n";
echo Reader::describe(), "\n";
