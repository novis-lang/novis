<?nvs
// A short leaderboard, best score first.
// The second thing given to `sort` is one object literal holding its optional
// settings. There are no flags to remember, and the loop says what it takes
// out of the list.

array<int> $scores = [1420, 880, 2310, 1105];
array<int> $ranked = Core\Arr::sort($scores, {order: Core\Order::Desc});

int $place = 1;
foreach ($ranked as int $score) {
    echo $place, ". ", $score, "\n";
    $place = $place + 1;
}
