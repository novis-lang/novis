<?nvs
// Shows the two ways a value of the whole enum enters a smaller type. One
// throws an error when the value is not one of the named cases, the other
// returns `null`.

class File
{
    enum Mode { Read, Write, Append, Exec }

    public static function open(Mode::Read|Mode::Write $mode): string
    {
        return 'opened in mode ' . (($mode as int) as string);
    }
}

File::Mode $wanted = File::Mode::Write;
// `as File::Mode::Read|File::Mode::Write` checks the value while the program
// runs. This prints `opened in mode 1`.
echo File::open($wanted as File::Mode::Read|File::Mode::Write), "\n";

File::Mode $other = File::Mode::Exec;
try {
    echo File::open($other as File::Mode::Read|File::Mode::Write), "\n";
} catch (RuntimeError $error) {
    // The message names every case the type accepts.
    echo 'stopped: ', $error->message, "\n";
}

// `as ?File::Mode::Read|File::Mode::Write` returns `null` for a value outside
// the set. This prints `no mode`.
var $maybe = $other as ?File::Mode::Read|File::Mode::Write;
if ($maybe == null) {
    echo "no mode\n";
} else {
    echo File::open($maybe), "\n";
}
