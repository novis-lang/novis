<?nvs
// Shows that two `catch` clauses in one function need two variable names.
// Both clauses below use `$e`, so this program does not compile.
// proof: compile-error

class Twice
{
    public static function run(): string
    {
        try {
            throw new LogicError("x");
        } catch (LogicError $e) {
            return "a";
        } catch (Throwable $e) {
            return "b";
        }
    }
}

echo Twice::run(), "\n";
