<?nvs
// Shows that a route capture can only have a class type when the class
// implements `Parses`. `Tag` does not, so this program does not compile.
// proof: compile-error

class Tag
{
    public string $text = '';
}

class Posts
{
    #[Core\Route(path: '/posts/{tag}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(Tag $tag): string
    {
        return 'one post';
    }
}
