<?nvs
// Shows a constructor that sets `$n` only when `$big` is true. The other path
// leaves it with no value, so this program does not compile.
// proof: compile-error

class Box
{
    public int $n;

    public function constructor(bool $big)
    {
        if ($big) {
            $this->n = 10;
        }
    }
}
