<?nvs
// Open this file in VS Code with the Novis extension installed.
// Each comment says what the editor shows on the line below it.
// The extension gets this information from `nvs lsp`, the Novis language server.

// `$apiKey` is a `secret` variable. The editor blurs its string when the file opens.
// Hover the string and click `Reveal` to read it. `nvs.secrets.redact` turns the blur off.
secret string $apiKey = "sk-live-not-a-real-key";

// A `tainted` variable has a value from outside the program that is not checked yet.
// The editor does not hide it. Set `nvs.taint.mark` to `declaration` to show a symbol after the name.
tainted string $query = "shoes";

// The extension colours `final`, `class` and the string in `line` as soon as the file opens.
// Then `nvs lsp` tells it that `Receipt` is a class and `$cents` is a property.
final class Receipt
{
    public int $cents = 0;

    // Hover `Core\Str::format` to see what it does. The text comes from the compiler,
    // so you do not install any extra files.
    public function line(): string
    {
        return Core\Str::format("%d cents", $this->cents);
    }
}

var $receipt = new Receipt();
$receipt->cents = 1250;

// The blur only changes what the screen shows. The file still contains the real string,
// so selecting, copying and editing it work as usual.
echo $receipt->line(), "\n";
