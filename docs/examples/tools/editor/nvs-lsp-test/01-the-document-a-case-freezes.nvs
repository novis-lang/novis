<?nvs
// `nvs lsp-test` freezes what the editor answers about a document. This is the
// document half of such a case, kept as a program so you can run it as well.

final class Cart
{
    public int $items = 0;
    public int $cents = 0;

    public function summary(): string
    {
        return Core\Str::format("%d items, %d cents", $this->items, $this->cents);
    }
}

var $cart = new Cart();
$cart->items = 3;
$cart->cents = 1250;

// Put a cursor right after `$cart->` and ask a case for `completion`, and this
// is the answer it freezes -- one line per member, sorted by name, with what
// each one is and its type:
//
//     cents   property  int
//     items   property  int
//     summary method    (): string
//
// A case usually asks about a document that does not parse -- half a line, an
// unclosed brace -- because that is what a buffer looks like while you type.
echo $cart->summary(), "\n";
