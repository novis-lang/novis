<?nvs
// `nvs lsp-test` checks what the language server returns for a document.
// This program is the document part of such a test. You can also run it.

final class Cart
{
    public int $items = 0;
    public int $cents = 0;

    public function summary(): string
    {
        return Core\Str::format("%d items, %d cents", $this->items, $this->cents);
    }
}

var $cart = new Cart();
$cart->items = 3;
$cart->cents = 1250;

// A `completion` test with the cursor after `$cart->` expects `cents`, `items` and `summary`.
// The result has one line for each, sorted by name, with its kind and its type.
echo $cart->summary(), "\n";
