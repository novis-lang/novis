<?nvs
// Shows a password that is read from its own file, so it is never written in `nvs.toml`.

// `Core\Config::get` returns the content of the file. The newline at the end is removed.
// The password has 15 characters, so this prints `15`.
string $password = Core\Config::get("mail.relay.password") ?? "";
echo Core\Str::length($password), "\n";

// This prints `true`. Do not print a password itself. Compare it or pass it on.
echo $password =="correct-horse-7" ? "true" : "false", "\n";

// `password_file` returns the path of the file, not the password.
// This prints `secrets/mail-password`.
echo Core\Config::get("mail.relay.password_file"), "\n";
