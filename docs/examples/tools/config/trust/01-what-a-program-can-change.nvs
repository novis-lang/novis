<?nvs
// Shows what a program can change in its own configuration, and what it cannot.

// The program reads its settings from `nvs.toml`. This prints `128M`.
echo Core\Config::get('memory'), "\n";

// `Core\Config::set` changes a setting for this request only. The file stays the same.
// This prints `yes` and then `64M`.
echo Core\Config::set('memory', '64M') ? 'yes' : 'no', "\n";
echo Core\Config::get('memory'), "\n";

// A program cannot give itself a new right.

// `Core\Config::set('capabilities.fs.write', ...)` does not compile,
// because a program may not change `capabilities.fs.write`.

// A name in a variable is checked only when the program runs. Then `set` returns `false`.
// This prints `no`.
string $right = 'capabilities.fs.write';
echo Core\Config::set($right, '.') ? 'yes' : 'no', "\n";

// Writing a file needs `fs.write`. It is not granted, so this throws a `RuntimeError`.
try {
    Core\IO::write('nvs.toml', "[limits]\nmemory = \"64G\"\n");
} catch (RuntimeError $denied) {
    echo "not allowed to write nvs.toml\n";
}
