<?nvs
// Shows how the state of each version in a package's index file decides what `nvs pkg add` chooses.

// The time of the check, in seconds since 1970. A fixed time gives the same output on every run.
int $now = 1793000000;

// A release sent with a token is pending for seven days.
int $published = $now - 2 * 86400;
int $selectableAt = $published + 7 * 86400;

// Part of the index file of `Acme\Http`. Version 2.0.0 waits for an owner, so it has no time.
string $index = '{"name":"Acme\\\\Http","versions":['
    . '{"version":"1.3.0","state":"released"},'
    . '{"version":"1.4.0","state":{"pending":{"selectable_at":' . ($selectableAt as string) . '}}},'
    . '{"version":"2.0.0","state":{"pending":{"selectable_at":null}}}]}';

var $file = Core\Json::decode($index) as array<mixed>;
var $versions = $file['versions'] as array<mixed>;

// Text from `Core\Json::decode` is tainted, which means it came from outside the program.
tainted string $chosen = 'nothing';
foreach ($versions as mixed $entry) {
    var $release = $entry as array<mixed>;
    var $version = $release['version'] as string;
    mixed $state = $release['state'];

    // A released version can be chosen. A pending version can be chosen once its time has passed.
    if ($state == 'released') {
        echo $version, ": released\n";
        $chosen = $version;
        continue;
    }
    var $pending = ($state as array<mixed>)['pending'] as array<mixed>;
    ?int $at = $pending['selectable_at'] as ?int;
    if ($at == null) {
        echo $version, ": pending until an owner confirms it\n";
    } elseif ($at > $now) {
        int $days = Core\Math::intDiv($at - $now, 86400);
        echo $version, ': pending for ', $days, " more days\n";
    } else {
        echo $version, ": pending, and its time has passed\n";
        $chosen = $version;
    }
}

// `nvs pkg add` chooses the newest version it may choose. This prints `1.3.0`.
echo 'nvs pkg add chooses ', $chosen, "\n";
