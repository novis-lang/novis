<?nvs
// Shows a program using the newer version of a package after `nvs pkg update acme/slug`.
// The command raised the minimum of `Acme\Slug` from 1.2.0 to 1.3.0.

require './vendor/packages.nvs';

// The program now loads version 1.3.0. This prints `1.3.0`.
echo Acme\Slug\Slug::VERSION, "\n";

// Your code calls the package the same way as before. This prints `garden-chair`.
echo Acme\Slug\Slug::make('The Garden Chair'), "\n";
