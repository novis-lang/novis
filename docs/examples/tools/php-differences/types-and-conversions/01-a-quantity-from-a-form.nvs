<?nvs
// Shows how to read a quantity that a user typed into a form, written in Novis.

class Cart {
    // Every parameter and every property declares its type.
    public int $items = 0;

    public function add(string $typed): string {
        // `as ?int` converts the text to a whole number. If that is not possible, the result is `null`.
        ?int $quantity = $typed as ?int;
        // Inside this `if`, `$quantity` is an `int`.
        if ($quantity is int) {
            $this->items = $this->items + $quantity;
            return "added " . $quantity;
        }
        return "'" . $typed . "' is not a whole number";
    }
}

Cart $cart = new Cart();
// This prints "added 3", then two messages, then "added 10".
array<string> $inputs = ["3", "2.5", "three", "10"];
foreach ($inputs as string $typed) {
    echo $cart->add($typed), "\n";
}
echo "Items in the cart: ", $cart->items, "\n";
