<?nvs
// Shows an order confirmation from a PHP program, written in Novis with typed arrays and a heredoc.

// An array written with `[...]` needs a type. `array<string>` is an array of strings.
array<string> $order = ["id" => "1042", "name" => "Ada", "city" => "Vienna"];

// Keyed destructuring copies entries into variables. Each variable has its type.
["id" => string $id, "name" => string $name] = $order;

// A heredoc reads variables and array entries. This prints three lines.
echo <<<EOT
Hello $name,
order #$id ships to {$order["city"]}.
Thank you!

EOT;

// `Core\Debug::dump` prints the whole array to help you debug.
// It writes to standard error, so the output of your program does not contain it.
Core\Debug::dump($order);
