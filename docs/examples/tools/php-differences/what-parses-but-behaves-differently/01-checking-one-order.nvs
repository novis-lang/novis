<?nvs
// Shows six results that are different from PHP, in code that checks one order of a shop.

// `==` compares two strings as text. "007" and "7" are different texts, so this prints "different".
string $typed = "007";
string $stored = "7";
echo $typed == $stored ? "same" : "different", "\n";

// `Core\Str::length` counts what a person sees as one character. This prints 5.
string $customer = "Chloé";
echo Core\Str::length($customer), "\n";

// `decimal` is an exact number type for money. 0.10 plus 0.20 is exactly 0.30, so this prints "paid".
decimal $item = 0.10;
decimal $shipping = 0.20;
decimal $total = $item + $shipping;
decimal $received = 0.30;
echo $total, " ", $total == $received ? "paid" : "not paid", "\n";

// An array key is always a string. `1042` and `"1042"` are the same key, so this prints 5.
array<int> $quantities = [];
$quantities[1042] = 2;
$quantities["1042"] = $quantities["1042"] + 3;
echo $quantities[1042], "\n";

// An `int` that becomes too large throws `ArithmeticError`. This prints "too many points".
int $points = 9223372036854775807;
try {
    $points = $points + 1;
    echo $points, "\n";
} catch (ArithmeticError $tooLarge) {
    echo "too many points\n";
}

// `as int` converts a `float` only when it is a whole number. 2.5 is not, so this prints "not whole".
float $weight = 2.5;
try {
    echo $weight as int, "\n";
} catch (ArithmeticError $notWhole) {
    echo "not whole\n";
}
// `Core\Math::floor` rounds down first. This prints 2.
echo Core\Math::floor($weight) as int, "\n";
