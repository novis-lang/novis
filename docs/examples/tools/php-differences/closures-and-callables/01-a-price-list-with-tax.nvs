<?nvs
// Shows closures from a PHP program, written in Novis with `fn`.

class Shop {
    public static function withTax(int $cents): int {
        return $cents + Core\Math::intDiv($cents, 5);
    }
}

array<int> $prices = [1000, 250, 4000];
int $limit = 2000;

// `fn` makes a closure. It can read `$limit` without a `use` clause.
callable $affordable = fn(int $cents): bool => $cents <= $limit;

// `Shop::withTax(...)` names the method as a value, so `Core\Arr::map` can call it.
array<int> $gross = Core\Arr::map($prices, Shop::withTax(...));

// This prints 1200, 300 and 4800. `yes` means the price is not over the limit.
foreach ($gross as int $cents) {
    echo $cents, $affordable($cents) ? " yes" : " no", "\n";
}
