<?nvs
// Shows the setting in the `nvs.toml` beside this file that a server needs when it runs as a service.

// A service has no terminal. `[log] target` is the file that gets the log of the server.
?string $log = Core\Config::get('log.target');
echo 'log target:             ', $log ?? 'not set', "\n";

// A program can read this setting, but it cannot change it, so `Core\Config::set('log.target', ...)`
// does not compile. Here the name is in a variable, so the call runs and returns `false`.
string $name = 'log.target';
echo 'changed by the program: ', Core\Config::set($name, 'file:/tmp/other.log') ? 'yes' : 'no', "\n";
