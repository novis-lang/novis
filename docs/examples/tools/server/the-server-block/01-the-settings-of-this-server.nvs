<?nvs
// Shows how a program reads the `[server]` block of the `nvs.toml` beside this file.

// `Core\Config::get` returns the value of a setting as a string.
// This prints `/up`, the path that a load balancer checks.
echo 'health check path:      ', Core\Config::get('server.health_path') ?? 'off', "\n";

// This prints `500`. A request over this number gets the response `503`.
echo 'requests at one time:   ', Core\Config::get('server.max_in_flight') ?? 'not set', "\n";

// The file does not set `drain_timeout`, so the result is `null`.
// The server then uses its default of 30 seconds.
echo 'drain timeout:          ', Core\Config::get('server.drain_timeout') ?? 'not set', "\n";

// A program cannot change a setting in this block. `Core\Config::set` returns `false`.
echo 'changed by the program: ', Core\Config::set('server.max_in_flight', '100000') ? 'yes' : 'no', "\n";
