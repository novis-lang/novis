<?nvs
// Shows how a program reads the `[server]` block of the `nvs.toml` beside this file.

// `Core\Config::get` returns the value of a setting as a string.
// This prints `/up`, the path that a load balancer checks.
echo 'health check path:      ', Core\Config::get('server.health_path') ?? 'off', "\n";

// This prints `500`. A request over this number gets the response `503`.
echo 'requests at one time:   ', Core\Config::get('server.max_in_flight') ?? '(no value)', "\n";

// The file does not set `drain_timeout`, so the result is the default, `30s`.
echo 'drain timeout:          ', Core\Config::get('server.drain_timeout') ?? '(no value)', "\n";

// A program cannot change a setting in this block. A name written directly in the
// call does not compile. This name is in a variable, so the call runs and returns `false`.
string $name = 'server.max_in_flight';
echo 'changed by the program: ', Core\Config::set($name, '100000') ? 'yes' : 'no', "\n";
