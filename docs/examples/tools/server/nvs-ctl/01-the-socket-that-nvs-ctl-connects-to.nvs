<?nvs
// Shows how a program reads the control socket of its server. `nvs ctl` connects to this socket.

// The `nvs.toml` beside this file sets `[control] socket`, and `Core\Config::get` returns the value.
// With no `[control]` block the result is `null`, and the server has no control socket.
?string $socket = Core\Config::get('control.socket');
echo 'control socket: ', $socket ?? 'none', "\n";

// `--socket` gives the name of the socket to `nvs ctl` directly.
// This prints the command that reloads this server.
if ($socket != null) {
    echo 'reload command: nvs ctl reload --socket ', $socket, "\n";
}

// A program can read this setting, but it cannot change it.
// `Core\Config::set` returns `false` here.
echo 'changed by the program: ', Core\Config::set('control.socket', '/tmp/other.sock') ? 'yes' : 'no', "\n";
