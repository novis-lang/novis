<?nvs
// Shows the `nvs code` commands that find who calls a method and which classes implement an interface.

namespace Shop;

interface Priced
{
    public function price(): int;
}

class Book implements Priced
{
    public function price(): int
    {
        return 12;
    }
}

class Lamp implements Priced
{
    public function price(): int
    {
        return 30;
    }
}

// `nvs code refs 'Shop\Priced::price'` prints the line where `Priced` declares `price`.
// Then it prints the call in `total`, with its file, line and column.
class Basket
{
    public static function total(array<Priced> $items): int
    {
        int $total = 0;
        foreach ($items as Priced $item) {
            $total += $item->price();
        }
        return $total;
    }

    // `nvs code calls 'Shop\Basket::total' 'Shop\Basket::withShipping'` prints the calls of both methods.
    // Each method gets a line with its name. Its callers and callees are indented under it.
    public static function withShipping(array<Priced> $items): int
    {
        return Basket::total($items) + 5;
    }
}

// `nvs code impls 'Shop\Priced'` prints one line for `Shop\Book` and one for `Shop\Lamp`.
// Each line starts with the file, the line and the column of the class.
array<Priced> $basket = [new Book(), new Lamp(), new Book()];

// This prints `59`.
echo Basket::withShipping($basket), "\n";
