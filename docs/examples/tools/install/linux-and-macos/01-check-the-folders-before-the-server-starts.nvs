<?nvs
// Shows the rule that Novis uses on Linux and macOS, as a script that checks a list of folders.
// Each line of the input is the mode, the owner and the path of one folder.
// On Linux, `stat -c '%a %U %n' /opt/novis /opt/novis/*` prints such lines.

class Layout {
    // The account that runs `nvs` on this host.
    public const string ACCOUNT = "novis";

    public static function check(tainted string $input): void {
        foreach (Core\Str::lines($input) as tainted string $line) {
            array<tainted string> $cells = Core\Str::split($line, " ", {limit: 3});
            if (Core\Arr::count($cells) != 3) {
                continue;
            }
            // The mode is an octal number, so `775` is read in base 8.
            int $mode = Core\Math::fromBase($cells[0], 8);
            tainted string $owner = $cells[1];
            tainted string $path = $cells[2];

            // The owner must be `root` or the account that runs `nvs`.
            if ($owner != "root" && $owner != self::ACCOUNT) {
                echo $path, ": fails. The owner is ", $owner, ".\n";
                continue;
            }
            // `0o020` is the write bit for the group. `0o002` is the write bit for others.
            if (($mode & 0o022) != 0) {
                echo $path, ": fails. Run `chmod go-w ", $path, "`.\n";
                continue;
            }
            echo $path, ": passes\n";
        }
    }
}

// The input is the file `01-check-the-folders-before-the-server-starts.in` beside this one.
// Two of its five folders fail.
Layout::check(Core\IO::stdin());
