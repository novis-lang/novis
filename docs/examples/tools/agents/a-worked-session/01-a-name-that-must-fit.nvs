<?nvs
// Shows a program that was written after three lookups with `nvs agent`.
// It checks that a name has at most 20 characters and at most 32 bytes.

// `nvs agent find length` lists two functions: `Core\Str::length` and `Core\Bytes::length`.
// `nvs agent show 'Core\Str::length'` prints that this function counts characters.
array<string> $names = ["Zoë", "Björk Guðmundsdóttir", "👩‍👩‍👧‍👦 The Family Account Of Us"];
foreach ($names as string $name) {
    uint $characters = Core\Str::length($name);
    // `nvs agent show 'Core\Bytes::length'` prints that this function counts bytes.
    // `as bytes` converts the text to its bytes. "Zoë" has 3 characters and 4 bytes.
    uint $size = Core\Bytes::length($name as bytes);
    string $verdict = $characters <= 20 && $size <= 32 ? "fits" : "too long";
    echo $name, ": ", $characters, " characters, ", $size, " bytes, ", $verdict, "\n";
}
// The last name has 26 characters, so its line ends with `too long`.
// `nvs check 01-a-name-that-must-fit.nvs` prints `no errors` for this file.
