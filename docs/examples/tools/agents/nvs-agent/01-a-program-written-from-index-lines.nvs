<?nvs
// Shows a program written from lines that `nvs agent find` printed.
// Each step names the command and the line that the step uses.

array<string> $tags = ["urgent", "billing", "eu"];

// `nvs agent find count` lists `Core\Arr::count(array<T> $a): uint`.
// This prints `3 tags`.
echo Core\Arr::count($tags), " tags\n";

// `nvs agent find join` lists `Core\Str::join(array<string> $parts, string $separator = ""): string`.
// The part `= ""` is a default value, so the second argument is optional.
echo Core\Str::join($tags, ", "), "\n";
echo Core\Str::join($tags), "\n";

// `nvs agent find strtoupper` prints nothing. No function has that name.
// `nvs agent find upper` lists `Core\Str::upper(string $s): string`. This prints `URGENT`.
echo Core\Str::upper($tags[0]), "\n";
