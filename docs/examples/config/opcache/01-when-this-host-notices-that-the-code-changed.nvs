<?nvs
// Shows the settings that control how a running server notices a changed source file.

// `validate` is how the server checks a file. `mtime` compares the time the file
// was last changed, and `hash` reads the whole file. The default is `mtime`.
echo 'validate:        ', Core\Config::get('opcache.validate') ?? '(not written, so the default)', "\n";

// `revalidate_freq` is how often the server checks. `settle` is how long the
// files must stay unchanged before the server compiles them again.
echo 'revalidate_freq: ', Core\Config::get('opcache.revalidate_freq') ?? '(not written, so the default)', "\n";
echo 'settle:          ', Core\Config::get('opcache.settle') ?? '(not written, so the default)', "\n";

// Only the person who runs the server may change these settings.
// A program cannot, so each call below returns `false`.
echo 'check by hash:          ', Core\Config::set('opcache.validate', 'hash') ? 'allowed' : 'not allowed', "\n";
echo 'check on every request: ', Core\Config::set('opcache.revalidate_freq', '0') ? 'allowed' : 'not allowed', "\n";
echo 'compile at once:        ', Core\Config::set('opcache.settle', '0s') ? 'allowed' : 'not allowed', "\n";

// The default of `settle` depends on the run mode. It is `1s` in production
// and `100ms` in development. A program cannot change the mode either.
echo 'change the mode:        ', Core\Config::set('mode.default', 'development') ? 'allowed' : 'not allowed', "\n";
echo 'settle is still:        ', Core\Config::get('opcache.settle') ?? '(not written, so the default)', "\n";
