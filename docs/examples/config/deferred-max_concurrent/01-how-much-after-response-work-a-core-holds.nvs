<?nvs
// Work that runs after the response is sent keeps its request open a little longer.
// `[deferred] max_concurrent` is how many of those requests one core keeps at one time.
// This file sets it:
//
//     [deferred]
//     max_concurrent = 256

echo 'requests held per core: ', Core\Config::get('deferred.max_concurrent') ?? '(no value)', "\n";

// A waiting request keeps its memory, up to `limits.hard.memory`.
// The `nvs.toml` beside this program sets it to `512M`, so this prints `512M`.
echo 'each may hold up to:    ', Core\Config::get('limits.hard.memory') ?? '(nothing)', "\n";

// The right limit depends on the size of the machine. A program may read it but not
// change it. `Core\Config::set` returns `false`, so this prints `no`.
string $name = 'deferred.max_concurrent';
echo 'raise it from code:     ', Core\Config::set($name, '4096') ? 'yes' : 'no', "\n";

// `Core\Task::runAfterResponse` runs this function after the response is sent. At the limit, it
// throws an error, and the request can do the work itself.
Core\Task::runAfterResponse(fn(): void => {
    echo "and the work itself runs once the answer is on its way\n";
});

echo "answered\n";
