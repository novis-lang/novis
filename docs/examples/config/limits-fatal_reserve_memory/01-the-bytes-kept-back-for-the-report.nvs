<?nvs
// `limits.fatal_reserve_memory` keeps some memory back for one job. When a request
// runs out of memory, the code that reports the error runs in this memory.
// Nothing else can use it.

echo 'the heap a request starts with: ', Core\Config::get('limits.memory') ?? '(unset)', "\n";
echo 'held back for the report:       ', Core\Config::get('limits.fatal_reserve_memory') ?? '(unset)', "\n";

// The reserve is part of `limits.memory`, so normal work gets the rest.
// `Core\Fatal::onLimit` registers the function that runs in the reserve.
Core\Fatal::onLimit(fn (): void => {
    echo "the request stopped on a limit\n";
});

// Only the person who runs the server may set the reserve. A program cannot
// make it bigger or set it to `0`, so both calls return `false`.
echo 'ask for a bigger net:           ', Core\Config::set('limits.fatal_reserve_memory', '64M') ? 'accepted' : 'refused', "\n";
echo 'ask for no net:                 ', Core\Config::set('limits.fatal_reserve_memory', '0') ? 'accepted' : 'refused', "\n";
echo 'still:                          ', Core\Config::get('limits.fatal_reserve_memory') ?? '(unset)', "\n";

// A program may change `limits.memory` for itself. The reserve is then taken
// from the new value.
echo 'keep myself small:              ', Core\Config::set('limits.memory', '64M') ? 'accepted' : 'refused', "\n";
echo 'heap now:                       ', Core\Config::get('limits.memory') ?? '(unset)', "\n";
