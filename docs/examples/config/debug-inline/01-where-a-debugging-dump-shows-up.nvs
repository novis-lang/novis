<?nvs
// `Core\Debug::dump` always writes to the log. `[debug] inline` says whether an HTML page
// also shows the dump at its end. This file sets nothing, so the run mode is used.
// In development mode the page shows the dump. In production mode it does not.

echo 'written here: ', Core\Config::get('debug.inline') ?? '(nothing, so the mode decides)', "\n";

// A program may never turn this setting on, so this prints `no`. A dump you forget
// in your code writes only to the log. It never appears in the response.
echo 'turn it on:   ', Core\Config::set('debug.inline', 'true') ? 'yes' : 'no', "\n";

// A program may not turn it off either. It may only lower a number, such as a memory
// limit or a timeout. To turn the setting off, run the server in production mode.
echo 'turn it off:  ', Core\Config::set('debug.inline', 'false') ? 'yes' : 'no', "\n";

// In a command-line program, `Core\Debug::dump` writes to the error stream.
// The normal output does not contain the dump, so you can still pipe it to another program.
Core\Debug::dump(['order' => 1042, 'total' => '19.90']);
echo "done\n";
