<?nvs
// `[session]` sets where sessions are stored, how long an unused one is kept,
// and the name of the session cookie:
//
//     [session]
//     backend = "shared"       # or "db"; no other value is allowed
//     ttl     = "2h"
//     cookie  = "nvs_session"

echo 'records live in: ', Core\Config::get('session.backend') ?? '(nothing written — a program that wants a session says so)', "\n";
echo 'untouched for:   ', Core\Config::get('session.ttl') ?? '(nothing written — two hours)', "\n";
echo 'cookie name:     ', Core\Config::get('session.cookie') ?? '(nothing written — the default name)', "\n";

// There are only two stores. The next request may run on another server, so
// a local cache is not allowed and this call returns `false`.
echo 'keep mine in a local cache: ', Core\Config::set('session.backend', 'local') ? 'accepted' : 'refused', "\n";

// A program cannot change how long a session is kept. A longer time makes a
// stolen session cookie useful for longer.
echo 'keep mine for a year:       ', Core\Config::set('session.ttl', '8760h') ? 'accepted' : 'refused', "\n";

// A program cannot rename the cookie either. Every cookie this server writes is
// secure, HTTP-only and same-site, and no setting changes that.
echo 'rename the cookie:          ', Core\Config::set('session.cookie', 'sid') ? 'accepted' : 'refused', "\n";
