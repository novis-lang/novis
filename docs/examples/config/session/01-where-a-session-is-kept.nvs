<?nvs
// `[session]` sets where sessions are stored, how long values are kept,
// and the name of the session cookie:
//
//     [session]
//     backend     = "shared"   # or "db"; no other value is allowed
//     short_lived = "2h"
//     long_lived  = "180d"
//     cookie      = "nvs_session"

// This file does not write `[session]`. So the last three keys have their defaults.
echo 'records live in: ', Core\Config::get('session.backend') ?? '(nothing written — a program that wants a session says so)', "\n";
echo 'short-lived for: ', Core\Config::get('session.short_lived') ?? '(no value)', "\n";
echo 'long-lived for:  ', Core\Config::get('session.long_lived') ?? '(no value)', "\n";
echo 'cookie name:     ', Core\Config::get('session.cookie') ?? '(no value)', "\n";

// There are only two stores. The next request may run in another server process,
// so `memory` is not allowed and this call returns `false`.
echo 'keep mine in memory:        ', Core\Config::set('session.backend', 'memory') ? 'accepted' : 'refused', "\n";

// A program cannot change how long a session value is kept. A longer time makes a
// stolen session cookie useful for longer.
echo 'keep mine for a year:       ', Core\Config::set('session.short_lived', '8760h') ? 'accepted' : 'refused', "\n";

// A program cannot rename the cookie either. Every cookie this server writes is
// secure, HTTP-only and same-site, and no setting changes that.
echo 'rename the cookie:          ', Core\Config::set('session.cookie', 'sid') ? 'accepted' : 'refused', "\n";
