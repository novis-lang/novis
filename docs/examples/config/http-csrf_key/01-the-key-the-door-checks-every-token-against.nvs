<?nvs
// `[http] csrf_key` is the one key the server door verifies a presented CSRF
// token against. Naming it is what turns the token half of the check on: until
// it is named there is no token this deployment ever issued, so a covered
// request arriving without one has nothing to be missing. This configuration
// names none.

echo 'door key:       ', Core\Config::get('http.csrf_key') ?? '(nothing, so no token is expected yet)', "\n";
echo 'read from file: ', Core\Config::get('http.csrf_key_file') ?? '(nothing)', "\n";

// It is not a program's to name, and this is the plainest case of why: the door
// checks every request against this one key, so a request that could write it
// would be choosing which forgeries the requests beside it accept.
echo 'name one here:  ', Core\Config::set('http.csrf_key', 'a-key-of-my-own') ? 'yes' : 'no', "\n";
echo 'or name a file: ', Core\Config::set('http.csrf_key_file', '/tmp/csrf.key') ? 'yes' : 'no', "\n";

// With no key named, what is still refused is the forgery the check is named
// for: a browser request that arrives somewhere other than where its `Origin`
// says it came from. What is not refused is a covered request that sent no
// `Origin` at all — every non-browser caller — and naming the key is what
// covers those.

// A program that wants tokens of its own does not wait for the deployment to
// name anything. It holds its own key and issues against that, and the two keys
// are for two different jobs: this one proves a form came from this
// application's page, and the door's proves it to the door.
secret bytes $mine = Core\Crypto::generateKey();
string $token = Core\Csrf::issue('sid-ada', $mine);
echo 'own token:      ', Core\Csrf::verify($token, 'sid-ada', $mine) ? 'accepted' : 'refused', "\n";
echo 'other session:  ', Core\Csrf::verify($token, 'sid-bob', $mine) ? 'accepted' : 'refused', "\n";
