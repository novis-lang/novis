<?nvs
// `[tls.client]` configures every outbound TLS connection: HTTP calls, mail, LDAP, databases and
// the shared cache. It sets the trusted certificates, the lowest TLS version and a key log file.
// This file sets the lowest version to `1.2` and does not set the other two.

echo 'oldest version:   ', Core\Config::get('tls.client.min_version') ?? '(no value)', "\n";
echo 'secrets written:  ', Core\Config::get('tls.client.keylog') ?? '(nothing, so none)', "\n";

// `roots` is a list. `Core\Config::get` cannot read a list, so it returns `null`. Without `roots`, Novis trusts its
// built-in certificate authorities. `roots = ["bundled", "/etc/novis/corp-ca.pem"]` adds one more.
echo 'trust anchors:    ', Core\Config::get('tls.client.roots') ?? '(a list: the shipped set)', "\n";

// A program cannot change these three settings. With the key written in the call, the program
// does not compile. Here the keys are in variables, so `Core\Config::set` runs and returns `false`.
string $roots = 'tls.client.roots';
string $minVersion = 'tls.client.min_version';
string $keylog = 'tls.client.keylog';
echo 'trust one more:   ', Core\Config::set($roots, '["/tmp/mine.pem"]') ? 'yes' : 'no', "\n";
echo 'speak older TLS:  ', Core\Config::set($minVersion, '1.2') ? 'yes' : 'no', "\n";
echo 'write secrets:    ', Core\Config::set($keylog, '/tmp/keys.log') ? 'yes' : 'no', "\n";

// The failed calls changed nothing, so the oldest version is still `1.2`.
echo 'still in force:   ', Core\Config::get('tls.client.min_version') ?? '(nothing)', "\n";
