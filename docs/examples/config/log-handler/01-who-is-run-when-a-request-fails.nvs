<?nvs
// `[log] handler` names a script that runs when a request fails. It runs when the
// program has no handler of its own, or when that handler could not run.

echo 'the handler on duty: ', Core\Config::get('log.handler') ?? '(none written — the floor writes the record itself)', "\n";
echo 'memory held back:    ', Core\Config::get('log.handler_reserve_memory') ?? '(no value)', "\n";
echo 'time held back:      ', Core\Config::get('log.handler_reserve_time') ?? '(no value)', "\n";

// A program registers its own handler with `Core\Fatal::onLimit`. The function
// you give it runs inside the request that failed.
Core\Fatal::onLimit(fn(): void => {
    echo "the program's own handler ran\n";
});

// A program cannot change `log.handler`. The compiler checks a setting name written as text,
// so `Core\Config::set('log.handler', ...)` does not compile. Here the name is in a variable, so both calls run and return `false`.
string $handler = 'log.handler';
echo 'point it at my script: ', Core\Config::set($handler, 'scripts/mine.nvs') ? 'accepted' : 'refused', "\n";
echo 'or take it off:        ', Core\Config::set($handler, '') ? 'accepted' : 'refused', "\n";

// The two reserve keys set the memory and time that script gets. A program
// cannot change them either.
string $reserveMemory = 'log.handler_reserve_memory';
string $reserveTime = 'log.handler_reserve_time';
echo 'widen its memory:      ', Core\Config::set($reserveMemory, '1G') ? 'accepted' : 'refused', "\n";
echo 'narrow its time:       ', Core\Config::set($reserveTime, '1ms') ? 'accepted' : 'refused', "\n";
