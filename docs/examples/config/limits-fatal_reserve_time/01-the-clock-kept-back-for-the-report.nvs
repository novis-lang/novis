<?nvs
// The other half of the same safety net. A request stopped for spending too
// much time has no time left to say so either, so a slice of the clock is held
// back beside the slice of the heap.

echo 'cpu time to start with:   ', Core\Config::get('limits.cpu_time') ?? '(unset — none was written)', "\n";
echo 'clock held back:          ', Core\Config::get('limits.fatal_reserve_time') ?? '(unset)', "\n";
echo 'heap held back beside it: ', Core\Config::get('limits.fatal_reserve_memory') ?? '(unset)', "\n";

// Both halves are the operator's, and for one reason: a program choosing how
// long its own crash report may take is choosing it at the worst moment there
// is. Neither can be widened, and neither can be given away.
array<string> $net = ['limits.fatal_reserve_time', 'limits.fatal_reserve_memory'];
foreach ($net as string $half) {
    echo 'widen ', $half, ': ', Core\Config::set($half, '10s') ? 'accepted' : 'refused', "\n";
    echo 'drop  ', $half, ': ', Core\Config::set($half, '0') ? 'accepted' : 'refused', "\n";
}

// The budget the slice comes out of is the program's own to lower. A job that
// knows it should be quick says so, and the report still gets its slice of
// whatever it asked for.
echo 'bound my own cpu time:    ', Core\Config::set('limits.cpu_time', '2s') ? 'accepted' : 'refused', "\n";
echo 'in force now:             ', Core\Config::get('limits.cpu_time') ?? '(unset)', "\n";
