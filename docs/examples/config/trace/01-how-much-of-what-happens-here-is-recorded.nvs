<?nvs
// `[trace]` sets where request traces are sent and what share of requests is
// traced. It also sets whether an outgoing call sends the trace header.

// This file does not write `[trace]`. So the exporter is `false`, `sample` is `0.0`
// and `propagate` is `true`. These are the defaults.
echo 'exporter:  ', Core\Config::get('trace.exporter') ?? '(no value)', "\n";
echo 'push to:   ', Core\Config::get('trace.endpoint') ?? '(nothing written)', "\n";
echo 'sample:    ', Core\Config::get('trace.sample') ?? '(no value)', "\n";
echo 'propagate: ', Core\Config::get('trace.propagate') ?? '(no value)', "\n";

// `exporter` and `sample` are separate settings. `sample` starts at `0`, so you
// must set both before any trace is sent.

// Only the person who runs the server may change `[trace]`. A program cannot
// trace more of its own requests, so this call returns `false`.
echo 'record every request of mine: ', Core\Config::set('trace.sample', '1.0') ? 'accepted' : 'refused', "\n";

// A program cannot trace fewer of its requests either. This call also returns `false`.
echo 'record none of them:          ', Core\Config::set('trace.sample', '0.0') ? 'accepted' : 'refused', "\n";

// A program cannot stop sending the trace header on outgoing calls. This call
// returns `false` too.
echo 'leave the trace behind:       ', Core\Config::set('trace.propagate', 'false') ? 'accepted' : 'refused', "\n";
