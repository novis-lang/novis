<?nvs
// `[opcache] file_cache_dir` is the directory where the server keeps code it has
// already compiled. No other setting names this directory.

echo 'artifact cache: ', Core\Config::get('opcache.file_cache_dir') ?? '(nothing written — the location this build derives for the account that runs it)', "\n";
echo 'cache in use:   ', Core\Config::get('opcache.file_cache') ?? '(nothing written — on)', "\n";
echo 'size limit:     ', Core\Config::get('opcache.file_cache_max_size') ?? '(nothing written — the ceiling this build ships with)', "\n";

// A program cannot move this directory, so the call returns `false`. The server
// runs the compiled code it reads from there.
echo 'read my code from /tmp:  ', Core\Config::set('opcache.file_cache_dir', '/tmp/mine') ? 'accepted' : 'refused', "\n";

// A program cannot turn the cache off either. This call also returns `false`.
echo 'turn the cache off:      ', Core\Config::set('opcache.file_cache', 'false') ? 'accepted' : 'refused', "\n";

// `[cache]` is a different block. It is the data cache your code reads and
// writes, and it has no `dir` key.
echo 'the data cache is not it: ', Core\Config::get('cache.dir') ?? '(no such key — an unknown key is refused when the file is read)', "\n";
