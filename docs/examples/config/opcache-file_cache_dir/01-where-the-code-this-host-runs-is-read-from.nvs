<?nvs
// `[opcache] file_cache_dir` is the directory where the server keeps code it has
// already compiled. No other setting names this directory.

// This file does not set it, so the server uses the `cache` folder in its data folder.
// The full path differs on each machine, so this prints only the last folder, `cache`.
echo 'artifact cache: ', Core\Path::fileName(Core\Config::get('opcache.file_cache_dir') ?? ''), "\n";

// By default the cache is on, and its size limit is `256M`.
echo 'cache in use:   ', Core\Config::get('opcache.file_cache') ?? '(no value)', "\n";
echo 'size limit:     ', Core\Config::get('opcache.file_cache_max_size') ?? '(no value)', "\n";

// `Core\Config::set('opcache.file_cache_dir', ...)` does not compile,
// because a program may not change `opcache.file_cache_dir`.

// This program keeps the names in variables. The compiler does not check a variable, so each `set` call runs and returns `false`.
string $cacheDir = 'opcache.file_cache_dir';
string $cache = 'opcache.file_cache';

// A program cannot move this directory, so the call returns `false`. The server
// runs the compiled code it reads from there.
echo 'read my code from /tmp:  ', Core\Config::set($cacheDir, '/tmp/mine') ? 'accepted' : 'not allowed', "\n";

// A program cannot turn the cache off either. This call also returns `false`.
echo 'turn the cache off:      ', Core\Config::set($cache, 'false') ? 'accepted' : 'not allowed', "\n";

// `[cache]` is a different block. It is the data cache your code reads and
// writes, and it has no `dir` key.
echo 'the data cache is not it: ', Core\Config::get('cache.dir') ?? '(no such setting)', "\n";
