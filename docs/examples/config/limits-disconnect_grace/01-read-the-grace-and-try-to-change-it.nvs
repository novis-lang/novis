<?nvs
// Shows how to read `limits.disconnect_grace`. A request cannot change it.

// The `nvs.toml` beside this file sets it, so this prints `10s`.
echo 'grace: ', Core\Config::get('limits.disconnect_grace') ?? 'not set', "\n";

// `Core\Config::set('limits.disconnect_grace', ...)` does not compile,
// because a program may not change `limits.disconnect_grace`.

// This program keeps the names in variables. The compiler does not check a variable, so each `set` call runs and returns `false`.
// This prints `not allowed` three times.
string $name = 'limits.disconnect_grace';
array<string> $values = ['1h', '1s', 'false'];
foreach ($values as string $value) {
    echo 'set to ', $value, ': ', Core\Config::set($name, $value) ? 'accepted' : 'not allowed', "\n";
}
