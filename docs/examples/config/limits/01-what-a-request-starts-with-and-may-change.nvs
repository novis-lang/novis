<?nvs
// `[limits]` is what one request starts with — the heap it may hold, the CPU
// and wall time it may spend, the bytes it may write back. This checkout
// writes two of them, and a program is allowed to read what it got.

echo 'memory to start with: ', Core\Config::get('limits.memory') ?? '(unset)', "\n";
echo 'the ceiling above it: ', Core\Config::get('limits.hard.memory') ?? '(unset)', "\n";

// These are ordinary per-request defaults, so a program may change its own. A
// job that knows it should stay small says so and is then held to it, which is
// worth doing: a limit a program set for itself still stops it, and stopping
// early is how a runaway is caught before it takes the host with it.
echo 'ask for less:         ', Core\Config::set('limits.memory', '64M') ? 'accepted' : 'refused', "\n";
echo 'in force now:         ', Core\Config::get('limits.memory'), "\n";

// It may ask for more, too — up to the ceiling the operator wrote and not one
// byte past it. Over the ceiling is refused on the spot with the previous
// value left standing, so a program asking for too much carries on under what
// it already had instead of falling over.
echo 'ask for 400M:         ', Core\Config::set('limits.memory', '400M') ? 'accepted' : 'refused', "\n";
echo 'ask for 1G:           ', Core\Config::set('limits.memory', '1G') ? 'accepted' : 'refused', "\n";
echo 'in force now:         ', Core\Config::get('limits.memory'), "\n";

// Raising the ceiling itself is the thing no program can do, and that is what
// makes the freedom above safe to hand out.
echo 'raise the ceiling:    ', Core\Config::set('limits.hard.memory', '1G') ? 'accepted' : 'refused', "\n";

// A key this block never wrote still starts unset and still takes a value, so
// a program can bound itself where the deployment said nothing at all.
echo 'cpu time to start:    ', Core\Config::get('limits.cpu_time') ?? '(unset — no ceiling was written for it either)', "\n";
echo 'bound my own cpu:     ', Core\Config::set('limits.cpu_time', '2s') ? 'accepted' : 'refused', "\n";

// And `restore` puts back what the configuration said, which is how a request
// hands the next one the deployment's answer rather than its own.
Core\Config::restore('limits.memory');
echo 'back to the file:     ', Core\Config::get('limits.memory'), "\n";
