<?nvs
// `[queue] max_attempts` is how many times a failing job is tried.
// The job is then moved to the dead-letter table. This is a table of failed jobs that a person can look at.

// This file does not set `max_attempts`, so this prints the default, `5`.
echo 'attempts a job gets: ', Core\Config::get('queue.max_attempts') ?? '(no value)', "\n";
echo 'queued in:           ', Core\Config::get('queue.connection') ?? '(nothing written)', "\n";

// After the last attempt, the job is not deleted. It stays in the dead-letter
// table until somebody reads it.

// `Core\Config::set('queue.max_attempts', ...)` does not compile,
// because a program may not change `queue.max_attempts`.

// This program keeps the names in variables. The compiler does not check a variable, so each `set` call runs and returns `false`.
string $name = 'queue.max_attempts';

// A program cannot raise this number, so the call returns `false`. Too many
// retries slow down every other job in the same queue.
echo 'try mine a thousand times: ', Core\Config::set($name, '1000') ? 'accepted' : 'not allowed', "\n";

// A program cannot lower it either, so this call also returns `false`.
// A job that is not retried may never be done.
echo 'or give mine one try:      ', Core\Config::set($name, '1') ? 'accepted' : 'not allowed', "\n";
