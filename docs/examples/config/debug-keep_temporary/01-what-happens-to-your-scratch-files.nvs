<?nvs
// A program can get its own directory for working files. It is deleted when the program ends.
// `[debug] keep_temporary` stops the deletion, so you can look at the files a run left:
//
//     [debug]
//     keep_temporary = true
//
// This file sets `false`. Every server in production should use `false`.

echo 'kept after a run: ', Core\Config::get('debug.keep_temporary') ?? '(no)', "\n";

// `io.temp_root` is where these directories are made. This file sets nothing,
// so they are made in the temporary directory of the machine.
echo 'made under:       ', Core\Config::get('io.temp_root') ?? "(the machine's own)", "\n";

// A program cannot change `keep_temporary`, so this prints `no`. Otherwise a program
// could keep every file it makes until the disk is full.
echo 'a program may:    ', Core\Config::set('debug.keep_temporary', 'true') ? 'yes' : 'no', "\n";

// You can turn the setting on in `nvs.toml` while the server runs. A restart is not needed.
// While it is on, nothing deletes the files. Turn it off again when you are done.
