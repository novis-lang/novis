<?nvs
// `[cache.shared]` names the store behind the third cache tier: a real store
// over the network, which every core and every machine in a deployment reads
// the same entries from. This is what the server running this program was
// given:
//
//     [cache.shared]
//     url = "redis://127.0.0.1:16379"
//
// The address is the one key with no sensible default, so a deployment that
// writes nothing here has no shared tier at all.

echo 'store:    ', Core\Config::get('cache.shared.url') ?? '(no shared tier)', "\n";

// The rest of the block is how that store is reached, and every one of them
// has a default worth having. `database` picks which of the store's databases
// these entries live in, and `timeout` bounds both the connect and each
// command, so a store that has stopped answering cannot hold a request open.
echo 'database: ', Core\Config::get('cache.shared.database') ?? '(the one the store opens on)', "\n";
echo 'timeout:  ', Core\Config::get('cache.shared.timeout') ?? '(the built-in bound)', "\n";

// The credential is the fourth: write it as `password`, or as `password_file`
// naming a file whose whole content is the value, which is how a container
// hands one in. Exactly one of the pair, never both.

// Which store a fleet's state lives in is whoever runs the server's decision,
// so a request cannot move it or shorten its bound for itself.
echo 'move:     ', Core\Config::set('cache.shared.url', 'redis://elsewhere:6379') ? 'yes' : 'no', "\n";
echo 'hurry:    ', Core\Config::set('cache.shared.timeout', '5ms') ? 'yes' : 'no', "\n";

// Even an operator's edit waits for a restart here, unlike the two in-memory
// tiers: every core holds an open connection to this store, so a new address
// means re-dialling all of them.
