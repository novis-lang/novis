<?nvs
// `[cache.shared]` names the store behind the third cache tier. It is a store on
// the network, and every core and every machine reads the same entries from it.
// This is what the server running this program was given:
//
//     [cache.shared]
//     url = "redis://127.0.0.1:16379"
//
// The address has no default. A server that writes nothing here has no shared tier.

echo 'store:    ', Core\Config::get('cache.shared.url') ?? '(no shared tier)', "\n";

// The other keys have defaults. `database` is the database in the store
// that the entries use.
echo 'database: ', Core\Config::get('cache.shared.database') ?? '(the one the store opens on)', "\n";

// `timeout` limits the connect and each command.
// A store that stops answering cannot block a request.
echo 'timeout:  ', Core\Config::get('cache.shared.timeout') ?? '(the built-in bound)', "\n";

// Set the password with `password`, or with `password_file`. Write only one of the two.
// `password_file` names a file that contains the password, which is how a container passes one in.

// Only the person who runs the server chooses the store.
// A program cannot move it or shorten its timeout.
echo 'move:     ', Core\Config::set('cache.shared.url', 'redis://elsewhere:6379') ? 'yes' : 'no', "\n";
echo 'hurry:    ', Core\Config::set('cache.shared.timeout', '5ms') ? 'yes' : 'no', "\n";

// The person who runs the server can change this block while it runs.
// The next request then uses the new store. No restart is needed.
