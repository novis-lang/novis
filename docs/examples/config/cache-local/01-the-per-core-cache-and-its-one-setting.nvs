<?nvs
// `[cache.local]` configures the fastest cache: one store for each CPU core.
// The server running this program has this setting:
//
//     [cache.local]
//     max_size = "32M"
//
// `max_size` is the most memory the entries of one core may use together.
// A machine with eight cores may use up to eight times that amount.

var $cache = Core\Cache::local();

// `put` stores a value for the next request on this core. `get` returns it, so this prints `20`.
$cache->put('vat-rate:at', '20');
echo 'vat rate: ', $cache->get('vat-rate:at') ?? '(work it out again)', "\n";

// This prints the limit as the file writes it: `32M`. Without a `[cache.local]`
// block, a built-in limit applies and `Core\Config::get` returns `null`.
echo 'cap:      ', Core\Config::get('cache.local.max_size') ?? '(the built-in cap)', "\n";

// When the store is full, `put` deletes the entries used least recently to make room.
// A `put` never fails, but a `get` can return `null`. This key was never stored.
echo 'miss:     ', $cache->get('vat-rate:de') ?? '(not cached)', "\n";

// Only the person who runs the server may change this limit.
// `Core\Config::set` returns `false`, so this prints `no`.
echo 'raise it: ', Core\Config::set('cache.local.max_size', '1G') ? 'yes' : 'no', "\n";
