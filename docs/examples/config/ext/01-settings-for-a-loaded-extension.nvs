<?nvs
// Shows a program that runs with an extension and the settings block for it.

use Shop\Ledger;

// `nvs.toml` loads `Shop\Ledger` and sets `currency` in the block `[ext.ledger]`.
// The extension declares that key, so the program starts. This prints 42.
echo Ledger::echoInt(42), "\n";

// The block belongs to the person who runs the server. A program cannot change it,
// so `Core\Config::set` returns `false`. This prints "refused".
bool $changed = Core\Config::set('ext.ledger.currency', 'EUR');
echo $changed ? "changed" : "refused", "\n";
