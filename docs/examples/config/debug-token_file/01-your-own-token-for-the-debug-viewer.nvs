<?nvs
// `[debug] token_file` is a file with the token that opens the debug viewer, such as `/etc/novis/debug.token`.
// This file does not set it, so `nvs debug` creates its own token, and this prints `(not set)`.
echo 'token_file: ', Core\Config::get('debug.token_file') ?? '(not set)', "\n";

// A program cannot change this setting, so this prints `no`. The compiler checks a setting name written as text,
// so `Core\Config::set('debug.token_file', ...)` does not compile. Here the name is in a variable, so the call runs.
string $name = 'debug.token_file';
echo 'change it:  ', Core\Config::set($name, '/etc/novis/debug.token') ? 'yes' : 'no', "\n";
