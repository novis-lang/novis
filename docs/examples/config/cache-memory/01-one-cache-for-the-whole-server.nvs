<?nvs
// Shows the two settings of the memory cache, and that a program cannot change them.
// The server running this program has these settings:
//
//     [cache.memory]
//     max_size = "32M"
//     fill_wait = "5s"

var $cache = Core\Cache::memory();

// Every core of this server reads the same store. This prints `0.92`.
$cache->put('rates:eur', '0.92');
echo 'eur rate: ', $cache->get('rates:eur') ?? '(fetch it)', "\n";

// `max_size` is the most memory all values in the store may use together.
echo 'cap:      ', Core\Config::get('cache.memory.max_size') ?? '(no value)', "\n";

// Several requests may call `getSecret` for the same missing value. One fetches it, and the others
// wait up to `fill_wait` for that result. After that time, `getSecret` throws a `TimeoutError`.
echo 'wait:     ', Core\Config::get('cache.memory.fill_wait') ?? '(no value)', "\n";

// Only the person who runs the server may change these settings.
// `Core\Config::set` returns `false` both times, so both lines print `no`.
echo 'raise:    ', Core\Config::set('cache.memory.max_size', '1G') ? 'yes' : 'no', "\n";
echo 'hurry:    ', Core\Config::set('cache.memory.fill_wait', '1s') ? 'yes' : 'no', "\n";
