<?nvs
// `[debug] index_max` is the largest size of the database that `nvs debug` writes.
// When the database is larger, `nvs debug` deletes the oldest records first.
// This file does not set it, so the default `1G` is used, and this prints `1G`.
echo 'index_max: ', Core\Config::get('debug.index_max') ?? '(no value)', "\n";

// A program may not change `debug.index_max`.
// A call to `Core\Config::set` with the name `'debug.index_max'` in the code does not compile.

// Here the name is in a variable, so the call compiles and runs.
// It returns `false`, and this prints `no`.
string $name = 'debug.index_max';
echo 'raise it:  ', Core\Config::set($name, '100G') ? 'yes' : 'no', "\n";
