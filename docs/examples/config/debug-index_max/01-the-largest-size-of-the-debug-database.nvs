<?nvs
// `[debug] index_max` is the largest size of the database that `nvs debug` writes.
// When the database is larger, `nvs debug` deletes the oldest records first.
// This file does not set it, so the default is used, and this prints `1G`.
echo 'index_max: ', Core\Config::get('debug.index_max') ?? '(no value)', "\n";

// `Core\Config::set('debug.index_max', ...)` does not compile,
// because a program may not change `debug.index_max`.

// This program keeps the name in a variable. The compiler does not check a variable, so `set` runs and returns `false`.
// This prints `no`.
string $name = 'debug.index_max';
echo 'raise it:  ', Core\Config::set($name, '100G') ? 'yes' : 'no', "\n";
