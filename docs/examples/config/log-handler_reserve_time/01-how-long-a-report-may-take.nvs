<?nvs
// `log.handler_reserve_time` is how long the script that reports a failure may
// run. A report is usually slow because of where it writes, not what it writes.

echo 'time for the report:  ', Core\Config::get('log.handler_reserve_time') ?? '(nothing written)', "\n";
echo 'memory beside it:     ', Core\Config::get('log.handler_reserve_memory') ?? '(nothing written)', "\n";

// `limits.fatal_reserve_time` and `limits.fatal_reserve_memory` are part of the request's own limits.
// They are the extra time and memory that the program's own handler function gets.
echo 'the request-side time: ', Core\Config::get('limits.fatal_reserve_time') ?? '(nothing written)', "\n";
echo 'the request-side heap: ', Core\Config::get('limits.fatal_reserve_memory') ?? '(nothing written)', "\n";

// A program cannot change this time. A report that is stopped early never arrives.

// The compiler checks a setting name written as text, so `Core\Config::set('log.handler_reserve_time', ...)` does not compile.
// Here the name is in a variable, so each call runs and returns `false`.
string $name = 'log.handler_reserve_time';
echo 'give it an hour:  ', Core\Config::set($name, '1h') ? 'accepted' : 'not allowed', "\n";
echo 'give it a moment: ', Core\Config::set($name, '1ms') ? 'accepted' : 'not allowed', "\n";

// A program may lower its own `limits.cpu_time`. The time for the report stays `5s`.
echo 'bound my own run:  ', Core\Config::set('limits.cpu_time', '2s') ? 'accepted' : 'not allowed', "\n";
echo 'time for the report still: ', Core\Config::get('log.handler_reserve_time') ?? '(nothing written)', "\n";
