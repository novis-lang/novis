<?nvs
// This program prints the size limit of a log file and shows that a program cannot change it.

// This file does not set `log.max_size`, so this prints the default, `10M`.
echo 'max_size: ', Core\Config::get('log.max_size') ?? '(no value)', "\n";

// Only `nvs.toml` can set `log.max_size`. The compiler checks a setting name written as text,
// so `Core\Config::set('log.max_size', ...)` does not compile. Here the name is in a variable, so each call runs and returns `false`.
string $name = 'log.max_size';
echo 'set it to 1G: ', Core\Config::set($name, '1G') ? 'accepted' : 'not allowed', "\n";
echo 'remove the limit: ', Core\Config::set($name, 'false') ? 'accepted' : 'not allowed', "\n";

echo 'max_size now: ', Core\Config::get('log.max_size') ?? '(no value)', "\n";
