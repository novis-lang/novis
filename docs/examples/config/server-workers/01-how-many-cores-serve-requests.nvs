<?nvs
// Shows how to read `[server] workers`, the number of workers that accept and serve requests.
//
//     [server]
//     workers = 4   # when not set: one worker for each CPU core

// This file does not set it, so there is one worker for each CPU core. That number
// differs on each machine, so this compares it with `Core\Os::cpuCount` and prints `yes`.
echo 'one per core:   ', (Core\Config::get('server.workers') as ?int) == Core\Os::cpuCount() ? 'yes' : 'no', "\n";

// A program cannot change this setting, so this prints `refused`.
echo 'use 64 workers: ', Core\Config::set('server.workers', '64') ? 'accepted' : 'refused', "\n";

// The server creates its workers when it starts. A new value takes effect after a restart.
