<?nvs
// `[cache.process]` configures one cache store that every CPU core of the process shares.
// The server running this program has these settings:
//
//     [cache.process]
//     max_size = "32M"
//     fill_wait = "5s"
//
// `max_size` is the most memory all entries may use together. There is one store
// for the whole process. The local cache has one store for each core.

var $cache = Core\Cache::process();

// Every core can read a value stored here. This prints `0.92`.
$cache->put('rates:eur', '0.92');
echo 'eur rate: ', $cache->get('rates:eur') ?? '(fetch it)', "\n";

echo 'cap:      ', Core\Config::get('cache.process.max_size') ?? '(the built-in cap)', "\n";

// Several requests may call `getSecret` for the same missing value. One fetches it, and the others
// wait up to `fill_wait` for that result. After that time, `getSecret` throws a `TimeoutError`.
echo 'wait:     ', Core\Config::get('cache.process.fill_wait') ?? '(the built-in wait)', "\n";

// Only the person who runs the server may change these settings.
// `Core\Config::set` returns `false` both times, so both lines print `no`.
echo 'raise:    ', Core\Config::set('cache.process.max_size', '1G') ? 'yes' : 'no', "\n";
echo 'hurry:    ', Core\Config::set('cache.process.fill_wait', '1s') ? 'yes' : 'no', "\n";
