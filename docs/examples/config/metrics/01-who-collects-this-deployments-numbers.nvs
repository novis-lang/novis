<?nvs
// `[metrics]` sets where Novis sends the numbers it counts about itself. It also
// sets `max_series`, the most different series one CPU core keeps.

// This file does not write `[metrics]`. The exporter is `false`, so nothing is exported.
// The series cap is the default, `10000`.
echo 'exporter:   ', Core\Config::get('metrics.exporter') ?? '(no value)', "\n";
echo 'scrape at:  ', Core\Config::get('metrics.listen') ?? '(nothing written)', "\n";
echo 'push to:    ', Core\Config::get('metrics.endpoint') ?? '(nothing written)', "\n";
echo 'series cap: ', Core\Config::get('metrics.max_series') ?? '(no value)', "\n";

// Only the person who runs the server may change `[metrics]`.

// `Core\Config::set('metrics.exporter', ...)` does not compile,
// because a program may not change `metrics.exporter`.

// This program keeps the names in variables. The compiler does not check a variable, so each `set` call runs and returns `false`.
string $exporter = 'metrics.exporter';
string $endpoint = 'metrics.endpoint';
string $maxSeries = 'metrics.max_series';
echo 'switch it off:        ', Core\Config::set($exporter, 'false') ? 'accepted' : 'not allowed', "\n";
echo 'push somewhere else:  ', Core\Config::set($endpoint, 'https://collector.mine/v1') ? 'accepted' : 'not allowed', "\n";
echo 'raise the series cap: ', Core\Config::set($maxSeries, '100000000') ? 'accepted' : 'not allowed', "\n";

// `[trace]` works the same way. A program cannot turn off its own tracing,
// so this call returns `false` too.
string $traceExporter = 'trace.exporter';
echo 'traces go to:         ', Core\Config::get('trace.exporter') ?? '(no value)', "\n";
echo 'stop tracing me:      ', Core\Config::set($traceExporter, 'false') ? 'accepted' : 'not allowed', "\n";
