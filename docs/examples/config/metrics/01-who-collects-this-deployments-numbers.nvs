<?nvs
// `[metrics]` says who collects the counts Novis keeps about itself, and how
// many distinct series one core holds before it stops taking new ones.

echo 'exporter:   ', Core\Config::get('metrics.exporter') ?? '(nothing written — nothing is exported)', "\n";
echo 'scrape at:  ', Core\Config::get('metrics.listen') ?? '(nothing written)', "\n";
echo 'push to:    ', Core\Config::get('metrics.endpoint') ?? '(nothing written)', "\n";
echo 'series cap: ', Core\Config::get('metrics.max_series') ?? '(nothing written — the bound this build ships with)', "\n";

// The block belongs to whoever runs the deployment, every key of it. A program
// that could switch the exporter off would stop being measured at the moment
// being measured matters most.
echo 'switch it off:        ', Core\Config::set('metrics.exporter', 'false') ? 'accepted' : 'refused', "\n";
echo 'push somewhere else:  ', Core\Config::set('metrics.endpoint', 'https://collector.mine/v1') ? 'accepted' : 'refused', "\n";
echo 'raise the series cap: ', Core\Config::set('metrics.max_series', '100000000') ? 'accepted' : 'refused', "\n";

// The tracing block beside it is the same kind of thing for the same reason:
// spans and counts are both how a deployment is watched, and a program that
// could turn either one down would be choosing how closely it is watched.
echo 'traces go to:         ', Core\Config::get('trace.exporter') ?? '(nothing written — nothing is exported)', "\n";
echo 'stop tracing me:      ', Core\Config::set('trace.exporter', 'false') ? 'accepted' : 'refused', "\n";
