<?nvs
// Shows how to read `[server] socket_mode`, the file permissions of the server's Unix sockets.
//
//     [server]
//     listen      = ["/run/nvs/web.sock"]
//     socket_mode = "0660"   # the owner and the socket's group may connect

// When the file does not set it, the value is `0660`.
echo 'socket mode:          ', Core\Config::get('server.socket_mode') ?? '(no value)', "\n";

// Every account that may write to the socket may connect to the server. A program cannot change this setting.

// `Core\Config::set('server.socket_mode', ...)` does not compile,
// because a program may not change `server.socket_mode`.

// This program keeps the name in a variable. The compiler does not check a variable, so `set` runs and returns `false`.
// This prints `not allowed`.
string $name = 'server.socket_mode';
echo 'let everyone connect: ', Core\Config::set($name, '0666') ? 'accepted' : 'not allowed', "\n";

// The server uses this value when it creates a socket. A new value takes effect after a restart.
