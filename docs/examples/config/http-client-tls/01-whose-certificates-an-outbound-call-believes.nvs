<?nvs
// `[http.client.tls]` configures every outbound `https` call: which certificates it trusts,
// the oldest TLS version it uses, and whether it writes its session secrets to a file for
// debugging. This file sets the oldest version to `1.2` and does not set the other two.

echo 'oldest version:   ', Core\Config::get('http.client.tls.min_version') ?? '(nothing, so 1.2)', "\n";
echo 'secrets written:  ', Core\Config::get('http.client.tls.keylog') ?? '(nothing, so none)', "\n";

// `Core\Config::get` cannot read a list, so it returns `null`. Without `roots`, Novis trusts its
// built-in certificate authorities. `roots = ["bundled", "/etc/novis/corp-ca.pem"]` adds one more.
echo 'trust anchors:    ', Core\Config::get('http.client.tls.roots') ?? '(nothing, so the shipped set)', "\n";

// Every request in this process uses the same TLS client, so a program cannot change
// these three settings. `Core\Config::set` returns `false`, and each line prints `no`.
echo 'trust one more:   ', Core\Config::set('http.client.tls.roots', '["/tmp/mine.pem"]') ? 'yes' : 'no', "\n";
echo 'speak older TLS:  ', Core\Config::set('http.client.tls.min_version', '1.2') ? 'yes' : 'no', "\n";
echo 'write secrets:    ', Core\Config::set('http.client.tls.keylog', '/tmp/keys.log') ? 'yes' : 'no', "\n";

// The failed calls changed nothing, so the oldest version is still `1.2`.
echo 'still in force:   ', Core\Config::get('http.client.tls.min_version') ?? '(nothing)', "\n";

// `[http.client.socket]` is the only block in `[http.client]` that a program may change.
// Its limits affect only the socket the program opened, so this prints `yes`.
echo 'hold less:        ', Core\Config::set('http.client.socket.max_message', '65536') ? 'yes' : 'no', "\n";
Core\Config::restore('http.client.socket.max_message');
