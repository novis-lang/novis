<?nvs
// Shows how to read `[control] socket`, the local socket an administrator uses to
// control a running server. This example sets it to `false`, which turns it off:
//
//     [control]
//     socket = false

echo 'control socket: ', Core\Config::get('control.socket') ?? '(none)', "\n";

// A server sets a path, such as `/run/nvs/control.sock`, or `\\.\pipe\nvs-control` on Windows.
// `nvs ctl reload` and `nvs ctl status` connect to that path.

// A host and a port are not allowed. Another machine could connect to them.

// Only the person who runs the server may change where the socket is.
// A program cannot, so this prints `no`.
echo 'move it:        ', Core\Config::set('control.socket', '/tmp/mine.sock') ? 'yes' : 'no', "\n";
