<?nvs
// The other question: what is in the first list and not in the second. The
// option means the same thing here, and the answer keeps the first list's
// names and its order.

array<int> $mine = ["x" => 1, "y" => 2, "z" => 3];
array<int> $theirs = ["p" => 2, "z" => 9];

echo "values:  ", Core\Json::encode(Core\Arr::diff($mine, $theirs)), "\n";
echo "names:   ", Core\Json::encode(Core\Arr::diff($mine, $theirs, {on: Core\SetOn::Keys})), "\n";
echo "both:    ", Core\Json::encode(Core\Arr::diff($mine, $theirs, {on: Core\SetOn::Both})), "\n";

// `Both` answers everything here, because not one entry matches on its name
// and its value at once — `z` is in both lists and holds something different
// in each.
