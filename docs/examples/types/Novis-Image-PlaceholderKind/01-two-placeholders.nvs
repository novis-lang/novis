<?nvs
// Shows the text each `PlaceholderKind` returns for the same image.
use Novis\Image\Color;
use Novis\Image\Image;
use Novis\Image\PlaceholderKind;

// An orange image of 120 by 80 pixels, encoded as PNG.
bytes $photo = Image::create(120, 80, Color::hex("#f97316"))->encode();

string $blur = Image::placeholder($photo, PlaceholderKind::BlurHash);
string $thumb = Image::placeholder($photo, PlaceholderKind::ThumbHash);

echo $blur, " (", Core\Str::length($blur), " characters)\n";
echo $thumb, " (", Core\Str::length($thumb), " characters)\n";
