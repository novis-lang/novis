<?nvs
// Three pairs that look alike and are not. Each pair would have given the same
// answer in a language with one number type and one string type, and here each
// half has a kind of its own.

class Kind {
    public static function of(mixed $value): string {
        return match (Core\Reflect::typeOf($value)) {
            Core\Reflect\TypeKind::Int => "Int",
            Core\Reflect\TypeKind::Uint => "Uint",
            Core\Reflect\TypeKind::Float => "Float",
            Core\Reflect\TypeKind::Decimal => "Decimal",
            Core\Reflect\TypeKind::Text => "Text",
            Core\Reflect\TypeKind::Bytes => "Bytes",
            default => "something else",
        };
    }
}

// A count cannot be negative and a temperature can, so they are not the same
// number.
int $below = -3;
uint $items = 3;
echo "-3 items:    ", Kind::of($below), "\n";
echo "3 items:     ", Kind::of($items), "\n";

// A price is exact to the last cent. A ratio is not, and a price kept as one
// loses money a fraction at a time.
decimal $price = 19.90;
float $ratio = 19.90;
echo "19.90 owed:  ", Kind::of($price), "\n";
echo "19.90 parts: ", Kind::of($ratio), "\n";

// Text is text you can show someone. Octets are whatever a file or a socket
// handed you, and nothing promises they read as anything.
string $name = "ab";
bytes $upload = Core\Encoding::fromHex("6162");
echo "the word ab: ", Kind::of($name), "\n";
echo "two octets:  ", Kind::of($upload), "\n";
