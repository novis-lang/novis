<?nvs
// Which level a piece of work asks for. The level is chosen from what the work
// would get wrong if something changed underneath it, and the value below is
// what you would pass as the `isolation` option of a transaction.

class Work {
    public static function levelFor(string $job): Core\Db\Isolation {
        return match ($job) {
            // Both halves of a transfer have to agree, so nothing may slip in
            // between the two of them.
            "moving money between accounts" => Core\Db\Isolation::Serializable,
            // A long report reads many tables, and one steady picture of them
            // is worth more than a fresh one per statement.
            "the month-end report" => Core\Db\Isolation::RepeatableRead,
            // Everything else only needs numbers somebody has committed.
            default => Core\Db\Isolation::ReadCommitted,
        };
    }

    public static function name(Core\Db\Isolation $level): string {
        return match ($level) {
            Core\Db\Isolation::ReadUncommitted => "ReadUncommitted",
            Core\Db\Isolation::ReadCommitted => "ReadCommitted",
            Core\Db\Isolation::RepeatableRead => "RepeatableRead",
            Core\Db\Isolation::Snapshot => "Snapshot",
            Core\Db\Isolation::Serializable => "Serializable",
        };
    }
}

array<string> $jobs = [
    "moving money between accounts",
    "the month-end report",
    "counting today's orders",
];

foreach ($jobs as string $job) {
    echo $job, " -> ", Work::name(Work::levelFor($job)), "\n";
}
