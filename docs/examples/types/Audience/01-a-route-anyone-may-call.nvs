<?nvs
// Every route in a Novis program says who may reach it. These two are open to
// anyone, and `Core\Audience::Public` is the name for that.

class Pages {
    #[Core\Route(path: "/pricing", method: Core\Http\Method::Get, name: "Pages::pricing")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function pricing(): string { return "our prices"; }

    #[Core\Route(path: "/help/{topic}", method: Core\Http\Method::Get, name: "Pages::help")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function help(string $topic): string { return $topic; }
}

// Links to those two pages, built from the names the routes were given.
echo Core\Router::url("Pages::pricing", []), "\n";
echo Core\Router::url("Pages::help", ["topic" => "billing"]), "\n";

// The case is an ordinary value as well. You can keep it in a variable and
// compare it, which is what code of your own that sorts routes by audience does.
var $audience = Core\Audience::Public;
echo $audience == Core\Audience::Public ? "open to everyone" : "not open", "\n";
