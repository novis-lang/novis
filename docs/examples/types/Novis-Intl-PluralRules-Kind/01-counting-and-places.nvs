<?nvs
// Shows the two `PluralRules::Kind` cases: one for counting items, one for places in a race.
use Novis\Intl\Icu;
use Novis\Intl\PluralRules;

class Category {
    public static function name(PluralRules::Category $category): string {
        return match ($category) {
            PluralRules::Category::Zero => "zero",
            PluralRules::Category::One => "one",
            PluralRules::Category::Two => "two",
            PluralRules::Category::Few => "few",
            PluralRules::Category::Many => "many",
            PluralRules::Category::Other => "other",
        };
    }
}

array<string> $numbers = ["1", "2", "3", "4"];
array<PluralRules::Kind> $kinds = [PluralRules::Kind::Cardinal, PluralRules::Kind::Ordinal];

// For counting, English has "1 item" and "2 items". For places, it has "1st", "2nd", "3rd" and "4th".
foreach ($kinds as PluralRules::Kind $kind) {
    array<string> $names = [];
    foreach (Icu::pluralCategories($numbers, "en", $kind) as PluralRules::Category $category) {
        $names[] = Category::name($category);
    }
    echo Core\Str::join($names, " "), "\n";
}
