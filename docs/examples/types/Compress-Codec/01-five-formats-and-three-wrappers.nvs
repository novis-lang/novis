<?nvs
// Gzip, Zlib and Deflate contain the same compressed data. Gzip and Zlib add a
// few bytes around it. This program compresses one text with each of them and
// prints the difference in size.

class Format
{
    public static function name(Core\Compress::Codec $codec): string
    {
        return match ($codec) {
            Core\Compress::Codec::Gzip => 'Gzip',
            Core\Compress::Codec::Zlib => 'Zlib',
            Core\Compress::Codec::Deflate => 'Deflate',
            Core\Compress::Codec::Brotli => 'Brotli',
            Core\Compress::Codec::Zstd => 'Zstd',
        };
    }
}

string $text = Core\Str::repeat("the quick brown fox jumps over the lazy dog\n", 16);
bytes $payload = $text as bytes;

uint $bare = Core\Bytes::length(Core\Compress::compress($payload, Core\Compress::Codec::Deflate));
uint $gzip = Core\Bytes::length(Core\Compress::compress($payload, Core\Compress::Codec::Gzip));
uint $zlib = Core\Bytes::length(Core\Compress::compress($payload, Core\Compress::Codec::Zlib));

echo "Deflate is the stream with nothing around it\n";
echo 'Gzip is that same stream plus ', $gzip - $bare, " octets\n";
echo 'Zlib is that same stream plus ', $zlib - $bare, " octets\n";

// Brotli and Zstd are different compression algorithms. With each of the five
// codecs, `decompress` returns exactly the original bytes.
array<Core\Compress::Codec> $codecs = [
    Core\Compress::Codec::Gzip,
    Core\Compress::Codec::Zlib,
    Core\Compress::Codec::Deflate,
    Core\Compress::Codec::Brotli,
    Core\Compress::Codec::Zstd,
];

foreach ($codecs as Core\Compress::Codec $codec) {
    bytes $frame = Core\Compress::compress($payload, $codec);
    echo Format::name($codec), ': ',
        Core\Hash::equals(Core\Compress::decompress($frame, $codec), $payload)
            ? 'reads back'
            : 'differs',
        "\n";
}
