<?nvs
// A sealed message does not say which cipher sealed it. Opening it with the other
// cipher throws the same error as a changed message. The program that seals a
// message must remember its cipher.

secret bytes $key = Core\Crypto::generateKey();
bytes $sealed = Core\Crypto::seal("card ending 4242" as bytes, $key, Core\Crypto\Cipher::Aes256Gcm);

try {
    bytes $opened = Core\Crypto::open($sealed, $key, Core\Crypto\Cipher::XChaCha20Poly1305);
    echo "opened under the other case", "\n";
} catch (RuntimeError $refused) {
    echo $refused->message, "\n";
}

// A wrong key gives the same error, so an attacker cannot tell which check
// failed. Opening with the right cipher returns the original text.
echo Core\Encoding::decodeText(
    Core\Crypto::open($sealed, $key, Core\Crypto\Cipher::Aes256Gcm),
    Core\Charset::Utf8
), "\n";
