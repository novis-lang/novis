<?nvs
// Two programs agree on a shared secret. Each creates a key pair of the same
// kind and sends its public key to the other. Each then combines its own
// private key with the other public key, and both get the same secret.

Core\Crypto\KeyPair $ours = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519);
Core\Crypto\KeyPair $theirs = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519);

secret bytes $weAgreed = Core\Crypto::agree($ours, $theirs->publicKey());
secret bytes $theyAgreed = Core\Crypto::agree($theirs, $ours->publicKey());

// The shared secret is not a key yet. `expandKey` with a context string turns it
// into a key. A different context string gives a different key.
secret bytes $ourKey = Core\Crypto::expandKey($weAgreed, "" as bytes, "orders v1");
secret bytes $theirKey = Core\Crypto::expandKey($theyAgreed, "" as bytes, "orders v1");

// We seal with our key, and they open with theirs. This works because both
// keys are the same.
bytes $sealed = Core\Crypto::seal("order 1042 accepted" as bytes, $ourKey, Core\Crypto\Cipher::XChaCha20Poly1305);
echo Core\Encoding::decodeText(
    Core\Crypto::open($sealed, $theirKey, Core\Crypto\Cipher::XChaCha20Poly1305),
    Core\Charset::Utf8
), "\n";

// An Ed25519 pair is for signing. `agree` with an Ed25519 key throws a
// `LogicError`, because both keys must be of the same curve.
Core\Crypto\KeyPair $forSigning = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519);
try {
    secret bytes $nothing = Core\Crypto::agree($forSigning, $theirs->publicKey());
    echo "agreed with a signing key", "\n";
} catch (LogicError $wrongKind) {
    echo $wrongKind->message, "\n";
}
