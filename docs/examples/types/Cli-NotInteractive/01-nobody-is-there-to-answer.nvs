<?nvs
// `Core\Cli::ask` needs a person at a terminal. A nightly job or a build step has
// no terminal, so `ask` throws `Core\Cli\NotInteractive` immediately. The `catch`
// block decides what happens next.

try {
    tainted string $who = Core\Cli::ask("Who is running this release?");
    echo "released by ", $who, "\n";
} catch (Core\Cli\NotInteractive $nobody) {
    echo $nobody->message, "\n";
    echo "released by the nightly job\n";
}
