<?nvs
// Shows how a program picks the right Russian word for "file" from each `PluralRules::Category`.
use Novis\Intl\Icu;
use Novis\Intl\PluralRules;

array<string> $counts = ["1", "3", "5", "21"];
array<PluralRules::Category> $categories = Icu::pluralCategories($counts, "ru", PluralRules::Kind::Cardinal);

// Russian uses three forms for whole numbers: `One`, `Few` and `Many`.
for (uint $i = 0; $i < 4; $i++) {
    string $word = match ($categories[$i]) {
        PluralRules::Category::One => "файл",
        PluralRules::Category::Few => "файла",
        PluralRules::Category::Zero, PluralRules::Category::Two, PluralRules::Category::Many, PluralRules::Category::Other => "файлов",
    };
    echo $counts[$i], " ", $word, "\n";
}
