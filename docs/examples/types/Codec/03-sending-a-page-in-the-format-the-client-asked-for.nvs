<?nvs
// A client lists the formats it can read. The server picks the best format that
// it can also write. It sends the format name in `Content-Encoding`, because the
// compressed bytes do not contain it.

class Response {
    // The server decides the order: Zstd, then Brotli, then Gzip. Almost every
    // client can read Gzip, so it is the last choice.
    public static function pick(string $accept): ?Core\Codec {
        if (Core\Str::contains($accept, "zstd")) {
            return Core\Codec::Zstd;
        }
        if (Core\Str::contains($accept, "br")) {
            return Core\Codec::Brotli;
        }
        if (Core\Str::contains($accept, "gzip")) {
            return Core\Codec::Gzip;
        }
        return null;
    }

    // `header` returns the `Content-Encoding` name. In HTTP, `deflate` means the
    // Zlib format. Plain `Deflate` has no name, so the result is "".
    public static function header(Core\Codec $codec): string {
        return match ($codec) {
            Core\Codec::Gzip => "gzip",
            Core\Codec::Zlib => "deflate",
            Core\Codec::Deflate => "",
            Core\Codec::Brotli => "br",
            Core\Codec::Zstd => "zstd",
        };
    }
}

bytes $page = Core\Str::repeat("<li>order 1042 shipped</li>\n", 40) as bytes;

array<string> $clients = [
    "gzip, deflate, br, zstd",
    "gzip, deflate",
    "identity",
];

foreach ($clients as string $accept) {
    ?Core\Codec $codec = Response::pick($accept);

    // If the client accepts none of these formats, the server sends the page
    // without compression.
    if ($codec == null) {
        echo "accepts ", $accept, " -> sent as it is\n";
    } else {
        bytes $frame = Core\Compress::compress($page, $codec);
        echo "accepts ", $accept,
            " -> Content-Encoding: ", Response::header($codec),
            ", ", Core\Bytes::length($frame),
            " octets instead of ", Core\Bytes::length($page), "\n";
    }
}
