<?nvs
// Shows the five kinds of security scheme, and the fields each kind needs.

class Kinds
{
    // Returns the text that the API document writes as the scheme's `type`.
    public static function documentName(Core\Api\SchemeType $type): string
    {
        return match ($type) {
            Core\Api\SchemeType::ApiKey => 'apiKey',
            Core\Api\SchemeType::Http => 'http',
            Core\Api\SchemeType::MutualTls => 'mutualTLS',
            Core\Api\SchemeType::OAuth2 => 'oauth2',
            Core\Api\SchemeType::OpenIdConnect => 'openIdConnect',
        };
    }

    // Returns the fields that a scheme of this kind needs, next to `name` and `type`.
    public static function needs(Core\Api\SchemeType $type): string
    {
        return match ($type) {
            Core\Api\SchemeType::ApiKey => 'in, parameter',
            Core\Api\SchemeType::Http => 'scheme (format is optional)',
            Core\Api\SchemeType::MutualTls => 'no other field',
            Core\Api\SchemeType::OAuth2 => 'flows',
            Core\Api\SchemeType::OpenIdConnect => 'url',
        };
    }
}

array<Core\Api\SchemeType> $everything = [
    Core\Api\SchemeType::ApiKey,
    Core\Api\SchemeType::Http,
    Core\Api\SchemeType::MutualTls,
    Core\Api\SchemeType::OAuth2,
    Core\Api\SchemeType::OpenIdConnect,
];

foreach ($everything as Core\Api\SchemeType $type) {
    echo Kinds::documentName($type), ': ', Kinds::needs($type), "\n";
}
