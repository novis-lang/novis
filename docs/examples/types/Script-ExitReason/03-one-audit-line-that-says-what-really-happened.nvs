<?nvs
// This program writes the last line of a nightly job's log from the exit reason.
// A job that stopped because there was no work gets a different line
// from a job that failed with an error.

class Audit {
    public static function line(Core\Script\ExitReason $reason): string {
        return match ($reason) {
            Core\Script\ExitReason::Normal => "nightly import: complete",
            Core\Script\ExitReason::Finish => "nightly import: complete",
            Core\Script\ExitReason::ExitCall => "nightly import: stopped early, on purpose",
            Core\Script\ExitReason::UncaughtThrow => "nightly import: FAILED, someone should look",
        };
    }

    // Only `UncaughtThrow` needs a person to look at it.
    // It is the only reason the program did not choose itself.
    public static function wakeSomebody(Core\Script\ExitReason $reason): bool {
        return $reason == Core\Script\ExitReason::UncaughtThrow;
    }
}

Core\Script::onExit(fn (Core\Script\ExitReport $report): void => {
    echo Audit::line($report->reason()), "\n";
    if (Audit::wakeSomebody($report->reason())) {
        echo "paging the on-call engineer\n";
    }
});

array<string> $waiting = [];

echo "looking for files to import\n";

// No files arrived tonight. That is normal, so `exit` stops the job here.
// The exit reason is `ExitCall`.
if (Core\Arr::count($waiting) == 0) {
    echo "nothing arrived tonight\n";
    exit;
}

echo "importing ", Core\Arr::count($waiting), " file(s)\n";
