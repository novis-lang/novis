<?nvs
// Shows one `respond` method that sends pages as HTML and every other value as JSON.

use Core\Http\Method;

class Shop
{
    // This method returns a page.
    #[Core\Route(path: '/', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function home(): Core\Html\Markup
    {
        return html`<h1>Welcome to the shop</h1>`;
    }

    // This method returns data: a list of product names.
    #[Core\Route(path: '/api/products', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function products(): array<string>
    {
        return ['teapot', 'cup'];
    }

    // This method is `void`, so it writes its own response.
    // `respond` does not run for it.
    #[Core\Route(path: '/health', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function health(): void
    {
        echo 'ok';
    }
}

class Gate implements Core\Router\Responder
{
    public function allows(Core\Router\Match $route): bool
    {
        return true;
    }

    public function refused(Core\Router\Refusal $reason, ?Core\Router\Match $route): void
    {
        echo 'you cannot open this page';
    }

    public function failed(?Core\Router\Match $route, ?Throwable $error): void
    {
        echo 'sorry, something went wrong';
    }

    // A page is sent as HTML. Any other value is sent as JSON.
    public function respond(Core\Router\Match $route, mixed $value): void
    {
        if ($value is Core\Html\Markup) {
            Core\Response::html($value);
        } else {
            Core\Response::json($value);
        }
    }
}

if (Core\Env::context() == Core\Env::Context::Request) {
    Core\Router::dispatch(new Gate());
} else {
    // This prints the content type and the body of each response:
    // first the page, then the JSON, then `ok`.
    array<string> $paths = ['/', '/api/products', '/health'];
    foreach ($paths as string $path) {
        var $answer = Core\Test::request(Method::Get, $path);
        echo $answer->header('Content-Type'), ' ', $answer->body(), "\n";
    }
}
