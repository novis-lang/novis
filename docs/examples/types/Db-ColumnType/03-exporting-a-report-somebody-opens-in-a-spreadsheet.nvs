<?nvs
// This program plans an export to a file that somebody opens in a spreadsheet.
// The type of each column decides how that column is written to the file.

class Export {
    // `rule` returns how a column of this type is written. It uses the column
    // type and not the first row, so an empty result still gets a correct header.
    public static function rule(Core\Db\ColumnType $type): string {
        return match ($type) {
            Core\Db\ColumnType::Bytes => "left out, with the size written instead",
            Core\Db\ColumnType::Date => "written as 2026-09-18",
            Core\Db\ColumnType::DateTime => "written as 2026-09-18 14:05:00",
            Core\Db\ColumnType::Instant => "written in the reader's own time zone",
            Core\Db\ColumnType::Json => "flattened to one line",
            Core\Db\ColumnType::Other => "left out, because nothing here knows what it is",
            default => "written as it reads",
        };
    }

    // `carried` returns `true` if the column goes into the file.
    // The last line prints how many columns do. Here it prints `4 of 5`.
    public static function carried(Core\Db\ColumnType $type): bool {
        return $type != Core\Db\ColumnType::Bytes && $type != Core\Db\ColumnType::Other;
    }
}

array<string> $names = ["invoice_no", "issued_on", "total", "meta", "scan"];
array<Core\Db\ColumnType> $types = [
    Core\Db\ColumnType::Text,
    Core\Db\ColumnType::Date,
    Core\Db\ColumnType::Decimal,
    Core\Db\ColumnType::Json,
    Core\Db\ColumnType::Bytes,
];

uint $carried = 0;
foreach (Core\Arr::range(0, 4) as int $column) {
    echo $names[$column], ": ", Export::rule($types[$column]), "\n";
    if (Export::carried($types[$column])) {
        $carried = $carried + 1;
    }
}

echo $carried, " of ", Core\Arr::count($names), " columns go into the file\n";
