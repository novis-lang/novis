<?nvs
// Shows one date written with each `DateFormat::Length`, in English for the United States.
use Novis\Intl\DateFormat;

array<Core\Time\Date> $dates = [Core\Time\Date::at(2026, 3, 1)];

// `Medium` is the default.
echo DateFormat::dates($dates, 'en-US', { length: DateFormat::Length::Short })[0], "\n";
echo DateFormat::dates($dates, 'en-US', { length: DateFormat::Length::Medium })[0], "\n";
echo DateFormat::dates($dates, 'en-US', { length: DateFormat::Length::Long })[0], "\n";
