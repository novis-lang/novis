<?nvs
// Shows the `Reader::Visibility` of a sheet written with each value of the option `hidden`.
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

class Visibilities
{
    public static function name(Reader::Visibility $visibility): string
    {
        return match ($visibility) {
            Reader::Visibility::Visible => 'Visible',
            Reader::Visibility::Hidden => 'Hidden',
            Reader::Visibility::VeryHidden => 'VeryHidden',
        };
    }
}

var $book = Workbook::createInMemory();
$book->sheet('Prices')->add(['Tea', 2.5]);
$book->sheet('Rates', { hidden: true })->add(['EUR', 1.0]);
$book->sheet('Codes', { hidden: 'very' })->add(['A1', 'Shop']);
var $reader = Reader::open($book->finish()->bytes ?? Core\Bytes::fill(0, 0));

// This prints "Prices: Visible", "Rates: Hidden" and "Codes: VeryHidden".
foreach ($reader->sheets() as var $info) {
    echo $info->name, ': ', Visibilities::name($info->visibility), "\n";
}
