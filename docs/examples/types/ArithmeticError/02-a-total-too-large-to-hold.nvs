<?nvs
// A whole number that is too large throws an `ArithmeticError`. It never wraps
// around to a small or negative number. The message names the operation that
// failed: here it is "Integer multiplication overflowed".

int $bytesPerRow = 4000000000;
array<int> $rowCounts = [2, 3000000000];
foreach ($rowCounts as int $rows) {
    try {
        int $total = $bytesPerRow * $rows;
        echo $rows, " rows: ", $total, " bytes\n";
    } catch (ArithmeticError $tooLarge) {
        echo $rows, " rows: ", $tooLarge->message, "\n";
    }
}
