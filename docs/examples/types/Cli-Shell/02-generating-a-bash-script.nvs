<?nvs
// You do not write a completion script. You declare your commands, name a
// shell, and the script is written from that declaration — so what the shell
// offers is always what the program actually accepts.

class Tool {
    #[Core\Command(name: "deploy", about: "Push the current build")]
    public static function deploy(
        string $target,
        #[Core\Option(short: "n", about: "Print what would happen")] bool $dryRun = false,
    ): uint {
        return 0;
    }

    #[Core\Command(name: "version", about: "Print the version and stop")]
    public static function version(): uint {
        return 0;
    }
}

// The script registers against the program's own name. For a file run from a
// command line that name is the file's, which is why this example's own file
// name is what appears below.
echo Core\Command::completions(Core\Cli\Shell::Bash);
