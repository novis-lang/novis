<?nvs
// A publisher gives a SHA-256 checksum with a file. This program checks that the
// downloaded file has the same checksum. Always use the algorithm the publisher names.

// The program writes the file first, so that it has a download to check.
string $path = Core\Path::join(Core\IO::temporaryDir(), 'release.tar');
Core\IO::write($path, 'the release archive');

// The checksum as the publisher wrote it. A checksum is usually written as hex,
// so `Core\Encoding::fromHex` converts it to bytes below.
string $published = '9287352f960eca8487b5cf180199b11a82306e1e6fff02b566d48a229a8ebe32';

// `Core\Hash::of` reads the open file one piece at a time.
// A download of any size needs only a small amount of memory.
Core\IO\File $file = Core\IO::open($path, Core\IO::FileMode::Read);
bytes $ours = Core\Hash::of($file, Core\Hash::Digest::Sha256);
$file->close();

bytes $theirs = Core\Encoding::fromHex($published);

if (Core\Hash::equals($ours, $theirs)) {
    echo "checksum matches, the file is the one they published\n";
} else {
    // The file is damaged, or it is not the file the publisher released.
    // Do not install it. Print both checksums so somebody can compare them.
    echo "checksum does not match\n";
    echo '  they published: ', $published, "\n";
    echo '  we have:        ', Core\Encoding::toHex($ours), "\n";
}
