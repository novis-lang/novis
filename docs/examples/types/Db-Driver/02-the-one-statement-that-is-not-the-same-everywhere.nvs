<?nvs
// Most SQL statements run unchanged on all five drivers. "Insert this row, or
// update it if it already exists" is not the same on all of them. `Upsert::statement`
// returns the right SQL for each driver, and the loop prints all five.

class Upsert {
    public static function statement(Core\Db\Driver $driver): string {
        return match ($driver) {
            Core\Db\Driver::MySql => "insert into contacts (email, name) values (?, ?) "
                . "on duplicate key update name = values(name)",
            Core\Db\Driver::MariaDb => "insert into contacts (email, name) values (?, ?) "
                . "on duplicate key update name = values(name)",
            Core\Db\Driver::Postgres => "insert into contacts (email, name) values (?, ?) "
                . "on conflict (email) do update set name = excluded.name",
            Core\Db\Driver::Sqlite => "insert into contacts (email, name) values (?, ?) "
                . "on conflict (email) do update set name = excluded.name",
            Core\Db\Driver::SqlServer => "merge contacts as target using (values (?, ?)) "
                . "as source (email, name) on target.email = source.email "
                . "when matched then update set name = source.name "
                . "when not matched then insert (email, name) values (source.email, source.name);",
        };
    }

    public static function label(Core\Db\Driver $driver): string {
        return match ($driver) {
            Core\Db\Driver::MySql => "MySQL",
            Core\Db\Driver::MariaDb => "MariaDB",
            Core\Db\Driver::Postgres => "PostgreSQL",
            Core\Db\Driver::Sqlite => "SQLite",
            Core\Db\Driver::SqlServer => "SQL Server",
        };
    }
}

array<Core\Db\Driver> $everything = [
    Core\Db\Driver::MySql,
    Core\Db\Driver::MariaDb,
    Core\Db\Driver::Postgres,
    Core\Db\Driver::Sqlite,
    Core\Db\Driver::SqlServer,
];

foreach ($everything as Core\Db\Driver $driver) {
    echo Upsert::label($driver), "\n  ", Upsert::statement($driver), "\n";
}

// Every statement above uses `?` for its values, so the values are sent as
// parameters. Only the SQL text changes with the driver.
