<?nvs
// The driver is the first setting of a connection. It decides which other
// settings the connection needs. Four of the five drivers connect to a server
// over the network. SQLite uses a file on the machine your program runs on.

class Backend {
    public static function label(Core\Db\Driver $driver): string {
        return match ($driver) {
            Core\Db\Driver::MySql => "MySQL",
            Core\Db\Driver::MariaDb => "MariaDB",
            Core\Db\Driver::Postgres => "PostgreSQL",
            Core\Db\Driver::Sqlite => "SQLite",
            Core\Db\Driver::SqlServer => "Microsoft SQL Server",
        };
    }

    public static function needs(Core\Db\Driver $driver): string {
        return match ($driver) {
            Core\Db\Driver::Sqlite => "a path to a file",
            default => "a host, and a user to log in as",
        };
    }
}

array<Core\Db\Driver> $everything = [
    Core\Db\Driver::MySql,
    Core\Db\Driver::MariaDb,
    Core\Db\Driver::Postgres,
    Core\Db\Driver::Sqlite,
    Core\Db\Driver::SqlServer,
];

foreach ($everything as Core\Db\Driver $driver) {
    echo Backend::label($driver), " takes ", Backend::needs($driver), "\n";
}

// MariaDB has its own case, because it logs in and reports errors differently
// from MySQL. The two cases are not equal, so this prints `no`.
echo "MySQL and MariaDB are one case: ",
    Core\Db\Driver::MySql == Core\Db\Driver::MariaDb ? "yes" : "no",
    "\n";
