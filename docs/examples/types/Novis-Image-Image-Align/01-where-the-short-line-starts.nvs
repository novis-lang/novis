<?nvs
// Shows where each `Image::Align` puts a short line under a longer one.
use Novis\Image\Color;
use Novis\Image\Image;

require 'fonts/box-font.nvs';

class Line
{
    // Draws "Shop Hi" in a box 24 pixels wide, so "Hi" goes on a second line.
    // Returns the first column of that line that is not white.
    public static function start(Image::Align $align): int
    {
        var $raw = Image::create(24, 20, Color::hex('#ffffff'))
            ->text('Shop Hi', BoxFont::load(), {
                size: 10.0,
                color: Color::hex('#000000'),
                x: 0,
                y: 0,
                maxWidth: 24,
                align: $align,
            })
            ->raw();
        // Row 15 is inside the second line. Each pixel is 4 bytes, red first.
        int $row = 15 * 24;
        int $x = 0;
        while ($x < 24) {
            bytes $red = Core\Bytes::slice($raw->pixels, ($row + $x) * 4, 1);
            if (Core\Encoding::toHex($red) != 'ff') {
                return $x;
            }
            $x = $x + 1;
        }
        return 24;
    }
}

// "Hi" is 12 pixels wide. This prints 0, 6 and 12.
array<Image::Align> $aligns = [Image::Align::Left, Image::Align::Center, Image::Align::Right];
foreach ($aligns as Image::Align $align) {
    echo Line::start($align), "\n";
}
