<?nvs
// A customer record that logs every change made to it. The logging code is in one method.
// Every field change adds an entry, and a field you add later is logged too.

// The entries are stored outside the record. So adding an entry is not a
// change to the customer.
final class Audit {
    public static array<tainted string> $entries = [];
}

class Customer implements PropertyObserver {
    public string $name = "unknown";
    public string $email = "";
    public uint $orders = 0;

    public function onPropertyGet(string $name, mixed $value): void {
    }

    // This method runs after the value is stored, so `$value` is the new value.
    // A class must have both methods, even if it does nothing on a read.
    public function onPropertySet(string $name, mixed $value): void {
        Audit::$entries[] = $name . " is now " . $value;
    }
}

var $ada = new Customer();
$ada->name = "Ada Lovelace";
$ada->email = "ada@example.com";

// A correction and a new order, later in the day. Neither line calls any
// logging code.
$ada->email = "ada.lovelace@example.com";
$ada->orders = $ada->orders + 1;

echo "fields changed, oldest first:\n";
foreach (Audit::$entries as tainted string $field) {
    echo "  ", $field, "\n";
}
echo "the record now: ", $ada->name, " <", $ada->email, "> ", $ada->orders, " orders\n";
