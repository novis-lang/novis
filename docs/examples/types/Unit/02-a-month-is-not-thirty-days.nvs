<?nvs
// This program shows that calendar units have no fixed length.
// A month has 28 to 31 days, and a leap year has one extra day.
// A day has 23 or 25 hours when the clocks change.

var $utc = Core\Time\Zone::UTC;
var $day = "yyyy-MM-dd";

// Adding months keeps the day number if the new month has it.
// If not, the result is the last day of that month.
var $endOfJanuary = Core\Time::at(2024, 1, 31, $utc);
echo "31 January plus one month:  ", $endOfJanuary->plus(1, Core\Unit::Month)->format($day), "\n";
echo "31 January plus two months: ", $endOfJanuary->plus(2, Core\Unit::Month)->format($day), "\n";

// Going back one month starts from 29 February, so the result is 29 January.
// The date you started from was 31 January.
var $there = $endOfJanuary->plus(1, Core\Unit::Month);
echo "and back one month again:   ", $there->minus(1, Core\Unit::Month)->format($day), "\n\n";

// 2025 has no 29 February, so the result is 28 February.
var $leapDay = Core\Time::at(2024, 2, 29, $utc);
echo "29 February plus one year:  ", $leapDay->plus(1, Core\Unit::Year)->format($day), "\n\n";

// The clocks go forward in Berlin on 31 March 2024, so that day has 23 hours.
// The same day measured in days is still `1`.
var $berlin = Core\Time\Zone::of("Europe/Berlin");
var $morning = Core\Time::at(2024, 3, 31, $berlin)->startOf(Core\Unit::Day);
var $nextMorning = $morning->plus(1, Core\Unit::Day);
echo "31 March in Berlin is ", $morning->difference($nextMorning, Core\Unit::Hour), " hours long\n";
echo "and still ", $morning->difference($nextMorning, Core\Unit::Day), " day long\n";
