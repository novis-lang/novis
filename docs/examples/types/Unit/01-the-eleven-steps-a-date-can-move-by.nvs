<?nvs
// This program adds one of each of the eleven units to the same date and time.
// The units go from smallest to largest.

var $utc = Core\Time\Zone::UTC;
var $start = Core\Time::at(2024, 1, 31, $utc, {hour: 9, minute: 0});
var $fmt = "yyyy-MM-dd HH:mm:ss.SSSSSSSSS";

array<Core\Unit> $steps = [
    "nanosecond" => Core\Unit::Nanosecond,
    "microsecond" => Core\Unit::Microsecond,
    "millisecond" => Core\Unit::Millisecond,
    "second" => Core\Unit::Second,
    "minute" => Core\Unit::Minute,
    "hour" => Core\Unit::Hour,
    "day" => Core\Unit::Day,
    "week" => Core\Unit::Week,
    "month" => Core\Unit::Month,
    "quarter" => Core\Unit::Quarter,
    "year" => Core\Unit::Year,
];

echo "starting from ", $start->format($fmt), "\n\n";

foreach ($steps as string $name => Core\Unit $step) {
    echo "one ", $name, " later: ", $start->plus(1, $step)->format($fmt), "\n";
}

// One month after 31 January is 29 February, because 31 February does not exist.
// The day changes to the last day of the new month.
