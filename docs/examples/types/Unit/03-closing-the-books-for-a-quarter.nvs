<?nvs
// This program finds the invoices for a quarterly report.
// `startOf` and `endOf` with `Core\Unit::Quarter` give the first and last day of the quarter.
// `difference` in days shows which invoices are more than 30 days old.

var $utc = Core\Time\Zone::UTC;
var $day = "yyyy-MM-dd";
var $today = Core\Time::at(2024, 8, 20, $utc);

var $from = $today->startOf(Core\Unit::Quarter);
var $to = $today->endOf(Core\Unit::Quarter);
echo "reporting ", $from->format($day), " .. ", $to->format($day), "\n\n";

array<Core\Time\DateTime> $issued = [
    "INV-1041" => Core\Time::at(2024, 6, 28, $utc),
    "INV-1042" => Core\Time::at(2024, 7, 2, $utc),
    "INV-1043" => Core\Time::at(2024, 7, 19, $utc),
    "INV-1044" => Core\Time::at(2024, 8, 12, $utc),
];

uint $inThisQuarter = 0;

foreach ($issued as string $number => Core\Time\DateTime $date) {
    // An invoice belongs to the quarter when its date is between the first and last day.
    bool $covered = $from->difference($date, Core\Unit::Day) >= 0
        && $date->difference($to, Core\Unit::Day) >= 0;
    if ($covered) {
        $inThisQuarter = $inThisQuarter + 1;
    }

    int $age = $date->difference($today, Core\Unit::Day);
    echo $number, " issued ", $date->format($day), ", ", $age, " days ago",
        $covered ? "" : ", belongs to the quarter before",
        $age > 30 ? " — chase it" : "",
        "\n";
}

echo "\n", $inThisQuarter, " invoice(s) go into this quarter's report\n";
