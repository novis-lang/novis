<?nvs
// This program shows how to reply to a saved form with a redirect.
// If the reply were the page itself, a refresh would post the form again.
// A redirect sends the browser to a page that is safe to reload.

string $order = "ORD-1042";

// After a `SeeOther` redirect, the browser loads the new page with a plain `GET`.
// This is what you want to show the saved order.
Core\Response::redirect("/orders/" . $order, Core\Response\Redirect::SeeOther);

// This is the short way to write the same redirect. `SeeOther` is the default.
// The second call replaces the first.
Core\Response::redirect("/orders/" . $order);
echo "saved ", $order, " and sent the browser to /orders/", $order, "\n";

// A refresh of the new page only loads the order again.
// The order is saved once.
echo "a refresh re-reads the order instead of posting the form again\n";
