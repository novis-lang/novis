<?nvs
// Shows the `Line` that each side of a border gets from `Style::of`.
use Novis\Spreadsheet\Line;
use Novis\Spreadsheet\Style;

class Lines
{
    // Returns the name of a line, or "none" for a side without a line.
    public static function name(?Line $line): string
    {
        return match ($line) {
            Line::Thin => 'Thin',
            Line::Medium => 'Medium',
            Line::Thick => 'Thick',
            Line::Dashed => 'Dashed',
            Line::Dotted => 'Dotted',
            Line::Double => 'Double',
            null => 'none',
        };
    }
}

// A string sets the same line on all four sides. This prints "Thin" four times.
var $box = Style::of({ border: 'thin' })->fields->border;
echo Lines::name($box?->top), ' ', Lines::name($box?->right), ' ';
echo Lines::name($box?->bottom), ' ', Lines::name($box?->left), "\n";

// A shape sets each side alone. Here only the top and the bottom have a line.
// This prints "Double none Thick none".
var $total = Style::of({ border: { top: 'double', bottom: 'thick' } })->fields->border;
echo Lines::name($total?->top), ' ', Lines::name($total?->right), ' ';
echo Lines::name($total?->bottom), ' ', Lines::name($total?->left), "\n";
