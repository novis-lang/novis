<?nvs
// Shows the four `NumberFormat::Style` cases, each writing the same number in German.
use Novis\Intl\Icu;
use Novis\Intl\NumberFormat;

// Most programs call the `NumberFormat` methods, which choose the style for you.
// `Icu::formatNumbers` takes the style directly. Its options name every field.
array<NumberFormat::Style> $styles = [NumberFormat::Style::Decimal, NumberFormat::Style::Percent, NumberFormat::Style::Currency, NumberFormat::Style::Compact];
foreach ($styles as NumberFormat::Style $style) {
    // Only the `Currency` style takes a currency code.
    ?string $currency = $style == NumberFormat::Style::Currency ? "EUR" : null;
    array<string> $text = Icu::formatNumbers(["1234567.5"], "de", {
        style: $style,
        minFractionDigits: null,
        maxFractionDigits: null,
        grouping: null,
        currency: $currency,
        currencyDisplay: null,
        compactDisplay: null,
    });
    echo $text[0], "\n";
}
