<?nvs
// A queue keeps the order your class states, so the most urgent job is always
// the next one out — even when it arrives after work has started.

final class Job implements Comparable {
    public string $name;
    // Minutes left before this job is late. The fewer, the more urgent.
    public int $minutesLeft;

    public function constructor(string $name, int $minutesLeft) {
        $this->name = $name;
        $this->minutesLeft = $minutesLeft;
    }

    public function compareTo(Job $other): int {
        return $this->minutesLeft - $other->minutesLeft;
    }
}

// No comparator is given: the queue asks the class.
var $queue = new Core\Heap<Job>();
$queue->push(new Job("send invoices", 45));
$queue->push(new Job("rebuild search index", 120));
$queue->push(new Job("charge expiring card", 10));

var $next = $queue->peek();
echo "next up: ", $next->name, "\n";

// A job that is nearly late arrives while the queue is being worked through.
// It does not wait for its turn in line.
var $worked = 0;
while (!$queue->isEmpty()) {
    var $job = $queue->pop();
    echo "worked ", $job->name, " with ", $job->minutesLeft, " minutes left\n";
    $worked = $worked + 1;
    if ($worked == 1) {
        $queue->push(new Job("retry failed payout", 2));
    }
}
