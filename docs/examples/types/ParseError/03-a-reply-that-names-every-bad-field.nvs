<?nvs
// The everyday use: a signup arrives as a document, and the reply names every
// field that was wrong. Somebody filling in a form sees all of it at once
// rather than fixing one field per attempt.

#[Core\Json\Derive]
class Signup {
    public string $email;
    public int $age;
    public bool $terms;
    public function constructor(string $email, int $age, bool $terms) {
        $this->email = $email;
        $this->age = $age;
        $this->terms = $terms;
    }
}

string $body = "{\"email\":\"ada@example.com\",\"age\":\"thirty six\",\"terms\":\"on\"}";

try {
    var $signup = Core\Json::decodeAs<Signup>($body);
    echo "welcome ", $signup->email, "\n";
} catch (ParseError $bad) {
    // One entry becomes one field of the answer, keyed by the field it is about.
    array<string> $fields = [];
    foreach ($bad->issues as ({path: string, message: string}) $issue) {
        $fields[$issue->path] = $issue->message;
    }
    echo Core\Json::encode({status: "invalid", fields: $fields}), "\n";
}
