<?nvs
// Some errors are not about one field. A broken document throws a `ParseError` with one entry.
// The entry's path is empty, because no single field caused the error.

try {
    Core\Json::decode("{\"total\": }");
} catch (ParseError $broken) {
    echo "entries=", Core\Arr::count($broken->issues), "\n";
    echo "path=[", $broken->issues["0"]->path, "]\n";
    echo $broken->message, "\n";
}

// `maxDepth` limits how deeply a document may be nested. A deeper document
// throws a `ParseError`, so a hostile document cannot use up the server.
try {
    Core\Json::decode("[[[1]]]", {maxDepth: 2});
} catch (ParseError $deep) {
    echo $deep->message, "\n";
}

// A valid document throws no error.
echo Core\Json::encode(Core\Json::decode("{\"total\": 3}")), "\n";
