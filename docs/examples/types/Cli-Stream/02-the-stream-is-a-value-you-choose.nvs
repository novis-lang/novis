<?nvs
// A `Core\Cli\Stream` is an ordinary value. You can store it in a variable,
// return it from a function and pass it to another function.

class Report {
    // A result goes to standard output. Every other message goes to standard error.
    public static function streamFor(string $kind): Core\Cli\Stream {
        return match ($kind) {
            "result" => Core\Cli\Stream::Out,
            default => Core\Cli\Stream::Err,
        };
    }

    public static function say(string $kind, string $message): void {
        Core\Cli::write($message, {stream: Report::streamFor($kind), newline: true});
    }
}

Report::say("result", "eur 41.90");
Report::say("warning", "one price was missing and was left out");
Report::say("result", "eur 12.00");

// `Core\Cli\Stream::In` is standard input, which a program reads. Writing to it
// throws an error, and the message explains why the case exists.
try {
    Core\Cli::write("who would read this?", {stream: Core\Cli\Stream::In});
} catch (Throwable $refused) {
    echo $refused->message, "\n";
}
