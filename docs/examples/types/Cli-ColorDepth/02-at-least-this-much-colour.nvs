<?nvs
// The cases are listed from least colour to most, so "does this terminal have
// at least what I need" is a comparison. A case is a name rather than a
// number, so convert both sides before comparing them.

class Colour {
    public static function atLeast(Core\Cli\ColorDepth $have, Core\Cli\ColorDepth $want): bool {
        return ($have as int) >= ($want as int);
    }
}

// Two terminals, and the same question asked of both.
Core\Cli\ColorDepth $laptop = Core\Cli\ColorDepth::TrueColor;
Core\Cli\ColorDepth $buildLog = Core\Cli\ColorDepth::None;

echo "laptop has 256: ", Colour::atLeast($laptop, Core\Cli\ColorDepth::Ansi256) ? "yes" : "no", "\n";
echo "build log has 256: ", Colour::atLeast($buildLog, Core\Cli\ColorDepth::Ansi256) ? "yes" : "no", "\n";

// Which is how a program picks the best of the drawings it knows how to make.
// The list is written richest first, and the first one the terminal can show
// wins.
class Chart {
    public static function pick(Core\Cli\ColorDepth $have): string {
        if (Colour::atLeast($have, Core\Cli\ColorDepth::TrueColor)) {
            return "a smooth gradient";
        }
        if (Colour::atLeast($have, Core\Cli\ColorDepth::Ansi256)) {
            return "twenty-four steps";
        }
        if (Colour::atLeast($have, Core\Cli\ColorDepth::Ansi16)) {
            return "four blocks";
        }
        return "numbers, no colour";
    }
}

echo "laptop draws ", Chart::pick($laptop), "\n";
echo "build log draws ", Chart::pick($buildLog), "\n";
echo "old console draws ", Chart::pick(Core\Cli\ColorDepth::Ansi16), "\n";
