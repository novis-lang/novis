<?nvs
// Shows the `Sheet::RuleKind` that each option of `Sheet::addValidation` writes into the file.
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $orders = $book->addSheet('Orders');
$orders->addRow(['item' => 'Tea', 'qty' => 3, 'price' => 2.5, 'code' => 'T-1']);

// Each call adds one validation with one option. The option gives the kind:
// `list` is `Sheet::RuleKind::List`, and `whole` is `Sheet::RuleKind::Whole`.
$orders->addValidation('A2:A99', { list: ['Tea', 'Cake'] });
$orders->addValidation('B2:B99', { whole: { min: 1, max: 99 } });
$orders->addValidation('C2:C99', { decimal: { min: 0 } });
$orders->addValidation('D2:D99', { length: { max: 8 } });
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

// The file stores the kind in the `type` of each validation. Excel calls `length` "textLength",
// so this prints "list", "whole", "decimal" and "textLength".
var $sheet = Core\Zip::read($file, 'xl/worksheets/sheet1.xml') as string;
var $checks = Core\Str::split($sheet, "<dataValidation type=\"");
foreach (Core\Arr::slice($checks, 1) as tainted string $check) {
    echo Core\Str::before($check, "\"") ?? '', "\n";
}
