<?nvs
// Shows the `Sheet::RuleKind` that each option of `Sheet::validate` writes into the file.
use Novis\Spreadsheet\Workbook;

var $book = Workbook::createInMemory();
var $orders = $book->sheet('Orders');
$orders->add(['item' => 'Tea', 'qty' => 3, 'price' => 2.5, 'code' => 'T-1']);

// Each call sets one kind. `list` is `Sheet::RuleKind::List`, and `whole` is `Sheet::RuleKind::Whole`.
$orders->validate('A2:A99', { list: ['Tea', 'Cake'] });
$orders->validate('B2:B99', { whole: { min: 1, max: 99 } });
$orders->validate('C2:C99', { decimal: { min: 0 } });
$orders->validate('D2:D99', { length: { max: 8 } });
bytes $file = $book->finish()->bytes ?? Core\Bytes::fill(0, 0);

// Excel reads the kind from the `type` of each check in the file.
// This prints "list", "whole", "decimal" and "textLength".
var $sheet = Core\Zip::read($file, 'xl/worksheets/sheet1.xml') as string;
var $checks = Core\Str::split($sheet, "<dataValidation type=\"");
foreach (Core\Arr::slice($checks, 1) as tainted string $check) {
    echo Core\Str::before($check, "\"") ?? '', "\n";
}
