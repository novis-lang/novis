<?nvs
// Every verb you can name, what each one is for, and whether it is allowed to
// change anything. The four that can change something are the ones a
// cross-site request check has to cover.

class Verbs {
    public static function purpose(Core\Http\Method $verb): string {
        return match ($verb) {
            Core\Http\Method::Get => "Get: reads a page, and changes nothing",
            Core\Http\Method::Head => "Head: the same as Get, but the answer has no body",
            Core\Http\Method::Options => "Options: asks what a page supports",
            Core\Http\Method::Trace => "Trace: sends the request back, for working out what a proxy did to it",
            Core\Http\Method::Post => "Post: sends something new, such as a filled-in form",
            Core\Http\Method::Put => "Put: replaces what is there with what you send",
            Core\Http\Method::Patch => "Patch: changes part of what is there",
            Core\Http\Method::Delete => "Delete: removes it",
        };
    }

    public static function changesThings(Core\Http\Method $verb): bool {
        return match ($verb) {
            Core\Http\Method::Get => false,
            Core\Http\Method::Head => false,
            Core\Http\Method::Options => false,
            Core\Http\Method::Trace => false,
            Core\Http\Method::Post => true,
            Core\Http\Method::Put => true,
            Core\Http\Method::Patch => true,
            Core\Http\Method::Delete => true,
        };
    }
}

array<Core\Http\Method> $everything = [
    Core\Http\Method::Get,
    Core\Http\Method::Head,
    Core\Http\Method::Options,
    Core\Http\Method::Trace,
    Core\Http\Method::Post,
    Core\Http\Method::Put,
    Core\Http\Method::Patch,
    Core\Http\Method::Delete,
];

foreach ($everything as Core\Http\Method $verb) {
    echo Verbs::changesThings($verb) ? "changes  " : "reads    ", Verbs::purpose($verb), "\n";
}
