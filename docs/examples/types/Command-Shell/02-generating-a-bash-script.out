# bash completion for 02-generating-a-bash-script — generated by Core\Command::completions
__02_generating_a_bash_script_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W 'deploy version' -- "$cur"))
        return
    fi
    local options=''
    case "${COMP_WORDS[1]}" in
        'deploy') options='-n --dryRun' ;;
    esac
    COMPREPLY=($(compgen -W "$options" -- "$cur"))
}
complete -F __02_generating_a_bash_script_complete '02-generating-a-bash-script'
