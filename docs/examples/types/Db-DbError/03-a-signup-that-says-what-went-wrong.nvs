<?nvs
// A signup that tells the person what went wrong. If the address is already
// registered, `Signup::add` returns a message the person can act on.
// It throws every other `DbError` again, for the caller to handle.

use Core\Db;
use Core\Db\Connection;
use Core\Db\DbError;
use Core\Db\ErrorKind;

final class Signup {
    public static function add(Connection $db, string $email): string {
        try {
            $db->execute('insert into accounts (email) values (?)', [$email]);
            return "welcome";
        } catch (DbError $refused) {
            if ($refused->kind == ErrorKind::UniqueViolation) {
                return "that address is already registered";
            }
            throw $refused;
        }
    }
}

var $db = Db::connect('schema');
$db->execute('create table accounts (email text not null primary key)', []);

echo Signup::add($db, "ada@example.test"), "\n";
echo Signup::add($db, "ada@example.test"), "\n";

$db->execute('drop table accounts', []);
