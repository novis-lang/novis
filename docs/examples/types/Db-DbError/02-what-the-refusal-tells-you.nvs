<?nvs
// A refusal carries more than a sentence. It says which rule was broken, and it
// hands back the statement the program wrote — so one place can log both, and
// nothing has to remember what it was doing when it asked.

use Core\Db;
use Core\Db\DbError;
use Core\Db\ErrorKind;

var $db = Db::connect('schema');
$db->execute('create table notes (id integer primary key, title text not null)', []);
$db->execute('insert into notes (id, title) values (?, ?)', [1, 'first']);

try {
    $db->execute('insert into notes (id, title) values (?, ?)', [1, 'again']);
} catch (DbError $refused) {
    if ($refused->kind == ErrorKind::UniqueViolation) {
        echo 'refused: that key is already taken', "\n";
    }
    echo 'the statement it refused: ', $refused->sql, "\n";
}

try {
    $db->execute('insert into notes (id, title) values (?, ?)', [2, null]);
} catch (DbError $refused) {
    if ($refused->kind == ErrorKind::NotNullViolation) {
        echo 'refused: that column may not be left empty', "\n";
    }
    echo 'the statement it refused: ', $refused->sql, "\n";
}

$db->execute('drop table notes', []);
