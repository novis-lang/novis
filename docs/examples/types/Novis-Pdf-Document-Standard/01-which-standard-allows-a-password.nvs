<?nvs
// Shows each `Document::Standard` used on the same document, and which one allows a password.
use Novis\Pdf\Document;

// This page has a title. With the creation time set below, it meets every standard.
string $html = "<html lang=\"en\"><head><title>Price list</title></head>"
    . '<body><h1>Price list</h1><p>Tea 2.50 EUR</p></body></html>';

array<Document::Standard> $standards = [
    Document::Standard::PdfA2b,
    Document::Standard::PdfA3b,
    Document::Standard::PdfUa1,
];

// A PDF/A file cannot have a password, so `render` throws a `LogicError` for the first two.
// This prints the error twice, and then "renders" for `PdfUa1`.
foreach ($standards as Document::Standard $standard) {
    var $document = Document::fromHtml($html)
        ->standard($standard)
        ->created(Core\Time::fromIso('2026-03-01T09:00:00Z'))
        ->password('shop-secret');
    try {
        $document->render();
        echo "renders\n";
    } catch (LogicError $e) {
        echo 'error: ', $e->message, "\n";
    }
}
