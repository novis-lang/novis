<?nvs
// A file arrives from an old system. Its bytes are not UTF-8, so reading them
// as text needs the name of the encoding they were written in.

// The old system writes its files in Latin-1. This line makes such a file.
string $path = Core\Path::join(Core\IO::temporaryDir(), 'export.txt');
Core\IO::write($path, Core\Encoding::encodeText('Café', Core\Charset::Latin1));

// `Core\IO::readBytes` reads the file exactly as it is on disk.
bytes $arrived = Core\IO::readBytes($path);

// Read the bytes as Latin-1. You get ordinary text back, and this prints `Café`.
echo Core\Encoding::decodeText($arrived, Core\Charset::Latin1), "\n";

// The same bytes are not UTF-8. So reading the file as UTF-8 text throws an error.
try {
    echo Core\IO::read($path), "\n";
} catch (Throwable $wrong) {
    echo $wrong->message, "\n";
}
