<?nvs
// `isValidText` checks if some bytes are valid text in an encoding. You can
// check an uploaded file this way before you read it as text.

bytes $uploaded = Core\Encoding::fromHex("436166e9");

echo "utf-8:        ", Core\Encoding::isValidText($uploaded, Core\Charset::Utf8) ? "yes" : "no", "\n";
echo "windows-1252: ", Core\Encoding::isValidText($uploaded, Core\Charset::Windows1252) ? "yes" : "no", "\n";
echo "koi8-r:       ", Core\Encoding::isValidText($uploaded, Core\Charset::Koi8R) ? "yes" : "no", "\n";

// `yes` does not prove the encoding. Many older encodings accept every byte,
// so the same bytes give different text in each one, as these two lines show.
echo Core\Encoding::decodeText($uploaded, Core\Charset::Windows1252), "\n";
echo Core\Encoding::decodeText($uploaded, Core\Charset::Koi8R), "\n";
