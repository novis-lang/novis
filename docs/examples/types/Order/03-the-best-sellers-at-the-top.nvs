<?nvs
// This program lists what sold this week. `Core\Order::Desc` puts the best sellers
// at the top.

array<int> $sold = [
    "notebook" => 41,
    "pencil"   => 128,
    "eraser"   => 12,
    "ruler"    => 63,
];

array<int> $best = Core\Arr::sort($sold, {order: Core\Order::Desc, preserveKeys: true});
foreach ($best as string $product => int $count) {
    echo $product, ": ", $count, "\n";
}

// `Core\Order::Asc` puts the least sold first. This list helps you decide what to
// stop selling.
echo "least sold: ", Core\Json::encode(Core\Arr::sort($sold, {order: Core\Order::Asc, preserveKeys: true})), "\n";
