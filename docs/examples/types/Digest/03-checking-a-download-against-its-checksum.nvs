<?nvs
// The everyday job: something published a SHA-256 beside a file, and you want
// to know whether what you have is what they published. The algorithm is the
// one they named, so it is read from their instructions rather than chosen.

// What was downloaded, standing in for the file's contents here.
string $downloaded = "the release archive";

// The checksum as the publisher wrote it — hex, because that is how a checksum
// is written down for people to copy.
string $published = "9287352f960eca8487b5cf180199b11a82306e1e6fff02b566d48a229a8ebe32";

bytes $ours = Core\Hash::of($downloaded, Core\Digest::Sha256);
bytes $theirs = Core\Encoding::fromHex($published);

if (Core\Hash::equals($ours, $theirs)) {
    echo "checksum matches, the file is the one they published\n";
} else {
    // Do not install it and do not try again quietly: either the download
    // broke, or what is on the server is not what the publisher signed off.
    echo "checksum does not match\n";
    echo "  they published: ", $published, "\n";
    echo "  we have:        ", Core\Encoding::toHex($ours), "\n";
}
