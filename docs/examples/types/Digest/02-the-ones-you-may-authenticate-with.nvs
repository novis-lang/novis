<?nvs
// Hashing a message and authenticating a message are different jobs. You can
// hash with any case of `Core\Digest`. To authenticate is to prove that a message
// came from somebody with the shared key. Only the ten SHA-2 and SHA-3 cases can do that.

// `Core\Hash::of` accepts any case, so you can still check an old MD5 checksum.
echo "md5 of the file:    ", Core\Encoding::toHex(Core\Hash::of("hello", Core\Digest::Md5)), "\n";

// `Core\Hash::hmac` needs a shared key and one of the ten cases.
// `Core\Digest::Md5` on the line below does not compile.
bytes $key = Core\Encoding::fromHex("4a656665");
bytes $tag = Core\Hash::hmac("hello", $key, Core\Digest::Sha256);
echo "tag on the message: ", Core\Encoding::toHex($tag), "\n";

// The receiver has the same key. It computes the tag again and compares the two.
// `Core\Hash::equals` compares in constant time. Use it for anything secret.
bytes $expected = Core\Hash::hmac("hello", $key, Core\Digest::Sha256);
if (Core\Hash::equals($tag, $expected)) {
    echo "the message is from whoever holds the key\n";
}
