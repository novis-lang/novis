<?nvs
// Four files arrive, and the question is what each one really is. The answer is
// read from the first few bytes of the file. Those bytes are not letters, so
// they are written here the way a person writes bytes: two characters each.

array<string> $arrived = [
    "a photo from a phone" => "ffd8ffe000104a4649",
    "a screenshot"         => "89504e470d0a1a0a",
    "an invoice"           => "255044462d312e37",
    "a spreadsheet"        => "504b03041400",
];

foreach ($arrived as string $what => string $firstBytes) {
    Core\Mime\Type $found = Core\Mime::detect(Core\Encoding::fromHex($firstBytes));
    echo $what, ": ", Core\Mime::mediaType($found), "\n";
}

// The spreadsheet came back as a zip, and that is correct. A `.xlsx` file, a
// `.docx` and a `.jar` are all zip archives, and what tells them apart is a
// file stored inside the archive.
