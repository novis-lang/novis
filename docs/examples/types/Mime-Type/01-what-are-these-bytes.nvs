<?nvs
// `Core\Mime::detect` reads the first bytes of a file and returns its type.
// This program checks four files in the `data` folder beside it.

array<Core\IO\File> $arrived = [
    'a photo from a phone' => Core\IO::open('data/photo.jpg', Core\IO::FileMode::Read),
    'a screenshot' => Core\IO::open('data/screenshot.png', Core\IO::FileMode::Read),
    'an invoice' => Core\IO::open('data/invoice.pdf', Core\IO::FileMode::Read),
    'a spreadsheet' => Core\IO::open('data/sales.xlsx', Core\IO::FileMode::Read),
];

foreach ($arrived as string $what => Core\IO\File $file) {
    // `detect` reads only the start of the file. It does not read the whole file.
    Core\Mime::Type $found = Core\Mime::detect($file);
    echo $what, ': ', Core\Mime::mediaType($found), "\n";
}

// The spreadsheet is a zip, and that is correct. A `.xlsx`, a `.docx` and a `.jar`
// file are all zip archives. Only the files inside the archive are different.
