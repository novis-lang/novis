<?nvs
// `Core\Mime::detect` reads the first bytes of a file and returns its type.
// This program checks four files. Their first bytes are written in hex:
// two characters for each byte.

array<string> $arrived = [
    "a photo from a phone" => "ffd8ffe000104a4649",
    "a screenshot"         => "89504e470d0a1a0a",
    "an invoice"           => "255044462d312e37",
    "a spreadsheet"        => "504b03041400",
];

foreach ($arrived as string $what => string $firstBytes) {
    Core\Mime\Type $found = Core\Mime::detect(Core\Encoding::fromHex($firstBytes));
    echo $what, ": ", Core\Mime::mediaType($found), "\n";
}

// The spreadsheet is a zip, and that is correct. A `.xlsx`, a `.docx` and a `.jar`
// file are all zip archives. Only the files inside the archive are different.
