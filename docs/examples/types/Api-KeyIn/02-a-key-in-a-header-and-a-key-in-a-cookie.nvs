<?nvs
// Declares two key schemes, one in a header and one in a cookie, and a route that accepts both.

// `parameter` is the name of the header or the cookie. `name` is the name of the scheme.
#[Core\Api\Scheme(name: 'partnerKey', type: Core\Api\SchemeType::ApiKey, in: Core\Api\KeyIn::Header, parameter: 'X-Partner-Key')]
#[Core\Api\Scheme(name: 'session', type: Core\Api\SchemeType::ApiKey, in: Core\Api\KeyIn::Cookie, parameter: 'shop_session')]
class Auth
{}

class Products
{
    /// List the products.
    #[Core\Route(path: '/products', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    // A partner sends its key in a header. A browser sends the session cookie.
    #[Core\Api(security: ['partnerKey', 'session'])]
    public function list(): string
    {
        return 'tea, coffee';
    }
}

// `nvs build --openapi` writes both schemes to the API document.
// When the program runs, the route works the same with or without them.
Products $products = new Products();
// This prints `tea, coffee`.
echo $products->list(), "\n";
