<?nvs
// This program collects the text of an XML document.
// It checks the kind of each node. It keeps text nodes and skips comments
// and processing instructions.

class Reader {
    public static function words(Core\Xml\Node $node): tainted string {
        if ($node->kind() == Core\Xml\NodeKind::Text) {
            return $node->text();
        }
        // A comment or an instruction gives an empty string.
        // An element or the document gives the text of all its children.
        if ($node->kind() == Core\Xml\NodeKind::Comment
            || $node->kind() == Core\Xml\NodeKind::ProcessingInstruction) {
            return "";
        }
        tainted string $said = "";
        foreach ($node->children() as Core\Xml\Node $child) {
            $said = $said . Reader::words($child);
        }
        return $said;
    }
}

var $doc = Core\Xml::parse("<page><?render draft?><h1>Opening hours</h1><!-- check before Easter --> <p>Every day from <b>9</b> until <b>17</b>.</p></page>");

// The space between the comment and `<p>` is a text node too,
// so it is part of the result.
echo Reader::words($doc), "\n";
