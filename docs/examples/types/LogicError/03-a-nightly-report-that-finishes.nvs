<?nvs
// A nightly run that has to finish. Each customer's reference numbers are
// written in a base taken from that customer's settings, and one of those
// settings holds a base nobody can write in. That row is recorded as our
// mistake to fix in the morning, and the rest of the run still goes out.

final class Nightly {
    public static function reference(int $order, uint $base): string {
        return Core\BigInt::of($order)->format({radix: $base});
    }

    // The line is built before anything is printed, so a row that turns out to
    // be broken has written nothing yet.
    public static function run(array<string> $customers, array<uint> $bases, array<int> $orders): uint {
        uint $toFix = 0;
        uint $row = 0;
        while ($row < 3) {
            try {
                string $code = Nightly::reference($orders[$row], $bases[$row]);
                echo $customers[$row], ": ", $code, "\n";
            } catch (LogicError $badSetting) {
                echo $customers[$row], ": skipped, ", $badSetting->message, "\n";
                $toFix = $toFix + 1;
            }
            $row = $row + 1;
        }
        return $toFix;
    }
}

array<string> $customers = ["Ferngrove", "Hallbeck", "Ostrander"];
array<uint> $bases = [16, 40, 36];
array<int> $orders = [4021, 1204, 9000000];

uint $toFix = Nightly::run($customers, $bases, $orders);
echo "settings to fix: ", $toFix, "\n";
