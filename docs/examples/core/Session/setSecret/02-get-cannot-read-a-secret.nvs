<?nvs
// Shows that a secret can only be read with `getSecret()` and the right keys.

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

Core\Session::start();
secret string $token = "rt-51d0e8aa";
Core\Session::setSecret("refresh-token", $token, $keys);

// `get()` does not return secrets. This prints `get: null`.
echo "get: ", Core\Session::get("refresh-token") == null ? "null" : "a value", "\n";

// Another key cannot decrypt the secret. This prints `other key: null`.
secret bytes $otherKey = Core\Crypto::generateKey();
array<secret bytes> $otherKeys = [$otherKey];
echo "other key: ",
    Core\Session::getSecret("refresh-token", $otherKeys) == null ? "null" : "a value", "\n";

// The right key can. This prints `right key: a value`.
echo "right key: ",
    Core\Session::getSecret("refresh-token", $keys) == null ? "null" : "a value", "\n";
