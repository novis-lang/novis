<?nvs
// Shows a page that calls a service with the user's access token, or asks the user to sign in.

class Calendar {
    public static function page(array<secret bytes> $keys): string {
        // `null` means the user has not signed in to the service yet.
        var $token =Core\Session::getSecret("calendar-token", $keys);
        if ($token == null) {
            return "please connect your calendar";
        }
        // A real program sends the token to the service here.
        return "showing your calendar";
    }
}

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

Core\Session::start();

// This prints `please connect your calendar`.
echo Calendar::page($keys), "\n";

// The user connects the calendar, and the program saves the token it got.
Core\Session::setSecret("calendar-token", "at-2d40c8e7", $keys);

// This prints `showing your calendar`.
echo Calendar::page($keys), "\n";
