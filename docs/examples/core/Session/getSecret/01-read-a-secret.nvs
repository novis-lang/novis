<?nvs
// Shows how to read a short-lived secret and a long-lived secret from the session.
// requires: redis

// A real program loads its keys from its configuration. This example creates one.
secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

// The access token belongs to the login. The device token stays after the browser closes.
secret string $token = 'at-7f3c9b21';
secret string $device = 'dv-0c55e1a9';
Core\Session::setShortLivedSecret('access-token', $token, $keys);
Core\Session::setLongLivedSecret('device-token', $device, $keys);

// `getSecret()` reads a secret of either lifetime. This prints `token: found` and `device: found`.
echo 'token: ',
    (Core\Session::getSecret('access-token', $keys) ?? '') == $token ? 'found' : 'missing', "\n";
echo 'device: ',
    (Core\Session::getSecret('device-token', $keys) ?? '') == $device ? 'found' : 'missing', "\n";

// Nothing is saved under this key, so the result is `null`. This prints `other: null`.
echo 'other: ',
    Core\Session::getSecret('api-token', $keys) == null ? 'null' : 'a value', "\n";
