<?nvs
// Shows how to read a secret from the session.

// A real program loads its keys from its configuration. This example creates one.
secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

Core\Session::start();
secret string $token = "at-7f3c9b21";
Core\Session::setSecret("access-token", $token, $keys);

// `getSecret()` returns the token. This prints `token: found`.
echo "token: ",
    (Core\Session::getSecret("access-token", $keys) ?? "") == $token ? "found" : "missing", "\n";

// Nothing is saved under this key, so the result is `null`. This prints `other: null`.
echo "other: ",
    Core\Session::getSecret("api-token", $keys) == null ? "null" : "a value", "\n";
