<?nvs
// Shows that `regenerate()` keeps every value and every secret in the session.

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

Core\Session::start();
Core\Session::set("language", "de");
secret string $token = "rt-51d0e8aa";
Core\Session::setSecret("refresh-token", $token, $keys);

Core\Session::regenerate();

// Both are still there. This prints `language: de` and `token: kept`.
echo "language: ", Core\Session::get("language") ?? "(none)", "\n";
echo "token: ",
    (Core\Session::getSecret("refresh-token", $keys) ?? "") == $token ? "kept" : "lost", "\n";
