<?nvs
// Shows that `regenerate()` keeps every value and every secret in the session.
// requires: redis

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

// One value of each lifetime, and one secret.
Core\Session::setLongLived('language', 'de');
Core\Session::setShortLived('user', 'ada');
secret string $token = 'rt-51d0e8aa';
Core\Session::setShortLivedSecret('refresh-token', $token, $keys);

Core\Session::regenerate();

// All three are still there. This prints `language: de`, `user: ada` and `token: kept`.
echo 'language: ', Core\Session::get('language') ?? '(none)', "\n";
echo 'user: ', Core\Session::get('user') ?? '(nobody)', "\n";
echo 'token: ',
    (Core\Session::getSecret('refresh-token', $keys) ?? '') == $token ? 'kept' : 'lost', "\n";
