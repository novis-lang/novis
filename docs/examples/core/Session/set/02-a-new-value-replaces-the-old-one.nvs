<?nvs
// Shows that saving under a key that already has a value replaces that value.

Core\Session::start();
Core\Session::set("language", "en");

// The visitor picks another language. The second `set()` replaces "en".
Core\Session::set("language", "de");

// This prints `de`.
echo "language: ", Core\Session::get("language") ?? "(none)", "\n";
