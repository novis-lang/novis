<?nvs
// Shows a counter of how many pages a visitor has opened since the browser started.
// requires: redis

// On the first page there is no saved count, so `get()` returns `null`
// and the count starts at 0. `as ?int` converts the saved value to a whole number.
int $views = Core\Session::get('views') as ?int ?? 0;
$views = $views + 1;

// A short-lived value is deleted when the visitor closes the browser.
// So the count starts again at 0 in a new browser session.
Core\Session::setShortLived('views', $views);

// This is the visitor's first request, so it prints `1`.
echo 'pages opened: ', $views, "\n";
