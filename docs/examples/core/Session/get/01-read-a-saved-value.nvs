<?nvs
// Shows how to read values that were saved in the session.
// requires: redis

Core\Session::setShortLived('user', 'ada');
Core\Session::setLongLived('language', 'de');

// `get()` reads a value of either lifetime. This prints `ada` and then `de`.
echo 'user: ', Core\Session::get('user') ?? '(none)', "\n";
echo 'language: ', Core\Session::get('language') ?? 'en', "\n";

// No value was saved under "currency", so `??` gives the default "EUR".
// Write `??` before `as string`, because `null as string` is an empty string.
tainted string $currency = (Core\Session::get('currency') ?? 'EUR') as string;
echo 'currency: ', $currency, "\n";
