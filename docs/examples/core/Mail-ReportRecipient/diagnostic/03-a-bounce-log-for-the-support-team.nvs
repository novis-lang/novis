<?nvs
// Writes one log line for each failed recipient, with the server message for the support team.

use Core\Mail\Message;
use Core\Mail\ReportRecipient;

Message $bounce = Message::parse(
    "From: mailer-daemon@mx.example.net\n"
        . "Subject: Undelivered Mail\n"
        . "Content-Type: multipart/report; report-type=delivery-status; boundary=\"b\"\n\n"
        . "--b\nContent-Type: message/delivery-status\n\n"
        . "Reporting-MTA: dns; mx.example.net\n\n"
        . "Final-Recipient: rfc822; ada@example.org\nAction: failed\nStatus: 5.1.1\n"
        . "Diagnostic-Code: smtp; 550 5.1.1 <ada@example.org>: Recipient address rejected\n\n"
        . "Final-Recipient: rfc822; bo@example.org\nAction: delayed\nStatus: 4.4.1\n"
        . "Diagnostic-Code: smtp; 421 4.4.1 Connection timed out\n"
        . "--b--\n",
);

// The program decides with `isPermanent()`. The message is only kept for a person to read.
foreach ($bounce->report()?->recipients() ?? [] as ReportRecipient $recipient) {
    string $level = $recipient->isPermanent() ? 'error' : 'warning';
    echo $level, ' ', $recipient->address(), ' "', $recipient->diagnostic() ?? '', "\"\n";
}

// On a web page, the message is escaped. The `<` and `>` around the address become `&lt;` and `&gt;`.
foreach ($bounce->report()?->recipients() ?? [] as ReportRecipient $recipient) {
    echo Core\Html::escape($recipient->diagnostic() ?? ''), "\n";
}
