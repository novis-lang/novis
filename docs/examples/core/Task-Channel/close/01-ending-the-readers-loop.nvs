<?nvs
// Shows how a reading loop ends. The task that sends calls `close`, and the
// `foreach` in the other task finishes instead of waiting for more values.

var $chan = new Core\Task\Channel<int>(2);

Core\Task::all({
    produce: fn(): int => {
        foreach (Core\Arr::range(1, 3) as int $i) {
            $chan->send($i);
        }
        // Without this line the loop below would wait for a fourth value that
        // nobody is going to send.
        $chan->close();
        return 0;
    },
    consume: fn(): int => {
        foreach ($chan as int $value) {
            echo "got ", $value, "\n";
        }
        // This line is reached because the channel was closed.
        echo "the channel is closed\n";
        return 0;
    },
});
