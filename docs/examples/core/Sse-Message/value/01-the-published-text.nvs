<?nvs
// Shows how to read the value that was published.

// The `.nvse` file beside this example publishes one value on `chat`.
Core\Sse $sse = Core\Sse::current();
Core\Topic::subscribe("chat");

?Core\Sse\Message $message = $sse->receive();
if ($message != null) {
    // `value()` returns what the publisher sent, as a `mixed` value. `as string` converts
    // it to a `tainted string`. This prints `anna: Hello, everyone!`.
    tainted string $text = $message->value() as string;
    echo $text, "\n";
}
