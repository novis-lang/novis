<?nvs
// Shows which attachments are shown inside the HTML and which are files to download.

use Core\Mail\Attachment;

array<Attachment> $parts = [
    Attachment::inlineFile('files/logo.png'),
    Attachment::fromFile('files/invoice-1042.pdf'),
    Attachment::fromBytes('orders.csv', "order,total\n", { type: 'text/csv' }),
];

// `inlineFile` and `inlineBytes` make inline attachments, which are shown inside the HTML.
// `fromFile` and `fromBytes` make files to download.
foreach ($parts as Attachment $part) {
    echo $part->name(), ': ', $part->isInline() ? 'inside the HTML' : 'a file to download', "\n";
}
