<?nvs
// Shows a stream script that sends every published update to its client.

// The `.nvse` file beside this example publishes two updates on `orders`.
Core\Sse $sse = Core\Sse::current();
Core\Topic::subscribe("orders");

// `receive()` waits for the next published value and returns it as a message.
// When the client has gone, it returns `null` and the loop ends.
?Core\Sse\Message $message = $sse->receive();
while ($message != null) {
    // This prints `event: order` and one `data:` line for each update.
    $sse->send($message->value() as string, event: "order");
    $message = $sse->receive();
}
// This prints `stream closed`.
echo "stream closed\n";
