<?nvs
// Shows the import a program does after it reads a file. The import gets a row
// of its own, and every record points at it. All of it is written together, so
// a half-finished import cannot be left behind.

var $db = Core\Db::connect('notes');
$db->execute('create table imports (id integer primary key, source text not null)', []);
$db->execute('create table people (id integer primary key, importId integer not null, name text not null)', []);

// In a real import these come from a file or an upload.
array<string> $names = ['Ada', 'Bo', 'Chen'];

uint $imported = $db->transaction(fn (Core\Db\Transaction $tx): uint => {
    var $import = $tx->execute('insert into imports (source) values (?)', ['people.csv']);
    var $importId = $import->lastId() ?? 0;
    // One set per record. A `:name` in the statement takes its value from the
    // key of the same name.
    array<array<mixed>> $rows = [];
    foreach ($names as string $name) {
        $rows[] = ['importId' => $importId, 'name' => $name];
    }
    return $tx->executeMany('insert into people (importId, name) values (:importId, :name)', $rows);
});

// This prints `3 people imported`.
echo $imported, " people imported\n";

$db->close();
