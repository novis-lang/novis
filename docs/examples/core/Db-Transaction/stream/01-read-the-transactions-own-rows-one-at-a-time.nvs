<?nvs
// Shows a read inside a transaction that gives you one row at a time. The rows
// the transaction has written are already there, before the transaction ends.

var $db = Core\Db::connect('notes');
$db->execute('create table notes (id integer primary key, text text not null)', []);

$db->transaction(fn (Core\Db\Transaction $tx): void => {
    $tx->execute('insert into notes (text) values (?), (?)', ['buy milk', 'call Ana']);

    // Each step of the loop reads one row from the database. The two rows above
    // are part of this transaction, so this prints both of them.
    foreach ($tx->stream('select id, text from notes order by id', []) as Core\Db\Row $row) {
        echo $row->int('id') ?? 0, ': ', $row->string('text') ?? '', "\n";
    }

    // The last row ended the walk, so the transaction can run another statement.
    echo 'rows: ', $tx->query('select id from notes', [])->count(), "\n";
});

// The transaction is over, so the rows are saved. This prints `2 notes`.
echo $db->query('select id from notes', [])->count(), " notes\n";

$db->close();
