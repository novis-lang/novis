<?nvs
// Shows what you get when the column has no value in this row.

var $db = Core\Db::connect('notes');
$db->execute('create table orders (label text not null, paid_by uuid)', []);
$db->execute(
    'insert into orders (label, paid_by) values (?, ?), (?, ?)',
    ['one tea', '3f2504e0-4f89-41d3-9a0c-0305e82c3301', 'two coffees', null]
);

// The result is `null` when the column has no value in this row. The type you
// get back is `?Core\Uuid`, so you test it for `null` before you use it.
foreach ($db->query('select label, paid_by from orders order by label', []) as Core\Db\Row $row) {
    ?Core\Uuid $payer = $row->uuid('paid_by');
    if ($payer == null) {
        echo $row->string('label') ?? '', ': nobody has paid', "\n";
    } else {
        echo $row->string('label') ?? '', ': paid by ', $payer->toString(), "\n";
    }
}

$db->close();
