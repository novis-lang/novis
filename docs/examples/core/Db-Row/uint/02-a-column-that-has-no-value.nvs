<?nvs
// Shows what you get when the column has no value in this row.

var $db = Core\Db::connect('notes');
$db->execute('create table uploads (name text not null, size bigint)', []);
$db->execute(
    'insert into uploads (name, size) values (?, ?), (?, ?)',
    ['logo.png', 18432, 'draft.txt', null]
);

// The result is `null` when the column has no value in this row. The type you
// get back is `?uint`, so you test it for `null` before you use it.
foreach ($db->query('select name, size from uploads order by name', []) as Core\Db\Row $row) {
    ?uint $size = $row->uint('size');
    if ($size == null) {
        echo $row->string('name') ?? '', ': the size is not known', "\n";
    } else {
        echo $row->string('name') ?? '', ': ', $size, " bytes\n";
    }
}

$db->close();
