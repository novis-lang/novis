<?nvs
// Shows how to read a measurement out of a row.

var $db = Core\Db::connect('notes');
$db->execute('create table readings (station text not null, celsius real not null)', []);
$db->execute(
    'insert into readings (station, celsius) values (?, ?), (?, ?)',
    ['north field', 21.5, 'south field', 9.25]
);

// `float` reads the named column as a floating-point number. This prints one
// line for each station.
foreach ($db->query('select station, celsius from readings order by station', []) as Core\Db\Row $row) {
    echo $row->string('station') ?? '', ': ', $row->float('celsius') ?? 0.0, " degrees\n";
}

$db->close();
