<?nvs
// Shows what you get when the binary column has no value in this row.

var $db = Core\Db::connect('notes');
$db->execute('create table people (name text not null, picture blob)', []);
$db->execute('insert into people (name, picture) values (?, ?), (?, ?)', ['Ana', 'GIF89a' as bytes, 'Bo', null]);

// `bytes` returns `null` for a column with no value, so your program can
// choose what to show instead. This prints `Ana: 6` and `Bo: no picture`.
foreach ($db->query('select name, picture from people order by name', []) as Core\Db\Row $row) {
    ?tainted bytes $picture = $row->bytes('picture');
    echo $row->string('name') ?? '', ': ';
    if ($picture != null) {
        echo Core\Bytes::length($picture), "\n";
    } else {
        echo "no picture\n";
    }
}

$db->close();
