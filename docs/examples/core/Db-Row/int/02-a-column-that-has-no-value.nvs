<?nvs
// Shows what you get when the column has no value in this row.

var $db = Core\Db::connect('notes');
$db->execute('create table tables (name text not null, seats int)', []);
$db->execute(
    'insert into tables (name, seats) values (?, ?), (?, ?)',
    ['by the window', 4, 'on the terrace', null]
);

// The result is `null` when the column has no value in this row. The type you
// get back is `?int`, so you test it for `null` before you use it.
foreach ($db->query('select name, seats from tables order by name', []) as Core\Db\Row $row) {
    ?int $seats = $row->int('seats');
    if ($seats == null) {
        echo $row->string('name') ?? '', ': nobody counted the seats', "\n";
    } else {
        echo $row->string('name') ?? '', ': ', $seats, " seats\n";
    }
}

$db->close();
