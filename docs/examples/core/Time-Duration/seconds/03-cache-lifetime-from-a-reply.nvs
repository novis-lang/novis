<?nvs
// Turns the `max-age` value of a `Cache-Control` header into a duration, to know how long to keep a reply.

array<string> $headers = ['max-age=3600', 'max-age=86400', 'no-store'];

// `max-age` is a number of seconds. This prints 1h for 3600, 1d for 86400 and 0s for `no-store`.
foreach ($headers as string $header) {
    Core\Time\Duration $keep = 0s;
    // `Core\Str::afterPrefix` returns the text after `max-age=`. For `no-store`, the result is `null`.
    ?string $value = Core\Str::afterPrefix($header, 'max-age=');
    if ($value != null) {
        // `as ?int` converts the text to a whole number. If that is not possible, the result is `null`.
        ?int $count = $value as ?int;
        if ($count != null) {
            $keep = Core\Time\Duration::seconds($count);
        }
    }
    echo $keep->toString(), "\n";
}
