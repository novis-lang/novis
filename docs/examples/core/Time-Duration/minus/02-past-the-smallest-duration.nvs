<?nvs
// Shows what happens when a difference is too long for a duration.

Core\Time\Duration $smallest = Core\Time\Duration::nanoseconds(-9223372036854775807 - 1);

// Taking away a negative duration makes the result longer. This prints -9223372036854775807.
echo $smallest->minus(Core\Time\Duration::nanoseconds(-1))->toNanoseconds(), "\n";

// Nothing is smaller than the smallest duration. Taking away one more nanosecond throws a `RuntimeError`.
try {
    $smallest->minus(Core\Time\Duration::nanoseconds(1));
} catch (RuntimeError $e) {
    echo $e->message, "\n";
}
