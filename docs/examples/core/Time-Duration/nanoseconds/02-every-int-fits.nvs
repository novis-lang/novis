<?nvs
// Shows that every `int` is a valid number of nanoseconds, and where a duration stops.

// The largest `int` is about 292 years in nanoseconds.
// This prints its length in days, which is 106751.99115741.
Core\Time\Duration $longest = Core\Time\Duration::nanoseconds(9223372036854775807);
echo $longest->toSeconds() / 86400, "\n";

// The smallest `int` works too. This prints the number of nanoseconds unchanged.
echo Core\Time\Duration::nanoseconds(-9223372036854775807 - 1)->toNanoseconds(), "\n";

// A longer duration does not fit. Adding one more nanosecond throws a `RuntimeError`.
try {
    $longest->plus(Core\Time\Duration::nanoseconds(1));
} catch (RuntimeError $e) {
    echo $e->message, "\n";
}
