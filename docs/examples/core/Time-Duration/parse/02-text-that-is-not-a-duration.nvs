<?nvs
// Shows what happens when a text is not a valid duration.

array<string> $texts = ["45s", "1.5h", "30min", ""];

// `parse` throws a `ParseError` when the text is not valid. The message says what is wrong.
// Only "45s" is valid here.
foreach ($texts as string $text) {
    try {
        Core\Time\Duration $length = Core\Time\Duration::parse($text);
        echo '"', $text, '" is ', $length->toString(), "\n";
    } catch (ParseError $e) {
        echo '"', $text, '": ', $e->message, "\n";
    }
}
