<?nvs
// Computes when each meeting ends, from its start time and its length in minutes.

array<string> $starts = ["2024-06-10T09:00:00Z", "2024-06-10T11:30:00Z", "2024-06-10T15:45:00Z"];
array<int> $lengths = [45, 90, 20];

// The meetings end at 09:45, 13:00 and 16:05. This prints each end time in full.
int $i = 0;
while ($i < 3) {
    var $start = Core\Time::fromIso($starts[$i]);
    Core\Time\Duration $length = Core\Time\Duration::minutes($lengths[$i]);
    echo $start->plus($length)->toIso(), "\n";
    $i = $i + 1;
}
