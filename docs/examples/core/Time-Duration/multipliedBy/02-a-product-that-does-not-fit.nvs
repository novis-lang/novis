<?nvs
// Shows what happens when a product is too long for a duration.

// 106751 days is the largest number of whole days that fits. This prints 106751.
echo 1d->multipliedBy(106751)->toSeconds() / 86400, "\n";

// One more day does not fit, so `multipliedBy` throws a `RuntimeError`.
try {
    1d->multipliedBy(106752);
} catch (RuntimeError $e) {
    echo $e->message, "\n";
}
