<?nvs
// Shows how to read a UUID from its text and print it again.

// `Core\Uuid::parse` reads the text. Upper case letters are allowed.
var $id = Core\Uuid::parse("F9168C5E-CEB2-4FAA-B6BF-329BF39FA1E4");

// The text of a `Uuid` is always lower case.
// This prints f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4.
echo $id, "\n";
