<?nvs
// Shows how to compare two UUIDs that were written in different case.

string $fromForm = "f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4";
string $fromFile = "F9168C5E-CEB2-4FAA-B6BF-329BF39FA1E4";

// The two texts are not equal. This prints "different".
if ($fromForm == $fromFile) {
    echo "same\n";
} else {
    echo "different\n";
}

// `toString()` gives the same text for the same UUID. This prints "same".
string $a = Core\Uuid::parse($fromForm)->toString();
string $b = Core\Uuid::parse($fromFile)->toString();
if ($a == $b) {
    echo "same\n";
} else {
    echo "different\n";
}
