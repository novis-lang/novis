<?nvs
// Shows how to get the text of a UUID.

var $id = Core\Uuid::parse("F9168C5E-CEB2-4FAA-B6BF-329BF39FA1E4");
string $text = $id->toString();

// The text is always in lower case. This prints f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4.
echo $text, "\n";

// The text is always 36 characters long. This prints 36.
echo Core\Str::length($text), "\n";

// `echo` writes the same text when you give it the `Uuid` itself.
echo $id, "\n";
