<?nvs
// Shows how to read a text as a UUID when the text may not be one.

// The text is a UUID, so `Core\Uuid::tryParse` returns a `Uuid`.
// This prints f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4.
?Core\Uuid $id = Core\Uuid::tryParse("F9168C5E-CEB2-4FAA-B6BF-329BF39FA1E4");
echo $id?->toString() ?? "not a UUID", "\n";

// The text is not a UUID, so the result is `null`. This prints not a UUID.
?Core\Uuid $other = Core\Uuid::tryParse("order-1042");
echo $other?->toString() ?? "not a UUID", "\n";
