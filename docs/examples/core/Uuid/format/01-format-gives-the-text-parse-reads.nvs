<?nvs
// Shows that `format` returns the text that `Core\Uuid::parse` reads.

var $id = Core\Uuid::parse('F9168C5E-CEB2-4FAA-B6BF-329BF39FA1E4');

// The text is in lower case. This prints f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4.
string $text = $id->format();
echo $text, "\n";

// `format` and `toString` return the same text. This prints "same".
echo $text == $id->toString() ? 'same' : 'different', "\n";

// `parse` reads the text back to the same sixteen bytes. This prints "same UUID".
var $again = Core\Uuid::parse($text);
echo $again->toBytes() == $id->toBytes() ? 'same UUID' : 'different UUID', "\n";
