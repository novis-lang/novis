<?nvs
// Shows how a program compresses a large file: it adds one block at a time as
// it reads them, instead of building the whole file as one piece first.

bytes $log = Core\Str::repeat("2026-03-04 12:00:01 GET /orders 200\n", 400) as bytes;
int $size = Core\Bytes::length($log) as int;
int $block = 8192;

var $archive = Core\Compress::compressor(Core\Codec::Zstd);
int $at = 0;
while ($at < $size) {
    // The last block is shorter than the others, so take what is left.
    int $take = $size - $at;
    if ($take > $block) {
        $take = $block;
    }
    $archive->add(Core\Bytes::slice($log, $at, $take));
    $at = $at + $take;
}

echo 'the log is ', $size, " bytes\n";
echo 'the archive is ', Core\Bytes::length($archive->finish()), " bytes\n";
