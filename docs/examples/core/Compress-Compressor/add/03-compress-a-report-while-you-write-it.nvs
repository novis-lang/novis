<?nvs
// Shows how a program compresses a report while it writes it. Each line is
// added as soon as it is made, so the whole report is never one string.

var $archive = Core\Compress::compressor(Core\Compress::Codec::Zstd);
int $written = 0;
for (int $day = 1; $day <= 365; $day++) {
    string $line = "day {$day}: 120 orders, 3 returns\n";
    $archive->add($line);
    $written = $written + (Core\Bytes::length($line as bytes) as int);
}
bytes $frame = $archive->finish();

echo 'the report is ', $written, " bytes\n";
echo 'the archive is ', Core\Bytes::length($frame), " bytes\n";

// A file that already exists does not need a compressor. Pass the open file
// to `Core\Compress::compress`, and it reads the file one block at a time.
