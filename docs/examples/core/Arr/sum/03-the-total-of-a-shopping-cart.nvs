<?nvs
// Shows how to work out the total of a shopping cart. Every line has a price
// in cents and a quantity, and the lines are added up at the end.

array<array<int>> $cart = [
    ['price' => 1299, 'quantity' => 2],
    ['price' => 499, 'quantity' => 1],
    ['price' => 250, 'quantity' => 4],
];

// `Core\Arr::map` turns every line into what that line costs.
array<int> $lines = Core\Arr::map(
    $cart,
    fn(array<int> $line): int => $line['price'] * $line['quantity']
);

// This prints 4097.
echo 'total: ', Core\Arr::sum($lines), " cents\n";
