<?nvs
// Shows where the window opens and closes when a position is negative or lies
// outside the array.

array<string> $days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];

// A negative offset counts back from the last entry. This prints
// ["Thu","Fri"].
echo Core\Json::encode(Core\Arr::slice($days, -2, null)), "\n";

// A negative length stops that many entries short of the end. This prints
// ["Mon","Tue","Wed"].
echo Core\Json::encode(Core\Arr::slice($days, 0, -2)), "\n";

// An offset before the first entry opens at the first entry. This prints
// ["Mon","Tue"].
echo Core\Json::encode(Core\Arr::slice($days, -99, 2)), "\n";

// A window that starts after the last entry holds nothing. This prints [].
echo Core\Json::encode(Core\Arr::slice($days, 99, 2)), "\n";
