<?nvs
// Shows what `Core\Arr::first` returns for an array with no entries.

array<string> $waiting = [];

// The result is `null`, so this prints `nobody is waiting`.
?string $head = Core\Arr::first($waiting);
if ($head == null) {
    echo "nobody is waiting\n";
}

// `??` gives a value to use when the result is `null`. This prints `nobody`.
echo Core\Arr::first($waiting) ?? 'nobody', "\n";

// `$holding` has one entry, and its value is `null`. `Core\Arr::first` returns `null` here too.
// `Core\Arr::isEmpty` returns `false`, so this prints `one entry, and its value is null`.
array<?string> $holding = [null];
if (!Core\Arr::isEmpty($holding)) {
    echo "one entry, and its value is null\n";
}
