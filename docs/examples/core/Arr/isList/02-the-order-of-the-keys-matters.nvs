<?nvs
// Shows what makes an array stop being a list. The keys have to be 0, 1, 2
// and so on, and they have to be put in in that order.

array<string> $backwards = [];
$backwards[1] = "second";
$backwards[0] = "first";

// Both keys are there, but 1 was put in before 0. This prints no.
echo Core\Arr::isList($backwards) ? "yes" : "no", "\n";

array<string> $empty = [];

// An array with no entries at all is a list. This prints yes.
echo Core\Arr::isList($empty) ? "yes" : "no", "\n";
