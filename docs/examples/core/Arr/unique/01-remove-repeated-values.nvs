<?nvs
// Shows how to remove the values that appear more than once in a list.

array<string> $tags = ["news", "sport", "news", "weather", "sport"];

// The first entry with a value is kept, with the key it had. "news" keeps key
// 0 and "weather" keeps key 3, so the keys have gaps in them.
array<string> $once = Core\Arr::unique($tags);
echo Core\Json::encode($once), "\n";
