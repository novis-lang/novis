<?nvs
// Shows how the gate writes one error page when a route method throws an error.

use Core\Http\Method;
use Core\Router\Refusal;

class Reports
{
    #[Core\Route(path: '/reports/{year}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(uint $year): void
    {
        if ($year < 2000) {
            throw new RuntimeError('no report before 2000');
        }
        echo 'report for ', $year;
    }
}

class Gate implements Core\Router\Gate
{
    public function allows(Core\Router\Match $route): bool
    {
        return true;
    }

    public function refused(Refusal $reason, ?Core\Router\Match $route): void
    {
        echo 'no page here';
    }

    // `dispatch` has set the status to 500. `$error` is the error the method threw.
    // `is` checks which method the route belongs to, so the page can say which page failed.
    public function failed(?Core\Router\Match $route, ?Throwable $error): void
    {
        if ($route != null && $route->is(Reports::show)) {
            echo 'the report page failed';
        } else {
            echo 'a page failed';
        }
    }
}

if (Core\Env::context() == Core\Env::Context::Request) {
    Core\Router::dispatch(new Gate());
} else {
    // This prints `200 report for 2024`, then `500 the report page failed`.
    var $good = Core\Test::request(Method::Get, '/reports/2024');
    echo $good->status(), ' ', $good->body(), "\n";
    var $bad = Core\Test::request(Method::Get, '/reports/1999');
    echo $bad->status(), ' ', $bad->body(), "\n";
}
