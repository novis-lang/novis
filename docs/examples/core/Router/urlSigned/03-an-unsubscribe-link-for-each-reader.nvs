<?nvs
// Shows how to build an unsubscribe link for each reader of a newsletter.

class Newsletter {
    #[Core\Route(path: "/unsubscribe/{reader}", method: Core\Http\Method::Get, name: "Newsletter::unsubscribe")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function unsubscribe(uint $reader): string { return "you are unsubscribed"; }
}

// The first key signs new links. The second key is an older one.
// Links that were signed with it still work when you check them.
secret bytes $current = Core\Crypto::generateKey();
secret bytes $older = Core\Crypto::generateKey();
array<secret bytes> $keys = [$current, $older];

// The links work for 30 days. Nobody can change a reader number in a link,
// because the signature would not match any more.
Core\Time\Instant $until = Core\Time::now()->plus(720h);

array<uint> $readers = [3, 17, 42];
foreach ($readers as uint $reader) {
    string $link = Core\Router::urlSigned("Newsletter::unsubscribe", ["reader" => $reader], {keys: $keys, until: $until});
    string $path = Core\Router::url("Newsletter::unsubscribe", ["reader" => $reader]);
    // This prints `/unsubscribe/3: signed`, and the same for the other readers.
    echo $path, ": ", Core\Str::startsWith($link, $path . "?_sig=") ? "signed" : "not signed", "\n";
}
