<?nvs
// Shows how to make the link in a password reset email.

// The token goes into the link. The program also stores it, to compare it later.
string $token = Core\Random::token();
string $link = "https://example.com/reset?token=" . $token;

// The token is different on every run, so this prints only the length of the link: 96.
echo Core\Str::length($link), "\n";

// Hex is safe in a URL, so the link needs no extra encoding. This prints `same`.
echo Core\Uri::encodeComponent($token) == $token ? "same" : "changed", "\n";
