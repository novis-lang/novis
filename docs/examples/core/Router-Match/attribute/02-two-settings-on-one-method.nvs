<?nvs
// Shows how one route method can have two settings, and how to read each one by its name.

attribute Cache on method { seconds: int, shared: bool }
attribute RateLimit on method { perMinute: int }

class Search
{
    #[Core\Route(path: '/search', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    #[Cache(seconds: 30, shared: true)]
    #[RateLimit(perMinute: 20)]
    public function results(): string
    {
        return 'results';
    }
}

?Core\Router\Match $route = Core\Router::match(Core\Http\Method::Get, '/search');
if ($route != null) {
    // `attribute<Cache>` returns only the `Cache` attribute. This prints `cache: 30 seconds`.
    var $cache = $route->attribute<Cache>();
    if ($cache != null) {
        echo 'cache: ', $cache->seconds, " seconds\n";
    }

    // `attribute<RateLimit>` returns only the `RateLimit` attribute.
    // This prints `limit: 20 per minute`.
    var $limit = $route->attribute<RateLimit>();
    if ($limit != null) {
        echo 'limit: ', $limit->perMinute, " per minute\n";
    }
}
