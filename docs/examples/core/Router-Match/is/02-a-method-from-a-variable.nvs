<?nvs
// Shows `is` with a method that is in a variable, and a method with two routes.

class Feedback
{
    // One method has two routes: `GET` shows the form and `POST` sends it.
    #[Core\Route(path: '/feedback', method: Core\Http\Method::Get)]
    #[Core\Route(path: '/feedback', method: Core\Http\Method::Post)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function form(): string
    {
        return 'the form';
    }

    #[Core\Route(path: '/help', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function help(): string
    {
        return 'the help page';
    }
}

// A variable of type `callable` can contain a method. Nothing is called here.
callable $form = Feedback::form;
callable $help = Feedback::help;

?Core\Router\Match $sent = Core\Router::match(Core\Http\Method::Post, '/feedback');
if ($sent != null) {
    // The `POST` route also belongs to `form`. This prints `true`.
    echo $sent->is($form) ? 'true' : 'false', "\n";
    // The route does not belong to `help`. This prints `false`.
    echo $sent->is($help) ? 'true' : 'false', "\n";
}
