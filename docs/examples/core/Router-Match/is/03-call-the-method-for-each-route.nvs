<?nvs
// Shows how a program calls the method of the matched route itself, without `Core\Router::dispatch`.

class Shop
{
    #[Core\Route(path: '/', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function home(): string
    {
        return 'Welcome to the shop';
    }

    #[Core\Route(path: '/products/{id}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function product(uint $id): string
    {
        return 'Product number ' . ($id as string);
    }
}

// The request is `GET /products/7`.
?Core\Router\Match $matched = Core\Request::route();
if ($matched == null) {
    echo 'Page not found', "\n";
} else {
    var $shop = new Shop();
    // Each `is` checks one method. The first one that returns `true` is called.
    // This prints `Product number 7`.
    if ($matched->is(Shop::home)) {
        echo $shop->home(), "\n";
    } elseif ($matched->is(Shop::product)) {
        echo $shop->product($matched->param('id') as uint), "\n";
    } else {
        echo 'Page not found', "\n";
    }
}
