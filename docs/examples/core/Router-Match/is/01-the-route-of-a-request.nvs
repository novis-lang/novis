<?nvs
// Shows how to check which method the route of the current request belongs to.

class Articles
{
    #[Core\Route(path: '/articles', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function list(): string
    {
        return 'all articles';
    }

    #[Core\Route(path: '/articles/{id}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(uint $id): string
    {
        return 'one article';
    }
}

// The request is `GET /articles/42`. `Core\Request::route()` returns its match.
?Core\Router\Match $matched = Core\Request::route();
if ($matched != null) {
    // `Articles::show` is written without `()`, so nothing is called.
    // The route belongs to `show`, so this prints `true` and then `false`.
    echo $matched->is(Articles::show) ? 'true' : 'false', "\n";
    echo $matched->is(Articles::list) ? 'true' : 'false', "\n";
}
