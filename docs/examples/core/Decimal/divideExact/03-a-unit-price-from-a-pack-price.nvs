<?nvs
// Shows how to work out what one item in a pack costs. When the pack price does
// not divide evenly, there is no exact unit price.

array<decimal> $packPrice = ['tea' => 7.20, 'soap' => 4.50, 'rice' => 10.00];
array<decimal> $packSize = ['tea' => 8, 'soap' => 3, 'rice' => 3];

foreach ($packPrice as string $name => decimal $price) {
    try {
        decimal $each = Core\Decimal::divideExact($price, $packSize[$name]);
        echo $name, ': ', $each, " each\n";
    } catch (ArithmeticError $uneven) {
        // The unit price would have digits with no end. To get a rounded unit
        // price instead, use `Core\Decimal::divideRounded`.
        echo $name, ": no exact unit price\n";
    }
}
