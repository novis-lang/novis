<?nvs
// Shows what happens when a zone name is misspelled.

// A user typed this name into a form. "Europe/Berln" is not in the database,
// so `Core\Time\Zone::of` throws a `RuntimeError`.
string $typed = 'Europe/Berln';
try {
    Core\Time\Zone $zone = Core\Time\Zone::of($typed);
    echo 'found the zone', "\n";
} catch (RuntimeError $e) {
    // This prints the error message. It contains the name that was not found.
    echo $e->message, "\n";
}
