<?nvs
// Shows one meeting time in Berlin as the clock time in three cities.

// 'Europe/Berlin' is written in quotes, so it is checked while compiling.
Core\Time\DateTime $meeting = Core\Time\DateTime::fromIso('2024-06-01 14:00', 'Europe/Berlin');
Core\Time\Instant $start = $meeting->toInstant();

// These names are in a list, so `Core\Time\Zone::of` finds each zone while the program runs.
// This prints 14:00, 08:00 and 21:00.
array<string> $cities = ['Europe/Berlin', 'America/New_York', 'Asia/Tokyo'];
foreach ($cities as string $name) {
    Core\Time\Zone $zone = Core\Time\Zone::of($name);
    echo $name, ': ', $start->in($zone)->format('HH:mm'), "\n";
}
