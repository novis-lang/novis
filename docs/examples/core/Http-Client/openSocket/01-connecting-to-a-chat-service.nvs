<?nvs
// Shows how to open a WebSocket to another server, and what happens when the
// address is inside your own network.

// `Core\Http\Client::openSocket` opens the connection and returns a `Core\Http\Socket`.
// 10.0.0.7 is a private address, so the call throws a `RuntimeError` before it connects.
try {
    Core\Http\Socket $socket = Core\Http\Client::openSocket("wss://10.0.0.7/chat");
    $socket->send("hello");
    var $reply = $socket->receive();
    echo "reply: ", $reply?->text() ?? "-", "\n";
    $socket->close();
} catch (RuntimeError $refused) {
    echo $refused->message, "\n";
}
