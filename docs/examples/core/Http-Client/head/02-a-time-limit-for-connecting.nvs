<?nvs
// Shows the option that limits how long a `HEAD` request may wait for the
// connection to the server.

// `connectTimeout` is the most time the connection may take. It must be longer
// than zero, so this call throws a `RuntimeError`.
try {
    var $quick = Core\Http\Client::head("https://203.0.113.10/report.pdf", {connectTimeout: 0s});
} catch (RuntimeError $tooShort) {
    echo $tooShort->message, "\n";
}
