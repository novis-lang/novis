<?nvs
// Shows how to open a directory at an address the program chooses.
// `Core\Ldap::open` needs the `ldap.open` capability for the host in the URL.
// No directory server runs at this address, so the call throws a `Core\Ldap\LdapError`.

try {
    var $directory = Core\Ldap::open({
        url: "ldaps://127.0.0.1:1",
        user: "CN=Reader,CN=Users,DC=example,DC=test",
        password: "Example-Pw1",
        timeout: Core\Time\Duration::seconds(5),
    });
    echo "Logged in as ", $directory->whoami(), "\n";
} catch (Core\Ldap\LdapError $error) {
    echo "The directory did not answer.\n";
}
