<?nvs
// Shows what happens when the old password is wrong.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp-accounts');
string $unit = 'OU=Changing Staff 2,DC=example,DC=test';
string $user = 'CN=Ivo Lang,' . $unit;

// A run that stopped early can leave the account behind, so the program deletes it first.
array<string> $leftovers = [$user, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $missing) {
    }
}
$corp->add($unit, ['objectClass' => 'organizationalUnit']);
$corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'ivo.lang']);
// `pwdLastSet` 0 means the user must change the password now.
$corp->setPassword($user, 'First-Pass-of-Ivo-1');
$corp->modify($user, [
    Core\Ldap\Change::replace('userAccountControl', 512),
    Core\Ldap\Change::replace('pwdLastSet', 0),
]);

// The old password is wrong, so `changePassword` throws an error.
// This prints `not changed`.
try {
    $corp->changePassword($user, 'Not-the-Pass-of-Ivo-1', 'Second-Pass-of-Ivo-2');
    echo 'changed', "\n";
} catch (Core\Ldap\LdapError $error) {
    echo 'not changed', "\n";
}

// The correct old password works. This prints `changed`.
$corp->changePassword($user, 'First-Pass-of-Ivo-1', 'Second-Pass-of-Ivo-2');
echo 'changed', "\n";

$corp->delete($user);
$corp->delete($unit);
