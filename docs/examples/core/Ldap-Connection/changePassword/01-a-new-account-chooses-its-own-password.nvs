<?nvs
// Shows how a new user replaces the first password the administrator gave them.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp-accounts');
string $unit = 'OU=Changing Staff 1,DC=example,DC=test';
string $user = 'CN=Jana Pohl,' . $unit;

// A run that stopped early can leave the account behind, so the program deletes it first.
array<string> $leftovers = [$user, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $missing) {
    }
}
$corp->add($unit, ['objectClass' => 'organizationalUnit']);
$corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'jana.pohl']);

// The administrator gives a first password. `pwdLastSet` 0 means
// the user must change it at the next login.
$corp->setPassword($user, 'Given-Pass-of-Jana-1');
$corp->modify($user, [
    Core\Ldap\Change::replace('userAccountControl', 512),
    Core\Ldap\Change::replace('pwdLastSet', 0),
]);

// The first login fails. This prints `MustChangePassword`.
try {
    $corp->authenticate($user, 'Given-Pass-of-Jana-1');
} catch (Core\Ldap\LdapError $error) {
    echo $error->kind == Core\Ldap\LdapError::Kind::MustChangePassword ? 'MustChangePassword' : 'another reason', "\n";
}

// The user chooses a password of their own. Then this prints `login works`.
$corp->changePassword($user, 'Given-Pass-of-Jana-1', 'Own-Pass-of-Jana-2');
$corp->authenticate($user, 'Own-Pass-of-Jana-2');
echo 'login works', "\n";

$corp->delete($user);
$corp->delete($unit);
