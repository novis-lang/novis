<?nvs
// Shows that a password set a moment ago cannot be changed again at once.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp-accounts');
string $unit = 'OU=Changing Staff 3,DC=example,DC=test';
string $user = 'CN=Hana Sato,' . $unit;

// A run that stopped early can leave the account behind, so the program deletes it first.
array<string> $leftovers = [$user, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $missing) {
    }
}
$corp->add($unit, ['objectClass' => 'organizationalUnit']);
$corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'hana.sato']);
$corp->setPassword($user, 'First-Pass-of-Hana-1');
$corp->modify($user, [Core\Ldap\Change::replace('userAccountControl', 512)]);

// This domain has a minimum password age of one day.
// So `changePassword` throws an error, and `$kind` is `PasswordPolicy`.
try {
    $corp->changePassword($user, 'First-Pass-of-Hana-1', 'Second-Pass-of-Hana-2');
    echo 'changed', "\n";
} catch (Core\Ldap\LdapError $error) {
    echo $error->kind == Core\Ldap\LdapError::Kind::PasswordPolicy ? 'PasswordPolicy' : 'another reason', "\n";
}

// The first password still works, so this prints `login works`.
$corp->authenticate($user, 'First-Pass-of-Hana-1');
echo 'login works', "\n";

$corp->delete($user);
$corp->delete($unit);
