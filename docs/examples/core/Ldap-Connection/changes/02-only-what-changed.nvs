<?nvs
// Shows how a second call with the cookie returns only the entries that changed.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $sales = Core\Ldap\Filter::all(
    Core\Ldap\Filter::equals('objectClass', 'user'),
    Core\Ldap\Filter::equals('department', 'Sales'),
);

// The first call reads every person in Sales. The loop reads them all, so the cookie is complete.
var $first = $corp->changes($sales, { select: ['department'] });
foreach ($first as Core\Ldap\Entry $person) {
}

// Nothing changed since the first call, so this prints `changed: 0`.
var $next = $corp->changes($sales, { select: ['department'], cookie: $first->cookie() });
uint $changed = 0;
foreach ($next as Core\Ldap\Entry $person) {
    $changed = $changed + 1;
}
echo 'changed: ', $changed, "\n";
