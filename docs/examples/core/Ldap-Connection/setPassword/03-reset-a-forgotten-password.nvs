<?nvs
// Shows how a help desk resets a forgotten password, so the user must choose a new one.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp-accounts');
string $unit = 'OU=New Staff 3,DC=example,DC=test';
string $user = 'CN=Gina Hart,' . $unit;

// A run that stopped early can leave the account behind, so the program deletes it first.
array<string> $leftovers = [$user, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $missing) {
    }
}
$corp->add($unit, ['objectClass' => 'organizationalUnit']);
$corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'gina.hart']);
$corp->setPassword($user, 'Forgotten-Pass-5');
$corp->modify($user, [Core\Ldap\Change::replace('userAccountControl', 512)]);

// The help desk sets a temporary password. `pwdLastSet` 0 means
// the user must change it at the next login.
$corp->setPassword($user, 'Temporary-Pass-6');
$corp->modify($user, [Core\Ldap\Change::replace('pwdLastSet', 0)]);

// The old password no longer works. This prints `InvalidCredentials`.
try {
    $corp->authenticate($user, 'Forgotten-Pass-5');
} catch (Core\Ldap\LdapError $error) {
    echo $error->kind == Core\Ldap\LdapError::Kind::InvalidCredentials ? 'InvalidCredentials' : 'another reason', "\n";
}

// The temporary password is correct, but the user must change it first.
// This prints `MustChangePassword`.
try {
    $corp->authenticate($user, 'Temporary-Pass-6');
} catch (Core\Ldap\LdapError $error) {
    echo $error->kind == Core\Ldap\LdapError::Kind::MustChangePassword ? 'MustChangePassword' : 'another reason', "\n";
}

$corp->delete($user);
$corp->delete($unit);
