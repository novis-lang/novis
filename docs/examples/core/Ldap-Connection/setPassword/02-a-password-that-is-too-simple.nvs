<?nvs
// Shows what happens when the domain does not accept a new password.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp-accounts');
string $unit = 'OU=New Staff 2,DC=example,DC=test';
string $user = 'CN=Finn Wolf,' . $unit;

// A run that stopped early can leave the account behind, so the program deletes it first.
array<string> $leftovers = [$user, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $missing) {
    }
}
$corp->add($unit, ['objectClass' => 'organizationalUnit']);
$corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'finn.wolf']);

// The domain needs longer passwords with several kinds of characters.
// So `setPassword` throws an error, and `$kind` is `PasswordPolicy`.
try {
    $corp->setPassword($user, 'abc');
    echo 'the password was set', "\n";
} catch (Core\Ldap\LdapError $error) {
    echo $error->kind == Core\Ldap\LdapError::Kind::PasswordPolicy ? 'PasswordPolicy' : 'another reason', "\n";
}

// A stronger password works. This prints `the password was set`.
$corp->setPassword($user, 'Strong-enough-Pass-9');
echo 'the password was set', "\n";

$corp->delete($user);
$corp->delete($unit);
