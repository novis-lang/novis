<?nvs
// Shows how to give a new user account its first password, so the person can log in.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp-accounts');
string $unit = 'OU=New Staff 1,DC=example,DC=test';
string $user = 'CN=Eva Roth,' . $unit;

// A run that stopped early can leave the account behind, so the program deletes it first.
array<string> $leftovers = [$user, $unit];
foreach ($leftovers as string $left) {
    try {
        $corp->delete($left);
    } catch (Core\Ldap\LdapError $missing) {
    }
}
$corp->add($unit, ['objectClass' => 'organizationalUnit']);
$corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'eva.roth']);

// The account gets its first password. The value 512 then turns the account on.
$corp->setPassword($user, 'Welcome-to-work-4');
$corp->modify($user, [Core\Ldap\Change::replace('userAccountControl', 512)]);

// `authenticate` throws an error when the password is wrong. This prints `login works`.
$corp->authenticate($user, 'Welcome-to-work-4');
echo 'login works', "\n";

$corp->delete($user);
$corp->delete($unit);
