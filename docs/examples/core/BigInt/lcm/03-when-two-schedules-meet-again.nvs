<?nvs
// Shows when two repeating jobs run at the same moment again. Each period is a
// number of microseconds, and the answer is far too large for an `int`.

var $firstJob = Core\BigInt::parse("123456789012345678901");
var $secondJob = Core\BigInt::parse("987654321098765432109");

// The two jobs meet after the least common multiple of their periods. This
// prints 121932631137021795225845145533336229232209.
var $meeting = $firstJob->lcm($secondJob);
echo $meeting, "\n";

// Both periods divide that moment exactly, so the remainder is 0 for each of
// them. This prints 0 0.
echo $meeting->mod($firstJob), " ", $meeting->mod($secondJob), "\n";
