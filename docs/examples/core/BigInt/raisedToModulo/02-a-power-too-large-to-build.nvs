<?nvs
// Shows how `raisedToModulo` gives the remainder of a power that is far too large to hold.

// For a small power, `raisedToModulo` and `raisedTo` with `remainder` give the same answer. This
// prints 445 twice.
echo Core\BigInt::of(4)->raisedToModulo(Core\BigInt::of(13), Core\BigInt::of(497)), "\n";
echo Core\BigInt::of(4)->raisedTo(13)->remainder(Core\BigInt::of(497)), "\n";

// 7 to the power 1000000 is a number of 845099 digits. `raisedTo` throws an
// error for a number that wide, and this prints the message.
try {
    Core\BigInt::of(7)->raisedTo(1000000);
} catch (ArithmeticError $tooWide) {
    echo $tooWide->message, "\n";
}

// `raisedToModulo` gives the remainder of that same power at once, and never holds the
// whole number. This prints 880007888.
echo Core\BigInt::of(7)->raisedToModulo(
    Core\BigInt::of(1000000),
    Core\BigInt::of(1000000007),
), "\n";
