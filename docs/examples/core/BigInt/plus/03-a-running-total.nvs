<?nvs
// Shows a running total that grows too large for an `int`. Three jobs report the
// number of bytes they wrote as text, and the program adds them up.

array<string> $written = [
    '8070450532247928832',
    '8070450532247928832',
    '1152921504606846976',
];

var $total = Core\BigInt::of(0);
foreach ($written as string $bytes) {
    // Each report is read as a number and added to the total so far. `plus`
    // returns the new total, so the result is kept in `$total`.
    $total = $total->plus(Core\BigInt::parse($bytes));
}

// The three numbers together are larger than an `int`. This prints
// 17293822569102704640.
echo $total, "\n";
