<?nvs
// Shows how to add two numbers, and that `plus` returns a new number instead of
// changing the one you called it on.

var $first = Core\BigInt::of(120);
var $second = Core\BigInt::of(23);

// This prints 143.
echo $first->plus($second), "\n";

// `$first` still has the same value. This prints 120.
echo $first, "\n";

// Adding a negative number takes it away. This prints 97.
echo $first->plus(Core\BigInt::of(-23)), "\n";
