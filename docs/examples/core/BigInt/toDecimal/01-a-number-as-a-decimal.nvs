<?nvs
// Shows how to convert a `Core\BigInt` to a `decimal`.

// `toDecimal` returns the `decimal` equal to this number. This prints 42.
echo Core\BigInt::of(42)->toDecimal(), "\n";

// The sign is kept, and zero is zero. This prints -7 and then 0.
echo Core\BigInt::of(-7)->toDecimal(), "\n";
echo Core\BigInt::of(0)->toDecimal(), "\n";

// The result is a `decimal`, so arithmetic with it is exact. This prints
// 42.25.
decimal $value = Core\BigInt::of(42)->toDecimal();
echo $value + (0.25 as decimal), "\n";

// A `decimal` reaches much further than an `int` does. This prints
// 79228162514264337593543950335, the largest number it holds.
echo Core\BigInt::parse("79228162514264337593543950335")->toDecimal(), "\n";
