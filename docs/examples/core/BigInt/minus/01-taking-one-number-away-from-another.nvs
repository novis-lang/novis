<?nvs
// Shows how to take one number away from another. `minus` returns a new number
// and leaves the one you called it on as it was.

var $stock = Core\BigInt::of(1000);
var $sold = Core\BigInt::of(325);

// This prints 675.
echo $stock->minus($sold), "\n";

// `$stock` still has the same value. This prints 1000.
echo $stock, "\n";

// When the second number is the larger one, the result is negative. This
// prints -675.
echo $sold->minus($stock), "\n";
