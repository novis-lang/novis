<?nvs
// Shows how to shift a whole number to the right. Each place you shift by halves it.

// `shiftedRight` moves the bits 1 place to the right, which halves the number. This
// prints 3.
echo Core\BigInt::of(6)->shiftedRight(1), "\n";

// The bits that fall off the right end are gone, so 7 halved is 3. These two
// lines print 3 and 1.
echo Core\BigInt::of(7)->shiftedRight(1), "\n";
echo Core\BigInt::of(255)->shiftedRight(7), "\n";

// Shifting by 0 places gives the number back. This prints 9.
echo Core\BigInt::of(9)->shiftedRight(0), "\n";

// A number far larger than an `int` can store is shifted the same way. This
// prints 1.
echo Core\BigInt::of(1)->shiftedLeft(64)->shiftedRight(64), "\n";
