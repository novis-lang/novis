<?nvs
// Shows the three answers `sign` gives.

// `sign` returns -1 below zero, 0 at zero, and 1 above zero. This prints -1,
// 0 and 1.
echo Core\BigInt::of(-42)->sign(), "\n";
echo Core\BigInt::of(0)->sign(), "\n";
echo Core\BigInt::of(42)->sign(), "\n";

// A number far larger than an `int` holds has a sign like any other. This
// prints 1 and -1.
echo Core\BigInt::of(1)->shl(200)->sign(), "\n";
echo Core\BigInt::of(-1)->shl(200)->sign(), "\n";
