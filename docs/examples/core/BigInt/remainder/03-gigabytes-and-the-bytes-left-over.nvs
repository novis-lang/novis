<?nvs
// Shows a number of bytes that is too large for an `int`, as whole gigabytes
// and the bytes that are left over.

var $perGigabyte = Core\BigInt::parse('1073741824');
var $written = Core\BigInt::parse('98765432109876543210');

// `dividedBy` gives the whole gigabytes and `remainder` gives the rest. Put together, the
// two are the number you started with.
echo $written->dividedBy($perGigabyte), ' GB and ', $written->remainder($perGigabyte), " bytes\n";
