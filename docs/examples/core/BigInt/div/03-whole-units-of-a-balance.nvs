<?nvs
// Shows how to report a balance that is stored in its smallest unit. One coin
// is 1000000000000000000 of those units, which is more than an `int` holds.

var $perCoin = Core\BigInt::parse("1000000000000000000");
array<string> $balances = [
    "25000000000000000000",
    "999999999999999999",
    "7500000000000000000",
];

foreach ($balances as string $raw) {
    // `div` gives the number of whole coins. Less than one coin is left out, so
    // the three lines print 25, 0 and 7.
    echo Core\BigInt::parse($raw)->div($perCoin), " whole coins\n";
}
