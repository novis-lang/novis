<?nvs
// Shows two programs agreeing on a secret without ever sending it, which is
// what a Diffie-Hellman key exchange does. Each side raises a shared number to
// its own private number, modulo a shared prime, and sends only the result.

// The prime and the base are public. Both sides know them before they start.
// A real exchange uses a prime of about 600 digits.
var $prime = Core\BigInt::parse("170141183460469231731687303715884105727");
var $base = Core\BigInt::of(5);

// Each side keeps its own number secret.
var $mySecret = Core\BigInt::parse("94823749283749283749283749283749");
var $theirSecret = Core\BigInt::parse("38472938472938472938472938472938");

// Each side sends this, and it says nothing about the secret behind it.
var $mine = $base->powMod($mySecret, $prime);
var $theirs = $base->powMod($theirSecret, $prime);

// Each side now raises what it received to its own secret. The two results are
// the same number, and it was never sent. This prints the shared secret twice.
echo $theirs->powMod($mySecret, $prime), "\n";
echo $mine->powMod($theirSecret, $prime), "\n";
