<?nvs
// Shows what `gcd` gives when one of the two numbers is zero.

var $value = Core\BigInt::of(42);
var $zero = Core\BigInt::of(0);

// Every number divides zero exactly, so the result is the other number.
// This prints 42.
echo $value->gcd($zero), "\n";

// Two zeroes have no largest common divisor. The result is 0.
echo $zero->gcd($zero), "\n";
