<?nvs
// Shows the three answers `compareTo` gives.

var $smaller = Core\BigInt::parse("99999999999999999999");
var $larger = Core\BigInt::parse("100000000000000000000");

// The number you call it on is the smaller one, so this prints -1.
echo $smaller->compareTo($larger), "\n";

// The other way round, so this prints 1.
echo $larger->compareTo($smaller), "\n";

// The two numbers are equal, so this prints 0.
echo $smaller->compareTo(Core\BigInt::parse("99999999999999999999")), "\n";

// A negative number is the smaller one however many digits it has. This
// prints -1.
echo $larger->neg()->compareTo(Core\BigInt::of(0)), "\n";
