<?nvs
// Shows how to read the TLS version of the connection a reply came over.

// `Core\Test::tlsSession` builds a TLS connection for a test, so the example runs
// without a network. `Core\Test::answerHttp` gives a fixed reply that reports it.
var $session = Core\Test::tlsSession({version: "TLSv1.3"});
Core\Test::answerHttp("https://api.example.com/health", 200, {body: "ok", tls: $session});

Core\Http\Response $response = Core\Http\Client::get("https://api.example.com/health");

// `tls()` is `null` for a reply that did not come over TLS, so the program checks first.
// `version()` returns the version as a string. This prints `TLSv1.3`.
?Core\Http\TlsInfo $info = $response->tls();
if ($info != null) {
    echo $info->version(), "\n";
}
