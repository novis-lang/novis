<?nvs
// Shows a check that accepts a connection only when it uses TLS 1.3.

class Policy {
    // Returns `true` when the connection uses TLS 1.3, the newest version.
    public static function isModern(Core\Http\TlsInfo $info): bool {
        return $info->version() == "TLSv1.3";
    }
}

// Two TLS connections built for a test: one with TLS 1.3 and one with TLS 1.2.
array<Core\Http\TlsInfo> $sessions = [
    Core\Test::tlsSession({version: "TLSv1.3"}),
    Core\Test::tlsSession({version: "TLSv1.2"}),
];

// This prints `TLSv1.3 accepted` and then `TLSv1.2 too old`.
foreach ($sessions as Core\Http\TlsInfo $info) {
    if (Policy::isModern($info)) {
        echo $info->version(), " accepted\n";
    } else {
        echo $info->version(), " too old\n";
    }
}
