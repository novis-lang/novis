<?nvs
// Shows how to read the name in the certificate of the server that sent a reply.

// `Core\Test::tlsSession` builds a TLS connection for a test, so the example runs
// without a network. `Core\Test::answerHttp` gives a fixed reply that reports it.
var $session = Core\Test::tlsSession({subject: "CN=api.example.com, O=Shop"});
Core\Test::answerHttp("https://api.example.com/health", 200, {tls: $session});

?Core\Http\TlsInfo $info = Core\Http\Client::get("https://api.example.com/health")->tls();

// `subject()` returns the name as `KEY=value` pairs. `CN` is the server name and
// `O` is the organization. This prints `CN=api.example.com, O=Shop`.
if ($info != null) {
    echo $info->subject(), "\n";
}
