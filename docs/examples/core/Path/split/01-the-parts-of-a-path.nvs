<?nvs
// Shows how to split a path into its folders and its file name with `Core\Path::split`.

// This prints `srv`, `shop`, `invoices` and `invoice-1042.pdf`, one per line.
foreach (Core\Path::split("srv/shop/invoices/invoice-1042.pdf") as string $part) {
    echo $part, "\n";
}

// `/` and `\` are both separators, and a repeated one adds nothing.
// This prints `3`.
echo Core\Arr::count(Core\Path::split("logs\\2026//app.log")), "\n";
