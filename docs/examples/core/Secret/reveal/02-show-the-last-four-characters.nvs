<?nvs
// Shows how to display only the end of a secret key, as a settings page does.

secret string $apiKey = "sk_live_51Hx8QeZr2";

// The reason can be a variable. It is not part of the result.
string $why = "the settings page shows the last four characters";
string $key = Core\Secret::reveal($apiKey, $why);

// `Core\Str::slice` with -4 returns the last four characters.
// This prints "Your key ends in eZr2" and "It is 18 characters long".
echo "Your key ends in ", Core\Str::slice($key, -4), "\n";
echo "It is ", Core\Str::length($key), " characters long\n";
