<?nvs
// Shows how to put a secret token into the headers of a web request to another service.

class PaymentClient {
    public static function headers(secret string $token): array<string> {
        // The token is revealed here and nowhere else in the program.
        string $plain = Core\Secret::reveal($token, "the payment service needs the token in its header");
        return [
            "Authorization: Bearer " . $plain,
            "Accept: application/json",
        ];
    }
}

secret string $token = "pay_9fK2mQ7xR1";

// This prints each header. The first line is "Authorization: Bearer pay_9fK2mQ7xR1".
foreach (PaymentClient::headers($token) as string $header) {
    echo $header, "\n";
}
