<?nvs
// Shows how to print a secret token one time, on the line that needs it.

secret string $token = "tok_7Hq2Lm9Xa4Rb";

// `echo $token` does not compile, because `$token` is `secret`.
// `Core\Secret::reveal` returns the text as a plain `string`.
string $shown = Core\Secret::reveal($token, "the user must copy the new token now");

// This prints the token: tok_7Hq2Lm9Xa4Rb
echo "Your new token: ", $shown, "\n";
echo "Copy it now. It is not shown again.\n";
