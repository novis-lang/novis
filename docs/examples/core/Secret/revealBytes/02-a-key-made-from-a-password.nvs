<?nvs
// Shows how to turn a key made from a password into hex text.

secret string $password = "correct horse battery staple";
bytes $salt = Core\Bytes::fill(16, 7);

// `Core\Crypto::deriveKey` makes a key from a password and a salt.
// The same password and salt always give the same key.
secret bytes $key = Core\Crypto::deriveKey($password, $salt, 100000);

// `Core\Encoding::toHex` writes each byte as two hex digits.
// This prints 64 hex digits, one pair for each of the 32 bytes.
bytes $raw = Core\Secret::revealBytes($key, "the key is compared with the one on the server");
echo Core\Encoding::toHex($raw), "\n";
