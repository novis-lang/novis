<?nvs
// Shows how to write a new encryption key into a line for a configuration file.

secret bytes $key = Core\Crypto::generateKey();

// Base64 turns the 32 bytes into text that fits on one line.
bytes $raw = Core\Secret::revealBytes($key, "the setup command writes the key to the config file");
string $line = "APP_KEY=" . Core\Encoding::toBase64($raw);

// The key is new every time, so this prints only the parts that stay the same.
// This prints "APP_KEY=" and then 52, the length of the whole line.
echo Core\Str::slice($line, 0, 8), "\n";
echo Core\Str::length($line), "\n";
