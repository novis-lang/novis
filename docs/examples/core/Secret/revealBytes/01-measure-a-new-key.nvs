<?nvs
// Shows how to check the length of a new encryption key.

// `Core\Crypto::generateKey` returns a new random key as `secret bytes`.
secret bytes $key = Core\Crypto::generateKey();

// `Core\Secret::revealBytes` returns the same bytes as plain `bytes`.
bytes $raw = Core\Secret::revealBytes($key, "the setup check measures the key");

// A key is 32 bytes, so this prints 32.
echo Core\Bytes::length($raw), "\n";
