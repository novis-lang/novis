<?nvs
// Shows how to get the public half of a pair, and the two ways to write it out.

Core\Crypto\KeyPair $pair = Core\Crypto\KeyPair::read(
    Core\Encoding::fromHex("302e020100300506032b65700422042036e7913c75ff5d89ba4f46526320f547cf75369a560a168f6ab5bb178fbeaadf"),
    Core\Crypto\KeyKind::Ed25519
);
Core\Crypto\PublicKey $half = $pair->publicKey();

// `Raw` is the key itself, and nothing else. It is the shortest form.
echo Core\Encoding::toHex($half->write(Core\Crypto\KeyFormat::Raw)), "\n";

// `Spki` is the same key with a header saying which kind it is. Most other
// programs expect this form.
echo Core\Encoding::toHex($half->write(Core\Crypto\KeyFormat::Spki)), "\n";

// The public half is worked out from the private key, so one file always gives
// you the same public key.
Core\Crypto\KeyPair $again = Core\Crypto\KeyPair::read(
    Core\Encoding::fromHex("302e020100300506032b65700422042036e7913c75ff5d89ba4f46526320f547cf75369a560a168f6ab5bb178fbeaadf"),
    Core\Crypto\KeyKind::Ed25519
);
echo "the same key every time: ",
    ($again->publicKey()->write(Core\Crypto\KeyFormat::Raw)
        == $half->write(Core\Crypto\KeyFormat::Raw) ? "yes" : "no"),
    "\n";
