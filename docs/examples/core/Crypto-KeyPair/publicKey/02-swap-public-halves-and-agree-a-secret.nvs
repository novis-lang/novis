<?nvs
// Shows two programs agreeing one shared secret. Each one sends its public half
// and keeps its private half. Here both sides run in one file.

Core\Crypto\KeyPair $mine = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519);
Core\Crypto\KeyPair $theirs = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519);

// This is what travels over the network. The private halves never leave.
bytes $iSend = $mine->publicKey()->write(Core\Crypto\KeyFormat::Raw);
bytes $theySend = $theirs->publicKey()->write(Core\Crypto\KeyFormat::Raw);

// Each side agrees with its own private half and the half it received.
secret bytes $ours = Core\Crypto::agree(
    $mine,
    Core\Crypto\PublicKey::read($theySend, Core\Crypto\KeyKind::X25519, Core\Crypto\KeyFormat::Raw)
);
secret bytes $theirsAgreed = Core\Crypto::agree(
    $theirs,
    Core\Crypto\PublicKey::read($iSend, Core\Crypto\KeyKind::X25519, Core\Crypto\KeyFormat::Raw)
);

// Both sides now hold the same secret, and nobody who watched the network has
// it.
echo "both sides agreed the same secret: ",
    ($ours == $theirsAgreed ? "yes" : "no"),
    "\n";
