<?nvs
// Shows what happens when the secret is shorter than 16 bytes.

secret bytes $short = Core\Random::bytes(8);

// A secret of 8 bytes is too easy to guess, so `code` throws a `LogicError`.
try {
    echo Core\Totp::code($short), "\n";
} catch (LogicError $e) {
    echo "The secret is too short.\n";
}

// A secret of 20 bytes is long enough. This prints 6.
echo Core\Str::length(Core\Totp::code(Core\Random::bytes(20))), "\n";
