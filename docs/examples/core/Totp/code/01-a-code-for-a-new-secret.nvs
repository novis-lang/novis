<?nvs
// Shows how to make a secret for a new account and read its current code.

// `Core\Random::bytes(20)` makes a secret of 20 random bytes.
secret bytes $secret = Core\Random::bytes(20);
string $code = Core\Totp::code($secret);

// The code changes every 30 seconds, but it always has six characters.
// This prints 6.
echo Core\Str::length($code), "\n";
