<?nvs
// Shows how to read a group of each match inside the function.

string $prices = "Price: 12 USD, shipping: 3 USD";

// `(\d+) USD` matches an amount, and group 1 is the number. The function puts
// a `$` sign before the number. This prints "Price: $12, shipping: $3".
echo Core\Regex::replaceWith($prices, '(\d+) USD', fn(Core\Regex\Match $m) => '$' . ($m->group(1) ?? '')), "\n";

// The text that the function returns is inserted exactly as it is.
// `$1` is not a group here, so this prints "Price: $1, shipping: $1".
echo Core\Regex::replaceWith($prices, '(\d+) USD', fn(Core\Regex\Match $m) => '$1'), "\n";
