<?nvs
// Shows how to get the moment that is a fixed amount of time before another one.

Core\Time\Instant $meeting = Core\Time::fromIso("2024-03-01T14:00:00Z");

// This prints 2024-03-01T12:30:00Z.
echo $meeting->minus(1h30m)->toIso(), "\n";

// `minus` returns a new instant. `$meeting` does not change, so this prints 2024-03-01T14:00:00Z.
echo $meeting->toIso(), "\n";
