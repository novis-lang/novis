<?nvs
// Shows how to test whether two timestamps written in different time zones are the same moment.

Core\Time\Instant $london = Core\Time\Instant::fromIso('2024-03-01T12:00:00Z');
Core\Time\Instant $vienna = Core\Time\Instant::fromIso('2024-03-01T13:00:00+01:00');

// `==` compares the moment. Both texts name the same moment, so this prints "same".
echo $london == $vienna ? 'same' : 'different', "\n";

// `compareTo` returns 0 for the same moment. This prints 0.
echo $london->compareTo($vienna), "\n";

// `<` uses `compareTo` too. This prints "no".
echo $london < $vienna ? 'yes' : 'no', "\n";
