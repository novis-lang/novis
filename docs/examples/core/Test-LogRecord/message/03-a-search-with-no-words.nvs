<?nvs
// Shows how to test the message of a record that a request wrote.
// proof: test

use Core\Http\Method;
use Core\Test;

class SearchTest
{
    // A search with an empty `q` writes one record. A search with words writes none.
    #[Test]
    public function anEmptySearchIsLogged(): void
    {
        Test::request(Method::Get, '/search?q=');
        Test::request(Method::Get, '/search?q=lamp');

        Test::assertCount(Test::logs(), 1);
        Test::assertSame(Test::logs()[0]->message(), 'search without words');
    }
}

// `Core\Test::request` runs this file again for each request.
// This part writes a record when the search has no words.
if (Core\Env::context() == Core\Env::Context::Request) {
    tainted string $words = Core\Request::queryParameter('q') ?? '';
    if ($words == '') {
        Core\Log::write(Core\Log::Level::Info, 'search without words');
        Core\Response::setStatus(400);
    } else {
        echo 'results for ', $words;
    }
}
