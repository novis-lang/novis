<?nvs
// Shows how a script reads the value that it was started with. This script
// passes "Ada" with `args:`, and the child reads it with `Core\Script::args()`.

// The path starts at the folder of this file.
// `output: "capture"` keeps what the child prints, so this script can print it.
var $child = spawn script "scripts/greet.nvs" with(args: "Ada", output: "capture");
var $result = await $child;

// This prints "Hello, Ada!".
echo $result->output;
