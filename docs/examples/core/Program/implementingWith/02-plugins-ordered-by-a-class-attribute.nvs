<?nvs
// Shows how to read an attribute that is on the class itself: the member name
// is left out. A class without the attribute gets `null`, so a default is easy.

type Order = {priority: int};

interface Plugin {
    public function name(): string;
}

#[Order(priority: 10)]
class Cache implements Plugin {
    public function name(): string {
        return "cache";
    }
}

class Logger implements Plugin {
    public function name(): string {
        return "logger";
    }
}

#[Order(priority: 1)]
class Auth implements Plugin {
    public function name(): string {
        return "auth";
    }
}

// Each plugin with its priority, and 100 for a plugin with no `Order` attribute.
// The rows come in class-name order, so this prints `auth 1`, `cache 10`, `logger 100`.
foreach (Core\Program::implementingWith<Plugin, Order>() as {instance: Plugin, attribute: ?Order} $row) {
    echo $row->instance->name(), " ", $row->attribute?->priority ?? 100, "\n";
}
