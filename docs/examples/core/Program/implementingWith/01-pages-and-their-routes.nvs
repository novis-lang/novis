<?nvs
// Shows how a framework finds every page and the path of its route in one
// call. A page writes its path once, in the attribute.

interface Page
{
    // Every class that implements `Page` may use this attribute.
    attribute PagePath on method { path: string }

    public function render(): string;
}

class Home implements Page
{
    #[PagePath(path: '/')]
    public function render(): string
    {
        return 'Welcome';
    }
}

class Contact implements Page
{
    #[PagePath(path: '/contact')]
    public function render(): string
    {
        return 'Write to us';
    }
}

// This call returns every page with the `PagePath` attribute of its `render` method.
// The rows are sorted by class name.
array<Page> $pages = [];
foreach (Core\Program::implementingWith<Page, Page::PagePath>('render') as var $row) {
    var $route = $row->attribute;
    if ($route != null) {
        $pages[$route->path] = $row->instance;
    }
}

// This prints `Write to us`, then `Welcome`.
echo $pages['/contact']->render(), "\n";
echo $pages['/']->render(), "\n";
