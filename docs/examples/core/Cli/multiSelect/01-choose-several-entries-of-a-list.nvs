<?nvs
// Shows how to let somebody choose several entries of a list at the terminal. In a
// terminal the person types the numbers. This example answers itself with
// `Core\Test::scriptAnswers`, so that it prints the same thing everywhere.

array<string> $features = ["dark mode", "e-mail digest", "beta pages"];

// The answer is choice 3 and choice 1. A space works in place of the comma.
Core\Test::scriptAnswers(["3,1"]);

array<string> $on = Core\Cli::multiSelect("Which features should be on?", $features);

// The answer keeps the order of the list above, so this prints
// "on: dark mode, beta pages".
echo "on: ", Core\Str::join($on, ", "), "\n";
