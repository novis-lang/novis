<?nvs
// Shows the everyday use: a tool that prints the lines a change added and
// removed. A terminal with colour shows them in green and red. Without colour
// the program writes `+` and `-` in front, so the meaning stays.

class Changes {
    public static function show(array<string> $removed, array<string> $added): void {
        // `None` means the text goes somewhere that shows no colour, such as a
        // file or another program.
        bool $plain = Core\Cli::colorDepth() == Core\Cli\ColorDepth::None;

        foreach ($removed as string $line) {
            echo $plain ? "-" : " ", $line, "\n";
        }
        foreach ($added as string $line) {
            echo $plain ? "+" : " ", $line, "\n";
        }
    }
}

Changes::show(["price: 11.00"], ["price: 12.50"]);
