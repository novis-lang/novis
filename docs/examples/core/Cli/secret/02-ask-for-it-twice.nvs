<?nvs
// Shows how to ask for a new password twice, so that a typing mistake is found
// before the password is stored. This example answers both questions itself with
// `Core\Test::scriptAnswers`.

Core\Test::scriptAnswers(["river-otter-42", "river-ottor-42"]);

secret tainted string $first = Core\Cli::secret("New password?");
secret tainted string $again = Core\Cli::secret("Type it again?");

// You can compare two secret values with `==`. The two answers above are
// different, so this prints the second message.
if ($first == $again) {
    echo "the new password was saved\n";
} else {
    echo "the two answers are different, nothing was saved\n";
}
