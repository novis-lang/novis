<?nvs
// Shows how to ask for a password at the terminal. The characters are not shown
// on the screen while they are typed. This example answers itself with
// `Core\Test::scriptAnswers`, so that it prints the same thing everywhere.

Core\Test::scriptAnswers(["correct horse battery"]);

secret tainted string $password = Core\Cli::secret("Password?");

// The answer is a `secret string`, so `echo $password` does not compile.
// `Core\Secret::reveal` returns the text, and takes a reason. This prints 21.
tainted string $plain = Core\Secret::reveal($password, "sending it to the mail server");
echo "the password is ", Core\Str::length($plain), " characters long\n";
