<?nvs
// Shows the everyday use: a command line tool asks who you are and checks your
// password. A real program reads the stored hash from its database. This example
// answers both questions itself with `Core\Test::scriptAnswers`.

string $stored = Core\Password::hash("opensesame");

Core\Test::scriptAnswers(["ada", "opensesame"]);

tainted string $user = Core\Cli::ask("User name?");
secret tainted string $password = Core\Cli::secret("Password?");

// `Core\Password::verify` takes the secret answer as it is. Nothing has to be
// revealed here. This prints "welcome, ada".
if (Core\Password::verify($password, $stored)) {
    echo "welcome, ", $user, "\n";
} else {
    echo "that password is wrong\n";
}
