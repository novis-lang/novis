<?nvs
// Shows the everyday use: a script asks a question when a person is there, and
// takes a sensible value when nobody is.

tainted string $branch = "main";

// Standard input is not a terminal when a build server runs the program, or
// when the input comes from a file. Nobody can answer, so do not ask.
if (Core\Cli::isTty(Core\Cli\Stream::In)) {
    $branch = Core\Cli::ask("Which branch?", {default: "main"});
}

echo "deploying ", $branch, "\n";
