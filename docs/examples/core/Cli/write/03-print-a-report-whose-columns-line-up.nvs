<?nvs
// Shows the everyday use: a program prints a report and the columns line up.
// `Core\Cli::write` adds nothing of its own, so each row is built piece by
// piece.

array<string> $names = ["Ada", "注文", "Grete"];
array<string> $totals = ["3", "12", "7"];

int $row = 0;
while ($row < 3) {
    string $name = $names[$row];

    // A Japanese character takes two columns on screen.
    // `Core\Cli::displayWidth` counts columns, so each name reaches column 8.
    uint $pad = 8 - Core\Cli::displayWidth($name);

    Core\Cli::write($name);
    Core\Cli::write(Core\Str::repeat(" ", $pad));
    Core\Cli::write($totals[$row], {newline: true});

    $row = $row + 1;
}
