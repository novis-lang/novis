<?nvs
// Shows how to read every attribute of one shape that is attached to a class.

type Tag = {name: string};

#[Tag(name: "users")]
#[Tag(name: "audited")]
class User {
    public string $email = "";
}

// `Core\Attributes::all` returns the matching attributes in the order they were
// written. `User::constructor(...)` names the class itself. This prints 2.
array<Tag> $tags = Core\Attributes::all<Tag>(User::constructor(...));
echo Core\Arr::count($tags), "\n";

// This prints `users` and then `audited`.
foreach ($tags as Tag $tag) {
    echo $tag->name, "\n";
}

// A class with no attribute on it. The result is an empty array, so this loop
// runs no times and the count is 0.
class Session {}

echo Core\Arr::count(Core\Attributes::all<Tag>(Session::constructor(...))), "\n";
