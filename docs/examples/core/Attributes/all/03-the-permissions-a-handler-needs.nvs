<?nvs
// Shows a check you can write before a handler runs. The handler lists the
// permissions it needs, and the program reads that list back.

type Needs = {permission: string};

class Orders {
    #[Needs(permission: "orders.read")]
    #[Needs(permission: "orders.write")]
    public static function cancelAll(): string {
        return "every open order is cancelled";
    }
}

class Access {
    // Returns true when `$held` contains every permission in `$needed`.
    public static function allows(array<Needs> $needed, array<string> $held): bool {
        foreach ($needed as Needs $need) {
            if (!Core\Arr::contains($held, $need->permission)) {
                return false;
            }
        }
        return true;
    }
}

// `Orders::cancelAll(...)` names the method. Both of its permissions come back.
array<Needs> $needed = Core\Attributes::all<Needs>(Orders::cancelAll(...));
array<string> $held = ["orders.read"];

// This user may read orders but not write them, so this prints `not allowed`.
if (Access::allows($needed, $held)) {
    echo Orders::cancelAll(), "\n";
} else {
    echo "not allowed\n";
}
