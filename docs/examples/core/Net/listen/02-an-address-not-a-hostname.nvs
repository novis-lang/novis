<?nvs
// Shows that `Core\Net::listen` needs an IP address, and what happens when it gets a hostname.

// `localhost` is a hostname, not an address. So this call throws a `RuntimeError`.
try {
    Core\Net::listen("localhost", 8080);
} catch (RuntimeError $wrong) {
    echo $wrong->message, "\n";
}

// The `nvs.toml` beside this example allows only `127.0.0.1` with port `0`.
// Port 8080 is not allowed, so this call throws a `RuntimeError` too.
try {
    Core\Net::listen("127.0.0.1", 8080);
} catch (RuntimeError $refused) {
    echo $refused->message, "\n";
}
