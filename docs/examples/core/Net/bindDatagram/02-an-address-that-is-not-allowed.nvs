<?nvs
// Shows the two ways `Core\Net::bindDatagram` can throw a `RuntimeError`.

// `localhost` is a hostname, not an IP address. So this call throws a `RuntimeError`.
try {
    Core\Net::bindDatagram("localhost", 5353);
} catch (RuntimeError $wrong) {
    echo $wrong->message, "\n";
}

// The `nvs.toml` beside this example allows only `127.0.0.1` with port `0`.
// Port 5353 is not allowed, so this call throws a `RuntimeError` too.
try {
    Core\Net::bindDatagram("127.0.0.1", 5353);
} catch (RuntimeError $refused) {
    echo $refused->message, "\n";
}
