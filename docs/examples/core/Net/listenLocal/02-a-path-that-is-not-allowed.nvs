<?nvs
// Shows what happens when a program listens at a path its configuration does not allow.

// The `nvs.toml` beside this example does not allow `/tmp/other.sock`.
// So this call throws a `RuntimeError`, and no socket file is created.
try {
    Core\Net::listenLocal("/tmp/other.sock");
} catch (RuntimeError $refused) {
    echo $refused->message, "\n";
}
