<?nvs
// Shows a small server on a socket file that greets one client.
// requires: unix

// `listenLocal` creates the socket file and returns a `Core\Net\Listener`.
string $path = "/tmp/novis-greeter.sock";
Core\Net\Listener $server = Core\Net::listenLocal($path);

// A client on the same computer connects to the same path and says its name.
Core\Net\Stream $client = Core\Net::connectLocal($path, 5s);
$client->write("Ada\n" as bytes, 5s);

// `accept` waits up to 5 seconds for the client. The server reads the name and replies.
Core\Net\Stream $connection = $server->accept(5s);
tainted string $name = Core\Str::trim($connection->read(64, 5s) as string);
$connection->write("Hello, " as bytes, 5s);
$connection->write($name as bytes, 5s);

// This prints `Hello, Ada`.
echo Core\Str::trim($client->read(64, 5s) as string), "\n";

$connection->close();
$client->close();
$server->close();

// The socket file stays on disk after `close`, so the program deletes it.
Core\IO::remove($path);
