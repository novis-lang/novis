<?nvs
// Shows how to read the minute of a time of day as a number.

Core\Time\TimeOfDay $lunch = Core\Time\TimeOfDay::at(12, 15);

// `minute` returns a `uint` from 0 to 59. This prints 15.
echo $lunch->minute(), "\n";

// A time made with `TimeOfDay::at(12, 0)` is on the hour. This prints 0.
echo Core\Time\TimeOfDay::at(12, 0)->minute(), "\n";
