<?nvs
// Shows how to check if two times are the same time.

Core\Time\TimeOfDay $a = Core\Time\TimeOfDay::at(12, 0);
Core\Time\TimeOfDay $b = Core\Time\TimeOfDay::at(12, 0);

// `==` compares the time itself. Both are 12:00, so this prints "same time".
echo $a == $b ? 'same time' : 'different time', "\n";

// `compareTo` returns 0 for the same time. This prints 0.
echo $a->compareTo($b), "\n";
