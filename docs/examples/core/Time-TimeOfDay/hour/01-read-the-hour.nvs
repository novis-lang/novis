<?nvs
// Shows how to read the hour of a time of day as a number.

Core\Time\TimeOfDay $closes = Core\Time\TimeOfDay::at(18, 30);

// `hour` returns a `uint` from 0 to 23. This prints 18.
echo $closes->hour(), "\n";

// The last hour before midnight is 23. This prints 23.
echo Core\Time\TimeOfDay::at(23, 59)->hour(), "\n";
