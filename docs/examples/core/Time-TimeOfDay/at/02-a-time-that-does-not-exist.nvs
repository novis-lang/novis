<?nvs
// Shows what happens when a part of the time is outside its range.

// The hours of a day go from 0 to 23, so hour 24 throws a `RuntimeError`.
try {
    Core\Time\TimeOfDay::at(24, 0);
} catch (RuntimeError $e) {
    echo $e->message, "\n";
}

// Midnight at the start of the day is hour 0. This prints 00:00.
echo Core\Time\TimeOfDay::at(0, 0)->format("HH:mm"), "\n";
