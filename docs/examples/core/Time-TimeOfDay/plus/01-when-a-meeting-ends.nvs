<?nvs
// Shows how to get the time that is a number of minutes after another time.

Core\Time\TimeOfDay $start = Core\Time\TimeOfDay::at(10, 30);

// This prints 11:15.
echo $start->plus(45, Core\Unit::Minute)->format("HH:mm"), "\n";

// `plus` returns a new time. `$start` does not change, so this prints 10:30.
echo $start->format("HH:mm"), "\n";
