<?nvs
// Shows how to copy a large file in parts, so the program never has the whole file in memory.

string $dir = Core\IO::temporaryDir();
string $source = Core\Path::join($dir, "export.csv");
string $copy = Core\Path::join($dir, "export-copy.csv");
Core\IO::write($source, Core\Str::repeat("1042,Café Größenwahn,19.90\n", 20000));

Core\IO\File $in = Core\IO::open($source, Core\IO\FileMode::Read);
Core\IO\File $out = Core\IO::open($copy, Core\IO\FileMode::Write);
uint $parts = 0;

// Each `read` returns up to 64 KB. An empty string means the file has ended.
string $part = $in->read(65536);
while (Core\Str::length($part) > 0) {
    $out->write($part);
    $parts = $parts + 1;
    $part = $in->read(65536);
}
$in->close();
$out->close();

// This prints how many parts were copied, and that both files have the same size.
echo "parts: ", $parts, "\n";
echo "same size: ", Core\IO::size($source) == Core\IO::size($copy) ? "yes" : "no", "\n";
