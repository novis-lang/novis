<?nvs
// Shows how a nightly job uses a lock file, so that two copies of the job never run at the same time.

class Job {
    // Returns `true` when this copy of the job ran, and `false` when another copy has the lock.
    public static function run(string $lockPath): bool {
        Core\IO\File $lock = Core\IO::open($lockPath, Core\IO\FileMode::ReadWrite);
        try {
            $lock->lock();
        } catch (IOError $busy) {
            $lock->close();
            return false;
        }
        echo "sending the reports\n";
        $lock->close();
        return true;
    }
}

string $lockPath = Core\Path::join(Core\IO::temporaryDir(), "reports.lock");

// Another copy of the job is running and has the lock. This prints "another copy is running".
Core\IO\File $other = Core\IO::open($lockPath, Core\IO\FileMode::ReadWrite);
$other->lock();
if (!Job::run($lockPath)) {
    echo "another copy is running\n";
}

// The other copy finishes and closes its handle. Now this copy runs and prints "sending the reports".
$other->close();
Job::run($lockPath);
