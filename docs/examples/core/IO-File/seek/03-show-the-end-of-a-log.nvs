<?nvs
// Shows how to read only the end of a large log file.
// The program never reads the start of the file, however large it is.

string $path = Core\Path::join(Core\IO::temporaryDir(), "app.log");
Core\IO\File $log = Core\IO::open($path, Core\IO\FileMode::Write);
uint $i = 1;
while ($i <= 5000) {
    $log->write("request " . $i as string . " done\n");
    $i = $i + 1;
}
$log->close();

// The last 60 bytes start at the file size minus 60.
Core\IO\File $file = Core\IO::open($path, Core\IO\FileMode::Read);
$file->seek(Core\IO::size($path) - 60);
string $end = $file->read(60);
$file->close();

// The first line in `$end` is cut, so this prints only the lines after it.
echo Core\Str::after($end, "\n");
