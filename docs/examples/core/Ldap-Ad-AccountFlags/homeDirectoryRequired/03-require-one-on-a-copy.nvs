<?nvs
// Shows how `homeDirectoryRequired` and the number change on a copy made with `with`.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    var $changed = $flags->with({ homeDirectoryRequired: true });

    // This prints `512 false` and then `520 true`.
    echo $flags->bits(), $flags->homeDirectoryRequired() ? ' true' : ' false', "\n";
    echo $changed->bits(), $changed->homeDirectoryRequired() ? ' true' : ' false', "\n";
}
