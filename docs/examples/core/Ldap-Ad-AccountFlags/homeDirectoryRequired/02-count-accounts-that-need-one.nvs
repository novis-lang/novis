<?nvs
// Shows how to count the accounts that need a home directory.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $found = $corp->search(
    Core\Ldap\Filter::equals('objectClass', 'user'),
    { base: 'OU=Company,DC=example,DC=test', select: ['userAccountControl'] },
);

uint $count = 0;
uint $all = 0;
foreach ($found as Core\Ldap\Entry $account) {
    var $flags = $account->accountFlags();
    if ($flags != null) {
        $all = $all + 1;
        if ($flags->homeDirectoryRequired()) {
            $count = $count + 1;
        }
    }
}

// No account in this directory needs a home directory. This prints `0 of 5`.
echo $count, ' of ', $all, "\n";
