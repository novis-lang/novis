<?nvs
// Shows how `normalAccount` changes when a copy gets another account type.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    // An account has one type, so the copy clears `normalAccount` and sets the new type.
    var $computer = $flags->with({ normalAccount: false, workstationTrustAccount: true });

    // This prints `512 true` and then `4096 false`.
    echo $flags->bits(), $flags->normalAccount() ? ' true' : ' false', "\n";
    echo $computer->bits(), $computer->normalAccount() ? ' true' : ' false', "\n";
}
