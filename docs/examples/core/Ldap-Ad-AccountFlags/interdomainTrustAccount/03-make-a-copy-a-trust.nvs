<?nvs
// Shows how `interdomainTrustAccount` and the number change on a copy made with `with`.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    // An account has one type, so the copy clears `normalAccount` and sets the new type.
    var $trust = $flags->with({ normalAccount: false, interdomainTrustAccount: true });

    // This prints `512 false` and then `2048 true`.
    echo $flags->bits(), $flags->interdomainTrustAccount() ? ' true' : ' false', "\n";
    echo $trust->bits(), $trust->interdomainTrustAccount() ? ' true' : ' false', "\n";
}
