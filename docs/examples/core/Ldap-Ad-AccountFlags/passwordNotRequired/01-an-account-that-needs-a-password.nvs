<?nvs
// Shows that `passwordNotRequired` returns `false` for an account that must have a password.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    // This prints `password not required: false`.
    echo 'password not required: ', $flags->passwordNotRequired() ? 'true' : 'false', "\n";
}
