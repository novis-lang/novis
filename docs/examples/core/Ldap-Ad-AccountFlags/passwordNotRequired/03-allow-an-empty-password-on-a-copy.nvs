<?nvs
// Shows how `passwordNotRequired` and the number change on a copy made with `with`.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    var $changed = $flags->with({ passwordNotRequired: true });

    // This prints `512 false` and then `544 true`.
    echo $flags->bits(), $flags->passwordNotRequired() ? ' true' : ' false', "\n";
    echo $changed->bits(), $changed->passwordNotRequired() ? ' true' : ' false', "\n";
}
