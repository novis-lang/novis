<?nvs
// Shows that `reversibleEncryption` returns `false` for an account whose password is stored as a hash.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    // This prints `reversible: false`.
    echo 'reversible: ', $flags->reversibleEncryption() ? 'true' : 'false', "\n";
}
