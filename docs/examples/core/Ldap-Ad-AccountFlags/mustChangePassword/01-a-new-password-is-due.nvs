<?nvs
// Shows that `mustChangePassword` returns `true` for a user who must set a new password.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Carla Diaz,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    // Carla Diaz has `pwdLastSet` set to `0`. This prints `must change: true`.
    echo 'must change: ', $flags->mustChangePassword() ? 'true' : 'false', "\n";
}
