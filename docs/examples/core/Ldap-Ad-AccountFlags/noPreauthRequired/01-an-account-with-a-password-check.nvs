<?nvs
// Shows that `noPreauthRequired` returns `false` for an account where Kerberos checks the password.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    // This prints `no preauth: false`.
    echo 'no preauth: ', $flags->noPreauthRequired() ? 'true' : 'false', "\n";
}
