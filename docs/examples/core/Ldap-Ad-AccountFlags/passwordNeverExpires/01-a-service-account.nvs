<?nvs
// Shows that `passwordNeverExpires` returns `true` for an account whose password does not expire.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Reader,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    // This prints `never expires: true`.
    echo 'never expires: ', $flags->passwordNeverExpires() ? 'true' : 'false', "\n";
}
