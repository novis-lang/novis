<?nvs
// Shows how to keep only the people who can log in.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $found = $corp->search(
    Core\Ldap\Filter::equals('objectClass', 'user'),
    { base: 'OU=Company,DC=example,DC=test', select: ['userAccountControl'] },
);

array<tainted string> $names = [];
foreach ($found as Core\Ldap\Entry $person) {
    var $flags = $person->accountFlags();
    if ($flags != null && !$flags->disabled()) {
        $names[] = $person->dn()->rdnValue();
    }
}

// The server sends entries in no fixed order, so the names are sorted.
// Dora Lind is disabled. This prints `Anna Berg`, `Ben Kohl`, `Carla Diaz` and `Reader`.
foreach (Core\Arr::sort($names) as tainted string $name) {
    echo $name, "\n";
}
