<?nvs
// Shows how `workstationTrustAccount` and the number change on a copy made with `with`.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    // An account has one type, so the copy clears `normalAccount` and sets the new type.
    var $computer = $flags->with({ normalAccount: false, workstationTrustAccount: true });

    // This prints `512 false` and then `4096 true`.
    echo $flags->bits(), $flags->workstationTrustAccount() ? ' true' : ' false', "\n";
    echo $computer->bits(), $computer->workstationTrustAccount() ? ' true' : ' false', "\n";
}
