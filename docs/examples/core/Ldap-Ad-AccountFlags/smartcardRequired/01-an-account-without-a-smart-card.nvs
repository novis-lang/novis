<?nvs
// Shows that `smartcardRequired` returns `false` for an account that logs in with a password.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    // This prints `smart card: false`.
    echo 'smart card: ', $flags->smartcardRequired() ? 'true' : 'false', "\n";
}
