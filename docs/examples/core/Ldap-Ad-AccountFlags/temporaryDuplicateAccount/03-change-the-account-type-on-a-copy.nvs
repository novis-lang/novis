<?nvs
// Shows how to change the account type on a copy made with `with`.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $flags = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();

if ($flags != null) {
    // An account has one type, so the copy clears `normalAccount` and sets the new type.
    var $changed = $flags->with({ normalAccount: false, temporaryDuplicateAccount: true });

    // This prints `512 false` and then `256 true`.
    echo $flags->bits(), $flags->temporaryDuplicateAccount() ? ' true' : ' false', "\n";
    echo $changed->bits(), $changed->temporaryDuplicateAccount() ? ' true' : ' false', "\n";
}
