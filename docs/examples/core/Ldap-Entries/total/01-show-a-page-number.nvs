<?nvs
// Shows how to print "page 1 of 3" above one page of a sorted list of people.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
int $perPage = 2;

// `sort` and `window` make the server return the first two people by name.
var $people = $corp->search(Core\Ldap\Filter::equals('objectClass', 'user'), {
    base: 'OU=Company,DC=example,DC=test',
    select: ['cn'],
    sort: 'cn',
    window: $perPage,
});

foreach ($people as Core\Ldap\Entry $person) {
    echo $person->string('cn') ?? '', "\n";
}

// `total` is the number of people in the whole list, not only on this page.
// There are 5, so this prints "Page 1 of 3".
int $count = $people->total() ?? 0;
int $pages = Core\Math::ceil($count / $perPage) as int;
echo 'Page 1 of ', $pages, "\n";
