<?nvs
// Shows a program that asks for the database where it needs it. Every call with
// the same name gives back the same connection, so a function does not have to
// take the connection as a parameter.

class Notes {
    public static function add(string $text): void {
        var $db = Core\Db::connect('notes');
        $db->execute('insert into notes (text) values (?)', [$text]);
    }

    public static function count(): int {
        var $db = Core\Db::connect('notes');
        int $total = 0;
        foreach ($db->query('select count(*) as n from notes', []) as Core\Db\Row $row) {
            $total = $row->int('n') ?? 0;
        }
        return $total;
    }
}

var $db = Core\Db::connect('notes');
$db->execute('create table notes (id integer primary key, text text not null)', []);

Notes::add('buy milk');
Notes::add('call the plumber');

// The two methods above wrote to this connection. This prints `2 notes`.
echo Notes::count(), " notes\n";

$db->close();
