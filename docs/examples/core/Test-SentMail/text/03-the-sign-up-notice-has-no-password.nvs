<?nvs
// Shows how to test that a mail about a new user does not contain the password from the form.
// proof: test

use Core\Http\Method;
use Core\Str;
use Core\Test;

class SignUpTest
{
    // The mail to the admins names the new user. The password from the form is not in it.
    #[Test]
    public function thePasswordIsNotInTheMail(): void
    {
        Test::request(Method::Post, '/sign-up', {
            headers: ['content-type' => 'application/x-www-form-urlencoded'],
            body: 'name=Ada&password=correct-horse-42',
        });

        Test::assertCount(Test::sentMail(), 1);
        string $text = Test::sentMail()[0]->text();
        Test::assertSame($text, 'A new user signed up: Ada');
        Test::assertTrue(!Str::contains($text, 'correct-horse-42'));
    }
}

// `Test::request` sends a request to this program. The code below, outside the class, runs for it.
// It sends the admins the name of the new user. The password from the form is not in the mail.
if (Core\Env::context() == Core\Env::Context::Request) {
    tainted string $name = Core\Request::formField('name') ?? '';
    Core\Mail::send('site', ['admin@example.com'], 'New user', 'A new user signed up: ' . $name);
    Core\Response::setStatus(201);
}
