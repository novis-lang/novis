<?nvs
// Shows how to test a request that sends an agent's reply and an automatic copy to the team.
// proof: test

use Core\Http\Method;
use Core\Test;

class AnswerTest
{
    #[Test]
    public function onlyTheCopyIsAutomatic(): void
    {
        Test::request(Method::Post, '/tickets/381/answer');

        // The first message is the reply that the agent wrote.
        Test::assertTrue(!Test::sentMail()[0]->isAutoSubmitted());

        // The second message is the copy that the program made.
        Test::assertTrue(Test::sentMail()[1]->isAutoSubmitted());
    }
}

// `Test::request` sends a request to this program. The code below, outside the class, runs for it.
// It sends the reply to the customer, and then a copy to the support team.
if (Core\Env::context() == Core\Env::Context::Request) {
    string $answer = 'Your parcel arrives tomorrow.';
    Core\Mail::send('shop', ['anna@example.com'], 'Re: Ticket 381', $answer, { autoSubmitted: false });
    Core\Mail::send('shop', ['support@example.com'], 'Ticket 381 was answered', 'Carla wrote: ' . $answer);
    Core\Response::setStatus(202);
}
