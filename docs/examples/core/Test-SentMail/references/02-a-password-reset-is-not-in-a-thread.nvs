<?nvs
// Shows how to test that a password reset mail is not part of a thread.
// proof: test

use Core\Mail;
use Core\Test;

class PasswordReset
{
    // Sends the reset link. Each reset is a new message, with no earlier messages.
    public static function send(string $email, string $token): void
    {
        Mail::send('shop', [$email], 'Reset your password', 'Open https://example.com/reset/' . $token);
    }
}

class PasswordResetTest
{
    #[Test]
    public function theResetMailHasNoReferences(): void
    {
        PasswordReset::send('bo@example.com', 'k3v9');

        // No `references` option was given, so the list is empty.
        Test::assertEquals(Test::sentMail()[0]->references(), []);
    }
}
