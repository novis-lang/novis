<?nvs
// Shows how to test that a comment a request sends lists the earlier messages of its thread.
// proof: test

use Core\Http\Method;
use Core\Test;

class CommentTest
{
    #[Test]
    public function theCommentListsTheThread(): void
    {
        Test::request(Method::Post, '/issues/12/comments');

        Core\Test\SentMail $mail = Test::sentMail()[0];
        Test::assertEquals($mail->references(), ['issue-12@example.com', 'comment-1@example.com']);

        // The last id of the list is also the message that this comment answers.
        Test::assertSame($mail->inReplyTo(), 'comment-1@example.com');
    }
}

// `Core\Test::request` runs this file again for the request. The issue has two earlier
// messages. The program saved their ids, and the new comment passes them to `references`.
if (Core\Env::context() == Core\Env::Context::Request) {
    array<string> $earlier = ['issue-12@example.com', 'comment-1@example.com'];
    Core\Mail::send('shop', ['team@example.com'], 'Re: Issue 12: the search is slow', 'It is fast again.', {
        inReplyTo: $earlier[1],
        references: $earlier,
    });
    Core\Response::setStatus(202);
}
