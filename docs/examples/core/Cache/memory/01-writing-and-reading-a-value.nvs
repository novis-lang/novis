<?nvs
// Shows how to write a value into the memory cache of this server, and read it back.

var $cache = Core\Cache::memory();

// `put` writes the value under the key "greeting". Every core of this server
// sees the same store, so every request on this server can read this value.
$cache->put('greeting', 'hello');

// `get` returns what was written. This prints hello.
var $greeting = $cache->get('greeting') as string;
echo $greeting, "\n";

// A key nothing wrote returns `null`. `??` gives a value to use instead,
// so this prints no colour yet.
var $colour = $cache->get('colour') ?? 'no colour yet';
echo $colour as string, "\n";

// `forget` removes one key for the whole server. This prints gone.
$cache->forget('greeting');
var $after = $cache->get('greeting') ?? 'gone';
echo $after as string, "\n";
