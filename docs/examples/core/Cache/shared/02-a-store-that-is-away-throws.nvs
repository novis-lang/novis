<?nvs
// Shows the one promise this tier makes that the two caches in memory do not.
// A key that was never written returns `null`. A shared store the server cannot
// reach throws, so your program can tell the two apart.

var $local = Core\Cache::local();

// A key with no value is an ordinary answer. This prints null.
var $missing = $local->get("never-written") ?? "null";
echo $missing as string, "\n";

// A shared store that is not there is an error. Your program needs that
// difference when a wrong answer would be worse than no answer at all.
try {
    Core\Cache::shared();
    echo "the store is ready\n";
} catch (Throwable $error) {
    echo "the shared store threw instead of answering null\n";
}
