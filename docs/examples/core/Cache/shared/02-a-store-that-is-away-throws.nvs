<?nvs
// Shows how a program tells a missing value apart from a shared store that the
// server cannot reach.

var $memory = Core\Cache::memory();

// Every cache returns `null` for a key that nothing wrote. This prints null.
var $missing = $memory->get('never-written') ?? 'null';
echo $missing as string, "\n";

// A shared store that the server cannot reach throws an error. Your program
// needs this when a wrong value is worse than no value.
try {
    Core\Cache::shared();
    echo "the store is ready\n";
} catch (Throwable $error) {
    echo "the shared store threw instead of answering null\n";
}
