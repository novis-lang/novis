<?nvs
// Shows how to send an email receipt for an order. The `[mail.shop]` block of
// `nvs.toml` names the sender. Its `capture = true` line keeps each message, so nothing is sent.

// `Core\Mail::send` sends the message through the `[mail.shop]` block.
// The body is HTML, so the message also gets a plain-text version of it.
string $id = Core\Mail::send(
    'shop',
    ['anna@example.com'],
    'Your receipt for order 1042',
    html`<p>Thank you for your order. The total is <b>59.90 EUR</b>.</p>`,
);

// `send` returns the Message-ID of the message. It ends with the domain of the sender.
// Save it to match a reply or a bounce to this order.
echo Core\Str::endsWith($id, '@example.com') ? "The receipt is sent.\n" : "No id.\n";
