<?nvs
// Shows what happens when an email address contains a line break.
// `Core\Mail::send` checks every address before it connects.

// This address hides a second line. In a mail header, that line would add a `Bcc:` recipient.
string $typed = "anna@example.com\r\nBcc: everyone@example.com";

// The call throws a `RuntimeError`, and nothing is sent.
try {
    Core\Mail::send("shop", [$typed], "Welcome", "Thank you for signing up.");
    echo "sent\n";
} catch (RuntimeError $refused) {
    echo $refused->message, "\n";
}
