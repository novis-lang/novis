<?nvs
// Shows how to compute a SHA-256 digest from a text that arrives in two parts.

Core\Hash\Stream $stream = Core\Hash::stream(Core\Digest::Sha256);
$stream->update("hel");
$stream->update("lo");

// This prints 2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824.
echo Core\Encoding::toHex($stream->finish()), "\n";

// `Core\Hash::of` over the whole text gives the same digest.
echo Core\Encoding::toHex(Core\Hash::of("hello", Core\Digest::Sha256)), "\n";
