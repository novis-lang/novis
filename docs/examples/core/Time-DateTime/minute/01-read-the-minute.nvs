<?nvs
// Shows how to read the minute of a date and time as a number.

var $departure = Core\Time\DateTime::fromIso('2024-08-12 07:45', 'Europe/Zurich');

// `minute` returns a `uint` from 0 to 59. This prints 45.
echo $departure->minute(), "\n";

// The train leaves at 7:45, so there are 15 minutes until 8:00. This prints 15.
echo 60 - $departure->minute(), "\n";
