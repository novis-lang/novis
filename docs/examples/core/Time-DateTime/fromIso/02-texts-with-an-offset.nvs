<?nvs
// Shows how `fromIso` reads a text with an offset from UTC.

// This text has an offset and a zone name in brackets. This is the text `toIso` writes.
// `fromIso` needs no second argument for it. This prints 2024-06-01 09:30 +02:00.
var $saved = Core\Time\DateTime::fromIso('2024-06-01T09:30:00+02:00[Europe/Berlin]');
echo $saved->format('yyyy-MM-dd HH:mm XXX'), "\n";

// A text that ends in `Z` or in an offset alone has no zone name.
// `fromIso` throws a `ParseError` for it.
array<string> $inputs = ['2024-06-01T07:30:00Z', '2024-06-01T09:30:00+02:00'];
foreach ($inputs as string $text) {
    try {
        echo Core\Time\DateTime::fromIso($text, 'Europe/Berlin')->format('yyyy-MM-dd HH:mm XXX'), "\n";
    } catch (ParseError $error) {
        echo 'no zone name: ', $text, "\n";
    }
}

// `Core\Time\Instant::fromIso` reads such a text. `in` gives the time in Berlin.
// This prints 2024-06-01 09:30 +02:00.
var $berlin = Core\Time\Zone::of('Europe/Berlin');
echo Core\Time\Instant::fromIso('2024-06-01T07:30:00Z')->in($berlin)->format('yyyy-MM-dd HH:mm XXX'), "\n";
