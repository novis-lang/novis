<?nvs
// Shows how to find the first day of the next month, when a monthly report is due.

class Report
{
    public static function dueDate(Core\Time\DateTime $today): Core\Time\DateTime
    {
        // In December the next month is January of the next year.
        if ($today->month() == 12) {
            return $today->with({ year: $today->year() + 1, month: 1, day: 1 });
        }
        return $today->with({ month: $today->month() + 1, day: 1 });
    }
}

var $zone = Core\Time\Zone::of('Asia/Singapore');

// This prints 2024-07-01 and then 2025-01-01.
echo Report::dueDate(Core\Time::at(2024, 6, 18, $zone))->format('yyyy-MM-dd'), "\n";
echo Report::dueDate(Core\Time::at(2024, 12, 31, $zone))->format('yyyy-MM-dd'), "\n";
