<?nvs
// Shows how to use the month as a position in a list, to pick a season for a shop banner.

// The list has one season for each month, from January to December.
array<string> $seasons = [
    'winter',
    'winter',
    'spring',
    'spring',
    'spring',
    'summer',
    'summer',
    'summer',
    'autumn',
    'autumn',
    'autumn',
    'winter',
];
var $zone = Core\Time\Zone::of('Europe/Rome');

// The months start at 1 and the list starts at 0, so the position is the month minus 1.
// This prints spring, summer and winter.
array<string> $days = ['2024-04-10', '2024-07-01', '2024-12-24'];
foreach ($days as string $text) {
    var $day = Core\Time::parse($text, 'yyyy-MM-dd', $zone);
    int $position = ($day->month() - 1) as int;
    echo $text, ': ', $seasons[$position], "\n";
}
