<?nvs
// Shows how to read the month of a date and time as a number.

var $shipped = Core\Time\DateTime::fromIso('2024-09-03 16:00', 'Europe/Paris');

// `month` returns a `uint` from 1 to 12. September is month 9, so this prints 9.
echo $shipped->month(), "\n";

// `format` with `MMMM` gives the name of the month. This prints September.
echo $shipped->format('MMMM'), "\n";
