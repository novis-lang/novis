<?nvs
// Shows how to move a delivery date to Monday when it falls on a weekend.

var $warehouse = Core\Time\Zone::of("Europe/Madrid");
array<string> $planned = ["2024-05-17T08:00:00Z", "2024-05-18T08:00:00Z", "2024-05-19T08:00:00Z"];

// A Saturday or a Sunday moves to the next Monday. `next` finds the next day with that weekday.
// This prints Friday 17 May, then Monday 20 May twice.
foreach ($planned as string $text) {
    var $delivery = Core\Time::fromIso($text)->in($warehouse);
    var $day = $delivery->weekday();
    if ($day == Core\Weekday::Saturday || $day == Core\Weekday::Sunday) {
        $delivery = $delivery->next(Core\Weekday::Monday);
    }
    echo $delivery->format("EEEE d MMMM"), "\n";
}
