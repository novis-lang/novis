<?nvs
// Shows how to find the day of the week of a date and time.

var $meeting = Core\Time\DateTime::fromIso('2024-03-05 14:30', 'Europe/Berlin');

// `weekday` returns a case of the `Core\Time\Weekday` enum. You can compare it with `==`.
// This prints Tuesday.
if ($meeting->weekday() == Core\Time\Weekday::Tuesday) {
    echo "Tuesday\n";
}

// `as int` gives the position in the week, and Monday is 0. This prints 1.
echo $meeting->weekday() as int, "\n";
