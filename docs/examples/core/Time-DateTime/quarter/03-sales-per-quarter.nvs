<?nvs
// Adds up the sales of a shop for each quarter of the year.

array<string> $orderTimes = ['2026-01-12 10:00', '2026-02-03 16:45', '2026-05-20 09:15', '2026-11-30 18:00'];
array<int> $amounts = [40, 25, 60, 15];

// `quarter` returns 1 to 4. The total of quarter 1 is at index 0 of `$totals`.
array<int> $totals = [0, 0, 0, 0];
int $i = 0;
foreach ($orderTimes as string $text) {
    uint $q = Core\Time\DateTime::fromIso($text, 'Europe/Berlin')->quarter();
    $totals[($q - 1) as string] = $totals[($q - 1) as string] + $amounts[$i as string];
    $i = $i + 1;
}

// This prints Q1: 65, Q2: 60, Q3: 0 and Q4: 15.
int $n = 0;
while ($n < 4) {
    echo 'Q', $n + 1, ': ', $totals[$n as string], "\n";
    $n = $n + 1;
}
