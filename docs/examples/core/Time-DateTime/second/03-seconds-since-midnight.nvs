<?nvs
// Shows how to count the seconds since midnight, for a daily timer in a factory.

class Clock
{
    public static function secondsSinceMidnight(Core\Time\DateTime $time): uint
    {
        return $time->hour() * 3600 + $time->minute() * 60 + $time->second();
    }
}

var $zone = Core\Time\Zone::of('Asia/Seoul');

// One minute after midnight is 60 seconds. This prints 60.
echo Clock::secondsSinceMidnight(Core\Time\DateTime::fromIso('2024-01-15 00:01', $zone)), "\n";

// 08:30:15 is 8 hours, 30 minutes and 15 seconds after midnight. This prints 30615.
echo Clock::secondsSinceMidnight(Core\Time\DateTime::fromIso('2024-01-15 08:30:15', $zone)), "\n";
