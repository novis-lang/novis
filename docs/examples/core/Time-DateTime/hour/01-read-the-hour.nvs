<?nvs
// Shows how to read the hour of a date and time as a number.

var $meeting = Core\Time\DateTime::fromIso('2024-03-05 14:30', 'Europe/Berlin');

// `hour` returns a `uint` from 0 to 23. This prints 14.
echo $meeting->hour(), "\n";

// Midnight is hour 0. This prints 0.
echo Core\Time\DateTime::fromIso('2024-03-06', 'Europe/Berlin')->hour(), "\n";
