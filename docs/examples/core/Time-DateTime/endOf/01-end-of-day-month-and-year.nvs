<?nvs
// Shows how to find the last moment of the day, the month and the year that a date and time is in.

var $at = Core\Time::at(2024, 2, 10, Core\Time\Zone::of("Asia/Singapore"), {hour: 8, minute: 5});
string $pattern = "yyyy-MM-dd HH:mm:ss.SSSSSSSSS";

// `endOf` returns the last nanosecond of the unit. That is one nanosecond before the next one starts.
// This prints 2024-02-10 23:59:59.999999999.
echo $at->endOf(Core\Unit::Day)->format($pattern), "\n";

// 2024 is a leap year, so February has 29 days. This prints 2024-02-29 23:59:59.999999999.
echo $at->endOf(Core\Unit::Month)->format($pattern), "\n";

// This prints 2024-12-31 23:59:59.999999999.
echo $at->endOf(Core\Unit::Year)->format($pattern), "\n";
