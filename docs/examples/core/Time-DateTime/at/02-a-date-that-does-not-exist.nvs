<?nvs
// Shows what happens with a date or a time that does not exist.

// February 2023 has 28 days, so `Date::at` throws a `RuntimeError` for day 29.
try {
    Core\Time\Date::at(2023, 2, 29);
} catch (RuntimeError $error) {
    echo 'Not a date: ', $error->message, "\n";
}

// On 31 March 2024, clocks in Berlin jump from 02:00 to 03:00.
// 02:30 is skipped, so the result is 03:30. This prints 03:30 +02:00.
var $date = Core\Time\Date::at(2024, 3, 31);
var $time = Core\Time\TimeOfDay::at(2, 30);
echo Core\Time\DateTime::at($date, $time, 'Europe/Berlin')->format('HH:mm XXX'), "\n";
