<?nvs
// Shows how to build a date and time from a date, a time of day and a time zone.

var $date = Core\Time\Date::at(2024, 3, 5);

// `TimeOfDay::at(0, 0)` is midnight. This prints 2024-03-05 00:00.
echo Core\Time\DateTime::at($date, Core\Time\TimeOfDay::at(0, 0), 'Europe/Berlin')->format('yyyy-MM-dd HH:mm'), "\n";

// The time of day can also have seconds. This prints 2024-03-05 09:30:15 +01:00.
var $time = Core\Time\TimeOfDay::at(9, 30, { second: 15 });
echo Core\Time\DateTime::at($date, $time, 'Europe/Berlin')->format('yyyy-MM-dd HH:mm:ss XXX'), "\n";
