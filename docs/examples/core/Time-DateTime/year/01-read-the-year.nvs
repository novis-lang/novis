<?nvs
// Shows how to read the year of a date and time as a number.

var $order = Core\Time\DateTime::fromIso('2024-03-15 10:00', 'Europe/Berlin');

// `year` returns an `int`. This prints 2024.
echo $order->year(), "\n";

// You can calculate with it. This prints 2031, the last year the order must be kept.
echo $order->year() + 7, "\n";
