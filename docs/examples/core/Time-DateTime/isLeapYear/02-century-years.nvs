<?nvs
// Shows the rule for years that end in 00.

// A year that divides by 4 is a leap year. A year that divides by 100 is not,
// unless it also divides by 400. This prints no, yes and no.
array<int> $years = [1900, 2000, 2100];
foreach ($years as int $year) {
    var $day = Core\Time::at($year, 1, 1, Core\Time\Zone::UTC);
    echo $year, ": ", $day->isLeapYear() ? "yes" : "no", "\n";
}
