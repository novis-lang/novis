<?nvs
// Shows how to remove the flag from a complaint once it is answered.

use Core\IO;
use Core\Imap;

var $inbox = Imap::open('shop')->folder('INBOX');

// A `directory` block is a folder on disk that works like a mailbox, for tests and local work.
// In such a block, the file `1.flags` has the flags of message 1, one per line.
echo "before:\n", IO::readText('shop/INBOX/1.flags');

// This removes the flag `\Flagged` from message 1.
$inbox->unflag(1, '\Flagged');

// `\Seen` does not change. This prints only "\Seen".
echo "after:\n", IO::readText('shop/INBOX/1.flags');

// This adds the flag again, so the example prints the same each time it runs.
$inbox->flag(1, '\Flagged');
