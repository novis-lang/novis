<?nvs
// Shows that `fetch` does not mark a message as read, and what happens for a UID that does not exist.

use Core\Arr;
use Core\Imap;

var $inbox = Imap::open('inbox')->folder('INBOX');

// The messages with the UIDs 2 and 3 are not read yet. So there are 2 unread messages.
// This prints "not read: 2" before and after `fetch(2)` reads message 2.
echo 'not read: ', Arr::count($inbox->search({ unseen: true })), "\n";
$inbox->fetch(2);
echo 'not read: ', Arr::count($inbox->search({ unseen: true })), "\n";

// The folder has no message with the UID 9, so `fetch` throws an `IOError`.
try {
    $inbox->fetch(9);
} catch (IOError $error) {
    echo $error->message, "\n";
}
