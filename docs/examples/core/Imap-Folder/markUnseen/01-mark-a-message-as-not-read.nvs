<?nvs
// Shows how to mark a read message as not read, so that it shows as new again.

use Core\Imap;

var $inbox = Imap::open('shop')->folder('INBOX');

// Both messages are read. Nobody has answered message 2 yet, so the script marks it as new.
$inbox->markUnseen(2);

// This prints "new: 2 Can I change my address?".
foreach ($inbox->search({ unseen: true }) as int $uid) {
    echo 'new: ', $uid, ' ', $inbox->fetch($uid)->subject(), "\n";
}

// This marks the message as read again, so the example prints the same each time it runs.
$inbox->markSeen(2);
