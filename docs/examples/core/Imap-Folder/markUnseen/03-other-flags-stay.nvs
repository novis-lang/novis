<?nvs
// Shows that `markUnseen` removes only `\Seen`, and the other flags of the message stay.

use Core\IO;
use Core\Imap;

var $inbox = Imap::open('support')->folder('INBOX');

// A `directory` block is a folder on disk that works like a mailbox, for tests and local work.
// In such a block, the file `1.flags` has the flags of message 1, one per line.
echo "before:\n", IO::readText('support/INBOX/1.flags');

$inbox->markUnseen(1);

// The message is still `\Flagged`. This prints only "\Flagged".
echo "after:\n", IO::readText('support/INBOX/1.flags');

// This marks the message as read again, so the example prints the same each time it runs.
$inbox->markSeen(1);
