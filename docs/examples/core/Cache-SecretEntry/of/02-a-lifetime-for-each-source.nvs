<?nvs
// Shows that every source gets the lifetime it deserves, because the entry
// carries the lifetime and not the store.

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

var $cache = Core\Cache::local();

// A short-lived access token. The service replaces it every few minutes, so
// the entry may only be used for two.
var $accessToken = fn (): Core\Cache\SecretEntry =>
    Core\Cache\SecretEntry::of("at-7f3c9b21", 2m);

// A signing key from the same service. It is changed twice a year, so this
// entry may be used for a day.
var $signingKey = fn (): Core\Cache\SecretEntry =>
    Core\Cache\SecretEntry::of("sk-0a51d7", 1d);

// Both entries live in the same store under names of their own. This prints
// both secrets are in the store.
var $token = $cache->getSecret("access-token", $keys, {fill: $accessToken});
var $signer = $cache->getSecret("signing-key", $keys, {fill: $signingKey});
echo $token != null && $signer != null
    ? "both secrets are in the store"
    : "one of the secrets is missing", "\n";

// A lifetime of zero is already over, so nothing is stored. The next read is
// a miss, and this prints nothing was kept.
var $once = fn (): Core\Cache\SecretEntry => Core\Cache\SecretEntry::of("one-time", 0s);
$cache->getSecret("one-time-code", $keys, {fill: $once});
echo $cache->getSecret("one-time-code", $keys) == null ? "nothing was kept" : "it was kept", "\n";
