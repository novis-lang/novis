<?nvs
// Shows how to take the part of a line that comes before a separator.

// `Core\Str::before` finds the first "=" and returns the text before it.
// This prints `color`.
echo Core\Str::before("color=dark=blue", "=") ?? "(none)", "\n";

// The separator is at the start, so the result is an empty string.
// This prints `[]`.
echo "[", Core\Str::before("=dark", "=") ?? "(none)", "]\n";

// The separator is not in the string, so the result is `null`.
// This prints `(none)`.
echo Core\Str::before("no separator here", "=") ?? "(none)", "\n";
