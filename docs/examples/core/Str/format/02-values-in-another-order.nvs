<?nvs
// Shows how a template can use its values in a different order, as a translated sentence often needs.

// `%1$s` is the first value and `%2$d` is the second. Both templates get the same values.
string $english = "%1\$s has %2\$d new messages\n";
string $german = "%2\$d neue Nachrichten für %1\$s\n";

// This prints `Ada has 4 new messages` and then `4 neue Nachrichten für Ada`.
echo Core\Str::format($english, "Ada", 4);
echo Core\Str::format($german, "Ada", 4);
