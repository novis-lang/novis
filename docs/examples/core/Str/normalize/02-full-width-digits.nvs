<?nvs
// Shows how `Nfkc` changes full-width digits, which some Asian keyboards type,
// into the digits `0` to `9`.

string $typed = "１２３";

// `as ?int` converts a value to a whole number. `１２３` is not written with
// the digits `0` to `9`, so the result is `null`, and this prints `0`.
echo ($typed as ?int) ?? 0, "\n";

// After `Nfkc`, the text is `123`. This prints `123` and then `124`.
string $digits = Core\Str::normalize($typed, Core\NormalForm::Nfkc);
echo $digits, "\n";
echo (($digits as ?int) ?? 0) + 1, "\n";
