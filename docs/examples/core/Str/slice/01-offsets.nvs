<?nvs
// Shows how to take a part of a text by its position.

var $s = "Hello, World!";

// Without a length, the part runs to the end. This prints `World!`.
echo Core\Str::slice($s, 7), "\n";
// The first five characters. This prints `Hello`.
echo Core\Str::slice($s, 0, 5), "\n";
// A negative offset counts from the end. This prints `World`.
echo Core\Str::slice($s, -6, 5), "\n";
