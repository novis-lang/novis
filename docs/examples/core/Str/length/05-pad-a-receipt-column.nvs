<?nvs
// Lining up a receipt. A column's width is a count of characters, so the
// prices line up whether the item name is plain ASCII or not.

array<array<string>> $items = [
    ["Espresso", "2.40"],
    ["Café crème", "3.10"],
    ["Brötchen", "1.20"],
];

uint $width = 0;
foreach ($items as array<string> $item) {
    var $n = Core\Str::length($item[0]);
    if ($n > $width) {
        $width = $n;
    }
}

foreach ($items as array<string> $item) {
    var $pad = $width - Core\Str::length($item[0]);
    echo $item[0], Core\Str::repeat(" ", $pad), "  ", $item[1], "\n";
}
