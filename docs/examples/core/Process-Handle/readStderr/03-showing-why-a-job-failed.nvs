<?nvs
// Shows how to report why a job failed, with the error message the job wrote.
// requires: unix

// This job prints its progress, then fails with an error message and exit code 1.
var $job = Core\Process::spawn(
    "/bin/sh",
    ["-c", 'echo "copying 3 files"; echo "cannot copy report.pdf: permission denied" >&2; exit 1'],
);

// The progress is printed as it arrives.
?bytes $part = $job->readStdout();
while ($part != null) {
    echo ($part as string);
    $part = $job->readStdout();
}

// The error message is kept, so it can be shown if the job fails.
string $message = "";
$part = $job->readStderr();
while ($part != null) {
    $message = $message . ($part as string);
    $part = $job->readStderr();
}

// The exit code is 1, so this prints the error message.
int $code = $job->wait()->exitCode();
if ($code != 0) {
    echo "the job failed with exit code ", $code, ": ", $message;
}
