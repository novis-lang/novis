<?nvs
// Shows that `wait()` returns only the output that `readStdout()` did not read yet.
// requires: unix

// This program prints one line, waits one second, and prints a second line.
var $program = Core\Process::spawn("/bin/sh", ["-c", "echo first; sleep 1; echo second"]);

// `readStdout()` reads the first line. This prints `read: first`.
?bytes $part = $program->readStdout();
echo "read: ", $part as string;

// The result of `wait()` has only the second line. This prints `wait: second`.
echo "wait: ", $program->wait()->stdout() as string;
