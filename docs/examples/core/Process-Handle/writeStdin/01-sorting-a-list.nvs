<?nvs
// Shows how to give a list to another program and read its answer.
// requires: unix

// `sort` reads lines from its input and writes them back in order.
var $sorter = Core\Process::spawn("/usr/bin/sort", []);

// Each call sends one name. `as bytes` converts the text to the `bytes` that `writeStdin` needs.
// The input stays open between the calls.
array<string> $names = ["Charlie", "Alice", "Bob"];
foreach ($names as string $name) {
    $sorter->writeStdin(($name . "\n") as bytes);
}

// `wait()` closes the input. `sort` then writes the sorted list and ends.
// This prints Alice, Bob and Charlie, one on each line.
echo $sorter->wait()->stdout() as string;
