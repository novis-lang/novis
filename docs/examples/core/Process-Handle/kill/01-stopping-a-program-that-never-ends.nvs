<?nvs
// Shows how to stop a program that would otherwise run forever.
// requires: unix

// `yes` prints the same line again and again, and never stops by itself.
var $endless = Core\Process::spawn("/usr/bin/yes", ["ready"]);

// This reads one part of the output, and prints its first line: `ready`.
?bytes $part = $endless->readStdout();
echo Core\Str::lines($part as string)[0], "\n";

// `kill()` stops the program. `wait()` then returns its exit code.
// A stopped program has no exit code of its own, so this prints `-1`.
$endless->kill();
echo $endless->wait()->exitCode(), "\n";
