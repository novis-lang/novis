<?nvs
// Shows how to read a table that is too large to hold in memory, one object at
// a time.
use Core\Db\Derive;

// `#[Derive]` writes the code that fills this class from a row. Each property
// takes the column of the same name.
#[Derive]
class Note {
    public uint $id;
    // A text column arrives as `tainted`, because the value comes from the
    // database.
    public tainted string $text;

    public function constructor(uint $id, tainted string $text)
    {
        $this->id = $id;
        $this->text = $text;
    }
}

var $db = Core\Db::connect('notes');
$db->execute('create table notes (id integer primary key, text text not null)', []);
$db->execute('insert into notes (text) values (?), (?), (?)', ['buy milk', 'call Ana', 'book train']);

// Each step reads one row and builds one `Note` from it. The object before it
// is gone by then.
foreach ($db->streamAs<Note>('select id, text from notes order by id', []) as Note $note) {
    echo $note->id, ': ', $note->text, "\n";
}

$db->close();
