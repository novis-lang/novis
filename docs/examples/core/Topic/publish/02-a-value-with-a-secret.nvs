<?nvs
// Shows that a value with a `secret` property cannot be published.

// A `secret` property is a value the program must not show or send.
// It is never copied to another connection.
class Login {
    public string $user = "ana";
    public secret string $password = "correct horse";
}

try {
    Core\Topic::publish("logins", new Login());
} catch (LogicError $error) {
    // This prints the error message, which names the `secret` property.
    echo $error->message, "\n";
}

// Without the password, the value can be published.
// Nobody subscribed to `logins`, so this prints `0`.
echo Core\Topic::publish("logins", ["user" => "ana"]), "\n";
