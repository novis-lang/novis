<?nvs
// Shows how a command-line tool saves its list of jobs to a file and loads it on the next run.

class Job
{
    public string $name;
    public uint $tries;
    public function constructor(string $name, uint $tries)
    {
        $this->name = $name;
        $this->tries = $tries;
    }
}

class JobList
{
    public array<Job> $jobs = [];
}

JobList $list = new JobList();
$list->jobs[] = new Job('send-invoices', 0);
$list->jobs[] = new Job('resize-images', 2);

// `Core\Serialize::encode` gives `bytes`. `Core\IO::write` saves them to the file as they are.
string $path = Core\Path::join(Core\IO::temporaryDir(), 'jobs.bin');
Core\IO::write($path, Core\Serialize::encode($list));

// On the next run, the tool reads the bytes back and builds the list again.
bytes $saved = Core\IO::readBytes($path);
JobList $loaded = Core\Serialize::decode($saved) as JobList;

// This prints each job and how many times it was tried.
foreach ($loaded->jobs as Job $job) {
    echo $job->name, ': ', $job->tries, "\n";
}
