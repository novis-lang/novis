<?nvs
// Shows how the passkeys an account already has go into the options for a new one.
// requires: redis

Core\Session::start();

// The account already has a passkey on a laptop. The application stored its four values.
// Here they are made up: an Ed25519 public key from `Core\Crypto`, and a random id.
var $key = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519);
bytes $raw = $key->publicKey()->write(Core\Crypto\PublicKey::Format::Raw);
bytes $publicKey = Core\Bytes::join([Core\Encoding::fromHex('a4010103272006215820'), $raw]);
Core\Passkey\Credential $laptop = Core\Passkey\Credential::of(
    Core\Random::bytes(16),
    $publicKey,
    Core\Passkey\Credential::Algorithm::Ed25519,
    0,
);

// `$existing` lists the passkeys the account has. The laptop does not create a second one.
string $json = Core\Passkey::registerOptions('example.com', 'Example Shop', Core\Random::bytes(16), 'ada@example.com', [$laptop]);

// The options list the laptop's passkey under `excludeCredentials`. This prints `1`.
var $options = Core\Json::decode($json) as array<mixed>;
var $excluded = $options['excludeCredentials'] as array<mixed>;
echo 'excluded passkeys: ', Core\Arr::count($excluded), "\n";

// The id in the options is the stored id, written in base64url.
var $first = $excluded[0] as array<mixed>;
bool $same = ($first['id'] as string) == Core\Encoding::toBase64Url($laptop->id());
echo 'it is the laptop: ', $same ? 'yes' : 'no', "\n";
