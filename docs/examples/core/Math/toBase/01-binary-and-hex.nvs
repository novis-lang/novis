<?nvs
// Shows how to write a number in binary, octal and hexadecimal.

// This prints 1010, 12 and a.
echo Core\Math::toBase(10, 2), "\n";
echo Core\Math::toBase(10, 8), "\n";
echo Core\Math::toBase(10, 16), "\n";

// Digits above 9 are lower case letters. This prints ff and zz.
echo Core\Math::toBase(255, 16), "\n";
echo Core\Math::toBase(1295, 36), "\n";

// A negative number starts with `-`. This prints -ff.
echo Core\Math::toBase(-255, 16), "\n";

// Zero is the digit 0 in every base. This prints 0.
echo Core\Math::toBase(0, 2), "\n";
