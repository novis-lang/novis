<?nvs
// Shows the greatest common divisor of a few pairs of numbers.

// 6 is the largest number that divides both 12 and 18. This prints 6.
echo Core\Math::gcd(12, 18), "\n";

// 7 divides 49, so 7 is the result. This prints 7.
echo Core\Math::gcd(7, 49), "\n";

// 17 and 5 have no common divisor except 1. This prints 1.
echo Core\Math::gcd(17, 5), "\n";
