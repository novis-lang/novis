<?nvs
// Shows the result for `NaN`, and what happens when two values cannot be compared.

// `NaN` is smaller than every other `float`. This prints NAN.
echo Core\Math::min(Core\Math::NAN, 0.0), "\n";

// This also prints NAN, even beside the smallest possible `float`.
echo Core\Math::min(-Core\Math::INFINITY, Core\Math::NAN), "\n";

// A number and a string cannot be compared. This throws a `RuntimeError`.
mixed $count = 5;
mixed $label = "5";
try {
    echo Core\Math::min($count, $label), "\n";
} catch (RuntimeError $error) {
    echo "These two values cannot be compared.\n";
}
