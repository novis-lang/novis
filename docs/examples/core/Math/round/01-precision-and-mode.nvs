<?nvs
// Shows how `precision` and `mode` change the result of rounding.

// Two decimal places are kept. This prints 3.14.
echo Core\Math::round(3.14159, {precision: 2}), "\n";

// A half rounds away from zero by default. This prints 3, then -3.
echo Core\Math::round(2.5), "\n";
echo Core\Math::round(-2.5), "\n";

// `HalfEven` rounds a half to the even neighbour. This prints 2.
echo Core\Math::round(2.5, {mode: Core\RoundMode::HalfEven}), "\n";
