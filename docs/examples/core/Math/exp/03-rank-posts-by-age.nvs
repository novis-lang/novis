<?nvs
// Shows how a website ranks posts so that a new post can come before an older one with more votes.

class Ranking {
    // Returns the score of a post, with one decimal place.
    // A vote loses value as the post gets older. After 24 hours, it counts about a third.
    public static function score(float $votes, float $hours): float {
        return Core\Math::round($votes * Core\Math::exp(-$hours / 24.0), {precision: 1});
    }
}

// A new post: 40 votes, 2 hours old. This prints 36.8.
echo Ranking::score(40.0, 2.0), "\n";

// A post from this morning: 60 votes, 12 hours old. This prints 36.4.
echo Ranking::score(60.0, 12.0), "\n";

// A post from two days ago: 150 votes, 48 hours old. This prints 20.3.
echo Ranking::score(150.0, 48.0), "\n";
