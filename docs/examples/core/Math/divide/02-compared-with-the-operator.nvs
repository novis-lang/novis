<?nvs
// Shows how `Core\Math::divide` differs from the `/` operator when the divisor is zero.

float $zero = 0.0;

// The `/` operator throws an `ArithmeticError`. This prints "Division by zero".
try {
    echo 5.0 / $zero, "\n";
} catch (ArithmeticError $error) {
    echo $error->message, "\n";
}

// `Core\Math::divide` returns a value. This prints INF.
echo Core\Math::divide(5.0, $zero), "\n";

// `-$zero` is a zero with a minus sign. A positive number divided by it is
// negative, so this prints -INF.
echo Core\Math::divide(5.0, -$zero), "\n";
