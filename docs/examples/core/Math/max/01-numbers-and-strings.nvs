<?nvs
// Shows the larger of two numbers, and the larger of two strings.

// This prints 7, in either order.
echo Core\Math::max(3, 7), "\n";
echo Core\Math::max(7, 3), "\n";

// This prints 2.5.
echo Core\Math::max(2.25, 2.5), "\n";

// -1 is larger than -10. This prints -1.
echo Core\Math::max(-10, -1), "\n";

// Strings are compared by their characters. This prints "pear".
echo Core\Math::max("apple", "pear"), "\n";
