<?nvs
// Shows the hyperbolic sine of a few numbers.

// The result at zero is 0. This prints 0.
echo Core\Math::sinh(0.0), "\n";

// A negative number gives the same result with a minus sign.
// These lines print 1.1752011936438 and -1.1752011936438.
echo Core\Math::sinh(1.0), "\n";
echo Core\Math::sinh(-1.0), "\n";
