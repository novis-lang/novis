<?nvs
// Shows how a planning tool finds how far a cable between two poles hangs down in the middle.

class Cable {
    // `$tension` is a number for how tight the cable is. A bigger number means a tighter cable.
    public static function sag(float $span, float $tension): float {
        float $drop = $tension * (Core\Math::cosh($span / (2.0 * $tension)) - 1.0);
        return Core\Math::round($drop, {precision: 2});
    }
}

// Two poles 100 meters apart. This prints 6.28, so the cable hangs 6.28 meters down.
echo Cable::sag(100.0, 200.0), "\n";

// A tighter cable hangs less. This prints 2.5.
echo Cable::sag(100.0, 500.0), "\n";
