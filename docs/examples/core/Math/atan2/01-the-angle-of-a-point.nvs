<?nvs
// Shows the angles `Core\Math::atan2` returns for one point on each side of the axes.

// The y coordinate comes first. This prints 45.
echo Core\Math::toDegrees(Core\Math::atan2(1.0, 1.0)), "\n";

// You can name the arguments, so the order is clear. This prints 135.
echo Core\Math::toDegrees(Core\Math::atan2(y: 1.0, x: -1.0)), "\n";

// A point below the x-axis gives a negative angle. This prints -135 and -45.
echo Core\Math::toDegrees(Core\Math::atan2(-1.0, -1.0)), "\n";
echo Core\Math::toDegrees(Core\Math::atan2(-1.0, 1.0)), "\n";
