<?nvs
// Shows how to send a secret token to another server in a JSON body.

// The server's reply is fixed here, so the example runs without a network.
Core\Test::answerHttp('https://pay.example.com/refunds', 201, { body: 'refund created' });

// The `[secrets]` block of `nvs.toml` sets `payment_token`.
secret string $token = Core\Config::secret('payment_token') ?? '';

// A JSON body accepts a secret. This prints `201 refund created`.
var $response = Core\Http\Client::post('https://pay.example.com/refunds', { json: ['token' => $token, 'order' => 381] });
echo $response->status(), ' ', $response->text(), "\n";
