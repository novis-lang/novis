<?nvs
// Shows how a program stops with a clear message when a secret it needs is not set.

class Secrets
{
    // Returns the secret `$name`, or throws an error when no block sets it.
    public static function required(string $name): secret string
    {
        var $value = Core\Config::secret($name);
        if ($value == null) {
            throw new RuntimeError("the secret {$name} is not set in nvs.toml");
        }
        return $value;
    }
}

// `api_key` is set, so this prints `the shop has its API key`.
secret string $key = Secrets::required('api_key');
echo "the shop has its API key\n";

// `mail_password` is not set, so this prints the error message.
// The message has the name of the secret. It never has the value.
try {
    secret string $mail = Secrets::required('mail_password');
    echo "the shop can send mail\n";
} catch (RuntimeError $error) {
    echo 'The shop cannot start: ', $error->message, "\n";
}
