<?nvs
// Shows what a change that is not allowed looks like. `Core\Config::set`
// returns `false` and leaves the old value in force. It throws no error, so a
// program that needs to know reads the result.

// Only the person who runs the server may set this one. A name written directly in
// the call does not compile. This name is in a variable, so the call runs and returns `false`.
string $operatorOnly = 'opcache.file_cache_dir';
echo Core\Config::set($operatorOnly, '/tmp/nvs') ? 'changed' : 'not allowed', "\n";

// This name is no setting at all.
string $unknown = 'my.own.setting';
echo Core\Config::set($unknown, '1') ? 'changed' : 'not allowed', "\n";

// A memory limit is a size, so this value cannot be read as one.
echo Core\Config::set('memory', 'as much as you like') ? 'changed' : 'not allowed', "\n";
