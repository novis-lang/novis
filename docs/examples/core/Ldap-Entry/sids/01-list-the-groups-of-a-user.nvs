<?nvs
// Shows how to list the security groups of a user by their RID.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $person = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['tokenGroups'] });

if ($person != null) {
    // The server sends the SIDs in no fixed order, so the RIDs are sorted.
    array<int> $rids = [];
    foreach ($person->sids('tokenGroups') ?? [] as Core\Ldap\Sid $group) {
        $rids[] = $group->rid();
    }

    // 513 is `Domain Users` and 545 is `Users`. The other two are `Employees` and `Managers`.
    // This prints 513, 545, 1104 and 1105, one on each line.
    foreach (Core\Arr::sort($rids) as int $rid) {
        echo $rid, "\n";
    }
}
