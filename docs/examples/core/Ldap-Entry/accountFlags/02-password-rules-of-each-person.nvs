<?nvs
// Shows how to read the password state of a few people from their account flags.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
array<string> $dns = [
    'CN=Anna Berg,OU=Company,DC=example,DC=test',
    'CN=Ben Kohl,OU=Company,DC=example,DC=test',
    'CN=Carla Diaz,OU=Company,DC=example,DC=test',
];

foreach ($dns as string $dn) {
    // When you select `userAccountControl`, the search also reads `pwdLastSet`
    // and the flags Active Directory computes, such as `passwordExpired`.
    var $person = $corp->read($dn, { select: ['userAccountControl'] });
    var $flags = $person?->accountFlags();
    if ($person == null || $flags == null) {
        continue;
    }
    // This prints `Anna Berg: ok`, `Ben Kohl: never expires`
    // and `Carla Diaz: must change it`.
    string $state = 'ok';
    if ($flags->passwordNeverExpires()) {
        $state = 'never expires';
    }
    if ($flags->mustChangePassword()) {
        $state = 'must change it';
    }
    echo $person->dn()->rdnValue(), ': ', $state, "\n";
}
