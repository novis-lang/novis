<?nvs
// Shows how to read how long a password lasts in a domain.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $domain = $corp->read('DC=example,DC=test', { select: ['maxPwdAge', 'minPwdAge'] });

if ($domain != null) {
    // This prints `A password must be changed after 6w.`
    echo 'A password must be changed after ', $domain->duration('maxPwdAge')?->toString() ?? 'never', ".\n";

    // This prints `A new password can be changed after 1d.`
    echo 'A new password can be changed after ', $domain->duration('minPwdAge')?->toString() ?? 'any time', ".\n";
}
