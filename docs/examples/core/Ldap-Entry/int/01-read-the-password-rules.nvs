<?nvs
// Shows how to read the password rules of a domain as whole numbers.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $domain = $corp->read('DC=example,DC=test', { select: ['minPwdLength', 'pwdHistoryLength'] });

if ($domain != null) {
    // This prints `A password has at least 7 characters.`
    int $length = $domain->int('minPwdLength') ?? 0;
    echo 'A password has at least ', $length, " characters.\n";

    // This prints `The last 24 passwords cannot be used again.`
    echo 'The last ', $domain->int('pwdHistoryLength') ?? 0, " passwords cannot be used again.\n";
}
