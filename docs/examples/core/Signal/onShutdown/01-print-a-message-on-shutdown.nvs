<?nvs
// Shows how to print a message when the program is asked to stop.

// This function runs only if the program gets a stop signal, such as Ctrl-C.
Core\Signal::onShutdown(fn (): void => {
    echo "Stopping. Goodbye.\n";
});

// Nothing asks this program to stop, so the message above is not printed.
echo "The program is running.\n";
echo "The program is done.\n";
