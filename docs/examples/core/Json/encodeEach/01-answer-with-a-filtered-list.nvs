<?nvs
// Shows a request that gets back the products in stock, as a JSON array sent in pieces.

#[Core\Json\Derive]
class Product
{
    public string $sku;
    public int $stock;

    public function constructor(string $sku, int $stock)
    {
        $this->sku = $sku;
        $this->stock = $stock;
    }
}

class Stock
{
    // This function gives the products in stock, one at a time.
    public static function available(): Iterator<Product>
    {
        array<Product> $all = [new Product('MUG-01', 12), new Product('LID-02', 0), new Product('CUP-07', 30)];
        foreach ($all as Product $product) {
            if ($product->stock > 0) {
                yield $product;
            }
        }
    }
}

// `Core\Response::stream` starts the body and sets its content type to `application/json`.
Core\Response\Stream $out = Core\Response::stream('application/json');

// The pieces are `bytes`, because no product contains text from a request.
// This sends `[{"sku":"MUG-01","stock":12},{"sku":"CUP-07","stock":30}]`.
foreach (Core\Json::encodeEach(Stock::available()) as bytes $piece) {
    $out->write($piece);
}
