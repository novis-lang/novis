<?nvs
// Shows the error `Core\Json::decodeAs` throws when the document does not match the class.

#[Core\Json\Derive]
class Product {
    public string $name;
    public int $cents;

    public function constructor(string $name, int $cents) {
        $this->name = $name;
        $this->cents = $cents;
    }
}

// `name` is missing, and `cents` is a string. Both are errors.
string $text = "{\"cents\":\"cheap\"}";

// The call throws one `ParseError`. Its `issues` list has one entry for each wrong field,
// with the field's path and a message.
try {
    Core\Json::decodeAs<Product>($text);
    echo "decoded\n";
} catch (ParseError $error) {
    // This prints the number of problems, and then the path and message of each one.
    echo Core\Arr::count($error->issues), " problems\n";
    foreach ($error->issues as {path: string, message: string} $issue) {
        echo $issue->path, ": ", $issue->message, "\n";
    }
}
