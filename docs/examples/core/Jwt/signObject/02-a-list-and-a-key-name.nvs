<?nvs
// Shows how to sign a claim that is a list, and how to name the key in the token's header.

#[Core\Json\Derive]
final class Grant {
    public string $sub;
    public array<string> $roles;

    public function constructor(string $sub, array<string> $roles) {
        $this->sub = $sub;
        $this->roles = $roles;
    }
}

// A `P256` key pair signs with the algorithm `ES256`.
Core\Crypto\KeyPair $pair = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256);

// The `kid` option writes a name for the key into the token's header.
// A service that has several keys uses this name to find the right one.
string $token = Core\Jwt::signObject(new Grant("42", ["editor", "viewer"]), 1h, $pair, {kid: "2026-key"});
array<string> $parts = Core\Str::split($token, ".");

// The first part is the header. This prints `{"alg":"ES256","kid":"2026-key","typ":"JWT"}`.
echo Core\Encoding::fromBase64Url($parts[0]) as string, "\n";

// The second part is the payload. `roles` is a JSON list in it.
// This prints `editor` and `viewer`.
string $payload = Core\Encoding::fromBase64Url($parts[1]) as string;
var $claims = Core\Json::decodeAs<{sub: string, roles: array<string>, iat: int, exp: int}>($payload);
foreach ($claims->roles as string $role) {
    echo $role, "\n";
}
