<?nvs
// Shows that `error()` returns `null` when the script caught its error.

Core\Script::onExit(fn (Core\Script\ExitReport $report): void => {
    ?Throwable $error = $report->error();
    // This prints "no error".
    if ($error == null) {
        echo "no error\n";
    }
});

try {
    throw new RuntimeError("the cache is empty");
} catch (RuntimeError $caught) {
    // The error is caught here, so it does not end the script.
    echo "caught: ", $caught->message, "\n";
}
