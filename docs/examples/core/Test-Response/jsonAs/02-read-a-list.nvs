<?nvs
// Shows how to read a JSON array of objects into a list of your own class.

use Core\Http\Method;
use Core\Test;

#[Core\Json\Derive]
class Product {
    public string $sku;
    public int $price;

    public function constructor(string $sku, int $price) {
        $this->sku = $sku;
        $this->price = $price;
    }
}

try {
    // This part answers each request. It sends a list of two products.
    var $path = Core\Request::path();
    Core\Response::json([["sku" => "mug-7", "price" => 12], ["sku" => "cup-2", "price" => 8]]);
} catch (LogicError $noRequest) {
    var $response = Test::request(Method::Get, "/products");

    // `array<Product>` creates one `Product` for each element.
    var $products = $response->jsonAs<array<Product>>();

    // This prints `mug-7` and then `cup-2`.
    foreach ($products as Product $product) {
        echo $product->sku, "\n";
    }
}
