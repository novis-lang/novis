<?nvs
// Shows which value you get when the program sets one cookie twice.

use Core\Http\Method;
use Core\Test;

if (Core\Env::context() == Core\Env::Context::Request) {
    // This part answers each request. It sets `theme` twice.
    Core\Response::addCookie('theme', 'light');
    Core\Response::addCookie('lang', 'en');
    Core\Response::addCookie('theme', 'dark');
} else {
    var $response = Test::request(Method::Get, '/settings');

    // A browser keeps the last value, and so does `cookies()`. This prints `dark`.
    echo $response->cookies()['theme'], "\n";

    // `headers()` still has all three lines. This prints `3`.
    echo Core\Arr::count($response->headers()['set-cookie']), "\n";
}
