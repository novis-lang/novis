<?nvs
// Shows what `headers()` returns when the program throws an error while it answers.

use Core\Http\Method;
use Core\Test;

try {
    // This part answers each request. It sets a header, and then throws
    // an error it does not catch.
    var $path = Core\Request::path();
    Core\Response::setHeader("Cache-Control", "no-store");
    throw new RuntimeError("the database is not available");
} catch (LogicError $noRequest) {
    var $response = Test::request(Method::Get, "/report");

    // The server does not send the headers of a failed request, so the
    // array is empty. This prints `500 0`.
    echo $response->status(), " ", Core\Arr::count($response->headers()), "\n";
}
