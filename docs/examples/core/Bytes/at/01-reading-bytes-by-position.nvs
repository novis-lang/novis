<?nvs
// Shows how to read single bytes out of a `bytes` value. Each byte comes back
// as a number from 0 to 255.

// There is no way to write bytes directly in a program, so this converts text.
bytes $data = "Hi!" as bytes;

// Position 0 is the first byte. This prints 72, 105 and 33.
echo Core\Bytes::at($data, 0), "\n";
echo Core\Bytes::at($data, 1), "\n";
echo Core\Bytes::at($data, 2), "\n";
