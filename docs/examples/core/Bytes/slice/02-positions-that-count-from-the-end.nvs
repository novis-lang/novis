<?nvs
// Shows the positions that count from the end of a value. A negative position
// starts there, and a negative length stops there.

bytes $record = "2026-09-21T08:15:00Z" as bytes;

// The last byte is at position -1. This prints "Z".
echo Core\Bytes::slice($record, -1) as string, "\n";

// A length of -1 stops one byte before the end. This prints
// "2026-09-21T08:15:00".
echo Core\Bytes::slice($record, 0, -1) as string, "\n";

// A position after the end gives a value with nothing in it. This prints 0.
echo Core\Bytes::length(Core\Bytes::slice($record, 99)), "\n";
