<?nvs
// Shows that a class also lists the methods it inherits from its parent class.

class Shape {
    public function describe(): string {
        return "a shape";
    }
}

class Square extends Shape {
    public function area(int $side): int {
        return $side * $side;
    }
}

// `Square` declares only `area`. It also inherits `describe` from `Shape`.
// This prints `area` and `describe`.
foreach (Core\Reflect::forObject(new Square())->methods() as Core\Reflect\MethodInfo $method) {
    echo $method->name(), "\n";
}
