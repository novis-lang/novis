<?nvs
// Shows how to check that a browser's subscription no longer exists.

// The push service replies with 410, which means "gone". `Core\Test::answerHttp`
// gives this fixed reply, so the example runs without a network.
Core\Test::answerHttp('https://push.example.com/send/*', 410, {});

string $json = '{"endpoint":"https://push.example.com/send/old-phone","keys":{'
    . '"p256dh":"BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4",'
    . '"auth":"BTBZMqHH6r4Tts7J_aSIgg"}}';
Core\WebPush\Subscription $to = Core\WebPush::subscription($json);
Core\Crypto\KeyPair $vapid = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256);
bytes $payload = Core\Encoding::encodeText('Your order has shipped.', Core\Charset::Utf8);

Core\WebPush\Sent $sent = Core\WebPush::send($to, $payload, $vapid, 'mailto:admin@example.com');

// `gone()` is `true`, so this prints `The subscription is gone.`
if ($sent->gone()) {
    echo "The subscription is gone.\n";
}
