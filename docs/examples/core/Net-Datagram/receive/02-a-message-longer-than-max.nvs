<?nvs
// Shows what `receive` keeps when a message is longer than `$max`.

Core\Net\Datagram $server = Core\Net::bindDatagram("127.0.0.1", 0);
Core\Net\Datagram $client = Core\Net::bindDatagram("127.0.0.1", 0);
$client->send("127.0.0.1", $server->port(), "hello world" as bytes, 1s);
$client->send("127.0.0.1", $server->port(), "second" as bytes, 1s);

// The first message has 11 bytes, and `$max` is 5. This prints `kept: hello`.
echo "kept: ", $server->receive(5, 5s)->payload() as string, "\n";

// The other 6 bytes are lost. The next call returns the next message.
// This prints `next: second`.
echo "next: ", $server->receive(64, 5s)->payload() as string, "\n";

$client->close();
$server->close();
