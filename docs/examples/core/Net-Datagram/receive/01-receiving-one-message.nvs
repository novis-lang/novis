<?nvs
// Shows how to wait for one UDP message and see who sent it.

Core\Net\Datagram $server = Core\Net::bindDatagram("127.0.0.1", 0);
Core\Net\Datagram $client = Core\Net::bindDatagram("127.0.0.1", 0);
$client->send("127.0.0.1", $server->port(), "ping" as bytes, 1s);

// `receive` keeps at most 64 bytes and waits at most 5 seconds.
// It returns a `Core\Net\Datagram\Message`.
Core\Net\Datagram\Message $message = $server->receive(64, 5s);

// This prints `payload: ping` and `from: 127.0.0.1`.
echo "payload: ", $message->payload() as string, "\n";
echo "from: ", $message->host(), "\n";

// The message came from the port of `$client`. This prints `from the client: yes`.
echo "from the client: ", $message->port() == $client->port() ? "yes" : "no", "\n";

$client->close();
$server->close();
