<?nvs
// Shows how to close a UDP socket when you are done with it.

Core\Net\Datagram $server = Core\Net::bindDatagram("127.0.0.1", 0);
Core\Net\Datagram $client = Core\Net::bindDatagram("127.0.0.1", 0);
$client->send("127.0.0.1", $server->port(), "last message" as bytes, 1s);
Core\Net\Datagram\Message $message = $server->receive(64, 5s);

// `close` frees the port of each socket.
$client->close();
$server->close();

// The message has its own copy of the bytes, so it is still readable.
// This prints `still readable: last message`.
echo "still readable: ", $message->payload() as string, "\n";
