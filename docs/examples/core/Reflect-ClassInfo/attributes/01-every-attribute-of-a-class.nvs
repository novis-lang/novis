<?nvs
// Shows every attribute written on a class and where each one is written.

type Route = {path: string};

#[Route(path: "/users")]
class UserController {
    #[{column: "user_name"}]
    public string $name = "";

    #[Route(path: "/show")]
    public function show(#[{from: "query"}] int $id): int {
        return $id;
    }
}

var $info = Core\Reflect::forObject(new UserController());

// `attributes()` returns one entry for each attribute, in the order they are written.
// This prints 4, then one line for each attribute.
echo Core\Arr::count($info->attributes()), "\n";
foreach ($info->attributes() as Core\Reflect\AttributeInfo $attribute) {
    // `target()` is empty for an attribute on the class itself.
    string $where = $attribute->target() == "" ? "the class" : $attribute->target();
    if ($attribute->parameter() != "") {
        $where = $where . ", parameter $" . $attribute->parameter();
    }
    echo $where, "\n";
}
