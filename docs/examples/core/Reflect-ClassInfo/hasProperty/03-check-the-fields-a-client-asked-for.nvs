<?nvs
// Shows how an API checks the field names a client asked for before it reads them.

class Product {
    public string $sku = "A-100";
    public string $name = "Desk lamp";
    public string $colour = "black";
}

class Fields {
    public static function pick(Product $product, array<string> $asked): string {
        var $info = Core\Reflect::forObject($product);
        string $out = "";
        foreach ($asked as string $field) {
            // A field the class does not have is reported to the client, and nothing is read.
            if (!$info->hasProperty($field)) {
                $out = $out . "unknown field: " . $field . "\n";
                continue;
            }
            $out = $out . $field . "=" . ($info->get($product, $field) as string) . "\n";
        }
        return $out;
    }
}

// The client asked for `?fields=name,price,colour`. This prints the name, an error for
// `price`, and the colour.
echo Fields::pick(new Product(), ["name", "price", "colour"]);
