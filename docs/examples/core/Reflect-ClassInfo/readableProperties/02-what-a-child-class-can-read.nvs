<?nvs
// Shows that code in a child class can read the protected properties of its parent.

class Entry {
    public string $title = "Hello";
    protected int $views = 7;
    private string $draft = "notes";
}

class Post extends Entry {
    public function fields(): array<string> {
        var $found = Core\Reflect::forClass("Entry");
        if ($found == null) {
            return [];
        }
        return $found->readableProperties();
    }
}

// This prints `title` and `views`. The private property `draft` is not in the list,
// because only code in `Entry` can read it.
foreach ((new Post())->fields() as string $name) {
    echo $name, "\n";
}
