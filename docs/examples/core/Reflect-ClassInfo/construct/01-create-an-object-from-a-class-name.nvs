<?nvs
// Shows how to create an object when the name of its class is in a string.

class Point {
    public int $x;
    public int $y;

    public function constructor(int $x, int $y) {
        $this->x = $x;
        $this->y = $y;
    }
}

class Factory {
    public static function make(string $className, array<mixed> $arguments): mixed {
        var $info = Core\Reflect::forClass($className);
        if ($info == null) {
            return null;
        }
        // `construct` runs the constructor with the values in `$arguments`, in order.
        return $info->construct($arguments);
    }
}

// The result has the type `mixed`, so `as Point` converts it. This prints "3, 4".
var $point = Factory::make("Point", [3, 4]) as Point;
echo $point->x, ", ", $point->y, "\n";
