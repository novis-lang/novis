<?nvs
// Shows which constants a subclass has: its own, then the ones it inherits.

interface HasVersion {
    public const int VERSION = 2;
}

class Plan implements HasVersion {
    public const int USERS = 5;
    public const string SUPPORT = "email";
}

class TeamPlan extends Plan {
    public const int USERS = 50;
}

// `TeamPlan` declares `USERS` again, so `USERS` is in the list once.
// This prints "USERS", "SUPPORT" and "VERSION".
foreach (Core\Reflect::forObject(new TeamPlan())->constants() as Core\Reflect\ConstantInfo $constant) {
    echo $constant->name(), "\n";
}

// The value of `USERS` is the one `TeamPlan` declares. This prints 50.
echo Core\Reflect::forObject(new TeamPlan())->constant("USERS") as int, "\n";
