<?nvs
// Shows a small method that asks a system tool for one value and returns it as clean text.
// requires: unix

class Days {
    // `expr` calculates with whole numbers. A day has 86400 seconds, so this
    // returns how many whole days passed between 1970-01-01 and the timestamp.
    public static function since1970(int $timestamp): string {
        var $result = Core\Process::run("/bin/expr", [$timestamp as string, "/", "86400"]);
        if ($result->exitCode() != 0) {
            throw new RuntimeError("expr failed with exit code " . $result->exitCode());
        }
        // The output ends with a new line. `Core\Str::trim` removes it.
        return Core\Str::trim($result->stdout() as string);
    }
}

// This prints `19675` and then `1`.
echo Days::since1970(1700000000), "\n";
echo Days::since1970(86400), "\n";
