<?nvs
// Shows a method that throws an error with the tool's own message when the tool fails.
// requires: unix

class Folders {
    public static function list(string $folder): string {
        var $result = Core\Process::run("/bin/ls", [$folder]);
        if ($result->exitCode() != 0) {
            // The message from `ls` says what went wrong. `Core\Str::trim` removes the new line.
            string $message = Core\Str::trim($result->stderr() as string);
            throw new RuntimeError("could not list the folder: " . $message);
        }
        return $result->stdout() as string;
    }
}

// This folder has three folders, so `ls` prints their names.
echo Folders::list("docs/examples/core/Process-Result");

// This folder does not exist. The error contains the message from `ls`.
try {
    echo Folders::list("/no-such-folder");
} catch (RuntimeError $failed) {
    echo $failed->message, "\n";
}
