<?nvs
// Shows what a `true` covers. This program may read files in one directory.
// The capability is granted, and the exact file is checked again when the
// program opens it.

// The deployment granted `fs.read`, so this prints yes.
echo "read files: ", Core\Cap::has("fs.read") ? "yes" : "no", "\n";

// A file inside the granted directory opens.
echo Core\Str::trim(Core\IO::read("data/hours.txt")), "\n";

// A file outside that directory throws an error, even though the result above was yes.
// The message continues with the path, so the program prints only its first part.
try {
    Core\IO::read("nvs.toml");
} catch (RuntimeError $denied) {
    echo Core\Str::before($denied->message, " for "), "\n";
}
