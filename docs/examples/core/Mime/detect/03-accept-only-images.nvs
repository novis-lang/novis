<?nvs
// Shows how an upload form can accept images and reject every other kind of file.

class Avatar
{
    public static function accepts(Core\Request\Part $upload): bool
    {
        Core\Mime::Type $type = Core\Mime::detect($upload);
        return $type == Core\Mime::Type::Png
            || $type == Core\Mime::Type::Jpeg
            || $type == Core\Mime::Type::Webp;
    }
}

string $folder = Core\IO::temporaryDir();
foreach (Core\Request::files() as Core\Request\Part $part) {
    // The gzip file is rejected, because it is not one of the three image types.
    if (!Avatar::accepts($part)) {
        echo $part->filename(), ": rejected\n";
        continue;
    }
    // `detect` reads only the first bytes, so `saveTo` still writes the whole file.
    string $path = Core\IO::within($folder, $part->filename());
    $part->saveTo($path, { max: 2000000 });
    echo $part->filename(), ': accepted, ', Core\IO::size($path), " bytes saved\n";
}
