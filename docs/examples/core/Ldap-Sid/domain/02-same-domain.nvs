<?nvs
// Shows how to check if two SIDs are in the same domain.

var $ann = Core\Ldap\Sid::parse('S-1-5-21-1004336348-1177238915-682003330-1105');
var $ben = Core\Ldap\Sid::parse('S-1-5-21-1004336348-1177238915-682003330-1106');
var $other = Core\Ldap\Sid::parse('S-1-5-21-3623811015-3361044348-30300820-1013');
// This prints yes and then no.
echo $ann->domain()?->toString() == $ben->domain()?->toString() ? 'yes' : 'no', "\n";
echo $ann->domain()?->toString() == $other->domain()?->toString() ? 'yes' : 'no', "\n";
