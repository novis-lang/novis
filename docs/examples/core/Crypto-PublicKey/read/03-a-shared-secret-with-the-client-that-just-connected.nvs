<?nvs
// Shows a server that sets up an encrypted channel with a client. The client
// sends its public key, the server reads it, and both sides reach the same
// shared secret without sending it.

// The server's own key pair, read from its configuration.
Core\Crypto\KeyPair $server = Core\Crypto\KeyPair::read(
    Core\Encoding::fromHex("302e020100300506032b656e042204200172af48574da59d306df1b27cc27457304669fb73e0630b9f84eac038695c2c"),
    Core\Crypto\KeyKind::X25519
);

// What the client sent. A public key off the network is octets until you read
// it, and `read` is where it is checked.
Core\Crypto\PublicKey $client = Core\Crypto\PublicKey::read(
    Core\Encoding::fromHex("9c7be3a9c961ce008340674cd3d468fc5be27c98b65a35262ca2d05573d0585e"),
    Core\Crypto\KeyKind::X25519,
    Core\Crypto\KeyFormat::Raw
);

// `agree` gives the shared secret, and `expandKey` turns it into a key for this
// one session. The text is part of the key, so two sessions get two keys.
secret bytes $key = Core\Crypto::expandKey(
    Core\Crypto::agree($server, $client),
    "" as bytes,
    "chat session"
);
bytes $sealed = Core\Crypto::seal(
    "your order is on its way" as bytes,
    $key,
    Core\Crypto\Cipher::XChaCha20Poly1305
);

// The client has the server's public key and its own pair, so it reaches the
// same secret and opens the message. This prints `your order is on its way`.
Core\Crypto\KeyPair $clientPair = Core\Crypto\KeyPair::read(
    Core\Encoding::fromHex("302e020100300506032b656e042204201135b8655ccc4ea0b976d3a303d6b64b90e9f0b643f65e52288c25bdcebe4fa4"),
    Core\Crypto\KeyKind::X25519
);
secret bytes $clientKey = Core\Crypto::expandKey(
    Core\Crypto::agree($clientPair, $server->publicKey()),
    "" as bytes,
    "chat session"
);
echo Core\Crypto::open($sealed, $clientKey, Core\Crypto\Cipher::XChaCha20Poly1305) as string, "\n";
