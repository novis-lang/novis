<?nvs
// Shows how to read a key that a browser sent as a JWK. It is then written out
// again in the shorter `Spki` form, which is the one to store.

string $sentByTheBrowser = "{\"key_ops\":[\"verify\"],\"ext\":true,\"alg\":\"Ed25519\",\"crv\":\"Ed25519\",\"x\":\"_M6QCKM1ZSSFYSlafOHMywQLYSm7qP8kdElTu8ASYaw\",\"kty\":\"OKP\"}";

// A JWK is a small JSON document, and `read` takes it as UTF-8 octets. Its
// members are checked against the kind you name.
Core\Crypto\PublicKey $key = Core\Crypto\PublicKey::read(
    $sentByTheBrowser as bytes,
    Core\Crypto\KeyKind::Ed25519,
    Core\Crypto\KeyFormat::Jwk
);

// One key has one spelling in each encoding. The same key sent as `Raw` or as
// `Spki` writes the same line here. This prints the key as hex text.
echo Core\Encoding::toHex($key->write(Core\Crypto\KeyFormat::Spki)), "\n";
