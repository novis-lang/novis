<?nvs
// Shows why you name the kind when you read an RSA key. The octets of an RSA
// key are the same for both schemes, so the kind is the one you named.

bytes $sameOctets = Core\Encoding::fromHex("");

Core\Crypto\PublicKey $signing = Core\Crypto\PublicKey::read(
    $sameOctets,
    Core\Crypto\KeyKind::RsaPkcs1,
    Core\Crypto\KeyFormat::Spki
);
Core\Crypto\PublicKey $probabilistic = Core\Crypto\PublicKey::read(
    $sameOctets,
    Core\Crypto\KeyKind::RsaPss,
    Core\Crypto\KeyFormat::Spki
);

// Two keys out of one document, and each reports the scheme it was read as.
// This prints `RS256` and then `PS256`.
if ($signing->kind() == Core\Crypto\KeyKind::RsaPkcs1) {
    echo "RS256", "\n";
}
if ($probabilistic->kind() == Core\Crypto\KeyKind::RsaPss) {
    echo "PS256", "\n";
}
