<?nvs
// Shows how to go through an XML document one node at a time and print its elements.

Core\Xml\Reader $reader = Core\Xml::reader("<menu><item>Soup</item><item>Salad</item></menu>");

// `read` returns the next node, and `null` at the end of the document.
// `depth` is how many elements are open around that node.
while (true) {
    ?Core\Xml\Node $node = $reader->read();
    if ($node == null) {
        break;
    }
    // This prints `menu`, then `item` twice, one step further in.
    if ($node->kind() == Core\Xml\NodeKind::Element) {
        echo Core\Str::repeat("  ", $reader->depth()), $node->name(), "\n";
    }
}
