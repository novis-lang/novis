<?nvs
// Shows how the port tells apart two senders that are on the same computer.

Core\Net\Datagram $server = Core\Net::bindDatagram("127.0.0.1", 0);
Core\Net\Datagram $first = Core\Net::bindDatagram("127.0.0.1", 0);
Core\Net\Datagram $second = Core\Net::bindDatagram("127.0.0.1", 0);
$first->send("127.0.0.1", $server->port(), "a" as bytes, 1s);
$second->send("127.0.0.1", $server->port(), "b" as bytes, 1s);

Core\Net\Datagram\Message $one = $server->receive(64, 5s);
Core\Net\Datagram\Message $two = $server->receive(64, 5s);

// Both messages have the host `127.0.0.1`. This prints `same host: yes`.
echo "same host: ", $one->host() == $two->host() ? "yes" : "no", "\n";
// The ports are different. This prints `different ports: yes`.
echo "different ports: ", $one->port() != $two->port() ? "yes" : "no", "\n";

$first->close();
$second->close();
$server->close();
