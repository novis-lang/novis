<?nvs
// Shows how to find out which port a UDP message was sent from.

Core\Net\Datagram $server = Core\Net::bindDatagram("127.0.0.1", 0);
Core\Net\Datagram $client = Core\Net::bindDatagram("127.0.0.1", 0);
$client->send("127.0.0.1", $server->port(), "hello" as bytes, 1s);

// `port()` returns the port of the socket that sent the message.
// The number is different on every run, so this prints `from the client: yes`.
Core\Net\Datagram\Message $message = $server->receive(64, 5s);
echo "from the client: ", $message->port() == $client->port() ? "yes" : "no", "\n";

$client->close();
$server->close();
