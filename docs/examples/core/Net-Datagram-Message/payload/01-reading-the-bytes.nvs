<?nvs
// Shows how to read the bytes of a UDP message you received.

Core\Net\Datagram $server = Core\Net::bindDatagram("127.0.0.1", 0);
Core\Net\Datagram $client = Core\Net::bindDatagram("127.0.0.1", 0);
$client->send("127.0.0.1", $server->port(), "hello" as bytes, 1s);
Core\Net\Datagram\Message $message = $server->receive(64, 5s);

// `payload()` returns `tainted bytes`. `as string` converts them to text.
// This prints `payload: hello`.
tainted string $text = $message->payload() as string;
echo "payload: ", $text, "\n";

$client->close();
$server->close();
