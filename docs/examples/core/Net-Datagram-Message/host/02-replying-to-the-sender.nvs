<?nvs
// Shows how to send a reply to the program that sent a message.

Core\Net\Datagram $server = Core\Net::bindDatagram("127.0.0.1", 0);
Core\Net\Datagram $client = Core\Net::bindDatagram("127.0.0.1", 0);
$client->send("127.0.0.1", $server->port(), "ping" as bytes, 1s);

// `host()` and `port()` together are the address of the sender. The reply goes there.
Core\Net\Datagram\Message $request = $server->receive(64, 5s);
$server->send($request->host(), $request->port(), "pong" as bytes, 1s);

// This prints `client got: pong`.
echo "client got: ", $client->receive(64, 5s)->payload() as string, "\n";

$client->close();
$server->close();
