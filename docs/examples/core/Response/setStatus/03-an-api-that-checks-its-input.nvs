<?nvs
// Shows an API that answers with status 422 when a required value is missing.

// The request has no `email` value, so `query` returns `null`.
?tainted string $email = Core\Request::query("email");
if ($email == null) {
    // 422 tells the client that the request is wrong and must be changed.
    Core\Response::setStatus(422);
    Core\Response::json({ status: 422, error: "The value email is required." });
} else {
    Core\Response::setStatus(201);
    Core\Response::json({ status: 201, email: $email });
}
