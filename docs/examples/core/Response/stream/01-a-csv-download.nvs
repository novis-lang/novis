<?nvs
// Shows how to send a CSV file that the browser saves as a download.

// `Content-Disposition` tells the browser to save the body as the file `orders.csv`.
// Set every header before you call `stream`, because `stream` sends the headers.
Core\Response::setHeader("Content-Disposition", "attachment; filename=\"orders.csv\"");

// `Core\Response::stream` starts the body and sets its content type to `text/csv`.
// Each `write` sends one line of the file.
Core\Response\Stream $csv = Core\Response::stream("text/csv");
$csv->write("id,customer,total\n");
$csv->write("1042,Ada,19.90\n");
$csv->write("1043,Alan,5.00\n");
