<?nvs
// Shows what happens when the content type contains a character that is not allowed.

// Every character of a content type must be printable ASCII. `é` is not,
// so `sendBytes` throws a `LogicError` and sends nothing.
tainted string $answer = '';
try {
    Core\Response::sendBytes('Hello' as bytes, 'text/plain; name=café');
    $answer = 'sent';
} catch (LogicError $error) {
    $answer = $error->message;
}

// This second call uses an allowed content type, so its body is sent.
// The body is the error message from the first call.
Core\Response::sendBytes(($answer . "\n") as bytes, 'text/plain; charset=utf-8');
