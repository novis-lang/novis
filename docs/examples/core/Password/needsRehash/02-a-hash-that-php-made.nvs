<?nvs
// Shows that every bcrypt hash from PHP needs to be made again. It still
// works with `verify`, but it uses another algorithm.

string $fromPhp = '$2y$10$PE6UB/yJ1bk1dIwtgHee0es/SxguHDHJgvcdKauDX66xu84voItOi';

// This prints `true`.
echo Core\Password::needsRehash($fromPhp) ? "true" : "false", "\n";

// A hash made by `hash` today does not need it. This prints `false`.
string $fresh = Core\Password::hash("correct horse battery staple");
echo Core\Password::needsRehash($fresh) ? "true" : "false", "\n";
