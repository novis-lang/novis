<?nvs
// Shows that the same password gives a different hash every time, and that
// both hashes still match the password.

secret string $password = "hunter2";
string $first = Core\Password::hash($password);
string $second = Core\Password::hash($password);

// Each call uses a new random salt. This prints `different`.
echo $first == $second ? "the same" : "different", "\n";

// `verify` reads the salt from each hash, so both match. This prints `true`
// twice.
echo Core\Password::verify($password, $first) ? "true" : "false", "\n";
echo Core\Password::verify($password, $second) ? "true" : "false", "\n";
