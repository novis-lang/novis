<?nvs
// Shows how to turn a password into a hash that you can store.

secret string $password = "correct horse battery staple";
string $stored = Core\Password::hash($password);

// The hash starts with the name of the algorithm. This prints `$argon2id$`.
echo Core\Str::slice($stored, 0, 10), "\n";

// The rest is a random salt and the hash itself, so it is different on every
// run. Its length is always the same. This prints 97.
echo Core\Str::length($stored), "\n";

// `verify` reads the stored string back. This prints `matches`.
echo Core\Password::verify($password, $stored) ? "matches" : "does not match", "\n";
