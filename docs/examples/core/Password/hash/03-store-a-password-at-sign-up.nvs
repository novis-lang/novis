<?nvs
// Shows how a sign-up form stores a new user's password. Only the hash is
// kept. The password itself is never stored.

class Account {
    public string $email = "";
    public string $passwordHash = "";
}

class SignUp {
    public static function create(string $email, secret string $password): Account {
        Account $account = new Account();
        $account->email = $email;
        $account->passwordHash = Core\Password::hash($password);
        return $account;
    }
}

// This value comes from the form.
secret string $typed = "a long and private sentence";
Account $account = SignUp::create("ada@example.com", $typed);

// A real program saves `$account` in its database. This prints the email and
// `$argon2id$`, the start of the stored hash.
echo $account->email, "\n";
echo Core\Str::slice($account->passwordHash, 0, 10), "\n";

// At the next login, the typed password is checked against the stored hash.
// This prints `logged in`.
secret string $atLogin = "a long and private sentence";
if (Core\Password::verify($atLogin, $account->passwordHash)) {
    echo "logged in\n";
}
