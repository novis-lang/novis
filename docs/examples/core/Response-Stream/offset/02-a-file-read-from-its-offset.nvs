<?nvs
// Shows how to send a file from storage, starting at the byte the browser asked for.

// A real server already has this file. The example writes it first, so that it has a file to send.
string $path = Core\Path::join(Core\IO::temporaryDir(), 'notes.txt');
Core\IO::write($path, "Line one\nLine two\nLine three\n");

Core\Response\Stream $body = Core\Response::stream('text/plain; charset=utf-8', Core\IO::size($path) as int);

// `seek` moves to the first byte of the part. This request has no `Range` header, so `offset()` is `0`.
Core\IO\File $file = Core\IO::open($path, Core\IO::FileMode::Read);
$file->seek($body->offset() as uint);
$body->write($file->read($body->length() as uint));
$file->close();
