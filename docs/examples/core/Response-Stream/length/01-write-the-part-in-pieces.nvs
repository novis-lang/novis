<?nvs
// Shows how to write the part in pieces whose sizes add up to `length()`.

bytes $text = "One, two, three, four, five.\n" as bytes;
Core\Response\Stream $body = Core\Response::stream('text/plain; charset=utf-8', Core\Bytes::length($text) as int);

// Each piece is 8 bytes or less. The loop stops when exactly `length()` bytes are written.
int $written = 0;
while ($written < $body->length()) {
    int $size = $body->length() - $written;
    if ($size > 8) {
        $size = 8;
    }
    $body->write(Core\Bytes::slice($text, $body->offset() + $written, $size));
    $written = $written + $size;
}
