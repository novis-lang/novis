<?nvs
// Times every call of a sales report. The profile shows which calls take the most time.

class Report {
    public static function sales(array<int> $orders): int {
        int $sum = 0;
        foreach ($orders as int $cents) {
            $sum = $sum + Report::withShipping($cents);
        }
        return $sum;
    }

    public static function withShipping(int $cents): int {
        return $cents + 490;
    }
}

// The profile file goes in the folder of this program. `nvs.toml` allows a profile there.
string $file = Core\Path::thisDir('report.speedscope.json');

// Every call between the start and the stop is timed.
Core\Debug::startProfile($file);
int $total = Report::sales([1000, 2500, 400]);
Core\Debug::stopProfile();

echo "total with shipping: ", $total, "\n";

// This deletes the profile file, so the next run starts with an empty folder.
if (Core\IO::exists($file)) {
    Core\IO::remove($file);
}
