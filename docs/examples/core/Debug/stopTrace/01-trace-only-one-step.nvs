<?nvs
// Traces one step of a nightly job, and stops the trace before the next step.

class Nightly
{
    public static function importOrders(): int
    {
        return 12;
    }

    public static function sendReport(int $orders): string
    {
        return 'report: ' . $orders . ' orders';
    }
}

string $file = Core\Path::thisDir('import.jsonl');

// Only the import is traced. `stopTrace` closes the file before the report starts.
Core\Debug::startTrace($file);
int $orders = Nightly::importOrders();
Core\Debug::stopTrace();

echo Nightly::sendReport($orders), "\n";

// The file has no line for `sendReport`, because it ran after the stop.
foreach (Core\IO::lines($file) as string $line) {
    var $call = Core\Json::decode($line) as array<mixed>;
    echo 'traced: ', $call['callee'] as string, "\n";
}

// This deletes the trace file, so the next run starts with an empty folder.
Core\IO::remove($file);
