<?nvs
// Shows that the counts are still there after `stopCoverage`.

int $sum = 0;
for (int $i = 1; $i <= 4; $i++) {
    $sum += $i;
}

Core\Debug::stopCoverage();

// Counting is off now, but `coverage` still returns the counts from before.
// Line 6 ran once for each number, so this prints `4`.
foreach (Core\Debug::coverage() as string $path => array<int> $lines) {
    echo 'line 6 ran ', $lines['6'], " times\n";
}

// This loop runs while counting is off. The count for line 6 does not change.
for (int $j = 1; $j <= 4; $j++) {
    $sum += $j;
}

foreach (Core\Debug::coverage() as string $path => array<int> $lines) {
    echo 'line 6 ran ', $lines['6'], " times\n";
}

echo 'sum: ', $sum, "\n";
