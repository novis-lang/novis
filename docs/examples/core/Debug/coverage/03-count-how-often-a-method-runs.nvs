<?nvs
// Shows how to find out how many times a method ran.

class Price
{
    public static function withFee(int $cents): int
    {
        return $cents + 25;
    }
}

array<int> $prices = [100, 250, 400, 80, 1000];
int $sum = 0;
foreach ($prices as int $cents) {
    $sum += Price::withFee($cents);
}
echo 'total: ', $sum, "\n";

// Line 8 is the body of `withFee`. Its count is the number of calls, so this prints `5`.
foreach (Core\Debug::coverage() as string $path => array<int> $lines) {
    echo 'withFee ran ', $lines['8'], " times\n";
}
