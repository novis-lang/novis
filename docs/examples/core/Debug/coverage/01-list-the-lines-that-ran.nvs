<?nvs
// Shows how to list the lines of a program that ran, with a count for each line.

array<string> $names = ['Ada', 'Grace', 'Alan'];
foreach ($names as string $name) {
    echo 'Hello, ', $name, "\n";
}

// `coverage` returns an array with one entry for each file. The key is the path.
// Each value is an array from a line number to the number of times it ran.
foreach (Core\Debug::coverage() as string $path => array<int> $lines) {
    echo Core\Path::basename($path), "\n";
    foreach ($lines as string $line => int $count) {
        echo '  line ', $line, ': ', $count, "\n";
    }
}
