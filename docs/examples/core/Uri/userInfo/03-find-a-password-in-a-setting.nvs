<?nvs
// Shows how a program checks that a database address in its settings has no password in it.

class Settings {
    public static function check(string $address): string {
        // `?? ""` gives an empty text when the address has no user part.
        string $user = Core\Uri::parse($address)->userInfo() ?? "";
        // A password is written after a `:` in the user part, such as `app:secret`.
        if (Core\Str::contains($user, ":")) {
            return "error: move the password out of the address";
        }
        return "ok";
    }
}

// This prints "ok" twice, then the error once.
echo Settings::check("postgres://app@db.example.com/shop"), "\n";
echo Settings::check("postgres://db.example.com/shop"), "\n";
echo Settings::check("postgres://app:secret@db.example.com/shop"), "\n";
