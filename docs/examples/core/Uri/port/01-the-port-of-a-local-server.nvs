<?nvs
// Shows how to read the port of an address.

var $server = Core\Uri::parse("http://localhost:8080/health");

// The port is the number after the host. This prints 8080.
echo $server->port(), "\n";

// The result is a number, so you can calculate with it. This prints 8081.
echo ($server->port() ?? 0) + 1, "\n";
