<?nvs
// Shows a password reset link that a server sends by email and checks when the user opens it.

class Reset {
    public static function link(uint $user, array<secret bytes> $keys): string {
        Core\Uri $page = Core\Uri::parse("https://example.com/reset")
            ->withQueryParameter("user", $user as string);
        // The link stops working 30 minutes after it is sent.
        return $page->sign({keys: $keys, until: Core\Time::now()->plus(30m)})->toString();
    }

    public static function open(string $request, array<secret bytes> $keys): string {
        Core\Uri $uri = Core\Uri::parse($request);
        try {
            $uri->verifySignature($keys);
        } catch (RuntimeError $error) {
            return "this link is not valid";
        }
        return "choose a new password for user " . ($uri->queryParameter("user") as string);
    }
}

array<secret bytes> $keys = [Core\Crypto::generateKey()];
string $mailed = Reset::link(42, $keys);

// The first line is the link as it was sent. The second changes the user from 42 to 43.
// This prints "choose a new password for user 42" and "this link is not valid".
echo Reset::open($mailed, $keys), "\n";
echo Reset::open(Core\Str::replace($mailed, "user=42", "user=43"), $keys), "\n";
