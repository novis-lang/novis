<?nvs
// Shows where each part of a program starts, in bytes from the beginning of
// the source. The first byte is 0, so the `<?nvs` tag and the newline after it
// take the first six.

string $source = "<?nvs\necho 1;\necho 2;\n";

// This prints 6, then 14.
foreach (Core\Ast::parse($source)->children() as Core\Ast\Node $part) {
    echo $part->offset(), "\n";
}
