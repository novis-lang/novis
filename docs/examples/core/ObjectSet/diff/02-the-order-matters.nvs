<?nvs
// Shows that `$a->diff($b)` and `$b->diff($a)` give different results.

final class Tag {
    public string $name;

    public function constructor(string $name) {
        $this->name = $name;
    }
}

Tag $red = new Tag("red");
Tag $blue = new Tag("blue");
Tag $green = new Tag("green");

Core\ObjectSet<Tag> $before = new Core\ObjectSet<Tag>();
$before->add($red);
$before->add($blue);

Core\ObjectSet<Tag> $after = new Core\ObjectSet<Tag>();
$after->add($blue);
$after->add($green);

// The tags that were removed. This prints "Removed red".
foreach ($before->diff($after) as Tag $tag) {
    echo "Removed ", $tag->name, "\n";
}

// The tags that were added. This prints "Added green".
foreach ($after->diff($before) as Tag $tag) {
    echo "Added ", $tag->name, "\n";
}
