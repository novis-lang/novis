<?nvs
// Shows how to find the values that are in one set and not in another.

final class Tag {
    public string $name;

    public function constructor(string $name) {
        $this->name = $name;
    }
}

Tag $red = new Tag("red");
Tag $blue = new Tag("blue");
Tag $green = new Tag("green");

Core\ObjectSet<Tag> $all = new Core\ObjectSet<Tag>();
$all->add($red);
$all->add($blue);
$all->add($green);

Core\ObjectSet<Tag> $used = new Core\ObjectSet<Tag>();
$used->add($blue);

// `diff` returns a new set without the values of `$used`.
Core\ObjectSet<Tag> $unused = $all->diff($used);
// This prints red and green, one on each line.
foreach ($unused as Tag $tag) {
    echo $tag->name, "\n";
}

// `$all` and `$used` do not change. This prints "3 1".
echo $all->count(), " ", $used->count(), "\n";
