<?nvs
// Shows how to print a report only when some products are low on stock.

final class Product {
    public string $name;
    public int $stock;

    public function constructor(string $name, int $stock) {
        $this->name = $name;
        $this->stock = $stock;
    }
}

final class StockCheck {
    public static function report(array<Product> $products): void {
        Core\ObjectSet<Product> $low = new Core\ObjectSet<Product>();
        foreach ($products as Product $product) {
            if ($product->stock < 5) {
                $low->add($product);
            }
        }
        if ($low->isEmpty()) {
            echo "All products are in stock.\n";
            return;
        }
        echo "Order more of:\n";
        foreach ($low as Product $product) {
            echo "- ", $product->name, "\n";
        }
    }
}

// Every product has 5 or more. This prints "All products are in stock."
StockCheck::report([new Product("Pens", 40), new Product("Paper", 12)]);

// Two products have less than 5. This prints a list with "Ink" and "Tape".
StockCheck::report([new Product("Ink", 2), new Product("Paper", 12), new Product("Tape", 0)]);
