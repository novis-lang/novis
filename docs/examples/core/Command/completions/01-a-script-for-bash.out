# bash completion for 01-a-script-for-bash — generated by Core\Command::completions
__01_a_script_for_bash_complete() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W 'deploy version' -- "$cur"))
        return
    fi
    local options=''
    case "${COMP_WORDS[1]}" in
        'deploy') options='-n --dryRun' ;;
    esac
    COMPREPLY=($(compgen -W "$options" -- "$cur"))
}
complete -F __01_a_script_for_bash_complete '01-a-script-for-bash'
