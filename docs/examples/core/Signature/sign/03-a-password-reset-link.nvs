<?nvs
// Shows a password reset link that works for one hour.

// A real server loads this key from its configuration, so it stays the same between requests.
secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

// The link says which user may reset a password, and for what purpose.
// The purpose stops somebody from using a token that was made for another feature.
Core\Time\Instant $inOneHour = Core\Time::now()->plus(1h);
array<string> $claims = ["purpose" => "reset-password", "user" => "42"];
string $token = Core\Signature::sign($claims, { keys: $keys, until: $inOneHour });
string $link = "https://example.com/reset?token=" . $token;
echo "Sent a link of ", Core\Str::length($link), " characters\n";

// Later, the user opens the link and the server checks the token.
// After one hour, `verify` throws a `RuntimeError`.
try {
    array<tainted string> $back = Core\Signature::verify($token, $keys);
    if ($back["purpose"] == "reset-password") {
        echo "Choose a new password for user ", $back["user"], "\n";
    }
} catch (RuntimeError $e) {
    echo "This link is not valid. Ask for a new one.\n";
}
