<?nvs
// Shows that `sign` gives the same token for the same values in any order.

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

// The same two values, written in two different orders.
array<string> $first = ["order" => "1042", "status" => "paid"];
array<string> $second = ["status" => "paid", "order" => "1042"];
string $a = Core\Signature::sign($first, { keys: $keys, until: null });
string $b = Core\Signature::sign($second, { keys: $keys, until: null });
// This prints `same`.
echo $a == $b ? "same" : "different", "\n";

// One changed value gives a different token. This prints `different`.
array<string> $refunded = ["order" => "1042", "status" => "refunded"];
string $c = Core\Signature::sign($refunded, { keys: $keys, until: null });
echo $a == $c ? "same" : "different", "\n";

// `verify` returns the values sorted by name, so this prints `order status`.
array<tainted string> $back = Core\Signature::verify($b, $keys);
array<string> $names = Core\Arr::keys($back);
echo $names[0], " ", $names[1], "\n";
