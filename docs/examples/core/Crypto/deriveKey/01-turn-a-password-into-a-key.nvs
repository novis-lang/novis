<?nvs
// Shows how to make a key from a password and use it to seal a note.

secret string $password = "correct horse battery staple";
// The salt is drawn once and stored next to what the key protects.
bytes $salt = Core\Random::bytes(16);

secret bytes $key = Core\Crypto::deriveKey($password, $salt, 100000);
bytes $sealed = Core\Crypto::seal(
    "the spare key is under the mat" as bytes,
    $key,
    Core\Crypto\Cipher::XChaCha20Poly1305
);

// The same password, salt and number of rounds give the same key back, so the
// note opens again. This prints the note.
secret bytes $again = Core\Crypto::deriveKey($password, $salt, 100000);
echo Core\Crypto::open($sealed, $again, Core\Crypto\Cipher::XChaCha20Poly1305) as string, "\n";
