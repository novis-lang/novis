<?nvs
// Shows how a program stores something under a passphrase and opens it again
// later. The salt and the number of rounds are stored next to the sealed bytes.
// All three are needed to make the same key a second time.

secret string $passphrase = "a long sentence only I know";
bytes $salt = Core\Random::bytes(16);
uint $rounds = 200000;

secret bytes $key = Core\Crypto::deriveKey($passphrase, $salt, $rounds);
bytes $sealed = Core\Crypto::seal(
    "account: 12345, pin: 6789" as bytes,
    $key,
    Core\Crypto\Cipher::XChaCha20Poly1305
);

// These three go into the file together. The passphrase is the only part that
// stays in the person's head.
string $storedSalt = Core\Encoding::toHex($salt);
uint $storedRounds = $rounds;
string $storedBackup = Core\Encoding::toHex($sealed);

// Later, the person types the passphrase again and the file is read back.
secret bytes $opened = Core\Crypto::deriveKey(
    $passphrase,
    Core\Encoding::fromHex($storedSalt),
    $storedRounds
);
echo Core\Crypto::open(
    Core\Encoding::fromHex($storedBackup),
    $opened,
    Core\Crypto\Cipher::XChaCha20Poly1305
) as string, "\n";
