<?nvs
// Shows what the salt is for. Two people picked the same password. Each gets
// their own salt, so each ends up with a different key.

secret string $password = "hunter2";
bytes $firstSalt = Core\Random::bytes(16);
bytes $secondSalt = Core\Random::bytes(16);

secret bytes $first = Core\Crypto::deriveKey($password, $firstSalt, 100000);
secret bytes $second = Core\Crypto::deriveKey($password, $secondSalt, 100000);

// This prints `two keys from one password: yes`.
echo "two keys from one password: ", ($first != $second ? "yes" : "no"), "\n";

// The number of rounds changes the key as well, so it is stored with the salt.
secret bytes $slower = Core\Crypto::deriveKey($password, $firstSalt, 200000);
echo "more rounds, another key: ", ($first != $slower ? "yes" : "no"), "\n";
