<?nvs
// Shows how one secret gives several keys. A connection often wants one key for
// each direction, so a message the client sent cannot be replayed back at it.

secret bytes $shared = Core\Crypto::generateKey();
bytes $salt = Core\Random::bytes(16);

secret bytes $toServer = Core\Crypto::expandKey($shared, $salt, "client to server");
secret bytes $toClient = Core\Crypto::expandKey($shared, $salt, "server to client");

// The two keys have nothing to do with each other. This prints
// `two keys from one secret: yes`.
echo "two keys from one secret: ", ($toServer != $toClient ? "yes" : "no"), "\n";

bytes $sealed = Core\Crypto::seal("get /orders" as bytes, $toServer, Core\Crypto\Cipher::XChaCha20Poly1305);

// The key for the other direction does not open it, and `Core\Crypto::open`
// throws instead of returning something wrong.
try {
    Core\Crypto::open($sealed, $toClient, Core\Crypto\Cipher::XChaCha20Poly1305);
    echo "the wrong key opened it", "\n";
} catch (RuntimeError $e) {
    echo "the wrong key did not open it", "\n";
}
