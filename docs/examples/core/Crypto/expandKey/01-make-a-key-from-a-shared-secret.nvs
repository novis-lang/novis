<?nvs
// Shows the usual job: two sides reach a shared secret, then each side turns it
// into a key and uses that key to send a message.

Core\Crypto\KeyPair $mine = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519);
Core\Crypto\KeyPair $theirs = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519);

// The salt may be empty. The text names what the key is for.
secret bytes $key = Core\Crypto::expandKey(
    Core\Crypto::agree($mine, $theirs->publicKey()),
    "" as bytes,
    "chat v1"
);
bytes $sealed = Core\Crypto::seal("see you at six" as bytes, $key, Core\Crypto\Cipher::XChaCha20Poly1305);

// The other side reaches the same secret and uses the same text, so it builds
// the same key. This prints the message.
secret bytes $peerKey = Core\Crypto::expandKey(
    Core\Crypto::agree($theirs, $mine->publicKey()),
    "" as bytes,
    "chat v1"
);
echo Core\Crypto::open($sealed, $peerKey, Core\Crypto\Cipher::XChaCha20Poly1305) as string, "\n";
