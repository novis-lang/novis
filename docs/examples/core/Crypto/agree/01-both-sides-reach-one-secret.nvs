<?nvs
// Shows two sides reaching the same shared secret. Both key pairs are in this
// one program. In real code each side has its own pair and sends only the
// public half of it.

Core\Crypto\KeyPair $mine = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519);
Core\Crypto\KeyPair $theirs = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519);

// Each side uses its own pair together with the other side's public key.
secret bytes $ours = Core\Crypto::agree($mine, $theirs->publicKey());
secret bytes $yours = Core\Crypto::agree($theirs, $mine->publicKey());

// The two secrets are the same. This prints `both sides reached one secret: yes`.
echo "both sides reached one secret: ", ($ours == $yours ? "yes" : "no"), "\n";
