<?nvs
// Shows how to send your public key and how to read the one a peer sent. A
// public key travels as bytes in the `Spki` format, which browsers and most
// other languages read and write too.

Core\Crypto\KeyPair $mine = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256);
Core\Crypto\KeyPair $theirs = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256);

// These are the bytes you send. A public key is safe to publish.
bytes $sent = $mine->publicKey()->write(Core\Crypto\KeyFormat::Spki);
// This prints `sent 91 bytes`.
echo "sent ", Core\Bytes::length($sent), " bytes", "\n";

// This is what the peer does with them. You name the kind and the format,
// because the bytes alone do not say which curve you expect.
Core\Crypto\PublicKey $read = Core\Crypto\PublicKey::read(
    $sent,
    Core\Crypto\KeyKind::P256,
    Core\Crypto\KeyFormat::Spki
);

// The key the peer read reaches the same secret as the key you hold.
secret bytes $peerSide = Core\Crypto::agree($theirs, $read);
secret bytes $mySide = Core\Crypto::agree($mine, $theirs->publicKey());
echo "one secret from both keys: ", ($peerSide == $mySide ? "yes" : "no"), "\n";
