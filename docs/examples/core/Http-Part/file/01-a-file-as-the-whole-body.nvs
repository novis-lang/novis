<?nvs
// Shows how to send a file as the whole body of a request.

// `Core\Http\Part::file` checks that the file exists and returns a part.
// It does not read the file yet. The path starts at the folder of this file.
Core\Http\Part $invoice = Core\Http\Part::file("data/invoice-1042.txt", {contentType: "text/plain"});
echo "part created\n";

// The file is read while the request is sent. 10.0.0.7 is a private address,
// so the request throws a `RuntimeError` before anything is sent.
try {
    Core\Http\Response $response = Core\Http\Client::put("https://10.0.0.7/invoices/1042", {body: $invoice});
    echo "status: ", $response->status(), "\n";
} catch (RuntimeError $refused) {
    echo $refused->message, "\n";
}
