<?nvs
// Shows a monthly job that uploads a sales report to an accounting service,
// as a form with one text field and one file.

// `filename` is the name the accounting service sees. Without it, the name would be
// `sales-2026-09.csv`, the last part of the path.
Core\Http\Part $file = Core\Http\Part::file("data/sales-2026-09.csv", {filename: "shop-sales-september.csv", contentType: "text/csv"});

bool $uploaded = false;
try {
    // `multipart` sends a form upload. Each key is one field of the form.
    Core\Http\Response $response = Core\Http\Client::post("https://192.168.20.5/api/reports", {
        multipart: [
            "month" => "2026-09",
            "report" => $file,
        ],
        deadline: 60s,
    });
    $uploaded = $response->status() == 200 || $response->status() == 201;
} catch (RuntimeError $error) {
    echo "not uploaded: ", $error->message, "\n";
}

// 192.168.20.5 is a private address, so the upload fails and this prints `try again tomorrow: yes`.
echo "try again tomorrow: ", $uploaded ? "no" : "yes", "\n";
