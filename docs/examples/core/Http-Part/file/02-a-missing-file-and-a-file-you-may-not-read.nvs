<?nvs
// Shows the two errors `Core\Http\Part::file` throws, on the line that names the file.

string $dir = "docs/examples/core/Http-Part/file/data";

// There is no file with this name, so the call throws an `IOError`.
try {
    Core\Http\Part $missing = Core\Http\Part::file($dir . "/invoice-9999.txt");
    echo "part created\n";
} catch (IOError $notThere) {
    echo "invoice-9999.txt: the file does not exist\n";
}

// This program may only read files in the `data` directory. `nvs.toml` is outside it,
// so the call throws a `RuntimeError`.
try {
    Core\Http\Part $config = Core\Http\Part::file("nvs.toml");
    echo "part created\n";
} catch (RuntimeError $denied) {
    echo $denied->message, "\n";
}
