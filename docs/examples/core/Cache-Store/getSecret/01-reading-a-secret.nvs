<?nvs
// Shows how to read a secret back out of a cache store, and what a read
// answers when there is nothing to read.

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

var $cache = Core\Cache::local();
secret string $token = "sk-8f2c41";
$cache->putSecret("api-token", $token, 1h, $keys);

// The same key list opens the entry. This prints the token is back.
echo ($cache->getSecret("api-token", $keys) ?? "") == $token
    ? "the token is back"
    : "the token is gone", "\n";

// A name nothing was stored under is `null`. This prints null.
echo $cache->getSecret("no-such-name", $keys) == null ? "null" : "a value", "\n";

// A lifetime that is already over is `null` too. This prints null.
$cache->putSecret("expired", $token, 0s, $keys);
echo $cache->getSecret("expired", $keys) == null ? "null" : "a value", "\n";

// So is an entry that none of your keys opens. Each of these is a miss, and
// none of them is an error. This prints null.
array<secret bytes> $other = [Core\Crypto::generateKey()];
echo $cache->getSecret("api-token", $other) == null ? "null" : "a value", "\n";
