<?nvs
// Shows how to store a secret in a cache store and read it back.

// A key seals the value. `Core\Crypto::generateKey` makes one. A real program
// reads its keys from the configuration instead.
secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

var $cache = Core\Cache::local();
secret string $token = "sk-8f2c41";

// `putSecret` encrypts the value and stores it under the name "api-token".
// The lifetime of one hour is required.
$cache->putSecret("api-token", $token, 1h, $keys);

// `getSecret` opens the entry with the same key list. This prints the token is
// back.
echo ($cache->getSecret("api-token", $keys) ?? "") == $token
    ? "the token is back"
    : "the token is gone", "\n";

// The store holds the encrypted bytes, so a plain `get` on the same name finds
// nothing. This prints get returns null.
echo $cache->get("api-token") == null ? "get returns null" : "get returns a value", "\n";

// Another key list does not open the entry. That is a miss and not an error,
// so this prints another key list is a miss.
array<secret bytes> $other = [Core\Crypto::generateKey()];
echo $cache->getSecret("api-token", $other) == null
    ? "another key list is a miss"
    : "another key list opened it", "\n";
