<?nvs
// Shows how a program keeps an access token it fetched, so the next request
// does not ask the service for a new one.

class Tokens {
    // The work the cache saves. A real program calls the service here. The
    // counter below shows how often that happened.
    public static function fetch(): secret string {
        var $cache = Core\Cache::process();
        var $held = $cache->get("token-fetches") ?? 0;
        int $done = $held as int;
        $cache->put("token-fetches", $done + 1);
        return "at-7f3c9b21";
    }

    public static function ensure(array<secret bytes> $keys): void {
        var $cache = Core\Cache::process();

        // A hit needs no service call. A miss is also what an expired entry
        // looks like, so the token is fetched again then.
        if ($cache->getSecret("service-token", $keys) != null) {
            return;
        }

        // The service said the token lasts fifteen minutes, so that is the
        // lifetime of the entry. A shorter one is safe. A longer one is not.
        secret string $token = Tokens::fetch();
        $cache->putSecret("service-token", $token, 15m, $keys);
    }
}

secret bytes $key = Core\Crypto::generateKey();
array<secret bytes> $keys = [$key];

Tokens::ensure($keys);
Tokens::ensure($keys);

var $cache = Core\Cache::process();

// The first call fetched the token and the second call read the store. This
// prints 1.
echo $cache->get("token-fetches") as int, "\n";

// The stored token is the one the service gave. This prints the stored token
// matches.
secret string $expected = "at-7f3c9b21";
echo ($cache->getSecret("service-token", $keys) ?? "") == $expected
    ? "the stored token matches"
    : "the stored token differs", "\n";
