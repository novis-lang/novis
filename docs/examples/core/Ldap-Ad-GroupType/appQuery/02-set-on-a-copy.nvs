<?nvs
// Shows `appQuery` on a copy of a group type that has the flag set.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $type = $corp->read('CN=Employees,OU=Company,DC=example,DC=test', { select: ['groupType'] })?->groupType();

if ($type != null) {
    // `with` returns a copy with the flag `0x20` added.
    var $app = $type->with({ appQuery: true });

    // This prints `appQuery: true` and then `-2147483614`.
    echo 'appQuery: ', $app->appQuery() ? 'true' : 'false', "\n";
    echo $app->bits(), "\n";
}
