<?nvs
// Shows that `isSecurityGroup` also works on a copy made with `with`, and the original does not change.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $type = $corp->read('CN=Employees,OU=Company,DC=example,DC=test', { select: ['groupType'] })?->groupType();

if ($type != null) {
    // `with` returns a copy without the security flag.
    var $list = $type->with({ security: false });

    // This prints `true` and then `false`.
    echo $type->isSecurityGroup() ? 'true' : 'false', "\n";
    echo $list->isSecurityGroup() ? 'true' : 'false', "\n";
}
