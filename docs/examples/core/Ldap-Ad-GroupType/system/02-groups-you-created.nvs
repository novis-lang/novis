<?nvs
// Shows that `system` returns `false` for every group that somebody created.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $found = $corp->search(
    Core\Ldap\Filter::equals('objectClass', 'group'),
    { base: 'OU=Company,DC=example,DC=test', select: ['groupType'] },
);

array<tainted string> $lines = [];
foreach ($found as Core\Ldap\Entry $group) {
    var $type = $group->groupType();
    if ($type != null) {
        $lines[] = $group->dn()->rdnValue() . ': ' . ($type->system() ? 'true' : 'false');
    }
}

// The server sends entries in no fixed order, so the lines are sorted.
// This prints `false` for `Employees`, `Managers` and `Newsletter`.
foreach (Core\Arr::sort($lines) as tainted string $line) {
    echo $line, "\n";
}
