<?nvs
// Shows `appBasic` on a copy of a group type that has the flag set.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');
var $type = $corp->read('CN=Newsletter,OU=Company,DC=example,DC=test', { select: ['groupType'] })?->groupType();

if ($type != null) {
    // `with` returns a copy with the flag `0x10` added to the number 2.
    var $app = $type->with({ appBasic: true });

    // This prints `appBasic: true` and then `18`.
    echo 'appBasic: ', $app->appBasic() ? 'true' : 'false', "\n";
    echo $app->bits(), "\n";
}
