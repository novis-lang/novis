<?nvs
// Shows that the object is closed after `finish`, and how to start the next text.

Core\Markdown\Live $live = Core\Markdown::live();
$live->push("First answer.");
echo $live->finish();

// The text has ended, so another `push` throws a `RuntimeError`. So does a second `finish`.
try {
    $live->push("More text.");
} catch (RuntimeError $e) {
    echo "push: closed\n";
}
try {
    $live->finish();
} catch (RuntimeError $e) {
    echo "finish: closed\n";
}

// For the next text, create a new object.
$live = Core\Markdown::live();
$live->push("Second answer.");
echo $live->finish();
