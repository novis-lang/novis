<?nvs
// Shows how to read one file out of a zip archive file.

// A small archive, written as base64 text so it fits in this file. It contains
// `readme.txt` and `data/sales.csv`, both compressed.
bytes $archive = Core\Encoding::fromBase64('');

// The program writes the archive to a file first, so that it has one to open.
string $path = Core\Path::join(Core\IO::temporaryDir(), 'report.zip');
Core\IO::write($path, $archive);
Core\IO\File $file = Core\IO::open($path, Core\IO::FileMode::Read);

// `Core\Zip::read` takes the open file and returns one file's content, decompressed.
// This prints 39, the size of `readme.txt` in bytes.
tainted bytes $readme = Core\Zip::read($file, 'readme.txt');
echo Core\Bytes::length($readme), "\n";

// A file in a folder is read by its full name, exactly as `Core\Zip::entries`
// lists it. This prints the four lines of the CSV file.
tainted bytes $sales = Core\Zip::read($file, 'data/sales.csv');
echo $sales as string;

$file->close();
