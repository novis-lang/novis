<?nvs
// Shows how to write every file of a zip archive into a folder.

// A small archive, written as base64 text so it fits in this file. It contains
// the folder `site/` with `site/index.html` and `site/css/style.css`.
bytes $archive = Core\Encoding::fromBase64("");
string $folder = Core\IO::temporaryDir();

// `Core\Zip::extract` writes each file under `$folder` and creates the folders
// it needs. It returns the number of files. Folders are not counted, so this prints 2.
uint $written = Core\Zip::extract($archive, $folder);
echo $written, "\n";

// The files are where the archive put them. This prints the two lines of HTML and CSS.
echo Core\IO::readText(Core\Path::join($folder, 'site/index.html'));
echo Core\IO::readText(Core\Path::join($folder, 'site/css/style.css'));
