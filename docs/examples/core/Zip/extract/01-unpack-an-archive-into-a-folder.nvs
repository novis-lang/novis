<?nvs
// Shows how to write every file of a zip archive file into a folder.

// A small archive, written as base64 text so it fits in this file. It contains
// the folder `site/` with `site/index.html` and `site/css/style.css`.
bytes $archive = Core\Encoding::fromBase64('');

// The program writes the archive to a file first, so that it has one to open.
string $path = Core\Path::join(Core\IO::temporaryDir(), 'site.zip');
Core\IO::write($path, $archive);
Core\IO\File $file = Core\IO::open($path, Core\IO::FileMode::Read);
string $folder = Core\IO::temporaryDir();

// `Core\Zip::extract` takes the open file and writes each file under `$folder`.
// It returns the number of files. Folders are not counted, so this prints 2.
uint $written = Core\Zip::extract($file, $folder);
echo $written, "\n";
$file->close();

// The files are where the archive put them. This prints the two lines of HTML and CSS.
echo Core\IO::readText(Core\Path::join($folder, 'site/index.html'));
echo Core\IO::readText(Core\Path::join($folder, 'site/css/style.css'));
