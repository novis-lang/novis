<?nvs
// Shows how to list the names in a zip archive file.

// A small archive, written as base64 text so it fits in this file. It contains
// `readme.txt`, the folder `images/`, `images/logo.png` and `index.html`.
bytes $archive = Core\Encoding::fromBase64('');

// The program writes the archive to a file first, so that it has one to open.
string $path = Core\Path::join(Core\IO::temporaryDir(), 'site.zip');
Core\IO::write($path, $archive);
Core\IO\File $file = Core\IO::open($path, Core\IO::FileMode::Read);

// `Core\Zip::entries` takes the open file and returns the names in the order the
// archive stores them. A folder name ends with `/`. This prints four lines.
foreach (Core\Zip::entries($file) as tainted string $name) {
    echo $name, "\n";
}

// The result is an ordinary array, so you can count it. This prints 4.
echo Core\Arr::count(Core\Zip::entries($file)), "\n";

$file->close();
