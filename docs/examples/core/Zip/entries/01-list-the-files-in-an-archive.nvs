<?nvs
// Shows how to list the names in a zip archive.

// A small archive, written as base64 text so it fits in this file. It contains
// `readme.txt`, the folder `images/`, `images/logo.png` and `index.html`.
bytes $archive = Core\Encoding::fromBase64("");

// `Core\Zip::entries` returns the names in the order the archive stores them.
// A folder name ends with `/`. This prints four lines.
foreach (Core\Zip::entries($archive) as tainted string $name) {
    echo $name, "\n";
}

// The result is an ordinary array, so you can count it. This prints 4.
echo Core\Arr::count(Core\Zip::entries($archive)), "\n";
