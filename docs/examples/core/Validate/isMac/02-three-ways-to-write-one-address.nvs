<?nvs
// Shows the three ways to write the same MAC address.

// The same address with ":", with "-" and with ".".
// The last one is in upper case. Upper and lower case letters are both allowed.
array<string> $forms = ["00:1a:2b:3c:4d:5e", "00-1a-2b-3c-4d-5e", "001A.2B3C.4D5E"];

// This prints yes three times.
foreach ($forms as string $form) {
    echo $form, ": ", Core\Validate::isMac($form) ? "yes" : "no", "\n";
}
