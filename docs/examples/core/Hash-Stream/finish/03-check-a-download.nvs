<?nvs
// Shows how to check a download against the checksum that its website publishes.

class Download {
    // Returns `true` when the parts, joined in order, have the published SHA-256 checksum.
    public static function isIntact(array<string> $parts, string $publishedHex): bool {
        Core\Hash\Stream $stream = Core\Hash::stream(Core\Digest::Sha256);
        foreach ($parts as string $part) {
            $stream->update($part);
        }
        // `finish` returns the checksum of the whole download.
        bytes $checksum = $stream->finish();
        return Core\Hash::equals($checksum, Core\Encoding::fromHex($publishedHex));
    }
}

// The checksum the website publishes next to the download link.
string $published = Core\Encoding::toHex(Core\Hash::of("release 2.4.1 of the tool", Core\Digest::Sha256));

// This prints `intact`.
array<string> $received = ["release 2.4.1 ", "of the tool"];
echo Download::isIntact($received, $published) ? "intact" : "broken", "\n";

// One character changed on the way. This prints `broken`.
array<string> $changed = ["release 2.4.1 ", "of the toot"];
echo Download::isIntact($changed, $published) ? "intact" : "broken", "\n";
