<?nvs
// Shows that a stream is closed after `finish`, and how to start the next digest.

Core\Hash\Stream $stream = Core\Hash::stream(Core\Digest::Sha256);
$stream->update("first file");
echo Core\Encoding::toHex($stream->finish()), "\n";

// The stream is closed now, so a second `finish` throws a `RuntimeError`.
try {
    $stream->finish();
} catch (RuntimeError $e) {
    echo "closed\n";
}

// For the next digest, start a new stream.
$stream = Core\Hash::stream(Core\Digest::Sha256);
$stream->update("second file");
echo Core\Encoding::toHex($stream->finish()), "\n";
