<?nvs
// Shows how to test that a payment client stops when the server uses an old TLS version.

use Core\Http\Client;
use Core\Test;

class PaymentClient {
    // Returns the reply status, or throws an error if the connection is not TLS 1.3.
    public static function charge(string $url): int {
        var $response = Client::post($url, {json: ["amount" => 1200]});
        ?Core\Http\TlsInfo $info = $response->tls();
        if ($info != null) {
            if ($info->version() == "TLSv1.3") {
                return $response->status();
            }
        }
        throw new RuntimeError("the payment server must use TLS 1.3");
    }
}

// Two fake servers: one with TLS 1.3, and one with TLS 1.2.
Test::answerHttp("https://pay.example.com/charge", 200, {tls: Test::tlsSession()});
Test::answerHttp("https://old-pay.example.com/charge", 200, {
    tls: Test::tlsSession({version: "TLSv1.2"}),
});

// This prints `200`.
echo PaymentClient::charge("https://pay.example.com/charge"), "\n";

// This prints `the payment server must use TLS 1.3`.
try {
    PaymentClient::charge("https://old-pay.example.com/charge");
} catch (RuntimeError $error) {
    echo $error->message, "\n";
}
