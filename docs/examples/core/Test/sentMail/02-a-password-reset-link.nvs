<?nvs
// Shows how to test the password reset mail that a request sends.
// proof: test

use Core\Http\Method;
use Core\Mail;
use Core\Str;
use Core\Test;
use Core\Test\SentMail;

class PasswordResetTest
{
    #[Test]
    public function theMailHasAResetLink(): void
    {
        var $response = Test::request(Method::Post, '/password/reset', {
            headers: ['content-type' => 'application/x-www-form-urlencoded'],
            body: 'user=ada',
        });
        Test::assertEquals($response->status(), 202);

        // The request sent the mail, and the test reads it.
        array<SentMail> $sent = Test::sentMail();
        Test::assertCount($sent, 1);
        Test::assertEquals($sent[0]->to(), ['ada@example.com']);

        // The link ends with a token of 32 characters.
        ?string $token = Str::after($sent[0]->text(), 'https://example.com/password/new?token=');
        Test::assertEquals(Str::length($token ?? ''), 32);
    }

    // A user name that does not exist gets the same status, and no mail is sent.
    #[Test]
    public function anUnknownUserGetsNoMail(): void
    {
        var $response = Test::request(Method::Post, '/password/reset', {
            headers: ['content-type' => 'application/x-www-form-urlencoded'],
            body: 'user=nobody',
        });
        Test::assertEquals($response->status(), 202);
        Test::assertCount(Test::sentMail(), 0);
    }
}

// `Core\Test::request` runs this file again for the request. This part
// finds the address of the user and sends the mail with a new random token.
if (Core\Env::context() == Core\Env::Context::Request) {
    array<string> $addresses = ['ada' => 'ada@example.com', 'alan' => 'alan@example.com'];
    ?string $address = $addresses[Core\Request::post('user') ?? ''] ?? null;
    if ($address != null) {
        string $link = 'https://example.com/password/new?token=' . Core\Random::token(16);
        Mail::send('site', [$address], 'Reset your password', "Open this link to choose a new password:\n" . $link);
    }
    Core\Response::setStatus(202);
} else {
    echo "Run this file with `nvs test`.\n";
}
