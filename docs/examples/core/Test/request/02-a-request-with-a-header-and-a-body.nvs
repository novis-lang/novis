<?nvs
// Shows how to send a request with a header and a body.

use Core\Http\Method;
use Core\Test;

try {
    // This part answers the request. It reads one header and the body,
    // and sets the status to 201.
    var $language = Core\Request::header("accept-language") ?? "none";
    var $body = Core\Request::body();
    Core\Response::setStatus(201);
    echo "language ", $language, ", note ", $body;
} catch (LogicError $noRequest) {
    // This part sends a `POST` request with one header and a body.
    var $response = Test::request(Method::Post, "/notes", {
        headers: ["Accept-Language" => "de"],
        body: "Buy milk",
    });

    // This prints `201 language de, note Buy milk`.
    echo $response->status(), " ", $response->body(), "\n";
}
