<?nvs
// Shows a test of a check you wrote yourself: it must pass for a good price and fail for a bad one.

final class PriceCheck {
    // A valid price is more than 0 cents and at most 1,000,000 cents.
    public static function assertValid(int $cents): void {
        Core\Test::assertTrue($cents > 0, {message: "price " . $cents . " is not positive"});
        Core\Test::assertTrue($cents <= 1000000, {message: "price " . $cents . " is too high"});
    }
}

// A good price: both checks pass.
PriceCheck::assertValid(1999);
echo "1999 is valid\n";

// Bad prices: one check fails each time, as expected.
Core\Test::expectFailure(fn (): void => PriceCheck::assertValid(0));
Core\Test::expectFailure(fn (): void => PriceCheck::assertValid(-5));
Core\Test::expectFailure(fn (): void => PriceCheck::assertValid(2000000));
echo "0, -5 and 2000000 are not valid\n";
