<?nvs
// Shows the everyday use: you make a new two-factor secret for a user, and put
// it in the link that their authenticator app reads.

// Twenty random bytes are the secret. RFC 4226 recommends this size.
bytes $secret = Core\Random::bytes(20);

// Base32 writes them as 32 characters. This prints 32.
string $written = Core\Encoding::toBase32($secret);
echo Core\Str::length($written), "\n";

// The text goes in the `secret=` part of the link. `toBase32` writes no `=`
// padding, so the link has only these two `=` signs. This prints 2.
string $link = "otpauth://totp/Shop:ada@example.com?secret=" . $written . "&issuer=Shop";
echo Core\Str::countOf($link, "="), "\n";

// Some people type the secret instead of scanning the link. Apps show it in
// groups of four. This prints 39: 32 characters and 7 spaces.
string $shown = Core\Str::join(Core\Str::chunk($written, 4), " ");
echo Core\Str::length($shown), "\n";

// The app reads the text back into the same bytes. This prints 0.
echo Core\Bytes::compare(Core\Encoding::fromBase32($written), $secret), "\n";
