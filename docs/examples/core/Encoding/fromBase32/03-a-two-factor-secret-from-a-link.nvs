<?nvs
// Shows the everyday use: a two-factor authentication link carries its shared
// secret as base32, and your program needs the bytes behind it.

// The `secret=` part of an `otpauth://totp/…` link.
string $fromTheLink = "JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP";

// Read it back to the bytes it stands for. This prints 20, the number of bytes
// RFC 4226 recommends for a secret.
bytes $secret = Core\Encoding::fromBase32($fromTheLink);
echo Core\Bytes::length($secret), "\n";

// Those bytes are what a code is made from. A code is six digits and changes
// every thirty seconds, so this prints 6.
echo Core\Str::length(Core\Totp::code($secret)), "\n";

// An authenticator app shows the same secret in groups of four. The spaces are
// not base32, so take them out first. This prints same bytes.
string $asShown = "JBSW Y3DP EHPK 3PXP JBSW Y3DP EHPK 3PXP";
bytes $typedBack = Core\Encoding::fromBase32(Core\Str::replace($asShown, " ", ""));
echo (Core\Bytes::compare($typedBack, $secret) == 0 ? "same bytes" : "different bytes"), "\n";
