<?nvs
// Shows the full name of each attribute on a class, with its namespace.

namespace Shop;

attribute Route on class { path: string }

abstract class Controller
{
    attribute Cache on class { seconds: int }
}

#[Route(path: '/orders')]
#[Cache(seconds: 60)]
class OrderController extends Controller
{}

var $info = Core\Reflect::forObject(new OrderController());

// `Cache` is declared inside the class `Controller`, so its name includes the class.
// This prints `[Shop\Route]` and then `[Shop\Controller::Cache]`.
foreach ($info->attributes() as Core\Reflect\AttributeInfo $attribute) {
    echo '[', $attribute->name(), "]\n";
}
