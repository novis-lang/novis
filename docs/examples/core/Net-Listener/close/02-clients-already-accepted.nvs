<?nvs
// Shows that a connection the server already accepted still works after the server is closed.

Core\Net\Listener $server = Core\Net::listen("127.0.0.1", 0);
Core\Net\Stream $client = Core\Net::connect("127.0.0.1", $server->port(), 5s);
Core\Net\Stream $connection = $server->accept(5s);

// `close` stops the server from taking new clients.
// Each accepted connection is a separate socket, so `$connection` stays open.
$server->close();

$client->write("HELLO\n" as bytes, 5s);
tainted string $request = Core\Str::trim($connection->read(64, 5s) as string);
$connection->write(("GOT " . $request . "\n") as bytes, 5s);

// This prints `GOT HELLO`.
echo Core\Str::trim($client->read(64, 5s) as string), "\n";

$connection->close();
$client->close();
