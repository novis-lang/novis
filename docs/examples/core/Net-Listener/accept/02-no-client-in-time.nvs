<?nvs
// Shows what happens when no client connects before the time runs out.

Core\Net\Listener $server = Core\Net::listen("127.0.0.1", 0);

// Nobody connects to this server. After 100 milliseconds, `accept` throws a `TimeoutError`.
try {
    $server->accept(100ms);
    echo "a client connected\n";
} catch (TimeoutError $late) {
    echo "no client yet\n";
}

// The server still works after a timeout. You can call `accept` again.
// This time a client is waiting, so this prints `a client connected`.
Core\Net\Stream $client = Core\Net::connect("127.0.0.1", $server->port(), 5s);
Core\Net\Stream $connection = $server->accept(5s);
echo "a client connected\n";

$connection->close();
$client->close();
$server->close();
