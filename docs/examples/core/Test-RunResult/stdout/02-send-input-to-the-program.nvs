<?nvs
// Shows how to give a run some input and read the output it prints.

use Core\Test;

if ((Core\Cli::arguments()[0] ?? '') == 'shout') {
    // This part is the program. It reads its input and prints it in capital letters.
    echo Core\Str::upper(Core\IO::stdin());
} else {
    // `stdin` is the input of the program.
    var $run = Test::run(['shout'], {stdin: "milk\nbread\n"});

    // This prints `MILK` and `BREAD`, each on its own line.
    echo $run->stdout();
}
