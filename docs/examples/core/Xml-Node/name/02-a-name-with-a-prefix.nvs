<?nvs
// Shows that a prefix is part of the name.

string $xml = '<feed xmlns:media="https://example.com/media"><media:title>Cats</media:title></feed>';

foreach (Core\Xml::parse($xml)->children() as Core\Xml\Node $feed) {
    foreach ($feed->children() as Core\Xml\Node $title) {
        // This prints media:title.
        echo $title->name(), "\n";
        // The name is not `title`, so this prints no.
        echo $title->name() == "title" ? "yes" : "no", "\n";
        // `namespaceUri` gives the namespace of the prefix: https://example.com/media
        echo $title->namespaceUri() ?? "", "\n";
    }
}
