<?nvs
// Shows how to use a value from a visitor after your program has checked it.

// A value that comes from a visitor is `tainted`. Here it is the column a list is sorted by.
tainted string $sort = "created_at" as tainted string;

// The program compares the value with the three columns it allows.
// Only after that check does it call `assertTrusted`.
if ($sort == "name" || $sort == "price" || $sort == "created_at") {
    string $column = Core\Taint::assertTrusted($sort, "the value is one of the three allowed columns");
    // This prints "ORDER BY created_at".
    echo "ORDER BY ", $column, "\n";
} else {
    echo "ORDER BY name\n";
}
