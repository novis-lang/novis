<?nvs
// Shows the errors `open` throws for a block that the program cannot open.

use Core\Imap;

// `[capabilities.imap] connect` is the list of blocks the program may open.
// `[imap.archive]` exists, but that list does not have it.
try {
    Imap::open('archive');
} catch (RuntimeError $notGranted) {
    echo $notGranted->message, "\n";
}

// `[imap.office]` has a server, but no `user` and `password`.
try {
    Imap::open('office');
} catch (RuntimeError $noSignIn) {
    echo $noSignIn->message, "\n";
}
