<?nvs
// Shows a small program that picks the page to show by the path of the request.

tainted string $path = Core\Request::path();

// Each known path has its own page. Any other path gets a "not found" page.
// The client asked for `/about`, so this prints "About our shop".
if ($path == "/") {
    echo "Welcome to our shop\n";
} elseif ($path == "/about") {
    echo "About our shop\n";
} else {
    echo "404: page not found\n";
}
