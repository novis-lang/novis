<?nvs
// Shows what `Core\Request::body` returns when the request has no body, like most GET requests.

tainted string $body = Core\Request::body();

// A request without a body gives the empty string. It does not throw an error.
if ($body == "") {
    echo "no body was sent\n";
} else {
    echo "the body has ", Core\Str::length($body), " characters\n";
}

// You can call `body` again. It returns the same result every time.
echo Core\Request::body() == $body ? "same result\n" : "different result\n";
