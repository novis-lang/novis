<?nvs
// Shows how a shop filters its product list with the parameters of the address.

array<string> $products = ["red shirt" => "red", "blue shirt" => "blue", "red hat" => "red"];

// The address is `/products?filter[color]=red&filter[size]=M`.
// The brackets put both values in one array under the name "filter".
array<tainted string> $filter = Core\Request::query("filter") as array<string>;
tainted string $color = $filter["color"] ?? "";

// This prints "red shirt" and "red hat".
foreach ($products as string $name => string $productColor) {
    if ($color == "" || $productColor == $color) {
        echo $name, "\n";
    }
}
