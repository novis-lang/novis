<?nvs
// Shows how a page layout marks the menu entry for the page that is open.

class Shop
{
    #[Core\Route(path: '/products', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function products(): string
    {
        return 'products';
    }

    #[Core\Route(path: '/orders', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function orders(): string
    {
        return 'orders';
    }
}

// Each menu entry is the text to show and the method of its page.
// `Shop::products` is written without `()`, so nothing is called here.
array<callable> $menu = ['Products' => Shop::products, 'Orders' => Shop::orders];

// The address is `/orders`, so the route belongs to `Shop::orders`.
?Core\Router\Match $matched = Core\Request::route();

// `is` checks whether the route belongs to the method of the entry.
// This prints "  Products" and then "> Orders".
foreach ($menu as string $label => callable $route) {
    bool $open = $matched != null && $matched->is($route);
    echo $open ? '> ' : '  ', $label, "\n";
}
