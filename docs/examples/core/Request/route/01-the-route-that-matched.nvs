<?nvs
// Shows how a program reads the route that the request matched, with its method and its captured value.

class Users
{
    #[Core\Route(path: '/users/{id}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(uint $id): string
    {
        return 'one user';
    }
}

// The address is `/users/42`. The server matches it against the routes before the program starts.
// `Core\Request::route()` returns that match.
?Core\Router\Match $matched = Core\Request::route();
if ($matched != null) {
    // `is` checks which method the route belongs to. This prints "Users::show".
    echo $matched->is(Users::show) ? 'Users::show' : 'another route', "\n";
    // `{id}` is declared as `uint`, so the text "42" is the number 42. This prints "id 42".
    echo 'id ', $matched->param('id') as uint, "\n";
}
