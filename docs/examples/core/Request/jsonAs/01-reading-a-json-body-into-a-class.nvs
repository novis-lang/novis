<?nvs
// Shows how to read the JSON body of a request straight into an instance of your own class.

// `#[Core\Json\Derive]` gives the class a JSON format. Each public field is one key.
// The body comes from the client, so a string field must be `tainted string`.
#[Core\Json\Derive]
class NewUser {
    public tainted string $name;
    public int $age;

    public function constructor(tainted string $name, int $age) {
        $this->name = $name;
        $this->age = $age;
    }
}

// The class between `<` and `>` is the class to create. The result is a `NewUser`.
var $user = Core\Request::jsonAs<NewUser>();

// This prints "Ada is 36".
echo $user->name, " is ", $user->age, "\n";
