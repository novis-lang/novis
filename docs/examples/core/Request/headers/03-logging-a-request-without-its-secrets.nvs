<?nvs
// Shows how to write the headers of a request to a log, with the secret values hidden.

// These headers can contain a password or a session, so the log shows "[hidden]" for them.
// The list is `tainted` because `Core\Arr::contains` compares it with header names from the request.
array<tainted string> $secret = ["authorization", "cookie", "x-api-key"];

// The names are already in lower case, so one comparison is enough.
// This prints five lines. The lines for `authorization` and `cookie` show "[hidden]".
foreach (Core\Request::headers() as tainted string $name => array<tainted string> $values) {
    foreach ($values as tainted string $value) {
        if (Core\Arr::contains($secret, $name)) {
            echo $name, ": [hidden]\n";
        } else {
            echo $name, ": ", $value, "\n";
        }
    }
}
