<?nvs
// Shows how to list every header of a request with its value.

// `Core\Request::headers` returns each header name in lower case, with a list of its values.
// This prints "host: example.com", then "user-agent: curl/8.5.0", then "accept: */*".
foreach (Core\Request::headers() as tainted string $name => array<tainted string> $values) {
    foreach ($values as tainted string $value) {
        echo $name, ": ", $value, "\n";
    }
}
