<?nvs
// Shows how to list the files that a form uploaded.

// Each loop step gives one uploaded file as a `Core\Request\Part`.
// `readAll` returns the content of the file.
foreach (Core\Request::files() as Core\Request\Part $part) {
    tainted bytes $content = $part->readAll();
    echo $part->name(), ": ", $part->filename(), ", ", $part->contentType();
    echo ", ", Core\Bytes::length($content), " bytes\n";
}
