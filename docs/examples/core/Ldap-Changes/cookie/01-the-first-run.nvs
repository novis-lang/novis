<?nvs
// Shows the first run of a sync: it returns every matching entry, and then a cookie.
// requires: samba-ad

var $corp = Core\Ldap::connect('corp');

// There is no cookie yet, so the result has every person in Sales.
var $sales = $corp->changes(Core\Ldap\Filter::equals('department', 'Sales'), {
    select: ['cn'],
});

array<tainted string> $names = [];
foreach ($sales as Core\Ldap\Entry $person) {
    $names[] = $person->dn()->toString();
}
// The server sends the entries in no fixed order, so they are sorted.
// This prints the DNs of Anna Berg and Carla Diaz.
foreach (Core\Arr::sort($names) as tainted string $name) {
    echo $name, "\n";
}

// After the loop, `cookie` returns the cookie for the next run. It is not empty.
echo Core\Bytes::length($sales->cookie()) > 0 ? "Keep the cookie for the next run.\n" : "No cookie.\n";
