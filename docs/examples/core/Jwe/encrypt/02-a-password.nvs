<?nvs
// Shows how to encrypt a note with a password.

// `Core\Jwe\Key::password` makes a key from a password.
Core\Jwe\Key $key = Core\Jwe\Key::password("correct horse battery staple");
string $token = Core\Jwe::encrypt("The safe code is 4711.", $key);

// The same password opens the token. This prints `The safe code is 4711.`
echo Core\Jwe::decrypt($token, [Core\Jwe\Key::password("correct horse battery staple")]), "\n";

// A wrong password throws a `RuntimeError`. This prints `wrong password`.
try {
    Core\Jwe::decrypt($token, [Core\Jwe\Key::password("correct horse")]);
    echo "opened", "\n";
} catch (RuntimeError $wrong) {
    echo "wrong password", "\n";
}
