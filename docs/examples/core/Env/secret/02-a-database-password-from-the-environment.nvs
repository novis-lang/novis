<?nvs
// Shows how to pass a database password from the environment to `Core\Db::open`.

// `SHOP_DB_PASSWORD` is not set on this computer, so the password is empty here.
secret string $password = Core\Env::secret('SHOP_DB_PASSWORD') ?? '';

// The `password` setting accepts a secret. This example does not allow the host
// `db.example.com`, so `open` throws an error before it connects.
try {
    var $db = Core\Db::open({
        driver: Core\Db\Driver::Postgres,
        host: 'db.example.com',
        database: 'shop',
        user: 'shop',
        password: $password,
    });
    echo "connected\n";
} catch (RuntimeError $error) {
    echo $error->message, "\n";
}
