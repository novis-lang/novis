<?nvs
// Shows how to read an API key from the environment and send it in a request header.

// The server's reply is fixed here, so the example runs without a network.
Core\Test::answerHttp('https://api.example.com/orders', 200, { body: '3 open orders' });

// `Core\Env::secret` returns a `secret string`. `SHOP_API_KEY` is not set on
// this computer, so the `??` operator gives an empty key here.
secret string $key = Core\Env::secret('SHOP_API_KEY') ?? '';

// A request header accepts a secret. This prints `200 3 open orders`.
var $response = Core\Http\Client::get('https://api.example.com/orders', { headers: ['authorization' => 'Bearer ' . $key] });
echo $response->status(), ' ', $response->text(), "\n";
