<?nvs
// Shows how a program stops with a clear message when a secret it needs is not set.

class Secrets
{
    // Returns the secret `$name`, or throws an error when the variable is not set.
    public static function required(string $name): secret string
    {
        var $value = Core\Env::secret($name);
        if ($value == null) {
            throw new RuntimeError("{$name} is not set");
        }
        return $value;
    }
}

// `SHOP_API_KEY` is not set on this computer, so this prints the error message.
// The message has the name of the variable. It never has the value.
try {
    secret string $key = Secrets::required('SHOP_API_KEY');
    echo "the shop has its API key\n";
} catch (RuntimeError $error) {
    echo 'The shop cannot start: ', $error->message, "\n";
}
