<?nvs
// Shows a function that reads a setting the program cannot run without.

class Settings {
    // Returns the value of `$name`, or throws an error when the variable is not set.
    public static function required(string $name): tainted string {
        var $value = Core\Env::get($name);
        if ($value == null) {
            throw new RuntimeError("{$name} is not set");
        }
        return $value;
    }
}

// `SHOP_DB_PASSWORD` is not set on this computer, so this prints the error message.
try {
    var $password = Settings::required("SHOP_DB_PASSWORD");
    echo "connecting to the database\n";
} catch (RuntimeError $error) {
    echo "The shop cannot start: ", $error->message, "\n";
}
