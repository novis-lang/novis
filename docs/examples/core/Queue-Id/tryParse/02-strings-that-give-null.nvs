<?nvs
// Shows which strings give a job id, and that a correct form does not prove the job exists.
use Core\Queue;
use Core\Queue\Id;

// On a real server, `nvs queue migrate` creates the queue tables.
// This database is in memory, so the example creates them itself.
var $db = Core\Db::connect('jobs');
var $jobs = <<<'SQL'
create table nvs_jobs (id integer primary key autoincrement, queue varchar(255) not null,
    script text not null, args text, state smallint not null, attempts integer not null,
    max_attempts integer not null, backoff_ms bigint not null, run_at bigint not null,
    tag varchar(255), dedupe_key varchar(255), dedupe_pending varchar(255),
    created_at bigint not null, claimed_at bigint, errors text, grants text, limits text,
    non_transactional smallint, token text, constraint nvs_jobs_dedupe unique (dedupe_pending))
SQL;
$db->execute($jobs, []);

var $job = Queue::push('jobs/send-invoice.nvs', { queue: 'mail' });

class Check
{
    // Prints yes when `$text` gives an id, and no when the result is `null`.
    public static function show(string $label, string $text): void
    {
        echo Id::tryParse($text) == null ? 'no ' : 'yes', '  ', $label, "\n";
    }
}

// Only the first two strings have the correct form. This prints yes, yes, no, no and no.
Check::show('written by toString', $job->toString());
Check::show('same form, other token', '1.AAAAAAAAAAAAAAAAAAAAAA.bWFpbA');
Check::show('only a number', '1');
Check::show('has a space', '1.abc def.bWFpbA');
Check::show('empty', '');

// The second string gives an id, but no job has that token.
// `Queue::cancel` finds no job, so it returns `false`. This prints no job.
?Id $guess = Id::tryParse('1.AAAAAAAAAAAAAAAAAAAAAA.bWFpbA');
if ($guess != null) {
    echo Queue::cancel($guess) ? 'cancelled' : 'no job', "\n";
}
