<?nvs
// Shows the number of days in each month of 2026.

uint $month = 1;
while ($month <= 12) {
    var $first = Core\Time\Date::at(2026, $month, 1);
    // `daysInMonth` returns 28, 30 or 31 for the months of 2026.
    echo $first->format('MMMM'), ': ', $first->daysInMonth(), "\n";
    $month = $month + 1;
}
