<?nvs
// Shows how to write a date as ISO text, such as `2026-05-20`.

// `toIso` returns the year, the month and the day. This prints 2026-05-20.
var $date = Core\Time\Date::at(2026, 5, 20);
echo $date->toIso(), "\n";

// The year always has four digits. This prints 0005-01-02.
echo Core\Time\Date::at(5, 1, 2)->toIso(), "\n";

// A year before year 1 starts with `-`. This prints -0044-03-15.
echo Core\Time\Date::at(-44, 3, 15)->toIso(), "\n";
