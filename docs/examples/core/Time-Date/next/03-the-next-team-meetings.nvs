<?nvs
// Shows how to list the dates of a meeting that takes place every Tuesday.

var $day = Core\Time\Date::at(2026, 12, 24);
int $i = 0;
while ($i < 4) {
    // Each call moves to the next Tuesday after the date before it.
    $day = $day->next(Core\Time\Weekday::Tuesday);
    echo 'Meeting on ', $day->format('EEEE d MMMM yyyy'), "\n";
    $i = $i + 1;
}
