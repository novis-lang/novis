<?nvs
// Shows what `parse` does with text that does not match the pattern.

use Core\Time\Date;

// February 2026 has 28 days, so this date does not exist. `parse` throws a `ParseError`.
try {
    Date::parse('30.02.2026', 'dd.MM.yyyy');
} catch (ParseError $missing) {
    echo "30.02.2026 is not a date\n";
}

// The text has an extra letter at the end. `parse` throws a `ParseError` here too.
try {
    Date::parse('05.01.2026x', 'dd.MM.yyyy');
} catch (ParseError $extra) {
    echo "05.01.2026x does not match the pattern\n";
}

// The pattern `MM/yyyy` has a month and a year, but no day. So the day is 1.
// This prints 2026-03-01.
echo Date::parse('03/2026', 'MM/yyyy')->toIso(), "\n";
