<?nvs
// Shows how to check the birth dates that people typed into a form.

use Core\Time\Date;

array<string> $typed = ['24.12.1990', '7.4.1985', '31.04.2001', 'next week'];

foreach ($typed as string $text) {
    // `d.M.yyyy` also reads a day or month with one digit, such as `7.4.1985`.
    // In `format`, `EEEE` is the full name of the weekday.
    try {
        var $born = Date::parse($text, 'd.M.yyyy');
        echo $text, ' is ', $born->format('EEEE d MMMM yyyy'), "\n";
    } catch (ParseError $wrong) {
        echo $text, " is not a valid date. Write it as day.month.year.\n";
    }
}
