<?nvs
// Shows how to turn a date into a date and time in a time zone.

var $berlin = Core\Time\Zone::of('Europe/Berlin');
var $meetingDay = Core\Time\Date::at(2024, 3, 5);

// `atStartOfDay` returns a `Core\Time\DateTime` at midnight in Berlin.
// This prints 2024-03-05 00:00 +01:00.
echo $meetingDay->atStartOfDay($berlin)->format('yyyy-MM-dd HH:mm XXX'), "\n";

// `withTime` sets a time of day. This prints 2024-03-05 09:30 +01:00.
var $start = $meetingDay->atStartOfDay($berlin)->withTime(Core\Time\TimeOfDay::at(9, 30));
echo $start->format('yyyy-MM-dd HH:mm XXX'), "\n";
