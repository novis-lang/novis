<?nvs
// Shows the start of a day in a time zone where the clock skips midnight.

var $santiago = Core\Time\Zone::of('America/Santiago');

// On a normal day the result is midnight. This prints 2024-09-07 00:00 -04:00.
echo Core\Time\Date::at(2024, 9, 7)->atStartOfDay($santiago)->format('yyyy-MM-dd HH:mm XXX'), "\n";

// On 8 September 2024, the clock in Chile went from 23:59 to 01:00 for summer time.
// So the day starts at 01:00. This prints 2024-09-08 01:00 -03:00.
echo Core\Time\Date::at(2024, 9, 8)->atStartOfDay($santiago)->format('yyyy-MM-dd HH:mm XXX'), "\n";
