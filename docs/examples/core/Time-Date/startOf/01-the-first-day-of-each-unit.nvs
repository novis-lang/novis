<?nvs
// Shows the first day of the week, the month, the quarter and the year of one date.

use Core\Unit;

// 20 May 2026 is a Wednesday.
var $date = Core\Time\Date::at(2026, 5, 20);

// A week starts on Monday. This prints 2026-05-18.
echo $date->startOf(Unit::Week)->toIso(), "\n";

// This prints 2026-05-01.
echo $date->startOf(Unit::Month)->toIso(), "\n";

// May is in the second quarter, which starts in April. This prints 2026-04-01.
echo $date->startOf(Unit::Quarter)->toIso(), "\n";

// This prints 2026-01-01.
echo $date->startOf(Unit::Year)->toIso(), "\n";
