<?nvs
// Shows how to list the renewal dates of a monthly subscription.

// The subscription starts on 31 January. Each renewal is counted from the start date.
// A month without a 31st gets its last day, and the next month is back on the 31st.
var $start = Core\Time\Date::at(2024, 1, 31);
int $month = 1;
while ($month <= 4) {
    echo "Renewal ", $month, ": ", $start->plus($month, Core\Unit::Month)->format("yyyy-MM-dd"), "\n";
    $month = $month + 1;
}

// Adding one month to the previous renewal gives a different result.
// The day stays at the 29th. This prints 2024-03-29.
echo $start->plus(1, Core\Unit::Month)->plus(1, Core\Unit::Month)->format("yyyy-MM-dd"), "\n";
