<?nvs
// Shows the week numbers of the days around New Year.

var $day = Core\Time\Date::at(2026, 12, 28);
int $i = 0;
while ($i < 8) {
    // 1 to 3 January 2027 are still in week 53 of 2026.
    echo $day->toIso(), ' is in week ', $day->isoWeek(), ' of ', $day->isoWeekYear(), "\n";
    $day = $day->plus(1, Core\Unit::Day);
    $i = $i + 1;
}
