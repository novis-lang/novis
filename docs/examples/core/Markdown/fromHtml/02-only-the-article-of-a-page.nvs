<?nvs
// Shows how to convert only the article of a web page, without its menu and footer.

class Find
{
    // Returns the first element with this tag name under `$node`, or `null` if there is none.
    public static function element(Core\Xml\Node $node, string $name): ?Core\Xml\Node
    {
        foreach ($node->children() as Core\Xml\Node $child) {
            if ($child->kind() == Core\Xml\Node::Kind::Element && $child->name() == $name) {
                return $child;
            }
            ?Core\Xml\Node $found = Find::element($child, $name);
            if ($found != null) {
                return $found;
            }
        }
        return null;
    }
}

string $page = '<html><body>'
    . '<nav><a href="/">Home</a> <a href="/blog">Blog</a></nav>'
    . '<article><h1>Opening hours</h1>'
    . '<p>The shop is open <em>Monday to Friday</em>.</p>'
    . '<ul><li>Morning: 9 to 12</li><li>Afternoon: 14 to 18</li></ul></article>'
    . '<footer>Copyright Shop</footer>'
    . '</body></html>';

// `fromHtml` converts everything it gets. Pass it only the `article` element,
// so the menu and the footer are not in the result.
?Core\Xml\Node $article = Find::element(Core\Html::parse($page), 'article');
if ($article != null) {
    echo Core\Markdown::fromHtml($article);
}
