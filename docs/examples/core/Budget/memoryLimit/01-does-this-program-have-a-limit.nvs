<?nvs
// Shows the first thing to do with the limit: find out whether there is one.
// The limit is a number of bytes, and it is 0 when the program may use as much
// memory as it likes.

uint $limit = Core\Budget::memoryLimit();

if ($limit == 0) {
    echo "this program has no memory limit\n";
} else {
    // Programs usually run with a limit, so this is the line that prints.
    echo "this program has a memory limit\n";
}
