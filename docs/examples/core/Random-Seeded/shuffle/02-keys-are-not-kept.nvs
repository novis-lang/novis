<?nvs
// Shows that a shuffled array gets new keys, and what happens with an empty array.

Core\Random\Seeded $generator = new Core\Random\Seeded(42);
array<int> $stock = ["apples" => 4, "pears" => 5, "plums" => 6];

// The result is a list, so its keys are 0, 1 and 2. This prints ["0","1","2"].
array<int> $shuffled = $generator->shuffle($stock);
echo Core\Json::encode(Core\Arr::keys($shuffled)), "\n";

// This prints [4,5,6]. The old order is also a possible order, and this seed gives it.
echo Core\Json::encode($shuffled), "\n";

// An empty array gives an empty list. This prints [].
array<int> $empty = [];
echo Core\Json::encode($generator->shuffle($empty)), "\n";
