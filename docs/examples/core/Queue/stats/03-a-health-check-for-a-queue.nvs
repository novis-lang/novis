<?nvs
// Shows a health check that warns when a queue has too many waiting jobs or failed jobs.
use Core\Queue;

// On a real server, `nvs queue migrate` creates the queue tables.
// This database is in memory, so the example creates them itself.
var $db = Core\Db::connect("jobs");
var $jobs = <<<'SQL'
create table nvs_jobs (id integer primary key autoincrement, queue varchar(255) not null,
    script text not null, args text, state smallint not null, attempts integer not null,
    max_attempts integer not null, backoff_ms bigint not null, run_at bigint not null,
    tag varchar(255), dedupe_key varchar(255), dedupe_pending varchar(255),
    created_at bigint not null, claimed_at bigint, errors text, grants text, limits text,
    constraint nvs_jobs_dedupe unique (dedupe_pending))
SQL;
var $dead = <<<'SQL'
create table nvs_dead_jobs (id bigint not null, queue varchar(255) not null,
    script text not null, args text, attempts integer not null, max_attempts integer not null,
    backoff_ms bigint not null, run_at bigint not null, tag varchar(255),
    dedupe_key varchar(255), created_at bigint not null, failed_at bigint not null,
    errors text not null, primary key (id))
SQL;
$db->execute($jobs, []);
$db->execute($dead, []);

int $n = 0;
while ($n < 4) {
    Queue::push("jobs/send-mail.nvs", {queue: "mail", args: ["n" => $n]});
    $n = $n + 1;
}

// On a real server, workers run the jobs and move a job that failed 5 times
// to the dead-letter table. No worker runs here, so SQL changes the rows.
$db->execute("update nvs_jobs set state = 1, attempts = 1 where id = 1", []);
$db->execute(<<<'SQL'
insert into nvs_dead_jobs (id, queue, script, attempts, max_attempts, backoff_ms,
    run_at, created_at, failed_at, errors)
values (90, 'mail', 'jobs/send-mail.nvs', 5, 5, 1000, 0, 0, 0, '[]')
SQL, []);

// This prints `mail: 3 waiting, 1 running, 1 failed`,
// and then a warning, because a job failed.
var $stats = Queue::stats("mail");
echo "mail: ", $stats->pending(), " waiting, ", $stats->claimed(), " running, ",
    $stats->deadLettered(), " failed\n";
if ($stats->pending() > 100 || $stats->deadLettered() > 0) {
    echo "warning: the mail queue needs attention\n";
}
