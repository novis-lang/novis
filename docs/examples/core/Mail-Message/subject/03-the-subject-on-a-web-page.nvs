<?nvs
// Shows how a help desk page lists the subject of a message that has HTML in it.

use Core\Html\Markup;
use Core\Mail\Message;

Message $mail = Message::parse(
    "From: ada@example.org\r\n"
    . "Subject: <img src=x onerror=alert(1)> Refund\r\n"
    . "\r\n"
    . "I would like a refund."
);

// The subject is tainted. An html`...` template escapes it, so the tag shows as text.
Markup $row = html`<td>{$mail->subject()}</td>`;

// This prints `<td>&lt;img src=x onerror=alert(1)&gt; Refund</td>`.
echo $row, "\n";
