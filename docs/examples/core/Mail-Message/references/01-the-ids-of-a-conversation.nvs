<?nvs
// Shows how to read the message ids of the conversation that a reply belongs to.

use Core\Mail\Message;

Message $reply = Message::parse(
    "From: Ada <ada@example.org>\n"
    . "Subject: Re: Re: Your order\n"
    . "In-Reply-To: <answer-2@example.com>\n"
    . "References: <order-42@example.com> <question-1@example.org> <answer-2@example.com>\n"
    . "\n"
    . "Thank you, that helps.\n"
);

// `references()` returns the ids without their angle brackets, the oldest first.
foreach ($reply->references() as var $id) {
    echo $id, "\n";
}
