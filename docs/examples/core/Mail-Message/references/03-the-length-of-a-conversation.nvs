<?nvs
// Shows how to count the messages that came before a reply in its conversation.

use Core\Mail\Message;

Message $reply = Message::parse(
    "Subject: Re: Ticket 7\n"
    . "References: <ticket-7@example.com>\n"
    . " <answer-1@example.com>\n"
    . " <question-2@example.org>\n"
    . "\n"
    . "It works now.\n"
);

// A long `References` header continues on the next lines. Each of these lines starts with a space.
// `references()` reads all of them. This prints `3 messages came before this reply`.
echo Core\Arr::count($reply->references()), " messages came before this reply\n";
