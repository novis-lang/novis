<?nvs
// Shows how to keep only the new lines of a reply, without the quoted message below them.

use Core\Mail\Message;

Message $reply = Message::parse(
    "From: Ada <ada@example.org>\n"
    . "Subject: Re: Ticket 7\n"
    . "\n"
    . "The printer works again.\n"
    . "Thank you!\n"
    . "\n"
    . "> Please restart the printer.\n"
    . "> Does it work now?\n"
);

// A mail program puts `>` in front of each line it quotes. This loop skips those lines.
// `text()` returns a tainted string, so each line is tainted too.
foreach (Core\Str::lines($reply->text() ?? '') as var $line) {
    if (!Core\Str::startsWith($line, '>') && $line != '') {
        echo $line, "\n";
    }
}
