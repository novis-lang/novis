<?nvs
// Shows how to read the plain text body of a message that also has an HTML body.

use Core\Mail\Message;

Message $reply = Message::parse(
    "From: Ada <ada@example.org>\n"
        . "Subject: Re: Your order\n"
        . "MIME-Version: 1.0\n"
        . "Content-Type: multipart/alternative; boundary=\"b1\"\n"
        . "\n"
        . "--b1\n"
        . "Content-Type: text/plain\n"
        . "\n"
        . "Thank you, the mug arrived.\n"
        . "--b1\n"
        . "Content-Type: text/html\n"
        . "\n"
        . "<p>Thank you, the <b>mug</b> arrived.</p>\n"
        . "--b1--\n",
);

// `text()` returns the `text/plain` part. This prints `Thank you, the mug arrived.`
// `echo` adds no line break, and the text already ends with one.
echo $reply->text() ?? 'no text';
