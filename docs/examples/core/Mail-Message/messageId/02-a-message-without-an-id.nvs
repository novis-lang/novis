<?nvs
// Shows what `messageId` returns for a message that has no `Message-ID` header.

use Core\Mail\Message;

Message $mail = Message::parse("From: printer@example.org\r\nSubject: Scan done\r\n\r\nYour scan is ready.");

// The header is missing, so the result is `null`. This prints `no id`.
echo $mail->messageId() ?? 'no id', "\n";

// A message without an id can still get a key: the SHA-256 digest of its raw bytes.
// The same bytes always give the same key. This prints its first 16 digits.
tainted string $key = $mail->messageId()
    ?? Core\Encoding::toHex(Core\Hash::of($mail->raw(), Core\Hash::Digest::Sha256));
echo Core\Str::slice($key, 0, 16), "\n";
