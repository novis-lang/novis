<?nvs
// A mailing list reads a delivery report and decides for each address: stop sending, or wait.

use Core\Mail\Message;
use Core\Mail\ReportRecipient;

Message $notice = Message::parse(
    "From: mailer-daemon@mx.example.net\nSubject: Delivery Status Notification\n"
    . "Content-Type: multipart/report; report-type=delivery-status; boundary=\"b\"\n\n"
    . "--b\nContent-Type: text/plain\n\nSome recipients did not get your mail.\n"
    . "--b\nContent-Type: message/delivery-status\n\n"
    . "Reporting-MTA: dns; mx.example.net\n\n"
    . "Final-Recipient: rfc822; old-address@example.org\nAction: failed\nStatus: 5.1.1\n\n"
    . "Final-Recipient: rfc822; busy@example.net\nAction: delayed\nStatus: 4.2.2\n\n"
    . "Final-Recipient: rfc822; fine@example.com\nAction: delivered\nStatus: 2.0.0\n"
    . "--b--\n"
);

// `?? []` gives an empty list when the message is not a delivery report.
foreach ($notice->report()?->recipients() ?? [] as ReportRecipient $recipient) {
    if ($recipient->isPermanent()) {
        echo 'remove ', $recipient->address(), ' from the list', "\n";
    } elseif ($recipient->action() == ReportRecipient::Action::Delayed) {
        echo 'wait for ', $recipient->address(), ', the server tries again', "\n";
    } else {
        echo 'nothing to do for ', $recipient->address(), "\n";
    }
}
