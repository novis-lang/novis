<?nvs
// Shows what `date` returns when the `Date` header is missing or cannot be read.

use Core\Mail\Message;

array<string> $headers = [
    "Date: Wed, 4 Nov 2026 09:30:00 -0500\r\n",
    "Date: sometime next week\r\n",
    '',
];

// The first date is read. The second is not a date, and the third message has no `Date` header.
// So this prints one date and then `no date` two times.
foreach ($headers as string $header) {
    Message $mail = Message::parse("From: bo@example.org\r\n" . $header . "\r\nHello");
    echo $mail->date()?->format('yyyy-MM-dd HH:mm') ?? 'no date', "\n";
}
