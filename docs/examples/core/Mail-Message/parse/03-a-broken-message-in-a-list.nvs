<?nvs
// Shows that a broken message does not stop a program that reads many messages.

use Core\Mail\Message;

// The second message has no headers, and the third one has a date that is not a date.
array<string> $inbox = [
    "From: ada@example.org\r\nSubject: Invoice question\r\nDate: 3 Nov 2026 10:00 +0000\r\n\r\nHello.",
    'this is not an email',
    "From: bo@example.org\r\nSubject: Opening hours\r\nDate: someday\r\n\r\nHi.",
];

// `parse` does not throw an error. For a missing subject, `subject()` returns an empty string.
// For a missing sender or date, `from()` and `date()` return `null`.
foreach ($inbox as string $raw) {
    Message $mail = Message::parse($raw);
    // The sender wrote the subject, so it is tainted (text from outside your program).
    tainted string $subject = $mail->subject() == '' ? '(no subject)' : $mail->subject();
    echo $mail->from()?->address() ?? '(no sender)', ': ', $subject;
    echo $mail->date() == null ? ', no date' : ', dated', "\n";
}
