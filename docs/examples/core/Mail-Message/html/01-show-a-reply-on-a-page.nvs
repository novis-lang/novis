<?nvs
// Shows how to put the HTML body of a received message on a page.

use Core\Mail\Message;

// A customer sent this reply. It has a plain text body and an HTML body.
Message $reply = Message::parse(
    "From: Ada <ada@example.org>\n"
        . "Subject: Re: Your order\n"
        . "MIME-Version: 1.0\n"
        . "Content-Type: multipart/alternative; boundary=\"b1\"\n"
        . "\n"
        . "--b1\n"
        . "Content-Type: text/plain\n"
        . "\n"
        . "Thank you, the mug arrived.\n"
        . "--b1\n"
        . "Content-Type: text/html\n"
        . "\n"
        . "<p>Thank you, the <b>mug</b> arrived.</p><script>alert(1)</script>\n"
        . "--b1--\n",
);

// `html()` returns a tainted string (text from outside your program). It cannot be put on a page as HTML.
// `Core\Html::sanitize` keeps the `p` and `b` tags and removes the script.
echo Core\Html::sanitize($reply->html() ?? '');
