<?nvs
// Shows that `header()` decodes a value that a mail program encoded.

use Core\Mail\Message;

// A header with letters that are not ASCII is sent as an encoded word, such as `=?UTF-8?B?...?=`.
// An encoded word is the way a header writes non-ASCII text.
Message $ticket = Message::parse(
    "From: shop@example.com\n"
    . "X-Customer: =?UTF-8?B?SsO8cmdlbiBNw7xsbGVy?=\n"
    . "\n"
    . "A new ticket.\n"
);

// `header()` returns the decoded text. This prints `Jürgen Müller`.
// The value is a tainted string (text from outside your program), because the sender wrote it.
echo $ticket->header('X-Customer')[0], "\n";
