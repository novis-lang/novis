<?nvs
// Shows how a shop sends each message to the right team, by the address it was sent to.

use Core\Mail\Address;
use Core\Mail\Message;

// Each address of the shop belongs to one team.
array<string> $teams = ['sales@example.com' => 'Sales', 'support@example.com' => 'Support'];

array<string> $inbox = [
    "To: Support <support@example.com>\r\nSubject: Broken lamp\r\n\r\nIt does not turn on.",
    "To: SALES@example.com\r\nSubject: 40 chairs\r\n\r\nPlease send a quote.",
    "To: someone@example.org\r\nSubject: Hello\r\n\r\nWrong address?",
];

foreach ($inbox as string $raw) {
    Message $mail = Message::parse($raw);
    string $team = 'Unsorted';
    foreach ($mail->to() as Address $recipient) {
        // An address is compared in lower case, because `SALES@example.com` is the same mailbox.
        tainted string $address = Core\Str::lower($recipient->address());
        foreach ($teams as string $known => string $name) {
            if ($address == $known) {
                $team = $name;
            }
        }
    }
    // This prints `Support`, `Sales` and `Unsorted`.
    echo $mail->subject(), ': ', $team, "\n";
}
