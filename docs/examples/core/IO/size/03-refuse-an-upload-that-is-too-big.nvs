<?nvs
// Shows how a program checks the size of uploaded files before it reads them.

class Uploads {
    // The largest file this program accepts, in bytes.
    public const uint LIMIT = 1000;

    public static function accept(string $path): string {
        uint $size = Core\IO::size($path);
        if ($size > self::LIMIT) {
            return "too big (" . ($size as string) . " bytes)";
        }
        return "accepted (" . ($size as string) . " bytes)";
    }
}

string $dir = Core\IO::temporaryDir();
string $small = Core\Path::join($dir, "avatar.png");
string $large = Core\Path::join($dir, "video.mp4");
Core\IO::write($small, Core\Str::repeat("x", 300));
Core\IO::write($large, Core\Str::repeat("x", 5000));

// This prints "avatar.png: accepted (300 bytes)" and then "video.mp4: too big (5000 bytes)".
array<string> $uploads = [$small, $large];
foreach ($uploads as string $path) {
    echo Core\Path::basename($path), ": ", Uploads::accept($path), "\n";
}
