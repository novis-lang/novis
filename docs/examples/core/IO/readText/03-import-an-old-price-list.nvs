<?nvs
// Shows how a program imports a price list that an older shop system exported in Windows-1252.

string $path = Core\Path::join(Core\IO::temporaryDir(), "prices.csv");
array<bytes> $export = [Core\Encoding::encodeText("Café au lait;3,50 €\nCrème brûlée;6,00 €\n", Core\Charset::Windows1252)];
Core\IO::writeStream($path, $export, {overwrite: true});

// Windows-1252 has the "€" sign, and Latin-1 does not. So the file is read as `Windows1252`.
string $prices = Core\IO::readText($path, {charset: Core\Charset::Windows1252});

// Each line has a product and a price, split at ";".
// This prints "Café au lait costs 3,50 €" and "Crème brûlée costs 6,00 €".
foreach (Core\Str::split(Core\Str::trim($prices), "\n") as string $line) {
    array<string> $fields = Core\Str::split($line, ";");
    echo $fields[0], " costs ", $fields[1], "\n";
}
