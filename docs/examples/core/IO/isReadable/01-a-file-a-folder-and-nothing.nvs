<?nvs
// Shows what `Core\IO::isReadable` returns for a file, a folder and a path with nothing at it.

string $dir = Core\IO::temporaryDir();
string $file = Core\Path::join($dir, "notes.txt");
Core\IO::write($file, "hello");

// The program may read this file. This prints "true".
echo Core\IO::isReadable($file) ? "true" : "false", "\n";

// A folder can be readable too. This prints "true".
echo Core\IO::isReadable($dir) ? "true" : "false", "\n";

// Nothing has this name. `isReadable` does not throw an error. This prints "false".
echo Core\IO::isReadable(Core\Path::join($dir, "missing.txt")) ? "true" : "false", "\n";
