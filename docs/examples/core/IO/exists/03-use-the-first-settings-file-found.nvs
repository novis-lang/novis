<?nvs
// Shows how a program looks for its settings in several places and uses the first file it finds.

string $dir = Core\IO::temporaryDir();
Core\IO::makeDir(Core\Path::join($dir, "defaults"));
Core\IO::write(Core\Path::join($dir, "defaults/app.ini"), "debug = false\n");

// The local file comes first, so it wins when it is there. Here only the default file exists.
array<string> $candidates = [
    Core\Path::join($dir, "local/app.ini"),
    Core\Path::join($dir, "defaults/app.ini"),
];

string $found = "";
foreach ($candidates as string $candidate) {
    if (Core\IO::exists($candidate)) {
        $found = $candidate;
        break;
    }
}

// This prints "defaults/app.ini" and then "debug = false".
echo Core\Path::basename(Core\Path::dirname($found)), "/", Core\Path::basename($found), "\n";
echo Core\IO::read($found);
