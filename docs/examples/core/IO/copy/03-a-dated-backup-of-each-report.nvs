<?nvs
// Shows a backup job that copies each report into a backup folder, with the date in the new name.

string $dir = Core\IO::temporaryDir();
string $reports = Core\Path::join($dir, "reports");
string $backups = Core\Path::join($dir, "backups");
Core\IO::makeDir($reports);
Core\IO::makeDir($backups);
Core\IO::write(Core\Path::join($reports, "sales.csv"), "month,total\nMay,1200\n");
Core\IO::write(Core\Path::join($reports, "stock.csv"), "item,count\nchair,40\n");

string $date = "2024-05-31";
foreach (Core\IO::list($reports) as string $name) {
    string $to = Core\Path::join($backups, Core\Str::format("%s-%s", $date, $name));
    Core\IO::copy(Core\Path::join($reports, $name), $to);
}

// This prints the two new names, "2024-05-31-sales.csv" and "2024-05-31-stock.csv".
foreach (Core\Arr::sort(Core\IO::list($backups)) as string $name) {
    echo $name, "\n";
}
