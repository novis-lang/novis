<?nvs
// Shows how to read the whole content of a text file into one string.

string $path = Core\Path::join(Core\IO::temporaryDir(), "notes.txt");
Core\IO::write($path, "Buy milk\nCall Ada\n");

// `read` returns the file exactly as it is, also the line break at the end.
// This prints the two lines, and then "18 characters".
string $notes = Core\IO::read($path);
echo $notes;
echo Core\Str::length($notes), " characters\n";
