<?nvs
// Shows how to loop over the lines that `Core\IO::lines` reads from a file.

string $path = Core\Path::join(Core\IO::temporaryDir(), 'todo.txt');
Core\IO::write($path, "buy milk\ncall the bank\nwater the plants\n");

// Each line comes without its line break. The last line break does not add an empty line.
// This prints "1: buy milk", "2: call the bank" and "3: water the plants".
uint $number = 0;
foreach (Core\IO::lines($path) as string $line) {
    $number = $number + 1;
    echo $number, ': ', $line, "\n";
}
