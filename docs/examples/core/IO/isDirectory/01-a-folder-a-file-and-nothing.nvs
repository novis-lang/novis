<?nvs
// Shows what `Core\IO::isDirectory` returns for a folder, a file and a path with nothing at it.

string $dir = Core\IO::createTemporaryDirectory();
string $file = Core\Path::join($dir, 'notes.txt');
Core\IO::write($file, 'hello');

// A folder. This prints "true".
echo Core\IO::isDirectory($dir) ? 'true' : 'false', "\n";

// A file is not a folder. This prints "false".
echo Core\IO::isDirectory($file) ? 'true' : 'false', "\n";

// Nothing has this name. `isDirectory` does not throw an error. This prints "false".
echo Core\IO::isDirectory(Core\Path::join($dir, 'missing')) ? 'true' : 'false', "\n";
