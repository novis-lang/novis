<?nvs
// Shows what `data()` returns when one event has several `data` lines.

// The first event has three `data` lines. The second event has one.
Core\Test::answerHttp("https://weather.example.com/alerts", 200, {
    body: "data: Storm warning\ndata: Area: north coast\ndata: Until: 18:00\n\ndata: All clear\n\n",
    headers: ["content-type" => "text/event-stream"],
});

// `data()` joins the lines of one event with a line break.
// This prints the three lines of the first event, then "All clear".
Core\Http\Stream $alerts = Core\Http\Client::stream(Core\Http\Method::Get, "https://weather.example.com/alerts");
int $number = 1;
foreach ($alerts->events() as Core\Http\Event $alert) {
    echo "Alert ", $number, ":\n", $alert->data(), "\n";
    $number = $number + 1;
}
