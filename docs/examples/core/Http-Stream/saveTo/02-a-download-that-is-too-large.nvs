<?nvs
// Shows what happens when a download is larger than the size you allow.

// This server sends 5000 bytes. The program allows at most 1000.
Core\Test::answerHttp("https://images.example.com/photo.jpg", 200, {body: Core\Str::repeat("x", 5000)});

string $path = Core\Path::join(Core\IO::temporaryDir(), "photo.jpg");
Core\Http\Stream $photo = Core\Http\Client::stream(Core\Http\Method::Get, "https://images.example.com/photo.jpg");

// `saveTo` throws a `RuntimeError` when the body is larger than the limit.
try {
    $photo->saveTo($path, 1000);
    echo "the photo was saved\n";
} catch (RuntimeError $error) {
    echo "the photo is too large\n";
}

// The part that was already written is deleted. This prints "file exists: no".
echo "file exists: ", Core\IO::exists($path) ? "yes" : "no", "\n";
