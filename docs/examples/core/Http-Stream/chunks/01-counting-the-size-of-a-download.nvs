<?nvs
// Shows how to read a download piece by piece and count its size.

// The reply comes from this table, so nothing is sent over a network.
Core\Test::answerHttp("https://files.example.com/report.csv", 200, {body: "date,sales\n2026-09-01,120\n2026-09-02,95\n"});

Core\Http\Stream $download = Core\Http\Client::stream(Core\Http\Method::Get, "https://files.example.com/report.csv");
uint $size = 0;
// `chunks()` gives each piece of the body as it arrives.
foreach ($download->chunks() as tainted bytes $piece) {
    $size = $size + Core\Bytes::length($piece);
}
// This prints "received 40 bytes".
echo "received ", $size, " bytes\n";
