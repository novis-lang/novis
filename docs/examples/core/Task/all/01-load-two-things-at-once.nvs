<?nvs
// Shows how to run two pieces of work at the same time and use both results.

// Each field of the shape is a closure. `Core\Task::all` runs them at the
// same time and waits until both have finished.
var $page = Core\Task::all({
    name:   fn (): string => Core\Str::upper("anna"),
    orders: fn (): array<int> => [1042, 1043, 1051],
});

// The result has the same field names. `$page->name` is a `string` and
// `$page->orders` is an `array<int>`. This prints `ANNA has 3 orders.`
echo $page->name, " has ", Core\Arr::count($page->orders), " orders.\n";
