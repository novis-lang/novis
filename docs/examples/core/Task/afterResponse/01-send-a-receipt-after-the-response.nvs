<?nvs
// Shows how to send a receipt after the response. The customer sees the
// confirmation first, and the receipt is sent after that.

string $email = "anna@example.com";
uint $order = 1042;

// This line adds the closure to a list. It does not run it yet.
Core\Task::afterResponse(fn (): void => {
    echo "Receipt for order #", $order, " sent to ", $email, "\n";
});

// The response. This line prints before the receipt line.
echo "Thank you! Order #", $order, " is confirmed.\n";
