<?nvs
// Shows how to send an audit log after the response, with a time limit.

array<string> $audit = [];
$audit[] = "user 17 signed in";
$audit[] = "user 17 changed the email address";
$audit[] = "user 17 downloaded invoice 2026-031";

// `deadline: 10s` stops the anonymous function if it runs longer than 10 seconds.
// A slow log server then cannot keep this work running for long.
Core\Task::afterResponse(fn (): void => {
    foreach ($audit as string $line) {
        echo "audit: ", $line, "\n";
    }
}, {deadline: 10s});

echo "Your settings are saved.\n";
