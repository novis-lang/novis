<?nvs
// Shows a login form that tells a user how many minutes to wait after too
// many failed attempts.

class Login {
    public static function failed(string $user): string {
        // Each user may fail 5 times per 15 minutes.
        var $decision = Core\RateLimit::shed("login:" . $user, 5, 15m);
        var $wait = $decision->retryAfter();
        if ($wait == null) {
            return "Wrong password.";
        }
        // The wait is rounded up to whole minutes.
        int $minutes = Core\Math::intDiv($wait->toMilliseconds() + 59999, 60000);
        return "Too many attempts. Try again in " . $minutes . " minutes.";
    }
}

// The first 5 failures are allowed. One attempt drains every 3 minutes,
// so the 6th failure prints `Try again in 3 minutes.`
uint $attempt = 0;
while ($attempt < 6) {
    echo Login::failed("sam"), "\n";
    $attempt = $attempt + 1;
}
