<?nvs
// Shows `remaining` when each call has a cost. A refused call uses no units.

class Report {
    public static function run(uint $pages): void {
        // Each user may print 10 pages per hour.
        var $decision = Core\RateLimit::shed("print:user:2", 10, 1h, {cost: $pages});
        echo $pages, " pages: ", $decision->allowed() ? "printed" : "refused";
        echo ", ", $decision->remaining(), " pages left\n";
    }
}

// 4 pages leave 6. 7 pages do not fit, so 6 are still left.
// 6 pages then use the rest, and 0 are left.
Report::run(4);
Report::run(7);
Report::run(6);
