<?nvs
// Checks the value of a `?status=` filter from a web address against the cases of an enum.

enum OrderStatus: int {
    Open = 1,
    Paid = 2,
    Shipped = 3,
    Cancelled = 9,
}

// These are values a visitor could type after `?status=`.
array<string> $filters = ["Shipped", "Lost", "open"];

?Core\Reflect\EnumInfo $found = Core\Reflect\EnumInfo::of(OrderStatus::class);
if ($found != null) {
    Core\Reflect\EnumInfo $info = $found;
    array<string> $allowed = $info->cases();
    foreach ($filters as string $filter) {
        // The check is exact, so "open" is not the same as "Open".
        if (Core\Arr::contains($allowed, $filter)) {
            echo "Filter by ", $filter, "\n";
        } else {
            // The error message lists every case, so the visitor knows what to type.
            echo "Unknown status '", $filter, "'. Use one of: ", Core\Str::join($allowed, ", "), "\n";
        }
    }
}
