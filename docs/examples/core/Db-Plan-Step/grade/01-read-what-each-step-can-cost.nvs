<?nvs
// Shows what each step of a plan can cost. `Core\Db\Plan\Step::grade` returns
// a `Core\Db\Plan\Grade` case, so the program compares it with `==`.

use Core\Db;
use Core\Db\Plan\Grade;
use Core\Db\Plan\Step;
use Core\Db\Schema;

var $db = Db::connect('notes');

// A table an earlier version of this program left behind.
$db->execute('create table notes_backup (id integer primary key)', []);

var $schema = Schema::fromArray([
    'tables' => [
        [
            'name' => 'notes',
            'columns' => [
                ['name' => 'id', 'type' => 'int64', 'identity' => true],
                ['name' => 'title', 'type' => 'text(200)'],
            ],
            'primary_key' => ['id'],
        ],
    ],
]);

// Every step carries a grade, and `reason()` is the sentence behind it.
foreach ($schema->planAgainst($db)->steps() as Step $step) {
    if ($step->grade() == Grade::Safe) {
        echo 'safe: ', $step->reason(), "\n";
    } else if ($step->grade() == Grade::Locking) {
        echo 'locking: ', $step->reason(), "\n";
    } else {
        // Dropping a table can lose data, so it is graded `Destructive`.
        echo 'destructive: ', $step->reason(), "\n";
    }
}

$db->close();
