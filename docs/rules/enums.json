{
  "topic": "enums",
  "title": "Enums",
  "order": 60,
  "rules": [
    {
      "id": "enums/declaration",
      "title": "A case with no written value counts on from the one before it, starting at zero",
      "status": "shipped",
      "because": ["0010"],
      "divergesFromPhp": "every case has an integer value even where none is written, so PHP's valueless pure case does not exist",
      "seeAlso": ["enums/closed-integer-type", "enums/one-backing-type", "enums/no-case-keyword"],
      "guardedBy": [
        "tests/conformance/enum/enum-cases-count-on-from-the-last-explicit-value.nvst",
        "tests/conformance/enum/an-enum-carries-negative-and-zero-cases.nvst",
        "crates/nvs-syntax/src/parser/tests/decl.rs"
      ]
    },
    {
      "id": "enums/no-case-keyword",
      "title": "PHP's `case` keyword does not parse, and each one is diagnosed where it is written",
      "status": "shipped",
      "because": ["0010"],
      "divergesFromPhp": "`case Hearts = 1;` is not a spelling this language has — an enum body is a comma list",
      "seeAlso": ["enums/declaration", "enums/no-class-machinery"],
      "guardedBy": ["crates/nvs-syntax/src/parser/tests/decl.rs"]
    },
    {
      "id": "enums/closed-integer-type",
      "title": "An enum declares a new, closed, named integer type",
      "status": "shipped",
      "because": ["0010", "0007", "0008"],
      "divergesFromPhp": "an enum is not a class in disguise — a case is a compile-time constant, with no singleton, no allocation and no identity",
      "seeAlso": [
        "enums/declaration",
        "enums/one-backing-type",
        "enums/no-class-machinery",
        "enums/representation"
      ],
      "guardedBy": [
        "tests/conformance/enum/an-enum-case-is-its-integer.nvst",
        "tests/conformance/enum/an-enum-crosses-a-method-boundary.nvst",
        "tests/conformance/enum/an-enum-typed-property-round-trips.nvst",
        "tests/conformance/enum/an-enum-is-returned-and-stored-in-an-array.nvst"
      ]
    },
    {
      "id": "enums/one-backing-type",
      "title": "Every enum is backed by exactly one integer type, and nothing else backs one",
      "status": "shipped",
      "because": ["0010", "0007"],
      "divergesFromPhp": "there is no pure enum and no `string`-backed enum, and `BackedEnum` and `UnitEnum` do not exist",
      "seeAlso": ["enums/declaration", "enums/closed-integer-type", "enums/representation"],
      "guardedBy": [
        "crates/nvs-syntax/src/parser/tests/decl.rs",
        "crates/nvs-codegen/tests/arithmetic.rs",
        "tests/conformance/core/json-decodes-an-enum-field.nvst"
      ]
    },
    {
      "id": "enums/representation",
      "title": "An enum value costs nothing beyond the integer it is",
      "status": "shipped",
      "because": ["0010", "0007", "0006", "0004"],
      "divergesFromPhp": "a case is a scalar, so it copies across an isolate boundary like an `int` and has no identity to preserve",
      "seeAlso": ["enums/no-class-machinery", "enums/one-backing-type", "enums/closed-integer-type"],
      "guardedBy": [
        "tests/conformance/core/json-decodes-an-enum-field.nvst",
        "tests/conformance/enum/an-enum-fills-an-array-and-survives-a-sort.nvst",
        "tests/conformance/enum/an-enum-flows-through-a-generator.nvst"
      ]
    },
    {
      "id": "enums/truthiness",
      "title": "An enum case is always truthy, whatever integer backs it",
      "status": "shipped",
      "because": ["0035", "0010"],
      "seeAlso": ["enums/representation", "enums/no-class-machinery", "enums/closed-integer-type"],
      "guardedBy": ["crates/nvs-codegen/tests/arithmetic.rs"]
    },
    {
      "id": "enums/no-class-machinery",
      "title": "A case is an integer constant, and an enum body declares nothing but cases",
      "status": "shipped",
      "because": ["0010", "0008", "0011"],
      "divergesFromPhp": "no methods, no interfaces, no enum constants, and no `::cases()`, `::from()`, `::tryFrom()`, `->value` or `->name`",
      "seeAlso": [
        "enums/closed-integer-type",
        "enums/representation",
        "enums/no-case-keyword",
        "enums/reflection"
      ],
      "guardedBy": [
        "crates/nvs-syntax/src/parser/tests/decl.rs",
        "crates/nvs-ir/tests/class_constants.rs",
        "tests/conformance/enum/an-enum-orders-and-sums-through-its-integer.nvst",
        "tests/conformance/reject/an-enum-case-is-not-an-array-key.nvst"
      ]
    },
    {
      "id": "enums/reflection",
      "title": "Reflection describes an enum's shape and grants it nothing a class has",
      "status": "shipped",
      "because": ["0019", "0010"],
      "divergesFromPhp": "there are no case instances for a description to hand back — it carries the type's name and its case list, and nothing that acts",
      "seeAlso": ["enums/no-class-machinery", "enums/closed-integer-type"],
      "guardedBy": [
        "tests/conformance/core/enum-info-describes-a-declared-enum.nvst",
        "tests/conformance/core/enum-info-of-answers-null-for-what-declares-no-enum.nvst",
        "tests/conformance/core/enum-info-reports-both-backings-and-refuses-an-unknown-case.nvst",
        "tests/conformance/core/enum-info-cases-agree-with-value-of-over-every-case.nvst",
        "tests/conformance/core/enum-info-round-trips-its-name-and-keeps-each-enums-own-backing.nvst"
      ]
    }
  ]
}
