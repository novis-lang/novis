{
  "topic": "core-api",
  "title": "The Core API",
  "order": 150,
  "rules": [
    {
      "id": "core-api/core-means-always-present",
      "title": "`Core` means always present, so nothing outside Tier 0 may register a name under it",
      "status": "shipped",
      "because": ["0051", "0011", "0003"],
      "seeAlso": ["core-api/reserved-namespace", "core-api/tier-placement", "core-api/five-placements"],
      "guardedBy": [
        "crates/nvs-stdlib/tests/tier_boundary.rs"
      ]
    },
    {
      "id": "core-api/tier-placement",
      "title": "A library candidate is placed by six ordered tests, not by PHP's extension list",
      "status": "shipped",
      "because": ["0051", "0003", "0082", "0145", "0024"],
      "divergesFromPhp": "PHP's extension partition tracks 1997 C build engineering and is not inherited — `ctype` and `str_pad` land in the same place",
      "seeAlso": ["core-api/five-placements", "core-api/tier-roster", "core-api/core-means-always-present", "programs/framework-core-half"],
      "guardedBy": [
        "crates/nvs-stdlib/tests/tier_boundary.rs"
      ]
    },
    {
      "id": "core-api/five-placements",
      "title": "A candidate lands in exactly one of five placements: Core, Native, Ext, Dropped or answered",
      "status": "shipped",
      "because": ["0051", "0003", "0081"],
      "seeAlso": ["core-api/tier-placement", "core-api/tier-roster", "core-api/core-means-always-present"],
      "guardedBy": [
        "crates/nvs-stdlib/tests/tier_boundary.rs"
      ]
    },
    {
      "id": "core-api/tier-roster",
      "title": "Every subsystem's tier is recorded once in the roster, including the ones no milestone has built",
      "status": "designed",
      "because": ["0051", "0067", "0076", "0086", "0120", "0121", "0122", "0123"],
      "seeAlso": ["core-api/tier-placement", "core-api/five-placements", "core-api/core-means-always-present"],
      "guardedBy": [
        "crates/nvs-stdlib/tests/tier_boundary.rs",
        "crates/nvs-stdlib/src/registry.rs"
      ]
    },
    {
      "id": "core-api/reserved-namespace",
      "title": "The `Core` namespace is the compiler's: nothing may declare under it and its rosters are closed while compiling",
      "status": "shipped",
      "because": ["0011", "0015", "0051"],
      "divergesFromPhp": "a misspelled built-in is a compile error naming the member rather than a run-time undefined-function fatal",
      "seeAlso": ["core-api/core-means-always-present", "core-api/a-domain-class-is-a-singular-noun", "classes/no-free-functions-or-constants", "classes/no-class-alias", "statements/nothing-gets-a-second-name"],
      "guardedBy": [
        "tests/conformance/reject/an-unknown-core-member-is-a-compile-error.nvst",
        "tests/conformance/reject/an-unknown-core-constant-is-a-compile-error.nvst",
        "tests/conformance/reject/an-unregistered-core-member-is-unknown.nvst",
        "crates/nvs-syntax/src/parser/decl.rs"
      ]
    },
    {
      "id": "core-api/a-domain-class-is-a-singular-noun",
      "title": "A domain class is a singular noun and its object types nest under it",
      "status": "shipped",
      "because": ["0063", "0011"],
      "seeAlso": ["core-api/members-are-full-words", "core-api/reserved-namespace", "classes/no-free-functions-or-constants"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs"
      ]
    },
    {
      "id": "core-api/shape-rules",
      "title": "Every `Core` member obeys the same twenty shape rules, R1–R20",
      "status": "shipped",
      "because": ["0063", "0011", "0051", "0135", "0147"],
      "divergesFromPhp": "PHP's built-ins have no API at all — argument order, failure signalling and option encoding vary between neighbouring functions in the same extension",
      "seeAlso": ["core-api/subject-first", "core-api/options-bag", "core-api/nothing-mutates", "core-api/failure-throws", "core-api/one-paradigm-per-operation"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs",
        "crates/nvs-stdlib/tests/spec_registry_coverage.rs"
      ]
    },
    {
      "id": "core-api/subject-first",
      "title": "The subject is parameter 1 of every `Core` member, with no exceptions",
      "status": "shipped",
      "because": ["0063"],
      "divergesFromPhp": "`array_map(f, a)` beside `array_filter(a, f)`, and `in_array`, `str_replace` and `preg_match` disagreeing about haystack-before-needle, all become one order",
      "seeAlso": ["core-api/shape-rules", "core-api/one-name-one-signature"],
      "guardedBy": [
        "tests/conformance/core/arr-map-and-filter.nvst",
        "crates/nvs-stdlib/src/registry.rs"
      ]
    },
    {
      "id": "core-api/verb-lexicon",
      "title": "A member's verb predicts its return type, and `…OrNull`, `…Safe`, `…Ex` and every `try…` but `tryParse` are banned",
      "status": "shipped",
      "because": ["0063", "0145"],
      "seeAlso": ["core-api/failure-throws", "core-api/symmetric-names", "expressions/try-parse"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs"
      ]
    },
    {
      "id": "core-api/symmetric-names",
      "title": "A symmetric operation gets a symmetric name, and which pair to reach for is a rule rather than taste",
      "status": "shipped",
      "because": ["0063"],
      "seeAlso": ["core-api/verb-lexicon", "core-api/members-are-full-words"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs"
      ]
    },
    {
      "id": "core-api/one-name-one-signature",
      "title": "One name has one signature, and two behaviours need two names",
      "status": "shipped",
      "because": ["0063", "0051"],
      "seeAlso": ["core-api/verb-lexicon", "core-api/two-cache-tiers", "statements/nothing-gets-a-second-name"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs"
      ]
    },
    {
      "id": "core-api/members-are-full-words",
      "title": "A member name is a full word; only a class name may abbreviate, and only from a closed list",
      "status": "shipped",
      "because": ["0063", "0011"],
      "divergesFromPhp": "`strlen` is `Core\\Str::length`, not `Core\\Str::len`",
      "seeAlso": ["core-api/identifier-casing", "core-api/a-domain-class-is-a-singular-noun"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs"
      ]
    },
    {
      "id": "core-api/identifier-casing",
      "title": "An identifier's casing is fixed by its category and a mismatch is a hard compile error",
      "status": "shipped",
      "because": ["0029", "0030", "0011"],
      "divergesFromPhp": "PHP checks legal characters and never case, so `snake_case` identifiers do not compile here",
      "seeAlso": ["core-api/casing-checks-the-leading-character", "core-api/casing-has-no-suppression", "core-api/members-are-full-words", "classes/no-leading-underscore-identifiers", "classes/names-resolve-case-sensitively", "statements/nothing-gets-a-second-name"],
      "guardedBy": [
        "crates/nvs-syntax/src/casing.rs",
        "tests/conformance/reject/a-class-name-must-be-pascalcase.nvst",
        "tests/conformance/reject/a-method-name-must-be-camelcase.nvst",
        "tests/conformance/reject/a-class-constant-must-be-screaming-snake-case.nvst",
        "tests/conformance/reject/an-enum-case-must-be-pascalcase.nvst"
      ]
    },
    {
      "id": "core-api/casing-checks-the-leading-character",
      "title": "Only the leading character's case is checked, so `HTTPClient` and `HttpClient` both pass",
      "status": "shipped",
      "because": ["0029"],
      "seeAlso": ["core-api/identifier-casing", "core-api/casing-has-no-suppression"],
      "guardedBy": [
        "crates/nvs-syntax/src/casing.rs",
        "tests/conformance/reject/a-class-name-must-be-pascalcase.nvst"
      ]
    },
    {
      "id": "core-api/casing-has-no-suppression",
      "title": "There is no suppression mechanism for a casing error, in any category",
      "status": "shipped",
      "because": ["0029", "0030"],
      "divergesFromPhp": "unlike Rust's `#[allow(non_snake_case)]` there is no attribute, pragma or per-file opt-out; a name mirroring an external format is renamed or does not compile",
      "seeAlso": ["core-api/identifier-casing", "core-api/written-visibility"],
      "guardedBy": [
        "crates/nvs-syntax/src/casing.rs",
        "crates/nvs-syntax/src/lexer.rs"
      ]
    },
    {
      "id": "core-api/written-visibility",
      "title": "Every member declaration writes exactly one visibility keyword, and there is no implicit `public`",
      "status": "shipped",
      "because": ["0094", "0043", "0029"],
      "divergesFromPhp": "`function f()`, `const X = 1`, `var $x;` and `readonly int $x;` all fail to compile — PHP's silent `public` has no successor",
      "seeAlso": ["core-api/a-parameter-is-not-a-member", "core-api/asymmetric-visibility-is-a-pair", "core-api/legacy-property-shapes-name-the-visibility", "classes/interface-private-methods", "classes/property-hooks", "types/declaration"],
      "guardedBy": [
        "tests/conformance/reject/a-member-must-declare-its-visibility.nvst",
        "tests/conformance/lang/a-class-reaches-its-own-private-members.nvst",
        "tests/conformance/lang/a-private-member-is-refused-outside-its-class.nvst",
        "tests/conformance/lang/a-private-constructor-refuses-new-from-outside.nvst",
        "crates/nvs-syntax/src/casing.rs",
        "crates/nvs-types/tests/visibility.rs"
      ]
    },
    {
      "id": "core-api/asymmetric-visibility-is-a-pair",
      "title": "An asymmetric property writes both halves, so a bare `private(set)` does not compile",
      "status": "shipped",
      "because": ["0094"],
      "divergesFromPhp": "PHP 8.4 infers a `public` read side for a bare `private(set)`; that is the same implicit `public` in a different spelling and is refused",
      "seeAlso": ["core-api/written-visibility"],
      "guardedBy": [
        "crates/nvs-syntax/src/casing.rs",
        "crates/nvs-types/src/signatures.rs"
      ]
    },
    {
      "id": "core-api/legacy-property-shapes-name-the-visibility",
      "title": "`var $x;` and a bare `int $x;` in a class body report the missing visibility, not a statement error",
      "status": "shipped",
      "because": ["0094", "0037"],
      "seeAlso": ["core-api/written-visibility", "classes/no-dynamic-properties", "types/var-inference"],
      "guardedBy": [
        "tests/conformance/reject/a-member-must-declare-its-visibility.nvst",
        "crates/nvs-syntax/src/casing.rs"
      ]
    },
    {
      "id": "core-api/a-parameter-is-not-a-member",
      "title": "A constructor parameter is not a member, because visibility is what promotes one",
      "status": "shipped",
      "because": ["0094"],
      "seeAlso": ["core-api/written-visibility", "classes/promotion-is-constructor-only"],
      "guardedBy": [
        "crates/nvs-syntax/src/casing.rs",
        "tests/conformance/class/a-promoted-constructor-parameter-is-a-property.nvst"
      ]
    },
    {
      "id": "core-api/written-participation",
      "title": "A class participates in a wire format only where it writes so, never structurally",
      "status": "shipped",
      "because": ["0063", "0071", "0028", "0033"],
      "divergesFromPhp": "there is no `JsonSerializable`-style magic hook and no structural encoding of public properties",
      "seeAlso": ["core-api/required-optional-and-nullable", "classes/no-magic-methods", "classes/serialize-is-a-closed-format", "attributes/inert-metadata", "types/object-top"],
      "guardedBy": [
        "tests/conformance/core/json-encode-decode-and-validate.nvst",
        "tests/conformance/core/json-encodes-a-shape-as-an-object.nvst",
        "tests/conformance/core/json-derive-encodes-declared-fields.nvst"
      ]
    },
    {
      "id": "core-api/qualifier-behaviour-is-declared",
      "title": "Every `Core` member declares whether it is a sink, a launderer, contagious or neutral",
      "status": "shipped",
      "because": ["0063", "0024", "0055", "0135"],
      "seeAlso": ["core-api/shape-flattens-at-the-abi", "core-api/tier-placement"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs",
        "tests/conformance/reject/a-core-io-path-refuses-a-tainted-argument.nvst"
      ]
    },
    {
      "id": "core-api/nothing-mutates",
      "title": "No `Core` member mutates its argument and none takes a reference",
      "status": "shipped",
      "because": ["0063"],
      "divergesFromPhp": "`sort($a)` becomes `$a = Arr::sort($a)`; there are no by-reference mutators, no out-parameters and no in-place variants",
      "seeAlso": ["core-api/shape-rules", "core-api/no-mutable-immutable-twins", "statements/inout-is-the-by-reference-spelling"],
      "guardedBy": [
        "tests/conformance/core/arr-map-and-filter-keep-their-keys.nvst",
        "crates/nvs-stdlib/src/arr.rs"
      ]
    },
    {
      "id": "core-api/no-mutable-immutable-twins",
      "title": "Every `Core` value type is immutable, so no mutable twin exists to choose between",
      "status": "shipped",
      "because": ["0063"],
      "divergesFromPhp": "there is no `DateTime`/`DateTimeImmutable` pair — one type, immutable",
      "seeAlso": ["core-api/nothing-mutates", "core-api/one-paradigm-per-operation", "classes/two-copy-depths"],
      "guardedBy": [
        "crates/nvs-stdlib/src/time.rs",
        "crates/nvs-stdlib/src/registry.rs"
      ]
    },
    {
      "id": "core-api/no-ambient-state",
      "title": "No `Core` member reads ambient state: there is no default timezone, locale, array pointer or error global",
      "status": "shipped",
      "because": ["0063", "0051"],
      "divergesFromPhp": "`setlocale`, `date_default_timezone_set`, the internal array pointer and every error global are absent; a `Zone` is an argument at every instant↔calendar conversion",
      "seeAlso": ["core-api/removals", "core-api/tier-placement", "statements/no-function-static-and-no-global"],
      "guardedBy": [
        "crates/nvs-stdlib/src/cldr.rs",
        "crates/nvs-config/src/schedule.rs"
      ]
    },
    {
      "id": "core-api/failure-throws",
      "title": "A `Core` member throws on failure and returns `?T` for absence; `false` is never an answer",
      "status": "shipped",
      "because": ["0063"],
      "divergesFromPhp": "no member returns `false` to signal failure, no member returns an error code, and there is no `json_last_error` or `error_get_last`",
      "seeAlso": ["core-api/verb-lexicon", "core-api/one-refusal-except-expiry", "errors/throwable-hierarchy", "expressions/nullable-conversion-availability"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs",
        "tests/conformance/core/json-encode-refuses-exactly-the-values-json-cannot-spell.nvst"
      ]
    },
    {
      "id": "core-api/one-paradigm-per-operation",
      "title": "No operation is reachable two ways, and a domain class's statics never mirror an object's own methods",
      "status": "shipped",
      "because": ["0063", "0051", "0122"],
      "divergesFromPhp": "the procedural twin of every OOP subsystem is gone — `date_*`, `collator_*`, the `fopen` family beside `SplFileObject`, `mysqli` twice",
      "seeAlso": ["core-api/no-methods-on-scalars-or-arrays", "core-api/no-mutable-immutable-twins", "core-api/each-door-takes-a-different-thing", "classes/no-call-magic", "expressions/pipeline-substitution"],
      "guardedBy": [
        "tests/conformance/reject/a-core-instance-member-has-one-spelling.nvst",
        "crates/nvs-stdlib/src/registry.rs"
      ]
    },
    {
      "id": "core-api/no-methods-on-scalars-or-arrays",
      "title": "A scalar and an `array<T>` never gain methods",
      "status": "shipped",
      "because": ["0063"],
      "divergesFromPhp": "there is no `$s->length()` and no `$a->map()` — `Core\\Str` and `Core\\Arr` are the one spelling",
      "seeAlso": ["core-api/one-paradigm-per-operation", "types/erased-member-access"],
      "guardedBy": [
        "crates/nvs-types/src/expr/calls.rs"
      ]
    },
    {
      "id": "core-api/no-mode-strings",
      "title": "A mode is an enum, never a string or an integer constant, and only four grammars are exempt",
      "status": "shipped",
      "because": ["0063"],
      "divergesFromPhp": "`fopen($p, \"r+b\")`, `hash(\"sha256\", …)` and `MB_CASE_TITLE` have no spelling; a closed enum, or a subset of one, takes their place",
      "seeAlso": ["core-api/units-are-types", "enums/closed-integer-type", "types/literal-types", "expressions/intrinsic-literals"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs",
        "tests/conformance/core/regex-split-honours-its-options.nvst"
      ]
    },
    {
      "id": "core-api/units-are-types",
      "title": "A unit is a type: a duration is a `Duration` and a size is `uint` bytes",
      "status": "shipped",
      "because": ["0063"],
      "divergesFromPhp": "the `sleep`/`usleep`/`time_nanosleep` split does not exist — one parameter takes one `Duration`",
      "seeAlso": ["core-api/no-mode-strings", "types/duration-literal"],
      "guardedBy": [
        "tests/conformance/core/time-duration-constructors-and-readers-are-one-scale.nvst"
      ]
    },
    {
      "id": "core-api/no-encoding-argument",
      "title": "A `string` member never takes an encoding argument",
      "status": "shipped",
      "because": ["0063", "0051"],
      "seeAlso": ["types/string-is-utf8", "types/bytes"],
      "guardedBy": [
        "crates/nvs-stdlib/src/encoding.rs",
        "crates/nvs-stdlib/src/str.rs"
      ]
    },
    {
      "id": "core-api/one-range-convention",
      "title": "Every range is `(offset, ?length)`, and a negative counts from the end",
      "status": "shipped",
      "because": ["0063"],
      "seeAlso": ["core-api/shape-rules", "types/preserve-keys"],
      "guardedBy": [
        "crates/nvs-stdlib/src/arr.rs",
        "crates/nvs-stdlib/src/str.rs"
      ]
    },
    {
      "id": "core-api/callback-receives-value-and-key",
      "title": "A callback always receives `($value, $key)`, and may declare fewer parameters than the call site passes",
      "status": "shipped",
      "because": ["0063"],
      "divergesFromPhp": "`ARRAY_FILTER_USE_KEY` and `ARRAY_FILTER_USE_BOTH` have nothing to select, and there is no `map`/`mapWithKey` pair",
      "seeAlso": ["core-api/no-mode-strings", "types/callable-arity", "types/callable-is-a-closure"],
      "guardedBy": [
        "tests/conformance/core/arr-map-and-filter.nvst",
        "tests/conformance/core/arr-map-keys-rekeys-and-group-by-partitions.nvst"
      ]
    },
    {
      "id": "core-api/parameters-are-callable-by-name",
      "title": "Every `Core` parameter is callable by the name the spec writes, and that name is compatibility surface",
      "status": "shipped",
      "because": ["0063", "0117"],
      "seeAlso": ["core-api/options-bag", "core-api/reference-card", "types/arrays"],
      "guardedBy": [
        "tests/conformance/reject/a-misspelled-name-at-a-core-member-is-unknown.nvst",
        "crates/nvs-stdlib/tests/spec_registry_coverage.rs",
        "crates/nvs-stdlib/src/registry.rs"
      ]
    },
    {
      "id": "core-api/options-bag",
      "title": "A member's optional knobs are one trailing shape literal, never a flag or a bitmask",
      "status": "shipped",
      "because": ["0063", "0147", "0135"],
      "divergesFromPhp": "there are no `bool` flag parameters, no `int` bitmask constants and no positional optional tail longer than one",
      "seeAlso": ["core-api/parameters-are-callable-by-name", "core-api/shape-parameter", "core-api/omission-is-not-a-written-null", "types/object-top"],
      "guardedBy": [
        "crates/nvs-types/tests/core_members.rs",
        "crates/nvs-codegen/tests/core_str.rs",
        "tests/conformance/core/command-run-fills-an-unwritten-option-from-its-declared-default.nvst"
      ]
    },
    {
      "id": "core-api/required-optional-and-nullable",
      "title": "Required, optional and nullable are three separate questions: nullability belongs to the type and optionality to the default",
      "status": "designed",
      "because": ["0071", "0063"],
      "divergesFromPhp": "`?T` never means \"the key may be absent\", and there is no omit-when-null encoding option",
      "seeAlso": ["core-api/written-participation", "core-api/omission-is-not-a-written-null", "core-api/the-marker-never-reaches-a-program", "types/unions-and-mixed"],
      "guardedBy": [
        "tests/conformance/core/json-decode-as-admits-exactly-its-declared-type.nvst",
        "tests/conformance/core/json-derive-decodes-and-reports-every-field.nvst",
        "crates/nvs-stdlib/src/json.rs"
      ]
    },
    {
      "id": "core-api/omission-is-not-a-written-null",
      "title": "An options bag tells an omitted key from a written `null`",
      "status": "shipped",
      "because": ["0147", "0063", "0135", "0022"],
      "divergesFromPhp": "PHP has no way to ask either question of an argument; here the two are different requests at every `Core` member",
      "seeAlso": ["core-api/a-nullable-field-omits-as-the-never-written-marker", "core-api/a-written-null-removes", "core-api/the-bag-abi-is-unchanged", "core-api/options-bag"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs",
        "tests/conformance/core/uri-with-tells-an-omitted-component-from-a-written-null.nvst"
      ]
    },
    {
      "id": "core-api/a-nullable-field-omits-as-the-never-written-marker",
      "title": "A bag or shape field is nullable exactly when its omission fills the never-written marker",
      "status": "shipped",
      "because": ["0147", "0135", "0022"],
      "seeAlso": ["core-api/omission-is-not-a-written-null", "core-api/the-marker-never-reaches-a-program", "core-api/shape-flattens-at-the-abi"],
      "guardedBy": [
        "crates/nvs-stdlib/src/registry.rs",
        "tests/conformance/reject/a-uri-component-with-no-removal-refuses-a-written-null.nvst"
      ]
    },
    {
      "id": "core-api/a-written-null-removes",
      "title": "Wherever a `Core` member admits a written `null` it means remove, and `\"\"` is never a removal spelling",
      "status": "shipped",
      "because": ["0147", "0063"],
      "divergesFromPhp": "PHP spreads clearing across `unset`, `\"\"`, `false` and per-function sentinels; here one spelling means one thing at every member",
      "seeAlso": ["core-api/omission-is-not-a-written-null", "core-api/a-lifetime-is-written", "core-api/no-mode-strings"],
      "guardedBy": [
        "crates/nvs-stdlib/src/uri.rs",
        "tests/conformance/core/uri-with-tells-an-omitted-component-from-a-written-null.nvst"
      ]
    },
    {
      "id": "core-api/the-marker-never-reaches-a-program",
      "title": "The never-written marker is not in the type system and is never handed to user code",
