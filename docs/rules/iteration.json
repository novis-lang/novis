{
  "topic": "iteration",
  "title": "Iteration",
  "order": 20,
  "rules": [
    {
      "id": "iteration/two-interfaces",
      "title": "Two interfaces carry every iteration, and a cursor is `advance()` then `current()`",
      "status": "shipped",
      "because": ["0053", "0007", "0028"],
      "divergesFromPhp": "no `rewind()`, `key()`, `valid()` or `IteratorAggregate`, and none of the ~20 SPL iterator classes; a cursor has two members and no key half",
      "seeAlso": [
        "iteration/foreach-subjects",
        "iteration/concrete-generic-implements",
        "iteration/cursor-out-of-range",
        "iteration/generators"
      ],
      "guardedBy": [
        "tests/conformance/iter/an-iterator-object-is-driven-by-hand.nvst",
        "tests/conformance/iter/an-iterable-object-is-drained-twice.nvst",
        "tests/conformance/iter/an-iterator-subclass-overrides-what-current-yields.nvst",
        "tests/conformance/lang/an-iterable-and-an-intersection-are-declarable.nvst"
      ]
    },
    {
      "id": "iteration/cursor-out-of-range",
      "title": "`current()` outside the protocol throws rather than answering",
      "status": "shipped",
      "because": ["0053"],
      "divergesFromPhp": "reading a cursor before it has advanced, or after it is drained, is an error rather than a `null` or a stale element",
      "seeAlso": ["iteration/two-interfaces", "iteration/generators"],
      "guardedBy": [
        "tests/conformance/error/iterator-current-outside-the-protocol-throws.nvst"
      ]
    },
    {
      "id": "iteration/concrete-generic-implements",
      "title": "A class implements a compiler-owned generic interface at a concrete type, and declares no type variable of its own",
      "status": "shipped",
      "because": ["0053", "0007"],
      "seeAlso": ["iteration/two-interfaces", "iteration/foreach-subjects"],
      "guardedBy": ["crates/nvs-types/tests/generics.rs"]
    },
    {
      "id": "iteration/foreach-subjects",
      "title": "`foreach` drives exactly three subjects, and a fourth is refused where it is written",
      "status": "shipped",
      "because": ["0053", "0007"],
      "divergesFromPhp": "an object is iterable only by declaring `Iterable<T>` or `Iterator<T>`; walking an ordinary object's public properties does not compile",
      "seeAlso": [
        "iteration/two-interfaces",
        "iteration/no-magic-collection-interfaces",
        "iteration/generators"
      ],
      "guardedBy": [
        "tests/conformance/lang/a-foreach-subject-that-is-not-iterable-is-refused-where-it-is-written.nvst",
        "tests/conformance/lang/a-foreach-key-binding-is-a-string-and-nothing-else.nvst",
        "tests/conformance/iter/foreach-over-an-iterable-object.nvst",
        "crates/nvs-types/tests/foreach.rs"
      ]
    },
    {
      "id": "iteration/no-magic-collection-interfaces",
      "title": "A class cannot make `$obj[$k]` or a count into a method call",
      "status": "shipped",
      "because": ["0053", "0028", "0014", "0011"],
      "divergesFromPhp": "`ArrayAccess` and `Countable` do not exist; a collection exposes `->get($k)`, `->set($k, $v)` and `->count()` instead",
      "seeAlso": ["iteration/foreach-subjects", "iteration/two-interfaces"],
      "guardedBy": []
    },
    {
      "id": "iteration/generators",
      "title": "A body that yields is a generator, and calling one returns a state object without running a line of it",
      "status": "shipped",
      "because": ["0053"],
      "divergesFromPhp": "a generator is a compiled state machine rather than a suspended stack, so it costs one small object and behaves the same on every compile target",
      "seeAlso": [
        "iteration/yield-lexical-confinement",
        "iteration/one-way-only",
        "iteration/two-interfaces",
        "iteration/generator-stays-in-one-isolate"
      ],
      "guardedBy": [
        "tests/conformance/iter/a-generator-is-drained-lazily.nvst",
        "tests/conformance/iter/a-generator-yields-in-order.nvst",
        "tests/conformance/iter/two-generators-from-one-method-advance-independently.nvst",
        "tests/conformance/iter/an-abandoned-generator-runs-the-finally-it-is-suspended-inside.nvst",
        "crates/nvs-types/tests/generators.rs",
        "crates/nvs-ir/src/lower/tests.rs"
      ]
    },
    {
      "id": "iteration/yield-lexical-confinement",
      "title": "`yield` appears only in the generator's own body",
      "status": "shipped",
      "because": ["0053"],
      "divergesFromPhp": "a helper called from a generator cannot yield into it; delegation is written as a `foreach` that re-yields",
      "seeAlso": ["iteration/generators", "iteration/one-way-only"],
      "guardedBy": [
        "crates/nvs-types/tests/generators.rs",
        "crates/nvs-types/tests/closures.rs"
      ]
    },
    {
      "id": "iteration/one-way-only",
      "title": "A generator is a lazy sequence and nothing more",
      "status": "shipped",
      "because": ["0053", "0051"],
      "divergesFromPhp": "no `yield from`, no `send()`, no `throw()` into a generator, no keyed `yield`, and no generator return value to retrieve",
      "seeAlso": ["iteration/generators", "iteration/yield-lexical-confinement"],
      "guardedBy": [
        "tests/conformance/reject/a-yield-has-no-key-half.nvst",
        "tests/conformance/lang/a-yield-is-a-statement-not-a-value.nvst",
        "tests/conformance/iter/a-generator-drains-another-generator.nvst",
        "tests/conformance/iter/a-generator-has-no-key-to-bind.nvst"
      ]
    },
    {
      "id": "iteration/generator-stays-in-one-isolate",
      "title": "A generator does not cross a boundary and does not clone",
      "status": "designed",
      "because": ["0053", "0023"],
      "seeAlso": ["iteration/generators"],
      "guardedBy": []
    },
    {
      "id": "iteration/for-init-clause",
      "title": "A `for` init clause is one typed declaration or a list of expressions, never both",
      "status": "shipped",
      "because": ["0109", "0007", "0037"],
      "seeAlso": ["iteration/for-counter-scope", "iteration/for-init-refusals"],
      "guardedBy": [
        "tests/conformance/lang/a-for-header-declares-its-own-counter.nvst",
        "tests/conformance/lang/a-for-loop-runs-init-condition-and-step.nvst",
        "crates/nvs-syntax/src/parser/tests/stmt.rs"
      ]
    },
    {
      "id": "iteration/for-counter-scope",
      "title": "A header-declared counter is function-scoped, and a second header declaring it again is refused",
      "status": "shipped",
      "because": ["0109", "0007"],
      "seeAlso": ["iteration/for-init-clause", "iteration/for-init-refusals"],
      "guardedBy": [
        "tests/conformance/lang/a-for-header-declares-its-own-counter.nvst",
        "tests/conformance/reject/a-second-for-header-redeclaring-its-counter-is-refused.nvst",
        "crates/nvs-types/src/locals.rs"
      ]
    },
    {
      "id": "iteration/for-init-refusals",
      "title": "A refused `for` header is one diagnostic, never a cascade",
      "status": "shipped",
      "because": ["0109"],
      "seeAlso": ["iteration/for-init-clause", "iteration/for-counter-scope"],
      "guardedBy": [
        "tests/conformance/reject/a-for-init-clause-is-a-declaration-or-expressions-not-both.nvst",
        "tests/conformance/reject/a-for-init-clause-declares-at-most-one-binding.nvst"
      ]
    }
  ]
}
