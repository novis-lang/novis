      "because": ["0007", "0047", "0066", "0150", "0192"],
      "seeAlso": ["types/unions-and-mixed", "types/conversion", "types/enum-case-type", "types/type-test", "types/class-reference-sites"],
      "guardedBy": [
        "tests/conformance/lang/a-null-test-narrows-a-nullable-local.nvst",
