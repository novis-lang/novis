        "tests/conformance/lang/an-is-test-over-a-mixed-subject-answers-the-scalar-class-array-and-literal-rows.nvst",
        "tests/conformance/lang/an-is-test-against-a-shape-walks-its-fields.nvst",
        "tests/conformance/lang/an-is-test-against-iterable-or-callable-answers-by-what-the-value-holds.nvst",
        "tests/conformance/lang/an-is-test-against-an-enum-agrees-with-its-own-case-rows.nvst",
        "tests/conformance/lang/an-is-test-against-a-union-or-an-intersection-asks-each-member.nvst",
        "tests/conformance/lang/an-is-test-against-a-class-reference-is-the-dynamic-class-test.nvst"
      ]
    },
    {
      "id": "types/narrowing",
      "title": "Narrowing is flow-sensitive and branch-local, and there are exactly four spellings of it",
