    {
      "id": "types/type-alias",
      "title": "A `type` alias is a transparent, compile-time-only synonym for a type expression",
      "status": "shipped",
      "because": ["0015", "0007", "0036", "0011", "0190"],
      "seeAlso": ["types/class-scoped-alias", "types/alias-is-never-a-bare-class", "types/grammar", "types/shape-type"],
      "guardedBy": [
