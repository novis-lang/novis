{
  "topic": "types",
  "title": "Types",
  "order": 20,
  "rules": [
    {
      "id": "types/declaration",
      "title": "Every binding declares its type, and no binding's type ever changes",
      "status": "shipped",
      "because": ["0007", "0022", "0037", "0008", "0011"],
      "divergesFromPhp": "a local, a `foreach` binding, a `for` counter and a destructuring target all carry a written type, and PHP source with none does not compile",
      "seeAlso": ["types/var-inference", "types/conversion", "types/grammar", "types/unions-and-mixed"],
      "guardedBy": [
        "tests/conformance/lang/a-locals-type-is-fixed-at-its-declaration.nvst",
        "tests/conformance/lang/a-declaration-without-an-initializer-fixes-the-type.nvst",
        "tests/conformance/reject/a-compound-assignment-cannot-retype-its-target.nvst",
        "crates/nvs-types/tests/locals.rs"
      ]
    },
    {
      "id": "types/var-inference",
      "title": "`var` takes a local's type from its initializer and fixes it there for good",
      "status": "shipped",
      "because": ["0037", "0007", "0114"],
      "seeAlso": ["types/declaration", "types/numeric-literal-placement", "types/arrays"],
      "guardedBy": [
        "tests/conformance/lang/var-infers-from-its-initializer.nvst",
        "tests/conformance/lang/var-refuses-a-bare-array-literal.nvst",
        "crates/nvs-types/tests/locals.rs"
      ]
    },
    {
      "id": "types/grammar",
      "title": "The type grammar is a closed set of atoms under unions and intersections",
      "status": "shipped",
      "because": ["0007", "0009", "0015", "0024", "0031", "0033", "0036", "0047", "0053", "0054", "0125", "0126", "0136"],
      "seeAlso": ["types/declaration", "types/unions-and-mixed", "types/type-alias", "types/shape-type"],
      "guardedBy": [
        "crates/nvs-syntax/src/parser/tests/ty.rs",
        "crates/nvs-ir/tests/type_atoms.rs",
        "tests/conformance/lang/object-is-a-declared-type-in-every-position.nvst",
        "tests/conformance/lang/a-core-collection-takes-the-type-arguments-it-declares.nvst"
      ]
    },
    {
      "id": "types/integer-literals",
      "title": "An integer literal is decimal, `0x`, `0o` or `0b`, and a leading zero is not a radix",
      "status": "shipped",
      "because": ["0007"],
      "divergesFromPhp": "`017` is decimal seventeen where PHP reads octal fifteen; PHP's leading-zero octal is refused rather than reinterpreted",
      "seeAlso": ["types/uint", "types/numeric-literal-placement", "types/arithmetic"],
      "guardedBy": [
        "tests/conformance/lang/an-integer-literal-takes-uint-from-the-operand-beside-it.nvst",
        "crates/nvs-syntax/src/lexer.rs"
      ]
    },
    {
      "id": "types/numeric-literal-placement",
      "title": "A numeric literal is untyped until it is placed, and `as T` is a placing position",
      "status": "shipped",
      "because": ["0054", "0007", "0037"],
      "divergesFromPhp": "a fractional literal is not born a `float` — `decimal $price = 19.99;` is exact — and there is no literal suffix for any numeric type",
      "seeAlso": ["types/decimal", "types/integer-literals", "types/var-inference", "types/implicit-widening"],
      "guardedBy": [
        "tests/conformance/lang/an-integer-literal-takes-uint-from-the-operand-beside-it.nvst",
        "tests/conformance/core/a-literal-adapts-to-a-generic-uint.nvst",
        "crates/nvs-types/tests/decimal.rs"
      ]
    },
    {
      "id": "types/uint",
      "title": "`uint` is a distinct unsigned 64-bit integer, and it costs no bytes a value did not already hold",
      "status": "shipped",
      "because": ["0007", "0004", "0150"],
      "divergesFromPhp": "PHP has one integer type; Novis has two, told apart by `Core\\Reflect::typeOf` and by `$x is uint` (`rule:types/type-test`), so a value PHP's `is_int()` accepted answers `is uint` and not `is int`, and the whole 64-bit range is representable",
      "seeAlso": ["types/arithmetic", "types/integer-literals", "types/conversion", "types/type-test"],
      "guardedBy": [
        "tests/conformance/lang/uint-spans-its-whole-range.nvst",
        "tests/conformance/lang/uint-arithmetic-reaches-the-top-of-its-range.nvst"
      ]
    },
    {
      "id": "types/arithmetic",
      "title": "An arithmetic operator answers in its operands' own type, and overflow throws rather than wrapping or promoting",
      "status": "shipped",
      "because": ["0007", "0054", "0010", "0035"],
      "divergesFromPhp": "`PHP_INT_MAX + 1` throws `ArithmeticError` instead of becoming a `float`, `int` against `uint` does not compile, and a `bool`, `string`, `array<T>` or object operand has no `+` at all",
      "seeAlso": ["types/ordering", "types/uint", "types/decimal", "types/implicit-widening"],
      "guardedBy": [
        "tests/conformance/lang/the-arithmetic-table-is-closed.nvst",
        "tests/conformance/lang/an-integer-overflow-throws-rather-than-wrapping.nvst",
        "tests/conformance/lang/mixed-signedness-arithmetic-is-a-compile-error.nvst",
        "tests/conformance/lang/every-arithmetic-row-promotes-the-narrower-operand.nvst",
        "tests/conformance/lang/arithmetic-over-a-mixed-operand-is-decided-by-its-tag.nvst",
        "tests/conformance/reject/an-object-takes-part-in-no-arithmetic.nvst"
      ]
    },
    {
      "id": "types/implicit-widening",
      "title": "An `int` or `uint` widening into a `float` position is the only implicit conversion in the language",
      "status": "shipped",
      "because": ["0007", "0054"],
      "divergesFromPhp": "the widening throws above 2^53 instead of rounding, and no other implicit coercion survives",
      "seeAlso": ["types/conversion", "types/arithmetic", "types/numeric-literal-placement"],
      "guardedBy": [
        "tests/conformance/lang/every-arithmetic-row-promotes-the-narrower-operand.nvst",
        "tests/conformance/core/arr-a-callback-float-parameter-widens-an-int-and-stops-at-2-53.nvst"
      ]
    },
    {
      "id": "types/decimal",
      "title": "`decimal` is an exact scalar of 96 mantissa bits and a scale of 0 to 28",
      "status": "shipped",
      "because": ["0054", "0007", "0051", "0004"],
      "divergesFromPhp": "`bcmath` and `gmp` are retired rather than ported — exact fractional arithmetic is a register-sized scalar, and arbitrary-magnitude integers are `Core\\BigInt`",
      "seeAlso": ["types/numeric-literal-placement", "types/arithmetic", "types/conversion"],
      "guardedBy": [
        "tests/conformance/lang/decimal-arithmetic-is-exact-and-keeps-its-scale.nvst",
        "tests/conformance/lang/decimal-conversions-are-checked-in-both-directions.nvst",
        "tests/conformance/core/decimal-division-refuses-a-zero-divisor-and-a-scale-it-cannot-hold.nvst",
        "crates/nvs-types/tests/decimal.rs"
      ]
    },
    {
      "id": "types/ordering",
      "title": "Only the types the table orders may be ordered, and two objects need `Comparable`",
      "status": "shipped",
      "because": ["0013", "0007", "0010", "0047"],
      "divergesFromPhp": "there is no fallback ordering — PHP orders anything by converting an operand first, and Novis refuses a `string`, `bytes`, `array<T>`, `callable`, enum case or `null` operand where it is written",
      "seeAlso": ["types/arithmetic", "types/conversion", "types/unions-and-mixed"],
      "guardedBy": [
        "tests/conformance/lang/an-ordering-over-a-mixed-operand-is-decided-by-its-tag.nvst",
        "tests/conformance/lang/an-operator-agrees-whether-its-operand-is-typed-or-tagged.nvst",
        "crates/nvs-types/tests/comparable_and_stringable.rs"
      ]
    },
    {
      "id": "types/string-is-utf8",
      "title": "A `string` is valid UTF-8 for its whole lifetime, and its unmarked unit is the grapheme cluster",
      "status": "shipped",
      "because": ["0009", "0007"],
      "divergesFromPhp": "`strlen` counts bytes and needs `mb_strlen` plus a correct ambient encoding to count characters; a Novis `string` has one encoding and one length, counting extended grapheme clusters unconditionally",
      "seeAlso": ["types/bytes", "types/conversion"],
      "guardedBy": [
        "tests/conformance/core/str-length-counts-graphemes.nvst",
        "tests/conformance/core/str-graphemes-partitions-the-subject-the-other-two-members-measure.nvst",
        "tests/conformance/core/str-graphemes-and-code-points-count-different-units.nvst",
        "tests/conformance/lang/an-interpolated-string-keeps-its-grapheme-clusters.nvst"
      ]
    },
    {
      "id": "types/bytes",
      "title": "`bytes` is a primitive peer to `string` for data that carries no encoding",
      "status": "shipped",
      "because": ["0009", "0007", "0006", "0012"],
      "divergesFromPhp": "PHP has one type for text and for a buffer and never says which a value is; a request body, a socket read, a file's contents and a digest all arrive as `bytes` and become text only by a conversion that can throw",
      "seeAlso": ["types/string-is-utf8", "types/conversion", "types/grammar"],
      "guardedBy": [
        "tests/conformance/core/bytes-indexes-and-orders-by-byte-offset.nvst",
        "tests/conformance/core/bytes-predicates-search-octets-where-core-str-searches-characters.nvst",
        "tests/conformance/lang/string-and-bytes-convert-both-ways.nvst",
        "tests/conformance/lang/a-bytes-in-a-condition-is-falsy-only-when-empty.nvst",
        "tests/conformance/core/a-body-stream-chunk-is-tainted-and-a-plain-bytes-binding-refuses-it.nvst"
      ]
    },
    {
      "id": "types/duration-literal",
      "title": "`1h30m` is a `Core\\Time\\Duration` constant, in one grammar shared by source, `parse` and `nvs.toml`",
      "status": "shipped",
      "because": ["0070", "0046", "0057", "0062", "0039"],
      "seeAlso": ["types/numeric-literal-placement", "types/integer-literals"],
      "guardedBy": [
        "tests/conformance/lang/duration-literal-and-parse-share-one-grammar.nvst",
        "tests/conformance/reject/a-duration-literal-follows-one-grammar.nvst",
        "tests/conformance/reject/a-duration-unit-is-lower-case-only.nvst",
        "tests/conformance/core/time-duration-round-trips-through-parse-exactly-where-the-grammar-has-a-spelling.nvst"
      ]
    },
    {
      "id": "types/literal-types",
      "title": "A `string` or `int` literal is its own type, and a union of them is a closed set",
      "status": "shipped",
      "because": ["0047", "0007", "0024", "0033", "0066"],
      "seeAlso": ["types/constant-in-type-position", "types/enum-case-type", "types/conversion", "types/narrowing"],
      "guardedBy": [
        "tests/conformance/lang/a-conversion-into-a-closed-set-of-literals-is-checked-at-run-time.nvst",
        "tests/conformance/lang/a-conversion-into-a-set-of-mixed-literal-kinds-tags-its-operand.nvst",
        "tests/conformance/lang/a-conversion-the-operand-disproves-is-a-compile-error.nvst",
        "tests/conformance/lang/a-true-or-false-target-is-a-literal-type-of-bool.nvst",
        "crates/nvs-types/tests/literal_types.rs"
      ]
    },
    {
      "id": "types/constant-in-type-position",
      "title": "A scalar class constant used as a type folds to its own literal type",
      "status": "shipped",
      "because": ["0047", "0046"],
      "seeAlso": ["types/literal-types", "types/enum-case-type"],
      "guardedBy": [
        "crates/nvs-types/tests/literal_types.rs",
        "crates/nvs-syntax/src/parser/tests/ty.rs"
      ]
    },
    {
      "id": "types/enum-case-type",
      "title": "An enum case used as a type is a narrowed subtype of its enum, never its backing integer",
      "status": "shipped",
      "because": ["0047", "0010", "0007"],
      "seeAlso": ["types/literal-types", "types/conversion", "types/narrowing"],
      "guardedBy": [
        "tests/conformance/lang/a-conversion-into-a-closed-set-of-enum-cases-is-checked-at-run-time.nvst",
        "tests/conformance/lang/an-enum-case-comparison-narrows-its-subject.nvst",
        "crates/nvs-types/tests/literal_types.rs"
      ]
    },
    {
      "id": "types/arrays",
      "title": "An array is PHP's ordered hash with `string` keys and a declared element type",
      "status": "shipped",
      "because": ["0007", "0069", "0114", "0002", "0159", "0188"],
      "divergesFromPhp": "there is no integer key — `Core\\Arr::keys()` returns `array<string>` and a `foreach` key binds as a `string` — and an element type is declared and enforced on every write, reading covariantly",
      "seeAlso": ["types/mixed-subscript", "types/array-combination", "types/preserve-keys", "types/conversion", "types/shape-type"],
      "guardedBy": [
        "tests/conformance/array/a-numeric-string-key-normalises-to-an-int.nvst",
        "tests/conformance/lang/a-foreach-key-binding-is-a-string-and-nothing-else.nvst",
        "tests/conformance/lang/an-array-converts-element-by-element-and-its-nullable-twin-agrees.nvst",
        "tests/conformance/lang/a-spread-array-element-is-checked-against-the-literals-element-type.nvst",
        "tests/conformance/core/arr-a-callback-key-is-a-string-on-a-list-too.nvst",
        "tests/conformance/core/arr-flip-takes-an-array-of-string-without-a-conversion.nvst",
        "tests/conformance/lang/an-array-of-string-is-passed-where-an-array-of-int-or-string-is-read.nvst",
        "crates/nvs-types/tests/arrays.rs"
      ]
    },
    {
      "id": "types/array-combination",
      "title": "Three combining members treat every key alike, and `array + array` does not compile",
      "status": "shipped",
      "because": ["0069", "0007", "0063"],
      "divergesFromPhp": "there is no `merge` under any spelling and no array `+` operator; `array_merge`'s rule chosen by a key's type does not survive a language where every key is a `string`",
      "seeAlso": ["types/arrays", "types/preserve-keys"],
      "guardedBy": [
        "tests/conformance/core/arr-combination-members-treat-every-key-alike.nvst",
        "tests/conformance/core/arr-combination-members-share-one-key-order-rule.nvst",
        "tests/conformance/core/arr-diff-and-intersect-are-twelve-php-functions.nvst",
        "tests/conformance/core/arr-flip-collapses-duplicates-last-wins.nvst"
      ]
    },
    {
      "id": "types/preserve-keys",
      "title": "`{preserveKeys: false}` discards every key, whatever shape the key has",
      "status": "shipped",
      "because": ["0069", "0007"],
      "divergesFromPhp": "PHP renumbers integer keys and silently keeps string ones; `false` means the result is a list, and nothing else",
      "seeAlso": ["types/array-combination", "types/arrays"],
      "guardedBy": [
        "tests/conformance/core/arr-reverse-discards-every-key-by-default.nvst",
        "tests/conformance/core/arr-sort-preserves-keys-on-request.nvst",
        "tests/conformance/core/arr-slice-and-chunk-window-by-position.nvst",
        "tests/conformance/core/arr-is-list-is-one-question-asked-twice.nvst"
      ]
    },
    {
      "id": "types/mixed-subscript",
      "title": "A subscript through a `mixed` is the tag's question; every other base answers it where it is written",
      "status": "shipped",
      "because": ["0007", "0036"],
      "divergesFromPhp": "a read that finds no array and no key is a catchable throw, never PHP's warning and a `null`",
      "seeAlso": ["types/arrays", "types/erased-member-access", "types/unions-and-mixed"],
      "guardedBy": [
        "tests/conformance/lang/a-subscript-through-a-mixed-base-is-decided-by-its-tag.nvst",
        "tests/conformance/lang/reading-an-absent-array-key-throws.nvst",
        "tests/conformance/array/a-subscript-needs-an-array-to-read-from.nvst"
      ]
    },
    {
      "id": "types/property-key",
      "title": "`property<T>` is a type whose values are `T`'s public property names, and `as` is its only source",
      "status": "shipped",
      "because": ["0126", "0007", "0090", "0019", "0066", "0024", "0033"],
      "seeAlso": ["types/property-key-variance", "types/property-key-access", "types/class-reference", "types/conversion"],
      "guardedBy": [
        "tests/conformance/class/a-property-key-is-checked-where-the-name-arrives.nvst",
        "tests/conformance/class/a-name-outside-the-public-set-throws-at-the-conversion.nvst",
        "tests/conformance/reject/a-private-property-is-not-a-property-key.nvst"
      ]
    },
    {
      "id": "types/property-key-variance",
      "title": "`property<T>` widens as `T` narrows, because the argument bounds the receiver",
      "status": "shipped",
      "because": ["0126", "0125"],
      "seeAlso": ["types/property-key", "types/class-reference-variance", "types/property-key-access"],
      "guardedBy": [
        "tests/conformance/class/a-property-key-reads-and-writes-the-field-it-names.nvst",
