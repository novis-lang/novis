        "tests/conformance/lang/a-match-and-a-switch-over-true-narrow-per-arm.nvst",
        "tests/conformance/lang/a-comparison-against-a-literal-narrows-its-subject.nvst",
        "crates/nvs-types/tests/narrowing.rs"
      ]
    },
    {
      "id": "types/conversion",
      "title": "`expr as T` is the only conversion, and it produces a `T` or throws",
      "status": "shipped",
      "because": ["0007", "0009", "0010", "0024", "0028", "0033", "0034", "0047", "0054", "0066", "0125", "0126", "0144"],
