{
  "topic": "classes",
  "title": "Classes",
  "order": 50,
  "rules": [
    {
      "id": "classes/no-free-functions-or-constants",
      "title": "No `function` and no `const` may be declared outside a class body",
      "status": "shipped",
      "because": ["0011", "0008", "0003"],
      "divergesFromPhp": "a global function or a global constant cannot be declared at all — every callable is a method, every constant a class constant, and there is no exception for built-ins",
      "seeAlso": [
        "statements/static-is-a-member-modifier",
        "statements/no-function-static-and-no-global",
        "statements/storage-that-outlives-a-call",
        "types/class-constant"
      ],
      "guardedBy": [
        "tests/conformance/reject/a-top-level-function-must-be-a-method.nvst",
        "tests/conformance/reject/a-top-level-constant-must-belong-to-a-class.nvst"
      ]
    },
    {
      "id": "classes/names-resolve-case-sensitively",
      "title": "Every name is compared exactly, so `Foo` and `foo` are two names and never one",
      "status": "shipped",
      "because": ["0062", "0029"],
      "divergesFromPhp": "class, interface and method names no longer fold case, so a mis-cased reference is a diagnostic instead of a silent match",
      "seeAlso": [
        "classes/reserved-spellings-are-lower-case",
        "programs/path-case",
        "programs/autoload"
      ],
      "guardedBy": ["crates/nvs-hir/src/qname.rs"]
    },
    {
      "id": "classes/reserved-spellings-are-lower-case",
      "title": "Keywords, contextual keywords and the `<?nvs` tag are lower case and nothing else",
      "status": "shipped",
      "because": ["0062", "0029"],
      "divergesFromPhp": "`IF`, `TRUE` and `NULL` are not keywords or literals — they lex as ordinary identifiers, and only `<?NVS` gets a diagnostic of its own",
      "seeAlso": ["classes/names-resolve-case-sensitively", "statements/nvs-is-the-only-open-tag"],
      "guardedBy": ["crates/nvs-syntax/src/lexer.rs"]
    },
    {
      "id": "classes/no-leading-underscore-identifiers",
      "title": "No property, parameter or local name may begin with `_`",
      "status": "shipped",
      "because": ["0030", "0029"],
      "divergesFromPhp": "PHP's `_private` and `$_unused` conventions do not compile; there is no leading-underscore allowance in any identifier category",
      "seeAlso": ["classes/constructor-is-a-method-named-constructor"],
      "guardedBy": ["tests/conformance/reject/a-leading-underscore-is-refused-on-a-local.nvst"]
    },
    {
      "id": "classes/constructor-is-a-method-named-constructor",
      "title": "A constructor is an ordinary method named `constructor`, and `__construct` does not compile",
      "status": "shipped",
      "because": ["0030", "0022", "0029"],
      "divergesFromPhp": "the constructor is spelled `constructor`; `__construct` is refused where it is written, with a diagnostic naming the rename",
      "seeAlso": [
        "classes/no-leading-underscore-identifiers",
        "classes/definite-property-initialization",
        "classes/no-magic-methods"
      ],
      "guardedBy": [
        "tests/conformance/reject/the-constructor-is-not-spelled-underscore-construct.nvst",
        "tests/conformance/class/constructor-and-instance-method.nvst"
      ]
    },
    {
      "id": "classes/promotion-is-constructor-only",
      "title": "A visibility keyword on a parameter promotes it to a property only in the `constructor`",
      "status": "shipped",
      "because": ["0043", "0022", "0094"],
      "seeAlso": [
        "classes/constructor-is-a-method-named-constructor",
        "classes/definite-property-initialization",
        "classes/delegation-by-field"
      ],
      "guardedBy": [
        "tests/conformance/class/a-visibility-keyword-promotes-only-in-the-constructor.nvst",
        "tests/conformance/class/a-promoted-constructor-parameter-is-a-property.nvst"
      ]
    },
    {
      "id": "classes/constructor-compatibility",
      "title": "A `new` through a class reference checks `T`'s constructor, and an implementor whose constructor diverges is refused there",
      "status": "shipped",
      "because": ["0125", "0022"],
      "divergesFromPhp": "the mismatch is refused at the `new` rather than discovered when the wrong subclass arrives",
      "seeAlso": [
        "types/class-reference",
        "types/class-reference-sites",
        "classes/constructor-is-a-method-named-constructor",
        "classes/definite-property-initialization"
      ],
      "guardedBy": [
        "tests/conformance/reject/a-subclass-with-another-constructor-refuses-a-dynamic-new.nvst",
        "crates/nvs-types/tests/classes.rs"
      ]
    },
    {
      "id": "classes/definite-property-initialization",
      "title": "Every property a class declares is definitely assigned on every path out of every constructor",
      "status": "shipped",
      "because": ["0022", "0043", "0023", "0038"],
      "divergesFromPhp": "a constructor that leaves a typed property unset on some path is refused at compile time rather than throwing at whichever read discovers it",
      "seeAlso": [
        "classes/an-unwritten-property-read-throws",
        "classes/no-undefined-value",
        "classes/lateinit",
        "classes/constructor-is-a-method-named-constructor",
        "types/declaration"
      ],
      "guardedBy": [
        "tests/conformance/class/a-constructor-must-assign-every-property.nvst",
        "tests/conformance/class/a-property-with-no-constructor-at-all-is-refused.nvst",
        "tests/conformance/class/an-inherited-constructor-does-not-discharge-a-subclass-property.nvst",
        "tests/conformance/class/a-promoted-constructor-parameter-is-a-property.nvst"
      ]
    },
    {
      "id": "classes/no-undefined-value",
      "title": "There is no `undefined`: a property that may legitimately hold no value is `?T`",
      "status": "shipped",
      "because": ["0022"],
      "seeAlso": [
        "classes/definite-property-initialization",
        "classes/an-unwritten-property-read-throws",
        "types/declaration",
        "types/unions-and-mixed"
      ],
      "guardedBy": []
    },
    {
      "id": "classes/an-unwritten-property-read-throws",
      "title": "Reading a property that has never been written throws a catchable error and never yields a value",
      "status": "shipped",
      "because": ["0022", "0038", "0019"],
      "seeAlso": [
        "classes/definite-property-initialization",
        "classes/lateinit",
        "errors/propagation",
        "errors/escalation-ladder"
      ],
      "guardedBy": [
        "tests/conformance/class/a-property-that-was-never-written-is-read-as-a-throw.nvst",
        "tests/conformance/class/a-delegate-reached-before-its-field-is-written-throws.nvst"
      ]
    },
    {
      "id": "classes/lateinit",
      "title": "A `lateinit` property is assigned after the constructor rather than inside it",
      "status": "shipped",
      "because": ["0038", "0022"],
      "seeAlso": [
        "classes/lateinit-restrictions",
        "classes/lateinit-read-before-write",
        "classes/definite-property-initialization",
        "classes/an-unwritten-property-read-throws"
      ],
      "guardedBy": [
        "tests/conformance/class/lateinit-holds-a-property-assigned-after-the-constructor.nvst"
      ]
    },
    {
      "id": "classes/lateinit-restrictions",
      "title": "`lateinit` is admitted only on a non-nullable class- or interface-typed property that is neither promoted nor `readonly`",
      "status": "shipped",
      "because": ["0038", "0022"],
      "seeAlso": ["classes/lateinit", "classes/no-undefined-value", "types/declaration"],
      "guardedBy": [
        "tests/conformance/class/lateinit-is-refused-on-a-scalar-property.nvst",
        "crates/nvs-types/src/lateinit.rs"
      ]
    },
    {
      "id": "classes/lateinit-read-before-write",
      "title": "A `lateinit` read the enclosing method can prove is too early is a compile error, and nothing wider is attempted",
      "status": "shipped",
      "because": ["0038", "0022", "0017"],
      "seeAlso": ["classes/lateinit", "classes/an-unwritten-property-read-throws"],
      "guardedBy": [
        "tests/conformance/class/lateinit-refuses-a-read-before-any-write.nvst",
        "crates/nvs-types/src/lateinit.rs"
      ]
    },
    {
      "id": "classes/no-dynamic-properties",
      "title": "A property that the class does not declare cannot be read or written, and no user code runs for the attempt",
      "status": "shipped",
      "because": ["0014", "0011", "0036"],
      "divergesFromPhp": "there are no dynamic properties and no `__get`/`__set` to catch one — a wrong name is a diagnostic or a checked throw, never a newly created field",
      "seeAlso": [
        "classes/property-observer",
        "types/erased-member-access",
        "types/property-key",
        "types/property-key-access",
        "types/declaration"
      ],
      "guardedBy": [
        "tests/conformance/class/an-undeclared-property-is-a-hard-error.nvst",
        "tests/conformance/class/a-property-key-is-checked-where-the-name-arrives.nvst",
        "crates/nvs-types/tests/classes.rs"
      ]
    },
    {
      "id": "classes/unset-is-refused-on-a-property",
      "title": "`unset` on a declared property is a compile error, and `isset` on one is an ordinary null test",
      "status": "shipped",
      "because": ["0028", "0022", "0014"],
      "divergesFromPhp": "`unset($obj->prop)` does not remove a property — the one surviving operand is an array element",
      "seeAlso": [
        "classes/definite-property-initialization",
