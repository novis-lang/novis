{
  "topic": "expressions",
  "title": "Expressions",
  "order": 30,
  "rules": [
    {
      "id": "expressions/truthy-positions",
      "title": "Six syntax positions test truthiness; every other `bool` position stays checked",
      "status": "shipped",
      "because": ["0035", "0007"],
      "divergesFromPhp": "the implicit conversion to `bool` is confined to six positions, where PHP applies it wherever a `bool` is wanted",
      "seeAlso": [
        "expressions/truthy-table",
        "expressions/nullable-condition-lint",
        "expressions/no-keyword-logical-operators",
        "iteration/for-init-clause"
      ],
      "guardedBy": [
        "tests/conformance/lang/a-condition-uses-phps-truthy-table.nvst",
        "tests/conformance/lang/logical-connectives-short-circuit.nvst"
      ]
    },
    {
      "id": "expressions/truthy-table",
      "title": "The truthy table is PHP's, and `bytes` is falsy only when it is empty",
      "status": "shipped",
      "because": ["0035", "0009", "0007"],
      "divergesFromPhp": "`bytes` has no PHP neighbour and takes emptiness alone, so a one-octet `\"0\"` buffer is truthy where the string `\"0\"` is falsy",
      "seeAlso": [
        "expressions/truthy-positions",
        "enums/truthiness",
        "expressions/equality-semantics"
      ],
      "guardedBy": [
        "tests/conformance/lang/a-bytes-in-a-condition-is-falsy-only-when-empty.nvst",
        "tests/conformance/lang/a-mixed-in-a-condition-resolves-the-truthy-table-at-run-time.nvst",
        "tests/conformance/lang/empty-answers-the-truthy-table-for-every-nvs-type.nvst"
      ]
    },
    {
      "id": "expressions/no-keyword-logical-operators",
      "title": "`and`, `or` and `xor` do not parse, and `&&`/`||` are the whole set",
      "status": "shipped",
      "because": ["0045", "0035", "0021"],
      "divergesFromPhp": "the low-precedence keyword connectives are gone entirely, and `xor` has no operator replacement at all",
      "seeAlso": ["expressions/truthy-positions", "expressions/one-equality-operator"],
      "guardedBy": [
        "tests/conformance/reject/keyword-logical-operators-do-not-parse.nvst",
        "tests/conformance/reject/xor-does-not-parse.nvst"
      ]
    },
    {
      "id": "expressions/nullable-condition-lint",
      "title": "A `?T` used directly as a condition is warned about, not refused",
      "status": "designed",
      "because": ["0066", "0035"],
      "seeAlso": [
        "expressions/nullable-conversion",
        "expressions/truthy-table",
        "expressions/bare-throwable-arm-warns"
      ],
      "guardedBy": []
    },
    {
      "id": "expressions/one-equality-operator",
      "title": "`==` and `!=` are the whole of equality, and `===`, `!==` and `<>` do not parse",
      "status": "shipped",
      "because": ["0090", "0013", "0029"],
      "divergesFromPhp": "there is no loose-versus-strict pair to pick between — one operator, which never converts either operand",
      "seeAlso": [
        "expressions/disjoint-comparison-refused",
        "expressions/equality-semantics",
        "expressions/object-identity-equality",
        "expressions/mixed-equality",
        "expressions/switch-match-equality"
      ],
      "guardedBy": [
        "tests/conformance/reject/not-equal-is-spelled-bang-equals.nvst",
        "tests/conformance/lang/equality-and-inequality-over-scalars.nvst",
        "tests/conformance/lang/comparison-operators.nvst"
      ]
    },
    {
      "id": "expressions/equality-semantics",
      "title": "Equality has one row per type, and every row is the strict reading",
      "status": "shipped",
      "because": ["0090", "0054", "0010", "0007", "0031", "0009"],
      "divergesFromPhp": "each row where PHP's two operators disagreed takes `===`'s answer — two strings compare as text and never as numbers, and an array compares in key order",
      "seeAlso": [
        "expressions/one-equality-operator",
        "expressions/object-identity-equality",
        "expressions/mixed-equality",
        "expressions/disjoint-comparison-refused",
        "enums/representation"
      ],
      "guardedBy": [
        "tests/conformance/lang/equality-over-strings-and-bools.nvst",
        "tests/conformance/lang/equality-over-arrays-objects-and-mixed.nvst",
        "tests/conformance/lang/float-comparisons-and-equality.nvst",
        "tests/conformance/lang/two-nulls-are-equal-and-two-bools-order.nvst"
      ]
    },
    {
      "id": "expressions/mixed-equality",
      "title": "A `mixed` or union operand resolves at run time, and a mismatched pair answers `false`",
      "status": "shipped",
      "because": ["0090", "0007"],
      "divergesFromPhp": "a cross-type pairing is `false` rather than PHP's converting comparison, and it is the one place a comparison answers instead of refusing to compile",
      "seeAlso": [
        "expressions/disjoint-comparison-refused",
        "expressions/equality-semantics",
        "expressions/truthy-table"
      ],
      "guardedBy": [
        "tests/conformance/lang/numeric-identity-is-one-domain-at-runtime.nvst",
        "tests/conformance/lang/equality-over-arrays-objects-and-mixed.nvst",
        "crates/nvs-types/tests/equality.rs"
      ]
    },
    {
      "id": "expressions/object-identity-equality",
      "title": "Two objects are equal only when they are the same object, and no class may change that",
      "status": "shipped",
      "because": ["0090", "0013", "0014", "0028", "0079"],
      "divergesFromPhp": "PHP's `==` walked properties; here there is no property walk, no `__equals`, no `equals()` protocol and no `Equatable` interface",
      "seeAlso": [
        "expressions/equality-semantics",
        "expressions/one-equality-operator",
        "expressions/mixed-equality"
      ],
      "guardedBy": [
        "tests/conformance/lang/equality-over-arrays-objects-and-mixed.nvst",
        "tests/conformance/core/object-collections-hold-one-member-per-distinct-value.nvst"
      ]
    },
    {
      "id": "expressions/disjoint-comparison-refused",
      "title": "Comparing two types that no single value inhabits is a compile error",
      "status": "shipped",
      "because": ["0090", "0007", "0009", "0010", "0047", "0054"],
      "divergesFromPhp": "`\"1\" == 1` neither answers `true` nor `false`; it does not compile, and the diagnostic names the conversion the author meant",
      "seeAlso": [
        "expressions/one-equality-operator",
        "expressions/equality-semantics",
        "expressions/mixed-equality",
        "expressions/switch-match-equality"
      ],
      "guardedBy": [
        "tests/conformance/lang/disjoint-equality-is-a-compile-error.nvst",
        "tests/conformance/lang/equality-across-overlapping-types-still-compiles.nvst",
        "crates/nvs-types/tests/equality.rs"
      ]
    },
    {
      "id": "expressions/switch-match-equality",
      "title": "A `switch` label and a `match` arm compare by the equality rule and by nothing else",
      "status": "shipped",
      "because": ["0090", "0035"],
      "divergesFromPhp": "`switch` no longer compares loosely while `match` compares identically — there is one comparison, and both use it",
      "seeAlso": [
        "expressions/one-equality-operator",
        "expressions/disjoint-comparison-refused",
        "expressions/equality-semantics"
      ],
      "guardedBy": [
        "tests/conformance/lang/a-switch-compares-in-order-and-falls-through.nvst",
        "tests/conformance/lang/equality-across-overlapping-types-still-compiles.nvst",
        "tests/differential/lang/a-switch-and-a-match-agree-with-php.nvst"
      ]
    },
    {
      "id": "expressions/intrinsic-literals",
      "title": "A literal argument to an intrinsic `Core` call is validated while checking and prepared into the artifact",
      "status": "shipped",
      "because": ["0057", "0046", "0042"],
      "divergesFromPhp": "a malformed pattern, URI, duration or format string is a compile error at the offset inside the literal, rather than a throw on the first request that reaches the call",
      "seeAlso": [
        "expressions/intrinsic-list-is-closed",
        "expressions/preparation-preserves-behaviour"
      ],
      "guardedBy": [
        "tests/conformance/core/a-literal-intrinsic-is-validated-while-checking.nvst",
        "tests/conformance/reject/a-malformed-literal-intrinsic-is-a-compile-error.nvst",
        "crates/nvs-types/tests/intrinsics.rs"
      ]
    },
    {
      "id": "expressions/intrinsic-list-is-closed",
      "title": "The intrinsic roster is a closed set in the compiler's own source, and nothing declares itself into it",
      "status": "shipped",
      "because": ["0057", "0063"],
      "seeAlso": [
        "expressions/intrinsic-literals",
        "expressions/preparation-preserves-behaviour"
      ],
      "guardedBy": ["crates/nvs-types/tests/intrinsics.rs"]
    },
    {
      "id": "expressions/bracket-destructuring",
      "title": "`list(...)` does not parse; `[...]` is the only destructuring target",
      "status": "shipped",
      "because": ["0050", "0049"],
      "divergesFromPhp": "one of PHP's two destructuring spellings is refused, so `list($a, $b) = $pair;` is a diagnostic naming the bracket form",
      "seeAlso": ["expressions/no-keyword-logical-operators"],
      "guardedBy": [
        "tests/conformance/reject/list-destructuring-does-not-parse.nvst",
        "tests/conformance/lang/destructuring-reads-elements-off-one-array.nvst"
      ]
    },
    {
      "id": "expressions/nullable-conversion",
      "title": "`expr as ?T` yields the converted value or `null`, and never throws",
      "status": "shipped",
      "because": ["0066", "0007", "0047"],
      "divergesFromPhp": "a failed conversion is a `null` the caller tests, where `(int)$x` — which does not parse at all — answered `0` and said nothing",
      "seeAlso": [
        "expressions/nullable-conversion-availability",
        "expressions/conversion-keeps-qualifiers",
        "expressions/nullable-condition-lint",
        "expressions/try-parse"
      ],
      "guardedBy": [
        "tests/conformance/lang/a-nullable-conversion-yields-null-rather-than-throwing.nvst",
        "tests/conformance/lang/a-nullable-conversion-to-string-answers-null-where-the-checked-one-throws.nvst",
        "tests/conformance/lang/a-nullable-conversion-into-a-closed-set-answers-null-where-the-checked-one-throws.nvst",
        "tests/conformance/lang/an-array-converts-element-by-element-and-its-nullable-twin-agrees.nvst"
      ]
    },
    {
      "id": "expressions/nullable-conversion-availability",
      "title": "`as ?T` is refused where the conversion cannot fail, where none exists, and at every class target",
      "status": "shipped",
      "because": ["0066", "0007", "0047"],
      "divergesFromPhp": "there is no operator downcast: `$s as ?Core\\Uri` is a compile error rather than a cast, and text reaches a class only through that class's own reader",
      "seeAlso": [
        "expressions/nullable-conversion",
        "expressions/try-parse",
        "expressions/disjoint-comparison-refused"
      ],
      "guardedBy": [
        "tests/conformance/lang/the-nullable-conversion-table-is-closed-at-both-ends.nvst",
        "tests/conformance/reject/a-written-class-name-outside-the-hierarchy-is-refused-under-the-nullable-conversion-too.nvst",
        "crates/nvs-types/tests/literal_types.rs"
      ]
    },
    {
      "id": "expressions/conversion-keeps-qualifiers",
      "title": "`as ?T` decides `tainted` and `secret` by exactly the rule `as T` uses, and launders nothing of its own",
      "status": "shipped",
      "because": ["0066", "0024", "0033"],
      "seeAlso": [
        "expressions/nullable-conversion",
        "expressions/nullable-conversion-availability"
      ],
      "guardedBy": [
        "crates/nvs-types/tests/tainted.rs",
        "crates/nvs-types/tests/secret.rs"
      ]
    },
    {
      "id": "expressions/try-parse",
      "title": "A failable single-`string` parse is spelled `tryParse`, and no separate validity predicate stands beside it",
      "status": "shipped",
      "because": ["0066", "0063"],
      "divergesFromPhp": "no validator sits next to a parser the way `filter_var` sits next to `parse_url`; `tryParse` is `parse` with the throw caught, so the two can never read one string differently",
      "seeAlso": [
        "expressions/nullable-conversion-availability",
        "expressions/nullable-conversion"
      ],
      "guardedBy": [
        "tests/conformance/core/uri-parse-and-try-parse-are-one-reader-asked-two-ways.nvst",
        "tests/conformance/core/uuid-tryparse-and-parse-are-one-reader.nvst",
        "tests/conformance/core/uri-try-parse-is-total-over-an-ascii-sweep-and-partitions-it-exactly-as-parse.nvst"
      ]
    },
    {
      "id": "expressions/preparation-preserves-behaviour",
      "title": "The prepared path and the runtime path are one implementation, so preparation is only earlier and never different",
      "status": "shipped",
      "because": ["0057", "0042", "0018"],
      "seeAlso": [
        "expressions/intrinsic-literals",
        "expressions/intrinsic-list-is-closed"
      ],
      "guardedBy": [
        "tests/conformance/core/a-literal-intrinsic-is-validated-while-checking.nvst",
        "crates/nvs-cli/src/cache.rs"
      ]
    },
    {
      "id": "expressions/pipeline-substitution",
      "title": "`|>` substitutes one hole at parse time, and has no run-time representation",
      "status": "designed",
      "because": ["0098", "0011", "0027", "0063"],
      "divergesFromPhp": "PHP 8.5's `|>` applies a callable resolved at run time; this one substitutes `$_` in the parser, so the emitted tree is the nested spelling's and no closure is allocated",
      "seeAlso": [
        "expressions/pipeline-hole-once",
        "expressions/pipeline-precedence",
        "expressions/first-class-callable-syntax"
      ],
      "guardedBy": []
    },
    {
      "id": "expressions/pipeline-precedence",
      "title": "`|>` binds tighter than every binary operator and looser than unary",
      "status": "designed",
      "because": ["0098"],
      "seeAlso": [
        "expressions/pipeline-substitution",
        "expressions/pipeline-hole-once",
        "expressions/catch-expression-precedence"
      ],
      "guardedBy": []
    },
    {
      "id": "expressions/pipeline-hole-once",
      "title": "The hole is `$_`, it appears exactly once on a right side, and nowhere else at all",
      "status": "designed",
      "because": ["0098", "0030"],
      "seeAlso": [
        "expressions/pipeline-substitution",
        "expressions/pipeline-precedence"
      ],
      "guardedBy": []
    },
    {
      "id": "expressions/catch-expression",
      "title": "An expression-level `catch` is a chain of typed arms guarding one expression",
      "status": "shipped",
      "because": ["0119", "0002", "0020"],
      "divergesFromPhp": "PHP has no expression-level `catch`; a one-line fallback for a throwing call is a language form rather than a swallowed `@` or a five-line block",
      "seeAlso": [
        "expressions/catch-arm-is-an-expression",
        "expressions/catch-result-type",
        "expressions/catch-expression-precedence",
        "expressions/catch-lowers-to-block-form",
        "errors/throwable-hierarchy"
      ],
      "guardedBy": [
        "tests/conformance/lang/an-expression-catch-yields-the-arm-where-the-guard-threw.nvst",
        "tests/conformance/lang/catch-arms-are-tried-in-order-and-the-rest-is-rethrown.nvst",
        "tests/conformance/reject/a-catch-arm-names-one-class-and-a-union-asks-for-two-arms.nvst",
        "crates/nvs-types/tests/catch_expression.rs"
      ]
    },
    {
      "id": "expressions/catch-expression-precedence",
      "title": "`catch` sits between assignment and the ternary, so one arm guards a whole `??` chain",
      "status": "shipped",
      "because": ["0119"],
      "seeAlso": [
        "expressions/catch-expression",
        "expressions/catch-arm-is-an-expression",
        "expressions/pipeline-precedence"
      ],
      "guardedBy": ["crates/nvs-syntax/src/parser/tests/expr.rs"]
    },
    {
      "id": "expressions/catch-arm-is-an-expression",
      "title": "An arm body is an expression, which admits `throw` and refuses `return` by name",
      "status": "shipped",
      "because": ["0119"],
      "seeAlso": [
        "expressions/catch-expression",
        "expressions/catch-result-type",
        "expressions/bare-throwable-arm-warns"
      ],
      "guardedBy": [
        "tests/conformance/reject/a-return-in-a-catch-arm-is-refused-naming-the-block-form.nvst",
        "tests/conformance/lang/a-throw-arm-leaves-through-the-enclosing-finally.nvst",
        "crates/nvs-types/tests/catch_expression.rs"
      ]
    },
    {
      "id": "expressions/catch-result-type",
      "title": "The result type is the union of the guard and every arm, and an arm is checked from the pre-guard state",
      "status": "shipped",
      "because": ["0119", "0007"],
      "seeAlso": [
        "expressions/catch-expression",
        "expressions/catch-arm-is-an-expression",
        "expressions/nullable-conversion"
      ],
      "guardedBy": ["crates/nvs-types/tests/catch_expression.rs"]
    },
    {
      "id": "expressions/bare-throwable-arm-warns",
      "title": "An unbound `catch (Throwable)` arm that supplies a value is warned about",
      "status": "shipped",
      "because": ["0119", "0007", "0066"],
      "divergesFromPhp": "PHP's `@` is gone, and the one-liner that would regrow it is named at compile time instead",
      "seeAlso": [
        "expressions/catch-arm-is-an-expression",
        "expressions/catch-expression",
        "expressions/nullable-condition-lint"
      ],
      "guardedBy": ["crates/nvs-types/tests/catch_expression.rs"]
    },
    {
      "id": "expressions/catch-lowers-to-block-form",
      "title": "The expression form lowers to the block form's landing pad, with the value in a temporary",
      "status": "shipped",
      "because": ["0119", "0002"],
      "seeAlso": [
        "expressions/catch-expression",
        "expressions/catch-result-type",
        "errors/propagation",
        "errors/throw-is-not-slower"
      ],
      "guardedBy": [
        "tests/conformance/lang/catch-arms-are-tried-in-order-and-the-rest-is-rethrown.nvst",
        "tests/conformance/lang/a-throw-arm-leaves-through-the-enclosing-finally.nvst",
        "crates/nvs-ir/src/lower/exception.rs"
      ]
    },
    {
      "id": "expressions/first-class-callable-syntax",
      "title": "`Name(...)` is the only spelling that takes a reference to a declared member",
      "status": "shipped",
      "because": ["0027", "0015", "0031", "0136", "0007"],
      "seeAlso": [
        "expressions/pipeline-substitution",
        "expressions/nullable-conversion-availability"
      ],
      "guardedBy": [
        "tests/conformance/lang/a-first-class-callable-names-a-member-not-a-class.nvst",
        "tests/conformance/reject/a-first-class-callable-forwards-every-argument.nvst",
        "crates/nvs-types/tests/callable.rs"
      ]
    }
  ]
}
