{
  "topic": "errors",
  "title": "Errors",
  "order": 90,
  "rules": [
    {
      "id": "errors/throwable-hierarchy",
      "title": "A limit report is not a Throwable, and the type checker knows it",
      "status": "shipped",
      "because": ["0020"],
      "divergesFromPhp": "`catch (Throwable)` provably cannot see a resource-limit fatal; `Exception` and `Error` are not class names",
      "seeAlso": ["errors/escalation-ladder", "errors/on-limit", "errors/compile-failure"],
      "guardedBy": [
        "tests/conformance/error/a-limit-fatal-is-not-catchable.nvst",
        "tests/conformance/error/a-parse-error-carries-an-issue-list.nvst"
      ]
    },
    {
      "id": "errors/propagation",
      "title": "An error propagates as a checked return, never by unwinding",
      "status": "shipped",
      "because": ["0002"],
      "divergesFromPhp": "an exception is a status value checked after every call, not a stack unwind",
      "seeAlso": ["errors/helper-abi", "errors/throw-is-not-slower", "errors/escalation-ladder"],
      "guardedBy": [
        "tests/conformance/error/a-throw-crosses-two-frames.nvst",
        "crates/nvs-codegen/tests/throwing.rs",
        "crates/nvs-codegen/tests/calls.rs",
        "benches/abi-probe/tests/invariants.rs",
        "benches/abi-probe/tests/unwind_unavailable.rs"
      ]
    },
    {
      "id": "errors/throw-is-not-slower",
      "title": "A throw costs no more than a return, and only its raise allocates",
      "status": "shipped",
      "because": ["0002"],
      "divergesFromPhp": "throwing is not a performance cliff, so exceptions may be used on ordinary control-flow paths",
      "seeAlso": ["errors/propagation"],
      "guardedBy": [
        "benches/abi-probe/tests/perf_guards.rs",
        "tests/conformance/error/a-helper-fault-names-the-frame-it-was-raised-in-when-it-is-caught-there.nvst"
      ]
    },
    {
      "id": "errors/helper-abi",
      "title": "A runtime helper never unwinds, and a panic dies inside one request",
      "status": "shipped",
      "because": ["0002", "0106"],
      "seeAlso": ["errors/propagation", "errors/panics-bypass-user-code"],
      "guardedBy": ["benches/abi-probe/tests/unwind_unavailable.rs"]
    },
    {
      "id": "errors/stack-depth",
      "title": "Recursion is bounded twice: a catchable error, then a fatal",
      "status": "shipped",
      "because": ["0020", "0106"],
      "divergesFromPhp": "recursion is bounded by an 8 MB native stack rather than by `memory_limit`, so deep PHP recursion needs a rewrite",
      "seeAlso": ["errors/on-limit", "errors/propagation"],
      "guardedBy": ["crates/nvs-codegen/tests/stack_limit.rs"]
    },
    {
      "id": "errors/on-limit",
      "title": "Tier 1 — a resource limit reaches the request that spent it",
      "status": "shipped",
      "because": ["0020"],
      "divergesFromPhp": "the handler is request-local rather than global, and runs on a reserve carved out before execution started",
      "seeAlso": ["errors/escalation-ladder", "errors/stack-depth", "errors/panics-bypass-user-code"],
      "guardedBy": [
        "tests/conformance/core/fatal-on-limit-registers-a-handler-without-running-it.nvst",
        "tests/conformance/core/fatal-on-uncaught-throw-and-on-limit-are-two-independent-slots.nvst",
        "crates/nvs-runtime/tests/configured_limits.rs"
      ]
    },
    {
      "id": "errors/an-allocation-past-the-ceiling-is-refused-in-front-of-itself",
      "title": "An allocation past the memory ceiling is refused before it is made, and the refusal is a complete no-op",
      "status": "shipped",
      "because": ["0174"],
      "seeAlso": [
        "errors/on-limit",
        "errors/escalation-ladder",
        "concurrency/a-cross-request-stores-bytes-are-its-own-balance"
      ],
      "guardedBy": [
        "tests/conformance/error/one-operation-past-the-ceiling-is-refused-before-it-allocates.nvst",
        "tests/conformance/error/a-loop-that-calls-nothing-is-stopped-by-the-memory-ceiling.nvst",
        "crates/nvs-runtime/tests/refusal.rs",
        "crates/nvs-runtime/tests/allocator_ceiling.rs"
      ]
    },
    {
      "id": "errors/escalation-ladder",
      "title": "A failure escalates through four tiers, and no tier is retried",
      "status": "shipped",
      "because": ["0020"],
      "divergesFromPhp": "every failure category ends in a log line, and no handler is ever given a second attempt at the same failure",
      "seeAlso": [
        "errors/on-limit",
        "errors/on-uncaught-throw",
        "errors/handler-script",
        "errors/engine-floor"
      ],
      "guardedBy": [
        "tests/conformance/error/the-floor-and-core-log-write-record-the-same-error-the-same-way.nvst",
        "tests/conformance/error/a-limit-breach-inside-finally-is-a-clean-fatal.nvst"
      ]
    },
    {
      "id": "errors/on-uncaught-throw",
      "title": "Tier 2 — an uncaught throw reaches the request root as itself",
      "status": "shipped",
      "because": ["0020", "0127"],
      "divergesFromPhp": "the handler is request-local and fires exactly once; there is no global `set_exception_handler`",
      "seeAlso": ["errors/escalation-ladder", "errors/handler-script"],
      "guardedBy": [
        "tests/conformance/core/fatal-on-uncaught-throw-fires-once-and-a-handler-that-throws-is-abandoned.nvst",
        "tests/conformance/core/fatal-on-uncaught-throw-hands-the-handler-the-object-the-program-threw.nvst",
        "tests/conformance/error/an-uncaught-throw-prints-a-backtrace.nvst"
      ]
    },
    {
      "id": "errors/handler-script",
      "title": "Tier 3 — the configured handler is an ordinary isolate on the engine's own budget",
      "status": "shipped",
      "because": ["0020"],
      "seeAlso": ["errors/escalation-ladder", "errors/engine-floor", "errors/log-write"],
      "guardedBy": []
    },
    {
      "id": "errors/engine-floor",
      "title": "Tier 4 — the floor is native, bounded, and gives up rather than escalating",
      "status": "shipped",
      "because": ["0020", "0086", "0106"],
      "seeAlso": ["errors/escalation-ladder", "errors/handler-script", "errors/log-write"],
      "guardedBy": [
        "tests/conformance/core/log-target-both-writers-land-in-the-destination-the-deployment-named.nvst"
      ]
    },
    {
      "id": "errors/panics-bypass-user-code",
      "title": "An internal panic never runs the failing request's own code",
      "status": "shipped",
      "because": ["0020"],
      "seeAlso": ["errors/on-limit", "errors/helper-abi", "errors/handler-script"],
      "guardedBy": []
    },
    {
      "id": "errors/compile-failure",
      "title": "A compile failure is catchable mid-execution and reaches the ladder at entry",
      "status": "shipped",
      "because": ["0020", "0091"],
      "seeAlso": ["errors/throwable-hierarchy", "errors/escalation-ladder"],
      "guardedBy": ["tests/conformance/error/a-parse-error-carries-an-issue-list.nvst"]
    },
    {
      "id": "errors/diagnostic-record",
      "title": "Every developer-facing output is one closed record",
      "status": "shipped",
      "because": ["0092", "0106"],
      "divergesFromPhp": "there is one model behind every diagnostic, so a value's type is never lost the way `print_r` loses it",
      "seeAlso": ["errors/renderings", "errors/record-transformations", "errors/record-producers", "errors/log-fields"],
      "guardedBy": [
        "tests/conformance/core/a-dump-renders-one-record-through-one-plaintext-view.nvst",
        "tests/conformance/core/a-dump-and-an-encode-agree-on-what-an-array-is.nvst"
      ]
    },
    {
      "id": "errors/record-producers",
      "title": "Five producers build the one record",
      "status": "designed",
      "because": ["0092", "0079"],
      "seeAlso": ["errors/diagnostic-record", "errors/log-write", "errors/debug-dump"],
      "guardedBy": []
    },
    {
      "id": "errors/a-record-names-where-it-was-produced",
      "title": "A record names the file, line and member it was produced at, and a `Throwable`'s location is that same datum",
      "status": "shipped",
      "because": ["0165"],
      "divergesFromPhp": "no stack is captured per record, where `getTrace` snapshots the whole stack at construction; the call path is the trace's answer and a record carries only where it was produced",
      "seeAlso": ["errors/diagnostic-record", "errors/record-producers", "errors/propagation", "observability/a-log-record-carries-trace-ids-when-a-trace-is-active"],
      "guardedBy": ["tests/conformance/core/a-record-names-the-member-it-was-produced-in.nvst", "tests/conformance/error/a-location-is-the-throw-site-and-a-rethrow-moves-it.nvst", "crates/nvs-runtime/src/throwable.rs", "crates/nvs-runtime/src/source.rs"]
    },
    {
      "id": "errors/record-transformations",
      "title": "Redaction, control bytes, bidi and elision are decided in the record",
      "status": "shipped",
      "because": ["0092", "0033", "0086", "0087"],
      "divergesFromPhp": "a cut, a cycle and a redaction are nodes in the record, so every rendering agrees on them instead of truncating per formatter",
      "seeAlso": ["errors/diagnostic-record", "errors/renderings", "errors/log-write"],
      "guardedBy": [
        "tests/conformance/core/a-secret-typed-property-is-redacted-wherever-it-is-dumped.nvst",
        "tests/conformance/core/a-repeat-is-a-cycle-only-when-it-is-an-ancestor.nvst",
        "tests/conformance/core/a-dump-cuts-at-its-caps-and-not-one-entry-early.nvst"
      ]
    },
    {
      "id": "errors/renderings",
      "title": "The sink in force picks the rendering, and no call site may name one",
      "status": "designed",
      "because": ["0092", "0088"],
      "divergesFromPhp": "one member replaces `var_dump`, `print_r`, `var_export` and `json_encode`, and reads correctly in every medium",
      "seeAlso": ["errors/diagnostic-record", "errors/debug-dump", "errors/no-render-hook"],
      "guardedBy": ["tests/conformance/core/log-format-text-selects-the-plaintext-rendering.nvst"]
    },
    {
      "id": "errors/no-render-hook",
      "title": "A class cannot change how it is dumped",
      "status": "shipped",
      "because": ["0092", "0028"],
      "divergesFromPhp": "no `__debugInfo` and no `__toString` in a dump — a dump shows declared state and never a prettier view of it",
      "seeAlso": ["errors/diagnostic-record", "errors/debug-dump"],
      "guardedBy": []
    },
    {
      "id": "errors/debug-dump",
      "title": "A dump goes to the log, and reaches a response body only in development",
      "status": "shipped",
      "because": ["0092", "0091", "0085"],
      "divergesFromPhp": "a forgotten dump writes a log line; the spelling that puts it in a production response does not exist",
      "seeAlso": ["errors/renderings", "errors/record-transformations", "errors/no-render-hook"],
      "guardedBy": [
        "tests/conformance/core/a-dump-writes-one-record-per-argument-and-none-at-all-for-none.nvst",
        "tests/conformance/core/a-dump-is-its-arguments-rendered-and-a-capture-never-swallows-one.nvst"
      ]
    },
    {
      "id": "errors/log-write",
      "title": "One write path, and the engine floor is its other caller",
      "status": "shipped",
      "because": ["0020", "0092"],
      "seeAlso": ["errors/log-level", "errors/log-fields", "errors/engine-floor", "errors/diagnostic-record"],
      "guardedBy": [
        "tests/conformance/core/log-write-renders-one-json-line-per-record.nvst",
        "tests/conformance/error/the-floor-and-core-log-write-record-the-same-error-the-same-way.nvst"
      ]
    },
    {
      "id": "errors/log-level",
      "title": "Five levels, and the mapping to syslog is fixed",
      "status": "shipped",
      "because": ["0092"],
      "divergesFromPhp": "five levels rather than PSR-3's eight, because nobody has a rule for choosing `notice` over `info`",
      "seeAlso": ["errors/log-write", "errors/diagnostic-record"],
      "guardedBy": ["tests/conformance/core/log-level-is-the-minimum-level-written.nvst"]
    },
    {
      "id": "errors/log-fields",
      "title": "A record's fields are named and typed, not a stringly bag",
      "status": "shipped",
      "because": ["0092", "0076"],
      "seeAlso": ["errors/log-write", "errors/diagnostic-record"],
      "guardedBy": [
        "tests/conformance/core/log-write-omits-an-empty-fields-object.nvst",
        "tests/conformance/core/log-write-renders-a-field-json-has-no-value-for.nvst"
      ]
    },
    {
      "id": "errors/a-repeat-is-bounded-at-the-sink-that-suffers",
      "title": "A repeat is bounded at the sink that suffers from it: a disk-bounded target coalesces before the write, and an indexed one groups at read time",
      "status": "shipped",
      "because": ["0165"],
      "seeAlso": ["http-server/the-floor-cannot-fill-the-disk", "errors/log-write", "errors/log-fields", "testing/the-ingester-runs-whether-or-not-anyone-is-looking"],
      "guardedBy": ["crates/nvs-runtime/src/floor.rs", "crates/nvs-stdlib/src/log.rs"]
    },
    {
      "id": "errors/ambiguous-input-refused",
      "title": "Ambiguous input is refused whole, never repaired",
      "status": "shipped",
      "because": ["0095", "0097"],
      "divergesFromPhp": "nothing is normalised, unfolded, mangled or truncated into an interpretation",
      "seeAlso": [
        "errors/http-message-defects",
        "errors/cookie-name-bytes",
        "errors/multipart-part-count",
        "errors/path-component-refusals"
      ],
      "guardedBy": []
    },
    {
      "id": "errors/http-message-defects",
      "title": "The closed list of what makes an HTTP message ambiguous",
      "status": "shipped",
      "because": ["0095", "0097", "0074"],
      "divergesFromPhp": "the outbound half is held to the same list, with no per-call opt-out",
      "seeAlso": ["errors/ambiguous-input-refused", "errors/cookie-name-bytes"],
      "guardedBy": []
    },
    {
      "id": "errors/cookie-name-bytes",
      "title": "A cookie name is bytes, and a prefix is enforced once",
      "status": "shipped",
      "because": ["0095", "0012"],
      "divergesFromPhp": "no `.`-and-space mangling of cookie names, and `__Host-`/`__Secure-` are enforced by the runtime rather than by every read site",
      "seeAlso": ["errors/ambiguous-input-refused", "errors/http-message-defects"],
      "guardedBy": [
        "tests/conformance/core/a-request-cookie-refuses-before-it-reads-the-name-it-was-given.nvst",
        "tests/conformance/core/a-response-add-cookie-enforces-a-cookie-name-prefix-on-write.nvst"
      ]
    },
    {
      "id": "errors/multipart-part-count",
      "title": "A multipart body is capped by part count, not only by size",
      "status": "shipped",
      "because": ["0095", "0064", "0004"],
      "seeAlso": ["errors/ambiguous-input-refused"],
      "guardedBy": []
    },
    {
      "id": "errors/path-component-refusals",
      "title": "A path component that does not spell what it resolves to is refused, on every platform",
      "status": "shipped",
      "because": ["0095"],
      "divergesFromPhp": "Windows device names, trailing dots and 8.3 short names are refused on Linux and macOS too",
      "seeAlso": ["errors/ambiguous-input-refused"],
      "guardedBy": [
        "tests/conformance/core/io-every-listed-name-is-one-within-admits-against-its-own-directory.nvst",
        "tests/conformance/core/io-within-resolves-and-then-proves-containment.nvst"
      ]
    }
  ]
}
