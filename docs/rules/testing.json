      "guardedBy": [
        "tests/conformance/lang/a-test-run-reports-a-versioned-json-document.nvst",
        "tests/conformance/lang/a-test-run-reports-the-junit-xml-ci-ingests.nvst",
        "tests/conformance/lang/a-test-run-lists-what-it-declares-without-running-it.nvst",
        "crates/nvs-cli/src/runner.rs"
      ]
    },
    {
      "id": "testing/nvst-is-separate",
      "title": "`.nvst` proves the language; `#[Test]` is how a program written in Novis tests itself",
      "status": "shipped",
      "because": ["0079"],
      "seeAlso": ["testing/test-attribute", "testing/report-formats", "testing/four-proofs"],
      "guardedBy": ["crates/nvs-test/src/lib.rs", "crates/nvs-cli/src/main.rs"]
    },
    {
      "id": "testing/one-slice-is-one-feature",
      "title": "One slice writes all four of a feature's proofs together",
