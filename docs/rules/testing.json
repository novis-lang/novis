{
  "topic": "testing",
  "title": "Testing",
  "order": 120,
  "rules": [
    {
      "id": "testing/test-attribute",
      "title": "A test is a method marked `#[Test]`, and its table is built while compiling",
      "status": "shipped",
      "because": ["0079", "0077", "0046", "0063", "0071", "0011", "0029", "0172"],
      "divergesFromPhp": "there is no test framework to install, no naming convention and no base class; a malformed test is a compile error rather than a case that silently never runs",
      "seeAlso": [
        "testing/isolate-per-test",
        "testing/fixtures",
        "testing/data-rows",
        "testing/runner-is-strict"
      ],
      "guardedBy": [
        "tests/conformance/reject/a-test-method-is-a-public-void-instance-method.nvst",
        "tests/conformance/reject/a-test-attribute-payload-is-checked-against-its-option-shape.nvst",
        "tests/conformance/lang/a-test-attribute-builds-a-table-the-runner-reports.nvst",
        "crates/nvs-types/tests/testing.rs"
      ]
    },
    {
      "id": "testing/tests-never-reach-a-build",
      "title": "`nvs run` and `nvs build` lower no test, and `nvs check` type-checks every one",
      "status": "designed",
      "because": ["0079"],
      "divergesFromPhp": "test code is absent from a built artifact by construction, rather than excluded by whatever the deployment happened to copy",
      "seeAlso": ["testing/test-attribute", "testing/determinism-declared-on-the-test"],
      "guardedBy": []
    },
    {
      "id": "testing/isolate-per-test",
      "title": "Every test runs in its own isolate and shares nothing but compiled code with its siblings",
      "status": "shipped",
      "because": ["0079", "0006", "0004"],
      "divergesFromPhp": "total isolation is the default rather than a per-case escape hatch; a static one test wrote is never visible to the next",
      "seeAlso": [
        "testing/test-attribute",
        "testing/fixtures",
        "testing/runner-is-strict",
        "statements/an-isolate-has-its-own-statics"
      ],
      "guardedBy": ["crates/nvs-cli/src/runner.rs"]
    },
    {
      "id": "testing/private-in-the-same-file",
      "title": "A test reaches `private` members of classes declared in its own file, and nowhere else",
      "status": "designed",
      "because": ["0079"],
      "divergesFromPhp": "there is no reflection to reach a private member with, so white-box testing is bought by co-location and by nothing else",
      "seeAlso": ["testing/test-attribute", "testing/tests-never-reach-a-build"],
      "guardedBy": []
    },
    {
      "id": "testing/assertions-are-typed",
      "title": "An assertion names its subject first and compares two values of one type",
      "status": "shipped",
      "because": ["0079", "0063", "0013", "0090", "0007"],
      "divergesFromPhp": "the argument order is `(actual, expected)`, the reverse of PHPUnit's, and comparing an `int` against a `string` does not compile",
      "seeAlso": [
        "testing/failure-ledger",
        "testing/runner-is-strict",
        "testing/inline-snapshots"
      ],
      "guardedBy": [
        "tests/conformance/core/an-assertion-compares-its-subject-against-its-expectation.nvst",
        "tests/conformance/core/a-predicate-assertion-judges-the-one-subject-its-type-admits.nvst",
        "tests/conformance/core/an-assertion-over-a-callable-judges-what-came-back.nvst",
        "tests/conformance/core/test-assert-equals-refuses-an-object-with-no-compare-to.nvst",
        "tests/conformance/core/test-assert-same-and-assert-equals-deep-part-only-at-a-copy.nvst"
      ]
    },
    {
      "id": "testing/failure-ledger",
      "title": "A failed assertion is a catchable `Throwable` and a ledger entry the test cannot erase",
      "status": "shipped",
      "because": ["0079", "0024", "0020"],
      "divergesFromPhp": "a `catch (Throwable)` around a failing assertion cannot turn a red test green; the runner reads its own ledger rather than the exception state",
      "seeAlso": [
        "testing/assertions-are-typed",
        "testing/runner-is-strict",
        "errors/throwable-hierarchy"
      ],
      "guardedBy": [
        "tests/conformance/core/a-failed-assertion-is-caught-by-name.nvst",
        "tests/conformance/core/a-failure-consumed-on-purpose-is-spelled-expect-failure.nvst",
        "tests/conformance/core/test-expect-failure-discharges-a-failed-assertion-and-refuses-a-passing-body.nvst",
        "tests/conformance/core/test-three-assertions-agree-on-what-reaches-the-ledger.nvst",
        "tests/conformance/core/test-assert-throws-consumes-the-throw-but-not-the-ledger-entry.nvst"
      ]
    },
    {
      "id": "testing/constructor-is-setup",
      "title": "The constructor is the test's setup, and there is no second before-hook",
      "status": "shipped",
      "because": ["0079", "0022"],
      "divergesFromPhp": "there is no `setUp`, `setUpBeforeClass` or `tearDownAfterClass`; the constructor is the only one, and every property is assigned before any test body runs",
      "seeAlso": ["testing/after-hook", "testing/fixtures", "testing/isolate-per-test"],
      "guardedBy": ["crates/nvs-runtime/src/dispatch.rs"]
    },
    {
      "id": "testing/after-hook",
      "title": "`#[After]` is for state that outlives the isolate, and nothing else needs teardown",
      "status": "designed",
      "because": ["0079"],
      "seeAlso": ["testing/constructor-is-setup", "testing/isolate-per-test"],
      "guardedBy": []
    },
    {
      "id": "testing/fixtures",
      "title": "`#[Fixture]` is built once per class and injected into a test by the type it returns",
      "status": "shipped",
      "because": ["0079", "0023"],
      "divergesFromPhp": "shared setup is resolved by declared type while compiling, so an unsatisfiable parameter is a diagnostic rather than a null at run time",
      "seeAlso": ["testing/data-rows", "testing/constructor-is-setup", "testing/isolate-per-test"],
      "guardedBy": [
        "tests/conformance/lang/a-fixture-is-built-once-and-injected-by-type.nvst",
        "tests/conformance/reject/a-fixture-supplies-one-type-from-a-public-static-method.nvst",
        "tests/conformance/reject/a-test-parameter-is-supplied-by-a-fixture-or-refused.nvst",
        "crates/nvs-types/tests/testing.rs"
      ]
    },
    {
      "id": "testing/data-rows",
      "title": "`#[TestWith]` is matched against the parameters by name and by type, and each row is its own case",
      "status": "shipped",
      "because": ["0079", "0046", "0071"],
      "divergesFromPhp": "a data provider is a checked attribute payload rather than an `array<array<mixed>>` a method returns, so a row that does not fit the signature is refused where it is written",
      "seeAlso": ["testing/fixtures", "testing/test-attribute", "testing/report-formats"],
      "guardedBy": [
        "tests/conformance/lang/a-data-row-is-its-own-reported-case.nvst",
        "tests/conformance/reject/a-data-row-is-matched-against-the-parameters-by-name-and-by-type.nvst",
        "crates/nvs-types/tests/testing.rs"
      ]
    },
    {
      "id": "testing/doubles",
      "title": "A double is a shape of closures, structurally checked against an interface",
      "status": "designed",
      "because": ["0079", "0036", "0031", "0052", "0043"],
      "divergesFromPhp": "no class is generated and no source is evaluated; a double is a value the checker compares against the interface, and a loose or nice double is not expressible",
      "seeAlso": ["testing/interaction-after-the-fact", "testing/assertions-are-typed"],
      "guardedBy": []
    },
    {
      "id": "testing/interaction-after-the-fact",
      "title": "A call to a double is asserted after the exercise, never expected before it",
      "status": "designed",
      "because": ["0079"],
      "divergesFromPhp": "there is no `expects()`; the method being asserted on is a compile-checked reference, so renaming it breaks the test rather than leaving it passing",
      "seeAlso": ["testing/doubles", "testing/assertions-are-typed"],
      "guardedBy": []
    },
    {
      "id": "testing/determinism-declared-on-the-test",
      "title": "`at:` and `seed:` fix the clock and the generator of the test's own isolate",
      "status": "shipped",
      "because": ["0079", "0008"],
      "divergesFromPhp": "time and randomness are controlled by a declaration on the test rather than by a clock parameter threaded through every time-aware class",
      "seeAlso": [
        "testing/task-tree-and-virtual-clock",
        "testing/isolate-per-test",
        "testing/tests-never-reach-a-build"
      ],
      "guardedBy": [
        "tests/conformance/core/test-advance-refuses-without-a-fixed-clock.nvst",
        "tests/conformance/core/test-advance-refuses-the-same-way-for-every-duration.nvst",
        "tests/conformance/core/the-members-a-test-makes-deterministic-agree-on-which-one-is-the-mutator.nvst",
        "crates/nvs-cli/src/runner.rs"
      ]
    },
    {
      "id": "testing/task-tree-and-virtual-clock",
      "title": "A task still running when a test returns fails that test",
      "status": "shipped",
      "because": ["0079", "0072"],
      "seeAlso": [
        "testing/determinism-declared-on-the-test",
        "testing/runner-is-strict",
        "testing/isolate-per-test"
      ],
      "guardedBy": ["crates/nvs-cli/src/runner.rs"]
    },
    {
      "id": "testing/db-transaction",
      "title": "`#[Test(db:)]` opens a transaction on the test's own context and rolls it back",
      "status": "shipped",
      "because": ["0079", "0067"],
      "seeAlso": ["testing/isolate-per-test", "testing/runner-is-strict"],
      "guardedBy": [
        "crates/nvs-cli/src/runner.rs",
        "crates/nvs-stdlib/src/db/transaction.rs"
      ]
    },
    {
      "id": "testing/in-process-request",
      "title": "A test request is dispatched in-process through the compiled route table, and its input arrives `tainted`",
      "status": "shipped",
      "because": ["0079", "0077", "0102", "0024", "0074", "0058", "0051"],
      "divergesFromPhp": "an HTTP test needs no socket, no port and no web server; the real route table and the real middleware chain answer it in microseconds",
      "seeAlso": ["testing/isolate-per-test", "testing/task-tree-and-virtual-clock"],
      "guardedBy": [
        "tests/conformance/core/an-in-process-request-carries-the-compiled-route-tables-own-match.nvst",
        "tests/conformance/core/an-in-process-request-may-not-be-made-from-inside-one.nvst",
        "tests/conformance/core/an-in-process-request-to-an-unclaimed-path-is-answered-by-the-program.nvst",
        "tests/conformance/core/an-in-process-responses-status-is-the-programs-own-or-200.nvst",
        "tests/conformance/core/a-program-with-no-ephemeral-listener-reads-no-address.nvst",
        "crates/nvs-cli/src/runner.rs"
      ]
    },
    {
      "id": "testing/an-outbound-call-is-answered-from-a-table",
      "title": "One registered answer makes every outbound call in that test come from the table, and an unmatched one throws rather than reaching the network",
      "status": "shipped",
      "because": ["0180"],
      "divergesFromPhp": "there is no way to intercept `curl_exec` short of a wrapper the application was written around or a stub extension; here one registered answer takes the whole test off the network",
      "seeAlso": ["testing/in-process-request", "testing/doubles", "http-server/allow-url-pins-the-address"],
      "guardedBy": [
        "crates/nvs-stdlib/src/test.rs",
        "tests/conformance/core/test-answer-http-serves-an-outbound-call-from-a-table.nvst",
        "tests/conformance/core/test-sent-http-records-each-outbound-request.nvst",
        "tests/conformance/core/test-an-unanswered-outbound-call-throws-and-never-connects.nvst"
      ]
    },
    {
      "id": "testing/an-outbound-socket-is-answered-by-a-scripted-peer",
      "title": "`Core\\Test`'s table answers a WebSocket handshake, plays the frames it was given and records what the program sent, and an unmatched socket throws rather than connecting",
      "status": "designed",
      "because": ["0183"],
      "seeAlso": [
        "testing/an-outbound-call-is-answered-from-a-table",
        "testing/determinism-declared-on-the-test",
        "http-server/an-outbound-socket-is-opened-like-an-outbound-call"
      ]
    },
    {
      "id": "testing/property-testing",
      "title": "`#[Property]` derives its generators from the parameters' declared types",
      "status": "designed",
      "because": ["0079", "0071", "0009"],
      "seeAlso": ["testing/data-rows", "testing/assertions-are-typed"],
      "guardedBy": []
    },
    {
      "id": "testing/inline-snapshots",
      "title": "A snapshot is a literal in the test body, and the updater rewrites that literal and nothing else",
      "status": "shipped",
      "because": ["0079", "0033"],
      "seeAlso": ["testing/assertions-are-typed", "testing/report-formats"],
      "guardedBy": [
        "tests/conformance/core/test-assert-matches-inline-agrees-with-debug-render-over-every-value-kind.nvst",
        "tests/conformance/core/test-assert-matches-inline-quotes-both-sides-of-a-mismatch.nvst",
        "tests/conformance/core/test-assert-matches-inline-never-holds-a-secret-property.nvst",
        "crates/nvs-cli/src/runner.rs"
      ]
    },
    {
      "id": "testing/mutation-testing",
      "title": "A mutation run asks whether any test would have noticed the code being wrong",
      "status": "designed",
      "because": ["0079", "0018", "0042"],
      "seeAlso": ["testing/debug-probes", "testing/isolate-per-test", "testing/four-proofs"],
      "guardedBy": []
    },
    {
      "id": "testing/runner-is-strict",
      "title": "A test that asserts nothing fails, a skip states a reason, and a retry is reported flaky rather than green",
      "status": "shipped",
      "because": ["0079", "0020"],
      "divergesFromPhp": "a test with no assertion is a failure rather than a risky-marked pass, and a case that only passed on a retry never counts as green",
      "seeAlso": [
        "testing/failure-ledger",
        "testing/report-formats",
        "testing/task-tree-and-virtual-clock",
        "testing/db-transaction"
      ],
      "guardedBy": [
        "tests/conformance/lang/a-retried-test-that-passes-is-reported-as-flaky.nvst",
        "tests/conformance/reject/a-retry-states-the-reason-it-is-retried.nvst",
        "tests/conformance/lang/a-test-attribute-builds-a-table-the-runner-reports.nvst"
      ]
    },
    {
      "id": "testing/report-formats",
      "title": "One verdict, three renderings, a machine format owns stdout alone, and the JSON one locates every test it reports",
      "status": "shipped",
      "because": ["0079", "0018", "0040", "0172"],
      "seeAlso": [
        "testing/runner-is-strict",
        "testing/data-rows",
        "testing/nvst-is-separate",
        "ide/the-test-tree-is-discovered-and-run-through-the-cli"
