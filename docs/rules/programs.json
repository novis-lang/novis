{
  "topic": "programs",
  "title": "Programs",
  "order": 10,
  "rules": [
    {
      "id": "programs/audience",
      "title": "Novis is built for web applications of every kind, with command-line tooling second",
      "status": "shipped",
      "because": ["0080", "0100"],
      "seeAlso": [
        "programs/three-claims",
        "programs/no-compatibility-promise",
        "programs/slice-ranking",
        "programs/first-party-framework"
      ],
      "guardedBy": []
    },
    {
      "id": "programs/three-claims",
      "title": "Novis claims three things, and \"faster than PHP\" is not one of them",
      "status": "shipped",
      "because": ["0080", "0026"],
      "seeAlso": ["programs/audience", "programs/no-compatibility-promise", "programs/memory-priority"],
      "guardedBy": []
    },
    {
      "id": "programs/no-compatibility-promise",
      "title": "The PHP-shaped syntax is an on-ramp, and no document may promise compatibility",
      "status": "shipped",
      "because": ["0080", "0089", "0152"],
      "divergesFromPhp": "existing PHP packages, frameworks and code do not run, and no document may imply otherwise",
      "seeAlso": ["programs/audience", "programs/three-claims", "packaging/help-text-speaks-to-its-reader"],
      "guardedBy": []
    },
    {
      "id": "programs/slice-ranking",
      "title": "When two slices compete, the one that gets a working application sooner wins",
      "status": "shipped",
      "because": ["0080"],
      "seeAlso": ["programs/audience", "programs/first-party-framework", "programs/memory-priority"],
      "guardedBy": []
    },
    {
      "id": "programs/memory-priority",
      "title": "Memory buys security, correctness, latency and simplicity — bounded, attributable and stated",
      "status": "shipped",
      "because": ["0004"],
      "seeAlso": ["programs/program-id", "programs/three-claims", "errors/propagation"],
      "guardedBy": []
    },
    {
      "id": "programs/implementing",
      "title": "`Core\\Program::implementing<T>()` is the one enumeration, and it expands while compiling",
      "status": "shipped",
      "because": ["0061"],
      "divergesFromPhp": "a plugin roster is a compile-time array literal, not a `foreach` over `new $className`",
      "seeAlso": ["programs/no-runtime-autoload", "programs/autoload", "programs/framework-refusals"],
      "guardedBy": [
        "tests/conformance/core/program-implementing-enumerates-every-implementor.nvst",
        "tests/conformance/core/program-implementing-expands-to-new-expressions-at-the-call-site.nvst",
        "tests/conformance/lang/a-class-named-only-by-an-attribute-is-autoloaded.nvst"
      ]
    },
    {
      "id": "programs/implementing-with",
      "title": "`Core\\Program::implementingWith<I, T>($member)` joins the enumeration with one attribute per class, and it expands while compiling",
      "status": "shipped",
      "because": ["0212"],
      "divergesFromPhp": "a plugin roster with its metadata is one compile-time array literal, not a `ReflectionClass` sweep over discovered classes",
      "seeAlso": [
        "programs/implementing",
        "attributes/structural-retrieval",
        "attributes/retrieval-folds-while-checking"
      ],
      "guardedBy": [
        "tests/conformance/core/program-implementing-with-joins-each-instance-with-its-attribute.nvst",
        "tests/conformance/core/program-implementing-with-reads-the-class-or-a-property-by-name.nvst",
        "tests/conformance/reject/program-implementing-with-names-a-member-every-implementor-declares.nvst",
        "tests/conformance/reject/program-implementing-with-answers-at-most-one-attribute-per-class.nvst",
        "crates/nvs-types/src/program.rs"
      ]
    },
    {
      "id": "programs/compile-target",
      "title": "A compile target changes the host context, never the language",
      "status": "designed",
      "because": ["0025"],
      "seeAlso": ["programs/bundle-trust-domain", "programs/no-runtime-autoload"],
      "guardedBy": []
    },
    {
      "id": "programs/no-runtime-autoload",
      "title": "A name reaches its file while compiling; there is no runtime loader of any kind",
      "status": "shipped",
      "because": ["0061", "0028", "0052"],
      "divergesFromPhp": "there is no `spl_autoload_register`, no `__autoload` and no `new $name` — a name held in a string can never reach a file",
      "seeAlso": [
        "programs/autoload",
        "programs/implementing",
        "programs/one-declaration-per-autoloaded-file"
      ],
      "guardedBy": ["tests/conformance/lang/a-class-reached-only-through-autoload-runs.nvst"]
    },
    {
      "id": "programs/autoload",
      "title": "`autoload` maps a prefix to roots, resolved relative to the file that declares it",
      "status": "shipped",
      "because": ["0061", "0021", "0029"],
      "divergesFromPhp": "the map is a declaration in source rather than a registered loader or a `psr-4` manifest, and it travels with the code instead of with the deployment",
      "seeAlso": [
        "programs/no-runtime-autoload",
        "programs/one-declaration-per-autoloaded-file",
        "programs/path-case"
      ],
      "guardedBy": [
        "tests/conformance/lang/an-autoload-in-the-entry-point-resolves-a-class.nvst",
        "tests/conformance/lang/an-autoload-prefix-probes-its-second-root-only-after-the-first-misses.nvst",
        "tests/conformance/lang/an-autoload-probe-compares-the-on-disk-spelling-exactly.nvst",
        "tests/conformance/lang/an-explicit-autoload-prefix-shadows-a-discover-glob.nvst",
        "tests/conformance/lang/a-duplicate-autoload-prefix-is-a-compile-error.nvst",
        "tests/conformance/lang/an-autoload-inside-an-autoloaded-file-is-a-compile-error.nvst",
        "crates/nvs-hir/src/autoload.rs"
      ]
    },
    {
      "id": "programs/one-declaration-per-autoloaded-file",
      "title": "A file reached by autoload declares exactly one thing, named for the file",
      "status": "shipped",
      "because": ["0061"],
      "divergesFromPhp": "PSR-4 imposes this by convention; here it is a diagnostic",
      "seeAlso": ["programs/autoload", "programs/no-runtime-autoload"],
      "guardedBy": ["tests/conformance/lang/an-autoloaded-file-declares-exactly-one-thing.nvst"]
    },
    {
      "id": "programs/path-case",
      "title": "A `require` path is compared against the on-disk entry exactly, on every OS",
      "status": "shipped",
      "because": ["0062", "0021"],
      "divergesFromPhp": "`require` does not inherit the filesystem's case behaviour, so a path that resolves on Windows or macOS resolves on Linux or fails on all three",
      "seeAlso": ["programs/autoload"],
      "guardedBy": [
        "crates/nvs-hir/src/requires.rs",
        "tests/conformance/lang/an-autoload-probe-compares-the-on-disk-spelling-exactly.nvst"
      ]
    },
    {
      "id": "programs/program-id",
      "title": "`Core\\Program::id()` is 64 hex characters naming this program's code and environment",
      "status": "shipped",
      "because": ["0061", "0042"],
      "seeAlso": ["programs/memory-priority", "programs/no-runtime-autoload"],
      "guardedBy": [
        "tests/conformance/core/a-program-id-is-64-lowercase-hex-characters.nvst",
        "tests/conformance/core/a-program-id-is-the-programs-and-not-the-asking-files.nvst",
        "tests/conformance/core/two-reads-of-the-program-id-in-one-run-agree.nvst",
        "crates/nvs-config/src/cache.rs"
      ]
    },
    {
      "id": "programs/bundle-trust-domain",
      "title": "A bundled executable is one trust domain: a program, never a service",
      "status": "shipped",
      "because": ["0048", "0093"],
      "seeAlso": ["programs/compile-target", "programs/audience"],
      "guardedBy": ["crates/nvs-cli/src/service.rs", "crates/nvs-cli/tests/bundle.rs"]
    },
    {
      "id": "programs/first-party-framework",
      "title": "Novis ships the framework, split by the standard-library placement tests",
      "status": "designed",
      "because": ["0082", "0051"],
      "seeAlso": [
        "programs/framework-core-half",
        "programs/framework-web-package",
        "programs/framework-refusals",
        "programs/nvs-new"
      ],
      "guardedBy": []
    },
    {
      "id": "programs/framework-core-half",
      "title": "The privileged half of the framework is `Core`, compiled into the binary",
      "status": "shipped",
      "because": ["0082", "0051", "0024"],
      "seeAlso": [
        "programs/first-party-framework",
        "programs/framework-web-package",
        "errors/ambiguous-input-refused"
      ],
      "guardedBy": [
        "tests/conformance/core/session-start-refuses-a-tree-that-configured-no-store.nvst",
        "tests/conformance/core/mail-refuses-an-endpoint-the-deployment-did-not-name.nvst",
        "tests/conformance/core/storage-reaches-only-a-disk-the-deployment-named.nvst",
        "tests/conformance/core/cldr-plural-category-refuses-a-language-it-carries-no-rules-for.nvst",
        "tests/conformance/core/password-hash-verify-and-needs-rehash-take-no-algorithm-argument.nvst"
      ]
    },
    {
      "id": "programs/framework-web-package",
      "title": "The opinionated half is `nvs/web`, a first-party package providing the `Web` namespace",
      "status": "designed",
      "because": ["0082", "0081"],
      "seeAlso": [
        "programs/first-party-framework",
        "programs/framework-core-half",
        "programs/no-migration-runner"
      ],
      "guardedBy": []
    },
    {
      "id": "programs/framework-refusals",
      "title": "The framework has no ORM, no runtime container, and no second way to do anything",
      "status": "designed",
      "because": ["0082"],
      "divergesFromPhp": "the ORM, the service container, the facade, the route cache and the autoload dump have no equivalent, and each is absent by construction rather than by omission",
      "seeAlso": ["programs/first-party-framework", "programs/implementing"],
      "guardedBy": []
    },
    {
      "id": "programs/no-migration-runner",
      "title": "No migration runner ships until migration semantics are decided",
      "status": "designed",
      "because": ["0082"],
      "seeAlso": ["programs/framework-web-package", "programs/first-party-framework"],
      "guardedBy": []
    },
    {
      "id": "programs/nvs-new",
      "title": "`nvs new` writes an application that runs before it is edited",
      "status": "designed",
      "because": ["0082", "0080"],
      "seeAlso": [
        "programs/first-party-framework",
        "programs/framework-web-package",
        "programs/audience"
      ],
      "guardedBy": []
    }
  ]
}
