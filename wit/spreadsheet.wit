package nvs:spreadsheet@1.0.0;

/// The spreadsheet component's whole surface: three resources, each kept by
/// the request that opened it, and the calls that drive them.
///
/// `Novis\Spreadsheet`'s classes are Novis source that build these records
/// and call `Novis\Spreadsheet\Engine`, whose static methods are these
/// exports (`rule:core-classes/spreadsheet-roster`). Nothing here names a
/// file or a URL: a write returns the compressed bytes ready to leave, and a
/// read or a fill takes the source the program holds, lent as a `value` on
/// every call that reads it, whose ranges the guest reads through the host
/// (`rule:core-classes/spreadsheet-reads-as-a-stream`). CSV never reaches the
/// component: the Novis half parses and formats it with `Core\Csv`.
///
/// Every type here is one the Novis-to-WIT table gives, so `u64` is a Novis
/// `uint` and `list<u8>` a `bytes`. A time crosses as its clock time: the
/// Novis half places an `Instant` in the workbook's zone and a read clock
/// time in the reader's, so the guest holds no zone data.
interface engine {
    use nvs:ext/types@1.0.0.{error, value, date, time-of-day, duration};

    // ---- cells ----

    record text-cell {
        text: string,
    }

    record number-cell {
        number: f64,
    }

    record integer-cell {
        integer: s64,
    }

    /// A `decimal` as its text. The Novis half sends one past 15
    /// significant digits as a `text-cell` instead.
    record decimal-cell {
        decimal: string,
    }

    record bool-cell {
        boolean: bool,
    }

    record date-cell {
        date: date,
    }

    record time-cell {
        time: time-of-day,
    }

    record duration-cell {
        duration: duration,
    }

    /// A `DateTime`'s own clock time, or an `Instant`'s in the workbook's
    /// zone.
    record clock-cell {
        day: date,
        clock: time-of-day,
    }

    /// A formula's text, with no leading `=`, and the result the file
    /// carries beside it.
    record formula-cell {
        formula: string,
        cached-text: option<string>,
        cached-number: option<f64>,
    }

    record rich-run {
        text: string,
        style: option<u64>,
    }

    record rich-cell {
        runs: list<rich-run>,
    }

    /// One cell's value, by `rule:core-classes/spreadsheet-value-types`'
    /// write table.
    variant cell-value {
        text(text-cell),
        number(number-cell),
        integer(integer-cell),
        decimal(decimal-cell),
        boolean(bool-cell),
        date(date-cell),
        time(time-cell),
        duration(duration-cell),
        clock(clock-cell),
        formula(formula-cell),
        rich(rich-cell),
    }

    /// One cell: an absent value is an empty cell, and `style` is an id
    /// `writer-style` returned, on top of the row's and the column's.
    record cell {
        value: option<cell-value>,
        style: option<u64>,
    }

    /// A `header` row is the sheet's header row, which only its first row can
    /// be. It gets the sheet's `header-options`.
    record row {
        cells: list<cell>,
        style: option<u64>,
        height: option<f64>,
        hidden: bool,
        level: u64,
        header: bool,
    }

    // ---- styles ----

    enum line {
        thin,
        medium,
        thick,
        dashed,
        dotted,
        double,
    }

    record border {
        top: option<line>,
        right: option<line>,
        bottom: option<line>,
        left: option<line>,
    }

    enum underline {
        single,
        double,
    }

    enum align {
        left,
        center,
        right,
        fill,
        justify,
    }

    enum valign {
        top,
        center,
        bottom,
    }

    /// The style fields of `rule:core-classes/spreadsheet-styles-and-defaults`,
    /// one layer of them. `format` is a format code or one of the shortcuts.
    record style {
        font: option<string>,
        size: option<f64>,
        bold: option<bool>,
        italic: option<bool>,
        strike: option<bool>,
        underline: option<underline>,
        color: option<string>,
        fill: option<string>,
        border: option<border>,
        border-color: option<string>,
        align: option<align>,
        valign: option<valign>,
        wrap: option<bool>,
        rotate: option<s64>,
        indent: option<u64>,
        format: option<string>,
        locked: option<bool>,
        hide-formula: option<bool>,
    }

    // ---- the workbook and its sheets ----

    record properties {
        title: option<string>,
        subject: option<string>,
        author: option<string>,
        company: option<string>,
        keywords: option<string>,
        created: option<clock-cell>,
    }

    /// `target` names where the bytes go, as the Novis half shows it to a
    /// person: the download's file name, the file's path, or `memory`. The
    /// error a writer dropped before `writer-finish` logs names it.
    record workbook-options {
        properties: properties,
        target: string,
    }

    enum visibility {
        visible,
        hidden,
        very-hidden,
    }

    /// A column, in header order. An absent `width` with `auto` measures
    /// the sheet's first batch of rows. A column past the list has `auto`
    /// when the sheet has a header row. `format` is a format code or a
    /// shortcut, over the column's `style`.
    record column {
        width: option<f64>,
        auto: bool,
        style: option<u64>,
        format: option<string>,
        hidden: bool,
    }

    /// What a header row gets: `default-style` is bold with a thin bottom
    /// border, with `style` over it, or `style` alone when it is off.
    /// `freeze` freezes the header and `filter` puts an autofilter over it
    /// and the rows below.
    record header-options {
        default-style: bool,
        style: option<u64>,
        freeze: bool,
        filter: bool,
    }

    /// `new-sheet-on-overflow` goes on to a sheet named `<name> (2)`, with
    /// the header row repeated, at the end of the grid.
    record sheet-options {
        name: string,
        position: option<u64>,
        visibility: visibility,
        columns: list<column>,
        freeze-rows: u64,
        freeze-columns: u64,
        autofilter: option<string>,
        tab-color: option<string>,
        zoom: option<u64>,
        gridlines: bool,
        right-to-left: bool,
        header: header-options,
        new-sheet-on-overflow: bool,
    }

    record merge-part {
        merge: string,
    }

    record link-part {
        anchor: string,
        target: string,
        text: option<string>,
        tooltip: option<string>,
    }

    record note-part {
        noted: string,
        note: string,
        author: option<string>,
    }

    enum rule-kind {
        %list,
        whole,
        decimal,
        date,
        length,
        formula,
    }

    enum operator {
        between,
        not-between,
        equal,
        not-equal,
        greater,
        greater-or-equal,
        less,
        less-or-equal,
    }

    record validation-part {
        validated: string,
        kind: rule-kind,
        operator: option<operator>,
        values: list<string>,
        input-title: option<string>,
        input-message: option<string>,
        error-title: option<string>,
        error-message: option<string>,
        allow-empty: bool,
    }

    record group-part {
        grouped: string,
        collapsed: bool,
    }

    enum total-function {
        sum,
        average,
        count,
        min,
        max,
    }

    record table-total {
        column: string,
        function: option<total-function>,
        formula: option<string>,
    }

    record table-part {
        table: string,
        name: option<string>,
        style: option<string>,
        banded: bool,
        filter: bool,
        totals: list<table-total>,
    }

    enum conditional-kind {
        cell,
        formula,
        color-scale,
        data-bar,
        icon-set,
        top,
        bottom,
        duplicates,
        unique,
    }

    record conditional-part {
        formatted: string,
        kind: conditional-kind,
        operator: option<operator>,
        values: list<string>,
        colors: list<string>,
        icons: option<string>,
        rank: option<u64>,
        percent: bool,
        style: option<style>,
    }

    /// PNG, JPEG or GIF bytes; the format is read from them, and any other
    /// returns `invalid`.
    record image-part {
        at: string,
        image: list<u8>,
        width: option<f64>,
        height: option<f64>,
        offset-x: option<f64>,
        offset-y: option<f64>,
    }

    enum chart-kind {
        column,
        bar,
        line,
        area,
        pie,
        doughnut,
        scatter,
    }

    enum legend {
        hidden,
        top,
        right,
        bottom,
        left,
    }

    record chart-series {
        values: string,
        categories: option<string>,
        name: option<string>,
        color: option<string>,
    }

    /// One chart type and its series; a combination is two layers.
    record chart-layer {
        kind: chart-kind,
        series: list<chart-series>,
    }

    record chart-part {
        placed: string,
        layers: list<chart-layer>,
        title: option<string>,
        x-title: option<string>,
        y-title: option<string>,
        legend: legend,
        labels: bool,
        width: option<f64>,
        height: option<f64>,
    }

    enum orientation {
        portrait,
        landscape,
    }

    record margins {
        top: f64,
        right: f64,
        bottom: f64,
        left: f64,
    }

    record print-part {
        orientation: option<orientation>,
        fit-width: option<u64>,
        fit-height: option<u64>,
        margins: option<margins>,
        header: option<string>,
        footer: option<string>,
        repeat-rows: option<string>,
        area: option<string>,
    }

    record protect-part {
        password: option<string>,
        allow: list<string>,
    }

    /// One part written after the rows or in a part of its own
    /// (`rule:core-classes/spreadsheet-sheet-end-parts`). Each case's record
    /// has keys no other case has, so a Novis value picks its case by shape.
    variant sheet-part {
        merge(merge-part),
        link(link-part),
        note(note-part),
        validation(validation-part),
        group(group-part),
        table(table-part),
        conditional(conditional-part),
        image(image-part),
        chart(chart-part),
        print(print-part),
        protect(protect-part),
    }

    record sheet-rows {
        name: string,
        rows: u64,
    }

    /// `data` is the last bytes to send; `size` counts every byte the
    /// workbook sent.
    record finished {
        data: list<u8>,
        rows: list<sheet-rows>,
        size: u64,
    }

    /// A workbook being written, sheet after sheet
    /// (`rule:core-classes/spreadsheet-writes-as-a-stream`).
    resource writer;

    /// Opens a workbook. Nothing is written until the first sheet. A writer
    /// the request drops before `writer-finish` logs an error naming its
    /// `target`.
    writer-open: func(options: workbook-options) -> result<writer, error>;
    /// The id of a style layer, the same id for an equal style.
    writer-style: func(writer: borrow<writer>, style: style) -> result<u64, error>;
    /// Finishes the open sheet, if any, and opens the next one with its first
    /// rows, which auto width measures. Returns the bytes ready to leave.
    writer-sheet: func(writer: borrow<writer>, options: sheet-options, first: list<row>) -> result<list<u8>, error>;
    /// Writes a batch of rows to the open sheet and returns the bytes ready
    /// to leave. The guest keeps no row of an earlier batch.
    writer-rows: func(writer: borrow<writer>, rows: list<row>) -> result<list<u8>, error>;
    /// Adds a sheet-end part to the open sheet. An image is written at once,
    /// and its bytes are returned.
    writer-part: func(writer: borrow<writer>, part: sheet-part) -> result<list<u8>, error>;
    /// A defined name over a reference.
    writer-define: func(writer: borrow<writer>, name: string, reference: string) -> result<_, error>;
    /// The A1 address of the column `column`, from 0, in the row `row`, such
    /// as `C7` (`rule:core-classes/spreadsheet-formula-is-a-value`).
    writer-cell: func(writer: borrow<writer>, column: u64, row: u64) -> result<string, error>;
    /// The open sheet's data range in the column `column`, from 0, over the
    /// rows written so far, such as `C2:C1043`.
    writer-column: func(writer: borrow<writer>, column: u64) -> result<string, error>;
    /// Finishes the open sheet and the workbook.
    writer-finish: func(writer: borrow<writer>) -> result<finished, error>;

    // ---- reading ----

    enum sheet-kind {
        worksheet,
        chartsheet,
    }

    record sheet-info {
        name: string,
        position: u64,
        visibility: visibility,
        rows: u64,
        columns: u64,
        kind: sheet-kind,
    }

    /// The selection and the defaults of `rule:core-classes/spreadsheet-reads-as-a-stream`.
    /// `text` names columns by letter; the Novis half turns header names into
    /// letters.
    record read-options {
        sheet: string,
        header-row: option<u64>,
        %from: option<u64>,
        limit: option<u64>,
        columns: list<string>,
        text: list<string>,
        text-all: bool,
        formulas: bool,
        keep-empty-rows: bool,
        fill-merged: bool,
        skip-hidden: bool,
        locale: string,
    }

    enum cell-error {
        null,
        div-zero,
        value,
        ref,
        name,
        num,
        not-available,
        getting-data,
        spill,
        calc,
    }

    record error-cell {
        error: cell-error,
    }

    /// One read cell's value, by the read table. A whole number within
    /// ±2^53 is `integer`, and a clock time is in no zone.
    variant read-value {
        text(text-cell),
        integer(integer-cell),
        number(number-cell),
        boolean(bool-cell),
        clock(clock-cell),
        date(date-cell),
        time(time-cell),
        duration(duration-cell),
        error(error-cell),
    }

    /// `column` counts from 1. `formula` is set with `formulas`, and
    /// `display` for a column `text` names.
    record read-cell {
        column: u64,
        value: option<read-value>,
        formula: option<string>,
        display: option<string>,
    }

    record read-row {
        number: u64,
        cells: list<read-cell>,
    }

    record read-batch {
        rows: list<read-row>,
        done: bool,
    }

    record link-info {
        anchor: string,
        target: string,
        text: option<string>,
        tooltip: option<string>,
        external: bool,
    }

    record note-info {
        noted: string,
        note: string,
        author: option<string>,
    }

    record name-info {
        name: string,
        reference: string,
        sheet: option<string>,
    }

    record table-info {
        table: string,
        name: string,
        sheet: string,
    }

    /// A formula cell `reader-evaluate` did not compute: `cell` as
    /// `Sheet!A1`, `kind` as `function`, `reference`, `circular` or
    /// `token`, and the text that names what.
    record missed-info {
        cell: string,
        kind: string,
        text: string,
    }

    /// A picture placed in its file has its bytes in `image`. A linked
    /// picture has no bytes and its target's text in `link`, never fetched.
    record image-info {
        at: string,
        image: list<u8>,
        format: string,
        link: option<string>,
    }

    /// A workbook being read (`rule:core-classes/spreadsheet-reads-as-a-stream`).
    /// It is not named `reader`, because a manifest's resource is a class in
    /// `Novis\Spreadsheet` and `Reader` is the Novis class over it.
    resource reading;

    /// `rule:core-classes/decompression-bound` for one workbook: a part held
    /// whole decompresses to at most `max-bytes` across the archive, and every
    /// part to at most `max-ratio` times its compressed size. The host sets
    /// both to the request's `[limits]` before the call, so `none` reads as
    /// the shipped default only where no host clamped it.
    record decompression-bound {
        max-bytes: option<u64>,
        max-ratio: option<u64>,
    }

    /// Opens the workbook `source` holds: reads its directory and its
    /// workbook part, and nothing of a sheet.
    reader-open: func(source: borrow<value>, bound: decompression-bound) -> result<reading, error>;
    reader-sheets: func(reader: borrow<reading>, source: borrow<value>) -> result<list<sheet-info>, error>;
    /// The header's keys: a duplicate numbered, an empty one its column
    /// letter.
    reader-header: func(reader: borrow<reading>, source: borrow<value>, options: read-options) -> result<list<string>, error>;
    /// The next batch of at most `max` rows of the sheet `options` names.
    /// A call whose `from` is past the last row the reader gave continues
    /// where it stopped, and any other starts the sheet again. `limit` is
    /// the most rows this call may give.
    reader-rows: func(reader: borrow<reading>, source: borrow<value>, options: read-options, max: u64) -> result<read-batch, error>;
    reader-merged: func(reader: borrow<reading>, source: borrow<value>, sheet: string) -> result<list<string>, error>;
    reader-links: func(reader: borrow<reading>, source: borrow<value>, sheet: string) -> result<list<link-info>, error>;
    reader-notes: func(reader: borrow<reading>, source: borrow<value>, sheet: string) -> result<list<note-info>, error>;
    reader-names: func(reader: borrow<reading>, source: borrow<value>) -> result<list<name-info>, error>;
    reader-tables: func(reader: borrow<reading>, source: borrow<value>, sheet: string) -> result<list<table-info>, error>;
    reader-images: func(reader: borrow<reading>, source: borrow<value>, sheet: string) -> result<list<image-info>, error>;
    reader-properties: func(reader: borrow<reading>, source: borrow<value>) -> result<properties, error>;
    /// The names of an xlsm's macro modules. Nothing runs them.
    reader-macros: func(reader: borrow<reading>, source: borrow<value>) -> result<list<string>, error>;
    /// Computes every formula of the workbook, once, and returns the cells
    /// it could not compute. Each later `reader-rows` gives a computed
    /// cell's result. Nothing is fetched and nothing runs on its own.
    reader-evaluate: func(reader: borrow<reading>, source: borrow<value>) -> result<list<missed-info>, error>;
    /// At most `length` bytes of `source` from `offset`, or every byte from
    /// `offset` when `length` is `none`. The Novis half reads a CSV file's
    /// first bytes, and a CSV file in another charset whole, through it.
    source-bytes: func(source: borrow<value>, offset: u64, length: option<u64>) -> result<list<u8>, error>;

    // ---- template fill ----

    /// One placeholder's path, such as `customer.name`, and its value. An
    /// absent value is an empty cell.
    record placeholder {
        path: string,
        value: option<cell-value>,
    }

    /// A batch of a list's items, each its own placeholders by their paths
    /// inside the item, such as `qty`.
    record item-batch {
        name: string,
        items: list<list<placeholder>>,
    }

    /// The bytes `template-fill` wrote, and the lists the template repeats in
    /// the order their blocks stand. A list the template does not use is not
    /// in `lists`.
    record filled {
        data: list<u8>,
        lists: list<string>,
    }

    /// A designed workbook being filled (`rule:core-classes/spreadsheet-template-fill`).
    /// It is not named `template`, because `Novis\Spreadsheet\Template` is
    /// the Novis class over it.
    resource filling;

    template-open: func(source: borrow<value>, bound: decompression-bound) -> result<filling, error>;
    /// Fills one cell by address, such as `Summary!B2`, before `template-fill`.
    template-set: func(template: borrow<filling>, address: string, value: option<cell-value>) -> result<_, error>;
    /// Fills every placeholder that is not in a list, finds the block of each
    /// of `lists`, and returns the bytes up to the first block.
    template-fill: func(template: borrow<filling>, values: list<placeholder>, lists: list<string>) -> result<filled, error>;
    /// Writes a batch of a list's items and returns the bytes ready to leave.
    /// The batches come in the order `filled` gives the lists.
    template-items: func(template: borrow<filling>, batch: item-batch) -> result<list<u8>, error>;
    /// Writes everything after the last block, shifted, and every other part,
    /// and returns the last bytes.
    template-finish: func(template: borrow<filling>, source: borrow<value>) -> result<finished, error>;
}

/// The spreadsheet component: everything an extension may import, and
/// `engine`.
world spreadsheet {
    include nvs:ext/extension@1.0.0;

    export engine;
}
