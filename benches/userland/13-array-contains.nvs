<?nvs
// in_array over a list — the membership test userland reaches for before it reaches for a set.
class Bench {
    public static function run(int $size, int $probes): int {
        array<string> $allowed = [];
        var $i = 0;
        while ($i < $size) {
            $allowed[] = "role-" . $i;
            $i = $i + 1;
        }

        var $hits = 0;
        var $probe = 0;
        while ($probe < $probes) {
            if (Core\Arr::contains($allowed, "role-" . ($probe * 7 % ($size * 2)))) {
                $hits = $hits + 1;
            }
            $probe = $probe + 1;
        }
        return $hits;
    }
}

echo Bench::run(500, 20000), "\n";
