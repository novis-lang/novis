<?nvs
// Calling an override through a base-typed handle — the interface dispatch a framework runs on.
class Shape {
    protected int $size;

    public function constructor(int $size) {
        $this->size = $size;
    }

    public function area(): int {
        return $this->size * $this->size;
    }
}

class Circle extends Shape {
    public function area(): int {
        return $this->size * $this->size * 3;
    }
}

class Bench {
    public static function run(int $rounds): int {
        array<Shape> $shapes = [new Shape(3), new Circle(4), new Shape(5), new Circle(6)];
        var $total = 0;
        var $i = 0;
        while ($i < $rounds) {
            foreach ($shapes as Shape $shape) {
                $total = ($total + $shape->area()) % 1000003;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(500000), "\n";
