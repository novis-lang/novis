<?mwl
// explode/implode round trips - how userland parses a CSV line, a path or a header.
class Bench {
    public static function run(int $rounds): int {
        array<string> $lines = [];
        var $k = 0;
        while ($k < 16) {
            $lines[] = "id" . $k . ",name,email,city,country,created,updated,status,score,notes";
            $k = $k + 1;
        }

        var $total = 1;
        var $i = 0;
        while ($i < $rounds) {
            array<string> $fields = Core\Str::split($lines[$total % 16], ",");
            var $back = Core\Str::join($fields, "|");
            $total = $total + Core\Arr::count($fields) as int + Core\Str::length($back) as int;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
