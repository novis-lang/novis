<?mwl
// Constructing objects and moving values through their properties — the DTO, the entity, the model.
class Point {
    public int $x;
    public int $y;

    public function constructor(int $x, int $y) {
        $this->x = $x;
        $this->y = $y;
    }
}

class Bench {
    public static function run(int $rounds): int {
        var $total = 0;
        var $i = 0;
        while ($i < $rounds) {
            var $point = new Point($i, $i * 2);
            $point->x = $point->x + $point->y;
            $point->y = $point->y - 1;
            $total = ($total + $point->x + $point->y) % 1000003;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000000), "\n";
