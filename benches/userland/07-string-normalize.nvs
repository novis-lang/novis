<?nvs
// trim / lower / pad - the tidy-up every form field and imported row goes through.
class Bench {
    public static function run(int $rounds): int {
        array<string> $raws = [];
        var $k = 0;
        while ($k < 16) {
            $raws[] = "   Ada  LOVELACE " . Core\Str::repeat("x", $k as uint) . "   ";
            $k = $k + 1;
        }

        var $total = 1;
        var $i = 0;
        while ($i < $rounds) {
            var $tidy = Core\Str::lower(Core\Str::trim($raws[$total % 16]));
            var $padded = Core\Str::padEnd($tidy, 32, ".");
            $total = $total + Core\Str::length($padded) as int;
            if (Core\Str::contains($padded, "lovelace")) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(300000), "\n";
