<?mwl
// Ordering records by one field - the leaderboard, the sorted table, the usort() every app has.
class Row {
    public string $name;
    public int $score;

    public function constructor(string $name, int $score) {
        $this->name = $name;
        $this->score = $score;
    }
}

class Bench {
    public static function run(int $size, int $rounds): string {
        array<Row> $rows = [];
        var $seed = 12345;
        var $i = 0;
        while ($i < $size) {
            $seed = ($seed * 1103515245 + 12345) % 2147483648;
            $rows[] = new Row("row-" . $i, $seed % 100000);
            $i = $i + 1;
        }

        var $total = 1;
        var $round = 0;
        var $top = "";
        while ($round < $rounds) {
            $rows[$round % $size] = new Row("edit-" . $round, $total % 100000);
            var $sorted = Core\Arr::sort($rows, {by: fn(Row $r): int => $r->score});
            var $first = Core\Arr::first($sorted);
            if ($first != null) {
                $total = $total + $first->score + 1;
                $top = $first->name;
            }
            $round = $round + 1;
        }
        return $top . "/" . $total;
    }
}

echo Bench::run(50000, 20), "\n";
