<?mwl
// map / filter / reduce over a list - the pipeline that replaced the foreach.
class Bench {
    public static function run(int $size, int $rounds): int {
        array<int> $source = [];
        var $i = 0;
        while ($i < $size) {
            $source[] = $i;
            $i = $i + 1;
        }

        var $total = 1;
        var $round = 0;
        while ($round < $rounds) {
            $source[$round % $size] = $total % 1000;
            var $doubled = Core\Arr::map($source, fn(int $n): int => $n * 2);
            var $kept = Core\Arr::filter($doubled, fn(int $n): bool => $n % 3 == 0);
            $total = $total + Core\Arr::reduce($kept, fn(int $carry, int $n): int => $carry + $n, 0);
            $round = $round + 1;
        }
        return $total;
    }
}

echo Bench::run(100000, 20), "\n";
