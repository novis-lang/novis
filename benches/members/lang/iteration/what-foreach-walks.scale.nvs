<?nvs
// Measures a `foreach` loop over an array, at growing array lengths.
// It shows how the cost of the loop grows when the array grows.
// bench: start 256
// bench: max 4096

class Bench {
    public static function run(uint $size): int {
        int $n = $size as int;
        array<int> $values = [];
        int $i = 0;
        while ($i < $n) {
            $values[] = $i % 10;
            $i = $i + 1;
        }
        int $total = 0;
        int $r = 0;
        while ($r < 64) {
            foreach ($values as int $v) {
                $total = $total + $v + ($total % 2);
            }
            $r = $r + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
