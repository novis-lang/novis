<?nvs
// Collects a short generator into an array with `Core\Arr::from`. A program meets this shape
// when it needs the whole of a sequence at once, to count it or to sort it.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function steps(int $n): Iterator<int> {
        int $i = 0;
        while ($i < $n) {
            yield $i;
            $i = $i + 1;
        }
    }

    public static function run(int $rounds): int {
        int $total = 0;
        int $r = 0;
        while ($r < $rounds) {
            array<int> $values = Core\Arr::from(Bench::steps(8));
            // Chained: what this round adds depends on the number the last
            // round produced, so the call stays where it is.
            $total = $total + $values[($total + $r) % 8];
            $r = $r + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
