<?nvs
// Walks an array with a `foreach` loop. A program meets this shape whenever it reads every
// value of a list it already holds.
// bench: iterations 512
// bench: complexity linear

class Bench {
    public static function run(int $rounds): int {
        array<int> $values = [3, 1, 4, 1, 5, 9, 2, 6];
        int $total = 0;
        int $r = 0;
        while ($r < $rounds) {
            foreach ($values as int $v) {
                // Chained: what this step adds depends on the total the last one reached,
                // so the loop stays where it is.
                $total = $total + $v + ($total % 2);
            }
            $r = $r + 1;
        }
        return $total;
    }
}

echo Bench::run(512), "\n";
