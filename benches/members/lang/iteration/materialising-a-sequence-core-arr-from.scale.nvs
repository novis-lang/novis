<?nvs
// Measures `Core\Arr::from` on a generator, at growing numbers of values.
// It shows how the cost of collecting a sequence grows with its length.
// bench: start 256
// bench: max 4096

class Bench {
    public static function steps(int $n): Iterator<int> {
        int $i = 0;
        while ($i < $n) {
            yield $i;
            $i = $i + 1;
        }
    }

    public static function run(uint $size): int {
        int $n = $size as int;
        int $total = 0;
        int $r = 0;
        while ($r < 64) {
            array<int> $values = Core\Arr::from(Bench::steps($n));
            $total = $total + $values[($total + $r) % $n];
            $r = $r + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
