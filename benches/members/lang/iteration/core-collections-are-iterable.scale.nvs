<?nvs
// Measures the bench's loops while the `Core\ObjectMap` and the `Core\ObjectSet` grow.
// The `Core\Heap` stays at eight numbers, because a loop over a heap copies it.
// bench: start 12500
// bench: max 100000
// bench: rounds 64

final class Item
{
    public int $id;

    public function constructor(int $id)
    {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(uint $size, uint $rounds): int
    {
        var $byName = new Core\ObjectMap<string, Item>();
        var $seen = new Core\ObjectSet<Item>();
        var $costs = new Core\Heap<int>();
        int $n = $size as int;
        int $i = 0;
        while ($i < $n) {
            Item $item = new Item($i);
            $byName->set("item{$i}", $item);
            $seen->add($item);
            $i = $i + 1;
        }
        $i = 0;
        while ($i < 8) {
            $costs->push(8 - $i);
            $i = $i + 1;
        }

        int $total = 0;
        uint $r = 0;
        while ($r < $rounds) {
            foreach ($byName as string $name) {
                $total = $total + ($byName->get($name)?->id ?? 0);
                break;
            }
            foreach ($seen as Item $item) {
                $total = $total + $item->id;
                break;
            }
            foreach ($costs as int $cost) {
                $total = $total + $cost + ($total % 2);
            }
            $r = $r + 1;
        }
        return $total;
    }
}

echo Bench::run(12500, 64), "\n";
