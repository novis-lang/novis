<?nvs
// Drives a cursor written by hand through a `foreach` loop. A program meets this shape when a
// class of its own is walked, so the loop calls `advance()` and `current()` on every step.
// bench: iterations 50000

class Letters implements Iterator<int> {
    private int $at = -1;

    public function constructor(private array<int> $items) {}

    public function advance(): bool {
        $this->at = $this->at + 1;
        return $this->at < 8;
    }

    public function current(): int {
        return $this->items[$this->at];
    }
}

class Bench {
    public static function run(int $rounds): int {
        array<int> $values = [3, 1, 4, 1, 5, 9, 2, 6];
        int $total = 0;
        int $r = 0;
        while ($r < $rounds) {
            foreach (new Letters($values) as int $v) {
                // Chained: what this step adds depends on the total the last one reached,
                // so the loop stays where it is.
                $total = $total + $v + ($total % 2);
            }
            $r = $r + 1;
        }
        return $total;
    }
}

echo Bench::run(50000), "\n";
