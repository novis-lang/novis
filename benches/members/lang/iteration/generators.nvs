<?nvs
// Drives a generator through a `foreach` loop. A program meets this shape when it reads a
// sequence of values that are produced one step at a time.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function steps(int $n): Iterator<int> {
        int $i = 0;
        while ($i < $n) {
            yield $i;
            $i = $i + 1;
        }
    }

    public static function run(int $rounds): int {
        int $total = 0;
        int $r = 0;
        while ($r < $rounds) {
            foreach (Bench::steps(8) as int $v) {
                // Chained: what this round adds depends on the number the last
                // round produced, so the loop stays where it is.
                $total = $total + $v + ($total % 2);
            }
            $r = $r + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
