<?nvs
// Uses `foreach` to read the first entry of a `Core\ObjectMap` and a `Core\ObjectSet`, and every number in a small `Core\Heap`.
// A program does this when it reports the values a request collected.
// bench: iterations 256
// bench: complexity constant

final class Item
{
    public int $id;

    public function constructor(int $id)
    {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(int $rounds): int
    {
        var $byName = new Core\ObjectMap<string, Item>();
        var $seen = new Core\ObjectSet<Item>();
        var $costs = new Core\Heap<int>();
        int $i = 0;
        while ($i < 8) {
            Item $item = new Item($i);
            $byName->set("item{$i}", $item);
            $seen->add($item);
            $costs->push(8 - $i);
            $i = $i + 1;
        }

        int $total = 0;
        int $r = 0;
        while ($r < $rounds) {
            // Each loop reads the first entry and stops.
            foreach ($byName as string $name) {
                $total = $total + ($byName->get($name)?->id ?? 0);
                break;
            }
            foreach ($seen as Item $item) {
                $total = $total + $item->id;
                break;
            }
            // This loop reads all eight numbers of the heap.
            // What each round adds depends on the total from the last round.
            foreach ($costs as int $cost) {
                $total = $total + $cost + ($total % 2);
            }
            $r = $r + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
