<?nvs
// Walks a small `Core\ObjectSet` and a small `Core\Heap` with `foreach`. A program meets this shape
// when a request has collected some values and reports every one of them before it answers.
// bench: iterations 50000
// bench: complexity nlogn

class Bench {
    public static function run(int $rounds): int {
        var $tags = new Core\ObjectSet<int>();
        var $costs = new Core\Heap<int>();
        int $i = 0;
        while ($i < 8) {
            $tags->add($i);
            $costs->push(8 - $i);
            $i = $i + 1;
        }

        int $total = 0;
        int $r = 0;
        while ($r < $rounds) {
            foreach ($tags as int $tag) {
                $total = $total + $tag;
            }
            foreach ($costs as int $cost) {
                // Chained: what this round adds depends on the number the last
                // round produced, so the loops stay where they are.
                $total = $total + $cost + ($total % 2);
            }
            $r = $r + 1;
        }
        return $total;
    }
}

echo Bench::run(50000), "\n";
