<?nvs
// Measures what a group of three jobs costs to start, run and collect. A page that
// loads several parts at the same time meets this once per request.
// bench: iterations 20000

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: this round's jobs are given the number the last round returned.
            uint $seed = $total % 7;
            var $group = Core\Task::all({
                one:   fn(): uint => $seed + 1,
                two:   fn(): uint => $seed + 2,
                three: fn(): uint => $seed + 3,
            });
            $total = $total + $group->one + $group->two + $group->three;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
