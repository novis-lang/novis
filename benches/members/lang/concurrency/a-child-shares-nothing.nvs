<?nvs
// Measures what a started script costs to set up and take down: its own class
// statics, its own place to print to, and the result it returns. A program that
// runs a job for every item on a list meets this once per item.
// bench: iterations 512
// bench: complexity constant

class Bench {
    // `here` returns its argument as a full path. A relative path written in
    // quotes starts at the folder of this file.
    private static function here(#[Core\Path] string $path): string {
        return $path;
    }

    public static function run(uint $rounds): uint {
        array<string> $scripts = [
            Bench::here("a-child-shares-nothing/counts-once.nvs"),
            Bench::here("a-child-shares-nothing/counts-three-times.nvs"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the script started this round is picked by the number the
            // last one returned.
            string $path = $scripts[($total % 2) as int];
            var $handle = spawn script $path with(output: "capture");
            var $result = await $handle;
            // Every round reads the same number back, because each script starts
            // with a fresh copy of `Counter::$seen`.
            $total = $total + ($result->value as uint) + Core\Str::length($result->output as string);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(512), "\n";
