<?nvs
// Measures what it costs to call a function that waits and then carry on. Every file
// read and every database answer in a request goes through this path, so this is the
// price of the waiting model itself.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function wait(uint $n): uint {
        Core\Time::sleep(0ms);
        return $n + 1;
    }

    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: each round waits, then adds to the number the last one gave.
            $total = Bench::wait($total);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
