<?nvs
// Uses a case of a `Core` enum as an ordinary value: compares it and converts it to its number. A
// program meets this shape when it carries a sort direction through its own code before handing it
// to the member that takes it.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0

class Bench {
    public static function run(int $rounds): int {
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the case held this round is picked by the number the last
            // round produced, so the comparison stays inside the loop.
            Core\Order $held = $total % 3 == 0 ? Core\Order::Desc : Core\Order::Asc;
            if ($held == Core\Order::Desc) {
                $total = $total + ($held as int) + 1;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
