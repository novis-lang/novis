<?nvs
// Adding and multiplying whole numbers is what a request spends most of its
// arithmetic on. This measures those operators together with the overflow
// test each one makes before it gives a result. Every round takes its input
// from the round before it, so no work can be skipped.
// bench: iterations 400000
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        int $total = 1;
        uint $i = 0;

        while ($i < $rounds) {
            int $step = ($total * 3 + 7) % 1000;   // chained: $total is last round's

            $total = ($total + $step) % 100000 + 1;

            $i = $i + 1;
        }

        return $total;
    }
}

echo Bench::run(400000), "\n";
