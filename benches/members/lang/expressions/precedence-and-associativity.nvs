<?nvs
// Measures one expression that mixes six levels of operator precedence. Real code writes
// this when it works out a line total and then makes a decision from it.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 1;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: this round starts from the total the last one left.
            $total = ($total * 3 + $i * 2 + 1) % 1000003 + ($total % 2 == 0 && $i % 3 == 1 ? 1 : 0) as uint;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
