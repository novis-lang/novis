<?nvs
// Measures a three-step pipeline that trims a label, makes it lower case and
// counts its length. A request handler does this to clean up a form field.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(int $rounds): int {
        array<string> $labels = ["  Ada ", "BOB", " carol  ", "Dee"];
        var $total = 0;
        var $i = 0;
        while ($i < $rounds) {
            $total = $total + ($labels[$total % 4]
                |> Core\Str::trim($_)
                |> Core\Str::lower($_)
                |> Core\Str::length($_) as int);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
