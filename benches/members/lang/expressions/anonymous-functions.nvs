<?nvs
// A program passes an anonymous function to a sort or a filter, and calls it
// many times. This measures three calls per round: to an anonymous function
// that captures nothing, to one that captures a number, and to one written
// as a block.
// bench: iterations 200000
// bench: allocations 0
// bench: complexity constant
// proof: gap nvs-runtime/call-through-a-callable-builds-its

class Bench {
    public static function run(int $rounds): int {
        int $step = 3;
        callable $plain = fn(int $n): int => $n + 1;
        callable $holding = fn(int $n): int => $n + $step;
        callable $block = fn(int $n): int => {
            int $doubled = $n * 2;

            return $doubled - $n;
        };

        int $acc = 1;
        int $i = 0;

        while ($i < $rounds) {
            // Chained: this round's argument is last round's answer.
            $acc = $plain($acc) as int;
            $acc = $holding($acc) as int;
            $acc = ($block($acc) as int) % 1000003;
            $i = $i + 1;
        }

        return $acc;
    }
}

echo Bench::run(200000), "\n";
