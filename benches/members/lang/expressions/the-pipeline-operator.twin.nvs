<?nvs
// Measures the same three steps as the pipeline bench, written as nested calls.
// The two programs compile to the same code, so the two figures should match.
// bench: iterations 1000000

class Bench {
    public static function run(int $rounds): int {
        array<string> $labels = ["  Ada ", "BOB", " carol  ", "Dee"];
        var $total = 0;
        var $i = 0;
        while ($i < $rounds) {
            $total = $total + (Core\Str::length(Core\Str::lower(Core\Str::trim($labels[$total % 4]))) as int);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000000), "\n";
