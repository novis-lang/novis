<?nvs
// Checks whether a file next to the program exists, as a program does before it reads its own data file.
// bench: iterations 20000

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each path in quotes starts at the folder of this file. The first one is this file.
            bool $found = false;
            if ($total % 2 == 0) {
                $found = Core\IO::exists("file-paths-a-relative-path-starts-at-the-folder-of-its-file.nvs");
            } else {
                $found = Core\IO::exists("missing.txt");
            }
            if ($found) {
                $total = $total + 1;
            } else {
                $total = $total + 3;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
