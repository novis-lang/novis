<?nvs
// Measures `Core\Arr::sort` on a list of text values, then adds them up as numbers.
// The list gets longer at each step, so this shows how the cost grows with it.
// bench: start 256
// bench: max 4096

class Bench {
    public static function run(uint $size): int {
        int $n = $size as int;
        array<string> $amounts = [];
        int $i = 0;
        while ($i < $n) {
            $amounts[] = "" . (($i * 7919) % 1000);
            $i = $i + 1;
        }
        int $total = 0;
        int $r = 0;
        while ($r < 64) {
            $amounts[0] = "" . ($total % 1000);
            array<string> $ordered = Core\Arr::sort($amounts, {order: Core\Order::Asc});
            foreach ($ordered as string $each) {
                $total = $total + ($each as int);
            }
            $r = $r + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
