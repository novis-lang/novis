<?nvs
// Measures a loop with a comment on almost every line, as in well-explained code.
// Comments are read only when the program is compiled. This loop should run
// as fast as the same loop without comments.
// bench: iterations 4000000
// bench: allocations 0
// bench: complexity constant

int $a = 1; // the value from the last round
int $b = 2; # a line comment can also start with #
int $total = 0;
int $i = 0;

/* A block comment before the loop. */
while ($i < 4000000) {
    $a = $total + 1; // each line uses the result of the line before
    $b = $a + $a; /* so the compiler cannot remove any of them */
    // The remainder keeps the running sum small.
    $total = $total + ($b % 7);
    $i = $i + 1; # and on to the next round
}

echo $total, "\n";
