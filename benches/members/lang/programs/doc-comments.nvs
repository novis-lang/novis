<?nvs
// Measures a loop in a class that has doc comments, as a shared library has.
// The `@see` tags point at a method, a constant and a Markdown file.
// The compiler reads doc comments, and the running program does not.
// So this loop should run as fast as the same loop with no doc comments.
// bench: iterations 4000000
// bench: allocations 0
// bench: complexity constant

/// Adds a run of numbers into one running total.
///
/// @see Meter::run
/// @see doc-comments/meter.md
final class Meter
{
    /// Each round adds the remainder of a division by this number.
    ///
    /// @see Meter::run
    /// @see doc-comments/meter.md#the-wrap
    public const int WRAP = 7;

    /// Runs `$rounds` rounds and returns the running total.
    ///
    /// @see Meter::WRAP
    /// @see doc-comments/meter.md#a-run
    public static function run(int $rounds): int
    {
        // Inside a function body, use an ordinary `//` comment.
        // A doc comment documents a declaration, such as a class or a method.
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            $total = $total + (($i + $total) % Meter::WRAP);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Meter::run(4000000), "\n";
