<?nvs
// This measures counting the characters and the bytes of a name from a form.
// A form checks both: characters for the reader, bytes for storage.
// Each round picks its name from the last round's total, so no count can be skipped.
// bench: iterations 1024
// bench: allocations 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): int {
        array<string> $names = ["Ann", "Grüße", "Rene\u{301}e", "Łukasz Szymański"];
        int $carry = 1;
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $name = $names[$carry % 4];
            int $characters = Core\Str::length($name) as int;
            int $stored = Core\Bytes::length($name as bytes) as int;
            $carry = ($carry + $characters + $stored) % 997;      // chained: $carry is last round's
            $total = $total + $carry;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
