<?nvs
// Adds numbers written in hexadecimal, binary, octal and with `_` separators.
// Each one is a plain number before the program starts, so `0x1F` costs the same as `31`.
// Each round starts from the last round's total. The loop allocates no memory.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = ($total + 0x1F + 0b101 + 0o17 + 017 + 1_000) % 65_521;   // chained: $total is last round's
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
