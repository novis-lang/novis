<?nvs
// Does arithmetic on a `mixed` variable, as code does with request data it has not converted.
// The type of a `mixed` value is checked at every step while the program runs.
// Converting the value once, at the start, avoids that cost. Each round uses the last round's value.
// bench: iterations 300000
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): int {
        mixed $carry = 1;
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $carry = ($carry + 7) % 997;                 // chained: $carry is last round's
            $total = $total + ($carry as int);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(300000), "\n";
