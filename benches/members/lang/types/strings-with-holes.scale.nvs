<?nvs
// Measures checking the holes of one condition, at growing numbers of holes.
// bench: start 256
// bench: max 4096

class Order
{
    public int $total = 0;
}

class Bench
{
    public static function run(uint $size): uint
    {
        string $text = Core\Str::repeat('{total} > 1 AND ', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string<propertyPath<Order>> $condition = ($text . '') as string<propertyPath<Order>>;
            $total = $total + Core\Str::length($condition as string);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
