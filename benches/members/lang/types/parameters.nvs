<?nvs
// Every method call in a program builds an argument list, and this one is
// built the three ways a caller can build it at once: a default left out, an
// argument written by name, and one that writes back into the caller's own
// variable. Each round starts from the round before it, so none of the calls
// can be skipped.
// bench: iterations 400000
// bench: allocations 0

class Tally
{
    public static function add(inout int $running, int $amount, int $weight = 3): void
    {
        $running = $running + $amount * $weight;
    }
}

class Bench
{
    public static function run(uint $rounds): int
    {
        int $running = 1;
        uint $i = 0;

        while ($i < $rounds) {
            Tally::add(inout $running, amount: $running % 7);   // chained: $running is last round's
            $i = $i + 1;
        }

        return $running;
    }
}

echo Bench::run(400000), "\n";
