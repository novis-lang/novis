<?nvs
// A running tally kept in a lookup table -- the loop a counting or grouping
// report has, one worked-out key per round with a read and a write through
// it. The key is a number every round, and turning a number into the text
// key it names is work an array subscript does that nothing else does.
// bench: iterations 300000
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): int {
        array<int> $tally = [0, 0, 0, 0];
        int $carry = 1;
        uint $i = 0;
        while ($i < $rounds) {
            int $slot = $carry % 4;
            $tally[$slot] = $tally[$slot] + $carry;      // chained: $carry is last round's
            $carry = $tally[$slot] % 1000 + 1;
            $i = $i + 1;
        }
        return $carry;
    }
}

echo Bench::run(300000), "\n";
