<?nvs
// Keeps running totals in an array, with one read and one write per loop round.
// A report that counts or groups rows uses a loop like this. The key is a number,
// and each round computes it from the last round's result.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        array<int> $tally = [0, 0, 0, 0];
        int $carry = 1;
        uint $i = 0;
        while ($i < $rounds) {
            int $slot = $carry % 4;
            $tally[$slot] = $tally[$slot] + $carry;      // chained: $carry is last round's
            $carry = $tally[$slot] % 1000 + 1;
            $i = $i + 1;
        }
        return $carry;
    }
}

echo Bench::run(2048), "\n";
