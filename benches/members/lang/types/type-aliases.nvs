<?nvs
// A loop written entirely through named types: a number, either-or, and an
// array of those. The names are gone before anything runs, so this counts
// exactly what the same loop with every type spelled out counts, and that
// equality is the figure worth keeping. Each round starts from the last
// round's total, so nothing here can be settled ahead of time.
// bench: iterations 300000
// bench: allocations 0
// bench: calls 0

type Slot = int;
type Answer = int|string;
type Answers = array<Answer>;

class Bench {
    public static function run(uint $rounds): int {
        Answers $answers = [1, "two", 3, "four", 5];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Slot $slot = ($total + ($i as int)) % 5;   // chained: $total is last round's
            Answer $answer = $answers[$slot];
            if ($answer is int) {
                $total = $total + $answer;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(300000), "\n";
