<?nvs
// This measures a loop that uses only type aliases: a number, a union and an array.
// An alias costs nothing at run time, so this loop is as fast as one with the full types.
// Each round starts from the last round's total, so no round can be skipped.
// bench: iterations 300000
// bench: allocations 0
// bench: calls 0
// bench: complexity constant

type Slot = int;
type Answer = int|string;
type Answers = array<Answer>;

class Bench {
    public static function run(uint $rounds): int {
        Answers $answers = [1, "two", 3, "four", 5];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Slot $slot = ($total + ($i as int)) % 5;   // chained: $total is last round's
            Answer $answer = $answers[$slot];
            if ($answer is int) {
                $total = $total + $answer;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(300000), "\n";
