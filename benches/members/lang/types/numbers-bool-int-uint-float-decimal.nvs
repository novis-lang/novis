<?nvs
// A running money total stepped by a fraction of a cent -- the loop a pricing or
// ledger routine writes. It is `decimal` rather than `int` or `float` because
// that is the number type whose `+`, `-` and `*` are out-of-line helper calls
// over a 96-bit mantissa instead of one native instruction, so this is the
// figure that moves when that lowering does.
// bench: iterations 500000

class Bench {
    public static function run(int $rounds): decimal {
        decimal $total = 0.00;
        decimal $step = 0.01;
        var $i = 0;
        while ($i < $rounds) {
            $total = $total + $step * 2 - $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(500000), "\n";
