<?nvs
// Adds a fraction of a cent to a `decimal` money total in a loop.
// Pricing and accounting code does this. `decimal` arithmetic is slower than
// `int` or `float` arithmetic, and this bench measures that cost.
// bench: iterations 500000
// bench: complexity constant

class Bench {
    public static function run(int $rounds): decimal {
        decimal $total = 0.00;
        decimal $step = 0.01;
        var $i = 0;
        while ($i < $rounds) {
            $total = $total + $step * 2 - $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(500000), "\n";
