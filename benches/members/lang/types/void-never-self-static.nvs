<?nvs
// Filters loaded objects with `is static` into an `array<static>`, as `Order::findAll()` does in a base model class.
// bench: iterations 256 -- one operation is now a whole finder call, which loops over the loaded objects
// bench: allocations 2
// bench: calls 2
// bench: complexity linear

class Model
{
    private static array<Model> $loaded = [];

    public static function remember(Model $object): void
    {
        Model::$loaded[] = $object;
    }

    public static function findAll(): array<static>
    {
        array<static> $found = [];
        foreach (Model::$loaded as Model $object) {
            if ($object is static) {
                $found[] = $object;
            }
        }
        return $found;
    }
}

final class Order extends Model
{}

final class Customer extends Model
{}

class Bench
{
    public static function run(uint $rounds): uint
    {
        Model::remember(new Order());
        Model::remember(new Customer());
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The rounds call `Order::findAll()` and `Customer::findAll()` in turn.
            // Each call returns an array with one object.
            if ($total % 2 == 0) {
                $total = $total + Core\Arr::count(Order::findAll());
            } else {
                $total = $total + Core\Arr::count(Customer::findAll());
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
