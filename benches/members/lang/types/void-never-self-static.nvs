<?nvs
// Measures what a small family of record types costs. A class builds whichever
// kind was named, methods return the object, and one method is called only for
// what it does. Each round starts from the running total, so nothing is
// computed ahead of time. One object is allocated per round.
// bench: iterations 200000
// bench: allocations 1
// bench: calls 5
// bench: complexity constant

class Row {
    public function constructor(public int $n) {}

    public static function make(int $n): static {
        return new static($n);
    }

    public function add(int $k): self {
        $this->n = $this->n + $k;
        return $this;
    }

    public static function seen(int $v): void {}
}

final class Total extends Row {}

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Total $row = Total::make($total % 7);   // chained: $total is last round's
            $total = $total + $row->add(1)->add(2)->n;
            Row::seen($total);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
