<?nvs
// Measures joining tainted text, counting its length and comparing a secret string, at growing text lengths.
// It shows how the cost grows when the text a person sent grows.
// bench: start 256
// bench: max 4096

class Bench {
    public static function run(uint $size): uint {
        tainted string $seed = Core\Str::repeat('a', $size);
        secret string $token = Core\Str::repeat('h', $size);
        string $guess = Core\Str::repeat('h', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            tainted string $line = "seen " . $seed;
            $total = $total + Core\Str::length($line);
            if ($token == $guess) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
