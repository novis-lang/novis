<?nvs
// Measures converting a property path, at growing numbers of names in the path.
// bench: start 256
// bench: max 4096

class Category
{
    public string $name = '';
    public ?Category $parent = null;
}

class Bench
{
    public static function run(uint $size): uint
    {
        string $text = Core\Str::repeat('parent.', $size) . 'name';
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            propertyPath<Category> $path = ($text . '') as propertyPath<Category>;
            $total = $total + Core\Str::length($path as string);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
