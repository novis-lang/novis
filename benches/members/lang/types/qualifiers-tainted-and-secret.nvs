<?nvs
// Measures the work a marked value costs: joining untrusted text, asking its
// length, and comparing a confidential one. That is what a request does every
// time it reads something a person sent it.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<tainted string> $seeds = ["42 apples", "7 pears"];
        secret string $token = "hunter2";
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            tainted string $line = "seen " . $seeds[($total % 2) as int];
            $total = $total + Core\Str::length($line);
            if ($token == "hunter2") {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
