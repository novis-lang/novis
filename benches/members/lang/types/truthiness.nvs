<?nvs
// Nearly every request starts by asking whether something is there at all: a
// setting, a list of rows, a line of text. This is what that question costs
// when the kind of value is only settled while the program runs, which is the
// one case that cannot be worked out ahead of time. Every round picks its
// value from the round before it, so none of this can be skipped.
// bench: iterations 400000
// bench: allocations 0

class Bench
{
    public static function run(uint $rounds): int
    {
        array<mixed> $values = ["", "0", "0.0", 0, 1, [], [7], null];
        int $total = 1;
        uint $i = 0;

        while ($i < $rounds) {
            mixed $value = $values[$total % 8];   // chained: $total is last round's

            if ($value) {
                $total = $total + 3;
            } else {
                $total = $total + 1;
            }

            $i = $i + 1;
        }

        return $total;
    }
}

echo Bench::run(400000), "\n";
