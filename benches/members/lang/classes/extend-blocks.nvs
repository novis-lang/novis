<?nvs
// Calls a method that an `extend` block adds to `Core\Time\Date`, as a billing loop does for each invoice date.
// bench: iterations 1024
// bench: allocations 0
// bench: calls 2
// bench: complexity constant

namespace Bench;

use Bench\InvoiceDays;
use Core\Time\Date;

extend Date as InvoiceDays
{
    public function isLate(int $lastDay): bool
    {
        return $this->day() > $lastDay;
    }
}

class Bench
{
    public static function run(int $rounds): int
    {
        array<Date> $dates = [Date::at(2026, 1, 3), Date::at(2026, 2, 17), Date::at(2026, 3, 9), Date::at(2026, 4, 28)];
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: this round's result picks the next round's date.
            $total = $total + ($dates[$total % 4]->isLate(10) ? 5 : 1);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
