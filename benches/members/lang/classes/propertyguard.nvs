<?nvs
// Writes one property of a class that guards itself. A class that checks
// every value before it is stored has this cost for every property it updates.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

final class Checked implements PropertyGuard
{
    public int $level = 1;

    public function beforePropertySet(string $name, mixed $value, array<string> $keys): void
    {
    }

    public function beforePropertyUnset(string $name, array<string> $keys): void
    {
    }
}

class Bench
{
    public static function run(int $rounds): int
    {
        var $checked = new Checked();
        int $i = 0;
        while ($i < $rounds) {
            // Chained: this round writes what the last one stored.
            $checked->level = $checked->level + 1;
            $i = $i + 1;
        }
        return $checked->level;
    }
}

echo Bench::run(2048), "\n";
