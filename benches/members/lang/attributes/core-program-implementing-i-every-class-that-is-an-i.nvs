<?nvs
// Measures collecting every class that implements an interface, which a program
// does once for each list of plug-ins it builds.
// bench: iterations 100000
// bench: complexity linear
// proof: gap nv/a-bench-cannot-ramp-an-input-fixed-outside-its-program
// bench: calls 1

interface Check {
    public function name(): string;
}

class DiskCheck implements Check {
    public function name(): string {
        return "disk";
    }
}

class MailCheck implements Check {
    public function name(): string {
        return "mail";
    }
}

class QueueCheck implements Check {
    public function name(): string {
        return "queue";
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<Check> $checks = Core\Program::implementing<Check>();
            // Chained: the check read this round is picked with the total from
            // the round before.
            $total = $total + Core\Str::length($checks[($total % 3) as int]->name());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
