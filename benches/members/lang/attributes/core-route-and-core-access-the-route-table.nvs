<?nvs
// Measures matching a path with a date in it to its route.
// The server does this for every request to a page such as a day's schedule.
// bench: iterations 256
// bench: calls 1
// bench: complexity linear

class Days
{
    #[Core\Route(path: '/days/{day}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(Core\Time\Date $day): string
    {
        return $day->toIso();
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $paths = ['/days/2026-03-09', '/days/2026-12-31', '/days/2027-02-28'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the path matched this round is picked with the count of the round before.
            ?Core\Router\Match $found = Core\Router::match(Core\Http\Method::Get, $paths[($total % 3) as int]);
            if ($found != null) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
