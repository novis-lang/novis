<?nvs
// Measures building one link from the route table with a long value in the path, at growing value lengths.
// bench: start 256
// bench: max 4096

class Products {
    #[Core\Route(path: "/products/{sku}", method: Core\Http\Method::Get, name: "product")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(string $sku): string {
        return $sku;
    }
}

class Bench
{
    public static function run(uint $size): uint
    {
        string $sku = Core\Str::repeat('cup-01', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string $url = Core\Router::url("product", ["sku" => $sku]);
            $total = $total + Core\Str::length($url);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
