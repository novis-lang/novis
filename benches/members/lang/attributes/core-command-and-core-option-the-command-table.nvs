<?nvs
// Measures reading a command and one of its options from the compiled table.
// A program does this for every command it knows when it prints a help screen.
// bench: iterations 256
// bench: allocations 2
// bench: calls 2
// bench: complexity constant

class Migrate
{
    #[Core\Command(name: 'migrate', about: 'Apply pending migrations')]
    public static function migrate(
        #[Core\Option(short: 'n', about: 'Print what would happen')] bool $pretend,
    ): uint
    {
        if ($pretend) {
            return 0;
        }
        return 1;
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $command = Core\Attributes::get<Core\Command>(Migrate::migrate);
            var $option = Core\Attributes::get<Core\Option>(Migrate::migrate, 'pretend');
            if ($command != null) {
                if ($option != null) {
                    // Chained: this round's length is added to the total from
                    // the round before. `??` gives '' when `short` is not set.
                    $total = $total + Core\Str::length($command->name) + $total % 2;
                    $total = $total + Core\Str::length($option->short ?? '');
                }
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
