<?nvs
// Measures building one link through your own method that takes a route, which a page does for
// every link it renders.
// bench: iterations 256
// bench: calls 3
// bench: complexity constant

class Products
{
    #[Core\Route(path: '/products/{sku}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public static function show(string $sku): string
    {
        return $sku;
    }
}

class Links
{
    public static function to(
        #[Core\Router\Target] callable $route,
        #[Core\Router\Params] array<mixed> $params,
    ): string {
        return Core\Router::url($route, $params);
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $skus = ['cup-01', 'plate-02', 'bowl-03'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the product linked this round is picked with the length
            // counted in the round before.
            string $url = Links::to(Products::show, ['sku' => $skus[($total % 3) as int]]);
            $total = $total + Core\Str::length($url);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
