<?nvs
// Decides which of four bands a number falls in, the way a program picks a
// label or a price from a chain of rules. Every arm of the chain is reached.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): int {
        int $acc = 1;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: this round's value comes out of the last round.
            int $value = ($acc + $i) % 100;
            if ($value >= 90) {
                $acc = $acc + 4;
            } elseif ($value >= 75) {
                $acc = $acc + 3;
            } elseif ($value >= 50) {
                $acc = $acc + 2;
            } else {
                $acc = $acc + 1;
            }
            $i = $i + 1;
        }
        return $acc;
    }
}

echo Bench::run(400000), "\n";
