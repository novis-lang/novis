<?nvs
// Measures a loop that searches a list and stops with `break` at the first match, at growing list lengths.
// The match is the last value, so every search walks the whole list.
// bench: start 256
// bench: max 4096

class Bench {
    public static function run(uint $size): int {
        int $n = $size as int;
        array<int> $totals = [];
        int $i = 0;
        while ($i < $n) {
            $totals[] = $i;
            $i = $i + 1;
        }
        int $acc = 1;
        int $r = 0;
        while ($r < 64) {
            int $limit = $n - 2 - $acc % 2;
            int $found = 0;
            foreach ($totals as int $total) {
                if ($total > $limit) {
                    $found = $total;
                    break;
                }
            }
            $acc = ($acc + $found + 1) % 1000003;
            $r = $r + 1;
        }
        return $acc;
    }
}

echo Bench::run(256), "\n";
