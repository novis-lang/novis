<?nvs
// Runs a `while` loop and a `do … while` loop that each do one small step per
// round. A program meets this shape whenever it works through a list of items.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0

class Bench {
    public static function run(int $rounds): int {
        int $acc = 1;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: this round's step comes out of the last round.
            $acc = ($acc + ($acc % 7) + 3) % 1000003;
            int $inner = 0;
            do {
                $acc = ($acc + $inner + 1) % 1000003;
                $inner = $inner + 1;
            } while ($inner < 1);
            $i = $i + 1;
        }
        return $acc;
    }
}

echo Bench::run(400000), "\n";
