<?nvs
// Measures a search that skips rows with `continue` and stops with `break`, at growing table sizes.
// The row it looks for is the last one, so every search walks the whole table.
// bench: start 256
// bench: max 4096

class Bench {
    public static function run(uint $size): int {
        int $n = $size as int;
        array<int> $rows = [];
        int $i = 0;
        while ($i < $n) {
            $rows[] = $i;
            $i = $i + 1;
        }
        int $acc = 1;
        int $r = 0;
        while ($r < 64) {
            int $target = $n - 1 - $acc % 2;
            int $found = 0;
            foreach ($rows as int $row) {
                if ($row % 2 == 0) {
                    continue;
                }
                if ($row >= $target) {
                    $found = $row;
                    break;
                }
            }
            $acc = ($acc + $found + 1) % 1000003;
            $r = $r + 1;
        }
        return $acc;
    }
}

echo Bench::run(256), "\n";
