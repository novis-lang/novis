<?nvs
// Measures a failed assertion: the throw, the message it builds out of the two
// values, and the `catch` that takes it. A test suite meets this shape on every
// failing test.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $wanted = 8;
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            try {
                // Chained: the value asserted this round comes out of the last
                // round's message, so the assertion stays inside the loop.
                Core\Test::assertEquals($total % 7, $wanted);
            } catch (Core\Test\Failure $failure) {
                $total = $total + Core\Str::length($failure->message);
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
