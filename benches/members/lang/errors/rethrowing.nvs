<?nvs
// Measures a rethrow: an error is caught, sent on unchanged, and caught again
// one frame out. A program meets this shape wherever one layer counts a failure
// and leaves the decision to the layer above it.
// bench: iterations 200000

class Bench {
    public static function relay(IOError $error): void {
        try {
            throw $error;
        } catch (IOError $caught) {
            throw $caught;
        }
    }

    public static function run(uint $rounds): uint {
        var $error = new IOError("the socket closed");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            try {
                Bench::relay($error);
            } catch (IOError $outer) {
                // Chained: every round adds the length of the place the rethrow
                // wrote, so the loop stays.
                $total = $total + Core\Str::length($outer->location);
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
