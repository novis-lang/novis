<?nvs
// Measures a recursion sixteen calls deep. Every call checks the stack against
// the depth limit, and this is what that check costs a program that walks
// nested data.
// bench: iterations 2048
// bench: calls 17
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function down(int $depth, int $acc): int {
        if ($depth == 0) {
            return $acc;
        }
        return Bench::down($depth - 1, $acc + $depth);
    }

    public static function run(int $rounds): int {
        int $acc = 1;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: every round starts from the last round's total.
            $acc = Bench::down(16, $acc) % 1000003;
            $i = $i + 1;
        }
        return $acc;
    }
}

echo Bench::run(2048), "\n";
