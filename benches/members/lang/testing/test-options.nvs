<?nvs
// Measures the work a test with options does when it runs. The options are read
// while the program is built, so each run of the test costs the same as without them.
// bench: iterations 2048
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

use Core\Test;

class Meter
{
    public static uint $entered = 0;

    public static function enter(): void
    {
        // Chained: the count written here is the one the round before wrote.
        Meter::$entered = Meter::$entered + 1;
    }
}

class OptionsTest
{
    #[Test(seed: 7, retries: 2, because: 'the options a real test carries')]
    public function countsOneEntry(): void
    {
        Meter::enter();
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $i = 0;
        while ($i < $rounds) {
            // The body of `countsOneEntry`. Only a test can call a test method.
            Meter::enter();
            $i = $i + 1;
        }
        return Meter::$entered;
    }
}

echo Bench::run(2048), "\n";
