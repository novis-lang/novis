<?nvs
// Measures the work a method marked `#[Test]` does when it runs. A test runner
// pays this once per test, and the body of a test is ordinary code.
// bench: iterations 2048
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

use Core\Test;

class Meter
{
    public static uint $rounds = 0;

    public static function countOne(): void
    {
        // Chained: the round counted here is the one the round before wrote.
        Meter::$rounds = Meter::$rounds + 1;
    }
}

class MarkedTest
{
    #[Test]
    public function countsOneRound(): void
    {
        Meter::countOne();
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $i = 0;
        while ($i < $rounds) {
            // The body of `countsOneRound`. Only a test can call a test method.
            Meter::countOne();
            $i = $i + 1;
        }
        return Meter::$rounds;
    }
}

echo Bench::run(2048), "\n";
