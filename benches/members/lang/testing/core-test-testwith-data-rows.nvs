<?nvs
// Measures what one data row costs: the test runs once per row, with the values
// of that row. A test runner pays this for every row you write.
// bench: iterations 2048
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

use Core\Test;
use Core\Test\TestWith;

class Meter
{
    public static uint $total = 0;

    public static function add(string $label, uint $weight): void
    {
        // Chained: the total counted here is the one the round before wrote.
        Meter::$total = Meter::$total + $weight;
    }
}

class RowsTest
{
    #[TestWith(label: 'order', weight: 1)]
    #[TestWith(label: 'customer', weight: 2)]
    #[Test]
    public function itAddsTheWeightOfARow(string $label, uint $weight): void
    {
        Meter::add($label, $weight);
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $labels = ['order', 'customer'];
        uint $i = 0;
        while ($i < $rounds) {
            // The body of `itAddsTheWeightOfARow`, with the two values of a row.
            // Only a test can call a test method.
            Meter::add($labels[(Meter::$total % 2) as int], 1);
            $i = $i + 1;
        }
        return Meter::$total;
    }
}

echo Bench::run(2048), "\n";
