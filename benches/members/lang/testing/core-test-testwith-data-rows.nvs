<?nvs
// Measures what one data row costs: the test is called once per row, with the
// values that row holds. A test runner pays this for every row you write.
// bench: iterations 300000
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

use Core\Test;
use Core\Test\TestWith;

class Meter {
    public static uint $total = 0;
}

class RowsTest {
    #[TestWith(label: "order", weight: 1)]
    #[TestWith(label: "customer", weight: 2)]
    #[Test]
    public function itAddsTheWeightOfARow(string $label, uint $weight): void {
        // Chained: the total counted here is the one the round before wrote.
        Meter::$total = Meter::$total + $weight;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $labels = ["order", "customer"];
        var $test = new RowsTest();
        uint $i = 0;
        while ($i < $rounds) {
            // The two values of a row, passed the way the runner passes them.
            $test->itAddsTheWeightOfARow($labels[(Meter::$total % 2) as int], 1);
            $i = $i + 1;
        }
        return Meter::$total;
    }
}

echo Bench::run(300000), "\n";
