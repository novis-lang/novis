<?nvs
// Measures what a test does with a fixture: the value is built once, and each
// test uses that same value. A test runner pays this per test.
// bench: iterations 2048
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

use Core\Test;
use Core\Test\Fixture;

class Counter
{
    public uint $seen = 0;

    public function countOne(): void
    {
        // Chained: the number written here is the one the round before wrote.
        $this->seen = $this->seen + 1;
    }
}

class InjectedTest
{
    #[Fixture]
    public static function counter(): Counter
    {
        return new Counter();
    }

    #[Test]
    public function countsWhatItWasGiven(Counter $counter): void
    {
        $counter->countOne();
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        // Built once for the whole class, the way the runner builds the fixture.
        var $counter = new Counter();
        uint $i = 0;
        while ($i < $rounds) {
            // The body of `countsWhatItWasGiven`. Only a test can call a test method.
            $counter->countOne();
            $i = $i + 1;
        }
        return $counter->seen;
    }
}

echo Bench::run(2048), "\n";
