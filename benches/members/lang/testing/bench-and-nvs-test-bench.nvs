<?nvs
// Measures what one bench costs a run: the bench class is built and its method runs
// once. `nvs test --bench` pays this for every bench in the program.
// bench: iterations 256
// bench: complexity constant

class Meter
{
    public static uint $ran = 0;

    public static function slugOf(uint $n): string
    {
        return 'post-' . $n;
    }
}

class SlugBench
{
    public uint $started;

    public function constructor()
    {
        $this->started = Meter::$ran;
    }

    // The full name of the attribute is written here, because this file has its own class `Bench`.
    #[Core\Test\Bench]
    public function slugsOfOnePost(): void
    {
        Meter::slugOf($this->started);
        Meter::$ran = Meter::$ran + 1;
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $i = 0;
        while ($i < $rounds) {
            var $bench = new SlugBench();
            // The body of `slugsOfOnePost`. Only `nvs test --bench` can call a bench method.
            // Chained: the input is the count the round before wrote.
            Meter::slugOf($bench->started);
            Meter::$ran = Meter::$ran + 1;
            $i = $i + 1;
        }
        return Meter::$ran;
    }
}

echo Bench::run(256), "\n";
