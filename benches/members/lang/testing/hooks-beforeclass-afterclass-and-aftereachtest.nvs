<?nvs
// Measures what a test and its `#[AfterEachTest]` hook do: the test writes, and
// the hook removes what it wrote. A test runner pays this once per test.
// bench: iterations 2048
// bench: calls 2
// bench: allocations 0
// bench: complexity constant

use Core\Test;
use Core\Test\AfterEachTest;

class Scratch
{
    public uint $written = 0;
    public uint $removed = 0;

    public function write(): void
    {
        $this->written = $this->written + 1;
    }

    public function remove(): void
    {
        $this->removed = $this->removed + 1;
    }
}

class CleanupTest
{
    private Scratch $scratch;

    public function constructor()
    {
        $this->scratch = new Scratch();
    }

    #[Test]
    public function writesSomething(): void
    {
        $this->scratch->write();
    }

    #[AfterEachTest]
    public function removesIt(): void
    {
        $this->scratch->remove();
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        // One object for every round, so the counts carry from one round to the next.
        var $scratch = new Scratch();
        uint $i = 0;
        while ($i < $rounds) {
            // The bodies of the test and of its hook. Only a test can call them.
            $scratch->write();
            $scratch->remove();
            $i = $i + 1;
        }
        return $scratch->removed;
    }
}

echo Bench::run(2048), "\n";
