<?nvs
// Measures what one test costs a run: the test class is built, the test's check
// runs, and the assertion it makes is recorded. A run pays this for every test
// in the program.
// bench: iterations 256
// bench: complexity constant

use Core\Test;

class Meter
{
    public static uint $checked = 0;

    public static function checkOne(uint $started): void
    {
        // Chained: the count checked here is the one the round before wrote.
        Test::assertSame($started, Meter::$checked);
        Meter::$checked = Meter::$checked + 1;
    }
}

class RunTest
{
    public uint $started;

    public function constructor()
    {
        $this->started = Meter::$checked;
    }

    #[Test]
    public function itChecksOneThing(): void
    {
        Meter::checkOne($this->started);
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $i = 0;
        while ($i < $rounds) {
            var $test = new RunTest();
            // The body of `itChecksOneThing`. Only a test can call a test method.
            Meter::checkOne($test->started);
            $i = $i + 1;
        }
        return Meter::$checked;
    }
}

echo Bench::run(256), "\n";
