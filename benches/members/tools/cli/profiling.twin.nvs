<?nvs
// Measures the same calls as the profiling bench, with no profile running.
// The difference between the two figures is what the profile adds to one call.
// bench: iterations 262144

class Bench {
    public static function step(uint $total, uint $i): uint {
        return ($total + $i) % 7 + 1;
    }

    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Bench::step($total, $i);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(262144), "\n";
