<?nvs
// Gets a cached client credentials token, as a server program does before each call to another service.
// bench: iterations 2048
// bench: complexity constant
autoload 'Novis\Rest' from '../../../packages/rest/src';

class Bench
{
    public static function run(uint $rounds): uint
    {
        Core\Test::answerHttp('https://login.example.com/oauth/token', 200, {
            json: ['access_token' => 'at-1', 'token_type' => 'Bearer', 'expires_in' => 3600],
        });
        secret string $clientSecret = 's3cret';
        Novis\Rest\Client $client = Novis\Rest\Client::confidential('https://login.example.com/oauth/token', 'shop', $clientSecret);
        array<secret bytes> $keys = [Core\Crypto::generateKey()];
        array<string> $scopes = ['read', 'write', 'read write', 'admin'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Novis\Rest\Token $token = Novis\Rest\ClientCredentials::token($client, $scopes[($total % 4) as int], $keys);
            $total = $total + Core\Str::length($token->type) as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
