<?nvs
// Requests an access token from a token server, as a server program does before it calls an API.
// bench: iterations 128
// bench: complexity constant
autoload 'Novis\Rest' from '../../../packages/rest/src';

class Bench
{
    public static function run(uint $rounds): uint
    {
        Core\Test::answerHttp('https://login.example.com/oauth/token', 200, {
            json: ['access_token' => 'at-1', 'token_type' => 'Bearer', 'expires_in' => 600, 'scope' => 'read'],
        });
        secret string $clientSecret = 's3cret';
        Novis\Rest\Client $client = Novis\Rest\Client::confidential('https://login.example.com/oauth/token', 'shop', $clientSecret);
        array<string> $scopes = ['read', 'write', 'read write'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Novis\Rest\Token $token = $client->requestToken(['grant_type' => 'client_credentials', 'scope' => $scopes[($total % 3) as int]]);
            $total = $total + Core\Str::length($token->scope) as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(128), "\n";
