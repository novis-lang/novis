<?nvs
// Publishes a small order update to a topic, as a web request does to tell open dashboards that an order changed.
// bench: iterations 100000

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $states = ["paid", "packed", "shipped"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $reached = Core\Topic::publish("orders", ["id" => $i, "state" => $states[$total % 3]]);
            $total = $total + $reached + 1;   // chained: the next state depends on this round
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
