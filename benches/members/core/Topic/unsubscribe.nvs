<?nvs
// Leaves a chat room and joins it again, as a chat script does when a user switches rooms.
// bench: iterations 100000

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $rooms = ["room:lobby", "room:help", "room:random"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $room = $rooms[$total % 3];
            Core\Topic::subscribe($room);
            Core\Topic::unsubscribe($room);
            $total = $total + ($i % 2) + 1;   // chained: the next room depends on this round
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
