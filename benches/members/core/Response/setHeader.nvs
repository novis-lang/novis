<?nvs
// Sets one response header, as a handler does for `Cache-Control` on each request.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $values = ["no-store", "max-age=60", "max-age=300", "private"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $value = $values[$total % 4];
            Core\Response::setHeader("Cache-Control", $value);
            $total = $total + Core\Str::length($value);   // chained: the next value depends on this one
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Response::text((Bench::run(200000) as string) . "\n");
