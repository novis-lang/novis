<?nvs
// Sends a small file body with its content type, as a download endpoint does once for each request.
// bench: iterations 20000

class Bench {
    public static function run(uint $rounds): uint {
        array<bytes> $bodies = ["id,name,total" as bytes, "GIF89a" as bytes, "%PDF-1.7" as bytes];
        array<string> $types = ["text/csv; charset=utf-8", "image/gif", "application/pdf"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $k = $total % 3;
            Core\Response::bytes($bodies[$k], $types[$k]);
            $total = $total + $k + 1;   // chained: the next body depends on this one
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Response::text((Bench::run(20000) as string) . "\n");
