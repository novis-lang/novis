<?nvs
// Sends a small HTML fragment, as a page handler does once for each request.
// bench: iterations 20000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Html\Markup> $pages = [
            html`<p>Your order is on its way.</p>`,
            html`<p>Your basket is empty.</p>`,
            html`<h1>Welcome back</h1>`,
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $k = $total % 3;
            Core\Response::html($pages[$k]);
            $total = $total + $k + 1;   // chained: the next page depends on this one
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Response::text((Bench::run(20000) as string) . "\n");
