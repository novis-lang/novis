<?nvs
// Measures `Core\Response::setHeader` on one header value, at growing value lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $value = 'private, ' . Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Response::setHeader("Cache-Control", $value);
            $total = $total + Core\Str::length($value);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
