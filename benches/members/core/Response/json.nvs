<?nvs
// Sends a small JSON object, as an API endpoint does once for each request.
// bench: iterations 20000

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $k = $total % 10;
            Core\Response::json({ id: $k, ok: true });
            $total = $total + $k + 1;   // chained: the next object depends on this one
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Response::text((Bench::run(20000) as string) . "\n");
