<?nvs
// Measures `Core\Response::addCookie` on one cookie value, at growing value lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $token = Core\Str::repeat('k', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Response::addCookie("sid", $token);
            $total = $total + Core\Str::length($token) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
