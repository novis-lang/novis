<?nvs
// Sends a file from the disk as the response, as a download page does once for each request.
// bench: iterations 20000

class Bench {
    // A path in a string literal starts at the folder of this file.
    // `Bench::file` returns that full path.
    public static function file(#[Core\Path] string $path): string {
        return $path;
    }

    public static function run(uint $rounds): uint {
        array<string> $paths = [Bench::file("text.nvs"), Bench::file("json.nvs"), Bench::file("html.nvs")];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            int $k = ($total % 3) as int;
            Core\Response::sendFile($paths[$k]);
            $total = $total + ($k as uint) + 1;   // chained: the next file depends on this one
            $i = $i + 1;
        }
        return $total;
    }
}

// The result chooses the file that is sent last, so the loop cannot be skipped.
array<string> $files = [Bench::file("text.nvs"), Bench::file("json.nvs"), Bench::file("html.nvs")];
int $last = (Bench::run(20000) % 3) as int;
Core\Response::sendFile($files[$last]);
