<?nvs
// Reads the JSON body of a test response into a class, as a test does before it checks what an API sent.
// bench: iterations 100000
// bench: complexity linear

#[Core\Json\Derive]
class Product {
    public string $sku;
    public int $price;

    public function constructor(string $sku, int $price) {
        $this->sku = $sku;
        $this->price = $price;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Test\Response> $responses = [
            Core\Test::request(Core\Http\Method::Get, "/"),
            Core\Test::request(Core\Http\Method::Get, "/bbb"),
            Core\Test::request(Core\Http\Method::Get, "/cccccc"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $product = $responses[($total % 3) as int]->jsonAs<Product>();
            $total = $total + Core\Str::length($product->sku);
            $i = $i + 1;
        }
        return $total;
    }
}

// Each request runs this file again. In that run, this part sends one product.
// The `sku` has one `x` for each character of the path.
try {
    var $sku = Core\Str::repeat("x", Core\Str::length(Core\Request::path()));
    Core\Response::json(["sku" => $sku, "price" => 12]);
} catch (LogicError $noRequest) {
    echo Bench::run(100000), "\n";
}
