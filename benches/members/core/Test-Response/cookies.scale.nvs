<?nvs
// Measures `cookies` on one test response, at growing lengths of its session cookie.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Test\Response $response = Core\Test::request(Core\Http\Method::Get, '/' . Core\Str::repeat('a', $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length($response->cookies()['sid']);
            $i = $i + 1;
        }
        return $total;
    }
}

// Each request runs this file again. In that run, this part sets two cookies.
// The `sid` value has one `x` for each character of the path.
try {
    Core\Response::addCookie('theme', 'dark');
    Core\Response::addCookie('sid', Core\Str::repeat('x', Core\Str::length(Core\Request::path())));
} catch (LogicError $noRequest) {
echo Bench::run(256), "\n";
}
