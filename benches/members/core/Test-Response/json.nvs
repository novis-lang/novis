<?nvs
// Decodes the JSON body of a test response, as a test does before it checks what an API sent.
// bench: iterations 100000

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Test\Response> $responses = [
            Core\Test::request(Core\Http\Method::Get, "/"),
            Core\Test::request(Core\Http\Method::Get, "/bbb"),
            Core\Test::request(Core\Http\Method::Get, "/cccccc"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $decoded = $responses[($total % 3) as int]->json() as array<mixed>;
            $total = $total + Core\Str::length($decoded["sku"] as string);
            $i = $i + 1;
        }
        return $total;
    }
}

// Each request runs this file again. In that run, this part sends one product.
// The `sku` has one `x` for each character of the path.
try {
    var $sku = Core\Str::repeat("x", Core\Str::length(Core\Request::path()));
    Core\Response::json(["sku" => $sku, "price" => 12, "tags" => ["blue", "kitchen"]]);
} catch (LogicError $noRequest) {
    echo Bench::run(100000), "\n";
}
