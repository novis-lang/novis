<?nvs
// Checks if a result of `stat` is a file, as a program does when it copies the files of a folder.
// bench: iterations 1024
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(array<Core\IO\Metadata> $infos, uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The result asked in each round depends on the round before.
            if ($infos[($total % 2) as int]->isFile()) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

string $dir = Core\IO::temporaryDir();
string $path = Core\Path::join($dir, "is-file.dat");
Core\IO::write($path, "x");
array<Core\IO\Metadata> $infos = [Core\IO::stat($path), Core\IO::stat($dir)];
echo Bench::run($infos, 1024), "\n";
