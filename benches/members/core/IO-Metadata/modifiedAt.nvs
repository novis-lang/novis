<?nvs
// Reads the modification time from a result of `stat`, as a program does when it looks for the newest file.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(array<Core\IO\Metadata> $infos, uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The result asked in each round depends on the round before.
            Core\Time\Instant $changed = $infos[($total % 2) as int]->modifiedAt();
            if ($changed->compareTo($changed) == 0) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

string $dir = Core\IO::temporaryDir();
string $path = Core\Path::join($dir, "modified-at.dat");
Core\IO::write($path, "x");
array<Core\IO\Metadata> $infos = [Core\IO::stat($path), Core\IO::stat($dir)];
echo Bench::run($infos, 2048), "\n";
