<?nvs
// Measures `Core\Jwt::signObject` on one object, at growing lengths of the user value in it.
// bench: start 256
// bench: max 4096

#[Core\Json\Derive]
final class Access
{
    public string $sub;
    public array<string> $scopes;

    public function constructor(string $sub, array<string> $scopes)
    {
        $this->sub = $sub;
        $this->scopes = $scopes;
    }
}

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Crypto\KeyPair $pair = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519);
        Access $access = new Access(Core\Str::repeat('a', $size), ['orders:read']);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string $token = Core\Jwt::signObject($access, 1h, $pair);
            $total = $total + Core\Str::length($token);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
