<?nvs
// Measures `Core\Jwt::verifyIssued` on one token, at growing lengths of the user value in it.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Crypto\KeyPair $service = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519);
        Core\Crypto\PublicKey $public = $service->publicKey();
        string $token = Core\Jwt::signObject(
            Core\Arr::shapeAs<{iss: string, aud: string, sub: string}>([
                'iss' => 'https://login.example.com',
                'aud' => 'shop',
                'sub' => Core\Str::repeat('a', $size),
            ]),
            1h,
            $service,
        );
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            var $claims = Core\Jwt::verifyIssued<tainted {sub: string}>($token, $public, 'https://login.example.com', 'shop');
            $total = $total + Core\Str::length($claims->sub);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
