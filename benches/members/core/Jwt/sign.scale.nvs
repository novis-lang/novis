<?nvs
// Measures `Core\Jwt::sign` on one token, at growing lengths of the user value in it.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        secret bytes $key = Core\Crypto::generateKey();
        string $user = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string $token = Core\Jwt::sign(['sub' => $user, 'role' => 'editor'], 1h, $key);
            $total = $total + Core\Str::length($token);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
