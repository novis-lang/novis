<?nvs
// Measures `Core\Jwt::verify` on one token, at growing lengths of the user value in it.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        secret bytes $key = Core\Crypto::generateKey();
        string $token = Core\Jwt::sign(['sub' => Core\Str::repeat('a', $size), 'role' => 'editor'], 1h, $key);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<tainted string> $claims = Core\Jwt::verify($token, $key);
            $total = $total + Core\Str::length($claims['sub']);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
