<?nvs
// Reads the attempts of a queue from its numbers, as a health check or a status page does.
// bench: iterations 400000
// bench: allocations 0
// bench: calls 0
// bench: complexity constant
use Core\Queue;

var $db = Core\Db::connect("jobs");
var $jobs = <<<'SQL'
create table nvs_jobs (id integer primary key autoincrement, queue varchar(255) not null,
    script text not null, args text, state smallint not null, attempts integer not null,
    max_attempts integer not null, backoff_ms bigint not null, run_at bigint not null,
    tag varchar(255), dedupe_key varchar(255), dedupe_pending varchar(255),
    created_at bigint not null, claimed_at bigint, errors text, grants text, limits text,
    constraint nvs_jobs_dedupe unique (dedupe_pending))
SQL;
var $dead = <<<'SQL'
create table nvs_dead_jobs (id bigint not null, queue varchar(255) not null,
    script text not null, args text, attempts integer not null, max_attempts integer not null,
    backoff_ms bigint not null, run_at bigint not null, tag varchar(255),
    dedupe_key varchar(255), created_at bigint not null, failed_at bigint not null,
    errors text not null, primary key (id))
SQL;
$db->execute($jobs, []);
$db->execute($dead, []);

class Bench {
    public static function run(array<Core\Queue\Stats> $all, uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The next result depends on the attempts counted so far.
            $total = $total + $all[($total % 2) as int]->attempts();
            $i = $i + 1;
        }
        return $total;
    }
}

// `mail` has used 3 attempts and `exports` has used 2.
Queue::push("jobs/send-mail.nvs", {queue: "mail"});
Queue::push("jobs/export.nvs", {queue: "exports"});
$db->execute("update nvs_jobs set attempts = 3 where queue = 'mail'", []);
$db->execute("update nvs_jobs set attempts = 2 where queue = 'exports'", []);

// The first round reads `mail`. The total is then odd, so every later round reads `exports`.
// The program prints `800001`.
echo Bench::run([Queue::stats("mail"), Queue::stats("exports")], 400000), "\n";
