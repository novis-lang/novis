<?nvs
// Measures reading one short compressed record back. A program meets this every
// time it reads a value out of a cache that keeps its entries compressed.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<bytes> $frames = [
            Core\Compress::compress('{"id":1042,"city":"Berlin","state":"shipped"}', Core\Codec::Zstd),
            Core\Compress::compress('{"id":1043,"city":"Lisbon","state":"packed"}', Core\Codec::Zstd),
            Core\Compress::compress('{"id":1044,"city":"Oslo","state":"paid"}', Core\Codec::Zstd),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The frame of each round is chosen by the round before it, so no
            // round can be left out.
            bytes $record = Core\Compress::decompress($frames[($total % 3) as int], Core\Codec::Zstd);
            $total = $total + Core\Bytes::length($record);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
