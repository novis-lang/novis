<?nvs
// Measures `Core\Compress::compress` on one record, at growing record sizes.
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): uint
    {
        bytes $record = Core\Str::repeat('{"id":1042}', $size) as bytes;
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Bytes::length(Core\Compress::compress($record, Core\Codec::Zstd));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
