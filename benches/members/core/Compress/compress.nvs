<?nvs
// Measures compressing one short record. A program meets this every time it
// puts a value in a cache or writes one to a log that is kept compressed.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<bytes> $records = [
            '{"id":1042,"city":"Berlin","state":"shipped"}' as bytes,
            '{"id":1043,"city":"Lisbon","state":"packed"}' as bytes,
            '{"id":1044,"city":"Oslo","state":"paid"}' as bytes,
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The record of each round is chosen by the round before it, so no
            // round can be left out.
            bytes $frame = Core\Compress::compress($records[($total % 3) as int], Core\Codec::Zstd);
            $total = $total + Core\Bytes::length($frame);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
