<?nvs
// Makes a key from another service's public key, as a program does before it encrypts a message for that service.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Crypto\PublicKey> $publics = [
            Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519)->publicKey(),
            Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256)->publicKey(),
            Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519)->publicKey(),
        ];
        Core\Jwe\Key $last = Core\Jwe\Key::recipient($publics[0]);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The public key of each round is chosen by the round before, so no round can be left out.
            Core\Jwe\Key $key = Core\Jwe\Key::recipient($publics[($total % 3) as int]);
            $total = $total + ((($key == $last) ? 2 : 1) as uint);
            $last = $key;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
