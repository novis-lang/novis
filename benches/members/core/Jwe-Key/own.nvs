<?nvs
// Makes a key from a program's own key pair, as a server does before it decrypts a message sent to it.
// bench: iterations 200000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Crypto\KeyPair> $pairs = [
            Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519),
            Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256),
            Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519),
        ];
        Core\Jwe\Key $last = Core\Jwe\Key::own($pairs[0]);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The key pair of each round is chosen by the round before, so no round can be left out.
            Core\Jwe\Key $key = Core\Jwe\Key::own($pairs[($total % 3) as int]);
            $total = $total + ((($key == $last) ? 2 : 1) as uint);
            $last = $key;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
