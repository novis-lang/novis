<?nvs
// Makes a key from a password, as a program does before it encrypts or decrypts a file with that password.
// bench: iterations 200000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $passwords = ["blue-river-42", "green tea at noon", "correct horse battery staple"];
        Core\Jwe\Key $last = Core\Jwe\Key::password($passwords[0]);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The password of each round is chosen by the round before, so no round can be left out.
            Core\Jwe\Key $key = Core\Jwe\Key::password($passwords[($total % 3) as int]);
            $total = $total + ((($key == $last) ? 2 : 1) as uint);
            $last = $key;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
