<?nvs
// Measures `Core\Jwe\Key::password` on one password, at growing password lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $password = Core\Str::repeat('a', $size);
        Core\Jwe\Key $last = Core\Jwe\Key::password($password);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Jwe\Key $key = Core\Jwe\Key::password($password);
            $total = $total + ((($key == $last) ? 2 : 1) as uint);
            $last = $key;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
