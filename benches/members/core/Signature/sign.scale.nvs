<?nvs
// Measures `Core\Signature::sign` on one value, at growing value lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<secret bytes> $keys = [Core\Crypto::generateKey()];
        string $doc = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string $token = Core\Signature::sign(["doc" => $doc, "act" => "download"], { keys: $keys, until: null });
            $total = $total + Core\Str::length($token) % 7 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
