<?nvs
// Measures `Core\Signature::verify` on one signed token, at growing token lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<secret bytes> $keys = [Core\Crypto::generateKey()];
        string $token = Core\Signature::sign(["doc" => Core\Str::repeat('a', $size), "act" => "download"], { keys: $keys, until: null });
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<tainted string> $back = Core\Signature::verify($token, $keys);
            $total = $total + Core\Str::length($back["act"]) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
