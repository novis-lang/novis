<?nvs
// Measures `Core\Router::urlAbsolute` on one link, at growing lengths of the value in the link.
// bench: start 256
// bench: max 4096

class Pages {
    #[Core\Route(path: "/pages/{slug}", method: Core\Http\Method::Get, name: "Pages::show")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(string $slug): string { return "one page"; }
}

class Bench
{
    public static function run(uint $size): uint
    {
        string $slug = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string $link = Core\Router::urlAbsolute("Pages::show", ["slug" => $slug]);
            $total = $total + Core\Str::length($link) % 7 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
