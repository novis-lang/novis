<?nvs
// Builds a signed download link for a file, as a page does for each file it lists.
// bench: iterations 100000

class Files {
    #[Core\Route(path: "/files/{id}", method: Core\Http\Method::Get, name: "Files::download")]
    #[Core\Access(allow: Core\Audience::Public)]
    public function download(uint $id): string { return "one file"; }
}

class Bench {
    public static function run(uint $rounds): uint {
        secret bytes $key = Core\Crypto::generateKey();
        array<secret bytes> $keys = [$key];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $link = Core\Router::urlSigned("Files::download", ["id" => $total % 1000], {keys: $keys, until: null});
            // chained: the next id depends on this result
            $total = $total + Core\Str::length($link) % 7 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
