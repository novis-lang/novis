<?nvs
// Measures how the content of an attachment is read, as a program does to check its size before sending.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Attachment;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Attachment> $files = [
            Attachment::fromBytes('a.bin', 'x'),
            Attachment::fromBytes('b.bin', 'xxxx'),
            Attachment::fromBytes('c.bin', 'xxxxxxx'),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round adds the counter to the total so far. The result picks one of the three files.
            $total = $total + Core\Bytes::length($files[(($total + $i) % 3) as int]->bytes());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
