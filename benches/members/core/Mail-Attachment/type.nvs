<?nvs
// Measures how the type of an attachment is read, as a test does for each file of a sent mail.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Attachment;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Attachment> $files = [
            Attachment::fromBytes('a.jpg', 'x', { type: 'image/jpeg' }),
            Attachment::fromBytes('b.txt', 'x', { type: 'text/plain' }),
            Attachment::fromBytes('c.mp3', 'x', { type: 'audio/mpeg' }),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The round before and the counter choose the file.
            $total = $total + Core\Str::length($files[(($total + $i) % 3) as int]->type());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
