<?nvs
// Measures how a small image is read from the disk as an inline image, as a mail with a logo does.
// bench: iterations 256
// bench: complexity constant

use Core\Bytes;
use Core\Mail\Attachment;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The file is chosen by the round before. Each one is a few hundred bytes.
            Attachment $image = $total % 3 == 1
                ? Attachment::inlineFile('files/logo.png')
                : Attachment::inlineFile('files/invoice.pdf', { type: 'image/png' });
            $total = $total + Bytes::length($image->bytes());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
