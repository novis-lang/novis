<?nvs
// Measures how a program checks whether an attachment is an inline image (an image shown inside the mail), as a loop over attachments does.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Attachment;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Attachment> $parts = [
            Attachment::inlineBytes('logo.png', 'pixel', { type: 'image/png' }),
            Attachment::fromBytes('invoice.pdf', 'x'),
            Attachment::inlineBytes('banner.png', 'pixel', { type: 'image/png' }),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round adds the counter to the total so far. The result picks one of the three attachments.
            $total = $total + ($parts[(($total + $i) % 3) as int]->isInline() ? 1 : 4) as uint;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
