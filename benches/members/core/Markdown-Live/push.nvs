<?nvs
// Measures pushing one short line of a model's answer, as a chat server does for each piece it receives.
// bench: iterations 256
// bench: calls 4
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $lines = ["Your order has *shipped*.\n\n", "- the parcel arrives on **Tuesday**\n", "Thanks for all your patience.\n\n"];
        Core\Markdown\Live $live = Core\Markdown::live();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The line pushed in each round is chosen by the HTML of the round before it, so no round can be left out.
            Core\Markdown\Update $update = $live->push($lines[($total % 3) as int]);
            $total = $total + Core\Str::length(Core\Html::toSource($update->open(), 'the bench counts the HTML')) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
