<?nvs
// Sorts a few orders into groups by their state, as a page does before it shows what is waiting.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $orders = ["paid", "open", "paid"];
        array<string> $prefixes = ["x-", "y-", "z-"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The prefix comes from last round's result, so no round can be reused.
            string $prefix = $prefixes[($total % 3) as int];
            array<array<string>> $byState = Core\Arr::groupBy($orders, fn(string $state)
                => $prefix . $state);
            $total = $total + Core\Arr::count($byState);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
