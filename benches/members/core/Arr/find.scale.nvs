<?nvs
// Measures `Core\Arr::find` on one list of numbers with no match, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $stock = Core\Arr::range(1, $size as int);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            int $limit = -1 - (($total % 3) as int);
            ?int $low = Core\Arr::find($stock, fn(int $n) => $n <= $limit);
            if ($low == null) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
