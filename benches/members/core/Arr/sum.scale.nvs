<?nvs
// Measures `Core\Arr::sum` on one list of invoice lines, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): int
    {
        array<int> $lines = Core\Arr::range(1, $size as int);
        int $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $lines[0] = $total % 7 + 1;
            $total = $total + (Core\Arr::sum($lines) as int) % 1000;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
