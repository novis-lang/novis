<?nvs
// Measures `Core\Arr::range` building one list of numbers, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): int
    {
        int $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<int> $pages = Core\Arr::range($total % 7 + 1, $total % 7 + ($size as int));
            $total = $total + $pages[3];
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
