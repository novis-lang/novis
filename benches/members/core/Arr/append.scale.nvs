<?nvs
// Measures `Core\Arr::append` on one list of numbers, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $row = Core\Arr::range(1, $size as int);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<int> $grown = Core\Arr::append($row, ($total % 7) as int);
            $total = $total + Core\Arr::count($grown);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
