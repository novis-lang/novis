<?nvs
// Reads the lowest price of a short list, as a shop does before it shows the
// cheapest offer on a page.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The first price is last round's total, so no round can be reused.
            array<int> $prices = [($total % 7) + 1, 30, 10, 20, 40, 25];
            $total = $total + (Core\Arr::min($prices) ?? 0);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
