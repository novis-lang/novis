<?nvs
// Measures `Core\Arr::fill` building one row of cells, at growing row lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<uint> $cells = Core\Arr::fill($size, $total % 7 + 1);
            $total = $total + $cells[3];
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
