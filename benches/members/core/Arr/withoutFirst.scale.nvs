<?nvs
// Measures `Core\Arr::withoutFirst` on one list of numbers, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $lines = Core\Arr::range(1, $size as int);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $lines[1] = ($total % 7) as int;
            array<int> $rest = Core\Arr::withoutFirst($lines);
            $total = $total + ($rest[1] as uint) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
