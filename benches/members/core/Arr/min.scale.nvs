<?nvs
// Measures `Core\Arr::min` on one list of prices, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): int
    {
        array<int> $prices = Core\Arr::range(1, $size as int);
        int $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $prices[0] = $total % 7 + 1;
            $total = $total + (Core\Arr::min($prices) ?? 0);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
