<?nvs
// Picks the first article in a small basket whose stock is below a limit, as a shop does before it shows the basket.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): uint {
        array<int> $stock = [4, 0, 7, 2];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            int $limit = (($total % 3) as int) - 1;
            ?int $low = Core\Arr::find($stock, fn(int $n) => $n <= $limit);   // chained: $limit is last round's
            if ($low == null) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
