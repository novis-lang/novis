<?nvs
// Measures `Core\Arr::flatten` on one list of tag lists, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<array<string>> $tags = Core\Arr::map(
            Core\Arr::range(1, $size as int),
            fn(int $n): array<string> => ['news', 'intro'],
        );
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<string> $all = Core\Arr::flatten($tags);
            $total = $total + Core\Arr::count($all);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
