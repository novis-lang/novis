<?nvs
// Measures `Core\Arr::keyOf` on one keyed array that does not have the value, at growing array sizes.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $numbers = Core\Arr::range(1, $size as int);
        array<string> $names = Core\Arr::map($numbers, fn(int $n): string => "r" . ($n as string));
        array<string> $paths = Core\Arr::map($numbers, fn(int $n): string => "/p" . ($n as string));
        array<string> $routes = Core\Arr::fromKeysAndValues($names, $paths);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            if (Core\Arr::keyOf($routes, "/cart") == null) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
