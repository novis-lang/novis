<?nvs
// Combines a configuration tree with the settings of the machine it runs on,
// as a program does while it starts up.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): int {
        array<array<int>> $shipped = [
            "db" => ["port" => 5432, "pool" => 10],
            "log" => ["level" => 1, "days" => 7],
        ];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Last round's total decides the layer, so no round can be reused.
            array<array<int>> $machine = ["db" => ["port" => 6000 + $total % 9]];
            array<array<int>> $config = Core\Arr::overlayDeep($shipped, $machine);
            $total = $total + $config["db"]["port"] + $config["log"]["days"];
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
