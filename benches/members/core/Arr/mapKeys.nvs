<?nvs
// Stores a few order codes under a key of their own, as a program does after it reads rows.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $codes = ["a-350", "a-420", "a-90"];
        array<string> $prefixes = ["x-", "y-", "z-"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The prefix comes from last round's result, so no round can be reused.
            string $prefix = $prefixes[($total % 3) as int];
            array<string> $byCode = Core\Arr::mapKeys($codes, fn(string $code) => $prefix . $code);
            $total = $total + Core\Arr::count($byCode);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
