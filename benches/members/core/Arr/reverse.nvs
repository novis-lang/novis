<?nvs
// Turns a list of events into newest-first order. A page does this before it
// shows a history.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $events = [
            'signed up', 'paid', 'shipped', 'delivered', 'reviewed', 'returned',
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<string> $newest = Core\Arr::reverse($events);
            // Last round's total decides which entry this round reads, so no
            // round can be reused.
            $total = $total + Core\Str::length($newest[($total % 6) as int]);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
