<?nvs
// Measures `Core\Arr::isList` on one list of names, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<string> $colours = Core\Arr::map(Core\Arr::range(1, $size as int), fn(int $n): string => "red");
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            if (Core\Arr::isList($colours)) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
