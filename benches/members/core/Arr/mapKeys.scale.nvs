<?nvs
// Measures `Core\Arr::mapKeys` on one list of order codes, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<string> $codes = Core\Arr::map(Core\Arr::range(1, $size as int), fn(int $n): string => "a-" . ($n as string));
        array<string> $prefixes = ["x-", "y-", "z-"];
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string $prefix = $prefixes[($total % 3) as int];
            array<string> $byCode = Core\Arr::mapKeys($codes, fn(string $code) => $prefix . $code);
            $total = $total + Core\Arr::count($byCode);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
