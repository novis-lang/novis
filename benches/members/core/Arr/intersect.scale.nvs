<?nvs
// Measures `Core\Arr::intersect` on two lists of numbers, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $needed = Core\Arr::range(1, $size as int);
        array<int> $granted = Core\Arr::range(2, $size as int);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<int> $allowed = Core\Arr::intersect($needed, $granted);
            $total = $total + Core\Arr::count($allowed);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
