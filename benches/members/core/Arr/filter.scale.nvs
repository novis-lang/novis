<?nvs
// Measures `Core\Arr::filter` on one list of numbers, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $basket = Core\Arr::range(1, $size as int);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            int $limit = ($total % 3) as int;
            array<int> $kept = Core\Arr::filter($basket, fn(int $n) => $n > $limit);
            $total = $total + Core\Arr::count($kept);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
