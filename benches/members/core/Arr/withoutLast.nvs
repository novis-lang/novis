<?nvs
// Drops the last entry of a short list, as a program does when it takes back the newest entry.
// bench: iterations 200000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<int> $lines = [10, 20, 30, 40];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The first entry is last round's total, and the call keeps it, so
            // no round can be reused.
            $lines[0] = ($total % 7) as int;
            array<int> $rest = Core\Arr::withoutLast($lines);
            $total = $total + ($rest[0] as uint) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
