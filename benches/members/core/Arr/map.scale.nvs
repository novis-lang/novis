<?nvs
// Measures `Core\Arr::map` on one list of prices, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $prices = Core\Arr::range(1, $size as int);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            int $fee = ($total % 3) as int;
            array<int> $charged = Core\Arr::map($prices, fn(int $cents): int => $cents + $fee);
            $total = $total + (($charged[0] % 7) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
