<?nvs
// Measures `Core\Arr::product` on one list of numbers, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): int
    {
        array<int> $counts = Core\Arr::map(Core\Arr::range(1, $size as int), fn(int $n): int => 1);
        int $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $counts[0] = $total % 3 + 1;
            $total = $total + (Core\Arr::product($counts) as int);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
