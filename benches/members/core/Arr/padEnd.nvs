<?nvs
// Adds entries at the end of a short list until it has a fixed length, as a report does before it writes a row.
// bench: iterations 200000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<int> $row = [7, 8, 9];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The value added is last round's total, so no round can be reused.
            array<int> $padded = Core\Arr::padEnd($row, 6, ($total % 7) as int);
            $total = $total + ($padded[5] as uint) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
