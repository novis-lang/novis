<?nvs
// Splits a list of products into rows of two. A page does this when it lays the
// products out in a grid.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $products = [
            'Keyboard', 'Lamp', 'Monitor', 'Mouse', 'Notebook', 'Pen',
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<array<string>> $rows = Core\Arr::chunk($products, 2);
            // Last round's total decides which row this round measures, so no
            // round can be reused.
            $total = $total + Core\Str::length(Core\Arr::first($rows[($total % 3) as int]) ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
