<?nvs
// Finds the name of the first sensor whose reading is below a limit, as a monitor does on every round.
// bench: iterations 200000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<int> $readings = ["north" => 4, "south" => 0, "east" => 7, "west" => 2];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            int $limit = (($total % 3) as int) - 1;
            ?string $name = Core\Arr::findKey($readings, fn(int $n) => $n <= $limit);   // chained: $limit is last round's
            if ($name == null) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
