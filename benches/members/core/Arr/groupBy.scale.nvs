<?nvs
// Measures `Core\Arr::groupBy` on one list of order states, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<string> $orders = Core\Arr::map(
            Core\Arr::range(1, $size as int),
            fn(int $n): string => $n % 2 == 0 ? "paid" : "open",
        );
        array<string> $prefixes = ["x-", "y-", "z-"];
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string $prefix = $prefixes[($total % 3) as int];
            array<array<string>> $byState = Core\Arr::groupBy($orders, fn(string $state)
                => $prefix . $state);
            $total = $total + Core\Arr::count($byState);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
