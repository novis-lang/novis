<?nvs
// Measures `Core\Arr::appendAll` on one list of numbers, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $page = Core\Arr::range(1, $size as int);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<int> $extra = [($total % 7) as int, 7];
            array<int> $joined = Core\Arr::appendAll($page, $extra);
            $total = $total + Core\Arr::count($joined);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
