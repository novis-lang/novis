<?nvs
// Measures `Core\Arr::max` on one list of bids, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): int
    {
        array<int> $bids = Core\Arr::range(1, $size as int);
        int $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $bids[0] = $total % 7;
            $total = $total + (Core\Arr::max($bids) ?? 0);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
