<?nvs
// Takes the id out of every row of a query result. A page does this before it
// asks another table for the rows that belong to them.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<array<string>> $rows = [
            ['id' => '7', 'name' => 'Ada'],
            ['id' => '9', 'name' => 'Bo'],
            ['id' => '12', 'name' => 'Cy'],
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<string> $ids = Core\Arr::column($rows, 'id');
            // Last round's total decides which id this round reads, so no round
            // can be reused.
            $total = $total + Core\Str::length($ids[$total % 3]);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
