<?nvs
// Finds which of the permissions a request needs the user also has. A program
// does this on every request that checks access.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<uint> $needed = [1, 2, 3, 4, 5, 6];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Last round's total decides the second list, so no round can be reused.
            array<uint> $granted = [$total % 7, 6];
            array<uint> $allowed = Core\Arr::intersect($needed, $granted);
            $total = $total + Core\Arr::count($allowed);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
