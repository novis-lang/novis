<?nvs
// Measures `Core\Arr::contains` on one list of names that does not have the value, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<string> $allowed = Core\Arr::map(Core\Arr::range(1, $size as int), fn(int $n): string => "role" . ($n as string));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            if (Core\Arr::contains($allowed, "guest")) {
                $total = $total + 2;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
