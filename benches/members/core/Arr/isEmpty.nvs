<?nvs
// Tests whether a basket is empty, as a page does before it draws the basket.
// bench: iterations 400000
// bench: allocations 0
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<uint> $filled = [1, 2, 3];
        array<uint> $empty = [];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Last round's total decides which array this round tests, so no
            // round can be reused.
            if ($total % 2 == 0) {
                if (Core\Arr::isEmpty($filled)) {
                    $total = $total + 2;
                } else {
                    $total = $total + 1;
                }
            } else {
                if (Core\Arr::isEmpty($empty)) {
                    $total = $total + 3;
                } else {
                    $total = $total + 4;
                }
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
