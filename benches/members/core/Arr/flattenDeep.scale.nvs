<?nvs
// Measures `Core\Arr::flattenDeep` on one menu with menus inside it, at growing menu sizes.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<mixed> $menu = Core\Arr::map(
            Core\Arr::range(1, $size as int),
            fn(int $n): mixed => ['Shop', ['Shoes', 'Shirts']],
        );
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count(Core\Arr::flattenDeep($menu));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
