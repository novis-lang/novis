<?nvs
// Finds which requested items a second list does not have. A program does
// this when it checks an order against what is in stock.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<uint> $requested = [1, 2, 3, 4, 5, 6];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Last round's total decides the second list, so no round can be reused.
            array<uint> $inStock = [$total % 7, 6];
            array<uint> $missing = Core\Arr::diff($requested, $inStock);
            $total = $total + Core\Arr::count($missing);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
