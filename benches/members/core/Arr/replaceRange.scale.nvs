<?nvs
// Measures `Core\Arr::replaceRange` replacing one item of a list, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<string> $basket = Core\Arr::map(Core\Arr::range(1, $size as int), fn(int $n): string => "tea");
        array<string> $instead = ['oat drink'];
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<string> $updated = Core\Arr::replaceRange($basket, ($total % 3) as int, 1, $instead);
            $total = $total + Core\Arr::count($updated);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
