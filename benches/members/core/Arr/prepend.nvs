<?nvs
// Puts one value in front of a short list, as a program does when it adds an entry above a menu.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): uint {
        array<int> $menu = [10, 20, 30];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The value put in front is last round's total, so no round can be reused.
            array<int> $longer = Core\Arr::prepend($menu, ($total % 7) as int);
            $total = $total + Core\Arr::count($longer);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
