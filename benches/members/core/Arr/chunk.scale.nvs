<?nvs
// Measures `Core\Arr::chunk` on one list of names, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<string> $products = Core\Arr::map(Core\Arr::range(1, $size as int), fn(int $n): string => "item");
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<array<string>> $rows = Core\Arr::chunk($products, 2);
            $total = $total + Core\Arr::count($rows);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
