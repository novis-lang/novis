<?nvs
// Measures `Core\Arr::fillKeys` on one list of field names, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<string> $fields = Core\Arr::map(Core\Arr::range(1, $size as int), fn(int $n): string => "f" . ($n as string));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<uint> $form = Core\Arr::fillKeys($fields, $total % 7 + 1);
            $total = $total + $form['f3'];
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
