<?nvs
// Runs two small tasks at the same time and reads both results, as a page does when it loads two things at once.
// bench: iterations 20000

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["order", "customer", "shipping address"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $name = $names[($total % 3) as int];
            var $page = Core\Task::all({
                size:  fn (): uint => Core\Str::length($name),
                round: fn (): uint => $i % 5,
            });
            $total = $total + $page->size + $page->round;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
