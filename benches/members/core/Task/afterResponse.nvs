<?nvs
// Adds a callable to run after the response and runs it, as a program does to send a receipt.
// bench: iterations 20000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $receipts = ["order 1042", "order 1043", "invoice 77"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $receipt = $receipts[($total % 3) as int];
            Core\Task::afterResponse(fn (): void => {
                uint $size = Core\Str::length($receipt);
            });
            $total = $total + Core\Str::length($receipt) % ($i % 3 + 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
