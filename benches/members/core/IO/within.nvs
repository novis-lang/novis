<?nvs
// Checks that a file name stays inside a folder, as a program does before it opens a file a visitor asked for.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(string $folder, uint $rounds): uint {
        array<string> $names = ["invoice-17.pdf", "photos/cat.jpg", "photos/../notes.txt"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round picks its name from the last round's total, so no round can be left out.
            $total = $total + Core\Str::length(Core\IO::within($folder, $names[($total % 3) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

string $folder = Core\IO::temporaryDir();
Core\IO::makeDir(Core\Path::join($folder, "photos"));
echo Bench::run($folder, 256) > 0 ? "done" : "no path was checked", "\n";
