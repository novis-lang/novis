<?nvs
// Makes sure a folder exists, as a program does each time before it writes a file into it.
// bench: iterations 256
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\IO::temporaryDir();
        array<string> $folders = [
            Core\Path::join($dir, "cache", "views"),
            Core\Path::join($dir, "cache", "data"),
            Core\Path::join($dir, "logs"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The folder in each round depends on the round before, so no round can be left out.
            string $folder = $folders[($total % 3) as int];
            Core\IO::makeDir($folder);
            $total = $total + Core\Str::length($folder) % 5 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256) > 0 ? "done" : "no folder was made", "\n";
