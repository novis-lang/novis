<?nvs
// Checks whether a path can be read, as a program does before it opens an optional settings file.
// bench: iterations 5000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\IO::temporaryDir();
        Core\IO::write(Core\Path::join($dir, "a.txt"), "x");
        array<string> $paths = [
            Core\Path::join($dir, "a.txt"),
            $dir,
            Core\Path::join($dir, "missing"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The path in each round depends on the round before, so no round can be left out.
            if (Core\IO::isReadable($paths[(($total + $i) % 3) as int])) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(5000) > 0 ? "done" : "nothing readable", "\n";
