<?nvs
// Reads when a file was last changed, as a program does before it decides to rebuild a cache.
// bench: iterations 256
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): int {
        string $dir = Core\IO::temporaryDir();
        array<string> $paths = [
            Core\Path::join($dir, "template.txt"),
            Core\Path::join($dir, "style.css"),
            Core\Path::join($dir, "config.toml"),
        ];
        Core\IO::write($paths[0], "a");
        Core\IO::write($paths[1], "b");
        Core\IO::write($paths[2], "c");
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            // The path in each round depends on the round before, so no round can be left out.
            Core\Time\Instant $changed = Core\IO::modifiedAt($paths[$total % 3]);
            $total = $total + 1 + $changed->toEpochSeconds() % 2;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256) > 0 ? "done" : "no file was read", "\n";
