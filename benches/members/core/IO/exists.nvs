<?nvs
// Checks whether a path exists, as a program does before it reads a settings file.
// bench: iterations 256
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\IO::temporaryDir();
        Core\IO::write(Core\Path::join($dir, "app.ini"), "x");
        array<string> $paths = [
            Core\Path::join($dir, "app.ini"),
            Core\Path::join($dir, "local.ini"),
            $dir,
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The path in each round depends on the round before, so no round can be left out.
            if (Core\IO::exists($paths[(($total + $i) % 3) as int])) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256) > 0 ? "done" : "nothing found", "\n";
