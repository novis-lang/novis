<?nvs
// Checks whether a path is a file, as a program does for each name in a folder it reads.
// bench: iterations 5000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\IO::temporaryDir();
        Core\IO::write(Core\Path::join($dir, "a.txt"), "x");
        Core\IO::makeDir(Core\Path::join($dir, "archive"));
        array<string> $paths = [
            Core\Path::join($dir, "a.txt"),
            Core\Path::join($dir, "archive"),
            Core\Path::join($dir, "missing.txt"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The path in each round depends on the round before, so no round can be left out.
            if (Core\IO::isFile($paths[(($total + $i) % 3) as int])) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(5000) > 0 ? "done" : "no file found", "\n";
