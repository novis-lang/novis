<?nvs
// Reads the size of a file, as a program does before it accepts an upload or rotates a log.
// bench: iterations 5000
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\IO::temporaryDir();
        array<string> $paths = [
            Core\Path::join($dir, "small.txt"),
            Core\Path::join($dir, "medium.txt"),
            Core\Path::join($dir, "large.txt"),
        ];
        Core\IO::write($paths[0], "x");
        Core\IO::write($paths[1], Core\Str::repeat("x", 100));
        Core\IO::write($paths[2], Core\Str::repeat("x", 10000));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The path in each round depends on the round before, so no round can be left out.
            $total = $total + Core\IO::size($paths[($total % 3) as int]);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(5000) > 0 ? "done" : "every file was empty", "\n";
