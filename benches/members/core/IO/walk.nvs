<?nvs
// Walks a small folder tree, as a program does when it looks for every template or upload below a folder.
// bench: iterations 2000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\Path::join(Core\IO::temporaryDir(), "templates");
        array<string> $roots = [
            Core\Path::join($dir, "mail"),
            Core\Path::join($dir, "pages"),
            Core\Path::join($dir, "admin"),
        ];
        foreach ($roots as string $made) {
            Core\IO::makeDir(Core\Path::join($made, "parts"));
            Core\IO::write(Core\Path::join($made, "a.html"), "a");
            Core\IO::write(Core\Path::join($made, "parts", "b.html"), "b");
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The tree in each round depends on the round before, so no round can be left out.
            string $root = $roots[($total % 3) as int];
            foreach (Core\IO::walk($root) as string $entry) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2000) > 0 ? "done" : "no entry was found", "\n";
