<?nvs
// Measures `Core\IO::copy` on one file, at growing file sizes.
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): uint
    {
        string $dir = Core\IO::temporaryDir();
        string $from = Core\Path::join($dir, 'a.ini');
        string $to = Core\Path::join($dir, 'copy.ini');
        Core\IO::write($from, Core\Str::repeat('a', $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\IO::copy($from, $to);
            $total = $total + Core\IO::size($to);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
