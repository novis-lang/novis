<?nvs
// Saves a short text to a file, as a program does when it stores a status or a small cache entry.
// bench: iterations 5000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $texts = ["ok\n", "pending\n", "the job is done\n"];
        string $path = Core\Path::join(Core\IO::temporaryDir(), "bench-status.txt");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The text in each round depends on the round before, so no round can be left out.
            string $text = $texts[(($total + $i) % 3) as int];
            Core\IO::write($path, $text);
            $total = $total + Core\Str::length($text);
            $i = $i + 1;
        }
        // The file has only the last text.
        return Core\IO::size($path) + $total;
    }
}

echo Bench::run(5000) > 0 ? "done" : "nothing was written", "\n";
