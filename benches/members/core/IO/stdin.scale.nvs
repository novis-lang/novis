<?nvs
// Prints the standard input for the `Core\IO::stdin` bench, with `$size` lines of orders.
// bench: prints
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): string
    {
        array<string> $orders = Core\Arr::map(Core\Arr::range(1, $size as int), fn(int $n): string => 'order-' . ($n as string) . ';customer-' . (($n % 100) as string) . ';' . (($n * 37) as string));
        return "// scaling: file stdin.in\n" . Core\Str::join($orders, "\n") . "\n";
    }
}

echo Bench::run(256);
