<?nvs
// Reads a short file whole, as a program does with a template or a small settings file.
// bench: iterations 5000

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\IO::temporaryDir();
        array<string> $files = [
            Core\Path::join($dir, "greeting.txt"),
            Core\Path::join($dir, "footer.html"),
            Core\Path::join($dir, "settings.env"),
        ];
        Core\IO::write($files[0], "Hello {name},\nyour order is on its way.\n");
        Core\IO::write($files[1], "<footer>Shop Ltd, 1 Main Street</footer>\n");
        Core\IO::write($files[2], "DEBUG=0\nPORT=8080\nHOST=localhost\n");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The file in each round depends on the round before, so no round can be left out.
            $total = $total + Core\Str::length(Core\IO::read($files[($total % 3) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(5000) > 0 ? "done" : "no file was read", "\n";
