<?nvs
// Lists the files in a small folder, as a program does when it looks for new uploads or old logs.
// bench: iterations 2000

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\Path::join(Core\IO::temporaryDir(), "uploads");
        array<string> $folders = [
            Core\Path::join($dir, "new"),
            Core\Path::join($dir, "done"),
            Core\Path::join($dir, "failed"),
        ];
        foreach ($folders as string $made) {
            Core\IO::makeDir($made);
            Core\IO::write(Core\Path::join($made, "a.txt"), "a");
            Core\IO::write(Core\Path::join($made, "b.txt"), "b");
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The folder in each round depends on the round before, so no round can be left out.
            string $folder = $folders[($total % 3) as int];
            $total = $total + Core\Arr::count(Core\IO::list($folder));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2000) > 0 ? "done" : "no file was listed", "\n";
