<?nvs
// Reads a list of 2000 orders from standard input in pieces, as a checksum or upload tool does.
// bench: iterations 1
// bench: complexity linear

class Bench
{
    public static function run(): uint
    {
        // The input is the file `stdinStream.in` beside this one. It can be read only once.
        uint $total = 0;
        foreach (Core\IO::stdinStream() as tainted bytes $piece) {
            $total = $total + Core\Bytes::length($piece);
        }
        return $total;
    }
}

echo Bench::run() > 0 ? 'done' : 'no input was read', "\n";
