<?nvs
// Measures `Core\IO::read` on one file, at growing file sizes.
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): uint
    {
        string $file = Core\Path::join(Core\IO::temporaryDir(), 'greeting.txt');
        Core\IO::write($file, Core\Str::repeat('a', $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\IO::read($file));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
