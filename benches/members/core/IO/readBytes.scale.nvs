<?nvs
// Measures `Core\IO::readBytes` on one binary file, at growing file sizes.
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): uint
    {
        string $file = Core\Path::join(Core\IO::temporaryDir(), 'picture.bin');
        Core\IO::write($file, Core\Bytes::repeat(Core\Encoding::fromHex('89'), $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Bytes::length(Core\IO::readBytes($file));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
