<?nvs
// Measures how fast `with` makes a changed copy of a group type, as a program does before it changes a group.
// bench: iterations 400000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $found = $corp->read('CN=Newsletter,OU=Company,DC=example,DC=test', { select: ['groupType'] })?->groupType();
        if ($found == null) {
            return 0;
        }
        Core\Ldap\Ad\GroupType $type = $found;
        // Each round sets the flag from the total of the round before, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if ($type->with({ security: $total % 2 == 0 })->security()) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
