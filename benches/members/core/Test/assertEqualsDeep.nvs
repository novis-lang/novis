<?nvs
// Compares a small order object with its lines, as a test does after it builds one.
// bench: iterations 20000

class Line {
    public function constructor(public string $sku, public int $quantity) {}
}

class Order {
    public function constructor(public string $customer, public array<Line> $lines) {}
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Order> $orders = [
            new Order("customer-1", [new Line("tea", 2), new Line("cup", 1)]),
            new Order("customer-2", [new Line("pot", 1)]),
            new Order("customer-3", [new Line("tea", 1), new Line("cup", 4), new Line("pot", 1)]),
        ];
        array<Order> $copies = [
            new Order("customer-1", [new Line("tea", 2), new Line("cup", 1)]),
            new Order("customer-2", [new Line("pot", 1)]),
            new Order("customer-3", [new Line("tea", 1), new Line("cup", 4), new Line("pot", 1)]),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $index = $total % 3;
            Core\Test::assertEqualsDeep($orders[$index], $copies[$index]);
            $total = $total + 1 + ($total % 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
