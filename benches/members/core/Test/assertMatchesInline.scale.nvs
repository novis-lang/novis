<?nvs
// Measures `Core\Test::assertMatchesInline` checking one string against its snapshot, at growing string lengths.
// bench: start 32
// bench: max 512

class Bench
{
    public static function run(uint $size): uint
    {
        string $value = Core\Str::repeat('a', $size);
        string $snapshot = 'string(' . $size . ') "' . $value . '"';
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Test::assertMatchesInline($value, $snapshot);
            $total = $total + 1 + ($total % 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
