<?nvs
// Builds a test double from closures and calls it once, as a test does before it runs the code.
// bench: iterations 20000

interface Clock {
    public function hour(): int;
}

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Clock $clock = Core\Test::double<Clock>({
                hour: fn(): int => 9,
            });
            $total = $total + $clock->hour() + ($total % 3);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
