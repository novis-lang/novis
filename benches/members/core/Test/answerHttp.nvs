<?nvs
// Registers fixed replies for web calls, as a test does before it runs code that calls a web service.
// bench: iterations 20000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $urls = ["https://api.example.com/users", "https://api.example.com/orders/*", "https://api.example.com/cart"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $status = 200 + ($total % 299);
            Core\Test::answerHttp($urls[($total % 3) as int], $status, {body: "ok"});
            $total = $total + $status;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
