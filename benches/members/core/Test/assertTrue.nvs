<?nvs
// Checks that a condition is `true`, as a test does after it compares two values.
// bench: iterations 400000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Test::assertTrue($total >= $i);
            $total = $total + 1 + ($total % 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
