<?nvs
// Measures `Core\Test::answerHttp` registering one fixed reply, at growing sizes of the reply body.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $body = Core\Str::repeat('x', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            uint $status = 200 + ($total % 299);
            Core\Test::answerHttp('https://api.example.com/users', $status, {body: $body});
            $total = $total + $status;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
