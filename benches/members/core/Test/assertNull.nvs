<?nvs
// Checks that a search returned `null`, as a test does after it looks for something that is not there.
// bench: iterations 400000

class Bench {
    public static function run(uint $rounds): uint {
        array<?string> $found = [null, null, null];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Test::assertNull($found[($total % 3) as int]);
            $total = $total + 1 + ($total % 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
