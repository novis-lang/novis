<?nvs
// Measures `Core\Test::assertEqualsDeep` comparing two equal orders, at growing numbers of order lines.
// bench: start 256
// bench: max 4096

class Line
{
    public function constructor(public string $sku, public int $quantity) {}
}

class Order
{
    public function constructor(public string $customer, public array<Line> $lines) {}
}

class Bench
{
    public static function run(uint $size): uint
    {
        array<Line> $lines = [];
        array<Line> $copies = [];
        uint $n = 0;
        while ($n < $size) {
            $lines[] = new Line('tea', 2);
            $copies[] = new Line('tea', 2);
            $n = $n + 1;
        }
        Order $order = new Order('customer-1', $lines);
        Order $copy = new Order('customer-1', $copies);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Test::assertEqualsDeep($order, $copy);
            $total = $total + 1 + ($total % 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
