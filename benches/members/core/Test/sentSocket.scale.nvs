<?nvs
// Measures `Core\Test::sentSocket` reading the messages a program sent, at growing numbers of messages.
// bench: start 64
// bench: max 1024

use Core\Http\Client;

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Test::answerSocket('wss://chat.example.com/room', []);
        var $socket = Client::openSocket('wss://chat.example.com/room');
        uint $n = 0;
        while ($n < $size) {
            $socket->send('hello');
            $n = $n + 1;
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count(Core\Test::sentSocket()) + ($total % 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
