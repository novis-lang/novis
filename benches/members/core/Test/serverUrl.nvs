<?nvs
// Reads the test server address, as a test does before it builds each URL it requests.
// bench: iterations 400000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $fallbacks = ["", "http://localhost", "http://127.0.0.1:8080"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $base = Core\Test::serverUrl() ?? $fallbacks[($total % 3) as int];
            $total = $total + Core\Str::length($base) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
