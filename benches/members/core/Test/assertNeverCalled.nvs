<?nvs
// Checks that a method was not called, as a test does after it runs the code.
// bench: iterations 20000

interface Files {
    public function read(string $path): string;
    public function delete(string $path): void;
}

class Bench {
    public static function run(uint $rounds): uint {
        Files $files = Core\Test::double<Files>({
            read: fn(string $path): string => "data",
            delete: fn(string $path): void => {},
        });
        $files->read("a.txt");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Test::assertNeverCalled($files, Files::delete);
            $total = $total + 1 + ($total % 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
