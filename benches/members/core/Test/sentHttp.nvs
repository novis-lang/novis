<?nvs
// Reads the requests a program sent to a fake web service, as a test does after it runs the code.
// bench: iterations 20000

use Core\Http\Client;

class Bench {
    public static function run(uint $rounds): uint {
        Core\Test::answerHttp("https://api.example.com/*", 200);
        Client::get("https://api.example.com/users/7");
        Client::post("https://api.example.com/orders", {json: ["sku" => "mug"]});
        Client::delete("https://api.example.com/users/7");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count(Core\Test::sentHttp()) + ($total % 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
