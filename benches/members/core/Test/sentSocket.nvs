<?nvs
// Reads the messages a program sent over a fake WebSocket, as a test does after it runs the code.
// bench: iterations 20000

use Core\Http\Client;

class Bench {
    public static function run(uint $rounds): uint {
        Core\Test::answerSocket("wss://chat.example.com/room", []);
        var $socket = Client::openSocket("wss://chat.example.com/room");
        $socket->send("join room");
        $socket->send("hello");
        $socket->send("bye");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count(Core\Test::sentSocket()) + ($total % 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
