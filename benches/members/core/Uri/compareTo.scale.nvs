<?nvs
// Measures `compareTo` on two addresses with long paths, at growing path lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $path = Core\Str::repeat('/shop', $size);
        Core\Uri $left = Core\Uri::parse("https://example.com" . $path . "?step=2");
        Core\Uri $right = Core\Uri::parse("https://EXAMPLE.com" . $path . "/./?step=2");
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + ($left->compareTo($right) + 2) as uint;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
