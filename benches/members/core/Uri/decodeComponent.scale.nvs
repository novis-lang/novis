<?nvs
// Measures `Core\Uri::decodeComponent` on one long file name, at growing name lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $name = Core\Str::repeat('caf%C3%A9%20', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Bytes::length(Core\Uri::decodeComponent($name));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
