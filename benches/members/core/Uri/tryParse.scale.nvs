<?nvs
// Measures `Core\Uri::tryParse` on one address with a long path, at growing path lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $typed = "https://shop.example.com" . Core\Str::repeat('/cart', $size) . "?item=42";
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            ?Core\Uri $uri = Core\Uri::tryParse($typed);
            if ($uri == null) {
                $total = $total + 1;
            } else {
                $total = $total + Core\Str::length($uri->path());
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
