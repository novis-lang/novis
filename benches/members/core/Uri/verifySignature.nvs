<?nvs
// Checks a signed link, as a server does each time somebody opens a download or reset link.
// bench: iterations 50000

class Bench {
    public static function run(uint $rounds): uint {
        array<secret bytes> $keys = [Core\Crypto::generateKey()];
        Core\Time\Instant $until = Core\Time::now()->plus(1h);
        array<Core\Uri> $links = [
            Core\Uri::parse("https://files.example.com/download?file=report.pdf")->sign({keys: $keys, until: $until}),
            Core\Uri::parse("/reset?user=42")->sign({keys: $keys, until: $until}),
            Core\Uri::parse("https://example.com/orders/7/invoice?format=pdf&lang=en")->sign({keys: $keys, until: null}),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $links[($total % 3) as int]->verifySignature($keys);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(50000), "\n";
