<?nvs
// Escapes a file name for a download link, as a page does for each file it lists.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["Café menu.pdf", "report 2026.txt", "a/b?c.png"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length(Core\Uri::encodeComponent($names[$total % 3]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
