<?nvs
// Reads the query of an address, as a server does before it looks at the parameters of a request.
// bench: iterations 400000
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Uri> $links = [
            Core\Uri::parse("https://shop.example.com/search?q=shoes&page=2#results"),
            Core\Uri::parse("http://localhost:8080/health"),
            Core\Uri::parse("/orders?status=open&sort=date&limit=50"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            ?string $query = $links[($total % 3) as int]->query();
            $total = $total + Core\Str::length($query ?? "") + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
