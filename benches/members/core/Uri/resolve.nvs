<?nvs
// Turns a short link into a full address, as a crawler does for each link on a page.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        Core\Uri $page = Core\Uri::parse("https://shop.example.com/catalog/shoes/index.html?page=2");
        array<string> $links = ["red-shoes.html", "../bags/", "/cart?add=17"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Uri $target = $page->resolve($links[($total % 3) as int]);
            $total = $total + Core\Str::length($target->toString());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
