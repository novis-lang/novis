<?nvs
// Escapes a search text for a form value, as a page does for each link to a results page.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $searches = ["red shoes", "salt & pepper", "Café au lait"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length(Core\Uri::encodeFormValue($searches[$total % 3]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
