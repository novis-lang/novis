<?nvs
// Measures `Core\Uri::parse` on one address with a long path, at growing path lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $link = "https://shop.example.com" . Core\Str::repeat('/shoes', $size) . "?page=2";
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            var $uri = Core\Uri::parse($link);
            $total = $total + Core\Str::length($uri->path());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
