<?nvs
// Measures `Core\Uri::parseQuery` on one query string with a long value, at growing value lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $query = "q=" . Core\Str::repeat('red+shoes', $size) . "&page=2";
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<mixed> $params = Core\Uri::parseQuery($query);
            $total = $total + Core\Arr::count($params);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
