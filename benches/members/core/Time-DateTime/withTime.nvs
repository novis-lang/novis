<?nvs
// Sets the time of a date and time, as a program does to plan a reminder at a fixed hour.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        array<Core\Time\TimeOfDay> $times = [
            Core\Time\TimeOfDay::at(8, 0), Core\Time\TimeOfDay::at(12, 30), Core\Time\TimeOfDay::at(18, 45),
        ];
        var $at = Core\Time::at(2024, 9, 20, Core\Time\Zone::of("Europe/London"), {hour: 23, minute: 30});
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the time is picked with last round's total
            var $set = $at->withTime($times[($total % 3) as uint]);
            $total = $total + ($set->dayOfYear() % 7) as int + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
