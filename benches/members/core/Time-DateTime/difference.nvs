<?nvs
// Counts whole days between two dates, as a program does when it shows how many days an invoice is overdue.
// bench: iterations 512
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        var $zone = Core\Time\Zone::of('Europe/Berlin');
        var $today = Core\Time\DateTime::fromIso('2024-11-20 09:00', $zone);
        array<Core\Time\DateTime> $due = [
            Core\Time\DateTime::fromIso('2024-11-04', $zone),
            Core\Time\DateTime::fromIso('2024-03-30 12:00', $zone),
            Core\Time\DateTime::fromIso('2024-10-01', $zone),
        ];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the due date counted in this round
            $total = $total + $due[(($total as uint + $i) % 3) as int]->difference($today, Core\Unit::Day);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(512), "\n";
