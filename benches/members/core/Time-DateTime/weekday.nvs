<?nvs
// Reads the day of the week, as a program does when it skips weekends.
// bench: iterations 1024
// bench: calls 0
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        var $zone = Core\Time\Zone::of("Europe/Berlin");
        array<Core\Time\DateTime> $days = [
            Core\Time::at(2024, 1, 3, $zone),
            Core\Time::at(2024, 7, 13, $zone, {hour: 9}),
            Core\Time::at(2023, 12, 31, $zone, {hour: 23}),
        ];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round
            $total = $total + ($days[(($total as uint + $i) % 3) as int]->weekday() as int);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
