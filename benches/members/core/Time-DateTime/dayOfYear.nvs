<?nvs
// Reads the number of a day in its year, as a program does when it picks a daily message or report.
// bench: iterations 1024
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $zone = Core\Time\Zone::of('Europe/Berlin');
        array<Core\Time\DateTime> $days = [
            Core\Time\DateTime::fromIso('2024-01-03', $zone),
            Core\Time\DateTime::fromIso('2024-07-16 09:00', $zone),
            Core\Time\DateTime::fromIso('2023-12-29 23:00', $zone),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round, and each day number is a multiple of 3
            $total = $total + $days[(($total + $i) % 3) as int]->dayOfYear();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
