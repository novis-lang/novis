<?nvs
// Reads the number of a day in its year, as a program does when it picks a daily message or report.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        var $zone = Core\Time\Zone::of("Europe/Berlin");
        array<Core\Time\DateTime> $days = [
            Core\Time::at(2024, 1, 3, $zone),
            Core\Time::at(2024, 7, 16, $zone, {hour: 9}),
            Core\Time::at(2023, 12, 29, $zone, {hour: 23}),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round, and each day number is a multiple of 3
            $total = $total + $days[(($total + $i) % 3) as int]->dayOfYear();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
