<?nvs
// Finds the last moment of the day, the week or the month, as a program does to show when an offer ends.
// bench: iterations 200000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        array<Core\Unit> $units = [Core\Unit::Day, Core\Unit::Week, Core\Unit::Month];
        var $at = Core\Time::at(2024, 4, 28, Core\Time\Zone::of("America/Chicago"), {hour: 18, minute: 30});
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the unit is picked with last round's total
            var $end = $at->endOf($units[($total % 3) as uint]);
            $total = $total + ($end->dayOfYear() % 7) as int + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
