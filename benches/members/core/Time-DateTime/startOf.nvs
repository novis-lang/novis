<?nvs
// Finds the start of the day, the week or the month, as a program does to group orders into a report.
// bench: iterations 200000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        array<Core\Unit> $units = [Core\Unit::Day, Core\Unit::Week, Core\Unit::Month];
        var $at = Core\Time::at(2024, 8, 21, Core\Time\Zone::of("Europe/Madrid"), {hour: 17, minute: 42});
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the unit is picked with last round's total
            var $start = $at->startOf($units[($total % 3) as uint]);
            $total = $total + ($start->dayOfYear() % 7) as int + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
