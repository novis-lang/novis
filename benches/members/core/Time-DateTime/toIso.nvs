<?nvs
// Writes a date and time as ISO text, as a program does when it saves a timestamp to a database.
// bench: iterations 1024
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        var $zone = Core\Time\Zone::of('Europe/Berlin');
        array<Core\Time\DateTime> $moments = [
            Core\Time\DateTime::fromIso('2024-01-03 08:30', $zone),
            Core\Time\DateTime::fromIso('2024-07-13 09:00:15.25', $zone),
            Core\Time\DateTime::fromIso('2023-12-31 23:00', $zone),
        ];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value written in this round
            $total = $total + Core\Str::length($moments[(($total as uint + $i) % 3) as int]->toIso()) as int;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
