<?nvs
// Checks whether a date is in a leap year, as a program does before it splits a yearly price into days.
// bench: iterations 4096
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $zone = Core\Time\Zone::of('Europe/Berlin');
        array<Core\Time\DateTime> $days = [
            Core\Time\DateTime::fromIso('2024-01-03', $zone),
            Core\Time\DateTime::fromIso('2025-07-16 09:00', $zone),
            Core\Time\DateTime::fromIso('2100-12-29 23:00', $zone),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round
            if ($days[(($total + $i) % 3) as int]->isLeapYear()) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(4096), "\n";
