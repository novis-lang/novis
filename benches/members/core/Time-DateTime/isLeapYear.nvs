<?nvs
// Checks whether a date is in a leap year, as a program does before it splits a yearly price into days.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        var $zone = Core\Time\Zone::of("Europe/Berlin");
        array<Core\Time\DateTime> $days = [
            Core\Time::at(2024, 1, 3, $zone),
            Core\Time::at(2025, 7, 16, $zone, {hour: 9}),
            Core\Time::at(2100, 12, 29, $zone, {hour: 23}),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round
            if ($days[(($total + $i) % 3) as int]->isLeapYear()) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
