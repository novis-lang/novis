<?nvs
// Sets the day and the hour of a date and time, as a program does to plan a delivery or a meeting.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): int {
        var $at = Core\Time::at(2024, 5, 13, Core\Time\Zone::of("Europe/Vienna"), {hour: 9, minute: 40});
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the day and the hour are picked with last round's total
            var $moved = $at->with({day: ($total % 28 + 1) as uint, hour: ($total % 24) as uint});
            $total = $total + ($moved->dayOfYear() % 7) as int + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
