<?nvs
// Reads the nanoseconds of a date and time, as a program does when it writes the fraction of a second into a log line.
// bench: iterations 1024
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $zone = Core\Time\Zone::UTC;
        array<Core\Time\DateTime> $times = [
            Core\Time::at(2024, 1, 9, $zone, { hour: 8, second: 6, nanos: 300000000 }),
            Core\Time::at(2024, 7, 18, $zone, { hour: 13, second: 24, nanos: 600000000 }),
            Core\Time::at(2023, 12, 27, $zone, { hour: 23, second: 51, nanos: 900000000 }),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round, and each count is a multiple of 3
            $total = $total + $times[(($total + $i) % 3) as int]->nanos();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
