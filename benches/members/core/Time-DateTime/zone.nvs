<?nvs
// Gets the time zone of a date and time, as a program does to show other times in the same zone.
// bench: iterations 256
// bench: calls 3
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        array<Core\Time\DateTime> $moments = [
            Core\Time\DateTime::fromIso('2024-03-30 23:00', 'Europe/Berlin'),
            Core\Time\DateTime::fromIso('2024-12-31 12:00', 'Asia/Kolkata'),
            Core\Time\DateTime::fromIso('2025-01-01', Core\Time\Zone::fixed(5h45m)),
        ];
        var $instant = Core\Time\Instant::fromIso('2024-07-01T00:00:00Z');
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round
            var $zone = $moments[(($total as uint + $i) % 3) as int]->zone();
            $total = $total + $zone->offsetAt($instant)->toSeconds() % 7;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
