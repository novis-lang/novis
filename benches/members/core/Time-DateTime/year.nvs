<?nvs
// Reads the year of a date and time, as a program does when it groups orders by year.
// bench: iterations 1024
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        var $zone = Core\Time\Zone::UTC;
        array<Core\Time\DateTime> $times = [
            Core\Time\DateTime::fromIso('2022-01-03 08:00', $zone),
            Core\Time\DateTime::fromIso('2025-07-16 13:30', $zone),
            Core\Time\DateTime::fromIso('2028-12-29 23:59:59', $zone),
        ];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round, and each year is a multiple of 3
            $total = $total + $times[(($total as uint + $i) % 3) as int]->year();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
