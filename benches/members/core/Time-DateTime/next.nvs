<?nvs
// Finds the next day with a given weekday, as a program does to plan a weekly delivery or meeting.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        array<Core\Weekday> $days = [
            Core\Weekday::Monday, Core\Weekday::Tuesday, Core\Weekday::Wednesday, Core\Weekday::Thursday,
            Core\Weekday::Friday, Core\Weekday::Saturday, Core\Weekday::Sunday,
        ];
        var $at = Core\Time::at(2024, 3, 27, Core\Time\Zone::of("Europe/Berlin"), {hour: 9, minute: 30});
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the weekday is picked with last round's total
            var $found = $at->next($days[($total % 7) as uint]);
            $total = $total + ($found->dayOfYear() % 5) as int + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
