<?nvs
// Finds the next day with a given weekday, as a program does to plan a weekly delivery or meeting.
// bench: iterations 256
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        array<Core\Time\Weekday> $days = [
            Core\Time\Weekday::Monday,
            Core\Time\Weekday::Tuesday,
            Core\Time\Weekday::Wednesday,
            Core\Time\Weekday::Thursday,
            Core\Time\Weekday::Friday,
            Core\Time\Weekday::Saturday,
            Core\Time\Weekday::Sunday,
        ];
        var $at = Core\Time\DateTime::fromIso('2024-03-27 09:30', 'Europe/Berlin');
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the weekday is picked with last round's total
            var $found = $at->next($days[($total % 7) as uint]);
            $total = $total + ($found->dayOfYear() % 5) as int + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
