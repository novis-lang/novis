<?nvs
// Reads a local date and time in a time zone, as a program does with a time a user typed into a form.
// bench: iterations 256
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        var $berlin = Core\Time\Zone::of('Europe/Berlin');
        array<string> $texts = ['2024-06-01 09:30', '2024-12-31T23:59:59', '2025-01-01'];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the text is picked by last round's total
            $total = $total + 1 + Core\Time\DateTime::fromIso($texts[$total % 3], $berlin)->toInstant()->toEpochSeconds() % 1000;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
