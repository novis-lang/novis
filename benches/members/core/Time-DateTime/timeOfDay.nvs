<?nvs
// Takes the time of day out of a date and time, as a program does when it checks opening hours.
// bench: iterations 200000
// bench: calls 0
// bench: allocations 1
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        var $zone = Core\Time\Zone::of("Europe/Berlin");
        array<Core\Time\DateTime> $moments = [
            Core\Time::at(2024, 3, 30, $zone, {hour: 8, minute: 15}),
            Core\Time::at(2024, 12, 31, $zone, {hour: 12}),
            Core\Time::at(2025, 1, 1, $zone, {hour: 18, minute: 45}),
        ];
        var $noon = Core\Time\TimeOfDay::at(12, 0);
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round
            $total = $total + $moments[(($total as uint + $i) % 3) as int]->timeOfDay()->compareTo($noon) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
