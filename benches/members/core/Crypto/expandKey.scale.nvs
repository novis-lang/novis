<?nvs
// Measures `Core\Crypto::expandKey` with one use label, at growing label lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        secret bytes $material = Core\Crypto::generateKey();
        bytes $salt = Core\Bytes::fill(16, 65);
        string $use = Core\Str::repeat('a', $size);
        secret bytes $first = Core\Crypto::expandKey($material, $salt, $use);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            secret bytes $key = Core\Crypto::expandKey($material, $salt, $use);
            $total = $total + (($key == $first ? 1 : 0) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
