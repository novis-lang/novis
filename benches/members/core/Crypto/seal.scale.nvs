<?nvs
// Measures `Core\Crypto::seal` on one field, at growing field sizes.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        secret bytes $key = Core\Crypto::generateKey();
        bytes $field = Core\Bytes::fill($size, 65);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            bytes $sealed = Core\Crypto::seal($field, $key, Core\Crypto\Cipher::XChaCha20Poly1305);
            $total = $total + Core\Bytes::length($sealed);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
