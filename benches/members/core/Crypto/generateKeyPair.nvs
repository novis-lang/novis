<?nvs
// Measures drawing one X25519 key pair, as a server does when it starts a new
// connection with a peer.
// bench: iterations 50000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        secret bytes $previous = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519)->write();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Every round compares its own key with the key of the round before
            // it, so no round can be left out.
            secret bytes $key = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519)->write();
            $total = $total + (($key != $previous ? 1 : 0) as uint);
            $previous = $key;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(50000), "\n";
