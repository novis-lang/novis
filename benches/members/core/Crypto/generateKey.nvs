<?nvs
// Measures drawing one key, as a program does before it seals a new record.
// bench: iterations 200000
// bench: calls 0
// bench: allocations 1
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        secret bytes $previous = Core\Crypto::generateKey();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Every round compares its key with the key of the round before it,
            // so no round can be left out.
            secret bytes $key = Core\Crypto::generateKey();
            $total = $total + (($key != $previous ? 1 : 0) as uint);
            $previous = $key;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
