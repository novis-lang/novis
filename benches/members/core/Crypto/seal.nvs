<?nvs
// Measures sealing one short field, as a program does before it stores a row.
// bench: iterations 100000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        secret bytes $key = Core\Crypto::generateKey();
        array<bytes> $fields = [
            "+44 7700 900123" as bytes,
            "ada@example.org" as bytes,
            "12 Pinner Road, Harrow" as bytes,
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The field of every round is chosen by the length sealed so far,
            // so no round can be left out.
            int $which = ($total % 3) as int;
            bytes $sealed = Core\Crypto::seal($fields[$which], $key, Core\Crypto\Cipher::XChaCha20Poly1305);
            $total = $total + Core\Bytes::length($sealed);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
