<?nvs
// Measures signing a short message with an Ed25519 key, as a program does for
// every message it sends to a partner.
// bench: iterations 5000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        Core\Crypto\KeyPair $pair = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519);
        array<bytes> $messages = [
            "order 1042 shipped" as bytes,
            "order 1043 shipped" as bytes,
            "order 1044 shipped" as bytes,
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The message of every round is chosen by the round before it, so no
            // round can be left out.
            int $which = ($total % 3) as int;
            $total = $total + Core\Bytes::length(Core\Crypto::sign($messages[$which], $pair));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(5000), "\n";
