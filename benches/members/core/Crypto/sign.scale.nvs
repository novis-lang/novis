<?nvs
// Measures `Core\Crypto::sign` on one message, at growing message sizes.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Crypto\KeyPair $pair = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519);
        bytes $message = Core\Bytes::fill($size, 65);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Bytes::length(Core\Crypto::sign($message, $pair));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
