<?nvs
// Measures how `Core\Mail::preview` copies the CSS of a styled order mail into its elements,
// as a shop does before it shows or sends a receipt.
// bench: iterations 64
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $names = ['Ada', 'Ben', 'Carla', 'Dev'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Html\Markup $body = html`<html><head><style>
body { margin: 0; background: #f4f4f4 }
.header { background: #0a5; color: white; padding: 16px }
.header h1 { font-size: 20px; margin: 0 }
p { font-size: 14px; line-height: 1.5; color: #333 }
.content { background: white; padding: 24px }
.button { display: inline-block; background: #0a5; color: white; padding: 12px 20px }
.total { font-weight: bold }
.footer { font-size: 12px; color: #888; padding: 16px }
.footer a { color: #888 }
@media (max-width: 600px) { .content { padding: 12px } }
</style></head><body>
<div class="header"><h1>Example Shop</h1></div>
<div class="content">
<p>Hello ` + Core\Html::escape($names[($total % 4) as int]) + html`,</p>
<p>Thank you for your order 1042. It is on its way.</p>
<p class="total">Total: 59.90 EUR</p>
<p><a class="button" href="https://example.com/orders/1042">Track your order</a></p>
</div>
<div class="footer"><p>Example Shop, 1 Main Street. <a href="https://example.com/unsubscribe">Unsubscribe</a></p></div>
</body></html>`;
            Core\Mail\Preview $mail = Core\Mail::preview($body);
            $total = $total + (Core\Str::length($mail->text()) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
