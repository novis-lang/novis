<?nvs
// Reads bodies a thousand times as large as in `bytes.nvs`, to measure the cost when a reply grows.
// bench: iterations 400000
// bench: scale 1000

class Bench {
    public static function run(uint $rounds): uint {
        // Both replies are answered from this table, so nothing is sent over a network.
        Core\Test::answerHttp("https://cdn.example.com/a.png", 200, {body: Core\Str::repeat("a", 64000)});
        Core\Test::answerHttp("https://cdn.example.com/b.png", 200, {body: Core\Str::repeat("b", 96000)});
        array<Core\Http\Response> $replies = [
            Core\Http\Client::get("https://cdn.example.com/a.png"),
            Core\Http\Client::get("https://cdn.example.com/b.png"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Bytes::length($replies[($total % 2) as int]->bytes());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
