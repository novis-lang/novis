<?nvs
// Reads one body as text, at growing body sizes, to measure how the cost grows with the reply.
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): uint
    {
        // The reply is answered from this table, so nothing is sent over a network.
        Core\Test::answerHttp('https://example.com/a.txt', 200, { body: Core\Str::repeat('a', $size) });
        Core\Http\Response $reply = Core\Http\Client::get('https://example.com/a.txt');
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            // Each round adds the length of the text, so no round can be left out.
            $total = $total + Core\Str::length($reply->text());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
