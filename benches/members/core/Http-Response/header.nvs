<?nvs
// Reads one header of a reply, as a program does to check the content type of every reply it gets.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        // The reply is answered from this table, so nothing is sent over a network.
        Core\Test::answerHttp("https://api.example.com/items", 200, {
            headers: ["Content-Type" => "application/json", "ETag" => "abc123", "Vary" => "Accept"],
        });
        Core\Http\Response $response = Core\Http\Client::get("https://api.example.com/items");
        array<string> $names = ["content-type", "ETag", "vary"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The name in each round is chosen by the round before, so no round can be left out.
            ?tainted string $value = $response->header($names[($total % 3) as int]);
            $total = $total + Core\Str::length($value ?? "");
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
