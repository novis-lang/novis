<?nvs
// Reads a login service's key set of two keys, as a program does when it starts or loads new keys.
// bench: iterations 20000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        Core\Crypto\KeyPair $first = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519);
        Core\Crypto\KeyPair $second = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256);
        string $a = Core\Encoding::decodeText($first->publicKey()->write(Core\Crypto\KeyFormat::Jwk), Core\Charset::Utf8);
        string $b = Core\Encoding::decodeText($second->publicKey()->write(Core\Crypto\KeyFormat::Jwk), Core\Charset::Utf8);
        array<string> $documents = [
            "{\"keys\":[" . Core\Str::replace($a, "{", "{\"kid\":\"a\",") . "," . Core\Str::replace($b, "{", "{\"kid\":\"b\",") . "]}",
            "{\"keys\":[" . Core\Str::replace($b, "{", "{\"kid\":\"c\",") . "," . Core\Str::replace($a, "{", "{\"kid\":\"d\",") . "]}",
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round reads the document the round before chose, so no round can be left out.
            string $document = $documents[($total % 2) as int];
            Core\Jwt\KeySet $keys = Core\Jwt\KeySet::read($document);
            $total = $total + 1 + Core\Str::length($document) % 2;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
