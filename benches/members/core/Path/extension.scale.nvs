<?nvs
// Measures `Core\Path::extension` on one path, at growing extension lengths.
// It shows how the cost of `extension` grows when the path grows.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $path = "/srv/report." . Core\Str::repeat("a", $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Path::extension($path) ?? "");
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
