<?nvs
// Measures finding the path from one folder to a file, as a program does when it writes a link between two pages.
// bench: iterations 400000

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $paths = [
            "/srv/shop/invoices/2026/invoice-10420.pdf",
            "/srv/shop/uploads/holiday.jpg",
            "/srv/shop/views/orders/index.nvs",
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The path used next depends on the last result, so no round can be skipped.
            string $way = Core\Path::relativeTo($paths[$total % 3], "/srv/shop/views/cart") ?? "";
            $total = $total + Core\Str::length($way);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
