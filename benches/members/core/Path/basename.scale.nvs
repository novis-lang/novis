<?nvs
// Measures `Core\Path::basename` on one path, at growing file name lengths.
// It shows how the cost of `basename` grows when the path grows.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $path = "/srv/shop/" . Core\Str::repeat("a", $size) . ".csv";
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Path::basename($path));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
