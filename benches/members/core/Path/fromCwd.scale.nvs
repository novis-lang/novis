<?nvs
// Measures `Core\Path::fromCwd` on one file name, at growing file name lengths.
// It shows how the cost of `fromCwd` grows when the file name grows.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $name = Core\Str::repeat("a", $size) . ".csv";
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Path::fromCwd($name));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
