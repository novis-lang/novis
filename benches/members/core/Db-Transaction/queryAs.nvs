<?nvs
// Measures `queryAs`, which runs one `select` in a transaction and reads the rows into objects.
// A program does this when it loads records before it changes them.
// bench: iterations 10000
use Core\Db\Derive;

#[Derive]
class Note {
    public uint $id;
    public uint $n;

    public function constructor(uint $id, uint $n)
    {
        $this->id = $id;
        $this->n = $n;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        var $db = Core\Db::connect('notes');
        $db->execute('create table notes (id integer primary key, n int not null)', []);
        uint $written = 0;
        while ($written < 10) {
            $db->execute('insert into notes (n) values (?)', [$written as int]);
            $written = $written + 1;
        }
        return $db->transaction(fn (Core\Db\Transaction $tx): uint => {
            uint $total = 0;
            uint $i = 0;
            while ($i < $rounds) {
                // The total so far sets the value for `?`, and each row adds its `n`
                // to the total. So no round can be skipped or moved out of the loop.
                var $rows = $tx->queryAs<Note>('select id, n from notes where n >= ? order by n', [($total % 10) as int]);
                foreach ($rows->all() as Note $note) {
                    $total = $total + $note->n;
                }
                $i = $i + 1;
            }
            return $total;
        });
    }
}

echo Bench::run(10000), "\n";
