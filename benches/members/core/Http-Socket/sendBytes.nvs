<?nvs
// Sends one short binary message to a WebSocket server, as a device does for each reading it reports.
// bench: iterations 200000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        // The server is answered from a table, so nothing is sent over a network.
        Core\Test::answerSocket("wss://sensors.example.com/readings", []);
        Core\Http\Socket $socket = Core\Http\Client::openSocket("wss://sensors.example.com/readings");
        array<bytes> $readings = ["\x01" as bytes, "\x01\x02" as bytes, "\x01\x02\x03" as bytes];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round picks its message from what the round before counted.
            bytes $reading = $readings[($total % 3) as int];
            $socket->sendBytes($reading);
            $total = $total + Core\Bytes::length($reading);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
