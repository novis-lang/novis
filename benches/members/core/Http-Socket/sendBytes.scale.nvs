<?nvs
// Measures sending a binary message to a WebSocket server, at growing message sizes.
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): uint
    {
        // The socket is answered from this table, so nothing is sent over a network.
        Core\Test::answerSocket('wss://sensors.example.com/readings', []);
        Core\Http\Socket $socket = Core\Http\Client::openSocket('wss://sensors.example.com/readings');
        bytes $reading = Core\Str::repeat('a', $size) as bytes;
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $socket->sendBytes($reading);
            $total = $total + Core\Bytes::length($reading);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
