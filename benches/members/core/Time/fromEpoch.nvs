<?nvs
// Builds an instant from a Unix timestamp, as a program does with a time it read from a database.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the timestamp comes from last round's total
            $total = $total + 1 + Core\Time::fromEpoch(1715688000 + $total % 86400)->toEpochSeconds() % 1000;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
