<?nvs
// Reads a date and time through a pattern, as a program does with each row of an exported file.
// bench: iterations 100000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): int {
        var $berlin = Core\Time\Zone::of("Europe/Berlin");
        array<string> $texts = ["05.06.2024 14:30", "31.12.2024 23:59", "01.01.2025 00:05"];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the text is picked by last round's total
            $total = $total + 1 + Core\Time::parse($texts[$total % 3], "dd.MM.yyyy HH:mm", $berlin)->toInstant()->toEpochSeconds() % 1000;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
