<?nvs
// Builds a date and time from its parts in a zone, as a program does when it plans an appointment.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): int {
        var $zone = Core\Time\Zone::of("Europe/Berlin");
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the day and the hour come from last round's total
            uint $day = ($total % 28) as uint + 1;
            uint $hour = ($total % 24) as uint;
            $total = $total + Core\Time::at(2024, 3, $day, $zone, {hour: $hour})->toInstant()->toEpochSeconds() % 1000;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
