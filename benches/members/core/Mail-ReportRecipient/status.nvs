<?nvs
// Measures how the status code of a bounced recipient is read, as a program does for each bounce it handles.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Message;
use Core\Mail\ReportRecipient;

class Bench
{
    public static function run(uint $rounds): uint
    {
        Message $bounce = Message::parse(
            "From: mailer-daemon@mx.example.net\n"
                . "Content-Type: multipart/report; report-type=delivery-status; boundary=\"b\"\n\n"
                . "--b\nContent-Type: message/delivery-status\n\n"
                . "Reporting-MTA: dns; mx.example.net\n\n"
                . "Final-Recipient: rfc822; ada@example.org\nAction: failed\nStatus: 5.1.1\n\n"
                . "Final-Recipient: rfc822; bo@example.org\nAction: delayed\nStatus: 4.4.1 (timed out)\n\n"
                . "Final-Recipient: rfc822; cy@example.org\nAction: failed\nStatus: 5.7.1\n"
                . "--b--\n",
        );
        array<ReportRecipient> $recipients = $bounce->report()?->recipients() ?? [];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each code has 5 characters, so `$total` grows by 6, and `($total + $i) % 3` is the same as `$i % 3`.
            // The loop reads recipient 1, 2, 3, then recipient 1 again, and so on.
            $total = $total + Core\Str::length($recipients[(($total + $i) % 3) as int]->status()) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
