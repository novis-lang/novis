<?nvs
// Reads the parts directly inside a node, as a program walking a parsed file
// does at every step of the walk.
// bench: iterations 200000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        Core\Ast\Node $file = Core\Ast::parse('<?nvs echo 1; echo 2, 3; echo 4, 5, 6;');
        array<Core\Ast\Node> $top = $file->children();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which of the three nodes is asked comes from last round's count,
            // so no round can be reused.
            Core\Ast\Node $node = $top[($total % 3) as int];
            $total = $total + Core\Arr::count($node->children());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
