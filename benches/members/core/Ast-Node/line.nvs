<?nvs
// Reads the line a part of the source starts on, as a tool does when it names
// a place a person can jump to.
// bench: iterations 200000
// bench: allocations 0
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        Core\Ast\Node $file = Core\Ast::parse("<?nvs\necho 1;\necho 2, 3;\necho 4, 5, 6;\n");
        array<Core\Ast\Node> $top = $file->children();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which of the three nodes is asked comes from last round's line,
            // so no round can be reused.
            Core\Ast\Node $node = $top[($total % 3) as int];
            $total = $total + ($node->line() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
