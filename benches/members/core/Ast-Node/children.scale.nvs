<?nvs
// Measures `children` on the top node of one parsed file, at growing numbers of statements.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Ast\Node $file = Core\Ast::parse('<?nvs ' . Core\Str::repeat('echo 1;', $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count($file->children());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
