<?nvs
// Measures how fast `removeAll` builds a change, as a program does before it sends a `modify`.
// bench: iterations 200000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The total so far chooses the name, so the loop cannot be left out.
        array<string> $names = ['pager', 'mobile', 'facsimileTelephoneNumber'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $name = $names[($total % 3) as int];
            var $change = Core\Ldap\Change::removeAll($name);
            $total = $total + Core\Str::length($name) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
