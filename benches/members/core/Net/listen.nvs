<?nvs
// Opens a listening TCP socket and closes it again, as a program does when it starts a server.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $addresses = ["127.0.0.1"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round picks its address from what the round before counted.
            Core\Net\Listener $server = Core\Net::listen($addresses[($total % 1) as int], 0);
            $server->close();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
