<?nvs
// Creates a server on a socket file and closes it again, as a program does when it starts a local service.
// bench: iterations 2000
// bench: complexity constant
// requires: unix

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $paths = ["/tmp/novis-bench-listen.sock"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round picks its path from what the round before counted.
            // The socket file stays after `close`, so each round also deletes it.
            Core\Net\Listener $server = Core\Net::listenLocal($paths[($total % 1) as int]);
            $server->close();
            Core\IO::remove($paths[($total % 1) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2000), "\n";
