<?nvs
// Measures adding to a counter, as a server does once for every order or login it handles.
// bench: iterations 256
// bench: allocations 0
// bench: complexity constant
// proof: gap nvs-stdlib/a-metrics-write-allocates-on-every-call

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the amount added this round depends on last round's total.
            uint $by = $total % 3 + 1;
            Core\Metrics::increment("orders_total", {by: $by});
            $total = $total + $by;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
