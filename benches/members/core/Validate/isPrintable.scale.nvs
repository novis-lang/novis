<?nvs
// Measures `Core\Validate::isPrintable` on one long display name, at growing name lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $name = Core\Str::repeat('Zoë Ann ', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            if (Core\Validate::isPrintable($name)) {
                $total = $total + 2;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
