<?nvs
// Measures `Core\Validate::isMac` on one long text made of address groups, at growing text lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $text = Core\Str::repeat('00:1a:', $size) . "2b";
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            if (Core\Validate::isMac($text)) {
                $total = $total + 2;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
