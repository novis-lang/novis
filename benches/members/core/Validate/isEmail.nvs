<?nvs
// Checks that an address from a sign-up form is an email address, as a program does before it saves a new user.
// bench: iterations 400000
// bench: allocations 0
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $addresses = ["ada.lovelace@example.com", "grace@@example.org", "bob+news@mail.example.net"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if (Core\Validate::isEmail($addresses[(($total + $i) % 3) as int])) {
                $total = $total + 3;
            } else {
                $total = $total + 6;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
