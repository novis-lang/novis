<?nvs
// Checks that a host name from a form or a configuration file is a domain name, as a program does before it connects.
// bench: iterations 4096
// bench: allocations 0
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $hosts = ["shop.example.com", "-bad.example.com", "mail.example.org"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if (Core\Validate::isDomain($hosts[(($total + $i) % 3) as int])) {
                $total = $total + 3;
            } else {
                $total = $total + 6;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(4096), "\n";
