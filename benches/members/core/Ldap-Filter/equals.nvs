<?nvs
// Measures how fast `Core\Ldap\Filter::equals` builds a filter, as a login page does for each sign-in.
// bench: iterations 100000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The count so far chooses the value, so the loop cannot be left out.
        array<string> $names = ['anna', 'ben.lee', 'carla*'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $filter = Core\Ldap\Filter::equals('sAMAccountName', $names[($total % 3) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
