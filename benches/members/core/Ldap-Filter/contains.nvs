<?nvs
// Measures how fast `Core\Ldap\Filter::contains` builds a filter, as a search for part of a name does.
// bench: iterations 100000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The count so far chooses the text, so the loop cannot be left out.
        array<string> $typed = ['lee', 'sales', 'print*'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $filter = Core\Ldap\Filter::contains('description', $typed[($total % 3) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
