<?nvs
// Measures how fast `Core\Ldap\Filter::parse` reads a short filter, as a program does with a filter from its settings.
// bench: iterations 100000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The count so far chooses the text, so the loop cannot be left out.
        array<string> $texts = [
            '(&(objectClass=user)(mail=*))',
            '(|(sAMAccountName=anna)(mail=anna@example.test))',
            '(&(objectClass=user)(!(objectClass=computer)))',
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $filter = Core\Ldap\Filter::parse($texts[($total % 3) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
