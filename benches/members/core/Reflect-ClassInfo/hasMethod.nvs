<?nvs
// Checks whether a class has a method by name, as an event dispatcher does before it calls a handler.
// bench: iterations 400000
// bench: allocations 0

class Listener {
    public function onCreated(): int {
        return 1;
    }

    public function onDeleted(): int {
        return 2;
    }

    public function onUpdated(): int {
        return 3;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        var $found = Core\Reflect::forClass("Listener");
        if ($found == null) {
            return 0;
        }
        Core\Reflect\ClassInfo $info = $found;
        array<string> $names = ["onCreated", "onMoved", "onUpdated"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The name checked depends on last round's total, so no round can be skipped.
            if ($info->hasMethod($names[($total % 3) as int])) {
                $total = $total + 2;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
