<?nvs
// Calls a method by its name, as a router or a command line tool does when the name comes from input.
// bench: iterations 200000
// bench: complexity constant

class Counter {
    public function add(int $total, int $step): int {
        return $total + $step;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        var $counter = new Counter();
        var $info = Core\Reflect::forObject($counter);
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each call gets last round's total, so no round can be skipped.
            $total = $info->call($counter, "add", [$total, 3]) as int;
            $i = $i + 1;
        }
        return $total as uint;
    }
}

echo Bench::run(200000), "\n";
