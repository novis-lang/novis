<?nvs
// Measures `Core\Random::shuffle` on one list, at growing list sizes.
// It shows how the cost of `shuffle` grows when the list grows.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $items = Core\Arr::range(1, $size as int);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count(Core\Random::shuffle($items));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
