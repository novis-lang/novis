<?nvs
// Measures how the folders of a mailbox with three folders are listed, as a script does before it picks one.
// bench: iterations 256
// bench: complexity constant

use Core\Arr;
use Core\Imap;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $mailbox = Imap::open('inbox');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Arr::count($mailbox->folders());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
