<?nvs
// Measures how one folder of a mailbox is opened by its name, as a script does for `INBOX` or `Sent`.
// bench: iterations 256
// bench: complexity constant

use Core\Imap;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $mailbox = Imap::open('inbox');
        array<string> $names = ['INBOX', 'Sent', 'Archive'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round uses the total so far to pick one of the three folders.
            var $folder = $mailbox->folder($names[($total % 3) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
