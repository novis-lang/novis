<?nvs
// Measures how the name of the sender is read, as a program does to greet the sender in its answer.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Address;
use Core\Mail\Message;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Address> $senders = [
            Message::parse("From: Bo <bo@example.org>\n\nHi")->from() ?? Address::of('a@x.io', ''),
            Message::parse("From: Ada Lovelace <ada@example.org>\n\nHi")->from() ?? Address::of('a@x.io', ''),
            Message::parse("From: Example Shop Customer Service <help@example.com>\n\nHi")->from() ?? Address::of('a@x.io', ''),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round adds the counter to the total so far. The result picks one of the three addresses.
            // The length is multiplied by 3, so the next round picks the next address.
            $total = $total + 3 * Core\Str::length($senders[(($total + $i) % 3) as int]->name());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
