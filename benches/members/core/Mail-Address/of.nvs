<?nvs
// Measures how `Core\Mail\Address::of` checks an address and adds a name to it,
// as a shop does for each customer it sends a mail to.
// bench: iterations 1024
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $emails = ['ada@example.com', 'ben.miller@shop.example', 'carla@bücher.example', 'dev+orders@example.org'];
        array<string> $names = ['Ada Lovelace', 'Ben Miller', 'Carla Müller', 'Dev'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            int $at = ($total % 4) as int;
            Core\Mail\Address $to = Core\Mail\Address::of($emails[$at], $names[$at]);
            $total = $total + 1 + ($i % 3);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
