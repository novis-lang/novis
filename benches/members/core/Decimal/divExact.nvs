<?nvs
// Measures one exact division of a pack price by a pack size, which a shop
// does to work out what one item costs.
// bench: iterations 1000000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<decimal> $prices = [8.00, 12.00, 20.00, 84.00];
        decimal $size = 4;
        uint $total = 1;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: which price is divided holds the last round's answer.
            decimal $each = Core\Decimal::divExact($prices[$total % 4], $size);
            $total = $total + ($each as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000000), "\n";
