<?nvs
// Measures rolling a die with a seeded generator, as a test or a simulation does.
// bench: iterations 256
// bench: calls 0
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        Core\Random\Seeded $generator = new Core\Random\Seeded(42);
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The upper bound depends on the last result, so no round can be left out.
            $total = $total + $generator->int(1, 6 + $total % 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256) > 0 ? "done" : "none", "\n";
