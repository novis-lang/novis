<?nvs
// Measures `bytes` on a seeded generator, at a growing number of bytes.
// It shows how the cost of `bytes` grows when you ask for more bytes.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Random\Seeded $generator = new Core\Random\Seeded(42);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Bytes::length($generator->bytes($size + $total % 2));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
