<?nvs
// Measures choosing three of twenty products with a seeded generator, as a quick test does.
// bench: iterations 200000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): int {
        Core\Random\Seeded $generator = new Core\Random\Seeded(42);
        array<int> $products = Core\Arr::range(1, 20);
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Every round adds the products it chose, so no round can be left out.
            array<int> $chosen = $generator->sample($products, 3);
            $total = $total + $chosen[0] + $chosen[1] + $chosen[2];
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
