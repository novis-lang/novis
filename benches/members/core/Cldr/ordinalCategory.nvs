<?nvs
// Measures picking the place form for a number, which a page does once for
// every row of a ranked list.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $locales = ["en", "it", "cy"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The language of each round is chosen by the round before it, so
            // no round can be left out.
            int $pick = ($total % 3) as int;
            var $form = Core\Cldr::ordinalCategory($i as int, $locales[$pick]);
            uint $step = 1;
            if ($form == Core\Cldr\PluralCategory::Other) {
                $step = 2;
            }
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
