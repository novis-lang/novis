<?nvs
// Measures picking the plural form for a count, which a page does once for
// every message that names a number.
// bench: iterations 2048
// bench: calls 0
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $locales = ["en", "ru", "pl"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The language of each round is chosen by the round before it, so
            // no round can be left out.
            int $pick = ($total % 3) as int;
            var $form = Core\Cldr::pluralCategory($i as int, $locales[$pick]);
            uint $step = 1;
            if ($form == Core\Cldr\PluralCategory::Other) {
                $step = 2;
            }
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
