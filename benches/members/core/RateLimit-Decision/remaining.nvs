<?nvs
// Reads how many calls a rate limit still allows, as a handler does to write a `RateLimit-Remaining` header.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): uint {
        // 11 of 12 and 5001 of 5002 are left, so both counts are odd.
        array<Core\RateLimit\Decision> $decisions = [
            Core\RateLimit::shed("bench:remaining:small", 12, 1h),
            Core\RateLimit::shed("bench:remaining:large", 5002, 1h),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which decision is read comes from last round's total,
            // so no round can be reused.
            Core\RateLimit\Decision $decision = $decisions[($total % 2) as int];
            $total = $total + $decision->remaining();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
