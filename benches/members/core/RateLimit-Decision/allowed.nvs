<?nvs
// Reads whether a rate limit allowed a call, as a request handler does before it answers.
// bench: iterations 1024
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\RateLimit\Decision> $decisions = [
            Core\RateLimit::shed("bench:allowed", 1, 1h),
            Core\RateLimit::shed("bench:allowed", 1, 1h),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which decision is read comes from last round's total,
            // so no round can be reused.
            Core\RateLimit\Decision $decision = $decisions[($total % 2) as int];
            if ($decision->allowed()) {
                $total = $total + 1;
            } else {
                $total = $total + 3;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
