<?nvs
// Checks which method a route match belongs to, as a front controller does before it calls that method.
// bench: iterations 1024
// bench: allocations 0
// bench: calls 0
// bench: complexity constant

class Shop
{
    #[Core\Route(path: '/products/{id}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function product(uint $id): string
    {
        return 'one product';
    }

    #[Core\Route(path: '/cart', method: Core\Http\Method::Post)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function cart(): string
    {
        return 'the cart';
    }
}

class Bench
{
    public static function loop(Core\Router\Match $product, Core\Router\Match $cart, uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Last round's total decides which match this round checks.
            bool $found = $total % 2 == 0 ? $product->is(Shop::product) : $cart->is(Shop::product);
            if ($found) {
                $total = $total + 1;
            } else {
                $total = $total + 3;
            }
            $i = $i + 1;
        }
        return $total;
    }

    public static function run(uint $rounds): uint
    {
        ?Core\Router\Match $product = Core\Router::match(Core\Http\Method::Get, '/products/42');
        ?Core\Router\Match $cart = Core\Router::match(Core\Http\Method::Post, '/cart');
        if ($product != null) {
            if ($cart != null) {
                return Bench::loop($product, $cart, $rounds);
            }
        }
        return 0;
    }
}

echo Bench::run(1024), "\n";
