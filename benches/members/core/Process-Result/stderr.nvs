<?nvs
// Measures reading the error output of a program that has ended, as a script does when it logs why a tool failed.
// bench: iterations 2048
// bench: allocations 0
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        // Two programs run once, before the loop: `/bin/sh` on Linux and macOS, `cmd.exe` on Windows.
        array<Core\Process\Result> $results = [];
        if (Core\Path::SEPARATOR == "\\") {
            $results[] = Core\Process::run("C:\\Windows\\System32\\cmd.exe", ["/c", "echo failed 1>&2"]);
            $results[] = Core\Process::run("C:\\Windows\\System32\\cmd.exe", ["/c", "echo a longer message 1>&2"]);
        } else {
            $results[] = Core\Process::run("/bin/sh", ["-c", "echo failed >&2"]);
            $results[] = Core\Process::run("/bin/sh", ["-c", "echo a longer message >&2"]);
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The next result depends on the total so far, so no round can be skipped.
            $total = $total + Core\Bytes::length($results[($total % 2) as int]->stderr());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
