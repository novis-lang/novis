<?nvs
// Measures how fast `string` reads one text value, as a program does to show a person's mail address.
// bench: iterations 400000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $found = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['mail', 'department'] });
        if ($found == null) {
            return 0;
        }
        Core\Ldap\Entry $person = $found;
        // The count so far chooses the attribute, so the loop cannot be left out.
        array<string> $names = ['mail', 'department'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length($person->string($names[($total % 2) as int]) ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
