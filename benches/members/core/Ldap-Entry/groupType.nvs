<?nvs
// Measures how fast `groupType` reads the type of a group, as a program does to keep only security groups.
// bench: iterations 400000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $found = $corp->read('CN=Employees,OU=Company,DC=example,DC=test', { select: ['groupType'] });
        if ($found == null) {
            return 0;
        }
        Core\Ldap\Entry $group = $found;
        // Each round uses the total of the round before, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $type = $group->groupType();
            if ($type != null && $type->security()) {
                $total = $total + 1 + $total % 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
