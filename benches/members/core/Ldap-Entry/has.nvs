<?nvs
// Measures how fast `has` checks an attribute, as a program does before it reads an optional field.
// bench: iterations 400000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $found = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['mail', 'department', 'title'] });
        if ($found == null) {
            return 0;
        }
        Core\Ldap\Entry $person = $found;
        // The count so far chooses the name, so the loop cannot be left out.
        // `title` is there and `telephoneNumber` is not.
        array<string> $names = ['title', 'telephoneNumber'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if ($person->has($names[($total % 2) as int])) {
                $total = $total + 3;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
