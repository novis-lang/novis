<?nvs
// Measures how fast `sids` reads a user's security groups, as a program does to check what a user may do.
// bench: iterations 200000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $found = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['tokenGroups', 'objectSid'] });
        if ($found == null) {
            return 0;
        }
        Core\Ldap\Entry $person = $found;
        // The count so far chooses the attribute, so the loop cannot be left out.
        array<string> $names = ['tokenGroups', 'objectSid'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count($person->sids($names[(($total + $i) % 2) as int]) ?? []);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
