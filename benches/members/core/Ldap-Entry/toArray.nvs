<?nvs
// Measures how fast `toArray` returns every attribute of an entry, as a program does to show all of its fields.
// bench: iterations 400000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        array<Core\Ldap\Entry> $people = [];
        var $found = $corp->search(Core\Ldap\Filter::equals('department', 'Sales'), { select: ['mail', 'department', 'memberOf'] });
        foreach ($found as Core\Ldap\Entry $person) {
            $people[] = $person;
        }
        // The count so far chooses the entry, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count($people[($total % 2) as int]->toArray());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
