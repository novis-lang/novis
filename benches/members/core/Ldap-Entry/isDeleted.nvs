<?nvs
// Measures how fast `isDeleted` checks an entry, as a sync job does for each account it finds.
// bench: iterations 400000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp-accounts');
        string $unit = 'OU=Bench Deleted,DC=example,DC=test';
        string $user = 'CN=Bench Gone,' . $unit;
        array<string> $leftovers = [$user, $unit];
        foreach ($leftovers as string $left) {
            try {
                $corp->delete($left);
            } catch (Core\Ldap\LdapError $missing) {
            }
        }
        $corp->add($unit, ['objectClass' => 'organizationalUnit']);
        $corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'bench.gone']);
        var $live = $corp->read($user, { select: ['objectSid'] });
        string $sid = $live?->sid('objectSid')?->toString() ?? '';
        $corp->delete($user);

        // One deleted entry and one live entry.
        array<Core\Ldap\Entry> $entries = [];
        var $bySid = Core\Ldap\Filter::equals('objectSid', $sid);
        foreach ($corp->search($bySid, { showDeleted: true }) as Core\Ldap\Entry $gone) {
            $entries[] = $gone;
        }
        var $unitEntry = $corp->read($unit, { select: ['ou'] });
        if ($unitEntry != null) {
            $entries[] = $unitEntry;
        }
        $corp->delete($unit);
        if (Core\Arr::count($entries) != 2) {
            return 0;
        }

        // The count so far chooses the entry, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if ($entries[($total % 2) as int]->isDeleted()) {
                $total = $total + 3;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
