<?nvs
// Measures how fast `instant` reads one time, as a program does to show when a password was last changed.
// bench: iterations 400000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $found = $corp->read('CN=Anna Berg,OU=Company,DC=example,DC=test', { select: ['whenCreated', 'pwdLastSet'] });
        if ($found == null) {
            return 0;
        }
        Core\Ldap\Entry $person = $found;
        // The count so far chooses the attribute, so the loop cannot be left out.
        // One is text and one is a number, so both ways of writing a time are measured.
        array<string> $names = ['whenCreated', 'pwdLastSet'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            ?Core\Time\Instant $at = $person->instant($names[(($total + $i) % 2) as int]);
            if ($at != null && $at->toEpochSeconds() > 0) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
