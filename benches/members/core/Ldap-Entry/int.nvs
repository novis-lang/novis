<?nvs
// Measures how fast `int` reads one whole number, as a program does to check a domain's password rules.
// bench: iterations 400000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $found = $corp->read('DC=example,DC=test', { select: ['minPwdLength', 'pwdHistoryLength'] });
        if ($found == null) {
            return 0;
        }
        Core\Ldap\Entry $domain = $found;
        // The count so far chooses the attribute, so the loop cannot be left out.
        array<string> $names = ['minPwdLength', 'pwdHistoryLength'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + (($domain->int($names[($total % 2) as int]) ?? 0) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
