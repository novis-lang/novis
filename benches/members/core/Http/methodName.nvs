<?nvs
// Turns HTTP methods into text, as a server does when it writes an `Allow` header or a log line.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Http\Method> $methods = [
            Core\Http\Method::Get,
            Core\Http\Method::Post,
            Core\Http\Method::Options,
            Core\Http\Method::Delete,
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the next method depends on the length of the last name
            $total = $total + Core\Str::length(Core\Http::methodName($methods[(($total + $i) % 4) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
