<?nvs
// Measures reading the grade of one step, as a deployment does for every step
// of every plan it reads.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        var $db = Core\Db::connect('notes');
        var $schema = Core\Db\Schema::fromArray([
            'tables' => [
                [
                    'name' => 'notes',
                    'columns' => [
                        ['name' => 'id', 'type' => 'int64', 'identity' => true],
                        ['name' => 'title', 'type' => 'text(200)'],
                    ],
                    'primary_key' => ['id'],
                ],
            ],
        ]);
        var $step = $schema->planAgainst($db)->steps()[0];

        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The grade decides what is added, so the loop cannot be left out.
            $total = $total + ($step->grade() as int) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
