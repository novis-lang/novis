<?nvs
// Reads the minute of a time of day, as a program does when it shows the departures of a timetable.
// bench: iterations 1024
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Core\Time\TimeOfDay> $times = [
            Core\Time\TimeOfDay::at(8, 15),
            Core\Time\TimeOfDay::at(13, 30),
            Core\Time\TimeOfDay::at(23, 45, { second: 59 }),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round, and each minute is a multiple of 3
            $total = $total + $times[(($total + $i) % 3) as int]->minute();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
