<?nvs
// Moves a time of day back, as a program does when it works out when to send a reminder.
// bench: iterations 400000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        Core\Time\TimeOfDay $appointment = Core\Time\TimeOfDay::at(14, 0);
        Core\Time\TimeOfDay $noon = Core\Time\TimeOfDay::at(12, 0);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total is the number of minutes
            Core\Time\TimeOfDay $remind = $appointment->minus(($total % 240) as int, Core\Unit::Minute);
            if ($remind < $noon) {
                $total = $total + 5;
            } else {
                $total = $total + 7;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
