<?nvs
// Reads the nanoseconds of a time of day, as a program does when it writes the fraction of a second of an event.
// bench: iterations 1024
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Core\Time\TimeOfDay> $times = [
            Core\Time\TimeOfDay::at(8, 10, { second: 6, nanos: 300000000 }),
            Core\Time\TimeOfDay::at(13, 30, { second: 24, nanos: 600000000 }),
            Core\Time\TimeOfDay::at(23, 59, { second: 51, nanos: 900000000 }),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round, and each count is a multiple of 3
            $total = $total + $times[(($total + $i) % 3) as int]->nanos();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
