<?nvs
// Finds the next Tuesday after a date, as a program does when it lists the dates of a weekly meeting.
// bench: iterations 256
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): string
    {
        var $date = Core\Time\Date::at(2000, 1, 1);
        uint $i = 0;
        while ($i < $rounds) {
            // chained: each step starts from last round's date
            $date = $date->next(Core\Time\Weekday::Tuesday);
            $i = $i + 1;
        }
        return $date->toIso();
    }
}

echo Bench::run(256), "\n";
