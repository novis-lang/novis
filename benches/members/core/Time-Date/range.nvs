<?nvs
// Lists every day of a month, as a program does when it shows a calendar or the delivery days of a month.
// bench: iterations 256
// bench: complexity linear

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $first = Core\Time\Date::at(2026, 1, 1);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round lists the days of the next month.
            var $days = Core\Time\Date::range($first, $first->endOf(Core\Unit::Month));
            $total = $total + Core\Arr::count($days);
            $first = $first->plus(1, Core\Unit::Month);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
