<?nvs
// Compares two dates, as a program does when it sorts orders or checks a deadline.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): int {
        var $first = Core\Time\Date::at(2023, 12, 31);
        var $second = Core\Time\Date::at(2024, 1, 1);
        var $third = Core\Time\Date::at(2024, 6, 15);
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the three dates move one place each round
            $total = $total + 2 + $first->compareTo($second);
            var $moved = $first;
            $first = $second;
            $second = $third;
            $third = $moved;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
