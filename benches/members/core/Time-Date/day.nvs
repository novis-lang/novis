<?nvs
// Reads the day of the month of a date, as a program does when it bills each customer on the same day every month.
// bench: iterations 1024
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Core\Time\Date> $days = [
            Core\Time\Date::at(2024, 1, 9),
            Core\Time\Date::at(2024, 7, 18),
            Core\Time\Date::at(2023, 12, 27),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round, and each day is a multiple of 3
            $total = $total + $days[(($total + $i) % 3) as int]->day();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
