<?nvs
// Checks whether a date is in a leap year, as a program does before it splits a yearly price into days.
// bench: iterations 512
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Core\Time\Date> $days = [
            Core\Time\Date::at(2024, 1, 3),
            Core\Time\Date::at(2025, 7, 16),
            Core\Time\Date::at(2100, 12, 29),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round
            if ($days[(($total + $i) % 3) as int]->isLeapYear()) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(512), "\n";
