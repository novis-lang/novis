<?nvs
// Moves a date forward by a few days, as a program does when it works out when an invoice is due.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): string {
        var $date = Core\Time\Date::at(-9999, 1, 1);
        int $count = 1;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: each step starts from last round's date
            $date = $date->plus($count, Core\Unit::Day);
            $count = $count % 7 + 1;
            $i = $i + 1;
        }
        return $date->format("yyyy-MM-dd");
    }
}

echo Bench::run(200000), "\n";
