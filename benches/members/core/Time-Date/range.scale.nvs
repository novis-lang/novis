<?nvs
// Measures `Core\Time\Date::range` on one list of days, at growing list lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        var $first = Core\Time\Date::at(2026, 1, 1);
        var $last = $first->plus(($size as int) - 1, Core\Unit::Day);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count(Core\Time\Date::range($first, $last));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
