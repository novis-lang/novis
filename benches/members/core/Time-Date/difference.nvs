<?nvs
// Counts the whole years between two dates, as a program does when it works out the age of a person.
// bench: iterations 512
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        array<Core\Time\Date> $born = [
            Core\Time\Date::at(1990, 1, 1),
            Core\Time\Date::at(2002, 2, 28),
            Core\Time\Date::at(1975, 3, 1),
        ];
        var $today = Core\Time\Date::at(2026, 5, 20);
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the date counted in this round
            $total = $total + $born[(($total as uint + $i) % 3) as int]->difference($today, Core\Unit::Year);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(512), "\n";
