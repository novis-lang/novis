<?nvs
// Moves a date back by a few days, as a program does when it finds the start of a billing period.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): string {
        var $date = Core\Time\Date::at(9999, 12, 31);
        int $count = 1;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: each step starts from last round's date
            $date = $date->minus($count, Core\Unit::Day);
            $count = $count % 7 + 1;
            $i = $i + 1;
        }
        return $date->format("yyyy-MM-dd");
    }
}

echo Bench::run(256), "\n";
