<?nvs
// Reads the year of a date, as a program does when it groups invoices by year.
// bench: iterations 1024
// bench: calls 1
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        array<Core\Time\Date> $days = [
            Core\Time\Date::at(2022, 1, 3),
            Core\Time\Date::at(2025, 7, 16),
            Core\Time\Date::at(2028, 12, 29),
        ];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the value read in this round, and each year is a multiple of 3
            $total = $total + $days[(($total as uint + $i) % 3) as int]->year();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
