<?nvs
// Reads the year of the ISO week of a date, as a program does when it groups days by week.
// bench: iterations 1024
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        array<Core\Time\Date> $days = [
            Core\Time\Date::at(2027, 1, 1),
            Core\Time\Date::at(2026, 5, 20),
            Core\Time\Date::at(2023, 6, 1),
        ];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the date read in this round
            $total = $total + $days[(($total as uint + $i) % 3) as int]->isoWeekYear();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
