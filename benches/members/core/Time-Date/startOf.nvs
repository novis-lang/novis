<?nvs
// Finds the first day of the month of a date, as a program does when it starts a monthly report.
// bench: iterations 256
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        var $date = Core\Time\Date::at(2024, 7, 11);
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: each round starts 40 days after last round's result
            var $start = $date->startOf(Core\Unit::Month);
            $total = $total + ($start->day() as int);
            $date = $start->plus(40, Core\Unit::Day);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
