<?nvs
// Finds the moment a date starts in a time zone, as a program does to list the orders placed on one day.
// bench: iterations 256
// bench: calls 2
// bench: allocations 3
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $zone = Core\Time\Zone::of('Europe/Berlin');
        array<Core\Time\Date> $days = [
            Core\Time\Date::at(2024, 1, 3),
            Core\Time\Date::at(2024, 3, 30),
            Core\Time\Date::at(2023, 10, 27),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the date of this round, and each day is a multiple of 3
            var $start = $days[(($total + $i) % 3) as int]->atStartOfDay($zone);
            $total = $total + $start->day();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
