<?nvs
// Reads the quarter of a date, as a program does when it adds up sales by quarter.
// bench: iterations 1024
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        array<Core\Time\Date> $days = [
            Core\Time\Date::at(2026, 2, 10),
            Core\Time\Date::at(2026, 3, 31),
            Core\Time\Date::at(2026, 11, 10),
        ];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: $total picks the date read in this round
            $total = $total + ($days[(($total as uint + $i) % 3) as int]->quarter() as int);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
