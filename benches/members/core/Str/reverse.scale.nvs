<?nvs
// Measures `Core\Str::reverse` on one word, at growing word lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $word = Core\Str::repeat('ab', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::reverse($word));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
