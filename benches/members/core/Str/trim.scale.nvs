<?nvs
// Measures `Core\Str::trim` on one form field with spaces on both sides, at growing numbers of spaces.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $field = Core\Str::repeat(' ', $size) . 'Anna' . Core\Str::repeat(' ', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::trim($field));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
