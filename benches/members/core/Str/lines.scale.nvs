<?nvs
// Measures `Core\Str::lines` splitting one text into lines, at growing numbers of lines.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $text = Core\Str::repeat("line\n", $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count(Core\Str::lines($text));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
