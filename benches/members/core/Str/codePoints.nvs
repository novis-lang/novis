<?nvs
// Lists the code points of a short user name, as a program does before it checks for unusual characters.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["ada", "jürgen", "zoë_1984"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count(Core\Str::codePoints($names[(($total + $i) % 3) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
