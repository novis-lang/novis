<?nvs
// Removes the zeros before an order number, as a program does before it shows the number.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $numbers = ["000042", "1050", "0000731", "00009"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $number = $numbers[(($total + $i) % 4) as int];
            $total = $total + Core\Str::length(Core\Str::trimStart($number, {characters: "0"}));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
