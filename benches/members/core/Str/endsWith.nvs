<?nvs
// Checks whether a file name ends with ".png", as a program does when it accepts an upload.
// bench: iterations 512
// bench: calls 0
// bench: allocations 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["logo.png", "invoice.pdf", "photo.jpg", "icon.png"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if (Core\Str::endsWith($names[(($total + $i) % 4) as int], ".png")) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(512), "\n";
