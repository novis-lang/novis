<?nvs
// Builds one symbol from its number, as a program does when it reads a reference like `&#233;` in imported text.
// bench: iterations 256
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<uint> $numbers = [233, 8364, 0x1F600];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length(Core\Str::fromCodePoint($numbers[(($total + $i) % 3) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
