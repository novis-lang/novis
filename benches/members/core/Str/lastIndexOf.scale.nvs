<?nvs
// Measures `Core\Str::lastIndexOf` finding the only `/` in one path, at growing path lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $path = '/' . Core\Str::repeat('a', $size);
        uint $none = 0;
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + (Core\Str::lastIndexOf($path, '/') ?? $none) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
