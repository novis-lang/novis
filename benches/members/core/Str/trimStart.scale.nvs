<?nvs
// Measures `Core\Str::trimStart` removing the zeros before one order number, at growing numbers of zeros.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $number = Core\Str::repeat('0', $size) . '42';
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::trimStart($number, {characters: '0'})) + $i % 2;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
