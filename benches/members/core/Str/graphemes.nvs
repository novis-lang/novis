<?nvs
// Divides a short name into its characters, as a program does before it checks each character of a form field.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["anna_m", "Zoë Müller", "José 👍🏽"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count(Core\Str::graphemes($names[(($total + $i) % 3) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
