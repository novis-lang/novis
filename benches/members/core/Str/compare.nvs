<?nvs
// Compares two short names, as a sort does many times for every list it puts in order.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["Alice", "alice", "Bob", "Carol", "carl"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            int $sign = Core\Str::compare($names[(($total + $i) % 5) as int], $names[($i % 5) as int]);
            $total = $total + ($sign + 1) as uint;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
