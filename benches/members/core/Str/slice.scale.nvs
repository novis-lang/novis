<?nvs
// Measures `Core\Str::slice` taking all but the last character of one name, at growing name lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $name = Core\Str::repeat('é', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::slice($name, 0, $size as int - 1));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
