<?nvs
// Measures `Core\Str::upperFirst` on one status word, at growing word lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $status = 'pending' . Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::upperFirst($status));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
