<?nvs
// Measures `Core\Str::normalize` changing one name to `Nfc`, at growing name lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $name = Core\Str::repeat('é', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::normalize($name, Core\NormalForm::Nfc));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
