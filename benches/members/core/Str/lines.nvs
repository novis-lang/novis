<?nvs
// Splits a short text into lines, as a program does when it reads a small file or a text field line by line.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $texts = ["name=Shop\nport=8080\n", "a\r\nb\r\nc", "one line only"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Arr::count(Core\Str::lines($texts[$pick as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
