<?nvs
// Takes the first eight characters of a product name, as a program does to show a short preview.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["Café au lait, large", "Größenwahn T-shirt", "Blue notebook, 80 pages"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Str::length(Core\Str::slice($names[$pick as int], 0, 8));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
