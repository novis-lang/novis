<?nvs
// Pads a name with spaces, as a program does when it prints a table in a terminal.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["Apples", "Pears", "Crème brûlée"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Str::length(Core\Str::padEnd($names[$pick as int], 14 + $total % 2));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
