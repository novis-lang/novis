<?nvs
// Wraps a short message at 10 characters, as a program does before it prints a notice in a narrow column.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $messages = ["Free shipping on all orders", "Your order has been sent", "Café au lait, extra warm"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Str::length(Core\Str::wrap($messages[$pick as int], 10));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
