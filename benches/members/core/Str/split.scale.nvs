<?nvs
// Measures `Core\Str::split` splitting one list at its commas, at growing numbers of tags.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $list = Core\Str::repeat('tag,', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count(Core\Str::split($list, ','));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
