<?nvs
// Measures `Core\Str::length` on one label, at growing label lengths.
// It shows how the cost of `length` grows when the input grows.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $label = Core\Str::repeat('é', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length($label);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
