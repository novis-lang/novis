<?nvs
// Changes a short word to lower case, as a program does before it compares a name or an email address.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $words = ["Anna@Example.DE", "ÄRGERLICH", "Content-Type"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Str::length(Core\Str::lower($words[$pick as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
