<?nvs
// Measures `Core\Str::replaceAll` filling the placeholders of one message, at growing message lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $message = Core\Str::repeat('Hello {name}! ', $size);
        array<string> $values = ["{name}" => "Anna", "{order}" => "#1042"];
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::replaceAll($message, $values));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
