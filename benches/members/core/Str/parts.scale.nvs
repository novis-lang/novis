<?nvs
// Measures `Core\Str::parts` splitting one condition, at growing numbers of holes.
// bench: start 256
// bench: max 4096

class Order
{
    public int $total = 0;
}

class Bench
{
    public static function run(uint $size): uint
    {
        string<property<Order>> $condition = Core\Str::repeat('{total} > 1 AND ', $size) as string<property<Order>>;
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count(Core\Str::parts($condition));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
