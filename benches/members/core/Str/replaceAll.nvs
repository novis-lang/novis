<?nvs
// Fills in the placeholders of a short message, as a program does before it sends an email.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $messages = ["Hello {name}!", "Order {order} for {name}", "No placeholders"];
        array<string> $values = ["{name}" => "Anna", "{order}" => "#1042"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Str::length(Core\Str::replaceAll($messages[$pick as int], $values));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
