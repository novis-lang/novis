<?nvs
// Checks whether a short log line contains a word, as a program does when it filters a log.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $lines = ["INFO server started", "ERROR disk is full", "INFO retrying", "WARN slow reply"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if (Core\Str::contains($lines[(($total + $i) % 4) as int], "ERROR")) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
