<?nvs
// Measures `Core\Str::at` reading the last character of a word, at growing word lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $word = Core\Str::repeat('é', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::at($word, $size as int - 1));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
