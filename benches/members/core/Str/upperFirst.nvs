<?nvs
// Changes the first letter of a word to upper case, as a program does when it shows a stored status as a label.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["closed", "überprüft", "cancelled"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Str::length(Core\Str::upperFirst($names[$pick as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
