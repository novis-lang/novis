<?nvs
// Hides all but the last four digits of a short number, as a program does before it prints a receipt.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $numbers = ["4111111111111111", "5500005555555559", "340000000000009"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Str::length(Core\Str::replaceRange($numbers[$pick as int], 0, -4, "****"));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
