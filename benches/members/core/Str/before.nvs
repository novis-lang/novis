<?nvs
// Takes the name before "=" in a short setting line, as a program does when it reads a config file.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $lines = ["host=example.com", "port=8080", "user=admin", "mode=fast"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            ?string $key = Core\Str::before($lines[($total % 4) as int], "=");
            if ($key != null) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
