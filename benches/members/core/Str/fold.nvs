<?nvs
// Folds a short email address, as a program does before it looks up a user by that address.
// bench: iterations 400000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $emails = ["Ada@Example.com", "BOB@example.COM", "Jürgen.Groß@Example.de"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length(Core\Str::fold($emails[(($total + $i) % 3) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
