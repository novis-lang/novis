<?nvs
// Pads a number with zeros in front, as a program does when it prints an invoice or order number.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $numbers = ["7", "42", "1305"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Str::length(Core\Str::padStart($numbers[$pick as int], 6 + $total % 2, "0"));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
