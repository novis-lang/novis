<?nvs
// Measures `Core\Str::upper` on one code, at growing code lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $code = Core\Str::repeat('ä', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::upper($code));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
