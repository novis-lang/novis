<?nvs
// Measures `Core\Str::join` joining a list of parts with a separator, at growing numbers of parts.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<string> $parts = [];
        uint $n = 0;
        while ($n < $size) {
            $parts[] = 'ab';
            $n = $n + 1;
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::join($parts, '-'));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
