<?nvs
// Measures `Core\Str::padEnd` padding one name with spaces, at growing widths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::padEnd('Anna', $size + $total % 2));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
