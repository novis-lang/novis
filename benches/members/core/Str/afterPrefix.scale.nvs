<?nvs
// Measures `Core\Str::afterPrefix` on one form field name, at growing name lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $key = 'openingHours-' . Core\Str::repeat('1', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::afterPrefix($key, 'openingHours-') ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
