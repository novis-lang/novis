<?nvs
// Measures `Core\Str::chunk` dividing a number into groups of four digits, at growing number lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $number = Core\Str::repeat('4', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count(Core\Str::chunk($number, 4));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
