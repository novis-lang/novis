<?nvs
// Counts the commas in a short line, as a program does before it splits a CSV row.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $lines = ["1042,Ada,London", "7,Bob", "88,Eve,Paris,FR", "3"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::countOf($lines[(($total + $i) % 4) as int], ",");
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
