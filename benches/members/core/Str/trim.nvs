<?nvs
// Removes the spaces around a form field, as a program does with every value somebody types.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $fields = ["  anna@example.com ", "Berlin", "\t12345\n", " New York  "];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length(Core\Str::trim($fields[(($total + $i) % 4) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
