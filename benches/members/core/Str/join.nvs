<?nvs
// Joins the parts of a date with a separator, as a program does when it writes a date into a report or a file name.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<array<string>> $dates = [["2026", "09", "28"], ["28", "09", "2026"], ["2026", "9", "7"]];
        array<string> $separators = ["-", ".", "/"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Str::length(Core\Str::join($dates[$pick as int], $separators[$pick as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
