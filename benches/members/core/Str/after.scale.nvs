<?nvs
// Measures `Core\Str::after` on one setting line, at growing line lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $line = Core\Str::repeat('k', $size) . '=value';
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Str::after($line, '=') ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
