<?nvs
// Fills a short template with a name and a number, as a program does when it builds a status line.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["ada", "jürgen", "zoë"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length(Core\Str::format("%s has %d items", $names[(($total + $i) % 3) as int], $i));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
