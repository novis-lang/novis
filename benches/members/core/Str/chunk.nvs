<?nvs
// Divides a card number into groups of four digits, as a payment page does before it shows one.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $numbers = ["4111111111111111", "5500000000000004", "340000000000009"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count(Core\Str::chunk($numbers[(($total + $i) % 3) as int], 4));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
