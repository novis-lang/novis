<?nvs
// Changes a short code to upper case, as a program does before it compares a voucher or a country code.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $words = ["sale-2024", "größe", "Content-Type"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $pick = ($total + $i) % 3;
            $total = $total + Core\Str::length(Core\Str::upper($words[$pick as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
