<?nvs
// Measures `get` reading one text value out of this core's cache, at growing text lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        var $store = Core\Cache::local();
        $store->put("row", Core\Str::repeat('a', $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length($store->get("row") as string);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
