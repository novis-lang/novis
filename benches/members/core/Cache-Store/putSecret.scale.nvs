<?nvs
// Measures `putSecret` sealing one token and writing it into this core's cache, at growing token lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        var $store = Core\Cache::local();
        secret bytes $key = Core\Crypto::generateKey();
        array<secret bytes> $keys = [$key];
        string $token = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $store->putSecret("round", $token, 1h, $keys);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
