<?nvs
// Measures removing a value from the memory cache. Each round writes a value
// first, so that there is one to remove.
// bench: iterations 1024
// bench: calls 2
// bench: complexity linear

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $store = Core\Cache::memory();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The value written in one round is built from the round before
            // it, so no round can be left out.
            $total = $total + 1;
            $store->put('round', $total);
            $store->forget('round');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
