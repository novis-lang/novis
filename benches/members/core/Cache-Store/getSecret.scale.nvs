<?nvs
// Measures `getSecret` opening one sealed token from this core's cache, at growing token lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        var $store = Core\Cache::local();
        secret bytes $key = Core\Crypto::generateKey();
        array<secret bytes> $keys = [$key];
        $store->putSecret("token", Core\Str::repeat('a', $size), 1h, $keys);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            int $step = $store->getSecret("token", $keys) == null ? 2 : 1;
            $total = $total + ($step as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
