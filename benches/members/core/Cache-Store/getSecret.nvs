<?nvs
// Measures opening one sealed secret out of this core's cache. A request does
// this before every outbound call that needs the token.
// bench: iterations 100000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        var $store = Core\Cache::local();
        secret bytes $key = Core\Crypto::generateKey();
        array<secret bytes> $keys = [$key];
        array<string> $names = ["token-a", "token-b", "token-c"];
        $store->putSecret("token-a", "at-7f3c9b21", 1h, $keys);
        $store->putSecret("token-b", "at-91abf042", 1h, $keys);
        $store->putSecret("token-c", "at-2d40c8e7", 1h, $keys);

        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The name read in one round is chosen by the round before it, so
            // no round can be left out.
            int $pick = ($total % 3) as int;
            int $step = $store->getSecret($names[$pick], $keys) == null ? 2 : 1;
            $total = $total + ($step as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
