<?nvs
// Measures sealing one secret and writing it into this core's cache. A request
// does this after it fetches a token that it wants the next request to reuse.
// bench: iterations 100000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        var $store = Core\Cache::local();
        secret bytes $key = Core\Crypto::generateKey();
        array<secret bytes> $keys = [$key];
        array<string> $tokens = ["at-7f3c9b21", "at-91abf042", "at-2d40c8e7"];

        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The secret written in one round is chosen by the round before
            // it, so no round can be left out.
            int $pick = ($total % 3) as int;
            $store->putSecret("round", $tokens[$pick], 1h, $keys);
            $total = $total + ($pick as uint) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
