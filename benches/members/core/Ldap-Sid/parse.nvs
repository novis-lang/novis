<?nvs
// Measures how fast `parse` reads SID text, as a program does with a SID from a form or a file.
// bench: iterations 100000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The total so far chooses the text, so the loop cannot be left out.
        array<string> $texts = [
            'S-1-5-32-544',
            'S-1-5-21-1004336348-1177238915-682003330-1105',
            'S-1-1-0',
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $sid = Core\Ldap\Sid::parse($texts[($total % 3) as int]);
            $total = $total + ($sid->rid() % 7) as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
