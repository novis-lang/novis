<?nvs
// Sends a reconnection time, as a stream does before the server stops for a restart.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(Core\Sse $sse, int $rounds): int {
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            $sse->retry(Core\Time\Duration::milliseconds($total % 5000));
            $total = $total + ($total % 7) + 1;   // chained: each wait depends on the last
            $i = $i + 1;
        }
        return $total;
    }
}

// `retry()` writes to an open stream, so the program opens one first.
Core\Sse $sse = Core\Sse::stream();
echo Bench::run($sse, 256), "\n";
