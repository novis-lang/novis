<?nvs
// Reads a value published to a topic, as a live feed does for every update it forwards to its client.
// bench: iterations 20000
// bench: complexity linear

class Bench {
    public static function run(Core\Sse $sse, uint $rounds): uint {
        Core\Topic::subscribe("feed:updates");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Topic::publish("feed:updates", $total % 7);
            ?Core\Sse\Message $message = $sse->receive();
            uint $posted = $message?->value() as uint;
            $total = $total + $posted + 1;   // chained: the next update depends on this one
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(Core\Sse::current(), 20000), "\n";
