<?nvs
// Starts an event stream, as a request does before it sends its first event.
// bench: iterations 200000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Sse $sse = Core\Sse::stream();
            $total = $total + ($total % 3) + 1;   // chained: each round depends on the last
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
