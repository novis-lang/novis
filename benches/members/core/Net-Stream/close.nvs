<?nvs
// Closes a TCP connection, as a client does after each request to a server. Each round also connects and accepts.
// bench: iterations 200
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        Core\Net\Listener $server = Core\Net::listen("127.0.0.1", 0);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Net\Stream $client = Core\Net::connect("127.0.0.1", $server->port(), 5s);
            Core\Net\Stream $connection = $server->accept(5s);
            // Each round adds to a total, so no round can be skipped.
            $total = $total + ($server->port() + $i) % 2;
            $client->close();
            $connection->close();
            $i = $i + 1;
        }
        $server->close();
        return $total;
    }
}

echo Bench::run(200) <= 200 ? "done" : "wrong", "\n";
