<?nvs
// Closes a TCP server, as a test does after it starts a server for one case. Each round also opens the server.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Net\Listener $server = Core\Net::listen("127.0.0.1", 0);
            // Each round adds the port it closed, so no round can be skipped.
            $total = $total + $server->port() % 2;
            $server->close();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256) <= 2000 ? "done" : "wrong", "\n";
