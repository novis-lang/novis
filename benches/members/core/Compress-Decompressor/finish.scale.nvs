<?nvs
// Measures closing a decompression stream, at growing amounts of data given to it.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        bytes $frame = Core\Compress::compress(Core\Str::repeat("order 1042\n", $size), Core\Codec::Zstd);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            var $stream = Core\Compress::decompressor(Core\Codec::Zstd);
            $stream->add($frame);
            $total = $total + Core\Bytes::length($stream->finish());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
