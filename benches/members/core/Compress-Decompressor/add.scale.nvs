<?nvs
// Measures adding one piece to an open decompression stream, at growing piece sizes.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        bytes $piece = Core\Bytes::fill($size, 65);
        var $stream = Core\Compress::decompressor(Core\Codec::Gzip);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $stream->add($piece);
            $total = $total + $i + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
