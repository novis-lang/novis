<?nvs
// Encodes a small settings object, as a program does before it saves the object in a cache.
// bench: iterations 200000

class Settings {
    public string $theme = "dark";
    public uint $pageSize = 20;
    public array<string> $columns;
    public function constructor() {
        $this->columns = ["name", "email", "created"];
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        Settings $settings = new Settings();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $settings->pageSize = $total % 100;
            $total = $total + Core\Bytes::length(Core\Serialize::encode($settings)) % 7 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
