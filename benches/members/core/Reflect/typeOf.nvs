<?nvs
// Checks what kind of value a `mixed` contains, as code does before it uses a decoded value.
// bench: iterations 1024
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<mixed> $values = [7, "seven", 7.5, true];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which value is checked comes from last round's total,
            // so no round can be reused.
            mixed $value = $values[($total % 4) as int];
            if (Core\Reflect::typeOf($value) == Core\Reflect\TypeKind::Text) {
                $total = $total + 3;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
