<?nvs
// Describes the class of an object, as a log or an error report does to name what it received.
// bench: iterations 256
// bench: complexity constant

class Order {
    public int $id = 0;
    public string $customer = "";
}

class Refund {
}

class Bench {
    public static function run(uint $rounds): uint {
        array<mixed> $objects = [new Order(), new Refund()];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which object is described comes from last round's total,
            // so no round can be reused.
            var $info = Core\Reflect::forObject($objects[($total % 2) as int]);
            $total = $total + Core\Arr::count($info->properties()) as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
