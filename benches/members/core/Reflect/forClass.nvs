<?nvs
// Describes a class by its name, as a program does when it loads a class named in a setting.
// bench: iterations 100000
// bench: complexity constant

class Order {
    public int $id = 0;
    public string $customer = "";
}

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["Order", "Bench"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which class is described comes from last round's total,
            // so no round can be reused.
            var $info = Core\Reflect::forClass($names[($total % 2) as int]);
            if ($info != null) {
                $total = $total + Core\Arr::count($info->properties()) as uint + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
