<?nvs
// Measures encrypting and signing a push message for a browser, as a shop does for each order update.
// bench: iterations 256
// bench: complexity linear

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The endpoint is a private address, so each send encrypts and signs the message,
        // then throws a `RuntimeError` before it connects.
        string $json = '{"endpoint":"https://10.0.0.12/send/abc","keys":{'
            . '"p256dh":"BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4",'
            . '"auth":"BTBZMqHH6r4Tts7J_aSIgg"}}';
        Core\WebPush\Subscription $to = Core\WebPush::subscription($json);
        Core\Crypto\KeyPair $vapid = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256);
        array<bytes> $payloads = [
            Core\Encoding::encodeText('{"title":"Order shipped","id":4711}', Core\Charset::Utf8),
            Core\Encoding::encodeText('{"title":"New message"}', Core\Charset::Utf8),
            Core\Encoding::encodeText('{"title":"Payment received","id":815}', Core\Charset::Utf8),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The payload in each round is chosen by the round before, so no round can be left out.
            try {
                Core\WebPush\Sent $sent = Core\WebPush::send($to, $payloads[($total % 3) as int], $vapid, 'mailto:admin@example.com');
                $total = $total + ($sent->status() as uint);
            } catch (RuntimeError $error) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
