<?nvs
// Reads a browser's push subscription, as the route that saves it with the user does.
// bench: iterations 4096
// bench: complexity linear

class Bench
{
    public static function run(uint $rounds): uint
    {
        string $keys = '"keys":{"p256dh":"BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4",'
            . '"auth":"BTBZMqHH6r4Tts7J_aSIgg"}';
        array<string> $texts = [];
        uint $n = 0;
        while ($n < 4) {
            $texts[] = '{"endpoint":"https://push.example.com/send/' . Core\Str::repeat('a', 40 + $n) . '",'
                . '"expirationTime":null,' . $keys . '}';
            $n = $n + 1;
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks the text
            Core\WebPush\Subscription $read = Core\WebPush::subscription($texts[($total % 4) as int]);
            if ($read->endpoint() == '') {
                $total = $total + 2;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(4096), "\n";
