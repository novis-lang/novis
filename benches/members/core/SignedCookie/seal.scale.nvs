<?nvs
// Measures `Core\SignedCookie::seal` on one value, at growing value lengths.
// bench: start 256
// bench: max 2048

class Bench
{
    public static function run(uint $size): uint
    {
        array<secret bytes> $keys = [Core\Crypto::generateKey()];
        string $value = 'user=' . Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string $cookie = Core\SignedCookie::seal($value, $keys);
            $total = $total + Core\Str::length($cookie) % 7 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
