<?nvs
// Measures `Core\SignedCookie::open` on one cookie, at growing cookie lengths.
// bench: start 256
// bench: max 2048

class Bench
{
    public static function run(uint $size): uint
    {
        array<secret bytes> $keys = [Core\Crypto::generateKey()];
        string $cookie = Core\SignedCookie::seal('user=' . Core\Str::repeat('a', $size), $keys);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string $value = Core\SignedCookie::open($cookie, $keys);
            $total = $total + Core\Str::length($value) % 7 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
