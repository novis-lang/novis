<?nvs
// Measures `Core\Regex::matchAll` on one post, at growing post lengths.
// The post has one tag for every eight characters.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $post = Core\Str::repeat('#tag abc', $size);
        Core\Regex\Pattern $tag = Core\Regex::compile('#(\w+)');
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            var $tags = Core\Regex::matchAll($post, $tag);
            $total = $total + Core\Arr::count($tags) as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
