<?nvs
// Measures `Core\Regex::quote` on one search text, at growing text lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $search = Core\Str::repeat('v2.1 (beta)+', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            string $quoted = Core\Regex::quote($search);
            $total = $total + Core\Str::length($quoted) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
