<?nvs
// Finds every tag in a short line of text, as a program does when it reads hashtags from a post.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $posts = ["#news today", "Sunny #weather #city", "#a #b #c"];
        Core\Regex\Pattern $tag = Core\Regex::compile('#(\w+)');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which post is searched comes from last round's total, so no round can be reused.
            var $tags = Core\Regex::matchAll($posts[($total % 3) as int], $tag);
            $total = $total + Core\Arr::count($tags) as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
