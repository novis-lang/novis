<?nvs
// Measures `Core\Regex::compile` on one pattern, at growing pattern lengths.
// The same pattern is compiled again in every round.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $text = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Regex\Pattern $pattern = Core\Regex::compile($text, {
                caseInsensitive: $total % 2 == 0,
            });
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
