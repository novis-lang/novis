<?nvs
// Measures `Core\Regex::match` on one line of text, at growing line lengths.
// The order number is at the end of the line, so the search reads the whole line.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $line = Core\Str::repeat('a', $size) . ' order 4711';
        Core\Regex\Pattern $order = Core\Regex::compile('order (\d+)', {caseInsensitive: true});
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            var $found = Core\Regex::match($line, $order);
            $total = $total + ($found?->offset() ?? 0) as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
