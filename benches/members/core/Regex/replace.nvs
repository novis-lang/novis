<?nvs
// Changes the order of the parts of a date, as a program does before it shows a date to a reader.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $dates = ["2026-09-27", "Due 2027-01-05", "no date here"];
        Core\Regex\Pattern $date = Core\Regex::compile('(\d{4})-(\d{2})-(\d{2})');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which text is changed comes from last round's total, so no round can be reused.
            string $shown = Core\Regex::replace($dates[($total % 3) as int], $date, '$3/$2/$1');
            $total = $total + Core\Str::length($shown) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
