<?nvs
// Measures `Core\Regex::split` on one list, at growing list lengths.
// The list has one comma for every eight characters.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $line = Core\Str::repeat('red , b ', $size);
        Core\Regex\Pattern $comma = Core\Regex::compile('\s*,\s*');
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<string> $pieces = Core\Regex::split($line, $comma);
            $total = $total + Core\Arr::count($pieces) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
