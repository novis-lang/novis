<?nvs
// Changes every amount in a line to upper case with a function, as a program does before it shows a price list.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $lines = ["12 usd and 3 eur", "Total 40 gbp", "no amount here"];
        Core\Regex\Pattern $amount = Core\Regex::compile('\d+ [a-z]{3}');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which line is changed comes from last round's total, so no round can be reused.
            string $shown = Core\Regex::replaceWith($lines[($total % 3) as int], $amount, fn(Core\Regex\Match $m) => Core\Str::upper($m->text()));
            $total = $total + Core\Str::length($shown) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
