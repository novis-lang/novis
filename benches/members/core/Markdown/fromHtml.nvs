<?nvs
// Measures converting a short HTML comment to Markdown, as a program does before it stores a comment as Markdown.
// bench: iterations 256
// bench: calls 2
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $comments = [
            '<p>Thanks, this <b>fixed</b> my build.</p>',
            '<p>See <a href="/docs/setup">the setup page</a> and retry.</p>',
            '<p>It costs 5 * 3 = 15 euros.</p><ul><li>tea</li><li>cake</li></ul>',
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            tainted string $markdown = Core\Markdown::fromHtml($comments[(($total + $i) % 3) as int]);
            $total = $total + Core\Str::length($markdown);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
