<?nvs
// Measures how `text()` returns the plain text of a previewed mail, as a test that checks a link does.
// bench: iterations 2048
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Core\Mail\Preview> $mails = [
            Core\Mail::preview(html`<h1>Your order</h1><p>It has shipped.</p>`),
            Core\Mail::preview('Your code is 482913.'),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + (Core\Str::length($mails[(($total + $i) % 2) as int]->text()) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
