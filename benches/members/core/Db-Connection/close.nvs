<?nvs
// Measures closing a connection that is closed already, as the cleanup of a
// program does when an earlier step gave the connection back.
// bench: iterations 200000
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): uint {
        var $db = Core\Db::connect('notes');
        $db->close();

        // Both entries are that connection, and the count so far picks which
        // one is closed, so the loop cannot be left out.
        array<Core\Db\Connection> $handles = [$db, $db];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $handles[($total % 2) as int]->close();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
