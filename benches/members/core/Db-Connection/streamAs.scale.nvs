<?nvs
// Measures one `select` whose rows are built into objects one at a time, at growing numbers of rows.
// bench: start 64
// bench: max 512
use Core\Db\Derive;

#[Derive]
class Note
{
    public uint $id;
    public uint $n;

    public function constructor(uint $id, uint $n)
    {
        $this->id = $id;
        $this->n = $n;
    }
}

class Bench
{
    public static function run(uint $size): uint
    {
        var $db = Core\Db::connect('notes');
        $db->execute('create table notes (id integer primary key, n int not null)', []);
        array<array<mixed>> $sets = [];
        uint $written = 0;
        while ($written < $size) {
            $sets[] = [$written as int];
            $written = $written + 1;
        }
        $db->executeMany('insert into notes (n) values (?)', $sets);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            foreach ($db->streamAs<Note>('select id, n from notes where n >= ? order by id', [($total % 2) as int]) as Note $note) {
                $total = $total + $note->n;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
