<?nvs
// Measures one insert of one row, as a program does when it writes records one
// at a time.
// bench: iterations 20000

class Bench {
    public static function run(uint $rounds): uint {
        var $db = Core\Db::connect('notes');
        $db->execute('create table notes (id integer primary key, n int not null)', []);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The count so far is the value written, and the count grows by
            // what the write reports, so the loop cannot be left out.
            var $written = $db->execute('insert into notes (n) values (?)', [$total as int]);
            $total = $total + $written->affected();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
