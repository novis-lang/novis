<?nvs
// Measures how fast `rename` gives an entry a new name, as an admin tool does when a team is renamed.
// bench: iterations 200
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp-accounts');
        array<string> $names = ['OU=Bench Rename A,DC=example,DC=test', 'OU=Bench Rename B,DC=example,DC=test'];
        foreach ($names as string $left) {
            try {
                $corp->delete($left);
            } catch (Core\Ldap\LdapError $missing) {
            }
        }
        $corp->add($names[0], ['objectClass' => 'organizationalUnit']);

        // The count so far chooses the direction, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $corp->rename($names[($total % 2) as int], $names[(($total + 1) % 2) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }

        $corp->delete($names[($total % 2) as int]);
        return $total;
    }
}

echo Bench::run(200), "\n";
