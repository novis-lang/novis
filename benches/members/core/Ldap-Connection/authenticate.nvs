<?nvs
// Measures how fast `authenticate` checks a login and password, as a login page does for each visitor.
// bench: iterations 10
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp-accounts');
        string $unit = 'OU=Bench Login,DC=example,DC=test';
        string $user = 'CN=Bench Login,' . $unit;
        array<string> $leftovers = [$user, $unit];
        foreach ($leftovers as string $left) {
            try {
                $corp->delete($left);
            } catch (Core\Ldap\LdapError $missing) {
            }
        }
        $corp->add($unit, ['objectClass' => 'organizationalUnit']);
        $corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'bench.login']);
        $corp->setPassword($user, 'Bench-Pass-42');
        $corp->modify($user, [Core\Ldap\Change::replace('userAccountControl', 512)]);

        // Each round logs in once and counts the login.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $corp->authenticate($user, 'Bench-Pass-42');
            $total = $total + 1;
            $i = $i + 1;
        }

        $corp->delete($user);
        $corp->delete($unit);
        return $total;
    }
}

echo Bench::run(10), "\n";
