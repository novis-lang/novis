<?nvs
// Measures how fast `setPassword` sets a new password, as a help desk tool does when it resets one.
// bench: iterations 200
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp-accounts');
        string $unit = 'OU=Bench Staff,DC=example,DC=test';
        string $user = 'CN=Bench User,' . $unit;
        array<string> $leftovers = [$user, $unit];
        foreach ($leftovers as string $left) {
            try {
                $corp->delete($left);
            } catch (Core\Ldap\LdapError $missing) {
            }
        }
        $corp->add($unit, ['objectClass' => 'organizationalUnit']);
        $corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'bench.user']);

        // The count so far is part of each password, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $corp->setPassword($user, 'Bench-Pass-' . $total . '-Aa');
            $total = $total + 1;
            $i = $i + 1;
        }

        $corp->delete($user);
        $corp->delete($unit);
        return $total;
    }
}

echo Bench::run(200), "\n";
