<?nvs
// Measures how fast `whoami` returns the account, as a health check does before it reports.
// bench: iterations 2000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        // The length of each result is added, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length($corp->whoami());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2000), "\n";
