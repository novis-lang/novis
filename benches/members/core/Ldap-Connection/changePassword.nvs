<?nvs
// Measures how fast `changePassword` changes a password, as a settings page does when a user picks a new one.
// bench: iterations 200
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp-accounts');
        string $unit = 'OU=Bench Changes,DC=example,DC=test';
        string $user = 'CN=Bench Changer,' . $unit;
        array<string> $leftovers = [$user, $unit];
        foreach ($leftovers as string $left) {
            try {
                $corp->delete($left);
            } catch (Core\Ldap\LdapError $missing) {
            }
        }
        $corp->add($unit, ['objectClass' => 'organizationalUnit']);
        $corp->add($user, ['objectClass' => 'user', 'sAMAccountName' => 'bench.changer']);
        $corp->setPassword($user, 'Bench-Pass-0-Aa');

        // Each round changes from last round's password, so the loop cannot be left out.
        // The domain allows one change a day, so `pwdLastSet` 0 first makes a new change due.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $corp->modify($user, [Core\Ldap\Change::replace('pwdLastSet', 0)]);
            $corp->changePassword($user, 'Bench-Pass-' . $total . '-Aa', 'Bench-Pass-' . ($total + 1) . '-Aa');
            $total = $total + 1;
            $i = $i + 1;
        }

        $corp->delete($user);
        $corp->delete($unit);
        return $total;
    }
}

echo Bench::run(200), "\n";
