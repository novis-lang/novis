<?nvs
// Measures how fast `compare` checks one value, as a program does when it tests a person's department.
// bench: iterations 2000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        string $anna = 'CN=Anna Berg,OU=Company,DC=example,DC=test';
        // The count so far chooses the value, so the loop cannot be left out.
        // Anna Berg works in `Sales` and not in `Warehouse`.
        array<string> $departments = ['Sales', 'Warehouse'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if ($corp->compare($anna, 'department', $departments[($total % 2) as int])) {
                $total = $total + 3;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2000), "\n";
