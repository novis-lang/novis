<?nvs
// Measures how fast `delete` removes an entry, as a program does when it cleans up accounts it no longer needs.
// bench: iterations 100
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp-accounts');
        array<string> $names = ['OU=Bench Delete A,DC=example,DC=test', 'OU=Bench Delete B,DC=example,DC=test'];
        foreach ($names as string $left) {
            try {
                $corp->delete($left);
            } catch (Core\Ldap\LdapError $missing) {
            }
        }

        // Each round adds a unit and deletes it again. The count so far chooses the name,
        // so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $name = $names[($total % 2) as int];
            $corp->add($name, ['objectClass' => 'organizationalUnit']);
            $corp->delete($name);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100), "\n";
