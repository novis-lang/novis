<?nvs
// Measures how fast `add` writes a new unit with a description, as a program does when it creates a team.
// bench: iterations 100
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp-accounts');
        array<string> $names = ['OU=Bench Add A,DC=example,DC=test', 'OU=Bench Add B,DC=example,DC=test'];
        foreach ($names as string $left) {
            try {
                $corp->delete($left);
            } catch (Core\Ldap\LdapError $missing) {
            }
        }

        // Each round adds a unit and deletes it again. The count so far chooses the name
        // and the description, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $name = $names[($total % 2) as int];
            $corp->add($name, ['objectClass' => 'organizationalUnit', 'description' => 'team ' . $total]);
            $corp->delete($name);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100), "\n";
