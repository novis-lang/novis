<?nvs
// Measures how fast `changes` checks for changes with a cookie, as a sync job does each time it runs.
// bench: iterations 200
// bench: calls 2
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $sales = Core\Ldap\Filter::equals('department', 'Sales');
        var $first = $corp->changes($sales, { select: ['department'] });
        uint $total = 0;
        foreach ($first as Core\Ldap\Entry $person) {
            $total = $total + 1;
        }
        // Each round gives the cookie of the round before, so the loop cannot be left out.
        tainted bytes $cookie = $first->cookie();
        uint $i = 0;
        while ($i < $rounds) {
            var $next = $corp->changes($sales, { select: ['department'], cookie: $cookie });
            foreach ($next as Core\Ldap\Entry $person) {
                $total = $total + 1;
            }
            $cookie = $next->cookie();
            $total = $total + Core\Bytes::length($cookie) % 2 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200), "\n";
