<?nvs
// Measures how fast `modify` changes one attribute, as a program does when a user edits their profile.
// bench: iterations 200
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp-accounts');
        string $unit = 'OU=Bench Modify,DC=example,DC=test';
        try {
            $corp->delete($unit);
        } catch (Core\Ldap\LdapError $missing) {
        }
        $corp->add($unit, ['objectClass' => 'organizationalUnit']);

        // The count so far is the new value, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $corp->modify($unit, [Core\Ldap\Change::replace('description', 'round ' . $total)]);
            $total = $total + 1;
            $i = $i + 1;
        }

        $corp->delete($unit);
        return $total;
    }
}

echo Bench::run(200), "\n";
