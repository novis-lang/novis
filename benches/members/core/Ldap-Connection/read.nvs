<?nvs
// Measures how fast `read` returns one entry, as a program does when it shows a person's profile.
// bench: iterations 2000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        // The count so far chooses the person, so the loop cannot be left out.
        array<string> $dns = [
            'CN=Anna Berg,OU=Company,DC=example,DC=test',
            'CN=Ben Kohl,OU=Company,DC=example,DC=test',
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $person = $corp->read($dns[($total % 2) as int], { select: ['department'] });
            $total = $total + Core\Str::length($person?->string('department') ?? '') + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2000), "\n";
