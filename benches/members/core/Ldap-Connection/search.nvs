<?nvs
// Measures how fast `search` finds one user by a login name, as a program does before it checks a login.
// bench: iterations 2000
// bench: calls 4
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        // The count so far chooses the login, so the loop cannot be left out.
        array<string> $logins = ['Reader', 'Administrator'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $filter = Core\Ldap\Filter::equals('sAMAccountName', $logins[($total % 2) as int]);
            foreach ($corp->search($filter, { select: ['cn'] }) as Core\Ldap\Entry $user) {
                $total = $total + Core\Str::length($user->string('cn') ?? '');
            }
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2000), "\n";
