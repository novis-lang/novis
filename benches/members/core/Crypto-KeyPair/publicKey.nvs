<?nvs
// Measures working out the public half of a key pair, as a server does when it
// publishes its key or sends it to a peer.
// bench: iterations 20000
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Crypto\KeyPair> $pairs = [
            Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::Ed25519),
            Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::X25519),
            Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256),
        ];
        array<Core\Crypto\KeyKind> $kinds = [
            Core\Crypto\KeyKind::Ed25519,
            Core\Crypto\KeyKind::X25519,
            Core\Crypto\KeyKind::P256,
        ];

        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The pair of every round is chosen by the round before it, so no
            // round can be left out.
            int $which = ($total % 3) as int;
            Core\Crypto\PublicKey $half = $pairs[$which]->publicKey();
            $total = $total + (($half->kind() == $kinds[$which] ? 1 : 0) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
