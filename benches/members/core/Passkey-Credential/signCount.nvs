<?nvs
// Reads the sign counter of a saved passkey, as an application does after each sign-in.
// bench: iterations 4096
// bench: complexity constant

class Bench
{
    public static function run(int $rounds): int
    {
        // Four passkeys with the counters 4, 8, 12 and 16. Each round reads the counter of another one.
        bytes $publicKey = Core\Encoding::fromHex(
            'a4010103272006215820fcce9008a33565248561295a7ce1cccb040b6129bba8ff24744953bbc01261ac',
        );
        array<Core\Passkey\Credential> $passkeys = [];
        int $n = 1;
        while ($n <= 4) {
            $passkeys[] = Core\Passkey\Credential::of(Core\Encoding::fromHex('0a0b0c0d'), $publicKey, Core\Passkey\Credential::Algorithm::Ed25519, $n * 4);
            $n = $n + 1;
        }
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            $total = $total + $passkeys[($total + $i) % 4]->signCount();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(4096), "\n";
