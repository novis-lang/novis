<?nvs
// Reads the algorithm of a saved passkey, as an application does before it saves the passkey.
// bench: iterations 4096
// bench: complexity constant

class Bench
{
    public static function run(int $rounds): int
    {
        // Two ES256 passkeys and two Ed25519 passkeys. Each round reads the algorithm of another one.
        bytes $raw = Core\Crypto::generateKeyPair(Core\Crypto\KeyKind::P256)->publicKey()->write(Core\Crypto\PublicKey::Format::Raw);
        bytes $es256 = Core\Bytes::join([
            Core\Encoding::fromHex('a5010203262001215820'),
            Core\Bytes::slice($raw, 1, 32),
            Core\Encoding::fromHex('225820'),
            Core\Bytes::slice($raw, 33, 32),
        ]);
        bytes $ed25519 = Core\Encoding::fromHex(
            'a4010103272006215820fcce9008a33565248561295a7ce1cccb040b6129bba8ff24744953bbc01261ac',
        );
        bytes $id = Core\Encoding::fromHex('0a0b0c0d');
        array<Core\Passkey\Credential> $passkeys = [
            Core\Passkey\Credential::of($id, $es256, Core\Passkey\Credential::Algorithm::ES256, 0),
            Core\Passkey\Credential::of($id, $ed25519, Core\Passkey\Credential::Algorithm::Ed25519, 0),
            Core\Passkey\Credential::of($id, $es256, Core\Passkey\Credential::Algorithm::ES256, 0),
            Core\Passkey\Credential::of($id, $ed25519, Core\Passkey\Credential::Algorithm::Ed25519, 0),
        ];
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            Core\Passkey\Credential::Algorithm $algorithm = $passkeys[($total + $i) % 4]->algorithm();
            // Each round adds 4 or 8, so the next round reads the next passkey.
            $total = $total + 4 + ($algorithm as int) * 4;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(4096), "\n";
