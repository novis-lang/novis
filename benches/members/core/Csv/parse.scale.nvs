<?nvs
// Measures `Core\Csv::parse` on one document, at growing numbers of rows.
// bench: start 64
// bench: max 512

class Bench
{
    public static function run(uint $size): uint
    {
        string $document = Core\Str::repeat("\"Beans, dried\",500 g,4.10\n", $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count(Core\Csv::parse($document));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
