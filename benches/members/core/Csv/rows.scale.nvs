<?nvs
// Measures reading one CSV file a record at a time, at growing numbers of records.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $path = Core\Path::join(Core\IO::temporaryDir(), 'rows.csv');
        Core\IO::write($path, Core\Str::repeat("\"Beans, dried\",500 g,4.10\n", $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\IO\File $file = Core\IO::open($path, Core\IO\FileMode::Read);
            foreach (Core\Csv::rows($file) as array<string> $record) {
                $total = $total + 1;
            }
            $file->close();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
