<?nvs
// Measures writing one short field of text as bytes, which a program does for
// every field of a file an older system has to read.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $fields = ["Müller", "Größe", "Preis in €"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the field written holds the count the round before gave.
            $total = $total + Core\Bytes::length(
                Core\Encoding::encodeText($fields[$total % 3], Core\Charset::Windows1252),
            );
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
