<?nvs
// Measures writing a 32-byte key as text, which a program does before it puts
// one in a header or a JSON field.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<bytes> $keys = [
            Core\Hash::of(Core\Encoding::encodeText("one", Core\Charset::Utf8), Core\Digest::Sha256),
            Core\Hash::of(Core\Encoding::encodeText("two", Core\Charset::Utf8), Core\Digest::Sha256),
            Core\Hash::of(Core\Encoding::encodeText("three", Core\Charset::Utf8), Core\Digest::Sha256),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the key written holds the count the round before gave.
            $total = $total + Core\Str::length(
                Core\Encoding::toBase64($keys[($total % 3) as int]),
            );
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
