<?nvs
// Measures `Core\Encoding::encodeText` on one field of text, at growing field lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $field = Core\Str::repeat('ü', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Bytes::length(Core\Encoding::encodeText($field, Core\Charset::Windows1252));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
