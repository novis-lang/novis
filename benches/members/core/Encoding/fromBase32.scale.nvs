<?nvs
// Measures `Core\Encoding::fromBase32` on one string, at growing string lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $text = Core\Str::repeat('JBSWY3DP', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Bytes::length(Core\Encoding::fromBase32($text));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
