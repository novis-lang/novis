<?nvs
// Measures reading one two-factor secret back from base32, which a server does
// each time it checks a code a user typed.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $secrets = [
            "JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP",
            "MZXW6YTBMZXW6YTBMZXW6YTBMZXW6YTB",
            "NBSWY3DPNBSWY3DPNBSWY3DPNBSWY3DP",
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the secret read holds the count the round before gave.
            $total = $total + Core\Bytes::length(
                Core\Encoding::fromBase32($secrets[($total % 3) as int]),
            );
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
