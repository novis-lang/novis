<?nvs
// Measures reading a 64-digit checksum back to bytes, which a program does
// before it compares one against a file it already has.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $checksums = [
            "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824",
            "486ea46224d1bb4fb680f34f7c9ad96a8f24ec88be73ea8e5a6c65260e9cb8a7",
            "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the checksum read holds the count the round before gave.
            $total = $total + Core\Bytes::length(
                Core\Encoding::fromHex($checksums[($total % 3) as int]),
            );
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
