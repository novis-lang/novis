<?nvs
// Measures spelling a 32-byte checksum as text, which a program does before it
// prints one or puts it in a cache key.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<bytes> $digests = [
            Core\Hash::of(Core\Encoding::encodeText("one", Core\Charset::Utf8), Core\Digest::Sha256),
            Core\Hash::of(Core\Encoding::encodeText("two", Core\Charset::Utf8), Core\Digest::Sha256),
            Core\Hash::of(Core\Encoding::encodeText("three", Core\Charset::Utf8), Core\Digest::Sha256),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the digest spelled holds the count the round before gave.
            $total = $total + Core\Str::length(
                Core\Encoding::toHex($digests[($total % 3) as int]),
            );
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
