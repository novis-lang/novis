<?nvs
// Measures marking a list of ids for one placeholder, as a page does before it
// reads the rows a person selected.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 1
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        // The count so far chooses the list, so the loop cannot be left out.
        // Both lists hold three ids, so every round marks a run of three.
        array<array<int>> $lists = [[11, 12, 13], [21, 22, 23]];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Db::inList($lists[($total % 2) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
