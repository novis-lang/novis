<?nvs
// Measures checking a column name, as a list page does for the column a visitor
// chose to sort by.
// bench: iterations 300000
// bench: calls 0
// bench: allocations 1

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["orders", "created_at", "customer_id", "_draft2"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The name of every round is chosen by the lengths so far, so the
            // loop cannot be left out.
            string $checked = Core\Db::quoteIdentifier($names[($total % 4) as int]);
            if ($checked == "orders") {
                $total = $total + 3;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(300000), "\n";
