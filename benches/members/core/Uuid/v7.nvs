<?nvs
// Creates a new time-ordered UUID, as a program does when it gives a new database row its key.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Bytes::length(Core\Uuid::v7()->toBytes()) + ($total % 3);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
