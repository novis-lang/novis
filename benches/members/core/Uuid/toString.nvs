<?nvs
// Gets the text of a UUID, as a program does before it writes one into a URL, a log line or JSON.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Uuid> $ids = [
            Core\Uuid::parse("0190d1e6-8e3c-7c2a-9a4b-1f2e3d4c5b6a"),
            Core\Uuid::parse("f9168c5e-ceb2-4faa-b6bf-329bf39fa1e4"),
            Core\Uuid::parse("00112233-4455-6677-8899-aabbccddeeff"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length($ids[($total % 3) as int]->toString()) + ($i % 5);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
