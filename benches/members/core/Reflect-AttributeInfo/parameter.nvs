<?nvs
// Reads which parameter an attribute is written on, as a framework does when it fills the arguments of a handler.
// bench: iterations 400000

class ArticleController {
    #[{path: "/articles/{id}"}]
    public function update(#[{source: "path"}] int $id): void {}
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Reflect\AttributeInfo> $attributes =
            Core\Reflect::forObject(new ArticleController())->attributes();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which attribute is read comes from last round's total,
            // so no round can be reused.
            Core\Reflect\AttributeInfo $attribute = $attributes[($total % 2) as int];
            $total = $total + Core\Str::length($attribute->parameter()) as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
