<?nvs
// Reads the name of an attribute, as a framework does when it looks for its own attributes on a class.
// bench: iterations 400000

type Route = {path: string};

#[Route(path: "/orders")]
#[{cache: 60}]
class OrderController {}

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Reflect\AttributeInfo> $attributes =
            Core\Reflect::forObject(new OrderController())->attributes();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which attribute is read comes from last round's total,
            // so no round can be reused.
            Core\Reflect\AttributeInfo $attribute = $attributes[($total % 2) as int];
            $total = $total + Core\Str::length($attribute->name()) as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
