<?nvs
// Reads which member an attribute is written on, as a validator does when it matches rules to properties.
// bench: iterations 2048
// bench: complexity constant

class Signup {
    #[{required: true}]
    public string $email = "";

    #[{maxLength: 40}]
    public string $nickname = "";
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Reflect\AttributeInfo> $attributes =
            Core\Reflect::forObject(new Signup())->attributes();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which attribute is read comes from last round's total,
            // so no round can be reused.
            Core\Reflect\AttributeInfo $attribute = $attributes[($total % 2) as int];
            $total = $total + Core\Str::length($attribute->target()) as uint;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
