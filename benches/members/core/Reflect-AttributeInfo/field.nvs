<?nvs
// Reads one value of an attribute by its field name, as a framework does when it reads a cache time for a page.
// bench: iterations 400000
// bench: complexity constant

type Cache = {seconds: int, shared: bool};

#[Cache(seconds: 3600, shared: true)]
class PageController {}

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Reflect\AttributeInfo> $attributes =
            Core\Reflect::forObject(new PageController())->attributes();
        Core\Reflect\AttributeInfo $attribute = $attributes[0];
        array<string> $names = ["seconds", "shared"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which field is read comes from last round's total,
            // so no round can be reused.
            mixed $value = $attribute->field($names[($total % 2) as int]);
            if ($value is int) {
                $total = $total + 2;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
