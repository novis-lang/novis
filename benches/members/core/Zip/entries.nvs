<?nvs
// Lists the names in a small archive file, as a program does before it unpacks a saved upload.
// bench: iterations 128
// bench: allocations 32
// bench: calls 2
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // Five entries: `readme.txt`, `src/`, `src/app.nvs`, `src/lib.nvs` and `composer.json`.
        bytes $archive = Core\Encoding::fromBase64('');
        // The second file has extra bytes after the archive. `entries` ignores them.
        string $dir = Core\IO::temporaryDir();
        string $first = Core\Path::join($dir, 'project.zip');
        string $second = Core\Path::join($dir, 'project-trailing.zip');
        Core\IO::write($first, $archive);
        Core\IO::write($second, Core\Bytes::join([$archive, 'trailing' as bytes]));
        array<Core\IO\File> $archives = [
            Core\IO::open($first, Core\IO::FileMode::Read),
            Core\IO::open($second, Core\IO::FileMode::Read),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: which file is listed depends on the last round's total.
            $total = $total + Core\Arr::count(Core\Zip::entries($archives[($total % 2) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(128), "\n";
