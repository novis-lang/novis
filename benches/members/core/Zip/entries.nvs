<?nvs
// Lists the names in a small archive, as a program does before it accepts an upload.
// bench: iterations 20000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        // Five entries: `readme.txt`, `src/`, `src/app.nvs`, `src/lib.nvs` and `composer.json`.
        bytes $archive = Core\Encoding::fromBase64("");
        // The second copy has extra bytes after the archive. `entries` ignores them.
        array<bytes> $archives = [$archive,Core\Bytes::join([$archive, "trailing" as bytes])];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: which archive is listed depends on the last round's total.
            $total = $total + Core\Arr::count(Core\Zip::entries($archives[($total % 2) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
