<?nvs
// Reads one compressed file out of a small archive, as a program does to load a settings file from an upload.
// bench: iterations 20000

class Bench {
    public static function run(uint $rounds): uint {
        // Two compressed files: `config.json` has 45 bytes and `readme.txt` has 244.
        bytes $archive = Core\Encoding::fromBase64("");
        array<string> $names = ["config.json", "readme.txt"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: which file is read depends on the last round's total.
            $total = $total + Core\Bytes::length(Core\Zip::read($archive, $names[$total % 2]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
