<?nvs
// Measures `Core\Zip::entries` on one archive file of 16 files, at growing file sizes.
// bench: start 16384
// bench: max 262144

class Bench
{
    // Builds a ZIP archive with one stored file for each name. All files have the same bytes.
    public static function archive(array<string> $names, bytes $data): bytes
    {
        array<mixed> $sum = Core\Bytes::unpack(Core\Hash::of($data, Core\Hash::Digest::Crc32), 'N');
        uint $crc = $sum[0] as uint;
        uint $size = Core\Bytes::length($data);
        array<bytes> $locals = [];
        array<bytes> $central = [];
        uint $offset = 0;
        foreach ($names as string $name) {
            uint $nameLength = Core\Bytes::length($name as bytes);
            bytes $local = Core\Bytes::join([
                Core\Bytes::pack('VvvvvvVVVvv', 0x04034b50, 20, 0, 0, 0, 0x21, $crc, $size, $size, $nameLength, 0),
                $name as bytes,
                $data,
            ]);
            $locals[] = $local;
            $central[] = Core\Bytes::join([
                Core\Bytes::pack(
                    'VvvvvvvVVVvvvvvVV',
                    0x02014b50,
                    20,
                    20,
                    0,
                    0,
                    0,
                    0x21,
                    $crc,
                    $size,
                    $size,
                    $nameLength,
                    0,
                    0,
                    0,
                    0,
                    0,
                    $offset,
                ),
                $name as bytes,
            ]);
            $offset = $offset + Core\Bytes::length($local);
        }
        bytes $directory = Core\Bytes::join($central);
        uint $count = Core\Arr::count($names);
        bytes $end = Core\Bytes::pack(
            'VvvvvVVv',
            0x06054b50,
            0,
            0,
            $count,
            $count,
            Core\Bytes::length($directory),
            $offset,
            0,
        );
        return Core\Bytes::join([Core\Bytes::join($locals), $directory, $end]);
    }

    public static function run(uint $size): uint
    {
        array<string> $names = [];
        uint $n = 0;
        while ($n < 16) {
            $names[] = 'src/file' . $n . '.nvs';
            $n = $n + 1;
        }
        // Each of the 16 files has `$size` bytes, so the archive grows and the list does not.
        string $path = Core\Path::join(Core\IO::temporaryDir(), 'project.zip');
        Core\IO::write($path, Bench::archive($names, Core\Bytes::repeat('a' as bytes, $size)));
        Core\IO\File $archive = Core\IO::open($path, Core\IO::FileMode::Read);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count(Core\Zip::entries($archive));
            $i = $i + 1;
        }
        $archive->close();
        return $total;
    }
}

echo Bench::run(16384), "\n";
