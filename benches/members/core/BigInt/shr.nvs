<?nvs
// Measures shifting a number to the right, as a program does to read the whole
// part out of a fixed-point value.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        var $base = Core\BigInt::of(3)->shl(96);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the number of places comes from the count of the rounds
            // before it, and stays between 60 and 62.
            $total = $total + (($base->shr(60 + $total % 3))->sign() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
