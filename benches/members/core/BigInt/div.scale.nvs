<?nvs
// Measures `div` on numbers of n/3 to n binary digits, each divided by a number half as long, at growing sizes of n.
// bench: start 64000
// bench: max 512000

class Bench
{
    public static function run(uint $size): uint
    {
        var $one = Core\BigInt::of(1);
        uint $signs = 0;
        // Sixteen sizes from n/3 up to n. Each size is 7% smaller than the one before.
        // Large numbers are divided in parts. Sizes over a range of three times make the cost grow smoothly.
        array<uint> $parts = [1000, 934, 872, 814, 760, 709, 662, 618, 577, 539, 503, 470, 439, 410, 382, 357];
        uint $unit = ($size / 1000) as uint;
        foreach ($parts as uint $part) {
            var $wide = $one->shl($unit * $part)->sub($one);
            var $divisor = $one->shl(($unit * $part / 2) as uint)->add($one);
            $signs = $signs + ($wide->div($divisor)->sign() as uint);
        }
        return $signs;
    }
}

echo Bench::run(64000), "\n";
