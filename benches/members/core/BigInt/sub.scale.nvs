<?nvs
// Measures `sub` on a running balance, at growing numbers of bits.
// bench: start 4096
// bench: max 65536

class Bench
{
    public static function run(uint $size): uint
    {
        var $amount = Core\BigInt::of(1)->shl($size)->sub(Core\BigInt::of(1));
        var $balance = Core\BigInt::of(1)->shl($size + 64);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $balance = $balance->sub($amount);
            $total = $total + ($balance->sign() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(4096), "\n";
