<?nvs
// Measures `parse` on texts of n/3 to n decimal digits, at growing sizes of n.
// bench: start 32000
// bench: max 256000

class Bench
{
    public static function run(uint $size): uint
    {
        uint $signs = 0;
        // Sixteen lengths from n/3 up to n. Each length is 7% shorter than the one before.
        // Long texts are read in halves. Lengths over a range of three times make the cost grow smoothly.
        array<uint> $parts = [1000, 934, 872, 814, 760, 709, 662, 618, 577, 539, 503, 470, 439, 410, 382, 357];
        uint $unit = ($size / 1000) as uint;
        foreach ($parts as uint $part) {
            string $digits = Core\Str::repeat('7', $unit * $part);
            $signs = $signs + (Core\BigInt::parse($digits)->sign() as uint);
        }
        return $signs;
    }
}

echo Bench::run(32000), "\n";
