<?nvs
// Measures dividing a large number by a smaller one, as a program does when it
// turns a balance in its smallest unit into whole units.
// bench: iterations 200000
// bench: complexity quadratic
// proof: gap nvs-stdlib/bigint-division-and-decimal-text-grow-quadratically
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\BigInt> $balances = [
            Core\BigInt::parse("123456789012345678901234567890"),
            Core\BigInt::parse("987654321098765432109876543210"),
        ];
        var $perUnit = Core\BigInt::parse("1000000000000000000");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the number divided this round is picked by the result of
            // the round before.
            $total = $total + ($balances[($total % 2) as int]->div($perUnit)->sign() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
