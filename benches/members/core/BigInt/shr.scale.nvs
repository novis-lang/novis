<?nvs
// Measures `shr` on one number, at growing numbers of bits.
// bench: start 4096
// bench: max 65536

class Bench
{
    public static function run(uint $size): uint
    {
        var $base = Core\BigInt::of(1)->shl($size)->sub(Core\BigInt::of(1));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + (($base->shr(60 + $total % 3))->sign() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(4096), "\n";
