<?nvs
// Measures `neg` on one negative number, at growing numbers of bits.
// bench: start 4096
// bench: max 65536

class Bench
{
    public static function run(uint $size): uint
    {
        var $entry = Core\BigInt::of(-1)->shl($size)->add(Core\BigInt::of(1));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + ($entry->neg()->sign() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(4096), "\n";
