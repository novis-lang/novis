<?nvs
// Measures multiplying two large numbers. A program does this when it counts a
// total in the smallest unit of a currency.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\BigInt> $prices = [
            Core\BigInt::parse("123456789012345678901234567890"),
            Core\BigInt::parse("987654321098765432109876543210"),
        ];
        var $quantity = Core\BigInt::of(1200);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the price multiplied this round is picked by the result
            // of the round before.
            $total = $total + ($prices[($total % 2) as int]->mul($quantity)->sign() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
