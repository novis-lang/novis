<?nvs
// Measures flipping the sign of a large number, as a program does when it
// cancels an entry in a ledger.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\BigInt> $entries = [
            Core\BigInt::parse("-123456789012345678901234567890"),
            Core\BigInt::parse("-98765432109876543210"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the number flipped this round is picked by the sign
            // counted in the round before.
            $total = $total + ($entries[($total % 2) as int]->neg()->sign() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
