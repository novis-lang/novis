<?nvs
// Measures building a number from a plain `uint`, as a program does before it
// adds up counts that grow past what a `uint` holds.
// bench: iterations 400000
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the number built this round is the count from the round
            // before it, taken from the top of the `uint` range.
            $total = $total + (Core\BigInt::ofUint(18446744073709551615 - $total)->sign() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
