<?nvs
// Measures getting the store this server shares, writing one text value and reading it back, at growing text lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $value = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            var $store = Core\Cache::process();
            $store->put("round", $value);
            $total = $total + Core\Str::length($store->get("round") as string);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
