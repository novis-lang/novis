<?nvs
// Measures how fast `memberOf` builds a group filter, as a program does before it lists a group's members.
// bench: iterations 100000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The total so far chooses the group, so the loop cannot be left out.
        array<Core\Ldap\Dn> $groups = [
            Core\Ldap\Dn::parse('CN=Staff,OU=Groups,DC=example,DC=test'),
            Core\Ldap\Dn::parse('CN=Sales,OU=Groups,DC=example,DC=test'),
            Core\Ldap\Dn::parse('CN=Domain Admins,CN=Users,DC=example,DC=test'),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $filter = Core\Ldap\Ad::memberOf($groups[($total % 3) as int], { nested: true });
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
