<?nvs
// Measures how fast `disabled` builds its filter and joins it with another, as a program does before it cleans up old accounts.
// bench: iterations 100000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The count so far chooses the other filter, so the loop cannot be left out.
        array<Core\Ldap\Filter> $kinds = [
            Core\Ldap\Filter::equals('objectClass', 'user'),
            Core\Ldap\Filter::equals('objectClass', 'computer'),
            Core\Ldap\Filter::present('mail'),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $filter = Core\Ldap\Filter::all($kinds[($total % 3) as int], Core\Ldap\Ad::disabled());
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
