<?nvs
// Measures how fast `Core\Ldap\Dn::parse` reads a short DN, as a program does with a search base from its settings.
// bench: iterations 100000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The length so far chooses the text, so the loop cannot be left out.
        array<string> $texts = [
            'OU=Staff,DC=example,DC=test',
            'CN=Ann Lee,OU=Staff,DC=example,DC=test',
            'CN=Lee\\, Ann,OU=Staff,DC=example,DC=test',
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $dn = Core\Ldap\Dn::parse($texts[($total % 3) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
