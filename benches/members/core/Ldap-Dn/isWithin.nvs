<?nvs
// Measures how fast `isWithin` checks that an entry is in a unit, as a program does before it changes the entry.
// bench: iterations 100000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $staff = Core\Ldap\Dn::parse('OU=Staff,DC=example,DC=test');
        // The count so far chooses the DN, so the loop cannot be left out.
        array<Core\Ldap\Dn> $dns = [
            Core\Ldap\Dn::parse('CN=Ann,OU=Staff,DC=example,DC=test'),
            Core\Ldap\Dn::parse('CN=Ben,OU=Sales,DC=example,DC=test'),
            Core\Ldap\Dn::parse('cn=Cleo,ou=staff,dc=Example,dc=Test'),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if ($dns[($total % 3) as int]->isWithin($staff)) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
