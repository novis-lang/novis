<?nvs
// Measures how fast `child` adds a name below a base, as a program does before it adds a user.
// bench: iterations 100000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $staff = Core\Ldap\Dn::parse('OU=Staff,DC=example,DC=test');
        // The length so far chooses the name, so the loop cannot be left out.
        array<string> $names = ['Ann Lee', 'Lee, Ann', 'Ann+uid=7'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Str::length($staff->child('CN', $names[($total % 3) as int])->rdnAttribute());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
