<?nvs
// Measures how fast `parent` finds the unit of an entry, as a program does when it shows where a user is.
// bench: iterations 100000
// bench: calls 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The length so far chooses the DN, so the loop cannot be left out.
        array<Core\Ldap\Dn> $dns = [
            Core\Ldap\Dn::parse('CN=Ann,OU=Staff,DC=example,DC=test'),
            Core\Ldap\Dn::parse('CN=Ben,OU=Sales,DC=example,DC=test'),
            Core\Ldap\Dn::parse('OU=Staff,DC=example,DC=test'),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $up = $dns[($total % 3) as int]->parent();
            if ($up == null) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
