<?nvs
// Measures reading the terminal's height, as a program does before it prints
// one page of a report.
// bench: iterations 200000
// bench: calls 0
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round adds the height to what the round before it held, so
            // no round can be left out.
            $total = ($total + Core\Cli::height()) % 1000;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
