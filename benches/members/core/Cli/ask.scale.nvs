<?nvs
// Measures `Core\Cli::ask` with a default answer and no terminal, at growing question lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $question = Core\Str::repeat('a', $size) . '?';
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Cli::ask($question, {default: "ada"}));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
