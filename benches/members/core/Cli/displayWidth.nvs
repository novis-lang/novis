<?nvs
// Measures how many terminal columns a short label needs, as a program does
// before it pads a table column.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $labels = ["order", "注文", "Café"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The label of each round is picked by the round before it, so no
            // round can be left out.
            int $pick = ($total % 3) as int;
            $total = $total + Core\Cli::displayWidth($labels[$pick]);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
