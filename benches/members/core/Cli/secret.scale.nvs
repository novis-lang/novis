<?nvs
// Measures `Core\Cli::secret` with a scripted answer, at growing password lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $typed = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Test::scriptAnswers([$typed]);
            secret tainted string $password = Core\Cli::secret("Password?");
            $total = $total
                + Core\Str::length(Core\Secret::reveal($password, "measuring the answer"));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
