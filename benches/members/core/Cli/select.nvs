<?nvs
// Measures offering a menu that carries its own answer. A release script offers a
// few of these before it changes anything, and a job with no terminal takes the
// default every time.
// bench: iterations 256
// bench: calls 0
// bench: allocations 2
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): int {
        array<int> $sizes = [1, 7, 30];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The default of each round is chosen by the round before it, so no
            // round can be left out.
            int $at = $total % 3;
            $total = $total + Core\Cli::select("how many days?", $sizes, {default: $sizes[$at]});
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
