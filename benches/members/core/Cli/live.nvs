<?nvs
// Measures opening a live region, drawing one row in it and closing it again. A
// command line tool meets this when it reports where it is while it works. The
// output here is not a terminal, so nothing is drawn and the region's own cost is
// what is left.
// bench: iterations 200000
// bench: calls 0
// bench: allocations 12
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Every round adds what its own region answered, so no round can be
            // left out.
            $total = $total + Core\Cli::live(fn(Core\Cli\Live $screen): uint => {
                $screen->set([Core\Cli\Text::plain("working")]);
                return 1;
            });
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
