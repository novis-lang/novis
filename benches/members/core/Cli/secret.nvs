<?nvs
// Measures asking for a password without showing what is typed. A command line
// tool meets this before it connects to a server. The loop answers itself with
// `Core\Test::scriptAnswers`, the way a test does.
// bench: iterations 256
// bench: calls 0
// bench: allocations 6
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $typed = ["hunter2", "correct horse", "s3cr3t"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The password of each round is chosen by the round before it, so no
            // round can be left out.
            int $at = ($total % 3) as int;
            Core\Test::scriptAnswers([$typed[$at]]);
            secret tainted string $password = Core\Cli::secret("Password?");
            // `Core\Secret::reveal` is the one way to read a secret value. Here
            // it only measures the answer, which keeps the rounds chained.
            $total = $total
                + Core\Str::length(Core\Secret::reveal($password, "measuring the answer"));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
