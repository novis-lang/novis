<?nvs
// Measures asking how much colour the terminal can show. A program asks before
// it decides how to draw a line of output.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Every round adds the answer to the total, so no round can be left
            // out.
            $total = $total + (Core\Cli::colorDepth() as int) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
