<?nvs
// Measures reading the words a program was started with. A command line
// program reads them at the start, and again for every job it runs.
// bench: iterations 200000
// bench: calls 0
// bench: allocations 1
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Every round adds the number of words to the total, so no round
            // can be left out.
            $total = $total + Core\Arr::count(Core\Cli::arguments()) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
