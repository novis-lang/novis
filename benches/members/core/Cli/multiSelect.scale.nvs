<?nvs
// Measures `Core\Cli::multiSelect` with a scripted answer, at growing numbers of choices.
// bench: start 64
// bench: max 1024

class Bench
{
    public static function run(uint $size): int
    {
        array<int> $sizes = Core\Arr::range(1, $size as int);
        array<string> $lines = ["1", "2,3", "3"];
        int $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Test::scriptAnswers([$lines[$total % 3]]);
            array<int> $chosen = Core\Cli::multiSelect("how many days?", $sizes);
            $total = $total + $chosen[0];
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
