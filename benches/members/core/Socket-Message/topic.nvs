<?nvs
// Reads the topic name of a message, as a connection does to decide what to do with each message.
// bench: iterations 200000

class Bench {
    public static function run(Core\Socket $conn, uint $rounds): uint {
        Core\Topic::subscribe("prices");
        Core\Topic::subscribe("alerts");
        Core\Topic::publish("prices", 1);
        Core\Topic::publish("alerts", 2);
        array<Core\Socket\Message> $messages = [];
        ?Core\Socket\Message $message = $conn->receive();
        while ($message != null) {
            $messages[] = $message;
            $message = $conn->receive();
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the next message depends on this one
            if ($messages[$total % 3]->topic() == null) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(Core\Socket::current(), 200000), "\n";
