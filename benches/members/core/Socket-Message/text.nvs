<?nvs
// Reads the text of a message, as a connection does for every line a client types.
// bench: iterations 200000
// bench: complexity constant

class Bench {
    public static function run(Core\Socket $conn, uint $rounds): uint {
        array<Core\Socket\Message> $messages = [];
        ?Core\Socket\Message $message = $conn->receive();
        while ($message != null) {
            $messages[] = $message;
            $message = $conn->receive();
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the next message depends on this one
            if ($messages[($total % 3) as int]->text() == null) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(Core\Socket::current(), 200000), "\n";
