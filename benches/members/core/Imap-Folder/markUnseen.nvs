<?nvs
// Measures how a read message is marked as new again, as a script does when it must try a message again.
// bench: iterations 256
// bench: complexity constant

use Core\Imap;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $inbox = Imap::open('markUnseen')->folder('INBOX');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $inbox->markUnseen(1);
            // This marks the message as read again.
            // So each time the loop runs, `markUnseen` starts with a read message.
            $inbox->markSeen(1);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
