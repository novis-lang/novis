<?nvs
// Measures how one message is deleted from a folder, as a cleanup job does for each old message.
// bench: iterations 256
// bench: complexity constant

use Core\IO;
use Core\Imap;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $inbox = Imap::open('delete')->folder('INBOX');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // In a `directory` block, a message is a file. This adds message 2, so each round has one to delete.
            IO::write('mailboxes/delete/INBOX/2.eml', "From: a@example.com\nSubject: Old\n\nHello.\n");
            $inbox->delete(2);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
