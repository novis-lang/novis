<?nvs
// Measures how the `UIDVALIDITY` of an open folder is read, as a script does before it trusts the UIDs it saved.
// bench: iterations 2048
// bench: complexity constant

use Core\Imap;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $inbox = Imap::open('read')->folder('INBOX');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + ($inbox->uidValidity() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
