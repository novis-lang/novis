<?nvs
// Measures how one message is moved to another folder, as a script does when it archives a message.
// bench: iterations 256
// bench: complexity constant

use Core\Imap;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $mailbox = Imap::open('move');
        var $inbox = $mailbox->folder('INBOX');
        var $archive = $mailbox->folder('Archive');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each time the loop runs, it moves the message to the other folder.
            // The message has the UID 2 in `Archive` and the UID 1 in `INBOX`.
            if ($total % 2 == 0) {
                $inbox->move(1, 'Archive');
            } else {
                $archive->move(2, 'INBOX');
            }
            $total = $total + 1;
            $i = $i + 1;
        }
        // The message may still be in `Archive` after the loop.
        // If it is, this moves it to `INBOX` for the next run.
        if ($total % 2 == 1) {
            $archive->move(2, 'INBOX');
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
