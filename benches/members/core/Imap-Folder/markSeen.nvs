<?nvs
// Measures how a new message is marked as read, as a script does after it handles the message.
// bench: iterations 256
// bench: complexity constant

use Core\Imap;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $inbox = Imap::open('markSeen')->folder('INBOX');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $inbox->markSeen(1);
            // This marks the message as new again, so each round marks a new message.
            $inbox->markUnseen(1);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
