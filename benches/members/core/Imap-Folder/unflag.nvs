<?nvs
// Measures how a flag is removed from a message, as a script does once a complaint is answered.
// bench: iterations 256
// bench: complexity constant

use Core\Imap;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $inbox = Imap::open('unflag')->folder('INBOX');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $inbox->unflag(1, '\Flagged');
            // This adds the flag again, so each round removes it from a message that has it.
            $inbox->flag(1, '\Flagged');
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
