<?nvs
// Measures reading the memory a program is using. A program does this around a
// piece of work to find out what the work costs.
// bench: iterations 1024
// bench: calls 0
// bench: allocations 0
// bench: statements 3
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The reading of every round is added to the total, so no round can
            // be left out.
            $total = $total + Core\Budget::memoryHeld();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
