<?nvs
// Measures how fast `cookie` returns the cookie of a sync, as a program does to save it after the loop.
// bench: iterations 200000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $sales = $corp->changes(Core\Ldap\Filter::equals('department', 'Sales'), { select: ['cn'] });
        foreach ($sales as Core\Ldap\Entry $person) {
        }
        // Each round uses the sum so far, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + 1 + Core\Bytes::length($sales->cookie()) % ($total % 2 + 1);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000) > 0 ? 'done' : 'nothing', "\n";
