<?nvs
// Measures reading the mode the program runs in. A program does this when it
// decides how much to show about an error.
// bench: iterations 2048
// bench: allocations 0
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round adds a number that depends on the mode, so no round can be left out.
            $total = $total + (Core\Env::mode() == Core\Env\Mode::Production ? 1 : 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
