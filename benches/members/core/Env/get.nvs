<?nvs
// Measures reading one environment variable by name. A program does this when it
// reads a setting such as a port or a database host.
// bench: iterations 50000
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $names = ["PATH", "NVS_BENCH_NOT_SET"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The name read in each round is chosen by the round before it, so no round
            // can be left out.
            var $value = Core\Env::get($names[($total % 2) as int]) ?? "";
            $total = $total + Core\Str::length($value) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

// The value of `PATH` is different on each computer, so this prints only whether the loop ran.
echo Bench::run(50000) > 0 ? "read\n" : "empty\n";
