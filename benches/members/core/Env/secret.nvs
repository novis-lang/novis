<?nvs
// Measures reading one environment variable as a secret. A program does this when
// it reads an API key or a database password.
// bench: iterations 256
// bench: calls 1
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $names = ['PATH', 'NVS_BENCH_NOT_SET'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The name read in each round is chosen by the round before it, so no round
            // can be left out.
            var $value = Core\Env::secret($names[($total % 2) as int]);
            uint $step = $value == null ? 2 : 1;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

// `PATH` is set and `NVS_BENCH_NOT_SET` is not, so this prints `read`.
echo Bench::run(256) > 0 ? "read\n" : "empty\n";
