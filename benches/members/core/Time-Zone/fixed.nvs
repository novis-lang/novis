<?nvs
// Makes a zone from an offset, as a program does when it reads a timestamp that has an offset.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        array<Core\Time\Duration> $offsets = [5h30m, Core\Time\Duration::hours(-3), 0s, 9h45m];
        Core\Time\Instant $at = Core\Time::fromEpoch(0);
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks the offset
            Core\Time\Zone $zone = Core\Time\Zone::fixed($offsets[$total % 4]);
            $total = $total + 1 + ($zone->offsetAt($at)->toSeconds() + 100000) % 7;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
