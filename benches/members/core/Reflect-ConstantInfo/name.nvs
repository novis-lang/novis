<?nvs
// Reads the name of a class constant, as a program does when it lists a class's settings or looks one up by name.
// bench: iterations 1024
// bench: allocations 0
// bench: complexity constant

class Limits {
    public const int SMALL = 1;
    public const int LARGE = 2;
    private const string KEY = "k";
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Reflect\ConstantInfo> $list = Core\Reflect::forObject(new Limits())->constants();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which constant is read comes from last round's total, so no round can be reused.
            $total = $total + Core\Str::length($list[($total % 3) as int]->name());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
