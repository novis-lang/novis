<?nvs
// Measures how fast `mustChangePassword` checks one account, as a program does after a login to ask for a new password.
// bench: iterations 1000000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $found = $corp->read('CN=Carla Diaz,OU=Company,DC=example,DC=test', { select: ['userAccountControl'] })?->accountFlags();
        if ($found == null) {
            return 0;
        }
        Core\Ldap\Ad\AccountFlags $flags = $found;
        // Each round uses the total of the round before, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if ($flags->mustChangePassword()) {
                $total = $total + 1 + $total % 2;
            } else {
                $total = $total + 2 - $total % 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000000), "\n";
