<?nvs
// Reads where the part to write starts, as a program that sends a video does before it reads the file.
// bench: iterations 2048
// bench: allocations 0
// bench: calls 1
// bench: complexity constant

class Bench
{
    public static function run(Core\Response\Stream $body, uint $rounds): int
    {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + $body->offset() + ($total % 3) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Response\Stream $video = Core\Response::stream('text/plain', 1);
$video->write((Bench::run($video, 2048) % 10) as string);
