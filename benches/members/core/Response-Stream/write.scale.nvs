<?nvs
// Measures `write` on a body that is sent in parts, at growing part lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Response\Stream $body = Core\Response::stream("text/csv");
        string $row = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $body->write($row);
            $total = $total + Core\Str::length($row) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
