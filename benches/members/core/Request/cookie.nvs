<?nvs
// Reads one cookie by its name, as a page does to find the session or the language of a visitor.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): uint {
        // The cookies are in the file `cookie.nvsr` beside this one.
        array<string> $names = ["__Host-session", "lang", "theme"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            tainted string $value = Core\Request::cookie($names[$total % 3]) ?? "";
            $total = $total + Core\Str::length($value);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
