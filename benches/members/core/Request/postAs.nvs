<?nvs
// Reads a submitted form into a shape, as a program does when it handles a sign-up or contact form.
// bench: iterations 100000
// bench: complexity linear
// proof: gap nv/a-bench-cannot-ramp-an-input-fixed-outside-its-program
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        // The form is in the file `postAs.nvsr` beside this one.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $form = Core\Request::postAs<tainted {name: string, age: uint}>();
            $total = $total + Core\Str::length($form->name) + $form->age + $total % 2;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
