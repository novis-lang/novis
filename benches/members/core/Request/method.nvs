<?nvs
// Reads the method of a request, as a page does to decide whether to show a form or save it.
// bench: iterations 1024
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        // The request is in the file `method.nvsr` beside this one.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if (Core\Request::method() == Core\Http\Method::Post) {
                $total = $total + 1 + $total % 2;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
