<?nvs
// Reads the query string into a shape, as a list page does for its page number and search term.
// bench: iterations 256
// bench: complexity linear
// proof: gap nv/a-bench-cannot-ramp-an-input-fixed-outside-its-program
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        // The query string is in the file `queryAs.nvsr` beside this one.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $search = Core\Request::queryAs<tainted {q: string, page: uint}>();
            $total = $total + Core\Str::length($search->q) + $search->page + $total % 2;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
