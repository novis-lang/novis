<?nvs
// Reads the path of a request, as a program does before it picks the page to show.
// bench: iterations 200000
// bench: allocations 1
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        // The request is in the file `path.nvsr` beside this one.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            tainted string $path = Core\Request::path();
            $total = $total + Core\Str::length($path) + $total % 2;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
