<?nvs
// Walks the files of an upload form and adds up their sizes, as a handler does before it stores them.
// bench: iterations 1
// bench: complexity linear
// proof: gap nv/a-bench-cannot-ramp-an-input-fixed-outside-its-program

class Bench {
    public static function run(): uint {
        // The form is the body in the file `files.nvsr` beside this one.
        // A request body can be read only once.
        uint $total = 0;
        foreach (Core\Request::files() as Core\Request\Part $part) {
            foreach ($part->content() as tainted bytes $chunk) {
                $total = $total + Core\Bytes::length($chunk);
            }
        }
        return $total;
    }
}

echo Bench::run() > 0 ? "done" : "no file was read", "\n";
