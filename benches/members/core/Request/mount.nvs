<?nvs
// Reads the mount of a request, as a program does before it builds a link or picks a customer.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        // The request is in the file `mount.nvsr` beside this one.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Request\Mount $mount = Core\Request::mount();
            $total = $total + Core\Str::length($mount->prefix()) + $total % 2;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
