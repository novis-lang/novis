<?nvs
// Reads the host name of a request, as a server that runs several sites does to pick the site.
// bench: iterations 200000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        // The request is in the file `host.nvsr` beside this one.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            tainted string $host = Core\Request::host() ?? "";
            $total = $total + Core\Str::length($host) + $total % 3;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
