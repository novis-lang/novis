<?nvs
// Reads the body of a small JSON request, as a handler does before it checks or decodes it.
// bench: iterations 200000
// bench: allocations 1
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each call returns a new copy of the body, so the loop cannot be skipped.
            tainted string $body = Core\Request::body();
            if ($body != "") {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
