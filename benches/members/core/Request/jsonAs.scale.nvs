<?nvs
// Prints the request for the `Core\Request::jsonAs` bench, with a body of `$size` bytes.
// bench: prints
// bench: start 1024
// bench: max 8388608

class Bench
{
    public static function run(uint $size): string
    {
        // One line of the order is 38 bytes with its comma. The body stays under `$size` bytes,
        // so the largest one is inside the default request body limit of 8 MiB.
        string $line = '{"sku":"TEA-1","cents":450,"count":2}';
        uint $count = Core\Math::intDiv($size as int - 64, 38) as uint;
        string $body = '{"customer":"c-1042","items":[' . Core\Str::repeat($line . ',', $count - 1) . $line . ']}';
        array<string> $lines = [
            '// scaling: file jsonAs.nvsr',
            '--METHOD--',
            'POST',
            '--PATH--',
            '/api/orders',
            '--SCHEME--',
            'https',
            '--HEADERS--',
            'host: shop.example.com',
            'content-type: application/json',
            '--BODY--',
            $body,
        ];
        return Core\Str::join($lines, "\n") . "\n";
    }
}

echo Bench::run(1024);
