<?nvs
// Prints the request for the `Core\Request::jsonAs` bench, with an order of `$size` items.
// bench: prints
// bench: start 16
// bench: max 256

class Bench
{
    public static function run(uint $size): string
    {
        array<string> $items = Core\Arr::map(Core\Arr::range(1, $size as int), fn(int $n): string => "{\"sku\":\"TEA-" . ($n as string) . "\",\"cents\":450,\"count\":2}");
        array<string> $lines = [
            '// scaling: file jsonAs.nvsr',
            '--METHOD--',
            'POST',
            '--PATH--',
            '/api/orders',
            '--SCHEME--',
            'https',
            '--HEADERS--',
            'host: shop.example.com',
            'content-type: application/json',
            '--BODY--',
            "{\"customer\":\"c-1042\",\"items\":[" . Core\Str::join($items, ',') . ']}',
        ];
        return Core\Str::join($lines, "\n") . "\n";
    }
}

echo Bench::run(16);
