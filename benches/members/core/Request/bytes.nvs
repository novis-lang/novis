<?nvs
// Reads the body of a small upload as bytes, as a handler does before it checks or stores a file.
// bench: iterations 200000
// bench: complexity linear
// proof: gap nv/a-bench-cannot-ramp-an-input-fixed-outside-its-program
// bench: allocations 1

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each call returns a new copy of the body, so the loop cannot be skipped.
            tainted bytes $upload = Core\Request::bytes();
            $total = $total + Core\Bytes::length($upload);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
