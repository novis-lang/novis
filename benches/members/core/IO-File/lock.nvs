<?nvs
// Opens a lock file, takes the lock and closes it, as a job does before it changes a shared file.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\IO::temporaryDir();
        array<string> $files = [
            Core\Path::join($dir, "a.lock"),
            Core\Path::join($dir, "b.lock"),
            Core\Path::join($dir, "c.lock"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The file in each round depends on the round before, so no round can be left out.
            Core\IO\File $handle = Core\IO::open($files[($total % 3) as int], Core\IO\FileMode::ReadWrite);
            $handle->lock();
            $handle->close();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256) > 0 ? "done" : "no lock was taken", "\n";
