<?nvs
// Measures reading one line of an open file, at growing line lengths.
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): uint
    {
        string $path = Core\Path::join(Core\IO::temporaryDir(), 'read-line.txt');
        Core\IO::write($path, Core\Str::repeat('a', $size) . "\n");
        Core\IO\File $file = Core\IO::open($path, Core\IO\FileMode::Read);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            // Each round reads the one line and then moves back to the start of the file.
            $total = $total + Core\Str::length($file->readLine() ?? '');
            $file->seek(0);
            $i = $i + 1;
        }
        $file->close();
        return $total;
    }
}

echo Bench::run(1024), "\n";
