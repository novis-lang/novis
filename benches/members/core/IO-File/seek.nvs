<?nvs
// Moves the handle of an open file, as a program does when it reads records at known places.
// bench: iterations 256
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(Core\IO\File $file, uint $rounds): uint {
        uint $at = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The next offset comes from the last one, so every move is different.
            $at = ($at * 7 + 3) % 4096;
            $file->seek($at);
            $i = $i + 1;
        }
        return $at;
    }
}

string $path = Core\Path::join(Core\IO::temporaryDir(), "seek.dat");
Core\IO::write($path, Core\Str::repeat("x", 4096));
Core\IO\File $file = Core\IO::open($path, Core\IO\FileMode::Read);
echo Bench::run($file, 256), "\n";
$file->close();
