<?nvs
// Asks an open file for its position, as a program does before it saves where it stopped.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(Core\IO\File $file, uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + $file->tell() + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

string $path = Core\Path::join(Core\IO::temporaryDir(), "tell.dat");
Core\IO::write($path, "0123456789");
Core\IO\File $file = Core\IO::open($path, Core\IO\FileMode::Read);
$file->seek(5);
echo Bench::run($file, 400000), "\n";
$file->close();
