<?nvs
// Measures `Core\Totp::code` with a long secret, at growing secret lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        secret bytes $secret = Core\Random::bytes($size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + 1 + Core\Str::length(Core\Totp::code($secret));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
