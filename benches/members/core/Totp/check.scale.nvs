<?nvs
// Measures `Core\Totp::check` with a long secret, at growing secret lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        secret bytes $secret = Core\Random::bytes($size);
        array<string> $typed = [Core\Totp::code($secret), "123456"];
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            if (Core\Totp::check($typed[($total % 2) as int], $secret) == null) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
