<?nvs
// Measures picking a colour out of the terminal's 256-entry palette. A tool
// meets this once for every line it writes in a colour of its own.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 1
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        Core\Cli\Color $last = Core\Cli\Color::index(0);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The entry of each round is chosen by the round before it, so no
            // round can be left out.
            Core\Cli\Color $color = Core\Cli\Color::index($total % 256);
            if ($color == $last) {
                $total = $total + 2;
            } else {
                $total = $total + 1;
            }
            $last = $color;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
