<?nvs
// Measures `Core\Out::capture` on one line of output, at growing line lengths.
// It shows how the cost of `capture` grows when the output grows.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $line = Core\Str::repeat("a", $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Out::capture(fn (): void => { echo $line; }) as string);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
