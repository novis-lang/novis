<?nvs
// Measures `Core\Passkey::credentialId` for sign-in answers of growing size, with the id at the end.
// bench: start 16
// bench: max 1024

class Bench
{
    public static function run(uint $size): uint
    {
        string $answer = '{"type":"public-key","response":{"signature":"'
            . Core\Str::repeat('M', $size * 48)
            . '"},"id":"ax8MmiTTXneBpMLw6TtdFg"}';
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            bytes $id = Core\Passkey::credentialId($answer);
            $total = $total + Core\Bytes::length($id) as uint;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(16), "\n";
