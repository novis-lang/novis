<?nvs
// Reads the passkey id from a sign-in answer, as the page that signs a user in does.
// bench: iterations 16384
// bench: complexity linear

class Bench
{
    public static function run(uint $rounds): uint
    {
        // Sixteen answers with different ids. Each round reads another one.
        array<string> $answers = [];
        uint $n = 0;
        while ($n < 16) {
            string $raw = Core\Encoding::toBase64Url(Core\Bytes::join([Core\Bytes::pack('J', $n), Core\Bytes::fill(8, 7)]));
            $answers[] = '{"id":"' . $raw . '","rawId":"' . $raw . '","type":"public-key",'
                . '"authenticatorAttachment":"platform","response":{"clientDataJSON":"'
                . Core\Str::repeat('e', 180) . '","authenticatorData":"' . Core\Str::repeat('S', 50)
                . '","signature":"' . Core\Str::repeat('M', 96) . '","userHandle":"wuk7XRZrHwyaJNNed4Gk8A"},'
                . '"clientExtensionResults":{}}';
            $n = $n + 1;
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            bytes $id = Core\Passkey::credentialId($answers[$i % 16]);
            $total = $total + Core\Bytes::length($id) as uint;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(16384), "\n";
