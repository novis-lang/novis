<?nvs
// Makes the options to sign in with any passkey, as the sign-in page does for each visitor.
// bench: iterations 256
// bench: complexity linear
// requires: redis

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $sites = ['example.com', 'shop.example.com', 'blog.example.com'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $json = Core\Passkey::signInOptions($sites[($total % 3) as int]);
            if (Core\Str::length($json) > 0) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::start();
echo Bench::run(256), "\n";
