<?nvs
// Measures a request whose method is chosen while the program runs, as in the tests
// of a job that sends saved changes.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        // Every request below is answered from this table, so nothing is sent over a network.
        Core\Test::answerHttp("https://api.example.com/*", 200);
        array<Core\Http\Method> $methods = [Core\Http\Method::Put, Core\Http\Method::Delete, Core\Http\Method::Get];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The method in each round is chosen by the round before, so no round can be left out.
            Core\Http\Method $method = $methods[($total % 3) as int];
            string $url = "https://api.example.com/changes/" . $i;
            Core\Http\Response $response = Core\Http\Client::request($method, $url);
            $total = $total + ($response->status() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
