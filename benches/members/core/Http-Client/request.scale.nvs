<?nvs
// Measures sending one request with `Core\Http\Client::request`, at growing reply sizes.
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): uint
    {
        // The reply comes from this table, so nothing is sent over a network.
        Core\Test::answerHttp('https://api.example.com/changes/1', 200, { body: Core\Str::repeat('a', $size) });
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Http\Response $response = Core\Http\Client::request(Core\Http\Method::Get, 'https://api.example.com/changes/1');
            $total = $total + ($response->status() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
