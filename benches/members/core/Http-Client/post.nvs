<?nvs
// Measures sending a `POST` request with a small JSON body that a test answers.
// A program's own tests do this for every request that sends data to another service.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        // Every request below is answered from this table, so nothing is sent over a network.
        Core\Test::answerHttp("https://api.example.com/*", 201);
        array<string> $paths = ["/orders/", "/messages/", "/charges/"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The URL and the body in each round depend on the round before, so no round can be left out.
            string $url = "https://api.example.com" . $paths[($total % 3) as int] . $i;
            Core\Http\Response $response = Core\Http\Client::post($url, {json: ["id" => $i, "total" => $total]});
            $total = $total + ($response->status() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
