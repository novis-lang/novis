<?nvs
// Measures sending one `HEAD` request, at growing lengths of the reply's header.
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): uint
    {
        // The reply comes from this table, so nothing is sent over a network.
        Core\Test::answerHttp('https://blog.example.com/post', 200, { headers: ['Link' => Core\Str::repeat('a', $size)] });
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Http\Response $response = Core\Http\Client::head('https://blog.example.com/post');
            $total = $total + ($response->status() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
