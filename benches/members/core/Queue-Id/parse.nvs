<?nvs
// Reads a job id from its string, as a page does with the id it gets in a URL.
// bench: iterations 256
// bench: complexity constant
use Core\Queue\Id;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $texts = [
            '1.AAAAAAAAAAAAAAAAAAAAAA.cmVjZWlwdHM',
            '42.q3vX9bT0LmN2pR8sK4dYfw.ZXhwb3J0cw',
            '90817.Zm9vYmFyYmF6cXV4cXV1eA.bWFpbA',
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Id $id = Id::parse($texts[($total % 3) as int]);
            $total = $total + ($i % 5) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
