<?nvs
// Measures removing the fractional part of a number, as a timer does to show whole seconds.
// bench: iterations 400000
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): float {
        float $value = 0.0;
        float $total = 0.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the number used this round depends on last round's result.
            $value = Core\Math::truncate($value * 0.5 + 7.9);
            $total = $total + $value;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
