<?nvs
// Measures the larger of two whole numbers, as a program does to keep a count from going below a limit.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): int {
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the first value this round depends on last round's total.
            $total = $total + Core\Math::max($total % 7 - 3, 1);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
