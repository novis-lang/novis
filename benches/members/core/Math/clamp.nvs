<?nvs
// Measures keeping a whole number inside a range, as a server does with a page size a visitor asks for.
// bench: iterations 1024
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): int {
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the number used this round depends on last round's total.
            $total = $total + Core\Math::clamp(($total % 250) - 50, 1, 100);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
