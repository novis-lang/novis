<?nvs
// Measures the tangent of an angle, as a map app does when it finds how steep a road is.
// bench: iterations 400000
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): float {
        float $total = 0.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the angle used this round depends on last round's total.
            $total = $total + Core\Math::tan($total * 0.000001 + 0.1);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
