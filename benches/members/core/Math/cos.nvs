<?nvs
// Measures the cosine of an angle, as a map or a drawing does when it finds a position.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(int $rounds): float {
        float $total = 0.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the angle used this round depends on last round's total.
            $total = $total + Core\Math::cos($total * 0.001);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
