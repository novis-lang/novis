<?nvs
// Measures a base-10 logarithm, as a chart does to place each value on a log scale.
// bench: iterations 256
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): float {
        float $total = 0.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the number this round depends on last round's total.
            $total = $total + Core\Math::log(2.0 + $total * 0.000001, {base: 10.0});
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
