<?nvs
// Measures rounding a number down, as a shop does when it counts full tens of euros.
// bench: iterations 400000
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): float {
        float $total = 1.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the number used this round depends on last round's total.
            $total = $total + Core\Math::floor(100.0 / $total) + 0.25;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
