<?nvs
// Measures converting an angle from radians to degrees, as a program does before it shows an angle.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(int $rounds): float {
        float $total = 0.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the angle used this round depends on last round's total.
            $total = $total + Core\Math::toDegrees($total * 0.0000001 + 0.1);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
