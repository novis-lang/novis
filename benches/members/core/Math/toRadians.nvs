<?nvs
// Measures converting an angle from degrees to radians, as a map app does before it uses `sin` or `cos`.
// bench: iterations 1024
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): float {
        float $total = 0.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the angle used this round depends on last round's total.
            $total = $total + Core\Math::toRadians($total * 0.001 + 1.0);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
