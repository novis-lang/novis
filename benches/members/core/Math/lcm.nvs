<?nvs
// Measures the least common multiple of two numbers, as a scheduler does when two jobs repeat.
// bench: iterations 1024
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): int {
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the first number this round depends on last round's total.
            $total = $total + Core\Math::lcm(6 + $total % 100, 8);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
