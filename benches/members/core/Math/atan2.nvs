<?nvs
// Measures the angle of a point from its two coordinates, as a program does when it
// finds the compass direction from one place to another.
// bench: iterations 256
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): float {
        float $total = 1.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: both coordinates used this round depend on last round's total.
            $total = $total + Core\Math::atan2($total, 1000.0 - $total);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
