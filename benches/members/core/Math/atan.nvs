<?nvs
// Measures turning a tangent into an angle, as a program does when it finds the
// angle of a road from its gradient.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(int $rounds): float {
        float $total = 1.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the tangent used this round depends on last round's total.
            $total = $total + Core\Math::atan($total);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
