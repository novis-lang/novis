<?nvs
// Measures a test for `NaN`, as a program does on each value before it adds it to a total.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(int $rounds): float {
        float $total = 0.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the value tested this round depends on last round's total.
            float $value = Core\Math::fdiv($total, $total - 1.0);
            if (!Core\Math::isNan($value)) {
                $total = $total + 1.0;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
