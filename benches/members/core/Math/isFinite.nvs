<?nvs
// Measures a test for an ordinary number, as a program does on a result before it saves it.
// bench: iterations 400000
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(int $rounds): float {
        float $total = 0.0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the value tested this round depends on last round's total.
            float $value = Core\Math::fdiv(1.0, $total - 1.0);
            if (Core\Math::isFinite($value)) {
                $total = $total + 1.0;
            } else {
                $total = $total + 2.0;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
