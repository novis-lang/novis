<?nvs
// Measures writing a price with two decimals and a comma between thousands, as a shop page does.
// bench: iterations 400000
// bench: complexity constant

class Bench {
    public static function run(int $rounds): int {
        int $total = 0;
        int $i = 0;
        while ($i < $rounds) {
            // Chained: the number written this round depends on last round's total.
            float $amount = 1234.5 + ($total % 1000) * 0.01;
            string $text = Core\Math::format($amount, {decimals: 2, groupSeparator: ","});
            $total = $total + (Core\Str::length($text) as int);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
