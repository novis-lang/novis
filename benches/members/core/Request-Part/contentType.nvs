<?nvs
// Reads the media type of each uploaded file, as a handler does to accept only some kinds of file.
// bench: iterations 1

class Bench
{
    public static function run(): uint
    {
        // The form is the body in the file `contentType.nvsr` beside this one.
        // A request body can be read only once.
        uint $total = 0;
        foreach (Core\Request::files() as Core\Request\Part $part) {
            $total = $total + Core\Str::length($part->contentType());
        }
        return $total;
    }
}

echo Bench::run() > 0 ? 'done' : 'no file was read', "\n";
