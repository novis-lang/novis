<?nvs
// Reads an uploaded file into one value, as a handler does before it checks or stores a small upload.
// bench: iterations 1

class Bench
{
    public static function run(): uint
    {
        // The form is the body in the file `readAll.nvsr` beside this one.
        // A request body can be read only once.
        uint $total = 0;
        foreach (Core\Request::files() as Core\Request\Part $part) {
            $total = $total + Core\Bytes::length($part->readAll());
        }
        return $total;
    }
}

echo Bench::run() > 0 ? 'done' : 'no file was read', "\n";
