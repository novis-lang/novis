<?nvs
// Reads the field name of each uploaded file, as a handler does to decide where each file goes.
// bench: iterations 1
// bench: complexity constant

class Bench
{
    public static function run(): uint
    {
        // The form is the body in the file `name.nvsr` beside this one.
        // A request body can be read only once.
        uint $total = 0;
        foreach (Core\Request::files() as Core\Request\Part $part) {
            $total = $total + Core\Str::length($part->name());
        }
        return $total;
    }
}

echo Bench::run() > 0 ? 'done' : 'no file was read', "\n";
