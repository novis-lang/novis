<?nvs
// Measures applying a schema to a database that already matches it. A program
// does this at start-up, to check that its tables are in place.
// bench: iterations 2000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        var $db = Core\Db::connect('notes');
        var $schema = Core\Db\Schema::fromArray([
            'tables' => [
                [
                    'name' => 'notes',
                    'columns' => [
                        ['name' => 'id', 'type' => 'int64', 'identity' => true],
                        ['name' => 'title', 'type' => 'text(200)'],
                    ],
                    'primary_key' => ['id'],
                ],
            ],
        ]);
        // This call creates the table. Every call after it finds the database
        // already matching, which is the measured case.
        $schema->applyIncludingRisky($db);

        // Both entries are that schema, and the count so far picks which one is
        // applied, so the loop cannot be left out.
        array<Core\Db\Schema> $schemas = [$schema, $schema];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $schemas[($total % 2) as int]->applyIncludingRisky($db);
            $total = $total + 1;
            $i = $i + 1;
        }
        $db->close();
        return $total;
    }
}

echo Bench::run(2000), "\n";
