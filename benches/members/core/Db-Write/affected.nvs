<?nvs
// Measures reading how many rows a statement changed, as a program does after
// every write it makes.
// bench: iterations 1024
// bench: calls 0
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        var $db = Core\Db::connect('notes');
        $db->execute('create table notes (id integer primary key, text text not null)', []);
        var $write = $db->execute('insert into notes (text) values (?), (?)', ['buy milk', 'call Ana']);

        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each count is added to the ones before it, so the loop cannot be
            // left out.
            $total = $total + $write->affected();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
