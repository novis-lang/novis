<?nvs
// Reads the name in a server's certificate, as a program does before it trusts a partner.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        // Two TLS connections built for a test, so nothing is sent over a network.
        array<Core\Http\TlsInfo> $sessions = [
            Core\Test::tlsSession({subject: "CN=api.example.com"}),
            Core\Test::tlsSession({subject: "CN=shop.example.com, O=Shop"}),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The connection in each round depends on the length read in the round before.
            $total = $total + Core\Str::length($sessions[($total % 2) as int]->subject());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
