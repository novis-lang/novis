<?nvs
// Reads when a server's certificate expires, as a daily renewal check does.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        // Two TLS connections built for a test, so nothing is sent over a network.
        array<Core\Http\TlsInfo> $sessions = [
            Core\Test::tlsSession({expiry: Core\Time::fromIso("2031-06-01T00:00:00Z")}),
            Core\Test::tlsSession({expiry: Core\Time::fromIso("2031-06-02T00:00:01Z")}),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The connection in each round depends on the value read in the round before.
            int $seconds = $sessions[($total % 2) as int]->expiry()->toEpochSeconds();
            $total = $total + ($seconds % 2) as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
