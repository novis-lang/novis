<?nvs
// Measures ending a stream, which a program does once for every channel it
// hands to another task.
// bench: iterations 400000

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The size of each round's channel comes from the round before it,
            // so no round can be left out.
            var $chan = new Core\Task\Channel<int>(1 + ($total % 2));
            $chan->close();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
