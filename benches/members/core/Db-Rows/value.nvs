<?nvs
// Measures reading the one value a `select count(*)` answered, which a program
// does for every figure it shows on a page.
// bench: iterations 1024
// bench: calls 0
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        var $db = Core\Db::connect('notes');
        $db->execute('create table seatings (id integer primary key, seats int not null)', []);
        $db->execute('insert into seatings (seats) values (?), (?), (?)', [4, 2, 6]);
        var $rows = $db->query('select count(*) from seatings', []);

        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The total carries the value the result holds, so the loop cannot
            // be left out.
            $total = $total + ((($rows->value() as ?int) ?? 0) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
