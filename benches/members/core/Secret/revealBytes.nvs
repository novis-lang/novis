<?nvs
// Reveals a secret key, as a program does before it saves the key to a file.
// bench: iterations 400000
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        secret bytes $key = Core\Encoding::fromHex("00ff8041c2fe0d0affc0809b7f00e0fd");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            bytes $raw = Core\Secret::revealBytes($key, "the key is saved to the config file");
            $total = $total + Core\Bytes::length($raw) % ($i % 3 + 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
