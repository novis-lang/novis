<?nvs
// Reveals a secret token, as a program does before it puts the token in a request header.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): uint {
        secret string $token = "tok_7Hq2Lm9Xa4Rb";
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $plain = Core\Secret::reveal($token, "the request header needs the token");
            $total = $total + Core\Str::length($plain) % ($i % 3 + 2);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
