<?nvs
// Checks whether a property is public, as a web API does before it sends a field to a client.
// bench: iterations 400000
// bench: allocations 0

class User {
    public string $name = "Ada";
    protected bool $isAdmin = false;
    private string $passwordHash = "x9f2";
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Reflect\PropertyInfo> $list = Core\Reflect::forObject(new User())->properties();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which property is checked comes from last round's total, so no round can be reused.
            if ($list[($total % 3) as int]->isPublic()) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
