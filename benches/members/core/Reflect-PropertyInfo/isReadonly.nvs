<?nvs
// Checks whether a property is `readonly`, as a function that writes new values into an object does before each write.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

class Product
{
    public string $name = 'Lamp';
    public int $price = 30;

    public function constructor(public readonly int $id)
    {}
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Core\Reflect\PropertyInfo> $list = Core\Reflect::forObject(new Product(12))->properties();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The total from the last pass of the loop selects the property.
            // So the compiler cannot reuse the result of an earlier pass.
            if ($list[($total % 3) as int]->isReadonly()) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
