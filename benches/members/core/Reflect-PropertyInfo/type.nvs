<?nvs
// Reads the declared type of a property, as a form handler does to convert text to that type.
// bench: iterations 400000
// bench: allocations 0

class Signup {
    public string $name = "";
    public ?int $age = null;
    public array<string> $tags = [];
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Reflect\PropertyInfo> $list = Core\Reflect::forObject(new Signup())->properties();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which property is read comes from last round's total, so no round can be reused.
            $total = $total + Core\Str::length($list[($total % 3) as int]->type() ?? "");
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
