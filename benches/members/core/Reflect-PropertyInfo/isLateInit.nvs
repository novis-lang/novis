<?nvs
// Checks whether a property is `lateinit`, as a function that saves an object does before it reads the property.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

class Cart
{
    public int $items = 3;
    public string $currency = 'EUR';
    public lateinit int $shippingCost;
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Core\Reflect\PropertyInfo> $list = Core\Reflect::forObject(new Cart())->properties();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The total from the last pass of the loop selects the property.
            // So the compiler cannot reuse the result of an earlier pass.
            if ($list[($total % 3) as int]->isLateInit()) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
