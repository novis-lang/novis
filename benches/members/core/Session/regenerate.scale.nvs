<?nvs
// Measures `Core\Session::regenerate` on one session, at growing lengths of the value in the session.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Session::set("cart", Core\Str::repeat('a', $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 16) {
            Core\Session::regenerate();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::start();
echo Bench::run(256), "\n";
