<?nvs
// Saves one encrypted token in a session, as a page does after a device gets a new token.
// bench: iterations 256
// bench: complexity linear
// requires: redis

class Bench
{
    public static function run(uint $rounds): uint
    {
        secret bytes $key = Core\Crypto::generateKey();
        array<secret bytes> $keys = [$key];
        array<string> $names = ['token-a', 'token-b', 'token-c'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Session::setLongLivedSecret($names[($total % 3) as int], 'dev-4e81a0c2', $keys);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::setLongLived('language', 'en');
echo Bench::run(256), "\n";
