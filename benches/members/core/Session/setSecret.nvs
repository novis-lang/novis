<?nvs
// Saves one encrypted token in a session, as a page does after it gets a new access token.
// bench: iterations 100000

class Bench {
    public static function run(uint $rounds): uint {
        secret bytes $key = Core\Crypto::generateKey();
        array<secret bytes> $keys = [$key];
        array<string> $names = ["token-a", "token-b", "token-c"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Session::setSecret($names[$total % 3], "at-7f3c9b21", $keys);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::start();
Core\Session::set("user", 17);
echo Bench::run(100000), "\n";
