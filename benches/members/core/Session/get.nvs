<?nvs
// Reads one value from a session that has three, as a page does to show who is signed in.
// bench: iterations 256
// bench: complexity constant
// requires: redis

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $keys = ['user', 'language', 'cart'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + (Core\Session::get($keys[($total % 3) as int]) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::setShortLived('user', 17);
Core\Session::setLongLived('language', 2);
Core\Session::setLongLived('cart', 5);
echo Bench::run(256), "\n";
