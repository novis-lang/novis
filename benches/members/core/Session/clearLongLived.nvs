<?nvs
// Deletes the preferences of a session that has one long-lived value, as a "Reset settings" button does.
// bench: iterations 256
// bench: complexity constant
// requires: redis

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Session::setLongLived('theme', $total);
            Core\Session::clearLongLived();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
