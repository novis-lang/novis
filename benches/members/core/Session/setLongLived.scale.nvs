<?nvs
// Measures `Core\Session::setLongLived` on a session with one long value, at growing value lengths.
// bench: start 256
// bench: max 16384
// requires: redis

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Session::setLongLived('cart', Core\Str::repeat('a', $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Session::setLongLived('theme', $total);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
