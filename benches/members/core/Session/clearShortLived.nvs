<?nvs
// Signs a user out of a session that has one short-lived value, as a sign-out page does.
// bench: iterations 256
// bench: complexity constant
// requires: redis

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Session::setShortLived('user', $total);
            Core\Session::clearShortLived();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
