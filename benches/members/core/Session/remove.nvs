<?nvs
// Saves a message in a session that has two other values and removes it, as a page does after it shows the message once.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Session::set("notice", $total);
            Core\Session::remove("notice");
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::start();
Core\Session::set("user", 17);
Core\Session::set("language", "de");
echo Bench::run(256), "\n";
