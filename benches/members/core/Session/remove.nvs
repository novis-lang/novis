<?nvs
// Saves a message in a session that has two other values and removes it, as a page does after it shows the message once.
// bench: iterations 256
// bench: complexity constant
// requires: redis

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Session::setShortLived('notice', $total);
            Core\Session::remove('notice');
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::setShortLived('user', 17);
Core\Session::setLongLived('language', 'de');
echo Bench::run(256), "\n";
