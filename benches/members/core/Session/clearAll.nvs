<?nvs
// Deletes a session that has one value, as a page that deletes a visitor's data does.
// bench: iterations 256
// bench: complexity constant
// requires: redis

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Session::setShortLived('user', $total);
            Core\Session::clearAll();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
