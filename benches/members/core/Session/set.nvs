<?nvs
// Saves one value in a session that has two others, as a page does when a visitor changes a setting.
// bench: iterations 100000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Session::set("views", $total);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::start();
Core\Session::set("user", 17);
Core\Session::set("language", "de");
echo Bench::run(100000), "\n";
