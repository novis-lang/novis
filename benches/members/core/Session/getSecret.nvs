<?nvs
// Reads one encrypted token from a session, as a page does before it calls a service for the user.
// bench: iterations 100000

class Bench {
    public static function run(uint $rounds): uint {
        secret bytes $key = Core\Crypto::generateKey();
        array<secret bytes> $keys = [$key];
        array<string> $names = ["token-a", "token-b", "token-c"];
        Core\Session::setSecret("token-a", "at-7f3c9b21", $keys);
        Core\Session::setSecret("token-b", "at-91abf042", $keys);
        Core\Session::setSecret("token-c", "at-2d40c8e7", $keys);

        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The name read in one round depends on the round before it.
            int $step = Core\Session::getSecret($names[$total % 3], $keys) == null ? 2 : 1;
            $total = $total + ($step as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::start();
echo Bench::run(100000), "\n";
