<?nvs
// Measures `Core\Session::getSecret` on one encrypted token, at growing token lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<secret bytes> $keys = [Core\Crypto::generateKey()];
        Core\Session::setSecret("token", "at-" . Core\Str::repeat('a', $size), $keys);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            int $step = Core\Session::getSecret("token", $keys) == null ? 2 : 1;
            $total = $total + ($step as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::start();
echo Bench::run(256), "\n";
