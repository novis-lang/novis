<?nvs
// Measures `Core\Session::remove` on a session with one long value, at growing value lengths.
// Each round saves a message and then removes it.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        Core\Session::set("cart", Core\Str::repeat('a', $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Session::set("notice", $total);
            Core\Session::remove("notice");
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::start();
echo Bench::run(256), "\n";
