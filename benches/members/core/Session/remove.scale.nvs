<?nvs
// Measures `Core\Session::remove` on a session with one long value, at growing value lengths.
// Each round saves a message and then removes it.
// The long value does not make this slower.
// bench: start 256
// bench: max 4096
// bench: rounds 64
// requires: redis

class Bench
{
    public static function run(uint $size, uint $rounds): uint
    {
        Core\Session::setLongLived('cart', Core\Str::repeat('a', $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Session::setShortLived('notice', $total);
            Core\Session::remove('notice');
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256, 64), "\n";
