<?nvs
// Gives a session with two values a new identifier, as a sign-in page does.
// bench: iterations 2000

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Session::regenerate();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::start();
Core\Session::set("user", 17);
echo Bench::run(2000), "\n";
