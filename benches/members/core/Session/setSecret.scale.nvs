<?nvs
// Measures `Core\Session::setSecret` on one token, at growing token lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        array<secret bytes> $keys = [Core\Crypto::generateKey()];
        string $token = "at-" . Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Session::setSecret("token", $token, $keys);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::start();
Core\Session::set("user", 17);
echo Bench::run(256), "\n";
