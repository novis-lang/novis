<?nvs
// Measures `Core\Session::setLongLivedSecret` on one token, at growing token lengths.
// bench: start 256
// bench: max 4096
// requires: redis

class Bench
{
    public static function run(uint $size): uint
    {
        array<secret bytes> $keys = [Core\Crypto::generateKey()];
        string $token = 'dev-' . Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Session::setLongLivedSecret('token', $token, $keys);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

Core\Session::setLongLived('language', 'en');
echo Bench::run(256), "\n";
