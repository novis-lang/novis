<?nvs
// Measures `Core\Hash::hmac` on one message, at growing message lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $message = Core\Str::repeat('a', $size);
        bytes $key = "a key only the server knows" as bytes;
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            bytes $signature = Core\Hash::hmac($message, $key, Core\Digest::Sha256);
            $total = $total + Core\Bytes::at($signature, 0) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
