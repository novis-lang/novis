<?nvs
// Measures the SHA-256 digest of a short text, as a program does when it makes a cache key.
// bench: iterations 256
// bench: allocations 1
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $keys = ["user:1042", "cart:77", "page:/shop/shoes"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The text hashed in each round is chosen by the round before it, so no round
            // can be left out.
            bytes $digest = Core\Hash::of($keys[($total % 3) as int], Core\Digest::Sha256);
            $total = $total + Core\Bytes::at($digest, 0) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
