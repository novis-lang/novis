<?nvs
// Measures `Core\Hash::equals` on two equal values, at growing value sizes.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        bytes $expected = Core\Bytes::fill($size, 65);
        bytes $sent = Core\Bytes::fill($size, 65);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            if (Core\Hash::equals($expected, $sent)) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
