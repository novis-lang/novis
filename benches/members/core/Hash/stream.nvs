<?nvs
// Measures opening a SHA-256 stream and finishing it empty, as a program does before it hashes an upload in parts.
// bench: iterations 200000
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Hash\Stream $stream = Core\Hash::stream(Core\Digest::Sha256);
            // The digest decides what the next round adds, so no round can be left out.
            $total = $total + Core\Bytes::at($stream->finish(), ($total % 32) as int) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
