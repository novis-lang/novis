<?nvs
// Measures `Core\Hash::of` on one text, at growing text lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $text = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            bytes $digest = Core\Hash::of($text, Core\Digest::Sha256);
            $total = $total + Core\Bytes::at($digest, 0) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
