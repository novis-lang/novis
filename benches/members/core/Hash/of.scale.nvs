<?nvs
// Measures `Core\Hash::of` on one file, at growing file sizes.
// bench: start 4096
// bench: max 65536

class Bench
{
    public static function run(uint $size): uint
    {
        string $path = Core\Path::join(Core\IO::temporaryDir(), 'archive.bin');
        Core\IO::write($path, Core\Bytes::repeat(Core\Encoding::fromHex('89'), $size));
        Core\IO\File $file = Core\IO::open($path, Core\IO::FileMode::Read);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            bytes $digest = Core\Hash::of($file, Core\Hash::Digest::Sha256);
            $total = $total + Core\Bytes::at($digest, 0) + 1;
            $i = $i + 1;
        }
        $file->close();
        return $total;
    }
}

echo Bench::run(4096), "\n";
