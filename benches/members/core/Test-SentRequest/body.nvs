<?nvs
// Reads the body of a sent request, as a test does to check the document a client sent.
// bench: iterations 1024
// bench: complexity constant

use Core\Http\Client;
use Core\Test\SentRequest;

class Bench {
    public static function run(uint $rounds): uint {
        Core\Test::answerHttp("https://api.example.com/*", 201);
        Client::post("https://api.example.com/orders", {json: ["sku" => "mug", "count" => 2]});
        Client::get("https://api.example.com/orders");
        array<SentRequest> $sent = Core\Test::sentHttp();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Bytes::length($sent[($total % 2) as int]->body()) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
