<?nvs
// Measures how fast `references` returns the other servers a search named, as a program does after the loop.
// bench: iterations 200000
// bench: calls 0
// bench: complexity constant
// requires: samba-ad

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $corp = Core\Ldap::connect('corp');
        var $entries = $corp->search(Core\Ldap\Filter::present('objectClass'), {
            scope: Core\Ldap\Connection::Scope::OneLevel,
            select: ['cn'],
        });
        foreach ($entries as Core\Ldap\Entry $entry) {
        }
        // Each round uses the count so far, so the loop cannot be left out.
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<tainted string> $urls = $entries->references();
            $total = $total + 1 + Core\Arr::count($urls) % ($total % 2 + 1);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
