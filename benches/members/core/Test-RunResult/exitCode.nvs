<?nvs
// Reads the exit code of one run of the program, as a test does before it checks how a command ended.
// bench: iterations 400000
// bench: allocations 0
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Core\Test\RunResult> $runs = [
            Core\Test::run(['one']),
            Core\Test::run(['four']),
            Core\Test::run(['seven']),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + ($runs[($total % 3) as int]->exitCode() as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

// Each run starts this file again with one word. In that run, this part ends with an exit code.
var $word = Core\Cli::arguments()[0] ?? '';
if ($word == 'one') {
    exit(1);
} else if ($word == 'four') {
    exit(4);
} else if ($word == 'seven') {
    exit(7);
} else {
    echo Bench::run(400000), "\n";
}
