<?nvs
// Checks if a set is empty, as a program does before it prints or sends a list.
// bench: iterations 1000000
// bench: allocations 0
// bench: complexity constant

final class Key {
    public int $id;

    public function constructor(int $id) {
        $this->id = $id;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        Core\ObjectSet<Key> $empty = new Core\ObjectSet<Key>();
        Core\ObjectSet<Key> $full = new Core\ObjectSet<Key>();
        $full->add(new Key(1));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks the set this round checks
            Core\ObjectSet<Key> $set = $total % 2 == 0 ? $empty : $full;
            if ($set->isEmpty()) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000000), "\n";
