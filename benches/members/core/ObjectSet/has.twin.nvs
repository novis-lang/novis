<?nvs
// Measures the same check as the `has` bench, on an array that uses each object's `id` as its key.
// bench: iterations 2048

final class Item
{
    public int $id;

    public function constructor(int $id)
    {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        Item $known = new Item(1);
        Item $unknown = new Item(2);
        array<Item> $seen = [];
        $seen[$known->id] = $known;
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Item $probe = $total % 3 == 0 ? $unknown : $known;
            if (isset($seen[$probe->id])) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
