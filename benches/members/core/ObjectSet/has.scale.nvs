<?nvs
// Measures `has` on a set of objects, at growing numbers of objects.
// It shows that a larger set does not make one check slower.
// bench: start 12500
// bench: max 100000
// bench: rounds 2048

final class Key
{
    public int $id;

    public function constructor(int $id)
    {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(uint $size, uint $rounds): uint
    {
        int $n = $size as int;
        array<Key> $keys = [];
        Core\ObjectSet<Key> $seen = new Core\ObjectSet<Key>();
        int $k = 0;
        while ($k < $n) {
            Key $key = new Key($k);
            $keys[] = $key;
            // Only every second object is in the set.
            if ($k % 2 == 0) {
                $seen->add($key);
            }
            $k = $k + 1;
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if ($seen->has($keys[($total % $size) as int])) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(12500, 2048), "\n";
