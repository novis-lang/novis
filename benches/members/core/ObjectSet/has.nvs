<?nvs
// Checks if an object is in a set, as a program does before it handles an item a second time.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

final class Key {
    public int $id;

    public function constructor(int $id) {
        $this->id = $id;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        Key $known = new Key(1);
        Key $unknown = new Key(2);
        Core\ObjectSet<Key> $seen = new Core\ObjectSet<Key>();
        $seen->add($known);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks the key this round looks for
            Key $probe = $total % 3 == 0 ? $unknown : $known;
            if ($seen->has($probe)) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
