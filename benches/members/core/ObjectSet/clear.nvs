<?nvs
// Empties a set of one object, as a program does before each batch of work.
// bench: iterations 256
// bench: complexity linear

final class Key {
    public int $id;

    public function constructor(int $id) {
        $this->id = $id;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Key> $keys = [new Key(1), new Key(2), new Key(3)];
        Core\ObjectSet<Key> $batch = new Core\ObjectSet<Key>();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: which key is added depends on last round's total
            $batch->add($keys[($total % 3) as int]);
            $batch->clear();
            $total = $total + 1 + ($total % 7);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
