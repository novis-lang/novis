<?nvs
// Measures registering a shutdown function. A server does this once for each request it answers.
// bench: iterations 400000
// bench: allocations 0
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        var $first = fn (): void => { echo "first\n"; };
        var $second = fn (): void => { echo "second\n"; };
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round registers the other function, so no round can be left out.
            Core\Signal::onShutdown($total % 2 == 0 ? $first : $second);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
