<?nvs
// Measures `Core\Ast::parse` on one piece of source, at growing numbers of statements.
// bench: start 64
// bench: max 1024

class Bench
{
    public static function run(uint $size): uint
    {
        string $source = '<?nvs ' . Core\Str::repeat('echo 1 + 2;', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Ast\Node $file = Core\Ast::parse($source);
            $total = $total + Core\Arr::count($file->children()) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
