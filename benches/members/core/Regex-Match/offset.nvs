<?nvs
// Reads where a match starts, as a program does before it cuts the text around a match.
// bench: iterations 4096
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $lines = ["Café 42", "Total: 99", "Größe 7"];
        array<Core\Regex\Match> $found = [];
        foreach ($lines as string $line) {
            var $m = Core\Regex::match($line, '\d+');
            if ($m != null) {
                $found[] = $m;
            }
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which match is read comes from last round's total, so no round can be reused.
            $total = $total + $found[($total % 3) as int]->offset() as uint + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(4096), "\n";
