<?nvs
// Writes a small node back out as XML text, as a program does when it copies part of a document.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): uint {
        Core\Xml\Node $document = Core\Xml::parse(
            '<order id="7"><line qty="2">Mug &amp; saucer</line><line qty="1">Teapot</line></order>'
        );
        array<Core\Xml\Node> $nodes = [$document];
        foreach ($document->children() as Core\Xml\Node $root) {
            $nodes[] = $root;
            foreach ($root->children() as Core\Xml\Node $line) {
                $nodes[] = $line;
            }
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if ($nodes[(($total + $i) % 4) as int]->source() != "") {   // chained: $total is last round's
                $total = $total + 4;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
