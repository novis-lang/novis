<?nvs
// Reads the kind of a node, as a program does before it reads anything else from that node.
// bench: iterations 400000
// bench: allocations 0
// bench: calls 0

class Bench {
    public static function run(uint $rounds): uint {
        Core\Xml\Node $document = Core\Xml::parse(
            '<order><line/>text<!--note--><?print fast?></order>'
        );
        array<Core\Xml\Node> $nodes = [$document];
        foreach ($document->children() as Core\Xml\Node $root) {
            $nodes[] = $root;
            foreach ($root->children() as Core\Xml\Node $child) {
                $nodes[] = $child;
            }
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Xml\Node $node = $nodes[(($total + $i) % 6) as int];   // chained: $total is last round's
            if ($node->kind() == Core\Xml\NodeKind::Element) {
                $total = $total + 6;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
