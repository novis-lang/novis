<?nvs
// Reads the children of an element, as a program does when it walks an XML document.
// bench: iterations 400000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        Core\Xml\Node $document = Core\Xml::parse(
            '<order><line/>text<line><name>Mug</name></line><!--note--><line/></order>'
        );
        array<Core\Xml\Node> $nodes = [];
        foreach ($document->children() as Core\Xml\Node $root) {
            $nodes[] = $root;
            foreach ($root->children() as Core\Xml\Node $child) {
                $nodes[] = $child;
            }
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count($nodes[(($total + $i) % 6) as int]->children());   // chained: $total is last round's
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
