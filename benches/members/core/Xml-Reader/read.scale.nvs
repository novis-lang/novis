<?nvs
// Measures `read` on a feed with one item of long text, at growing text lengths.
// Each round reads every node of the feed.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $xml = '<feed><item id="1">' . Core\Str::repeat('text ', $size) . '</item></feed>';
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Xml\Reader $reader = Core\Xml::reader($xml);
            ?Core\Xml\Node $node = $reader->read();
            while ($node != null) {
                $total = $total + 1;
                $node = $reader->read();
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
