<?nvs
// Measures reading the error output of a running program part by part, as a server does to show the warnings of a long job.
// bench: iterations 512 -- each round also writes the line it reads back, and the ramp needs a batch of 256 on some runs
// bench: calls 3
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // `/bin/sh` runs `cat` on Linux and macOS, and `cmd.exe` runs a loop on Windows.
        // Both print each line of input back to the error output as soon as they read it.
        string $path = '/bin/sh';
        array<string> $arguments = ['-c', 'exec cat >&2'];
        if (Core\Env::OS == Core\Env::Platform::Windows) {
            $path = "C:\\Windows\\System32\\cmd.exe";
            $arguments = ['/v:on', '/c', 'for /l %i in (0,0,1) do @(set /p line=& <nul 1>&2 set /p =!line!)'];
        }
        var $program = Core\Process::spawn($path, $arguments);
        bytes $line = "a line of output\n" as bytes;
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The program prints one line for each line it reads.
            // So each read returns exactly that one line.
            $program->writeStdin($line);
            ?bytes $part = $program->readStderr();
            // The total depends on every part, so no read can be skipped.
            if ($part != null) {
                $total = $total + Core\Bytes::length($part);
            }
            $i = $i + 1;
        }
        $program->kill();
        $program->wait();
        // This is the number of parts read, when the program printed something.
        if ($total == 0) {
            return 0;
        }
        return $i;
    }
}

echo Bench::run(512), "\n";
