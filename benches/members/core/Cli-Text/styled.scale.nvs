<?nvs
// Measures `Core\Cli\Text::styled` on one label, at growing label lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        var $style = Core\Cli\Style::of({color: Core\Cli\Color::RED, bold: true});
        string $label = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            var $text = Core\Cli\Text::styled($label, $style);
            $total = $total + Core\Str::length($text->text());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
