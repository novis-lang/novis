<?nvs
// Measures `text()` on one line of terminal text, at growing line lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        var $line = Core\Cli\Text::plain(Core\Str::repeat('a', $size));
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length($line->text());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
