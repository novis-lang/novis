<?nvs
// Measures one `Core\Log::write` with one field, as a server writes for each order it saves.
// bench: iterations 20000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $events = ["order saved", "payment taken", "email sent"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The message of each round is picked by the round before it, so no round can be
            // left out. The field is different each round, so no record repeats.
            int $pick = ($total % 3) as int;
            Core\Log::write(Core\Log\Level::Info, $events[$pick], ["order" => $i]);
            $total = $total + Core\Str::length($events[$pick]);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
