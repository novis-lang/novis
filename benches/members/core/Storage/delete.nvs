<?nvs
// Deletes a saved file, as a cleanup job does. Each round saves the file first, so it also counts one `put`.
// bench: iterations 2000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $keys = ["bench-delete-a.tmp", "bench-delete-b.tmp", "bench-delete-c.tmp"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $key = $keys[($total % 3) as int];
            Core\Storage::put("bench", $key, "x" as bytes);
            Core\Storage::delete("bench", $key);
            $total = $total + 1 + $i % 2;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2000), "\n";
