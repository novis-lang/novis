<?nvs
// Reads the bytes of a received UDP message, as a server does before it handles each request.
// bench: iterations 2000000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        Core\Net\Datagram $server = Core\Net::bindDatagram("127.0.0.1", 0);
        Core\Net\Datagram $client = Core\Net::bindDatagram("127.0.0.1", 0);
        $client->send("127.0.0.1", $server->port(), "status" as bytes, 1s);
        $client->send("127.0.0.1", $server->port(), "version" as bytes, 1s);
        array<Core\Net\Datagram\Message> $messages = [$server->receive(64, 5s), $server->receive(64, 5s)];
        $client->close();
        $server->close();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round picks its message from the payloads the rounds before read.
            if ($messages[($total % 2) as int]->payload() as string == "status") {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2000000), "\n";
