<?nvs
// Measures parsing a short piece of HTML into a tree, as a program does before it reads the links of a page.
// bench: iterations 20000

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $pieces = [
            "<p>Hello, <b>world</b>",
            "<ul><li>Apples<li>Pears<li>Plums</ul>",
            "<nav><a href=\"/\">Home</a> <a href=\"/help\">Help</a></nav>",
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The piece parsed in each round is chosen by the round before, so no round can be left out.
            var $tree = Core\Html::parse($pieces[($total % 3) as int]);
            $total = $total + Core\Arr::count($tree->children()) as uint + $i % 2;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
