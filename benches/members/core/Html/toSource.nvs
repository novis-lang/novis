<?nvs
// Measures getting the text of an HTML value, as a program does before it stores a rendered piece of a page.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Html\Markup> $cards = [
            Core\Html::escape("Tom & Jerry"),
            Core\Html::escape("Ada Lovelace"),
            Core\Html::escape("<b>Grace</b>"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The value read in each round is chosen by the round before, so no round can be left out.
            $total = $total + Core\Str::length(
                Core\Html::toSource($cards[(($total + $i) % 3) as int], "measuring the stored card"),
            );
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
