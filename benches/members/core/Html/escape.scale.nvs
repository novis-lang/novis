<?nvs
// Measures `Core\Html::escape` on one name, at growing name lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $name = Core\Str::repeat('a&<', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Html::toSource(Core\Html::escape($name), 'measuring the escaped name'));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
