<?nvs
// Builds a page with three `later` parts and reads it, as a page with a few slow boxes does.
// bench: iterations 2000

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $paths = ["/blog", "/shop", "/news"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $response = Core\Test::request(Core\Http\Method::Get, $paths[($total % 3) as int]);
            $total = $total + Core\Str::length($response->body());
            $i = $i + 1;
        }
        return $total;
    }
}

// Each request runs this file again. In that run, this part writes the page.
try {
    tainted string $path = Core\Request::path();
    Core\Html\Markup $title = Core\Html::later(fn(): Core\Html\Markup => html`<h1>{$path}</h1>`);
    Core\Html\Markup $list = Core\Html::later(fn(): Core\Html\Markup => html`<ul><li>one</li></ul>`);
    Core\Html\Markup $foot = Core\Html::later(fn(): Core\Html\Markup => html`<p>end</p>`);
    echo $title, $list, $foot;
} catch (LogicError $noRequest) {
    echo Bench::run(2000), "\n";
}
