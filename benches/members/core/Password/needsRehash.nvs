<?nvs
// Measures checking whether a stored hash is out of date, as a login does after
// the password is correct.
// bench: iterations 200000
// bench: allocations 2

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $stored = [
            '$argon2id$v=19$m=19456,t=2,p=1$jJ+hokoSJRsAzYsgfwhV6g$BGyWXoH11l0/GF4ezLqvtQgPY0T/4fv4DukErq9R0cI',
            '$argon2id$v=19$m=4096,t=2,p=1$jJ+hokoSJRsAzYsgfwhV6g$BGyWXoH11l0/GF4ezLqvtQgPY0T/4fv4DukErq9R0cI',
            '$2y$10$PE6UB/yJ1bk1dIwtgHee0es/SxguHDHJgvcdKauDX66xu84voItOi',
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The hash checked next depends on the total so far, so no round
            // can be skipped.
            if (Core\Password::needsRehash($stored[$total % 3])) {
                $total = $total + 1;
            } else {
                $total = $total + 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
