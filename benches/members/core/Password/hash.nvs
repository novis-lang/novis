<?nvs
// Measures hashing one password, as a sign-up form or a password change does.
// bench: iterations 20
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $passwords = ["hunter2", "correct horse battery staple", "my first pet"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The next password depends on the total so far, so no round can
            // be skipped.
            $total = $total + Core\Str::length(Core\Password::hash($passwords[($total % 3) as int]));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20), "\n";
