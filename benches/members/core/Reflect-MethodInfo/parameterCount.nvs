<?nvs
// Reads how many parameters a method has, as a job runner does before it calls a task with no arguments.
// bench: iterations 400000
// bench: allocations 0
// bench: complexity constant

class Tasks {
    public function clearCache(): bool {
        return true;
    }

    public function sendReport(string $email, int $days): bool {
        return true;
    }

    public function rotateLogs(int $keep): bool {
        return true;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Reflect\MethodInfo> $list = Core\Reflect::forObject(new Tasks())->methods();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Which method is read comes from last round's total, so no round can be reused.
            $total = $total + 1 + $list[($total % 3) as int]->parameterCount();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
