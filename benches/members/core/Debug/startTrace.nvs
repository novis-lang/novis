<?nvs
// Starts writing a trace to a new file and stops it again, as a program does around the part it debugs.
// bench: iterations 64
// bench: calls 2
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\IO::temporaryDir();
        array<string> $paths = [
            Core\Path::join($dir, "a.jsonl"),
            Core\Path::join($dir, "b.jsonl"),
            Core\Path::join($dir, "c.jsonl"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The round before decides which file the trace is written to.
            Core\Debug::startTrace($paths[(($total + $i) % 3) as int]);
            Core\Debug::stopTrace();
            $total = $total + 3;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
