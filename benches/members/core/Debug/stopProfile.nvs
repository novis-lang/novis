<?nvs
// Stops timing calls, as a program does when the part it wants to make faster has run.
// bench: iterations 256
// bench: calls 3
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        string $dir = Core\IO::temporaryDir();
        array<string> $paths = [
            Core\Path::join($dir, "a.json"),
            Core\Path::join($dir, "b.json"),
            Core\Path::join($dir, "c.json"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $path = $paths[(($total + $i) % 3) as int];
            Core\Debug::startProfile($path);
            // This call is timed before the profile stops.
            $total = $total + 3 * Core\Str::length($path);
            Core\Debug::stopProfile();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
