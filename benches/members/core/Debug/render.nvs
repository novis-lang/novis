<?nvs
// Measures one `Core\Debug::render` of a short row, which a program builds
// when it puts a value into a message it is about to print.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    // The rendering is kept, so the work is really done every round.
    public static ?Core\Cli\Text $last = null;

    public static function run(uint $rounds): uint {
        array<int> $row = [1, 2, 3];
        uint $total = 1;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the value rendered holds the number the last round made.
            $row[0] = ($total % 97) as int;
            Bench::$last = Core\Debug::render($row);
            $total = $total + ($i % 7) + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
