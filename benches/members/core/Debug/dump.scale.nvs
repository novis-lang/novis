<?nvs
// Measures one `Core\Debug::dump` of an array, at growing numbers of elements.
// bench: start 64
// bench: max 1024

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $row = [];
        uint $at = 0;
        while ($at < $size) {
            $row[] = $at as int;
            $at = $at + 1;
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Debug::dump($row);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
