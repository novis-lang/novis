<?nvs
// Measures reading one byte out of a `bytes` value. A program does this when
// it checks the first bytes of an uploaded file to see what kind of file it is.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0
// bench: statements 3
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        bytes $data = "Novis" as bytes;
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The byte read in one round picks the position of the next read,
            // so no round can be left out.
            $total = $total + Core\Bytes::at($data, ($total % 5) as int);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
