<?nvs
// Measures `Core\Bytes::fill` building one buffer, at growing buffer lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Bytes::length(Core\Bytes::fill($size + ($total % 7), 97));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
