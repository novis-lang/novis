<?nvs
// Measures `Core\Bytes::unpack` reading every byte of one message, at growing message lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        bytes $message = Core\Bytes::fill($size, 4);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            array<mixed> $fields = Core\Bytes::unpack($message, "C*");
            $total = $total + ($fields[1] as uint) + Core\Arr::count($fields);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
