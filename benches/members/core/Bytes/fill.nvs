<?nvs
// Measures `Core\Bytes::fill`, which builds a buffer of one byte repeated.
// A program uses it to pad a record up to a fixed size.
// bench: iterations 200000
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The result of one round sets the size of the next buffer, so no
            // round can be skipped. The sizes go from 16 to 271 bytes.
            $total = $total + Core\Bytes::length(Core\Bytes::fill(16 + ($total % 256), 97));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
