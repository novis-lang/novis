<?nvs
// Measures `Core\Bytes::repeat` building one buffer, at growing numbers of repeats.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        bytes $pattern = "-+" as bytes;
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Bytes::length(Core\Bytes::repeat($pattern, $size + ($total % 3)));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
