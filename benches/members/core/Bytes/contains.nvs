<?nvs
// Measures looking for a short run of bytes inside a small message. A program
// does this when it checks whether the message it has read is complete.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0
// bench: statements 3

class Bench {
    public static function run(uint $rounds): uint {
        bytes $message = "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n" as bytes;
        array<bytes> $needles = [
            Core\Encoding::fromHex("0d0a0d0a"),
            "Host:" as bytes,
            "Cookie:" as bytes,
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The result of one round picks the bytes the next round looks
            // for, so no round can be left out.
            $total = $total
                + ((Core\Bytes::contains($message, $needles[($total % 3) as int]) ? 2 : 1) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
