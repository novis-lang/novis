<?nvs
// Measures `Core\Bytes::contains` looking for bytes a message does not have, at growing message lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        bytes $message = Core\Bytes::fill($size, 97);
        bytes $needle = "Cookie:" as bytes;
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + ((Core\Bytes::contains($message, $needle) ? 2 : 1) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
