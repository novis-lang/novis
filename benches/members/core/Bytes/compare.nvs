<?nvs
// Measures ordering two eight-byte keys. A program does this when it sorts
// binary keys, or when it checks that a key falls inside a range.
// bench: iterations 400000
// bench: calls 0
// bench: allocations 0
// bench: statements 3
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        bytes $key = Core\Encoding::fromHex("0102030405060708");
        array<bytes> $others = [
            Core\Encoding::fromHex("0102030405060707"),
            Core\Encoding::fromHex("0102030405060708"),
            Core\Encoding::fromHex("0102030405060709"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The result of one round picks the value the next round compares
            // against, so no round can be left out.
            $total = $total + (Core\Bytes::compare($key, $others[($total % 3) as int]) + 2) as uint;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
