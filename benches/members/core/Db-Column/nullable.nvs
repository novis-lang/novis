<?nvs
// Measures asking whether a column may be empty, as an export does when it
// decides which columns need a check for a missing value.
// bench: iterations 2048
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        var $db = Core\Db::connect('notes');
        $db->execute('create table notes (id integer primary key, note text)', []);
        array<Core\Db\Column> $described =
            $db->query('select id, note from notes', [])->columns();

        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The count so far chooses the column, so the loop cannot be left
            // out. Both columns are described, so every round reads an answer.
            if ($described[($total % 2) as int]->nullable()) {
                $total = $total + 1;
            } else {
                $total = $total + 3;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
