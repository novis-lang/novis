<?nvs
// Measures how the subject of a received message is read, as a help desk does for each line of its inbox.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Message;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Message> $mails = [
            Message::parse("Subject: Re: Order 1042\r\n\r\nx"),
            Message::parse("Subject: =?UTF-8?Q?Cr=C3=A8me_br=C3=BBl=C3=A9e?=\r\n\r\nx"),
            Message::parse("Subject: Question about my delivery\r\n\r\nx"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each round adds the counter to the total so far. The result picks one of the three messages.
            // Three times the length is added, so the messages are picked in turn.
            uint $length = Core\Str::length($mails[(($total + $i) % 3) as int]->subject());
            $total = $total + $length * 3;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
