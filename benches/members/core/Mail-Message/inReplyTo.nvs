<?nvs
// Measures how the `In-Reply-To` id of a reply is read, as a program does to find the order a customer wrote about.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Message;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Message> $messages = [
            Message::parse("In-Reply-To: <a1@example.com>\n\nThanks!"),
            Message::parse("In-Reply-To: <order-42@example.com>\n\nThanks!"),
            Message::parse("In-Reply-To: <welcome-1042.7f3e@mail.example.com>\n\nThanks!"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // `$total` grows by a multiple of 3, so `($total + $i) % 3` is the same as `$i % 3`.
            // The loop reads message 1, 2, 3, then message 1 again, and so on.
            $total = $total + 3 * Core\Str::length($messages[(($total + $i) % 3) as int]->inReplyTo() ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
