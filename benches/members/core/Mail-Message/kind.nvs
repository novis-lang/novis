<?nvs
// Measures how a received message is parsed and classified, as a script does for each message in a bounce mailbox.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Message;

class Bench
{
    public static function run(uint $rounds): uint
    {
        string $groups = "--b\nContent-Type: message/delivery-status\n\nReporting-MTA: dns; mx.example.net\n\n";
        array<string> $messages = [
            "From: mailer-daemon@mx.example.net\nSubject: Undelivered Mail\n"
                . "Content-Type: multipart/report; report-type=delivery-status; boundary=\"b\"\n\n"
                . $groups . "Final-Recipient: rfc822; ada@example.org\nAction: failed\nStatus: 5.1.1\n"
                . "--b\nContent-Type: text/rfc822-headers\n\nMessage-ID: <order-42@example.com>\n\n--b--\n",
            "From: mailer-daemon@mx.example.net\nSubject: Delayed Mail\n"
                . "Content-Type: multipart/report; report-type=delivery-status; boundary=\"b\"\n\n"
                . $groups . "Final-Recipient: rfc822; bo@example.org\nAction: delayed\nStatus: 4.4.1\n--b--\n",
            "From: cy@example.org\nSubject: Re: Your order\nIn-Reply-To: <order-43@example.com>\n\nThank you.\n",
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Each kind adds a multiple of 3 to `$total`, so `($total + $i) % 3` is the same as `$i % 3`.
            // The loop reads message 1, 2, 3, then message 1 again, and so on.
            Message $message = Message::parse($messages[(($total + $i) % 3) as int]);
            int $step = match ($message->kind()) {
                Message::Kind::Bounce => 3,
                Message::Kind::Delay => 6,
                default => 9,
            };
            $total = $total + $step as uint;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
