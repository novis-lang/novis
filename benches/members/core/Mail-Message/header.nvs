<?nvs
// Measures how one header of a received message is read by its name, as a program does to find the mailing list of a message.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Message;

class Bench
{
    public static function run(uint $rounds): uint
    {
        string $head = "From: forum@example.com\nSubject: New answer\nReceived: from mx1.example.net\n";
        array<Message> $messages = [
            Message::parse($head . "List-Id: <a.example.com>\n\nHello"),
            Message::parse($head . "List-Id: Shop forum <forum.example.com>\n\nHello"),
            Message::parse($head . "List-Id: Shop news for customers <news.example.com>\n\nHello"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // `$total` grows by a multiple of 3, so `($total + $i) % 3` is the same as `$i % 3`.
            // The loop reads message 1, 2, 3, then message 1 again, and so on.
            array<tainted string> $values = $messages[(($total + $i) % 3) as int]->header('List-Id');
            $total = $total + 3 * Core\Str::length($values[0]);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
