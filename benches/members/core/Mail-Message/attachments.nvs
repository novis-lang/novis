<?nvs
// Measures how the attached files of a received message are read, as a program does before it saves each file.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Message;

class Bench
{
    public static function run(uint $rounds): uint
    {
        string $head = "MIME-Version: 1.0\nContent-Type: multipart/mixed; boundary=\"b1\"\n\n--b1\nContent-Type: text/plain\n\nHello\n";
        string $file = "--b1\nContent-Type: text/csv\nContent-Disposition: attachment; filename=\"orders.csv\"\n\nid,total\n";
        array<Message> $messages = [
            Message::parse($head . $file . "--b1--\n"),
            Message::parse($head . $file . $file . "--b1--\n"),
            Message::parse($head . $file . $file . $file . "--b1--\n"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // `$total` grows by a multiple of 3, so `($total + $i) % 3` is the same as `$i % 3`.
            // The loop reads message 1, 2, 3, then message 1 again, and so on.
            $total = $total + 3 * Core\Arr::count($messages[(($total + $i) % 3) as int]->attachments());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
