<?nvs
// Measures how the UID of a message is read, as a program does before it moves or deletes the message.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Message;

class Bench
{
    public static function run(uint $rounds): uint
    {
        // A UID is the number of a message in its mailbox folder. These messages have none, so `uid()` returns `null`.
        // Reading it costs the same as for a message fetched from a server.
        array<Message> $messages = [
            Message::parse("Subject: Hi\n\nThanks!"),
            Message::parse("Subject: Re: Order 42\n\nIt arrived."),
            Message::parse("Subject: Re: Ticket 7\n\nThe printer works again."),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // `$total` grows by a multiple of 3, so `($total + $i) % 3` is the same as `$i % 3`.
            // The loop reads message 1, 2, 3, then message 1 again, and so on.
            $total = $total + 3 * ($messages[(($total + $i) % 3) as int]->uid() ?? 1) as uint;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
