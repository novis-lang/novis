<?nvs
// Measures how the raw bytes of a received message are read, as a program does to save a copy of each message.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Message;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<Message> $messages = [
            Message::parse("Subject: Hi\n\nThanks!"),
            Message::parse("From: ada@example.org\nSubject: Re: Order 42\n\nIt arrived."),
            Message::parse("From: ada@example.org\nTo: shop@example.com\nSubject: Re: Ticket 7\n\nThe printer works again."),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // `$total` grows by a multiple of 3, so `($total + $i) % 3` is the same as `$i % 3`.
            // The loop reads message 1, 2, 3, then message 1 again, and so on.
            $total = $total + 3 * Core\Bytes::length($messages[(($total + $i) % 3) as int]->raw());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
