<?nvs
// Measures how the plain text of a received message is read, as a help desk does to save a reply.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Message;

class Bench
{
    public static function run(uint $rounds): uint
    {
        string $head = "From: ada@example.org\nSubject: Re: Ticket 7\n\n";
        array<Message> $messages = [
            Message::parse($head . 'Thanks!'),
            Message::parse($head . 'The printer works again.'),
            Message::parse($head . 'Can I change the address of order 42?'),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // `$total` grows by a multiple of 3, so `($total + $i) % 3` is the same as `$i % 3`.
            // The loop reads message 1, 2, 3, then message 1 again, and so on.
            $total = $total + 3 * Core\Str::length($messages[(($total + $i) % 3) as int]->text() ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
