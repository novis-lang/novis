<?nvs
// Measures how the HTML body of a received message is read, as a program does before it shows a reply on a page.
// bench: iterations 2048
// bench: complexity constant

use Core\Mail\Message;

class Bench
{
    public static function run(uint $rounds): uint
    {
        string $head = "From: ada@example.org\nMIME-Version: 1.0\nContent-Type: text/html\n\n";
        array<Message> $messages = [
            Message::parse($head . '<p>Thanks!</p>'),
            Message::parse($head . '<p>The <b>mug</b> arrived.</p>'),
            Message::parse($head . '<p>Can I change the address of order 42?</p>'),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // `$total` grows by a multiple of 3, so `($total + $i) % 3` is the same as `$i % 3`.
            // The loop reads message 1, 2, 3, then message 1 again, and so on.
            $total = $total + 3 * Core\Str::length($messages[(($total + $i) % 3) as int]->html() ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
