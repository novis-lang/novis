<?nvs
// Measures checking whether a heap is empty, as a worker does before it takes the next job.
// bench: iterations 400000
// bench: allocations 0
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Heap<int>> $heaps = [new Core\Heap<int>(), new Core\Heap<int>(), new Core\Heap<int>()];
        $heaps[1]->push(4);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The heap checked in each round is chosen by the round before, so no round can be left out.
            if ($heaps[($total % 3) as int]->isEmpty()) {
                $total = $total + 2;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
