<?nvs
// Measures counting the values in a heap, as a worker does when it reports how many jobs are waiting.
// bench: iterations 400000
// bench: allocations 0
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<Core\Heap<int>> $heaps = [new Core\Heap<int>(), new Core\Heap<int>(), new Core\Heap<int>()];
        $heaps[1]->push(4);
        $heaps[2]->push(4);
        $heaps[2]->push(9);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The heap counted in each round is chosen by the round before, so no round can be left out.
            $total = $total + $heaps[($total % 3) as int]->count() + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
