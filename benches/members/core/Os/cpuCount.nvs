<?nvs
// Measures reading the number of cores. A program does this when it decides
// how many workers to start.
// bench: iterations 20000
// bench: calls 0
// bench: allocations 0
// bench: statements 3

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The reading of every round is added to the total, so no round can
            // be left out.
            $total = $total + Core\Os::cpuCount();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
