<?nvs
// Measures reading the machine's name. A program does this when it writes the
// name into a log line or a worker's name.
// bench: iterations 20000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The length of every reading is added to the total, so no round
            // can be left out.
            $total = $total + Core\Str::length(Core\Os::hostname());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(20000), "\n";
