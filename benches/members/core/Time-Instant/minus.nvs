<?nvs
// Moves an instant back by a duration, as a program does when it finds the start of a time window.
// bench: iterations 400000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        Core\Time\Instant $now = Core\Time::fromEpoch(1709294400);
        array<Core\Time\Duration> $windows = [1m, 1h, 24h];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks the window
            Core\Time\Instant $start = $now->minus($windows[$total % 3]);
            $total = $total + $start->toEpochSeconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
