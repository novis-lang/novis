<?nvs
// Writes an instant as RFC 3339 text, as a program does for every date in a JSON reply.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        Core\Time\Instant $start = Core\Time::fromEpoch(1709294400);
        array<Core\Time\Instant> $times = [$start, $start->plus(250ms), $start->plus(1ns)];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks the instant
            $total = $total + Core\Str::length($times[($total % 3) as int]->toIso()) % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
