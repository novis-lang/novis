<?nvs
// Measures the time between two instants, as a program does when it logs how long a request took.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        Core\Time\Instant $start = Core\Time::fromEpoch(1709294400);
        array<Core\Time\Instant> $ends = [$start->plus(80ms), $start->plus(750ms), $start->plus(2s)];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks the end
            Core\Time\Duration $took = $ends[$total % 3]->since($start);
            $total = $total + $took->toMilliseconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
