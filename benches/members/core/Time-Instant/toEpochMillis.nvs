<?nvs
// Reads the milliseconds since 1970 of an instant, as a program does before it sends a time to JavaScript.
// bench: iterations 400000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        array<Core\Time\Instant> $moments = [
            Core\Time::fromEpoch(1709294400, {nanos: 250000000}),
            Core\Time::fromEpoch(-86400, {nanos: 500000000}),
            Core\Time::fromEpoch(253402207200),
        ];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks the instant
            $total = $total + $moments[$total % 3]->toEpochMillis() % 13 + 14;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
