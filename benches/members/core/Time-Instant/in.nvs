<?nvs
// Shows an instant in a time zone, as a program does before it prints a date for a user.
// bench: iterations 200000

class Bench {
    public static function run(uint $rounds): uint {
        Core\Time\Instant $now = Core\Time::fromEpoch(1709294400);
        array<Core\Time\Zone> $zones = [
            Core\Time\Zone::UTC,
            Core\Time\Zone::of("Europe/Berlin"),
            Core\Time\Zone::of("America/New_York"),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks the zone
            Core\Time\DateTime $local = $now->in($zones[($total % 3) as int]);
            $total = $total + $local->dayOfYear() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
