<?nvs
// Measures `clear` on a map of objects, at growing numbers of entries.
// It shows how the cost of `clear` grows when the map grows.
// bench: start 256
// bench: max 4096

final class Key {
    public int $id;

    public function constructor(int $id) {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(uint $size): uint
    {
        array<Key> $keys = [];
        uint $n = 0;
        while ($n < $size) {
            $keys[] = new Key($n as int);
            $n = $n + 1;
        }
        Core\ObjectMap<Key, uint> $cache = new Core\ObjectMap<Key, uint>();
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            // Each round fills the map again, and then empties it.
            foreach ($keys as Key $key) {
                $cache->set($key, $i);
            }
            $total = $total + $cache->count();
            $cache->clear();
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
