<?nvs
// Checks if a string is a key in a map. A program does this so that it loads each record once.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

final class Item
{
    public int $id;

    public function constructor(int $id)
    {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $keys = ['order', 'customer', 'invoice'];
        Core\ObjectMap<string, Item> $map = new Core\ObjectMap<string, Item>();
        $map->set($keys[0], new Item(1));
        $map->set($keys[2], new Item(3));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // `$total` from the last round picks the key for this round.
            // A found key adds 4 and a missing key adds 1, so the rounds check the three keys in turn.
            $total = $total + ($map->has($keys[($total % 3) as int]) ? (4 as uint) : (1 as uint));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
