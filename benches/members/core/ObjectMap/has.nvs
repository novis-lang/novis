<?nvs
// Checks if an object is a key in a map, as a program does before it does a piece of work only once.
// bench: iterations 1000000
// bench: allocations 0
// bench: complexity constant

final class Key {
    public int $id;

    public function constructor(int $id) {
        $this->id = $id;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Key> $keys = [new Key(1), new Key(2), new Key(3)];
        Core\ObjectMap<Key, int> $map = new Core\ObjectMap<Key, int>();
        $map->set($keys[0], 1);
        $map->set($keys[2], 3);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: which key is checked depends on last round's total
            $total = $total + 1 + ($map->has($keys[($total % 3) as int]) ? (1 as uint) : (0 as uint));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000000), "\n";
