<?nvs
// Measures the same read as the `get` bench, from an array that uses the same strings as keys.
// bench: iterations 2048

final class Item
{
    public int $id;

    public function constructor(int $id)
    {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $keys = ['order', 'customer', 'invoice'];
        array<Item> $items = [];
        $items[$keys[0]] = new Item(1);
        $items[$keys[1]] = new Item(4);
        $items[$keys[2]] = new Item(7);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + ((($items[$keys[($total % 3) as int]] ?? null)?->id ?? 0) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
