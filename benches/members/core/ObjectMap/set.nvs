<?nvs
// Replaces the object stored for a string key, as a program does when it keeps the latest record per name.
// bench: iterations 256
// bench: allocations 0
// bench: calls 1
// bench: complexity constant

final class Item
{
    public int $id;

    public function constructor(int $id)
    {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $keys = ['order', 'customer', 'invoice'];
        array<Item> $values = [new Item(1), new Item(2), new Item(3)];
        Core\ObjectMap<string, Item> $map = new Core\ObjectMap<string, Item>();
        $map->set($keys[0], $values[0]);
        $map->set($keys[1], $values[0]);
        $map->set($keys[2], $values[0]);
        uint $total = 0;
        while ($rounds > 0) {
            // The total from the last round picks the key and the object for this round.
            $map->set($keys[($total % 3) as int], $values[(($total + $rounds) % 3) as int]);
            $total = $total + 1 + ($total % 7);
            $rounds = $rounds - 1;
        }
        return $total + (($map->get($keys[0])?->id ?? 0) as uint);
    }
}

echo Bench::run(256), "\n";
