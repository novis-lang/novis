<?nvs
// Replaces the value stored for an object, as a program does when it counts something per object.
// bench: iterations 1000000
// bench: complexity constant

final class Key {
    public int $id;

    public function constructor(int $id) {
        $this->id = $id;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Key> $keys = [new Key(1), new Key(2), new Key(3)];
        Core\ObjectMap<Key, uint> $map = new Core\ObjectMap<Key, uint>();
        $map->set($keys[0], 0);
        $map->set($keys[1], 0);
        $map->set($keys[2], 0);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: which key is written depends on last round's total
            $map->set($keys[($total % 3) as int], $total);
            $total = $total + 1 + ($total % 7);
            $i = $i + 1;
        }
        return $total + ($map->get($keys[0]) ?? (0 as uint));
    }
}

echo Bench::run(1000000), "\n";
