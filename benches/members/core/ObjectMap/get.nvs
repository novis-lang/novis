<?nvs
// Reads the object stored for a string key, as a program does when it looks up a record it loaded earlier.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

final class Item
{
    public int $id;

    public function constructor(int $id)
    {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $keys = ['order', 'customer', 'invoice'];
        Core\ObjectMap<string, Item> $map = new Core\ObjectMap<string, Item>();
        $map->set($keys[0], new Item(1));
        $map->set($keys[1], new Item(4));
        $map->set($keys[2], new Item(7));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The total from the last round picks the key for this round.
            // Each id adds 1 to the remainder, so the rounds read every key in turn.
            $total = $total + (($map->get($keys[($total % 3) as int])?->id ?? 0) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
