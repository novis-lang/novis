<?nvs
// Reads the value stored for an object, as a program does when it looks up a result it saved earlier.
// bench: iterations 1000000
// bench: allocations 0

final class Key {
    public int $id;

    public function constructor(int $id) {
        $this->id = $id;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        array<Key> $keys = [new Key(1), new Key(2), new Key(3)];
        Core\ObjectMap<Key, uint> $map = new Core\ObjectMap<Key, uint>();
        $map->set($keys[0], 1);
        $map->set($keys[1], 2);
        $map->set($keys[2], 3);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: which key is read depends on last round's total
            $total = $total + ($map->get($keys[($total % 3) as int]) ?? (0 as uint));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000000), "\n";
