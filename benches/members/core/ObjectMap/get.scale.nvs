<?nvs
// Measures `get` on a map with string keys, at growing numbers of keys.
// It shows that a larger map does not make one read slower.
// bench: start 12500
// bench: max 100000
// bench: rounds 2048

final class Item
{
    public int $id;

    public function constructor(int $id)
    {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(uint $size, uint $rounds): uint
    {
        int $n = $size as int;
        array<string> $keys = [];
        Core\ObjectMap<string, Item> $map = new Core\ObjectMap<string, Item>();
        int $k = 0;
        while ($k < $n) {
            string $key = "key{$k}";
            $keys[] = $key;
            $map->set($key, new Item(1));
            $k = $k + 1;
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Every id is 1, so the rounds read the keys one after another.
            $total = $total + (($map->get($keys[($total % $size) as int])?->id ?? 0) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(12500, 2048), "\n";
