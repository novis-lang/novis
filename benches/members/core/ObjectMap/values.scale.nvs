<?nvs
// Measures `values` on a map of objects, at growing numbers of entries.
// It shows how the cost of `values` grows when the map grows.
// bench: start 256
// bench: max 4096

final class Key {
    public int $id;

    public function constructor(int $id) {
        $this->id = $id;
    }
}

class Bench
{
    public static function run(uint $size): uint
    {
        Core\ObjectMap<Key, uint> $map = new Core\ObjectMap<Key, uint>();
        uint $n = 0;
        while ($n < $size) {
            $map->set(new Key($n as int), $n);
            $n = $n + 1;
        }
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Arr::count($map->values());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
