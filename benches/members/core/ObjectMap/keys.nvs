<?nvs
// Lists the keys of a small map, as a program does before it passes the objects to another function.
// bench: iterations 400000

final class Key {
    public int $id;

    public function constructor(int $id) {
        $this->id = $id;
    }
}

class Bench {
    public static function run(uint $rounds): uint {
        Core\ObjectMap<Key, int> $map = new Core\ObjectMap<Key, int>();
        $map->set(new Key(1), 1);
        $map->set(new Key(2), 2);
        $map->set(new Key(3), 3);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: which key is read depends on last round's total
            array<Key> $keys = $map->keys();
            $total = $total + 1 + ($keys[($total % 3) as int]->id as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
