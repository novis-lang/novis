<?nvs
// Measures `Core\Csrf::issue` for one session, at growing session id lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        secret bytes $key = Core\Crypto::generateKey();
        string $session = Core\Str::repeat('s', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $total = $total + Core\Str::length(Core\Csrf::issue($session, $key));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
