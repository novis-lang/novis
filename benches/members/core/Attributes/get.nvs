<?nvs
// Measures reading one attribute off a method, as a router does for every handler
// it knows about when the program starts.
// bench: iterations 256
// bench: calls 0
// bench: allocations 1
// bench: complexity constant

type Route = {path: string};

class Orders {
    #[Route(path: "/orders/{id}")]
    public function show(int $id): int { return $id; }
}

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            ?Route $route = Core\Attributes::get<Route>(Orders::show(...));
            if ($route != null) {
                // Chained: the length counted this round is added to the total
                // carried out of the round before.
                $total = $total + Core\Str::length($route->path) + $total % 2;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
