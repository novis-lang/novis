<?nvs
// Checks whether the server is shutting down, as a long job does before each item it works on.
// bench: iterations 1000000
// bench: allocations 0
// bench: calls 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            if (Core\Server::isDraining()) {
                $total = $total + 2;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000000), "\n";
