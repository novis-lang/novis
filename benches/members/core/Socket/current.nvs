<?nvs
// Gets the connection, as a connection script does on its first line and in every helper it calls.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Socket $conn = Core\Socket::current();
            $total = $total + ($total % 3) + 1;   // chained: each round depends on the last
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
