<?nvs
// Sends a short text message to the client, as a connection does for every update it pushes.
// bench: iterations 256
// bench: complexity linear

class Bench {
    public static function run(Core\Socket $conn, uint $rounds): uint {
        array<string> $updates = ["ok", "tick 42", "price 12.50"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $update = $updates[($total % 3) as int];
            $conn->send($update);
            $total = $total + Core\Str::length($update);   // chained: the next update depends on this one
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(Core\Socket::current(), 256), "\n";
