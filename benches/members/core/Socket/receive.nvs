<?nvs
// Reads a message posted to a topic, as a chat connection does for every line somebody posts in its room.
// bench: iterations 20000
// bench: complexity linear

class Bench {
    public static function run(Core\Socket $conn, uint $rounds): uint {
        Core\Topic::subscribe("room:lobby");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Topic::publish("room:lobby", $total % 7);
            ?Core\Socket\Message $message = $conn->receive();
            uint $posted = $message?->value() as uint;
            $total = $total + $posted + 1;   // chained: the next post depends on this one
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(Core\Socket::current(), 20000), "\n";
