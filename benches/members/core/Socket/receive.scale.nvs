<?nvs
// Measures `receive` on a connection for one message posted to a topic, at growing message lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(Core\Socket $conn, uint $size): uint
    {
        Core\Topic::subscribe("room:lobby");
        string $line = Core\Str::repeat('a', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Topic::publish("room:lobby", $line);
            ?Core\Socket\Message $message = $conn->receive();
            tainted string $posted =$message?->value() as string;
            $total = $total + Core\Str::length($posted) % 7 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(Core\Socket::current(), 256), "\n";
