<?nvs
// Reads a duration written as hours and minutes, as a program does with a time a person types into a form.
// bench: iterations 256
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): int
    {
        array<string> $texts = ['0:05', '1:30', '25:30:15'];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks which text is read
            Core\Time\Duration $read = Core\Time\Duration::fromClock($texts[$total % 3]);
            $total = $total + $read->toSeconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
