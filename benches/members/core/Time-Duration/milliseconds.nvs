<?nvs
// Creates a duration from a number of milliseconds, as a program does when it reads a timeout from its settings.
// bench: iterations 400000

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the number of milliseconds comes from last round's total
            $total = $total + Core\Time\Duration::milliseconds($total % 3000)->toMilliseconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
