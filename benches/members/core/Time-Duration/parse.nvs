<?nvs
// Reads a duration from a short text, as a program does with a timeout from a configuration file.
// bench: iterations 400000

class Bench {
    public static function run(uint $rounds): int {
        array<string> $texts = ["30s", "1h30m", "250ms"];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks which text is read
            Core\Time\Duration $read = Core\Time\Duration::parse($texts[$total % 3]);
            $total = $total + $read->toMilliseconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
