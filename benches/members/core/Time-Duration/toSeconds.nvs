<?nvs
// Reads a duration as a number of seconds, as a program does when it writes a `max-age` header.
// bench: iterations 400000
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        array<Core\Time\Duration> $took = [90s, 1h, 1500ms, 1d];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the duration is picked with last round's total
            $total = $total + $took[$total % 4]->toSeconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
