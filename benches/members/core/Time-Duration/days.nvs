<?nvs
// Creates a duration from a number of days, as a program does when it reads a setting such as "keep logs for 30 days".
// bench: iterations 400000
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the number of days comes from last round's total
            $total = $total + Core\Time\Duration::days($total % 90)->toSeconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
