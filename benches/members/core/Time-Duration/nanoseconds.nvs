<?nvs
// Creates a duration from a number of nanoseconds, as a program does when it reads a timer or a log.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the number of nanoseconds comes from last round's total
            $total = $total + Core\Time\Duration::nanoseconds($total * 1000003)->toNanoseconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
