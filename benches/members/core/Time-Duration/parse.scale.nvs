<?nvs
// Measures `Core\Time\Duration::parse` reading one duration that starts with zeros, at growing numbers of zeros.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): int
    {
        string $text = Core\Str::repeat('0', $size) . '30s';
        int $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Time\Duration $read = Core\Time\Duration::parse($text);
            $total = $total + $read->toMilliseconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
