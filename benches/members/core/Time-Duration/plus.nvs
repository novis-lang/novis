<?nvs
// Adds one duration to another, as a program does when it adds up the time of several steps.
// bench: iterations 400000

class Bench {
    public static function run(uint $rounds): int {
        Core\Time\Duration $short = 1ms;
        Core\Time\Duration $long = 30s;
        Core\Time\Duration $back = $long->negated();
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total picks which of the two is added to the other
            Core\Time\Duration $sum = $total % 2 == 0 ? $long->plus($short) : $short->plus($back);
            $total = $total + $sum->toMilliseconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
