<?nvs
// Builds a duration from a number of seconds, as a program does with a timeout it read as a number.
// bench: iterations 400000

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: last round's total is the count of seconds
            Core\Time\Duration $made = Core\Time\Duration::seconds($total % 3600);
            $total = $total + $made->toSeconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
