<?nvs
// Reads a duration as a number of milliseconds, as a program does when it sends a wait time to a browser.
// bench: iterations 400000
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): int {
        array<Core\Time\Duration> $took = [120ms, 2s500ms, 999us, 16s];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the duration is picked with last round's total
            $total = $total + $took[$total % 4]->toMilliseconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(400000), "\n";
