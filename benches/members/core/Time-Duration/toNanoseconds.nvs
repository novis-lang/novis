<?nvs
// Reads a duration as a number of nanoseconds, as a program does before it saves a measured time.
// bench: iterations 512
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        array<Core\Time\Duration> $took = [120ms, 250ms, 1400ms, 90ms];
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the duration is picked with last round's total
            $total = $total + $took[$total % 4]->toNanoseconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(512), "\n";
