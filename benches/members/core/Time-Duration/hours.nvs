<?nvs
// Creates a duration from a number of hours, as a program does when it reads a setting such as "links expire after 48 hours".
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the number of hours comes from last round's total
            $total = $total + Core\Time\Duration::hours($total % 72)->toSeconds() % 13 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
