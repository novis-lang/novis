<?nvs
// Compares two durations, as a program does when it checks how long a task took against a limit.
// bench: iterations 2048
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): int {
        array<Core\Time\Duration> $took = [120ms, 250ms, 1400ms, 90ms];
        Core\Time\Duration $limit = 250ms;
        int $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // chained: the duration is picked with last round's total
            $total = $total + 2 + $took[$total % 4]->compareTo($limit);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
