<?nvs
// Measures reading a streamed reply as server-sent events, at growing numbers of events.
// bench: start 64
// bench: max 1024

class Bench
{
    public static function run(uint $size): uint
    {
        // The reply comes from this table, so nothing is sent over a network.
        Core\Test::answerHttp('https://feed.example.com/a', 200, { body: Core\Str::repeat("data: tick\n\n", $size) });
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Http\Stream $feed = Core\Http\Client::stream(Core\Http\Method::Get, 'https://feed.example.com/a');
            foreach ($feed->events() as Core\Http\Event $event) {
                $total = $total + Core\Str::length($event->data());
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
