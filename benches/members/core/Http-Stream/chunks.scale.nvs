<?nvs
// Measures reading the body of a streamed reply piece by piece, at growing body sizes.
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): uint
    {
        // The reply comes from this table, so nothing is sent over a network.
        Core\Test::answerHttp('https://files.example.com/a.bin', 200, { body: Core\Str::repeat('a', $size) });
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Http\Stream $download = Core\Http\Client::stream(Core\Http\Method::Get, 'https://files.example.com/a.bin');
            foreach ($download->chunks() as tainted bytes $piece) {
                $total = $total + Core\Bytes::length($piece);
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
