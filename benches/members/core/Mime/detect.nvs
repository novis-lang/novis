<?nvs
// Finds the type of an uploaded file, as a server does before it stores the upload.
// bench: iterations 256
// bench: allocations 1
// bench: calls 1
// bench: complexity constant

class Bench
{
    public static function run(uint $rounds): uint
    {
        // The upload is the PDF file in the form in `detect.nvsr` beside this one.
        // `detect` reads only the start of the file, so every round reads the same bytes.
        uint $total = 0;
        foreach (Core\Request::files() as Core\Request\Part $upload) {
            uint $i = 0;
            while ($i < $rounds) {
                if (Core\Mime::detect($upload) == Core\Mime::Type::Pdf) {
                    $total = $total + 1;
                }
                $i = $i + 1;
            }
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
