<?nvs
// Measures finding the type of an uploaded file, as a server does before it stores the upload.
// bench: iterations 1024
// bench: allocations 0
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        bytes $png = Core\Encoding::fromHex("89504e470d0a1a0a");
        bytes $pdf = Core\Encoding::fromHex("255044462d312e37");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // Chained: the upload read this round depends on last round's total.
            bytes $upload = $png;
            if ($total % 2 == 1) {
                $upload = $pdf;
            }
            if (Core\Mime::detect($upload) == Core\Mime\Type::Png) {
                $total = $total + 1;
            }
            $total = $total + 2;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1024), "\n";
