--METHOD--
POST
--PATH--
/invoices
--SCHEME--
https
--HEADERS--
host: example.com
content-type: multipart/form-data; boundary=----ShopFormBoundary
--BODY_CRLF--
------ShopFormBoundary
Content-Disposition: form-data; name="invoice"; filename="invoice.pdf"
Content-Type: application/pdf

%PDF-1.7
1 0 obj << /Type /Catalog /Pages 2 0 R >> endobj
2 0 obj << /Type /Pages /Kids [] /Count 0 >> endobj
trailer << /Root 1 0 R >>
%%EOF
------ShopFormBoundary--
