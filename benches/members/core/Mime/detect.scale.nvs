<?nvs
// Prints the request for the `Core\Mime::detect` bench, with an uploaded PDF file of `$size` bytes.
// bench: prints
// bench: start 1024
// bench: max 16384

class Bench
{
    public static function run(uint $size): string
    {
        string $boundary = '------ShopFormBoundary';
        array<string> $lines = [
            '// scaling: file detect.nvsr',
            '--METHOD--',
            'POST',
            '--PATH--',
            '/invoices',
            '--SCHEME--',
            'https',
            '--HEADERS--',
            'host: example.com',
            'content-type: multipart/form-data; boundary=----ShopFormBoundary',
            '--BODY_CRLF--',
            $boundary,
            "Content-Disposition: form-data; name=\"invoice\"; filename=\"invoice.pdf\"",
            'Content-Type: application/pdf',
            '',
            '%PDF-1.7',
            Core\Str::repeat('a', $size),
            $boundary . '--',
        ];
        return Core\Str::join($lines, "\n") . "\n";
    }
}

echo Bench::run(1024);
