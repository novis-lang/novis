<?nvs
// Measures replacing the rows of a live region, at growing numbers of rows.
// bench: start 16
// bench: max 128

class Bench
{
    public static function run(uint $size): int
    {
        array<Core\Cli\Text> $rows = [];
        uint $row = 0;
        while ($row < $size) {
            $rows[] = Core\Cli\Text::plain("reading");
            $row = $row + 1;
        }
        return Core\Cli::live(fn(Core\Cli\Live $screen): int => {
            int $total = 0;
            uint $i = 0;
            while ($i < 64) {
                $screen->set($rows);
                $total = $total + 1;
                $i = $i + 1;
            }
            return $total;
        });
    }
}

echo Bench::run(16), "\n";
