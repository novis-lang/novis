<?nvs
// Measures `content` with a long text that has characters to escape, at growing text lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $text = Core\Str::repeat('Cable <USB-C> & ', $size);
        Core\Xml\Writer $writer = Core\Xml::writer();
        $writer->startDocument();
        $writer->startElement("products");
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $writer->content($text);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
