<?nvs
// Measures `instruction` with a long data text, at growing data lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $data = Core\Str::repeat('step=1 ', $size);
        Core\Xml\Writer $writer = Core\Xml::writer();
        $writer->startDocument();
        $writer->startElement("feed");
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $writer->instruction("app", $data);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
