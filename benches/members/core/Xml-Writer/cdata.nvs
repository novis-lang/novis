<?nvs
// Writes HTML as CDATA sections inside an element, as a program does when it builds a news feed.
// bench: iterations 50000
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $parts = ["<p>New tea</p>", "<b>Sale</b> & more", "a < b"];
        Core\Xml\Writer $writer = Core\Xml::writer();
        $writer->startDocument();
        $writer->startElement("feed");
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $writer->cdata($parts[(($total + $i) % 3) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(50000), "\n";
