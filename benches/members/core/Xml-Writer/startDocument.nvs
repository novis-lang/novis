<?nvs
// Starts a new document with a new writer, as a program does once for every XML file or reply it writes.
// bench: iterations 256
// bench: complexity constant

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $indents = ["", "  "];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Core\Xml\Writer $writer = Core\Xml::writer({indent: $indents[($total % 2) as int]});
            $writer->startDocument();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
