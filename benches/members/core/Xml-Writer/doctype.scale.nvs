<?nvs
// Measures `doctype` with a long document type name, at growing name lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $name = Core\Str::repeat('note', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            Core\Xml\Writer $writer = Core\Xml::writer();
            $writer->startDocument();
            $writer->doctype($name);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
