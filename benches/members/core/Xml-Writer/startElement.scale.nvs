<?nvs
// Measures `startElement` with a long element name, at growing name lengths.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $name = Core\Str::repeat('item', $size);
        Core\Xml\Writer $writer = Core\Xml::writer();
        $writer->startDocument();
        $writer->startElement("list");
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $writer->startElement($name);
            $writer->endElement();
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
