<?nvs
// Measures `Core\Json::decode` on a list of orders, at growing document sizes in bytes.
// bench: start 1024
// bench: max 33554432

class Bench
{
    public static function run(uint $size): uint
    {
        // One order is 66 bytes, so the list has `$size / 66` of them.
        string $order = '{"id":7,"name":"Grüße \"Ada\"\n","price":12.5,"tags":[1,22,333]}';
        uint $count = Core\Math::intDiv($size as int, 66) as uint;
        string $body = '[' . Core\Str::repeat($order . ',', $count - 1) . $order . ']';
        var $decoded = Core\Json::decode($body) as array<mixed>;
        return Core\Arr::count($decoded) + Core\Budget::memoryPeak();
    }
}

echo Bench::run(1024), "\n";
