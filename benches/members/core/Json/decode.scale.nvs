<?nvs
// Measures `Core\Json::decode` on one JSON array, at growing numbers of values.
// bench: start 64
// bench: max 1024

class Bench
{
    public static function run(uint $size): uint
    {
        string $body = '[' . Core\Str::repeat('7,', $size) . '7]';
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            var $decoded = Core\Json::decode($body) as array<mixed>;
            $total = $total + Core\Arr::count($decoded);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
