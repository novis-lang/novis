<?nvs
// Measures `Core\Json::decodeAs` on a list of orders, at growing document sizes in bytes.
// bench: start 1024
// bench: max 33554432

#[Core\Json\Derive]
class Order
{
    public int $id;
    public string $name;
    public float $price;
    public array<int> $tags;

    public function constructor(int $id, string $name, float $price, array<int> $tags)
    {
        $this->id = $id;
        $this->name = $name;
        $this->price = $price;
        $this->tags = $tags;
    }
}

#[Core\Json\Derive]
class Orders
{
    public array<Order> $items;

    public function constructor(array<Order> $items)
    {
        $this->items = $items;
    }
}

class Bench
{
    public static function run(uint $size): uint
    {
        // One order is 66 bytes, so the list has `$size / 66` of them.
        string $order = '{"id":7,"name":"Grüße \"Ada\"\n","price":12.5,"tags":[1,22,333]}';
        uint $count = Core\Math::intDiv($size as int, 66) as uint;
        string $body = '{"items":[' . Core\Str::repeat($order . ',', $count - 1) . $order . ']}';
        var $orders = Core\Json::decodeAs<Orders>($body);
        return Core\Arr::count($orders->items) + Core\Budget::memoryPeak();
    }
}

echo Bench::run(1024), "\n";
