<?nvs
// Measures `Core\Json::decodeAs` on a class that contains itself, at growing nesting depths.
// bench: start 32
// bench: max 512

#[Core\Json\Derive]
class Node
{
    public string $name;
    public ?Node $child;

    public function constructor(string $name, ?Node $child)
    {
        $this->name = $name;
        $this->child = $child;
    }
}

class Bench
{
    public static function run(uint $size): uint
    {
        string $body = Core\Str::repeat("{\"name\":\"a\",\"child\":", $size)
            . 'null'
            . Core\Str::repeat('}', $size);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            var $node = Core\Json::decodeAs<Node>($body);
            $total = $total + Core\Str::length($node->name);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
