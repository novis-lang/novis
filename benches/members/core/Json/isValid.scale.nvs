<?nvs
// Measures `Core\Json::isValid` on one JSON array, at growing numbers of values.
// bench: start 64
// bench: max 1024

class Bench
{
    public static function run(uint $size): uint
    {
        string $body = '[' . Core\Str::repeat('7,', $size) . '7]';
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            if (Core\Json::isValid($body)) {
                $total = $total + 2;
            } else {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(64), "\n";
