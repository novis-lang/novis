<?nvs
// Checks that a small request body is valid JSON, as an API does before it decodes the body.
// bench: iterations 50000

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $bodies = [
            "{\"id\":7,\"name\":\"Ada\",\"tags\":[\"admin\",\"editor\"],\"active\":true}",
            "{\"order\":1042,\"items\":[{\"sku\":\"T-1\",\"count\":2}],\"paid\":false,\"note\":null}",
            "{\"query\":\"green tea\",\"page\":3,\"filters\":{\"inStock\":true},\"sort\":\"price\",",
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The body in each round depends on the round before, so no round can be left out.
            $total = $total + 1;
            if (Core\Json::isValid($bodies[($total % 3) as int])) {
                $total = $total + 1;
            }
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(50000), "\n";
