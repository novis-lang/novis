<?nvs
// Measures adding one piece to an open compression stream. A program meets
// this on every row it writes into a compressed export.
// bench: iterations 100000
// bench: calls 0
// `add` keeps the piece it was given instead of copying it, so one piece costs
// no memory of its own.
// bench: allocations 0

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $cities = ['Berlin', 'Lisbon', 'Oslo'];
        var $stream = Core\Compress::compressor(Core\Codec::Zstd);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            // The piece of each round is chosen by the rounds before it, so no
            // round can be left out.
            $stream->add($cities[($total % 3) as int]);
            $total = $total + $i + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
