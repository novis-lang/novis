<?nvs
// Measures adding one piece to an open compression stream, at growing piece sizes.
// bench: start 256
// bench: max 4096

class Bench
{
    public static function run(uint $size): uint
    {
        string $piece = Core\Str::repeat('Berlin', $size);
        var $stream = Core\Compress::compressor(Core\Codec::Zstd);
        uint $total = 0;
        uint $i = 0;
        while ($i < 64) {
            $stream->add($piece);
            $total = $total + $i + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
