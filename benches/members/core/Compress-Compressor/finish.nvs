<?nvs
// Measures closing a compression stream that was given sixteen pieces: the
// join and the compression a program pays for once per compressed file.
// bench: iterations 256
// bench: calls 0
// bench: complexity linear

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $rows = ['1042,Berlin', '1043,Lisbon', '1044,Oslo'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $stream = Core\Compress::compressor(Core\Codec::Zstd);
            uint $piece = 0;
            while ($piece < 16) {
                // The rows of each round are chosen by the round before it, so
                // no round can be left out.
                $stream->add($rows[(($total + $piece) % 3) as int]);
                $piece = $piece + 1;
            }
            $total = $total + Core\Bytes::length($stream->finish());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
