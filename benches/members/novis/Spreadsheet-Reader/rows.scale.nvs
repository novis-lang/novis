<?nvs
// Reads a growing number of rows from an xlsx file, up to a million rows, as a shop does when it imports a large catalogue.
// bench: start 1024
// bench: max 1048576
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Row;
use Novis\Spreadsheet\Workbook;

class Items
{
    public function constructor(private uint $size)
    {}

    public function rows(): Iterator<array<mixed>>
    {
        yield ['Item', 'Name', 'Price'];
        uint $n = 1;
        while ($n < $this->size) {
            yield [$n, 'Item', ($n as float) * 1.25];
            $n = $n + 1;
        }
    }
}

class Bench
{
    public static function run(uint $size): uint
    {
        var $items = new Items($size);
        Reader $reader = Reader::open(Workbook::fromRows($items->rows(), { header: true })->bytes());
        uint $count = 0;
        foreach ($reader->rows(0, { header: true }) as Row $row) {
            $count = $count + 1;
        }
        return $count;
    }
}

echo Bench::run(1024), "\n";
