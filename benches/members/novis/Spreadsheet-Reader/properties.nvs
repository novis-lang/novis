<?nvs
// Reads the title, author and creation time of an uploaded workbook, as an import does to log the file.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $book = Workbook::createInMemory({ properties: { title: 'Prices', author: 'Shop', created: Core\Time::fromEpoch(1704067200) } });
        $book->sheet('Prices')->add(['Item', 'Price']);
        Reader $reader = Reader::open($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $step = $reader->properties()->created != null ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
