<?nvs
// Lists the defined names of a form workbook, as an import does to find its input cells.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $book = Workbook::createInMemory();
        $book->sheet('Form')->addAll([['Customer', 'Shop'], ['Date', '2024-05-01']]);
        $book->define('CustomerName', 'Form!$B$1')->define('OrderDate', 'Form!$B$2');
        Reader $reader = Reader::open($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count($reader->names());
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
