<?nvs
// Reads the 100 rows of an uploaded xlsx file, as a shop does when somebody imports a price list.
// bench: iterations 32
// bench: complexity linear
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Row;
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<array<mixed>> $prices = [['Item', 'Name', 'Price', 'Day']];
        uint $n = 1;
        while ($n <= 100) {
            $prices[] = [$n, 'Item ' . ($n as string), ($n as float) * 1.25, Core\Time\Date::at(2024, 1, 1 + $n % 28)];
            $n = $n + 1;
        }
        Reader $reader = Reader::open(Workbook::fromRows($prices, { header: true })->bytes());
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $count = 0;
            foreach ($reader->rows(0, { header: true }) as Row $row) {
                $count = $count + 1;
            }
            uint $step = $count > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
