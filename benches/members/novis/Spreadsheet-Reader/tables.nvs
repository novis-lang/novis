<?nvs
// Lists the Excel tables of a sheet, as an import does to find the table it reads.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Reader;
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $book = Workbook::createInMemory();
        $book->sheet('Shop')->table('A1:B3', { name: 'Prices' })->addAll([['Item', 'Price'], ['Widget', 2.5], ['Gadget', 4.0]]);
        Reader $reader = Reader::open($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count($reader->tables('Shop'));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
