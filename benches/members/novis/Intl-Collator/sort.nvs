<?nvs
// Sorts a short list of names for German, as a page does before it shows a list of customers.
// bench: iterations 1000
// bench: complexity constant
use Novis\Intl\Collator;

class Bench {
    public static function run(uint $rounds): uint {
        array<array<string>> $lists = [
            ["Zimmermann", "Ärzte", "Bauer", "Öztürk", "Adler"],
            ["Müller", "Schmidt", "Weber", "Wagner", "Becker"],
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<string> $sorted = Collator::sort($lists[$total % 2], "de");
            $total = $total + Core\Str::length($sorted[0]) % 3;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000), "\n";
