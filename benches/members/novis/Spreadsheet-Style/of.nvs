<?nvs
// Makes a style with a font, a border and a number format, as a report does for its totals row.
// bench: iterations 256
// bench: complexity constant
use Novis\Spreadsheet\Style;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $lines = ['thin', 'medium', 'thick', 'double'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $style = Style::of({ bold: true, border: $lines[($total % 4) as int], format: 'money', align: 'right' });
            uint $step = $style->fields->bold == true ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
