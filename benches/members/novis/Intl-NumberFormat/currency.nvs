<?nvs
// Formats a short list of prices in euros for German, as a shop page does before it shows a cart.
// bench: iterations 1000
// bench: complexity constant
use Novis\Intl\NumberFormat;

class Bench {
    public static function run(uint $rounds): uint {
        array<array<int|float|decimal>> $lists = [
            [1234.5, 19.9, 42, 0.5, 1000],
            [70, 2500, 3.25, 99.99, 12],
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<string> $written = NumberFormat::currency($lists[$total % 2], "EUR", "de");
            $total = $total + Core\Str::length($written[0]) % 3;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000), "\n";
