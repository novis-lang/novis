<?nvs
// Formats a short list of shares as percentages for English, as a report page does.
// bench: iterations 1000
// bench: complexity constant
use Novis\Intl\NumberFormat;

class Bench {
    public static function run(uint $rounds): uint {
        array<array<int|float|decimal>> $lists = [
            [1, 0.25, 0.5, 0.125, 0.07],
            [2, 0.9, 0.333, 0.01, 0.6],
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<string> $written = NumberFormat::percent($lists[$total % 2], "en");
            $total = $total + Core\Str::length($written[0]) % 3;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000), "\n";
