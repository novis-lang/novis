<?nvs
// Decodes a small PNG and resizes it, as a server does when it makes a thumbnail.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Codec;
use Novis\Image\Color;
use Novis\Image\Image;
use Novis\Image\Output;

class Bench {
    public static function run(uint $rounds): uint {
        bytes $png = Image::create(16, 16, Color::hex("#336699"))->encode();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $width = 1 + $total % 8;
            bytes $size = Codec::run(
                {data: $png, autoOrient: true, toSrgb: true},
                {steps: [{resize: {width: $width}}], overlays: [], output: Output::Size}
            );
            array<mixed> $numbers = Core\Bytes::unpack($size, "JJ");
            $total = $total + ($numbers[0] as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
