<?nvs
// Joins two short lists of names in German, as a page does before it shows what a cart contains.
// bench: iterations 1000
// bench: complexity constant
use Novis\Intl\ListFormat;

class Bench {
    public static function run(uint $rounds): uint {
        array<array<array<string>>> $batches = [
            [["Shop", "Blog", "Wiki"], ["Shop", "Blog"]],
            [["Blog", "Wiki"], ["Wiki", "Shop", "Blog", "Forum"]],
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<string> $joined = ListFormat::join($batches[$total % 2], "de");
            $total = $total + Core\Str::length($joined[0]) % 7 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000), "\n";
