<?nvs
// Writes a shop's opening and closing time in American English, as a contact page does.
// bench: iterations 1000
// bench: complexity constant
use Novis\Intl\DateFormat;

class Bench {
    public static function run(uint $rounds): uint {
        array<array<Core\Time\TimeOfDay>> $batches = [
            [Core\Time\TimeOfDay::at(9, 0), Core\Time\TimeOfDay::at(18, 30)],
            [Core\Time\TimeOfDay::at(10, 0), Core\Time\TimeOfDay::at(14, 0)],
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<string> $lines = DateFormat::times($batches[$total % 2], "en-US");
            $total = $total + Core\Str::length($lines[0]) % 7 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000), "\n";
