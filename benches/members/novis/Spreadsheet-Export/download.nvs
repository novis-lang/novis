<?nvs
// Sends a CSV download of one order made with `fromRows`, as a shop does when somebody downloads a receipt.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Workbook::fromRows([['order' => $total, 'total' => 19.9]])->download('receipt.csv');
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
