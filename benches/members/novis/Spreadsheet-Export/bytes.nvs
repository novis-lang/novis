<?nvs
// Makes an xlsx file of one order in memory with `fromRows`, as an API does before it attaches the file to an email.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            bytes $file = Workbook::fromRows([['order' => $total, 'total' => 19.9]])->bytes();
            uint $step = Core\Bytes::length($file) > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
