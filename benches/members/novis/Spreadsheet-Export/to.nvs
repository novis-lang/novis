<?nvs
// Writes a CSV export of one order to an open file, as a job does when it collects many exports in one file.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        string $path = Core\Path::join(Core\IO::temporaryDir(), 'orders.csv');
        Core\IO\File $file = Core\IO::open($path, Core\IO::FileMode::Write);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $rows = Workbook::fromRows([['order' => $total, 'total' => 19.9]], { format: 'csv' })->to($file)->rows['Sheet1'] as uint;
            $total = $total + $rows;
            $i = $i + 1;
        }
        $file->close();
        return $total;
    }
}

echo Bench::run(32), "\n";
