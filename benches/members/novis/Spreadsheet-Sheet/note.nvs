<?nvs
// Writes a small stock list with a note on each item to reorder, as a shop does for its stock report.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Stock');
            $sheet->addAll([['item' => 'Pen', 'qty' => 120], ['item' => 'Ink', 'qty' => 3], ['item' => 'Pad', 'qty' => 2]]);
            $sheet->note('B3', 'Order more of this item.', { author: 'Shop' })->note('B4', 'Order more of this item.');
            uint $size = Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
