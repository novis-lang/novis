<?nvs
// Writes a small price list that is locked with a password, as a shop does for the price list it sends out.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Prices');
            $sheet->addAll([['item' => 'Widget', 'price' => 2.5], ['item' => 'Gadget', 'price' => 4.0]]);
            $sheet->protect({ password: 'shop-prices', allow: ['sort', 'autoFilter'] });
            uint $size = Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
