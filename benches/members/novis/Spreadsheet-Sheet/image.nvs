<?nvs
// Writes a small report with a logo at the top, as a shop does for the reports it sends to customers.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        bytes $logo = Core\Encoding::fromBase64('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==');
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Report');
            $sheet->image('D1', $logo, { width: 120.0, height: 40.0 });
            $sheet->addAll([['shop' => 'North', 'sales' => 340], ['shop' => 'South', 'sales' => 210]]);
            uint $size = Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
