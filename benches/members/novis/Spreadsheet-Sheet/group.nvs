<?nvs
// Writes a small order list with the lines of each order in a group, as a shop does for its order report.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Orders');
            $sheet->group('3:4')->group('6:7', { collapsed: true });
            $sheet->addAll([
                ['what' => 'Order 1042', 'total' => 9.5],
                ['what' => 'Widget', 'total' => 5.0],
                ['what' => 'Gadget', 'total' => 4.5],
                ['what' => 'Order 1043', 'total' => 6.0],
                ['what' => 'Widget', 'total' => 5.0],
                ['what' => 'Pen', 'total' => 1.0],
            ]);
            uint $size = Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
