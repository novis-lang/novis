<?nvs
// Writes a small report with its title merged over three columns, as a shop does for its sales report.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Report');
            $sheet->add(['Sales by shop'])->merge('A1:C1');
            $sheet->addAll([['Shop', 'Orders', 'Sales'], ['North', 12, 340.5], ['South', 8, 210.0]]);
            uint $size = Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
