<?nvs
// Writes a small product list with a link to the page of each product, as a shop does for its catalogue.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Products');
            $sheet->addAll([['product' => 'Widget', 'page' => 'Open'], ['product' => 'Gadget', 'page' => 'Open']]);
            $sheet->link('B2', 'https://example.com/widget', { text: 'Widget page' })->link('B3', 'https://example.com/gadget');
            uint $size = Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
