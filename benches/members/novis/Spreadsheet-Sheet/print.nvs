<?nvs
// Writes a small report that prints one page wide with its header row on each page, as a shop does for a list.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Sales');
            $sheet->print({ orientation: 'landscape', fitToPage: { width: 1, height: 0 }, repeatRows: '1:1', footer: 'Shop sales report' });
            $sheet->addAll([['shop' => 'North', 'sales' => 340], ['shop' => 'South', 'sales' => 210]]);
            uint $size = Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
