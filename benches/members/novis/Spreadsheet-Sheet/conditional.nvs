<?nvs
// Writes a small stock list that marks low stock in red, as a shop does for its stock report.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Style;
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        Style $red = Style::of({ fill: '#FFC7CE', color: '#9C0006' });
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Stock');
            $sheet->addAll([['item' => 'Pen', 'qty' => 120], ['item' => 'Ink', 'qty' => 3], ['item' => 'Pad', 'qty' => 60]]);
            $sheet->conditional('B2:B4', { kind: 'cell', operator: 'less', values: ['10'], style: $red });
            $sheet->conditional('B2:B4', { kind: 'colorScale', colors: ['#F8696B', '#63BE7B'] });
            uint $size = Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
