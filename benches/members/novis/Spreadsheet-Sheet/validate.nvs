<?nvs
// Writes a small order form with a list of statuses and a quantity check, as a shop does for a form to fill in.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Orders');
            $sheet->addAll([['order' => 1042, 'status' => 'open', 'qty' => 1], ['order' => 1043, 'status' => 'paid', 'qty' => 2]]);
            $sheet->validate('B2:B100', { list: ['open', 'paid', 'sent'] });
            $sheet->validate('C2:C100', { whole: { min: 1, max: 99 }, error: 'The quantity is a whole number from 1 to 99.' });
            uint $size = Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
