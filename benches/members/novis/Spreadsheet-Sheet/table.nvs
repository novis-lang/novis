<?nvs
// Writes a small sales table with a totals row, as a shop does for its sales report.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createInMemory();
            var $sheet = $book->sheet('Sales');
            $sheet->addAll([['shop' => 'North', 'sales' => 120], ['shop' => 'South', 'sales' => 80], ['shop' => 'East', 'sales' => 95]]);
            $sheet->table('A1:B4', { name: 'Sales', totals: ['sales' => 'sum'] });
            uint $size = Core\Bytes::length($book->finish()->bytes ?? Core\Bytes::fill(0, 0));
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
