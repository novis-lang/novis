<?nvs
// Checks which date rules two locale tags use, as a settings page does before it saves them.
// bench: iterations 1000
// bench: complexity constant
use Novis\Intl\Locale;
use Novis\Intl\Service;

class Bench {
    public static function run(uint $rounds): uint {
        array<array<string>> $batches = [["de-AT", "fr-CA"], ["en-GB", "zz"]];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<string> $used = Locale::resolve($batches[$total % 2], Service::Dates);
            $total = $total + Core\Str::length($used[0]) % 7 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000), "\n";
