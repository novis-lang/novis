<?nvs
// Makes a small QR code for a link, as a shop does for each order page.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\QrCode;

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $links = ["https://example.com/a", "https://example.com/bb", "https://example.com/ccc"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            bytes $code = QrCode::render($links[$total % 3], { size: 64, margin: 2 });
            $total = $total + Core\Bytes::length($code);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
