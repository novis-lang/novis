<?nvs
// Makes a Code 128 barcode as SVG, as a shop does for each order page it shows in HTML.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Barcode;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $labels = ['SHIP-00022', 'SHIP-55', 'SHIP-88888'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $code = Barcode::svg($labels[($total % 3) as int], Barcode::Symbology::Code128, { text: true });
            $total = $total + Core\Str::length($code);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
