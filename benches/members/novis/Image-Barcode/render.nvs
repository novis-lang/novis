<?nvs
// Makes a Code 128 barcode as a PNG, as a shop does for each shipping label it prints.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Barcode;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $labels = ['SHIP-4', 'SHIP-55', 'SHIP-7777'];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            bytes $code = Barcode::render($labels[($total % 3) as int], Barcode::Symbology::Code128, { height: 40 });
            $total = $total + Core\Bytes::length($code);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
