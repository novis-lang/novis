<?nvs
// Attaches the Factur-X XML to an invoice, as a shop does for each electronic invoice before it renders it.
// bench: iterations 4096
// bench: complexity constant
use Novis\Pdf\Document;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $invoice = Document::fromHtml("<html lang=\"en\"><head><title>Invoice</title></head><body><h1>Invoice</h1></body></html>")
            ->standard(Document::Standard::PdfA3b);
        string $start = "<rsm:CrossIndustryInvoice xmlns:rsm=\"urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100\">";
        array<string> $xml = [
            $start . '<rsm:ExchangedDocument/></rsm:CrossIndustryInvoice>',
            $start . '<rsm:ExchangedDocumentContext/></rsm:CrossIndustryInvoice>',
            $start . '</rsm:CrossIndustryInvoice>',
        ];
        array<Document> $documents = [];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $documents[] = $invoice->invoiceXml($xml[($total % 3) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total + Core\Arr::count($documents);
    }
}

echo Bench::run(4096), "\n";
