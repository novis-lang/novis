<?nvs
// Starts a document from a string of HTML, as a shop does for each invoice before it renders it.
// bench: iterations 4096
// bench: complexity constant
use Novis\Pdf\Document;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<string> $pages = ['<h1>Invoice 1</h1>', '<h1>Invoice 2</h1><p>Tea 2.50 EUR</p>', '<p>Receipt</p>'];
        array<Document> $documents = [];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            string $html = $pages[($total % 3) as int];
            $documents[] = Document::fromHtml($html);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total + Core\Arr::count($documents);
    }
}

echo Bench::run(4096), "\n";
