<?nvs
// Sets the password of a statement, as a bank does for each customer before it renders the statement.
// bench: iterations 4096
// bench: complexity constant
use Novis\Pdf\Document;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $statement = Document::fromHtml('<h1>Statement</h1><p>Balance: 10.00 EUR</p>');
        array<string> $passwords = ['ada-7731', 'grace-1906', 'a much longer password of a careful customer'];
        array<Document> $documents = [];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $documents[] = $statement->password($passwords[($total % 3) as int]);
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total + Core\Arr::count($documents);
    }
}

echo Bench::run(4096), "\n";
