<?nvs
// Writes a CSV export of one order to a file that stays open, as a job does that adds each export to one log.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        Core\IO\File $file = Core\IO::open(Core\Path::join(Core\IO::temporaryDir(), 'orders.log'), Core\IO::FileMode::Write);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createForStream($file, { format: 'csv' });
            $book->sheet('Order')->add(['order' => $total, 'total' => 19.9]);
            uint $size = $book->finish()->size as uint;
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        $file->close();
        return $total;
    }
}

echo Bench::run(32), "\n";
