<?nvs
// Adds a sheet of one row to a workbook, as a report does with one sheet for each month.
// bench: iterations 128
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $book = Workbook::createInMemory();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $book->sheet('Month ' . ($total as string))->add(['sales' => $i]);
            $total = $total + 1;
            $i = $i + 1;
        }
        $book->finish();
        return $total;
    }
}

echo Bench::run(128), "\n";
