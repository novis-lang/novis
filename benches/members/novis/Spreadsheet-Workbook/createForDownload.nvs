<?nvs
// Sends a CSV download of one order, as a shop does when somebody downloads a receipt.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $book = Workbook::createForDownload('receipt.csv');
            $book->sheet('Receipt')->add(['order' => $total, 'total' => 19.9]);
            uint $size = $book->finish()->size as uint;
            uint $step = $size > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
