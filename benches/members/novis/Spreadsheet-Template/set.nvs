<?nvs
// Writes one value into a template cell by its address, as a report does for its title and date.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Template;
use Novis\Spreadsheet\Workbook;

class Bench
{
    public static function run(uint $rounds): uint
    {
        var $design = Workbook::createInMemory();
        $design->sheet('Report')->addAll([['Report', null], ['Sales', '{{sales}}']]);
        bytes $source = $design->finish()->bytes ?? Core\Bytes::fill(0, 0);
        var $template = Template::open($source);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $template->set('Report!B1', 'May 2024');
            $total = $total + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
