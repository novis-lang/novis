<?nvs
// Starts a scatter chart with two axis titles, as a report of price and units sold does.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Chart;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $chart = Chart::scatter({ xTitle: 'Price', yTitle: 'Units sold', legend: 'hidden' });
            $total = $total + Core\Str::length($chart->xTitle ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
