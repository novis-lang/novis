<?nvs
// Starts an area chart with a title, as a report of the orders of each quarter does.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Chart;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $chart = Chart::area({ title: 'Orders per quarter', legend: 'top' });
            $total = $total + Core\Str::length($chart->title ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
