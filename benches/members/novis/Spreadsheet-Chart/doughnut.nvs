<?nvs
// Starts a doughnut chart with the legend on the left, as a report of open and closed tickets does.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Chart;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $chart = Chart::doughnut({ title: 'Tickets', legend: 'left' });
            $total = $total + Core\Str::length($chart->title ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
