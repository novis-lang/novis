<?nvs
// Starts a line chart with axis titles, as a report of the visitors of each day does.
// bench: iterations 32
// bench: complexity constant
use Novis\Spreadsheet\Chart;

class Bench
{
    public static function run(uint $rounds): uint
    {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $chart = Chart::line({ title: 'Visitors', xTitle: 'Day', yTitle: 'Visitors per day' });
            $total = $total + Core\Str::length($chart->title ?? '');
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
