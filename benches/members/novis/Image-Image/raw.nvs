<?nvs
// Reads the pixels of a small image and the colour of one pixel, as a test does when it checks a step.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Image;
use Novis\Image\Color;

class Bench {
    public static function run(uint $rounds): uint {
        Image $photo = Image::create(4, 4, Color::hex("#336699"));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            int $start = ((($total + $i) % 16) * 4) as int;
            array<mixed> $pixel = Core\Bytes::unpack(Core\Bytes::slice($photo->raw()->pixels, $start, 4), "C4");
            $total = $total + ($pixel[0] as uint) % 7;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
