<?nvs
// Resizes a small image and reads its pixels, as a program does when it makes an icon.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Image;
use Novis\Image\Color;

class Bench {
    public static function run(uint $rounds): uint {
        Image $logo = Image::create(4, 4, Color::hex("#336699"));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + $logo->resize({width: 1 + ($total + $i) % 3})->raw()->width;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
