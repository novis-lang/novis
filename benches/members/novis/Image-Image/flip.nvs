<?nvs
use Novis\Image\Color;
// Mirrors a small image and reads its pixels, as a program does when it mirrors a photo from a front camera.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Image;

class Bench
{
    public static function run(uint $rounds): uint
    {
        Image $photo = Image::create(4, 2, Color::hex('#336699'));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Image::Axis $axis = ($total + $i) % 2 == 0 ? Image::Axis::Horizontal : Image::Axis::Vertical;
            $total = $total + $photo->flip($axis)->raw()->width;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
