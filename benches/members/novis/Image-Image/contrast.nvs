<?nvs
// Adds contrast to a small image and reads its pixels, as a program does when it fixes a pale photo.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Image;
use Novis\Image\Color;

class Bench {
    public static function run(uint $rounds): uint {
        Image $photo = Image::create(4, 4, Color::rgba(100, 200, 128));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            float $amount = 1.0 + ((($total + $i) % 4) as float) / 10.0;
            bytes $pixels = $photo->contrast($amount)->raw()->pixels;
            $total = $total + Core\Bytes::length($pixels);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
