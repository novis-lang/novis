<?nvs
// Blurs a small image and reads its pixels, as a program does when it makes a preview.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Image;
use Novis\Image\Color;

class Bench {
    public static function run(uint $rounds): uint {
        Image $photo = Image::create(4, 4, Color::hex("#336699"));
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            float $sigma = 0.5 + ((($total + $i) % 3) as float) / 2.0;
            bytes $pixels = $photo->blur($sigma)->raw()->pixels;
            $total = $total + Core\Bytes::length($pixels);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
