<?nvs
use Novis\Image\Color;
use Novis\Image\Format;
// Runs a short pipeline on a small PNG and writes the file, as a program does for each image it serves.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Image;

class Bench
{
    public static function run(uint $rounds): uint
    {
        tainted bytes $png = Image::create(4, 4, Color::hex('#336699'))->withFormat(Format::Png)->encode();
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Image::Axis $axis = ($total + $i) % 2 == 0 ? Image::Axis::Horizontal : Image::Axis::Vertical;
            $total = $total + Core\Bytes::length(Image::open($png)->flipped($axis)->encode()) % 5;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
