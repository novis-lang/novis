<?nvs
use Novis\Image\Color;
use Novis\Image\Format;
// Keeps the EXIF data of a small JPEG photo in a new file, as a photo archive does with every upload.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Image;

class Bench
{
    public static function run(uint $rounds): uint
    {
        tainted bytes $jpeg = Image::create(4, 4, Color::hex('#336699'))->withFormat(Format::Jpeg)->encode();
        bytes $exif = Core\Encoding::fromHex('ffe1002245786966000049492a0008000000010012010300010000000600000000000000');
        array<tainted bytes> $parts = [Core\Bytes::slice($jpeg, 0, 2), $exif, Core\Bytes::slice($jpeg, 2)];
        Image $photo = Image::open(Core\Bytes::join($parts), { autoOrient: false });
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            bool $keep = ($total + $i) % 2 == 0;
            Image $step = $keep ? $photo->keepingMetadata() : $photo;
            $total = $total + Image::info($step->encode())->orientation;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
