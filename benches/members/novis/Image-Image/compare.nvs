<?nvs
// Compares two small encoded images, as a test does when it checks a rendered thumbnail.
// bench: iterations 256
// bench: complexity constant
use Novis\Image\Image;
use Novis\Image\Color;

class Bench {
    public static function run(uint $rounds): uint {
        array<bytes> $images = [
            Image::create(16, 16, Color::hex("#336699"))->encode(),
            Image::create(16, 16, Color::hex("#336a99"))->encode(),
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $diff = Image::compare($images[$total % 2], $images[($total + 1) % 2]);
            $total = $total + $diff->maxDelta + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(256), "\n";
