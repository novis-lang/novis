<?nvs
// Splits two short comments into words, as a page does before it counts or highlights the words.
// bench: iterations 1000
// bench: complexity constant
use Novis\Intl\Segmenter;

class Bench {
    public static function run(uint $rounds): uint {
        array<array<string>> $batches = [
            ["Hello, Shop! It's 9.50 now.", "Great blog"],
            ["The Wiki has a new page.", "東京で買い物"],
        ];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            array<array<{text: string, wordLike: bool}>> $parts = Segmenter::words($batches[$total % 2], "en");
            $total = $total + Core\Arr::count($parts[0]) % 5 + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000), "\n";
