<?nvs
// Makes a colour from its channels, as a program does before it fills or tints an image.
// bench: iterations 200000
// bench: complexity constant
use Novis\Image\Color;

class Bench {
    public static function run(uint $rounds): uint {
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Color $c = Color::rgba($total % 256, $i % 256, 128, 0.5);
            $total = $total + $c->r + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(200000), "\n";
