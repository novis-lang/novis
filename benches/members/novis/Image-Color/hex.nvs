<?nvs
// Reads a colour written in hex, as a program does when the colour comes from a setting.
// bench: iterations 100000
// bench: complexity constant
use Novis\Image\Color;

class Bench {
    public static function run(uint $rounds): uint {
        array<string> $texts = ["#f80", "#2a6f97", "#ff880080", "336699"];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            Color $c = Color::hex($texts[$total % 4]);
            $total = $total + $c->g + 1;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(100000), "\n";
