<?nvs
// Reads the text of one page of a received PDF file, as a shop does to find the total on an invoice.
// bench: iterations 32
// bench: complexity linear
use Novis\Pdf\Document;
use Novis\Pdf\Reader;

class Bench
{
    public static function run(uint $rounds): uint
    {
        Reader $reader = Reader::open(Document::fromHtml('<style>p { break-after: page }</style>'
            . '<p>Invoice 1042</p><p>Items: 3 bikes</p><p>Total: 1,250.00 EUR</p>')->render()->bytes);
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            uint $length = Core\Str::length($reader->text(($total % 3) + 1));
            uint $step = $length > 0 ? 1 : 3;
            $total = $total + $step;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(32), "\n";
