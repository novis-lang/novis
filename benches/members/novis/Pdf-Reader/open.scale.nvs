<?nvs
// Opens a PDF file with a growing number of pages, as a shop does for a long catalogue that a supplier sends.
// bench: start 8
// bench: max 512
use Novis\Pdf\Document;
use Novis\Pdf\Reader;

class Bench
{
    public static function run(uint $size): uint
    {
        string $html = Core\Str::repeat("<p style=\"break-after: page\">Shop, 1 Example Street</p>", $size);
        bytes $catalogue = Document::fromHtml($html)->render()->bytes;
        uint $total = 0;
        uint $i = 0;
        while ($i < 16) {
            $total = $total + Reader::open($catalogue)->pageCount;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(8), "\n";
