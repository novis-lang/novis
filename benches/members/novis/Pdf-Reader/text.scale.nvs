<?nvs
// Reads the text of a page with a growing number of lines, as a shop does for a long order list.
// bench: start 8
// bench: max 512
use Novis\Pdf\Document;
use Novis\Pdf\Reader;

class Bench
{
    public static function run(uint $size): uint
    {
        string $html = Core\Str::repeat("<div style=\"font-size: 1pt\">1 bike, 1 helmet</div>", $size);
        Reader $reader = Reader::open(Document::fromHtml($html)->render()->bytes);
        uint $total = 0;
        uint $i = 0;
        while ($i < 16) {
            $total = $total + Core\Str::length($reader->text(1));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(8), "\n";
