<?nvs
// Reads the amounts on a page and every page before it, as an invoice footer does for a running total.
// bench: iterations 2048
// bench: complexity linear
use Novis\Pdf\Page;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<array<{ name: string, value: string }>> $marks = [
            [{ name: 'amount', value: '1.50' }, { name: 'tax', value: '0.28' }],
            [{ name: 'amount', value: '2.00' }, { name: 'amount', value: '0.50' }, { name: 'amount', value: '7.25' }],
            [{ name: 'amount', value: '3.20' }, { name: 'amount', value: '0.15' }, { name: 'amount', value: '9.99' }],
        ];
        array<Page> $pages = [new Page(1, 3, null, [], $marks), new Page(2, 3, null, [], $marks), new Page(3, 3, null, [], $marks)];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            $total = $total + Core\Arr::count($pages[($total % 3) as int]->marksUpTo('amount'));
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(2048), "\n";
