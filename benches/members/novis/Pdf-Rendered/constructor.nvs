<?nvs
// Makes a render result by hand, as a test does for code that saves or sends a PDF file.
// bench: iterations 4096
// bench: complexity constant
use Novis\Pdf\Rendered;

class Bench
{
    public static function run(uint $rounds): uint
    {
        array<bytes> $files = ['%PDF-1.7A' as bytes, '%PDF-1.7 ABC' as bytes, '%PDF-1.7 ABCDEF' as bytes];
        uint $total = 0;
        uint $i = 0;
        while ($i < $rounds) {
            var $result = new Rendered($files[($total % 3) as int], 1, [], [], []);
            $total = $total + Core\Bytes::length($result->bytes) + $result->pageCount;
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(4096), "\n";
