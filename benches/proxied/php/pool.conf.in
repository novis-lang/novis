; The FPM pool for the proxied benchmark. `benches/proxied/README.md` § *Tuning is a variable we
; own* is why every value below is in git rather than left to the image's defaults.
;
; THIS IS A TEMPLATE. `bun nv bench-proxied` substitutes `@PHP_CHILDREN@` and writes the result to
; `benches/proxied/generated/pool.conf`, which is what the compose file mounts. It is rendered rather
; than parameterised because **php-fpm does not interpolate environment variables in a pool file** --
; a `pm.max_children = $PHP_CHILDREN` makes the whole configuration fail to load, with an error that
; says only "Unable to include" and names no key. That was established by running it; do not spend
; the afternoon again.
;
; The rendered file is not in git, and does not need to be: this template is, its digest is in every
; record, and the one value substituted into it is recorded beside that as `php_children`. Those
; three together reconstruct the pool any given row was measured against.
;
; Loaded as `zz-bench.conf`, after the image's own `zz-docker.conf`, because php-fpm takes the last
; assignment of a key and the image sets `listen` and `daemonize` in that file. Overriding them here
; would be a second home for two values the image already owns correctly.

[www]

; `static` and not `dynamic`. A dynamic pool spawns workers during the run, so the first seconds of
; a measurement include forks and the last seconds do not, and the reported rate is a blend of two
; different servers. Static pays the whole cost before the clock starts, which is the same courtesy
; the Novis side gets for free by compiling its unit before it binds the socket.
pm = static

; **Sized by concurrency, not by cores**, which is both how a real FPM pool is sized and the only
; way this benchmark runs at all. A FastCGI worker holding a keep-alive connection is *bound* to it
; and will not accept another, so a pool smaller than the number of open connections does not run
; slowly -- it stops: the surplus connections are accepted by the kernel and answered by nobody,
; and the client sees a socket timeout while this container's log shows healthy 200s going past.
; One worker per core deadlocks at any concurrency above 1 for exactly that reason.
;
; So fairness between the two peers is the **CPU budget** the container is given, which is equal on
; both sides and is what `cpus:` in the compose files enforces. The worker count is left free to be
; whatever PHP needs to use that budget: `bun nv bench-proxied` renders `max(2 x concurrency, 96)`
; and records the number. 96 is a floor rather than a guess -- it clears the 64 idle upstream
; connections `worker_processes 4` x `keepalive 16` can hold in `nginx/php.conf`, with headroom.
;
; Idle workers cost memory and no CPU, so a generous pool is the setting that favours PHP.
pm.max_children = @PHP_CHILDREN@

; Never recycle a worker mid-run. The default (`0`, unlimited) is already this; it is written out
; because a recycled worker re-warms an empty opcache and the resulting stall would land inside a
; timed pass as an unexplained tail.
pm.max_requests = 0

; The status and ping endpoints are deliberately absent: both are additional routes nginx would have
; to be able to reach, and a benchmark's proxy should have exactly one thing it can do.

; Logging a slow request is a write inside the request path. There is no slowlog and no
; `request_slowlog_timeout` for the same reason `access_log` is off in both nginx configs.
catch_workers_output = yes
decorate_workers_output = no

; `clear_env = no` so the container's environment reaches the workers. Nothing in the `hello` case
; reads one; it is here so that a case added later behaves the way a normal FPM deployment does
; rather than the way this benchmark happened to be configured.
clear_env = no
