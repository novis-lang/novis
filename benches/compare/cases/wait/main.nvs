<?nvs
// Waits 50 ms on a timer, then answers. This measures the cost of many
// requests in flight at once, as when a page waits for another service.

if (Core\Request::path() != '/wait') {
    Core\Response::setStatus(404);
    Core\Response::text("not found\n");
} else {
    // `Core\Time::sleep` pauses this request. Other requests run while it waits.
    Core\Time::sleep(Core\Time\Duration::milliseconds(50));
    Core\Response::text("waited 50 ms\n");
}
