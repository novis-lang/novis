<?nvs
// Reads a JSON order, checks it, and returns its totals in cents as JSON.
// This measures reading, checking and writing JSON in a typical API request.

#[Core\Json\Derive]
class Customer
{
    public int $id;
    public tainted string $name;
    public tainted string $email;

    public function constructor(int $id, tainted string $name, tainted string $email)
    {
        $this->id = $id;
        $this->name = $name;
        $this->email = $email;
    }
}

#[Core\Json\Derive]
class Item
{
    public tainted string $sku;
    public tainted string $name;
    public int $qty;
    public int $unitCents;

    public function constructor(tainted string $sku, tainted string $name, int $qty, int $unitCents)
    {
        $this->sku = $sku;
        $this->name = $name;
        $this->qty = $qty;
        $this->unitCents = $unitCents;
    }
}

#[Core\Json\Derive]
class Order
{
    public Customer $customer;
    public array<Item> $items;

    public function constructor(Customer $customer, array<Item> $items)
    {
        $this->customer = $customer;
        $this->items = $items;
    }
}

#[Core\Json\Derive]
class Line
{
    public tainted string $sku;
    public int $qty;
    public int $totalCents;

    public function constructor(tainted string $sku, int $qty, int $totalCents)
    {
        $this->sku = $sku;
        $this->qty = $qty;
        $this->totalCents = $totalCents;
    }
}

#[Core\Json\Derive]
class Receipt
{
    public int $customer;
    public array<Line> $items;
    public int $subtotalCents;
    public int $taxCents;
    public int $totalCents;

    public function constructor(int $customer, array<Line> $items, int $subtotalCents, int $taxCents, int $totalCents)
    {
        $this->customer = $customer;
        $this->items = $items;
        $this->subtotalCents = $subtotalCents;
        $this->taxCents = $taxCents;
        $this->totalCents = $totalCents;
    }
}

class Orders
{
    // Returns the receipt for one order, or null when the order fails a check.
    public static function total(Order $order): ?Receipt
    {
        uint $count = Core\Arr::count($order->items);
        if ($order->customer->id < 1 || $count < 1 || $count > 100) {
            return null;
        }
        array<Line> $lines = [];
        int $subtotal = 0;
        foreach ($order->items as Item $item) {
            if ($item->sku == '' || $item->qty < 1 || $item->qty > 1000 || $item->unitCents < 1 || $item->unitCents > 10000000) {
                return null;
            }
            int $total = $item->qty * $item->unitCents;
            $lines[] = new Line($item->sku, $item->qty, $total);
            $subtotal = $subtotal + $total;
        }

        // The tax is 20 percent, rounded to the nearest cent. Half a cent rounds up.
        int $tax = Core\Math::intDiv($subtotal * 20 + 50, 100);

        // The largest line comes first. Lines with the same total keep the order of the request.
        var $sorted = Core\Arr::sort($lines, { by: fn(Line $line): int => -$line->totalCents });

        return new Receipt($order->customer->id, $sorted, $subtotal, $tax, $subtotal + $tax);
    }
}

if (Core\Request::method() != Core\Http\Method::Post || Core\Request::path() != '/orders') {
    Core\Response::setStatus(404);
    Core\Response::text("not found\n");
} else {
    // `jsonAs` throws a `ParseError` when the body is not JSON or a field has the wrong type.
    ?Receipt $receipt = null;
    try {
        $receipt = Orders::total(Core\Request::jsonAs<Order>());
    } catch (ParseError $error) {
        $receipt = null;
    }
    if ($receipt == null) {
        Core\Response::setStatus(422);
        Core\Response::json({ error: 'invalid order' });
    } else {
        Core\Response::json($receipt);
    }
}
