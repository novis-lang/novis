<?nvs
// Runs `?parts=` parts of the same loop and prints the sum of their results.
// With four parts, each part runs in a child script on another core.
final class Work
{
    public static function part(int $seed, int $turns): int
    {
        int $x = $seed;
        int $i = 0;
        while ($i < $turns) {
            $x = ($x * 31 + $i) % 1000003;
            $i = $i + 1;
        }
        return $x;
    }
}

int $parts = Core\Request::query('parts') as int;
int $turns = Core\Request::query('turns') as int;
if ($parts == 4) {
    // `spawn script` starts each part and returns at once. `await` waits for its result.
    var $a = spawn script Work::part(...) with(args: ['seed' => 1, 'turns' => $turns], on: 'worker');
    var $b = spawn script Work::part(...) with(args: ['seed' => 2, 'turns' => $turns], on: 'worker');
    var $c = spawn script Work::part(...) with(args: ['seed' => 3, 'turns' => $turns], on: 'worker');
    var $d = spawn script Work::part(...) with(args: ['seed' => 4, 'turns' => $turns], on: 'worker');
    var $ra = await $a;
    var $rb = await $b;
    var $rc = await $c;
    var $rd = await $d;
    echo ($ra->value as int) + ($rb->value as int) + ($rc->value as int) + ($rd->value as int);
} else {
    echo Work::part(1, $turns);
}
