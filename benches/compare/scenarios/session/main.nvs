<?nvs
// One visitor's session, read and written by two kinds of request.
// `/slow` adds 1 to a counter in the session, then works for 2 seconds.
// `/fast` only reads the counter. Every other path sets the counter to 0.

int $count = (Core\Session::get('count') ?? 0) as int;

if (Core\Request::path() == '/slow') {
    Core\Session::setShortLived('count', $count + 1);
    Core\Time::sleep(Core\Time\Duration::seconds(2));
    Core\Response::sendText("slow done\n");
} elseif (Core\Request::path() == '/fast') {
    Core\Response::sendText('count: ' . $count . "\n");
} else {
    Core\Session::setShortLived('count', 0);
    Core\Response::sendText("started\n");
}
