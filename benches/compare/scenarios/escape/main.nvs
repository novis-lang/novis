<?nvs
// Prints the search term `?q=` into a heading with an html template on `/`,
// and with a plain `echo` of strings on `/direct`.
tainted string $term = Core\Request::query('q') ?? '';
if (Core\Request::path() == '/direct') {
    echo '<h1>Results for ', $term, "</h1>\n";
} else {
    echo html`<h1>Results for {$term}</h1>
`;
}
