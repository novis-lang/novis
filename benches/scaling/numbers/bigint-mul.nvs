<?nvs
// Multiplies numbers of n/2 to n binary digits by themselves, as a program does when it works with very large keys.
// scaling: start 64000
// scaling: max 512000
// scaling: expect karatsuba

class Bench {
    public static function run(uint $size): uint {
        var $one = Core\BigInt::of(1);
        uint $signs = 0;
        uint $step = ($size / 32) as uint;
        uint $k = 16;
        // Sixteen sizes from n/2 up to 31n/32, so no single size decides the result.
        while ($k < 32) {
            var $wide = $one->shl($k * $step)->sub($one);
            $signs = $signs + ($wide->mul($wide)->sign() as uint);
            $k = $k + 1;
        }
        return $signs;
    }
}

echo Bench::run(64000), "\n";
