<?nvs
// Works out each of the next n days from one start date, as a calendar does when it lists the days of a long range.
// scaling: start 1000
// scaling: max 64000
// scaling: expect linear

class Bench {
    public static function run(uint $size): int {
        var $start = Core\Time\Date::at(2026, 1, 1);
        int $total = 0;
        int $i = 0;
        while ($i < $size as int) {
            $total = $total + $start->plus($i, Core\Unit::Day)->compareTo($start);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000), "\n";
