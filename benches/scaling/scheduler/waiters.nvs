<?nvs
// Sends 256 values per waiting task from one task to another while n other tasks wait on channels of their own, as a server does with many idle connections.
// scaling: start 16
// scaling: max 128
// scaling: expect linear

class Total {
    public static uint $sum = 0;
}

class Bench {
    public static function run(uint $size): uint {
        array<Core\Task\Channel<uint>> $idle = [];
        uint $i = 0;
        while ($i < $size) {
            $idle[] = new Core\Task\Channel<uint>(1);
            $i = $i + 1;
        }
        var $busy = new Core\Task\Channel<uint>(1);
        Core\Task::all({
            idle: fn(): uint => {
                var $counts = Core\Task::map($idle, fn (Core\Task\Channel<uint> $one): uint => {
                    uint $seen = 0;
                    foreach ($one as uint $value) {
                        $seen = $seen + $value;
                    }
                    return $seen;
                });
                return 0;
            },
            send: fn(): uint => {
                uint $n = 0;
                while ($n < $size * 256) {
                    $busy->send($n);
                    $n = $n + 1;
                }
                $busy->close();
                return 0;
            },
            read: fn(): uint => {
                foreach ($busy as uint $value) {
                    Total::$sum = Total::$sum + $value;
                }
                foreach ($idle as Core\Task\Channel<uint> $one) {
                    $one->close();
                }
                return 0;
            },
        });
        return Total::$sum;
    }
}

echo Bench::run(16), "\n";
