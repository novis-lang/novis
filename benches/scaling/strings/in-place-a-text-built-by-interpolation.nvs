<?nvs
// Builds one string from n short pieces with `$text = "{$text}..."`, as a program does when it writes a report line by line.
// scaling: start 4000
// scaling: max 64000
// scaling: expect linear

class Bench
{
    public static function run(uint $size): uint
    {
        string $text = '';
        uint $i = 0;
        while ($i < $size) {
            $text = "{$text}row {$i} ";
            $i = $i + 1;
        }
        return Core\Str::length($text);
    }
}

echo Bench::run(4000), "\n";
