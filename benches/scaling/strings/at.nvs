<?nvs
// Reads every character of a long string by its index, as a parser does when it walks its input.
// scaling: start 1000
// scaling: max 64000
// scaling: expect linear

class Bench {
    public static function run(uint $size): uint {
        string $text = Core\Str::repeat("a,", $size);
        uint $commas = 0;
        int $i = 0;
        int $end = Core\Str::length($text) as int;
        while ($i < $end) {
            if (Core\Str::at($text, $i) == ",") {
                $commas = $commas + 1;
            }
            $i = $i + 1;
        }
        return $commas;
    }
}

echo Bench::run(1000), "\n";
