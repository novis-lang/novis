<?nvs
// Keeps n values in the cache of this core and reads each one back, as a server does with many small values it remembers.
// scaling: start 1000
// scaling: max 64000
// scaling: expect linear

class Bench {
    public static function run(uint $size): uint {
        var $store = Core\Cache::local();
        uint $i = 0;
        while ($i < $size) {
            $store->put("price:" . $i, $i % 1000);
            $i = $i + 1;
        }
        uint $total = 0;
        $i = 0;
        while ($i < $size) {
            $total = $total + ($store->get("price:" . $i) as uint);
            $i = $i + 1;
        }
        return $total;
    }
}

echo Bench::run(1000), "\n";
