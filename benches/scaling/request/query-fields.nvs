<?nvs
// Reads every parameter of a long address once, as a search page that applies each filter does.
// scaling: kind serve
// scaling: size query
// scaling: start 64
// scaling: max 4096
// scaling: expect linear

int $read = 0;
while (Core\Request::query("p{$read}") != null) {
    $read = $read + 1;
}
tainted string $q =Core\Request::query("q") as string;
echo "parameters: ", $read, " q: ", $q, "\n";
