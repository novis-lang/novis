<?nvs
// Maps 100 rows of n numbers with a function that never reads a row, as a report does to give every row one weight.
// scaling: start 1000
// scaling: max 16000
// scaling: expect constant
// scaling: rounds 100

class Bench
{
    public static function run(uint $size, uint $rounds): uint
    {
        array<int> $row = Core\Arr::range(1, $size as int);
        array<array<int>> $rows = Core\Arr::fill(100, $row);
        uint $total = 0;
        uint $round = 0;
        while ($round < $rounds) {
            array<int> $weights = Core\Arr::map($rows, fn(array<int> $row): int => 1);
            $total = $total + (Core\Arr::sum($weights) as uint);
            $round = $round + 1;
        }
        return $total;
    }
}

echo Bench::run(1000, 100), "\n";
