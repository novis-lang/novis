<?nvs
// Builds a list of n numbers with `Core\Arr::prepend`, as code does when the newest entry comes first.
// scaling: start 1000
// scaling: max 32000
// scaling: expect linear

class Bench
{
    public static function run(uint $size): uint
    {
        array<uint> $list = [];
        uint $i = 0;
        while ($i < $size) {
            $list = Core\Arr::prepend($list, $i);
            $i = $i + 1;
        }
        return Core\Arr::first($list) ?? 0;
    }
}

echo Bench::run(1000), "\n";
