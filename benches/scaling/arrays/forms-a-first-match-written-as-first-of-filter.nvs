<?nvs
// Takes the first entry of a list that matches a test, as a page does when it shows the first order that is still open.
// scaling: start 1000
// scaling: max 16000
// scaling: expect constant

class Bench
{
    public static function run(uint $size): uint
    {
        array<int> $orders = Core\Arr::range(1, $size as int);
        int $open = Core\Arr::first(Core\Arr::filter($orders, fn(int $x): bool => $x < 10)) ?? 0;
        return $open as uint;
    }
}

echo Bench::run(1000), "\n";
