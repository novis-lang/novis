<?nvs
// The server case: what one request costs before any application work does.
//
// Deliberately the smallest program that still produces a body, because what
// `--serve-vs-fpm` measures is the *server* -- accept, parse, isolate, dispatch,
// write -- and every line of userland here is a line the userland suite in
// `benches/userland/` already measures better. Its `.php` twin must print the
// same bytes: `bench.py` refuses to time two servers that disagree.
echo "hello, world\n";
