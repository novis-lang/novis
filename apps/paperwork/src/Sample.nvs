    // The orders of each week of the quarter and of the same week last year.
    public static function weeks(): array<Compare>
    {
        array<int> $now = [2810, 2765, 2690, 2742, 2655, 2598, 2710, 2875, 3020, 3190, 3305, 3402, 3452];
        array<int> $last = [2620, 2580, 2490, 2540, 2470, 2410, 2500, 2650, 2760, 2900, 3010, 3080, 3018];
        array<Compare> $weeks = [];
        for (int $week = 0; $week < 13; $week++) {
            $weeks[] = { name: 'W' . ($week + 27), value: $now[$week], last: $last[$week] };
        }
        return $weeks;
    }

