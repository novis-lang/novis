<?nvs
namespace Paperwork;

use Core\Time\Date;

// The data that the three documents show. A real app reads it from its database.
final class Sample
{
    type Party = { name: string, street: string, postcode: string, city: string, country: string, countryCode: string, vatId: string, email: string };
    type Item = { sku: string, name: string, quantity: uint, unit: string, price: decimal };
    type Invoice = { number: string, customer: string, order: string, issued: Date, delivered: Date, days: int, seller: Party, buyer: Party, items: array<Item> };
    type Kpi = { label: string, value: string, change: string, note: string };
    type Point = { name: string, value: int };
    type Compare = { name: string, value: int, last: int };
    type Product = { line: string, name: string, units: int, revenue: int, margin: int };
    type Attendee = { name: string, ticket: string, id: string, zone: string, seat: string, days: string, price: decimal };
    type Event = { name: string, tagline: string, venue: string, address: string, dates: string, doors: string, site: string };
    type Order = { number: string, placed: Date, buyer: Party, attendees: array<Attendee> };

    // The company that sends the invoice and writes the report.
    public static function shop(): Party
    {
        return { name: 'Shop GmbH', street: '12 Example Street', postcode: '10115', city: 'Berlin', country: 'Germany', countryCode: 'DE', vatId: 'DE123456789', email: 'billing@example.com' };
    }

    // The bank account of the shop. This is the standard test IBAN, and its check digits are valid.
    public static function iban(): string
    {
        return 'DE89 3704 0044 0532 0130 00';
    }

