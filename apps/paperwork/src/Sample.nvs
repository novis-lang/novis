    // The conference that the tickets are for.
    public static function event(): Event
    {
        return {
            name: 'Framework Conf 2026',
            tagline: 'Two days of talks about software that lasts',
            venue: 'Example Hall',
            address: '1 Example Street, 10115 Berlin',
            dates: '12 and 13 November 2026',
            doors: 'Doors open at 08:30. The first talk starts at 09:30.',
            site: 'conf.example.com',
        };
    }

    // An order of four tickets. One company bought them for four people.
    public static function order(): Order
    {
        Party $buyer = { name: 'Blog GmbH', street: '7 Example Street', postcode: '20095', city: 'Hamburg', country: 'Germany', countryCode: 'DE', vatId: 'DE246813579', email: 'team@example.com' };
        return {
            number: 'FWC-2026-0417',
            placed: Date::at(2026, 10, 2),
            buyer: $buyer,
            attendees: [
                { name: 'Ada Lovelace', ticket: 'Conference pass', id: 'FWC26-7K3Q-0412', zone: 'Hall A', seat: 'Row 4, seat 12', days: '12 and 13 November', price: '489.00' as decimal },
