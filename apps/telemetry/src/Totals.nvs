<?nvs
namespace Telemetry;

use Core\Db\Connection;
use Core\Db\Transaction;

// The weekly totals. A report is added to them, and the report itself is not saved.
// Each row is for one week, version, operating system and processor.
// The table `reports` counts the reports. The table `counters` adds up each counter.
final class Totals {
    private Connection $db;

    public function constructor(Connection $db) {
        $this->db = $db;
    }

    // Creates the two tables if they do not exist yet.
    public function setUp(): void {
        $this->db->execute(
            "create table if not exists reports (week text not null, version text not null, os text not null, arch text not null, "
            . "reports integer not null, first_reports integer not null, "
            . "active_1 integer not null, active_2 integer not null, active_3 integer not null, active_4 integer not null, "
            . "active_5 integer not null, active_6 integer not null, active_7 integer not null, "
            . "primary key (week, version, os, arch))",
            [],
        );
        $this->db->execute(
            "create table if not exists counters (week text not null, version text not null, os text not null, arch text not null, "
            . "counter text not null, total integer not null, reports integer not null, "
            . "primary key (week, version, os, arch, counter))",
            [],
        );
    }

    // Adds one report to both tables. Both tables change, or neither does.
    public function add(Report $report): void {
        $this->db->transaction(fn (Transaction $tx): void => {
            // `active_1` to `active_7` count the reports by their `days_active`. This report adds 1 to one of them.
            array<mixed> $row = [$report->week, $report->version, $report->os, $report->arch, $report->first ? 1 : 0];
            foreach (Core\Arr::range(1, 7) as int $day) {
                $row[] = $report->daysActive == $day ? 1 : 0;
            }
            $tx->execute(
                "insert into reports values (?, ?, ?, ?, 1, ?, ?, ?, ?, ?, ?, ?, ?) "
                . "on conflict (week, version, os, arch) do update set reports = reports + 1, "
                . "first_reports = first_reports + excluded.first_reports, "
                . "active_1 = active_1 + excluded.active_1, active_2 = active_2 + excluded.active_2, "
                . "active_3 = active_3 + excluded.active_3, active_4 = active_4 + excluded.active_4, "
                . "active_5 = active_5 + excluded.active_5, active_6 = active_6 + excluded.active_6, "
                . "active_7 = active_7 + excluded.active_7",
                $row,
            );
            // A counter with the value 0 adds nothing, so it gets no row.
            foreach ($report->counters as string $counter => int $count) {
                if ($count > 0) {
                    $tx->execute(
                        "insert into counters values (?, ?, ?, ?, ?, ?, 1) "
                        . "on conflict (week, version, os, arch, counter) do update set total = total + excluded.total, reports = reports + 1",
                        [$report->week, $report->version, $report->os, $report->arch, $counter, $count],
                    );
                }
            }
        });
    }
}
