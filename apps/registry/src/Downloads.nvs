<?nvs
namespace Registry;

use Core\Charset;
use Core\Compress;
use Core\Db\Connection;
use Core\Db\Row;
use Core\Db\Transaction;
use Core\Encoding;
use Core\Hash;
use Core\IO;
use Core\Math;
use Core\Path;
use Core\Random;
use Core\Str;
use Core\Time;
use RuntimeError;

// Counts the downloads of each version per day. One address counts once per version per day.
// The address is never saved. A download the registry sends itself saves a hash of the address
// with the salt of the day, and the salt and the hashes are deleted after that day.
// The access lines of the file hosts are counted once a day, and their salt and hashes are
// only in memory while they are counted.
final class Downloads
{
    // The seconds in one day.
    public const int DAY = 86400;

    // The most bytes one part of the access lines may have when it is uncompressed: 512 MiB.
    // A bigger part stops the count of its day.
    public const uint PART_BYTES = 536870912;

    private const string HEX = '0123456789abcdef';

    // The characters of the name of a part of the access lines.
    private const string NAME = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-.';

    private Connection $db;

    public function constructor(Connection $db)
    {
        $this->db = $db;
    }

    // Returns the day of a time, as the number of days since 1970.
    public static function dayOf(int $seconds): int
    {
        return Math::intDiv($seconds, Downloads::DAY);
    }

    // Counts one download of a version. `$address` is the address of the computer that downloads.
    public function count(string $key, string $version, ?tainted string $address): void
    {
        int $day = Downloads::dayOf(Time::now()->toEpochSeconds());
        string $seen = Downloads::seen($this->saltOf($day), $address, $key, $version);
        $this->db->transaction(fn(Transaction $tx): void => {
            var $first = $tx->execute('insert into downloads_seen (day, hash) values (?, ?) on conflict (day, hash) do nothing', [$day, $seen]);
            if ($first->affected() == 1) {
                Downloads::add($tx, $key, $version, $day, 1);
            }
        });
    }

    // Returns the folder of the month of the day `$day` in Bunny's Permanent Log Storage, such as `2026/03/`.
    public static function folderOf(int $day): string
    {
        string $iso = Time::fromEpoch($day * Downloads::DAY)->toIso();
        return Str::slice($iso, 0, 4) . '/' . Str::slice($iso, 5, 2) . '/';
    }

    // Returns the names in `$names` of the files of the day `$day` in the folder `folderOf($day)`.
    // Bunny writes each day in parts, such as `04_100-0-a1b2c3d4.gzip` for 4 March: the day,
    // the log server, the number of the part and a random text.
    public static function partsOf(array<tainted string> $names, int $day): array<string>
    {
        string $prefix = Str::slice(Time::fromEpoch($day * Downloads::DAY)->toIso(), 8, 2) . '_';
        array<string> $parts = [];
        foreach ($names as tainted string $name) {
            if (Str::startsWith($name, $prefix) && Str::endsWith($name, '.gzip') && Str::trim($name, { characters: Downloads::NAME }) == '') {
                $parts[] = Core\Taint::assertTrusted($name, 'a name of a part has only letters, digits, `_`, `-` and `.`');
            }
        }
        return $parts;
    }

    // Counts the downloads in Bunny's access lines of the day `$day`. `$log` is the folder of one
    // pull zone in Bunny's Permanent Log Storage, and each part of the day is a gzip file in `folderOf`.
    // `$folder` is a folder that is never served, for the copy of one part while it is counted.
    // Only a request for `archive/<digest>.tar` that was answered with a status 200 to 299, by a
    // user agent that starts with `nvs/`, counts. A line that does not have this form is skipped.
    // A day is counted once: a second run for the same day counts nothing.
    // It returns the number of downloads it counted. It throws a `RuntimeError` when the store
    // fails or a part is not gzip, and then it counts nothing for that day.
    // Memory: one part at a time, compressed, uncompressed and as a list of lines, at most
    // `PART_BYTES` uncompressed. And one hash for each address and archive of the day.
    // All of it is deleted when the count ends.
    public function countLog(Store $log, int $day, string $folder): int
    {
        if ($this->db->query('select 1 from downloads_counted where day = ?', [$day])->count() > 0) {
            return 0;
        }
        // The salt is only in memory, so a hash of an address cannot be checked after the count.
        string $salt = Random::token(32);
        // One key for each archive and address: the digest, a line break, and the hash of the address.
        array<bool> $seen = [];
        string $copy = Path::join($folder, 'downloads-' . Random::token(8) . '.log');
        try {
            foreach (Downloads::partsOf($log->list(Downloads::folderOf($day)), $day) as string $name) {
                ?bytes $part = $log->bytes(Downloads::folderOf($day) . $name);
                if ($part == null) {
                    continue;
                }
                if (IO::isFile($copy)) {
                    IO::remove($copy);
                }
                IO::writeStream($copy, [Compress::decompress($part, Compress::Codec::Gzip, Downloads::PART_BYTES)]);
                // Latin-1 reads every byte, so a line that is not UTF-8 is skipped below and does
                // not stop the count.
                foreach (Str::lines(IO::readText($copy, { charset: Charset::Latin1 })) as string $line) {
                    ?array<string> $download = Downloads::parseBunny($line, $day);
                    if ($download != null) {
                        $seen[$download[0] . "\n" . Downloads::seen($salt, $download[1], $download[0], '')] = true;
                    }
                }
            }
        } finally {
            if (IO::isFile($copy)) {
                IO::remove($copy);
            }
        }
        return $this->save($seen, $day);
    }

    // Returns the number of downloads of a version on the day `$day`.
    public function on(string $key, string $version, int $day): int
    {
        foreach ($this->db->query('select count from downloads where package = ? and version = ? and day = ?', [$key, $version, $day]) as Row $row) {
            return $row->int('count') ?? 0;
        }
        return 0;
    }

    // Returns `true` when the salt of the day `$day` is still saved.
    public function hasSalt(int $day): bool
    {
        foreach ($this->db->query('select 1 as found from download_salts where day = ?', [$day]) as Row $row) {
            return true;
        }
        return false;
    }

    // Saves the downloads of the day `$day` and the day in one transaction. `$seen` has one key
    // for each archive and address. An archive of no release is not counted.
    private function save(array<bool> $seen, int $day): int
    {
        // The package and version of each digest, such as `acme\http` and `1.0.0` with a line break between.
        // An empty text is a digest of no release.
        array<string> $releases = [];
        array<int> $counts = [];
        int $total = 0;
        foreach (Core\Arr::keys($seen) as string $key) {
            string $digest = Str::before($key, "\n") ?? $key;
            if (!Core\Arr::hasKey($releases, $digest)) {
                $releases[$digest] = $this->releaseOf($digest);
            }
            string $release = $releases[$digest];
            if ($release == '') {
                continue;
            }
            $counts[$release] = ($counts[$release] ?? 0) + 1;
            $total++;
        }
        return $this->db->transaction(fn(Transaction $tx): int => {
            var $first = $tx->execute('insert into downloads_counted (day) values (?) on conflict (day) do nothing', [$day]);
            if ($first->affected() == 0) {
                return 0;
            }
            foreach ($counts as string $release => int $count) {
                array<string> $parts = Str::split($release, "\n");
                Downloads::add($tx, $parts[0], $parts[1], $day, $count);
            }
            return $total;
        });
    }

    // Reads one of Bunny's access lines. The fields are separated by `|`, in this order:
    // the cache status, the status, the time in milliseconds since 1970, the bytes sent,
    // the pull zone, the address, the referrer, the URL, the edge location, the user agent,
    // the request id and the country. The line has no method, so a `HEAD` request counts as a `GET`.
    // It returns the digest in hex and the address of a download by `nvs` on the day `$day`,
    // or `null` for any other line.
    private static function parseBunny(string $line, int $day): ?array<string>
    {
        array<string> $fields = Str::split($line, '|');
        if (Core\Arr::count($fields) < 10) {
            return null;
        }
        ?int $status = $fields[1] as ?int;
        ?int $milliseconds = $fields[2] as ?int;
        if ($status == null || $status < 200 || $status > 299 || $milliseconds == null) {
            return null;
        }
        if (Downloads::dayOf(Math::intDiv($milliseconds, 1000)) != $day || !Str::startsWith($fields[9], 'nvs/') || $fields[5] == '') {
            return null;
        }
        string $path = Str::before($fields[7], '?') ?? $fields[7];
        int $length = Str::length($path) as int;
        // `/archive/` and 64 hex characters and `.tar` are 77 characters.
        if ($length < 77 || !Str::endsWith($path, '.tar') || Str::slice($path, $length - 77, 9) != '/archive/') {
            return null;
        }
        string $digest = Str::slice($path, $length - 68, 64);
        if (Str::trim($digest, { characters: Downloads::HEX }) != '') {
            return null;
        }
        return [$digest, $fields[5]];
    }

    // Returns the package and the version of the archive `$digest`, with a line break between,
    // or an empty text when no release has it.
    private function releaseOf(string $digest): string
    {
        foreach ($this->db->query('select package, version from releases where digest = ?', ['blake3:' . $digest]) as Row $row) {
            return Downloads::trusted($row->string('package')) . "\n" . Downloads::trusted($row->string('version'));
        }
        return '';
    }

    // Returns the hash that counts one address once per version on the day of `$salt`.
    private static function seen(string $salt, ?tainted string $address, string $key, string $version): string
    {
        tainted string $hash = Encoding::toHex(Hash::of($salt . "\n" . ($address ?? '') . "\n" . $key . "\n" . $version, Hash::Digest::Sha256));
        return Core\Taint::assertTrusted($hash, 'a SHA-256 hash in hex is 64 hex characters');
    }

    // Adds `$count` downloads of a version on the day `$day`.
    private static function add(Transaction $tx, string $key, string $version, int $day, int $count): void
    {
        $tx->execute(
            'insert into downloads (package, version, day, count) values (?, ?, ?, ?) '
                . 'on conflict (package, version, day) do update set count = count + excluded.count',
            [$key, $version, $day, $count],
        );
    }

    // Returns the salt of the day. The salts and hashes of the days before are deleted first.
    private function saltOf(int $day): string
    {
        $this->db->execute('delete from download_salts where day < ?', [$day]);
        $this->db->execute('delete from downloads_seen where day < ?', [$day]);
        $this->db->execute('insert into download_salts (day, salt) values (?, ?) on conflict (day) do nothing', [$day, Random::token(32)]);
        foreach ($this->db->query('select salt from download_salts where day = ?', [$day]) as Row $row) {
            return Core\Taint::assertTrusted($row->string('salt') as tainted string, 'the registry wrote the salt');
        }
        throw new RuntimeError('the salt of the day was not saved');
    }

    private static function trusted(mixed $value): string
    {
        return Core\Taint::assertTrusted($value as tainted string, 'the registry wrote this text');
    }
}
