<?nvs
namespace Registry;

use Core\Db\Connection;
use Core\Db\Row;
use Core\Db\Transaction;
use Core\Json;
use Core\Str;
use Core\Time;
use RuntimeError;

// The state of each release after it is published: pending, released, unlisted, retracted or withheld.
// A release by token alone is pending for seven days, and an owner's passkey releases it at once.
// The first release at `0.1.0` or higher waits until an owner confirms its API with a passkey.
// A release whose dependency is pending waits for that dependency.
// Every change here is saved with its entry of the log (`Events`).
final class Releases
{
    // A dependency that waits on another one is followed this many steps, and no further.
    private const int DEPTH = 16;

    private Connection $db;

    public function constructor(Connection $db)
    {
        $this->db = $db;
    }

    // Returns the package in lower case, such as `acme\http`, when `$vendor` and `$name` are a
    // published package. Otherwise the result is `null`.
    public function packageOf(tainted string $vendor, tainted string $name): ?string
    {
        ?string $scope = Tokens::scopeOf($vendor . '\\' . $name);
        if ($scope == null || !Str::contains($scope, '\\')) {
            return null;
        }
        string $key = Str::lower($scope);
        foreach ($this->db->query('select 1 as found from packages where key = ?', [$key]) as Row $row) {
            return $key;
        }
        return null;
    }

    // Returns `true` when the package `$key` has the version `$version`.
    public function has(string $key, string $version): bool
    {
        foreach ($this->db->query('select 1 as found from releases where package = ? and version = ?', [$key, $version]) as Row $row) {
            return true;
        }
        return false;
    }

    // Returns the time a release can be selected by `nvs pkg add`, in seconds since 1970.
    // A time in the past means it is released. The result is `null` when the release waits for an
    // owner: it is the first release at `0.1.0` or higher, or a dependency waits for one.
    // A dependency that is not in this registry does not wait.
    public function selectableAt(Connection|Transaction $db, string $key, string $version, int $depth = 0): ?int
    {
        var $rows = $db->query('select major, minor, patch, pending_until, dependencies from releases where package = ? and version = ?', [$key, $version]);
        foreach ($rows as Row $row) {
            int $at = $row->int('pending_until') ?? 0;
            if ($this->waitsForStable($db, $key, $row->int('major') ?? 0, $row->int('minor') ?? 0, $row->int('patch') ?? 0)) {
                return null;
            }
            if ($depth >= Releases::DEPTH) {
                return $at;
            }
            foreach ((Json::decode(Releases::trusted($row->string('dependencies'))) as array<mixed>) as tainted string $name => mixed $minimum) {
                ?int $needed = $this->selectableAt($db, Str::lower(Releases::trusted($name)), Releases::trusted($minimum), $depth + 1);
                if ($needed == null) {
                    return null;
                }
                if ($needed > $at) {
                    $at = $needed;
                }
            }
            return $at;
        }
        return 0;
    }

    // Returns `true` when a version at `0.1.0` or higher has no stable confirmation at or below it.
    private function waitsForStable(Connection|Transaction $db, string $key, int $major, int $minor, int $patch): bool
    {
        if ($major == 0 && $minor == 0) {
            return false;
        }
        var $rows = $db->query(
            'select 1 as found from release_states s join releases r on r.package = s.package and r.version = s.version '
                . 'where s.package = ? and s.stable_at is not null '
                . 'and (r.major < ? or (r.major = ? and (r.minor < ? or (r.minor = ? and r.patch <= ?)))) limit 1',
            [$key, $major, $major, $minor, $minor, $patch],
        );
        foreach ($rows as Row $row) {
            return false;
        }
        return true;
    }

    // Returns `true` when this version waits for an owner to confirm its API.
    public function needsStable(string $key, string $version): bool
    {
        foreach ($this->db->query('select major, minor, patch from releases where package = ? and version = ?', [$key, $version]) as Row $row) {
            return $this->waitsForStable($this->db, $key, $row->int('major') ?? 0, $row->int('minor') ?? 0, $row->int('patch') ?? 0);
        }
        return false;
    }

    // Releases a pending version now. An owner calls this after a passkey sign-in.
    // With `$stable`, it also confirms the API of the first release at `0.1.0` or higher.
    // From then on only a new major version may break that API.
    // It returns `false` when there is nothing to confirm.
    public function confirm(string $key, string $version, bool $stable): bool
    {
        int $now = Time::now()->toEpochSeconds();
        bool $waitsForStable = $this->needsStable($key, $version);
        return $this->db->transaction(fn(Transaction $tx): bool => {
            bool $changed = false;
            if ($stable && $waitsForStable) {
                $this->ensureRow($tx, $key, $version);
                $tx->execute('update release_states set stable_at = ? where package = ? and version = ?', [$now, $key, $version]);
                Events::release($tx, 'stable-api-confirmed', $key, $version);
                $changed = true;
            }
            var $write = $tx->execute(
                'update releases set pending_until = null where package = ? and version = ? and pending_until > ?',
                [$key, $version, $now],
            );
            if ($write->affected() == 1) {
                Events::release($tx, 'release-confirmed', $key, $version);
                $changed = true;
            }
            return $changed;
        });
    }

    // Hides a version from search and listings, or shows it again when `$listed` is `true`.
    // It stays fetchable. It returns `false` when the version is in that state already.
    public function unlist(string $key, string $version, bool $listed): bool
    {
        int $now = Time::now()->toEpochSeconds();
        return $this->db->transaction(fn(Transaction $tx): bool => {
            $this->ensureRow($tx, $key, $version);
            var $write = $listed
                ? $tx->execute('update release_states set unlisted_at = null where package = ? and version = ? and unlisted_at is not null', [$key, $version])
                : $tx->execute('update release_states set unlisted_at = ? where package = ? and version = ? and unlisted_at is null', [$now, $key, $version]);
            if ($write->affected() != 1) {
                return false;
            }
            Events::release($tx, $listed ? 'relist' : 'unlist', $key, $version);
            return true;
        });
    }

    // Moves the package `$key` to another repository, or another folder in it, and saves its log entry.
    // The next publish must come from there, and each release keeps the repository it was built from.
    // It returns `false` when a package publishes from that folder of that repository already.
    public function rebind(string $key, string $repository, string $directory): bool
    {
        return $this->db->transaction(fn(Transaction $tx): bool => {
            // This statement writes, so the transaction has the write lock of the database from here on.
            // When the first statement only reads, SQLite fails the write below at once while another request writes.
            $tx->execute('update packages set repository = repository where key = ?', [$key]);
            if ($tx->query('select 1 from packages where repository = ? and directory = ?', [$repository, $directory])->count() != 0) {
                return false;
            }
            $tx->execute('update packages set repository = ?, directory = ? where key = ?', [$repository, $directory, $key]);
            Events::repository($tx, $key, $repository);
            return true;
        });
    }

    // Retracts a version with its reason and, when there is one, the version that fixes it.
    // `$from` is the time the retraction shows in the index: now for a passkey, seven days later
    // for a token alone. The log and the advisory feed take its entry from that time too, and the
    // owners get a message now. A second retraction with an earlier time moves the time forward.
    // It gives the waiting entry its reason and time, and adds no entry.
    // It returns `false` when the version is retracted already from that time or earlier.
    public function retract(string $key, string $version, string $reason, ?string $fixedIn, int $from): bool
    {
        return $this->db->transaction(fn(Transaction $tx): bool => {
            $this->ensureRow($tx, $key, $version);
            var $write = $tx->execute(
                'update release_states set retracted_at = ?, retract_reason = ?, fixed_in = ? '
                    . 'where package = ? and version = ? and (retracted_at is null or retracted_at > ?)',
                [$from, $reason, $fixedIn, $key, $version, $from],
            );
            if ($write->affected() != 1) {
                return false;
            }
            ?int $waiting = null;
            foreach ($tx->query('select retract_event from release_states where package = ? and version = ?', [$key, $version]) as Row $row) {
                $waiting = $row->int('retract_event');
            }
            // The entry is not found when the log has it already. A new entry is added then.
            if ($waiting != null && Events::moved($tx, $waiting, $key, $version, $reason, $fixedIn, $from)) {
                return true;
            }
            int $event = Events::reasoned($tx, 'retract', $key, $version, $reason, $fixedIn, $from);
            $tx->execute('update release_states set retract_event = ? where package = ? and version = ?', [$event, $key, $version]);
            return true;
        });
    }

    // Sends an advisory about the versions `$range` of the package `$key`, with a summary.
    // `$from` is the time the advisory goes into the log and the feed: now for a passkey, seven days
    // later for a token alone. The same advisory sent again with an earlier time moves the time forward.
    // It returns the id of the advisory, such as `acme/http-1`. When the same advisory is sent
    // already from that time or earlier, the result is `null`.
    public function advise(string $key, VersionRange $range, string $summary, int $from): ?string
    {
        string $versions = $range->text();
        return $this->db->transaction(fn(Transaction $tx): ?string => {
            // This statement writes, so the transaction has the write lock of the database from here on.
            // When the first statement only reads, SQLite fails the write below at once while another request writes.
            $tx->execute('update packages set repository = repository where key = ?', [$key]);
            // A cancelled advisory is not the same advisory. It still counts for the next id below.
            var $same = $tx->query(
                'select id, shows_at, event from advisories where package = ? and versions = ? and summary = ? and cancelled_at is null',
                [$key, $versions, $summary],
            );
            foreach ($same as Row $row) {
                if (($row->int('shows_at') ?? 0) <= $from) {
                    return null;
                }
                string $found = Releases::trusted($row->string('id'));
                $tx->execute('update advisories set shows_at = ? where id = ?', [$from, $found]);
                $tx->execute('update events set due = ? where id = ?', [$from, $row->int('event')]);
                return $found;
            }
            int $count = 0;
            foreach ($tx->query('select count(*) as n from advisories where package = ?', [$key]) as Row $row) {
                $count = $row->int('n') ?? 0;
            }
            string $id = Index::slug($key) . '-' . ($count + 1);
            int $event = Events::advisory($tx, $key, $id, $versions, $summary, $from);
            $tx->execute(
                'insert into advisories (id, package, versions, summary, shows_at, event) values (?, ?, ?, ?, ?, ?)',
                [$id, $key, $versions, $summary, $from, $event],
            );
            return $id;
        });
    }

    // Cancels the waiting retraction of a version. A retraction waits while its time has not come and
    // the log does not have its entry. The version is then not retracted, and the owners get a message.
    // It returns `false` when no retraction of the version waits.
    public function cancelRetraction(string $key, string $version): bool
    {
        int $now = Time::now()->toEpochSeconds();
        return $this->db->transaction(fn(Transaction $tx): bool => {
            var $write = $tx->execute(
                'delete from events where due > ? and id = (select retract_event from release_states where package = ? and version = ?)',
                [$now, $key, $version],
            );
            if ($write->affected() != 1) {
                return false;
            }
            $tx->execute(
                'update release_states set retracted_at = null, retract_reason = null, fixed_in = null, retract_event = null '
                    . 'where package = ? and version = ?',
                [$key, $version],
            );
            Events::cancelled($tx, $key, $version, null);
            return true;
        });
    }

    // Cancels the waiting advisory `$id`, such as `acme/http-1`. An advisory waits while its time has
    // not come and the log does not have its entry. Its row stays, so no other advisory gets its id.
    // It returns `false` when no such advisory waits.
    public function cancelAdvisory(string $key, string $id): bool
    {
        int $now = Time::now()->toEpochSeconds();
        return $this->db->transaction(fn(Transaction $tx): bool => {
            var $write = $tx->execute(
                'delete from events where due > ? and id = (select event from advisories where id = ? and package = ? and cancelled_at is null)',
                [$now, $id, $key],
            );
            if ($write->affected() != 1) {
                return false;
            }
            $tx->execute('update advisories set cancelled_at = ? where id = ?', [$now, $id]);
            Events::cancelled($tx, $key, null, $id);
            return true;
        });
    }

    // Returns `true` when the version `$version` of `$key` is retracted, or will be at a later time.
    public function isRetracted(string $key, string $version): bool
    {
        var $rows = $this->db->query(
            'select 1 as found from release_states where package = ? and version = ? and retracted_at is not null',
            [$key, $version],
        );
        return $rows->count() > 0;
    }

    // Returns `true` when `$key` has the advisory `$id` and it is not cancelled.
    public function hasAdvisory(string $key, string $id): bool
    {
        var $rows = $this->db->query('select 1 as found from advisories where id = ? and package = ? and cancelled_at is null', [$id, $key]);
        return $rows->count() > 0;
    }

    // Withholds the bytes of a version, for malware or a legal order. Only the operator does this.
    // The name, the version and the digest stay in the index and the log, with the reason.
    // It returns `false` when the version is withheld already.
    public function withhold(string $key, string $version, string $reason): bool
    {
        return $this->db->transaction(fn(Transaction $tx): bool => {
            $this->ensureRow($tx, $key, $version);
            var $write = $tx->execute(
                'update release_states set withheld = ? where package = ? and version = ? and withheld is null',
                [$reason, $key, $version],
            );
            if ($write->affected() != 1) {
                return false;
            }
            Events::reasoned($tx, 'withhold', $key, $version, $reason, null, Time::now()->toEpochSeconds());
            return true;
        });
    }

    // Returns `true` when the bytes of the archive with this digest are withheld.
    public function isWithheld(string $digest): bool
    {
        var $rows = $this->db->query(
            'select 1 as found from releases r join release_states s on s.package = r.package and s.version = r.version '
                . 'where r.digest = ? and s.withheld is not null',
            [$digest],
        );
        foreach ($rows as Row $row) {
            return true;
        }
        return false;
    }

    // Returns the path of a version's archive in the stores, such as `archive/` and 64 hex characters and `.tar`.
    public static function archiveOf(Connection $db, string $key, string $version): string
    {
        foreach ($db->query('select digest from releases where package = ? and version = ?', [$key, $version]) as Row $row) {
            string $digest = Releases::trusted($row->string('digest'));
            return 'archive/' . (Str::startsWith($digest, 'blake3:') ? Str::slice($digest, 7) : $digest) . '.tar';
        }
        throw new RuntimeError('The package ' . $key . ' has no version ' . $version . '.');
    }

    private function ensureRow(Transaction $tx, string $key, string $version): void
    {
        $tx->execute('insert into release_states (package, version) values (?, ?) on conflict (package, version) do nothing', [$key, $version]);
    }

    private static function trusted(mixed $value): string
    {
        return Core\Taint::assertTrusted($value as tainted string, 'the registry wrote this text');
    }
}
