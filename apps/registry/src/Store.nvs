<?nvs
namespace Registry;

use Core\Http\Client;
use Core\Http\Part;
use Core\IO;
use Core\Path;
use Core\Random;
use Core\Str;
use RuntimeError;

// One place the registry writes files to, from `hosting.json`.
// A `dir` store is a folder. An `http` store gets each file as a `PUT` request to its URL
// with one header that has the credential, as Bunny Storage and a WebDAV server take it.
final class Store
{
    public function constructor(
        // `dir` or `http`.
        public readonly string $kind,
        // The folder of a `dir` store, as a full path. The base URL of an `http` store, ending in `/`.
        public readonly string $location,
        // The name of the header with the credential, such as `AccessKey`. Empty for a `dir` store.
        public readonly string $header = '',
        // The file with the credential. Empty for a `dir` store.
        public readonly string $secret = '',
    )
    {}

    // Reads one store from `hosting.json`. `$where` names it in an error, such as `stores[0]`.
    // A relative folder is relative to `$base`, the folder of `hosting.json`.
    // It throws a `RuntimeError` when a setting is missing or the credential file does not exist.
    public static function of(array<mixed> $settings, string $base, string $where): Store
    {
        string $kind = Site::text($settings, 'kind', $where);
        if ($kind == 'dir') {
            return new Store('dir', Path::join($base, Site::text($settings, 'path', $where)));
        }
        if ($kind == 'http') {
            string $url = Site::text($settings, 'url', $where);
            if (!Str::startsWith($url, 'https://') && !Str::startsWith($url, 'http://')) {
                throw new RuntimeError('hosting.json: `' . $where . '.url` must start with `https://`.');
            }
            return new Store(
                'http',
                Str::endsWith($url, '/') ? $url : $url . '/',
                Site::text($settings, 'header', $where),
                Site::secretPath(Site::text($settings, 'secret', $where), $base, $where . '.secret'),
            );
        }
        throw new RuntimeError('hosting.json: `' . $where . '.kind` must be `dir` or `http`.');
    }

    // Writes the file `$file` to `$path` in this store, such as `index/acme/http.json`.
    // A `dir` store gets the whole file at once, so a reader never sees half of it.
    // It throws a `RuntimeError` when the store does not take the file.
    public function put(string $path, string $file): void
    {
        if ($this->kind == 'dir') {
            string $target = Path::join($this->location, $path);
            IO::makeDir(Path::dirname($target));
            string $partial = $target . '.' . Random::token(8) . '.partial';
            IO::copy($file, $partial);
            IO::move($partial, $target);
            return;
        }
        secret string $credential = Str::trim(IO::read($this->secret));
        var $response = Client::put($this->location . $path, {
            body: Part::file($file),
            headers: [$this->header => $credential],
        });
        if ($response->status() < 200 || $response->status() > 299) {
            throw new RuntimeError('The store ' . $this->location . ' answered ' . $response->status() . ' for ' . $path . '.');
        }
    }

    // Copies the file at `$path` in this store to the local file `$file`.
    // An `http` store gets a `GET` request with the same credential header as `put`.
    // It returns `false` when the store has no file at `$path`, and throws a `RuntimeError`
    // when the store gives another error.
    // Memory: an `http` store's file is in memory once while it is written.
    public function fetch(string $path, string $file): bool
    {
        if ($this->kind == 'dir') {
            string $source = Path::join($this->location, $path);
            if (!IO::isFile($source)) {
                return false;
            }
            IO::copy($source, $file);
            return true;
        }
        secret string $credential = Str::trim(IO::read($this->secret));
        var $response = Client::get($this->location . $path, { headers: [$this->header => $credential] });
        if ($response->status() == 404) {
            return false;
        }
        if ($response->status() < 200 || $response->status() > 299) {
            throw new RuntimeError('The store ' . $this->location . ' answered ' . $response->status() . ' for ' . $path . '.');
        }
        // Every reader checks what it reads: the copy is sealed, `nvs registry log verify` checks the log,
        // and `Downloads` skips each access line that does not have the form it counts.
        IO::writeStream($file, [Core\Taint::assertTrustedBytes($response->bytes(), 'every reader checks the file it fetched')]);
        return true;
    }

    // Returns the full path of `$path` in a `dir` store, or `null` for an `http` store.
    public function fileOf(string $path): ?string
    {
        return $this->kind == 'dir' ? Path::join($this->location, $path) : null;
    }
}
