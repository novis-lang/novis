<?nvs
namespace Registry;

use Core\Access;
use Core\Arr;
use Core\Encoding;
use Core\Http\Method;
use Core\Json;
use Core\Passkey;
use Core\Request;
use Core\Response;
use Core\Route;
use Core\Str;
use ParseError;
use RuntimeError;

// The routes of the registry. Each method with a `Route` handles one kind of request.
// Every route takes JSON and returns JSON.
final class App
{
    // The name of the site, as a device shows it next to the passkey.
    public const string NAME = 'Novis registry';

    // The messages to the other devices and webhooks of an account when its channels change.
    public const string DEVICE_ADDED = 'A new device gets the messages of your account.';
    public const string WEBHOOK_ADDED = 'A new webhook gets the messages of your account.';
    public const string CHANNEL_REMOVED = 'A device or a webhook was removed from your account.';

    // Returns the packages that match the text `q`, in the order `sort`, with the facts of each one.
    // `sort` is `default`, `date`, `activity`, `downloads` or `name`, and `default` is the order of `Ranking`.
    #[Route(path: '/api/search', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function search(): void
    {
        ?Sort $sort = Search::sortOf(Request::query('sort') ?? 'default');
        if ($sort == null) {
            App::fail(400, 'The sort must be default, date, activity, downloads or name.');
            return;
        }
        array<Facts> $found = new Search(Schema::open())->find(Request::query('q') ?? '', $sort, Core\Time::now()->toEpochSeconds());
        Response::json({
            sort: Search::nameOf($sort),
            ranking: 'apps/registry/src/Ranking.nvs',
            packages: Arr::map($found, fn(Facts $f): mixed => ({
                name: $f->name,
                summary: $f->summary,
                score: Ranking::score($f),
                ageDays: $f->ageDays,
                activeMonths: $f->activeMonths,
                releasedAt: $f->releasedAt,
                daysSinceRelease: $f->daysSinceRelease,
                declarations: $f->declarations,
                documented: $f->documented,
                fixedRetractions: $f->fixedRetractions,
                downloads: $f->downloads,
            })),
        });
    }

    // The page of a package: its versions, owners, advisories, the facts of its order in a search, and its readme.
    #[Route(path: '/packages/{vendor}/{name}', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function packagePage(tainted string $vendor, tainted string $name): void
    {
        var $db = Schema::open();
        ?string $key = new Releases($db)->packageOf($vendor, $name);
        ?Core\Html\Markup $page = $key == null ? null : new PackagePage($db, Core\Time::now()->toEpochSeconds(), Site::load()->feed())->package($key);
        App::page($page);
    }

    // The page of one version of a package: its state, commit, capabilities, API changes, files and readme.
    #[Route(path: '/packages/{vendor}/{name}/{version}', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function versionPage(tainted string $vendor, tainted string $name, tainted string $version): void
    {
        var $db = Schema::open();
        ?string $key = new Releases($db)->packageOf($vendor, $name);
        ?string $wanted = App::versionOf($version);
        ?Core\Html\Markup $page = $key == null || $wanted == null ? null : new PackagePage($db, Core\Time::now()->toEpochSeconds(), Site::load()->feed())->version($key, $wanted);
        App::page($page);
    }

    // The page of the account: its passkeys, tokens, vendors, devices and webhooks, inbox, and the days it can still publish.
    #[Route(path: '/account', method: Method::Get)]
    #[Access(allow: Visitor::SignedIn)]
    public static function accountPage(): void
    {
        Response::html(new AccountPage(Schema::open(), Core\Time::now()->toEpochSeconds())->of(Session::account() ?? ''));
    }

    // The page that says the operator of the registry only withholds a version, and why.
    #[Route(path: '/policy', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function policyPage(): void
    {
        Response::html(PolicyPage::page());
    }

    // Step 1 of a sign-up: returns a challenge for the proof-of-work and the number of zero bits it needs.
    #[Route(path: '/api/signup/work', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function signUpWork(): void
    {
        Response::json({ challenge: Work::issue(), bits: Site::load()->signUpWork });
    }

    // Step 2 of a sign-up: checks the proof-of-work and returns the options for a new passkey.
    #[Route(path: '/api/signup/options', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function signUpOptions(): void
    {
        var $site = Site::load();
        try {
            var $answer = Request::jsonAs<WorkAnswer>();
            if (!Work::check($answer->challenge, $answer->nonce, $site->signUpWork)) {
                App::fail(403, 'The proof-of-work is not valid. Ask for a new challenge.');
                return;
            }
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a challenge and a nonce.');
            return;
        }
        string $account = Accounts::newId();
        Session::startSignUp($account);
        App::options(Passkey::registerOptions($site->domain(), App::NAME, Encoding::fromHex($account), App::label($account)));
    }

    // Step 3 of a sign-up: checks the new passkey and creates the account.
    // It returns the recovery codes. They are shown this one time only.
    #[Route(path: '/api/signup', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function signUp(): void
    {
        var $site = Site::load();
        ?string $account = Session::takeSignUp();
        if ($account == null) {
            App::fail(403, 'Send the proof-of-work first.');
            return;
        }
        try {
            var $passkey = Passkey::verifyRegistration(Request::body(), $site->domain(), $site->origin);
            array<string> $codes = new Accounts(Schema::open())->create($account, $passkey);
            Session::signIn($account, true);
            Response::setStatus(201);
            Response::json({ account: $account, recoveryCodes: $codes });
        } catch (RuntimeError $error) {
            App::fail(400, 'The passkey could not be checked. Start the sign-up again.');
        }
    }

    // Returns the options to sign in with any passkey of this site.
    #[Route(path: '/api/signin/options', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function signInOptions(): void
    {
        App::options(Passkey::signInOptions(Site::load()->domain()));
    }

    // Checks a sign-in with a passkey, and signs the visitor in to its account.
    #[Route(path: '/api/signin', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function signIn(): void
    {
        var $site = Site::load();
        var $accounts = new Accounts(Schema::open());
        try {
            ?Owned $owned = $accounts->findPasskey(Passkey::credentialId(Request::body()));
            if ($owned == null) {
                App::fail(403, 'This passkey belongs to no account.');
                return;
            }
            var $passkey = Passkey::verifySignIn(Request::body(), $owned->passkey, $site->domain(), $site->origin);
            $accounts->signedIn($owned->account, $passkey);
            Session::signIn($owned->account, true);
            Response::json({ account: $owned->account });
        } catch (RuntimeError $error) {
            App::fail(403, 'The passkey could not be checked.');
        }
    }

    // Signs the visitor in with a recovery code. Each code works once.
    #[Route(path: '/api/signin/recovery', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function signInWithCode(): void
    {
        var $accounts = new Accounts(Schema::open());
        try {
            ?string $account = $accounts->useRecoveryCode(Request::jsonAs<CodeAnswer>()->code);
            if ($account == null) {
                App::fail(403, 'This recovery code is not valid, or it was used before.');
                return;
            }
            Session::signIn($account, false);
            Response::json({ account: $account, recoveryCodesLeft: $accounts->recoveryCodesLeft($account) });
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a code.');
        }
    }

    // Returns the account of the visitor, its number of passkeys and of unused recovery codes, and the vendors it owns.
    // `activeUntil` is the time the account stops being able to publish without activity, and
    // `remindAfter` is the quiet days before its first reminder.
    #[Route(path: '/api/account', method: Method::Get)]
    #[Access(allow: Visitor::SignedIn)]
    public static function account(): void
    {
        string $account = Session::account() ?? '';
        var $db = Schema::open();
        var $accounts = new Accounts($db);
        var $activity = new Activity($db);
        Response::json({
            account: $account,
            passkeys: Arr::count($accounts->passkeys($account)),
            recoveryCodesLeft: $accounts->recoveryCodesLeft($account),
            vendors: new Vendors($db)->ownedBy($account),
            activeUntil: $activity->activeUntil($account),
            remindAfter: $activity->remindAfter($account),
        });
    }

    // Saves the quiet days before the first reminder, from 7 to 59, such as `{"days": 45}`.
    #[Route(path: '/api/account/reminders', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function setReminders(): void
    {
        try {
            int $days = Request::jsonAs<ReminderRequest>()->days;
            if (!new Activity(Schema::open())->setRemindAfter(Session::account() ?? '', $days)) {
                App::fail(400, 'The number of days must be from ' . Activity::REMIND_FIRST . ' to ' . Activity::REMIND_LAST . '.');
                return;
            }
            Response::json({ remindAfter: $days });
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a number of days.');
        }
    }

    // The page that a reminder opens. Its button sends the answer "Yes, I am here".
    #[Route(path: '/here/{code}', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function herePage(tainted string $code): void
    {
        Response::html(
            '<!doctype html><title>Novis registry</title><p>Your account had no activity for a while.</p>' as Core\Html\Markup
                + '<form method="post"><button>Yes, I am here</button></form>' as Core\Html\Markup,
        );
    }

    // Takes the answer "Yes, I am here" with the one-time code of a reminder. A right code counts
    // as activity. The button of the page and the action of a push message send it.
    #[Route(path: '/here/{code}', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function here(tainted string $code): void
    {
        if (new Activity(Schema::open())->answer($code) == null) {
            Response::setStatus(404);
            Response::html(
                '<!doctype html><title>Novis registry</title><p>This link is wrong or was used before. ' as Core\Html\Markup
                    + 'If your account had no activity for 60 days, sign in with a passkey.</p>' as Core\Html\Markup,
            );
            return;
        }
        Response::html('<!doctype html><title>Novis registry</title><p>Thank you. Your account can publish.</p>' as Core\Html\Markup);
    }

    // Returns the options for one more passkey. The passkeys the account has are excluded.
    #[Route(path: '/api/account/passkeys/options', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function passkeyOptions(): void
    {
        string $account = Session::account() ?? '';
        var $existing = new Accounts(Schema::open())->passkeys($account);
        App::options(Passkey::registerOptions(Site::load()->domain(), App::NAME, Encoding::fromHex($account), App::label($account), $existing));
    }

    // Checks the new passkey and adds it to the account.
    #[Route(path: '/api/account/passkeys', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function addPasskey(): void
    {
        var $site = Site::load();
        string $account = Session::account() ?? '';
        var $accounts = new Accounts(Schema::open());
        try {
            $accounts->addPasskey($account, Passkey::verifyRegistration(Request::body(), $site->domain(), $site->origin));
            Response::setStatus(201);
            Response::json({ passkeys: Arr::count($accounts->passkeys($account)) });
        } catch (RuntimeError $error) {
            App::fail(400, 'The passkey could not be checked.');
        }
    }

    // Returns the owners of a vendor. Only an owner of the vendor sees them.
    #[Route(path: '/api/vendors/{vendor}/owners', method: Method::Get)]
    #[Access(allow: Visitor::SignedIn)]
    public static function owners(tainted string $vendor): void
    {
        var $vendors = new Vendors(Schema::open());
        ?string $name = App::ownedVendor($vendors, $vendor);
        if ($name != null) {
            Response::json({ vendor: $name, owners: $vendors->owners($name) });
        }
    }

    // Adds an owner to a vendor. Only an owner who signed in with a passkey in the last 15 minutes can do this.
    // The new owner must have a verified channel for messages.
    #[Route(path: '/api/vendors/{vendor}/owners', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function addOwner(tainted string $vendor): void
    {
        if (!App::needsPasskey()) {
            return;
        }
        var $db = Schema::open();
        var $vendors = new Vendors($db);
        ?string $name = App::ownedVendor($vendors, $vendor);
        if ($name == null) {
            return;
        }
        try {
            ?string $account = Accounts::idOf(Request::jsonAs<OwnerAnswer>()->account);
            if ($account == null || !new Accounts($db)->exists($account)) {
                App::fail(404, 'There is no account with this id.');
                return;
            }
            if (!new Channels($db)->hasVerified($account)) {
                App::fail(403, 'This account has no verified channel for messages. It must add a push device or a webhook before it can become an owner.');
                return;
            }
            if (!$vendors->addOwner($name, $account)) {
                App::fail(409, 'This account is an owner already.');
                return;
            }
            Response::setStatus(201);
            Response::json({ vendor: $name, owners: $vendors->owners($name), sent: App::flush($db) });
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with an account.');
        }
    }

    // Removes an owner from a vendor. The last owner cannot be removed.
    // Only an owner who signed in with a passkey in the last 15 minutes can do this.
    #[Route(path: '/api/vendors/{vendor}/owners/{account}', method: Method::Delete)]
    #[Access(allow: Visitor::SignedIn)]
    public static function removeOwner(tainted string $vendor, tainted string $account): void
    {
        if (!App::needsPasskey()) {
            return;
        }
        var $db = Schema::open();
        var $vendors = new Vendors($db);
        ?string $name = App::ownedVendor($vendors, $vendor);
        if ($name == null) {
            return;
        }
        ?string $owner = Accounts::idOf($account);
        if ($owner == null || !$vendors->isOwner($name, $owner)) {
            App::fail(404, 'This account is not an owner of the vendor.');
            return;
        }
        if (!$vendors->removeOwner($name, $owner)) {
            App::fail(409, 'The last owner of a vendor cannot be removed.');
            return;
        }
        Response::json({ vendor: $name, owners: $vendors->owners($name), sent: App::flush($db) });
    }

    // Makes a publish token for a vendor or one of its packages. The answer shows the token this one time only.
    // Only an owner who signed in with a passkey in the last 15 minutes can do this.
    #[Route(path: '/api/tokens', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function createToken(): void
    {
        if (!App::needsPasskey()) {
            return;
        }
        string $account = Session::account() ?? '';
        var $db = Schema::open();
        try {
            var $asked = Request::jsonAs<TokenRequest>();
            ?string $scope = Tokens::scopeOf($asked->scope);
            if ($scope == null) {
                App::fail(400, 'The scope must be a vendor, such as `Acme`, or a package, such as `Acme\\Http`.');
                return;
            }
            if ($asked->days < 1 || $asked->days > Tokens::MAX_DAYS) {
                App::fail(400, 'A token works for 1 to 365 days.');
                return;
            }
            if (!new Vendors($db)->mayPublish(Str::before($scope, '\\') ?? $scope, $account)) {
                App::fail(403, 'You can make a token only for a vendor you own, or a new vendor that nobody owns yet.');
                return;
            }
            array<string> $made = new Tokens($db)->create($account, $scope, $asked->days);
            Response::setStatus(201);
            Response::json({ id: $made['id'], token: $made['token'], scope: $scope, days: $asked->days, sent: App::flush($db) });
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a scope and a number of days.');
        }
    }

    // Returns the tokens of the account, the newest first. The answer has no token itself, only its id.
    #[Route(path: '/api/tokens', method: Method::Get)]
    #[Access(allow: Visitor::SignedIn)]
    public static function tokens(): void
    {
        Response::json({ tokens: new Tokens(Schema::open())->of(Session::account() ?? '') });
    }

    // Revokes a token of the account. A recovery code is enough for this.
    #[Route(path: '/api/tokens/{id}', method: Method::Delete)]
    #[Access(allow: Visitor::SignedIn)]
    public static function revokeToken(tainted string $id): void
    {
        var $db = Schema::open();
        if (!new Tokens($db)->revoke(Session::account() ?? '', $id)) {
            App::fail(404, 'This account has no such token, or it was revoked before.');
            return;
        }
        // The token stops working now. Its entry of the log waits for the next run when this fails.
        App::flush($db);
        Response::setStatus(204);
    }

    // Returns the public key that the page passes to `pushManager.subscribe()`.
    // The answer is `503` when the registry has no key for Web Push.
    #[Route(path: '/api/push/key', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function pushKey(): void
    {
        ?Push $push = Push::ofSite(Schema::open(), Site::load());
        if ($push == null) {
            App::fail(503, 'This registry has no key for Web Push.');
            return;
        }
        Response::json({ applicationServerKey: $push->publicKey() });
    }

    // Adds a push device and sends it a test message with a one-time code. The device counts once
    // the code comes back. Only an owner who signed in with a passkey in the last 15 minutes can do this.
    #[Route(path: '/api/push/devices', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function addDevice(): void
    {
        if (!App::needsPasskey()) {
            return;
        }
        var $db = Schema::open();
        ?Push $push = Push::ofSite($db, Site::load());
        if ($push == null) {
            App::fail(503, 'This registry has no key for Web Push.');
            return;
        }
        try {
            var $asked = Request::jsonAs<DeviceRequest>();
            string $account = Session::account() ?? '';
            ?string $id = $push->register($account, $asked->subscription);
            if ($id == null) {
                App::fail(410, 'The push service does not know this device. Allow notifications in the browser again.');
                return;
            }
            new Notices($db, $push, new Webhooks($db, Site::load()->origin))->tell($account, App::DEVICE_ADDED, $id);
            Response::setStatus(201);
            Response::json({ id: $id });
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a subscription.');
        } catch (RuntimeError $invalid) {
            App::fail(400, 'The subscription is not valid. Send the text that `PushSubscription.toJSON()` returns.');
        }
    }

    // Adds a webhook and sends it a message with a one-time code. The webhook counts once the code
    // comes back. The answer has the secret that signs its messages, and it is shown only this once.
    // Only an owner who signed in with a passkey in the last 15 minutes can do this.
    #[Route(path: '/api/webhooks', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function addWebhook(): void
    {
        if (!App::needsPasskey()) {
            return;
        }
        var $db = Schema::open();
        string $account = Session::account() ?? '';
        try {
            var $asked = Request::jsonAs<WebhookRequest>();
            array<string> $added = new Webhooks($db, Site::load()->origin)->add($account, $asked->url);
            Notices::ofSite($db, Site::load())->tell($account, App::WEBHOOK_ADDED, $added['id']);
            Response::setStatus(201);
            Response::json({ id: $added['id'], secret: $added['secret'] });
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a url.');
        } catch (RuntimeError $refused) {
            App::fail(400, $refused->message);
        }
    }

    // Verifies a webhook with the link in its message. The code in the link is the proof,
    // so nobody needs to be signed in.
    #[Route(path: '/api/channels/{id}/confirm/{code}', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function confirmWebhook(tainted string $id, tainted string $code): void
    {
        if (!new Channels(Schema::open())->confirm($id, $code)) {
            App::fail(404, 'The link is wrong or expired. Send a new test message from your account page.');
            return;
        }
        Response::json({ id: Core\Taint::assertTrusted($id, 'the id matched a channel'), verified: true });
    }

    // Returns the push devices and webhooks of the account, with the time each one last took a message.
    #[Route(path: '/api/channels', method: Method::Get)]
    #[Access(allow: Visitor::SignedIn)]
    public static function channels(): void
    {
        Response::json({ channels: new Channels(Schema::open())->of(Session::account() ?? '') });
    }

    // Verifies a channel with the one-time code of its test message.
    #[Route(path: '/api/channels/{id}/verify', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function verifyChannel(tainted string $id): void
    {
        try {
            var $answer = Request::jsonAs<CodeAnswer>();
            if (!new Channels(Schema::open())->verify(Session::account() ?? '', $id, $answer->code)) {
                App::fail(404, 'The code is wrong or expired, or this account has no such channel.');
                return;
            }
            Response::json({ id: Core\Taint::assertTrusted($id, 'the id matched a channel'), verified: true });
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a code.');
        }
    }

    // Sends a new test message with a new one-time code to a push device or a webhook of the account.
    #[Route(path: '/api/channels/{id}/test', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function testChannel(tainted string $id): void
    {
        var $db = Schema::open();
        string $account = Session::account() ?? '';
        ?array<string> $found = new Channels($db)->find($account, $id);
        if ($found == null) {
            App::fail(404, 'This account has no such channel.');
            return;
        }
        if ($found['kind'] == Channels::WEBHOOK) {
            if (!new Webhooks($db, Site::load()->origin)->sendCode($account, $id)) {
                App::fail(502, 'The webhook did not take the message. It is sent again in one minute.');
                return;
            }
            Response::json({ id: Core\Taint::assertTrusted($id, 'the id matched a channel'), sent: true });
            return;
        }
        ?Push $push = Push::ofSite($db, Site::load());
        if ($push == null) {
            App::fail(503, 'This registry has no key for Web Push.');
            return;
        }
        if (!$push->sendCode($account, $id)) {
            App::fail(502, 'The push service did not take the message.');
            return;
        }
        Response::json({ id: Core\Taint::assertTrusted($id, 'the id matched a channel'), sent: true });
    }

    // Deletes a push device or a webhook of the account. The other devices get a message about it.
    #[Route(path: '/api/channels/{id}', method: Method::Delete)]
    #[Access(allow: Visitor::SignedIn)]
    public static function removeChannel(tainted string $id): void
    {
        var $db = Schema::open();
        string $account = Session::account() ?? '';
        if (!new Channels($db)->remove($account, $id)) {
            App::fail(404, 'This account has no such channel.');
            return;
        }
        Notices::ofSite($db, Site::load())->tell($account, App::CHANNEL_REMOVED);
        Response::setStatus(204);
    }

    // Returns the account and the scope of the token in the `authorization` header.
    // `nvs pkg whoami` calls this. The session is not used.
    #[Route(path: '/api/whoami', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function whoami(): void
    {
        ?Token $token = new Tokens(Schema::open())->find(Tokens::bearer());
        if ($token == null) {
            App::fail(401, 'The token is not valid. It may be expired or revoked.');
            return;
        }
        var $db = Schema::open();
        Response::json({
            account: $token->account,
            scope: $token->scope,
            expiresAt: $token->expiresAt,
            pending: Feeds::pendingOf($db, $token->account),
        });
    }

    // The signed feed of a vendor: every event, such as a publish or a new token, the newest first.
    // Anybody can read it. It is a signed note that the public key of the log checks.
    #[Route(path: '/feeds/vendors/{vendor}', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function vendorFeed(tainted string $vendor): void
    {
        var $db = Schema::open();
        ?Feeds $feeds = Feeds::ofSite($db, Site::load());
        if ($feeds == null) {
            App::fail(503, 'This registry has no key for its log.');
            return;
        }
        ?string $name = Vendors::nameOf($vendor);
        ?string $feed = $name == null ? null : $feeds->vendor($name);
        if ($feed == null) {
            App::fail(404, 'There is no such vendor.');
            return;
        }
        Response::text($feed);
    }

    // The signed public list of every pending release. Anybody can read it.
    #[Route(path: '/feeds/pending', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function pendingFeed(): void
    {
        var $db = Schema::open();
        ?Feeds $feeds = Feeds::ofSite($db, Site::load());
        if ($feeds == null) {
            App::fail(503, 'This registry has no key for its log.');
            return;
        }
        Response::text($feeds->pending());
    }

    // The inbox: the events of every vendor the account owns, and the events about the account.
    #[Route(path: '/api/inbox', method: Method::Get)]
    #[Access(allow: Visitor::SignedIn)]
    public static function inbox(): void
    {
        var $db = Schema::open();
        string $account = Session::account() ?? '';
        Response::json({ events: Feeds::inbox($db, $account), pending: Feeds::pendingOf($db, $account) });
    }

    // Publishes a version. `nvs pkg publish` sends the repository, the commit, the version and the
    // folder of the package. The registry builds the archive from that commit itself.
    // The `authorization` header has the publish token. The session is not used.
    #[Route(path: '/api/publish', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function publish(): void
    {
        var $site = Site::load();
        try {
            var $sent = Request::jsonAs<PublishRequest>();
            var $db = Schema::open();
            var $done = new Publish($db, new NvsBuilder($site), $site)->publish(Tokens::bearer(), $sent);
            if ($done->digest == '') {
                App::fail($done->status, $done->text);
                return;
            }
            // The version is saved. It is answered only once it is in the log and in the index.
            if (!new Index($db, new NvsLog($site, Index::work($site)), $site)->catchUp($done->package)) {
                App::fail(
                    500,
                    'The version is saved, and the registry could not send it to every file host. '
                        . 'Publish the same commit again to finish.',
                );
                return;
            }
            // A copy of the database that fails does not fail the publish. The log has the release.
            new Backup($db, $site)->afterPublish();
            var $notices = Notices::ofSite($db, $site);
            int $took = $notices->send();
            string $account = new Tokens($db)->find(Tokens::bearer())?->account ?? '';
            Response::setStatus($done->status);
            Response::json({
                digest: $done->digest,
                message: $done->text,
                pending: Feeds::pendingOf($db, $account),
                warning: $took > 0 || $done->status != 201 ? null : App::unheard($notices, $done->package),
            });
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a repository, a commit, a version and a directory.');
        }
    }

    // Sends `registry.json`, the file that lists the file hosts.
    #[Route(path: '/registry.json', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function root(): void
    {
        Files::send('registry.json');
    }

    // Sends the index file of a package, such as `/index/acme/http.json`.
    #[Route(path: '/index/{vendor}/{file}', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function index(tainted string $vendor, tainted string $file): void
    {
        Files::send('index/' . $vendor . '/' . $file);
    }

    // Sends a file of the log, such as `/log/checkpoint`.
    #[Route(path: '/log/{path...}', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function log(tainted string $path): void
    {
        Files::send('log/' . $path);
    }

    // Sends the archive of a version, such as `/archive/<digest>.tar`, and counts the download.
    #[Route(path: '/archive/{file}', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function archive(tainted string $file): void
    {
        Files::sendArchive($file);
    }

    // Releases a pending version now. Only an owner who signed in with a passkey in the last 15 minutes can do this.
    #[Route(path: '/api/packages/{vendor}/{name}/{version}/release', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function release(tainted string $vendor, tainted string $name, tainted string $version): void
    {
        App::confirm($vendor, $name, $version, false);
    }

    // Confirms the API of the first version at `0.1.0` or higher, and releases it.
    // From then on, only a new major version may break this API.
    // Only an owner who signed in with a passkey in the last 15 minutes can do this.
    #[Route(path: '/api/packages/{vendor}/{name}/{version}/stable', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function stable(tainted string $vendor, tainted string $name, tainted string $version): void
    {
        App::confirm($vendor, $name, $version, true);
    }

    // Returns the API of a version, as `nvs registry build` wrote it. The page that confirms
    // the first stable API shows it.
    #[Route(path: '/api/packages/{vendor}/{name}/{version}/api', method: Method::Get)]
    #[Access(allow: Visitor::Anyone)]
    public static function api(tainted string $vendor, tainted string $name, tainted string $version): void
    {
        var $db = Schema::open();
        ?string $key = new Releases($db)->packageOf($vendor, $name);
        ?string $wanted = App::versionOf($version);
        if ($key != null && $wanted != null) {
            foreach ($db->query('select api from releases where package = ? and version = ?', [$key, $wanted]) as Core\Db\Row $row) {
                string $file = Core\Taint::assertTrusted($row->string('api') as tainted string, 'the registry wrote this path');
                if ($file != '' && Core\IO::isFile($file)) {
                    Response::json({ waitsForOwner: new Releases($db)->needsStable($key, $wanted), api: Json::decode(Core\IO::read($file)) });
                    return;
                }
            }
        }
        App::fail(404, 'There is no such version, or its API is not on this registry.');
    }

    // Hides a version from search and listings, or every version when `version` is empty.
    // It stays fetchable. Only an owner who signed in with a passkey in the last 15 minutes can do this.
    // With a token, the answer is `202` and gives the page where an owner does it with a passkey.
    #[Route(path: '/api/packages/{vendor}/{name}/unlist', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function unlist(tainted string $vendor, tainted string $name): void
    {
        try {
            App::listing($vendor, $name, Request::jsonAs<VersionRequest>(), false);
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a version.');
        }
    }

    // Shows an unlisted version again, or every version when `version` is empty.
    // It needs the same passkey sign-in as `unlist`.
    #[Route(path: '/api/packages/{vendor}/{name}/relist', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function relist(tainted string $vendor, tainted string $name): void
    {
        try {
            App::listing($vendor, $name, Request::jsonAs<VersionRequest>(), true);
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a version.');
        }
    }

    // Moves a package to another repository, or another folder in it. The next publish must come
    // from there. Only an owner who signed in with a passkey in the last 15 minutes can do this.
    #[Route(path: '/api/packages/{vendor}/{name}/repository', method: Method::Post)]
    #[Access(allow: Visitor::SignedIn)]
    public static function rebind(tainted string $vendor, tainted string $name): void
    {
        if (!App::needsPasskey()) {
            return;
        }
        var $db = Schema::open();
        var $releases = new Releases($db);
        ?string $key = $releases->packageOf($vendor, $name);
        if ($key == null || !App::ownsWithPasskey($db, $key)) {
            App::fail(404, 'You own no package with this name.');
            return;
        }
        try {
            var $asked = Request::jsonAs<RepositoryRequest>();
            ?string $repository = Publish::repositoryOf($asked->repository);
            ?string $directory = Publish::directoryOf($asked->directory);
            if ($repository == null || $directory == null) {
                App::fail(422, 'The repository must be an `https://` URL, and the directory a folder in it, such as `packages/http`.');
                return;
            }
            if (!$releases->rebind($key, $repository, $directory)) {
                App::fail(409, 'A package publishes from this folder of this repository already.');
                return;
            }
            Response::json({ repository: $repository, directory: $directory, sent: App::flush($db) });
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a repository and a directory.');
        }
    }

    // Retracts a version with a reason. With a passkey sign-in in the last 15 minutes, the index
    // shows it at once. With a token alone, it shows seven days later, and an owner's passkey can
    // retract it at once in that time.
    #[Route(path: '/api/packages/{vendor}/{name}/retract', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function retract(tainted string $vendor, tainted string $name): void
    {
        var $db = Schema::open();
        var $releases = new Releases($db);
        ?string $key = $releases->packageOf($vendor, $name);
        if ($key == null) {
            App::fail(404, 'There is no such package.');
            return;
        }
        try {
            var $asked = Request::jsonAs<RetractRequest>();
            ?string $version = App::versionOf($asked->version);
            if ($version == null || !$releases->has($key, $version)) {
                App::fail(404, 'The package has no such version.');
                return;
            }
            ?string $fixedIn = $asked->fixedIn == '' ? null : App::versionOf($asked->fixedIn);
            if ($asked->fixedIn != '' && ($fixedIn == null || !$releases->has($key, $fixedIn))) {
                App::fail(422, 'The version that fixes it must be a published version of the package.');
                return;
            }
            string $reason = Str::trim(Core\Taint::assertTrusted($asked->reason, 'a reason is text the index shows as JSON'));
            if ($reason == '' || Str::length($reason) > App::REASON_LENGTH) {
                App::fail(422, 'The reason must have 1 to 500 characters.');
                return;
            }
            int $now = Core\Time::now()->toEpochSeconds();
            int $from = $now;
            if (!App::ownsWithPasskey($db, $key)) {
                if (Session::account() != null) {
                    // A signed-in visitor who is not an owner, or whose passkey sign-in is too old.
                    App::fail(403, 'Sign in with a passkey as an owner of the package first.');
                    return;
                }
                if (new Tokens($db)->allows(Tokens::bearer(), $key) == null) {
                    App::fail(401, 'Send a publish token for this package, or sign in with a passkey.');
                    return;
                }
                $from = $now + Publish::PENDING_DAYS * 86400;
            }
            if (!$releases->retract($key, $version, $reason, $fixedIn, $from)) {
                App::fail(409, 'This version is retracted already.');
                return;
            }
            bool $sent = App::flush($db);
            string $text = $from == $now
                ? 'Version ' . $version . ' is retracted.'
                : 'Version ' . $version . ' is retracted from ' . Core\Time::fromEpoch($from)->toIso() . '. An owner can retract it now with a passkey on the website.';
            Response::json({ message: $text, sent: $sent });
        } catch (ParseError $error) {
            App::fail(400, 'The body must be JSON with a version, a reason and fixedIn.');
        }
    }

    // Signs the visitor out.
    #[Route(path: '/api/signout', method: Method::Post)]
    #[Access(allow: Visitor::Anyone)]
    public static function signOut(): void
    {
        Session::signOut();
        Response::setStatus(204);
    }

    // The longest reason of a retraction, in characters.
    private const int REASON_LENGTH = 500;

    // Releases a pending version, or confirms its stable API when `$stable` is `true`.
    private static function confirm(tainted string $vendor, tainted string $name, tainted string $version, bool $stable): void
    {
        if (!App::needsPasskey()) {
            return;
        }
        var $db = Schema::open();
        var $releases = new Releases($db);
        ?string $key = $releases->packageOf($vendor, $name);
        ?string $wanted = App::versionOf($version);
        if ($key == null || $wanted == null || !$releases->has($key, $wanted) || !App::ownsWithPasskey($db, $key)) {
            App::fail(404, 'You own no package with this version.');
            return;
        }
        if (!$stable && $releases->needsStable($key, $wanted)) {
            App::fail(409, 'This is the first version at 0.1.0 or higher. Confirm its API first.');
            return;
        }
        if (!$releases->confirm($key, $wanted, $stable)) {
            App::fail(409, 'This version is released already.');
            return;
        }
        Response::json({ version: $wanted, sent: App::flush($db) });
    }

    // Unlists a version, or every version when the body's `version` is empty, or shows it again.
    private static function listing(tainted string $vendor, tainted string $name, VersionRequest $asked, bool $listed): void
    {
        var $db = Schema::open();
        var $releases = new Releases($db);
        ?string $key = $releases->packageOf($vendor, $name);
        if ($key == null) {
            App::fail(404, 'There is no such package.');
            return;
        }
        array<string> $versions = [];
        if ($asked->version == '') {
            foreach ($db->query('select version from releases where package = ? order by major, minor, patch', [$key]) as Core\Db\Row $row) {
                $versions[] = Core\Taint::assertTrusted($row->string('version') as tainted string, 'the registry wrote this version');
            }
        } else {
            ?string $one = App::versionOf($asked->version);
            if ($one == null || !$releases->has($key, $one)) {
                App::fail(404, 'The package has no such version.');
                return;
            }
            $versions[] = $one;
        }
        if (!App::ownsWithPasskey($db, $key)) {
            if (Session::account() == null && new Tokens($db)->allows(Tokens::bearer(), $key) != null) {
                // A token cannot unlist. The answer names the page where an owner does it.
                Response::setStatus(202);
                Response::json({
                    message: 'To ' . ($listed ? 'list' : 'unlist') . ' it, sign in with a passkey and confirm on '
                        . Site::load()->origin . '/packages/' . Index::slug($key) . '.',
                });
                return;
            }
            App::fail(403, 'Sign in with a passkey as an owner of the package first.');
            return;
        }
        array<string> $changed = [];
        foreach ($versions as string $version) {
            if ($releases->unlist($key, $version, $listed)) {
                $changed[] = $version;
            }
        }
        if (Arr::count($changed) == 0) {
            App::fail(409, $listed ? 'Nothing is unlisted.' : 'This is unlisted already.');
            return;
        }
        Response::json({ versions: $changed, sent: App::flush($db) });
    }

    // Returns `true` when the visitor owns the vendor of the package `$key` and signed in with a
    // passkey in the last 15 minutes.
    private static function ownsWithPasskey(Core\Db\Connection $db, string $key): bool
    {
        ?string $account = Session::account();
        return $account != null && Session::hasRecentPasskey() && new Vendors($db)->isOwner(Str::before($key, '\\') ?? $key, $account);
    }

    // Adds the waiting entries to the log and sends the index files they change.
    // A failure does not undo the change. The entries wait for the next run, and the result is `false`.
    // Then it sends the waiting messages to the owners. A message that fails does not change the result.
    private static function flush(Core\Db\Connection $db): bool
    {
        var $site = Site::load();
        bool $sent = new Index($db, new NvsLog($site, Index::work($site)), $site)->flush();
        Notices::ofSite($db, $site)->send();
        return $sent;
    }

    // The warning `nvs pkg publish` prints when no owner of the vendor got the message about a release.
    private static function unheard(Notices $notices, string $key): string
    {
        string $vendor = Notices::vendorOf($key);
        if (!$notices->isReachable($vendor)) {
            return 'No owner of `' . $vendor . '` has a working device or webhook. Nobody was told about this release. '
                . 'Add a device or a webhook on the website.';
        }
        return 'No device or webhook of an owner of `' . $vendor . '` took the message about this release. '
            . 'A webhook gets it again later. Check them on the website.';
    }

    // A version from a path or a body, such as `1.4.0`, or `null` when it is not one.
    private static function versionOf(tainted string $text): ?string
    {
        ?array<int> $parts = Publish::versionOf($text);
        return $parts == null ? null : $parts[0] . '.' . $parts[1] . '.' . $parts[2];
    }

    // The name a device shows for the passkey, such as `account 3f2a9c1e`.
    private static function label(string $account): string
    {
        return 'account ' . Str::slice($account, 0, 8);
    }

    // Sends the options of a passkey ceremony to the browser.
    private static function options(string $json): void
    {
        Response::json(Json::decode($json));
    }

    // Returns the name of the vendor when the visitor owns it.
    // Otherwise it writes the error, and the result is `null`.
    private static function ownedVendor(Vendors $vendors, tainted string $vendor): ?string
    {
        ?string $name = Vendors::nameOf($vendor);
        ?string $found = $name == null ? null : $vendors->find($name);
        if ($found == null || !$vendors->isOwner($found, Session::account() ?? '')) {
            App::fail(404, 'You own no vendor with this name.');
            return null;
        }
        return $found;
    }

    // Returns `true` when the visitor signed in with a passkey in the last 15 minutes.
    // Otherwise it writes the error, and the result is `false`.
    private static function needsPasskey(): bool
    {
        if (Session::hasRecentPasskey()) {
            return true;
        }
        App::fail(403, 'Sign in with a passkey first. A recovery code is not enough for this.');
        return false;
    }

    // Sends a page, or a page that says there is no such package when `$page` is `null`.
    private static function page(?Core\Html\Markup $page): void
    {
        if ($page == null) {
            Response::setStatus(404);
            Response::html(html`<!doctype html><title>Not found · Novis registry</title><p>There is no such package or version on this registry.</p>`);
            return;
        }
        Response::html($page);
    }

    private static function fail(uint $status, string $text): void
    {
        Response::setStatus($status);
        Response::json({ error: $text });
    }
}
