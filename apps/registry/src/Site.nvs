<?nvs
namespace Registry;

use Core\IO;
use Core\Json;
use Core\Path;
use Core\Str;
use Core\Uri;
use RuntimeError;

// The settings of this installation, read from `hosting.json`.
// A deployment writes its own `hosting.json`. The code names no host.
final class Site
{
    public function constructor(
        // The address of the site, such as `https://registry.example.com`. Passkeys work only on it.
        public readonly string $origin,
        // The number of zero bits the proof-of-work of a sign-up needs.
        public readonly int $signUpWork,
        // The `nvs` program that builds each release, such as `/usr/local/bin/nvs`.
        public readonly string $nvs,
        // A PEM file with one more certificate authority for the git servers, or an empty string for none.
        public readonly string $gitCaFile,
        // The account that may publish the vendors `Core` and `Novis`, or an empty string for none.
        public readonly string $projectAccount,
        // The folder where the registry makes and signs its public files before it sends them to
        // the stores: `registry.json`, `index`, `archive` and `log`. It is never served.
        public readonly string $work,
        // The places every public file is written to. A publish is answered once each one has the file.
        public readonly array<Store> $stores,
        // The file hosts that `registry.json` lists, in the order a client tries them.
        // With none, a client reads every file from the address of the site.
        public readonly array<string> $hosts,
        // The place the sealed copies of the database are written to. It is never a public store.
        public readonly Store $backup,
        // The file with the key that seals the copies of the database, or an empty string for no copies.
        public readonly string $backupKey,
        // The minutes between two copies of the database when something changed.
        public readonly int $backupMinutes,
        // The place the access lines of the file hosts are read from, or `null` when the registry
        // sends the files itself and counts each download as it sends it.
        public readonly ?Store $downloadLog,
        // The format of the access lines. `bunny` is the only one: the folder of one pull zone in
        // Bunny's Permanent Log Storage, read from an `http` store. The lines of 4 March 2026 are
        // in the files `2026/03/04_*.gzip`.
        public readonly string $downloadFormat,
        // The file with the private key that signs the log and the index files.
        // `nvs registry key` makes one.
        public readonly string $logKey,
        // The name of the log, the first line of every checkpoint. It is the name of the key.
        public readonly string $logName,
        // The file with the private P-256 key that signs each Web Push message, or an empty string
        // for no Web Push. With no key, no push device can be added.
        public readonly string $pushKey,
        // The contact of the operator that each push service sees, a `mailto:` or `https:` URL.
        public readonly string $pushSubject,
        // The address of a second copy of the checkpoint on another host, such as
        // `https://mirror.example.org/registry.example.com/checkpoint`, or an empty string for none.
        // `nvs pkg audit` reads both copies and fails when they do not agree.
        public readonly string $checkpointCopy = '',
        // The purge API of the CDN in front of `hosts`, or `null` for none. A withheld archive is
        // then purged from the CDN. With none, the CDN may serve its copy until its cache lifetime ends.
        public readonly ?Purge $purge = null,
    )
    {}

    // Reads `hosting.json` from the folder above `src`. A relative path in it is relative to that folder.
    // It throws a `RuntimeError` that names the setting when one is missing or wrong,
    // and names the path when a file it names does not exist.
    public static function load(): Site
    {
        string $base = Path::thisDir('..');
        var $settings = Json::decode(IO::read('../hosting.json')) as array<mixed>;
        array<Store> $stores = [];
        var $listed = ($settings['stores'] ?? []) as array<mixed>;
        foreach ($listed as mixed $store) {
            $stores[] = Store::of($store as array<mixed>, $base, 'stores[' . Core\Arr::count($stores) . ']');
        }
        if (Core\Arr::count($stores) == 0) {
            throw new RuntimeError('hosting.json: `stores` must name at least one store.');
        }
        array<string> $hosts = Site::texts($settings['hosts'] as array<mixed>);
        if (Core\Arr::count($hosts) == 0 && Site::firstFolder($stores) == null) {
            throw new RuntimeError('hosting.json: with no `hosts`, the registry sends the files itself, so one of `stores` must be a `dir` store.');
        }
        ?Store $downloadLog = null;
        string $downloadFormat = '';
        if (($settings['downloadLog'] ?? null) != null) {
            var $source = $settings['downloadLog'] as array<mixed>;
            Store $logStore = Store::of($source, $base, 'downloadLog');
            $downloadLog = $logStore;
            $downloadFormat = Site::text($source, 'format', 'downloadLog');
            if ($downloadFormat != 'bunny') {
                throw new RuntimeError('hosting.json: `downloadLog.format` must be `bunny`.');
            }
            if ($logStore->kind != 'http') {
                throw new RuntimeError('hosting.json: `downloadLog` must be an `http` store, the folder of the pull zone in Bunny Storage.');
            }
        }
        return new Site(
            Site::text($settings, 'origin', ''),
            $settings['signUpWork'] as int,
            Site::text($settings, 'nvs', ''),
            Site::optionalPath(Site::text($settings, 'gitCaFile', ''), $base, 'gitCaFile'),
            Site::text($settings, 'projectAccount', ''),
            Path::join($base, Site::text($settings, 'work', '')),
            $stores,
            $hosts,
            Store::of($settings['backup'] as array<mixed>, $base, 'backup'),
            Site::optionalPath(Site::text($settings, 'backupKey', ''), $base, 'backupKey'),
            $settings['backupMinutes'] as int,
            $downloadLog,
            $downloadFormat,
            Site::optionalPath(Site::text($settings, 'logKey', ''), $base, 'logKey'),
            Site::text($settings, 'logName', ''),
            Site::optionalPath(Site::text($settings, 'pushKey', ''), $base, 'pushKey'),
            Site::text($settings, 'pushSubject', ''),
            Site::checkpointCopyOf($settings),
            Purge::of($settings, $base),
        );
    }

    // The setting `checkpointCopy`. It may be left out, and then there is no second copy.
    // Any other value must be an `https:` address.
    private static function checkpointCopyOf(array<mixed> $settings): string
    {
        if (($settings['checkpointCopy'] ?? null) == null) {
            return '';
        }
        string $copy = Site::text($settings, 'checkpointCopy', '');
        if ($copy != '' && Str::lower(Uri::tryParse($copy)?->scheme() ?? '') != 'https') {
            throw new RuntimeError('hosting.json: `checkpointCopy` must be an https: address.');
        }
        return $copy;
    }

    // The domain of the site, such as `registry.example.com`. A passkey belongs to this domain.
    public function domain(): string
    {
        return Str::lower(Uri::parse($this->origin)->host() ?? '');
    }

    // The address of the signed advisory feed: on the first file host, or on this site when there is none.
    public function feed(): string
    {
        return Core\Arr::count($this->hosts) == 0 ? '/log/advisories' : Str::trimEnd($this->hosts[0], { characters: '/' }) . '/log/advisories';
    }

    // The first `dir` store. The registry sends the files from it when `hosts` is empty.
    public function folder(): ?Store
    {
        return Site::firstFolder($this->stores);
    }

    // The text setting `$key` of `$settings`. `$where` is the object it is in, such as `backup`.
    public static function text(array<mixed> $settings, string $key, string $where): string
    {
        mixed $value = $settings[$key] ?? null;
        if (!($value is string)) {
            string $name = $where == '' ? $key : $where . '.' . $key;
            throw new RuntimeError('hosting.json: `' . $name . '` must be a text.');
        }
        return Core\Taint::assertTrusted($value as tainted string, 'the operator wrote hosting.json');
    }

    // The full path of a file with a secret, such as a credential or a key.
    // It throws a `RuntimeError` that names the path when there is no file at it.
    public static function secretPath(string $path, string $base, string $name): string
    {
        string $full = Path::isAbsolute($path) ? $path : Path::join($base, $path);
        if (!IO::isFile($full)) {
            throw new RuntimeError('hosting.json: `' . $name . '` names ' . $full . ', and there is no file at that path.');
        }
        return $full;
    }

    // An empty path stays empty. Any other path must name a file.
    private static function optionalPath(string $path, string $base, string $name): string
    {
        return $path == '' ? '' : Site::secretPath($path, $base, $name);
    }

    private static function firstFolder(array<Store> $stores): ?Store
    {
        foreach ($stores as Store $store) {
            if ($store->kind == 'dir') {
                return $store;
            }
        }
        return null;
    }

    private static function texts(array<mixed> $list): array<string>
    {
        array<string> $texts = [];
        foreach ($list as mixed $item) {
            $texts[] = Core\Taint::assertTrusted($item as tainted string, 'the operator wrote hosting.json');
        }
        return $texts;
    }
}
