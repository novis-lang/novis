<?nvs
namespace Registry;

use Core\Arr;
use Core\Db\Connection;
use Core\Db\Row;
use Core\Db\Transaction;
use Core\IO;
use Core\Json;
use Core\Str;
use Core\Time;
use RuntimeError;

// Writes the files that `nvs pkg` reads: `registry.json`, one index file per package and one
// archive per version. A release is added to the log before an index file lists it.
final class Index
{
    private Connection $db;
    private Log $log;
    private Site $site;

    public function constructor(Connection $db, Log $log, Site $site)
    {
        $this->db = $db;
        $this->log = $log;
        $this->site = $site;
    }

    // Returns the work folder, where the public files are made and signed. It is made when it does not exist.
    public static function work(Site $site): string
    {
        if (!IO::isDir($site->work)) {
            IO::makeDir($site->work);
        }
        return IO::canonicalize($site->work);
    }

    // Adds every release of the package `$key` that is not in the log yet, such as `acme\http`.
    // Each archive is copied first. Then the releases are added to the log, the index file and
    // `registry.json` are written and signed, and every new file is sent to the stores.
    // It returns `false` when a step fails. A release that is not in the log yet is added the next
    // time this runs for its package, and a file that a store does not have is sent again then.
    // Memory: one archive at a time while it is sent to a store.
    public function catchUp(string $key): bool
    {
        string $folder = Index::work($this->site);
        var $stores = new Stores($this->db, $this->site);
        try {
            return $this->db->transaction(fn(Transaction $tx): bool => {
                // This statement writes, so the transaction has the write lock of the database
                // from here on. Two publishes add to the log and send to the stores one after the other.
                // Other requests that write wait until the stores have the files.
                $tx->execute('update releases set log = log where package = ? and log is null', [$key]);
                var $rows = $tx->query(
                    'select version, digest, git_commit, archive from releases where package = ? and log is null order by published_at, major, minor, patch',
                    [$key],
                );
                string $repository = $this->repositoryOf($key);
                int $next = $this->log->size();
                string $lines = '';
                foreach ($rows as Row $row) {
                    string $version = Index::trusted($row->string('version'));
                    string $digest = Index::hexOf(Index::trusted($row->string('digest')));
                    IO::makeDir($folder . '/archive');
                    IO::copy(Index::trusted($row->string('archive')), $folder . '/archive/' . $digest . '.tar');
                    $stores->queue('archive/' . $digest . '.tar', Stores::ARCHIVE);
                    $lines .= Index::trusted(Json::encode({
                        v: 1,
                        kind: 'publish',
                        package: Index::slug($key),
                        version: $version,
                        digest: $digest,
                        repository: $repository,
                        commit: Index::trusted($row->string('git_commit')),
                    })) . "\n";
                    $tx->execute('update releases set log = ? where package = ? and version = ?', [$next, $key, $version]);
                    $next++;
                }
                if ($lines != '') {
                    ?array<string> $written = $this->log->append($lines);
                    if ($written == null) {
                        // Nothing was added, so the numbers above are undone with the transaction.
                        throw new RuntimeError('the log did not add the releases');
                    }
                    foreach ($written as string $path) {
                        $stores->queue('log/' . $path, $path == 'checkpoint' ? Stores::CHECKPOINT : Stores::LOG);
                    }
                }
                // The log has the releases now, so the transaction must keep their numbers.
                // So a failure below returns `false` and does not throw, and the next run sends again.
                try {
                    // `sign` signs every index file, and only the files of this package changed.
                    // The daily run sends every index file.
                    $stores->queue($this->write($key, $folder), Stores::INDEX);
                    $this->sign($folder, $stores);
                } catch (RuntimeError $error) {
                    return false;
                }
                return $stores->send();
            });
        } catch (RuntimeError $error) {
            return false;
        }
    }

    // Runs once a day, from `jobs/daily.nvs`. It adds every release that is not in the log yet.
    // Then it writes every index file again, signs every file, and sends every index file and
    // `registry.json` to every store. So a version whose seven days have passed is released.
    // It returns `false` when a step fails. The next run does every step again.
    // Memory: one index file at a time.
    public function daily(): bool
    {
        array<string> $waiting = [];
        foreach ($this->db->query('select distinct package from releases where log is null', []) as Row $row) {
            $waiting[] = Index::trusted($row->string('package'));
        }
        bool $done = true;
        foreach ($waiting as string $key) {
            if (!$this->catchUp($key)) {
                $done = false;
            }
        }
        string $folder = Index::work($this->site);
        var $stores = new Stores($this->db, $this->site);
        try {
            bool $sent = $this->db->transaction(fn(Transaction $tx): bool => {
                // This statement writes, so the transaction has the write lock of the database,
                // as in `catchUp`. A publish waits until the stores have the files.
                $tx->execute('update releases set log = log where log is null', []);
                foreach ($tx->query('select distinct package from releases where log is not null order by package', []) as Row $row) {
                    $stores->queue($this->write(Index::trusted($row->string('package')), $folder), Stores::INDEX);
                }
                $this->sign($folder, $stores);
                return $stores->send();
            });
            return $done && $sent;
        } catch (RuntimeError $error) {
            return false;
        }
    }

    // Writes `registry.json`, signs it and every index file, and adds `registry.json` to the files to send.
    // It throws a `RuntimeError` when a step fails.
    private function sign(string $folder, Stores $stores): void
    {
        IO::write($folder . '/registry.json', Json::encode({ schema: 1, hosts: $this->site->hosts }));
        if (!$this->log->sign(Time::now()->toEpochSeconds())) {
            throw new RuntimeError('the index files could not be signed');
        }
        $stores->queue('registry.json', Stores::INDEX);
    }

    // Writes the index file of the package `$key`, before it is signed.
    // It returns its path in the work folder, such as `index/acme/http.json`.
    private function write(string $key, string $folder): string
    {
        string $name = '';
        foreach ($this->db->query('select name, vendor from packages where key = ?', [$key]) as Row $row) {
            $name = Index::trusted($row->string('name'));
        }
        array<string> $owners = [];
        var $rows = $this->db->query('select account from owners where vendor = ? order by account', [Str::lower(Str::before($key, '\\') ?? '')]);
        foreach ($rows as Row $row) {
            $owners[] = Index::trusted($row->string('account'));
        }
        string $repository = $this->repositoryOf($key);
        array<Listed> $versions = [];
        $rows = $this->db->query(
            'select version, digest, pending_until, dependencies, capabilities, git_commit, log from releases '
                . 'where package = ? and log is not null order by major, minor, patch',
            [$key],
        );
        foreach ($rows as Row $row) {
            $versions[] = new Listed(
                Index::trusted($row->string('version')),
                Index::hexOf(Index::trusted($row->string('digest'))),
                $row->int('pending_until'),
                Index::trusted($row->string('dependencies')),
                Index::trusted($row->string('capabilities')),
                $repository,
                Index::trusted($row->string('git_commit')),
                $row->int('log') ?? 0,
            );
        }
        string $path = 'index/' . Index::slug($key) . '.json';
        IO::makeDir($folder . '/index/' . Index::slug(Str::before($key, '\\') ?? $key));
        IO::write($folder . '/' . $path, Index::document($name, $owners, $versions, Time::now()->toEpochSeconds()));
        return $path;
    }

    // Returns the text of one index file before it is signed. `$now` is the time in seconds since 1970.
    // A version whose pending time has passed is released.
    public static function document(string $name, array<string> $owners, array<Listed> $versions, int $now): string
    {
        array<mixed> $lines = [];
        foreach ($versions as Listed $listed) {
            mixed $state = 'released';
            if ($listed->pendingUntil != null && $listed->pendingUntil > $now) {
                $state = { pending: ['selectable_at' => $listed->pendingUntil] };
            }
            $lines[] = {
                version: $listed->version,
                digest: $listed->digest,
                state: $state,
                dependencies: Index::objectOf($listed->dependencies),
                capabilities: Index::objectOf($listed->capabilities),
                repository: $listed->repository,
                commit: $listed->commit,
                log: $listed->log,
            };
        }
        return Index::trusted(Json::encode({ schema: 1, name: $name, owners: $owners, versions: $lines }));
    }

    private function repositoryOf(string $key): string
    {
        foreach ($this->db->query('select repository from packages where key = ?', [$key]) as Row $row) {
            return Index::trusted($row->string('repository'));
        }
        return '';
    }

    // The path of a package in the index, such as `acme/http` for `acme\http`.
    public static function slug(string $key): string
    {
        return Str::replace(Str::lower($key), '\\', '/');
    }

    // The digest as 64 hex characters, without the `blake3:` that the build writes.
    private static function hexOf(string $digest): string
    {
        return Str::startsWith($digest, 'blake3:') ? Str::slice($digest, 7) : $digest;
    }

    // JSON text from the database as a value. An empty map stays a JSON object.
    private static function objectOf(string $json): mixed
    {
        mixed $value = Json::decode($json);
        if (Arr::count($value as array<mixed>) == 0) {
            return {};
        }
        return $value;
    }

    // A text from a row the registry wrote.
    private static function trusted(mixed $value): string
    {
        return Core\Taint::assertTrusted($value as tainted string, 'the registry wrote this text');
    }
}
