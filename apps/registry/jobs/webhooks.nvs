<?nvs
// Sends the messages to the owners that no request sent yet, and the webhook messages that failed.
// The `[[schedule]]` block in `nvs.toml` runs it every minute.
autoload 'Registry' from '../src';

var $db = Registry\Schema::open();
var $site = Registry\Site::load();
Registry\Notices::ofSite($db, $site)->send();
new Registry\Webhooks($db, $site->origin)->retry();
