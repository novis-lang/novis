<?nvs
namespace Chat;

// The chat rooms. A visitor can only join a room from this list.
final class Rooms
{
    // The name of each room in the address, and the title that the page shows.
    public static function all(): array<string>
    {
        return ['lobby' => 'Lobby', 'help' => 'Help', 'random' => 'Random'];
    }

    // Returns the room with this name, or `null` when there is no such room.
    // The result comes from the list above and not from the request, so it is not `tainted`.
    public static function find(tainted string $asked): ?string
    {
        foreach (Rooms::all() as string $room => string $title) {
            if ($room == $asked) {
                return $room;
            }
        }
        return null;
    }

    // Returns the title of a room, such as `Lobby`.
    public static function title(string $room): string
    {
        return Rooms::all()[$room] ?? $room;
    }

    // Returns the topic of a room. Every connection in the room subscribes to it.
    // A topic name cannot be `tainted`, so a visitor can never choose a topic.
    public static function topic(string $room): string
    {
        return 'room:' . $room;
    }
}
