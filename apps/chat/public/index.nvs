<?nvs
// This is the entry file. `nvs serve public/index.nvs` runs it once for each request.
// The `autoload` line reads each class `Chat\...` from the folder `src`.
autoload 'Chat' from '../src';

// `dispatch` finds the route for the request and calls its method.
// `Chat\Gate` decides if the method may run, and it shows the error pages.
Core\Router::dispatch(new Chat\Gate());
