      ["--check"]
    ]
  },
  "records": {
    "python": ["python", "tools/records.py"],
    "nv": ["bun", "tools/nv/main.ts", "records"],
    "unordered": {
      "pattern": "^  \\d{4}\\s+\\d+ inbound$|^    [a-z0-9-]+/[a-z0-9-]+ +(also shaped by |no other record|created by )",
      "why": "Python breaks a tie among the most-cited records in set-hash order, which changes from run to run. nv breaks it by number. And `--graph` lists a record's rules in the order its prose front matter wrote them, which nv does not read: it derives them from the rules' `because` lists and lists them by id."
    },
    "cases": [
      [],
      ["--graph", "0066"],
      ["--graph", "0134"],
      ["--graph", "0205"],
      ["--graph", "9999"],
      ["--check"],
      ["--only", "links"],
      ["--only", "structure", "--only", "section refs"],
      ["--only", "no-such-check"],
      ["--residue"],
      ["--stats"],
      ["--orphans"]
    ]
  }
}
