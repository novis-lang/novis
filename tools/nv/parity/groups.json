{
  "bench": {
    "python": ["python", "tools/bench.py"],
    "nv": ["bun", "tools/nv/main.ts", "bench"],
    "cases": [
      ["--bogus"],
      ["--reps", "x"],
      ["--reps"],
      ["--re", "3"],
      ["--max", "3"],
      ["--php-mode", "x"],
      ["--serve-baseline", "x"],
      ["--max-work-ms", "x"],
      ["a", "--check", "b"],
      ["--max-ms", "10"],
      ["--reps", "0"],
      ["--nvs", "nosuch.exe"],
      ["--nvs", "target/debug/nvs.exe", "--warm-start"],
      ["--nvs", "target/debug/nvs.exe", "--allow-debug", "--record", "x.json"],
      ["--nvs", "target/debug/nvs.exe", "--allow-debug", "--max-work-ms", "5"],
      ["--nvs", "target/debug/nvs.exe", "--allow-debug", "--engines", "nvs,bogus"],
      ["--nvs", "target/debug/nvs.exe", "--allow-debug", "--engines", "php"],
      ["--nvs", "target/debug/nvs.exe", "--allow-debug", "--check", "--engines", "nvs,php", "zzz"],
      ["--nvs", "target/debug/nvs.exe", "--allow-debug", "--check", "--engines", "nvs,php", "01", "03"]
    ]
  },
  "db-matrix": {
    "python": ["python", "tools/db-matrix.py"],
    "nv": ["bun", "tools/nv/main.ts", "db-matrix"],
    "sequential": "Both programs run `cargo test` over the one target directory, and cargo's lock on it would make one wait for the other anyway.",
    "cases": [
      ["--list"],
      ["--driver", "sqlite", "--list"],
      ["--driver", "postgres", "--driver=postgres", "--dr", "mssql", "--list"],
      ["--all", "--driver", "sqlite", "--list"],
      ["--driver", "nosuch"],
      ["--driver"],
      ["--d", "sqlite"],
      ["--bogus"],
      ["--driver", "sqlite"]
    ]
  },
  "disk": {
    "python": ["python", "tools/disk.py"],
    "nv": ["bun", "tools/nv/main.ts", "disk"],
    "cases": [
      [],
      ["--clean"],
      ["--clean", "-n"],
      ["--clean", "--dry-run", "--grace-hours", "0"],
      ["--bogus"],
      ["--keep"],
      ["--keep-runs", "abc"],
      ["--grace-hours"],
      ["--grace-hours=x1"],
      ["--scratch", "3", "extra"]
    ]
  },
  "peek": {
    "python": ["python", "tools/peek.py"],
    "nv": ["bun", "tools/nv/main.ts", "peek"],
    "cases": [
      ["--quiet", "tools/peek.py:1-5"],
      ["tools/peek.py:@locate", "tools/nv/main.ts"],
      ["tools/peek.py:120+3", "tools/peek.py:re:def (out|rel)\\b", "tools/peek.py:nosuchheading", "no/such/file.rs"],
      ["AGENTS.md:## The priority ordering", "docs/agent/conventions.md:\"## A code comment\""],
      ["tools/*.py:re:^ROOT = :1", "tools/nv/**/*.ts:@NoSuchSymbolAnywhere"],
      ["rule:testing/feature-proofs", "`rule:types/no-such-rule`"],
      ["tools/peek.py", "tools/peek.py:/^DEFAULT_/1"],
      ["--context", "1", "tools/peek.py:re:^DEFAULT_", "tools/peek.py:re:^BYTES_PER_TOKEN:0"],
      ["--window", "3", "tools/bench.py:@discover"],
      ["--max-lines", "40", "tools/nv/main.ts"],
      ["--locate", "discover", "DEFAULT_WINDOW", "NoSuchSymbolAnywhere"],
      ["--locate", "rel", "Index"],
      ["--locate", "rel", "--in", "tools/nv/**/*.ts"],
      ["--outline", "tools/peek.py", "tools/bench.py"],
      ["--deep", "--outline", "crates/nvs-host/src/watchdog.rs", "tools/nv/cmd/*.ts"],
      ["--outline", "no/such.rs"]
    ]
  }
}
