    "python": ["python", "tools/owners.py"],
    "nv": ["bun", "tools/nv/main.ts", "owners"],
    "unordered": {
      "pattern": "^  crates/\\S+  gap # ",
      "why": "Python lists a module's gaps in the order its doc writes them. A gap record carries no position, so nv lists them by slug."
