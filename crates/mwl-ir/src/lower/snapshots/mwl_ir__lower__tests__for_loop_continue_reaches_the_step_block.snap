    ; stmt s0 @4:5-4:19
    v2 = const.int 0  ; int
    ; stmt s1 @5:5-5:16
    v3 = const.int 0  ; int
    ; stmt s2 @6:5-11:6
    v4 = const.int 0  ; int
    jump bb1
  bb1:
    v5 = phi [bb0: v2, bb3: v12]  ; int
    v6 = phi [bb0: v4, bb3: v14]  ; int
    v7 = lt v6, v1  ; bool
    branch v7 -> bb2 (e0), bb4 (e1)
  bb2:
    ; stmt s3 @6:36-11:6
