  bb1:
    v5 = phi [bb0: v2, bb3: v8]  ; int
    v6 = phi [bb0: v4, bb3: v10]  ; int
    v7 = lt v6, v1  ; bool
    branch v7 -> bb2 (e0), bb4 (e1)
  bb2:
    ; stmt s3 @6:36-8:6
