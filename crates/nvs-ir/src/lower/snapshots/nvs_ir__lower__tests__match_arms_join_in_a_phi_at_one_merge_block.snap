fn name(object, int) -> string {
  bb0:
    v0 = param 0  ; object
    v1 = param 1  ; int
    safepoint
    ; stmt s0 @4:5-7:7
    v2 = const.int 1  ; int
    v3 = eq v1, v2  ; bool
    branch v3 -> bb2 (e0), bb5 (e1)
  bb1:
    release v0
    propagate "name() at t.nvs:1"
  bb2:
    v6 = const.str "low"  ; string
    jump bb4
  bb3:
    v7 = const.str "high"  ; string
    jump bb4
  bb4:
    v8 = phi [bb2: v6, bb3: v7]  ; string
    release v0
    return v8
  bb5:
    v4 = const.int 2  ; int
    v5 = eq v1, v4  ; bool
    branch v5 -> bb2 (e2), bb6 (e3)
  bb6:
    jump bb3
}
