fn m(object, bool, int, int) -> int {
  bb0:
    v0 = param 0  ; object
    v1 = param 1  ; bool
    v2 = param 2  ; int
    v3 = param 3  ; int
    safepoint
    ; stmt s0 @4:5-4:25
    branch v1 -> bb2 (e0), bb3 (e1)
  bb1:
    release v0
    propagate "m() at t.nvs:1"
  bb2:
    jump bb4
  bb3:
    jump bb4
  bb4:
    v4 = phi [bb2: v2, bb3: v3]  ; int
    release v0
    return v4
}
