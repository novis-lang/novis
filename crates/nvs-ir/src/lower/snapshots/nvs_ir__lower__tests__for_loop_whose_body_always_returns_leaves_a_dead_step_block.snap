    jump bb1
  bb1:
    v4 = phi [bb0: v3, bb3: v3]  ; int
    v5 = lt v4, v1  ; bool
    branch v5 -> bb2 (e0), bb4 (e1)
  bb2:
    ; stmt s2 @5:36-7:6
    ; stmt s3 @6:7-6:17
    release v0
    return v4
  bb3:
