<?nvs
// The request opens an event stream running `Feed::run`, which greets the
// client, forwards what is published on `news`, and says when the client left.

class Feed {
    public static function run(string $who): void {
        Core\Sse $sse = Core\Sse::current();
        $sse->send("hello " . $who);
        Core\Topic::subscribe("news");
        ?Core\Sse\Message $message = $sse->receive();
        while ($message != null) {
            $sse->send($message->value() as string, event: "news");
            $message = $sse->receive();
        }
        echo "client left\n";
    }
}

Core\Sse::upgrade(Feed::run(...), args: ["who" => "ada"]);
