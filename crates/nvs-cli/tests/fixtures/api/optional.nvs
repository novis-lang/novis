<?nvs
// [base.nvs](base.nvs) with one `#[Query]` parameter added to `Items::index`,
// carrying a default — `rule:routing/a-query-parameter-is-declared-like-a-capture` makes that the declaration saying the key
// may be absent, so the document calls it optional and `nvs api diff` calls
// adding it compatible.

class Items
{
    #[Core\Route(path: '/items', method: Core\Http\Method::Get, name: 'Items::index')]
    #[Core\Access(allow: Core\Audience::Public)]
    public function index(#[Core\Query] string $sort = 'name'): string
    {
        return 'every item by ' . $sort;
    }

    #[Core\Route(path: '/items/{id}', method: Core\Http\Method::Get, name: 'Items::show')]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(uint $id): string
    {
        return 'item ' . $id;
    }
}

echo 'GET /items -> Items::index', "\n";
