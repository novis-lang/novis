<?nvs
// ADR 0079 § 17, as the runner sees it: a `#[Test(db: "test")]` method runs
// inside a transaction the runner opened before it and rolls back after it, so
// the test writes no cleanup code and the next test sees a pristine database.
//
// Four cases, in declaration order, because the claim cannot be made by one.
// The two that name no `db:` run under no transaction at all and so commit what
// they write — they are the ground truth the two in the middle are measured
// against, and they are also the other half of the claim: a runner that opened
// a transaction for *every* test would roll the table away and the second case
// would fail to find it.
//
// The table is this fixture's own and is dropped again at the end, so a run
// leaves the database exactly as it found it. `[db.test]` is built in Rust by
// `crates/nvs-cli/src/runner.rs`'s own test — there is no `nvs.toml` beside a
// fixture — and points at the same compose PostgreSQL `nvs.toml`'s `[db.main]`
// does.

use Core\Db;
use Core\Db\Transaction;

class Rows {
    // § 6's typed reader answers `?T`, a `null` being a NULL column, so the
    // unwrap happens once here rather than at each of the four places below.
    public static function count(Core\Db\Connection $db): int {
        var $row = $db->query("select count(*) as n from nvs_test_db_rollback", [])->first();
        if ($row == null) {
            return -1;
        }
        var $n = $row->int("n");
        if ($n == null) {
            return -1;
        }
        return $n;
    }

    // Whether the table is there at all, which is a different question from how
    // many rows it holds — the last case has nothing to count and still has
    // something to assert (ADR 0079 § 20).
    public static function tables(Core\Db\Connection $db): int {
        var $row = $db->query(
            "select count(*) as n from information_schema.tables where table_name = 'nvs_test_db_rollback'",
            []
        )->first();
        if ($row == null) {
            return -1;
        }
        var $n = $row->int("n");
        if ($n == null) {
            return -1;
        }
        return $n;
    }
}

class Rollback {
    // No `db:`, so no transaction: what this writes is committed and is still
    // there for the two cases below. It is also the drop-and-create, so a run
    // that ended badly last time starts from the same place this one does.
    #[Core\Test]
    public function itPreparesATableOutsideAnyTransaction(): void {
        var $db = Db::connect("test");
        $db->execute("drop table if exists nvs_test_db_rollback", []);
        $db->execute("create table nvs_test_db_rollback (id integer primary key)", []);
        Core\Test::assertEquals(Rows::count($db), 0);
    }

    // The write half. Everything here happens inside the runner's transaction,
    // including the nested one — § 17's second sentence — so the `rollBack`
    // below undoes its own `SAVEPOINT` and leaves the row written above it.
    #[Core\Test(db: "test")]
    public function itWritesInsideTheRunnersTransaction(): void {
        var $db = Db::connect("test");
        $db->execute("insert into nvs_test_db_rollback (id) values (1)", []);
        Core\Test::assertEquals(Rows::count($db), 1);

        try {
            $db->transaction(fn (Transaction $tx): void => {
                $tx->execute("insert into nvs_test_db_rollback (id) values (2)", []);
                $tx->rollBack("the savepoint is undone and the row above it is not");
            });
        } catch (Core\Db\RolledBack $rolled) {
            // Expected: `rollBack` throws out of the owning `transaction()`.
        }
        // 1 and not 0: the nested rollback reached its savepoint and stopped
        // there. A runner that had opened no outer transaction would have made
        // that nested call a real `BEGIN`, and this line would still read 1 —
        // which is why the case below is the one that decides it.
        Core\Test::assertEquals(Rows::count($db), 1);
    }

    // The rollback half, and the assertion the whole fixture exists for: the
    // row the case above wrote is gone, with no cleanup written anywhere.
    #[Core\Test(db: "test")]
    public function itSeesNothingTheLastTestWrote(): void {
        var $db = Db::connect("test");
        Core\Test::assertEquals(Rows::count($db), 0);
    }

    // No `db:` again, so this commits — which is what makes the fixture leave
    // nothing behind.
    #[Core\Test]
    public function itDropsTheTableOutsideAnyTransaction(): void {
        var $db = Db::connect("test");
        $db->execute("drop table if exists nvs_test_db_rollback", []);
        Core\Test::assertEquals(Rows::tables($db), 0);
    }
}
