<?nvs
// `rule:testing/mutation-testing`'s four outcomes. The runner's test finds each
// mutant by the comment at the end of its line.
//
// `crates/nvs-cli/src/runner/mutation.rs`'s own tests are the only reader of this file.
use Core\Test;

final class Counter
{
    public static function atLeast(int $value, int $floor): bool
    {
        return $value >= $floor; // survives
    }

    public static function sum(int $a, int $b): int
    {
        return $a + $b; // killed
    }

    public static function countTo(int $n): int
    {
        var $i = 0;
        while ($i < $n) {
            $i = $i + 1; // times out
        }
        return $i;
    }

    public static function previous(int $a): int
    {
        return $a - 1; // not reached
    }
}

final class CounterTest
{
    #[Test]
    public function itComparesFarFromTheBoundary(): void
    {
        Test::assertTrue(Counter::atLeast(10, 3));
    }

    #[Test]
    public function itAdds(): void
    {
        Test::assertSame(Counter::sum(2, 3), 5);
    }

    #[Test]
    public function itCounts(): void
    {
        Test::assertSame(Counter::countTo(3), 3);
    }
}
