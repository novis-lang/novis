<?nvs
// `rule:testing/in-process-request`'s second mechanism, as the runner sees it: a `#[Test(server:
// true)]` method is given a real listener on a port the operating system chose,
// and reaches this same program over the wire.
//
// The top level is the entry, so it runs once when the suite is loaded — with
// no request in front of it — and once per request the listener accepts.
// `Core\Env::context()` is what tells those apart: it is `Request` only in the
// run that answers one (`rule:core-classes/env-context`). This program declares
// no `#[Route]`, so a real request matches nothing and still gets an answer,
// which is `rule:routing/the-servers-match-dispatches-nothing`.
class Wire
{
    #[Core\Test(server: true)]
    public function itReachesItsOwnListenerOverTheWire(): void
    {
        var $url = Core\Test::serverUrl();
        Core\Test::assertTrue($url != null);
        if ($url == null) {
            return;
        }
        // A real socket, a real request line and a real response head — which is
        // the whole of why `rule:testing/in-process-request` has two mechanisms rather than one.
        var $answered = Core\Http\Client::get($url);
        Core\Test::assertEquals($answered->status(), 200);
        Core\Test::assertEquals($answered->text(), 'on the wire');
    }

    #[Core\Test]
    public function itHasNoListenerWithoutTheOption(): void
    {
        // `rule:testing/isolate-per-test`'s boundary, stated on the address: a sibling that asked for no
        // listener cannot read the port the test above bound, because the URL
        // is on that test's own context and not on the process.
        Core\Test::assertNull(Core\Test::serverUrl());
    }
}

// The suite's own load has nothing to answer, so it writes nothing.
if (Core\Env::context() == Core\Env::Context::Request) {
    var $matched = Core\Request::route();
    if ($matched == null) {
        echo 'on the wire';
    } else {
        echo 'routed';
    }
}
