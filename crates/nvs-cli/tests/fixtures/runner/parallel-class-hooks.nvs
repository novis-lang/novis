<?nvs
// `rule:testing/class-hooks`'s order while the tests run at once: each hook and
// test prints the microsecond it reached a point, and the runner's test reads
// the printed instants back. Both tests fail on purpose, because a failing
// test's output is the output the report prints.
//
// Each test sleeps a second. A machine running other test binaries can start a
// posted test half a second late, and a shorter window then reads as the two
// tests running one after another.
//
// `crates/nvs-cli/src/runner.rs`'s own tests are the only reader of this file.
use Core\Test;
use Core\Test\AfterClass;
use Core\Test\BeforeClass;
use Core\Time;

final class HookOrderTest
{
    #[BeforeClass]
    public static function prepare(): void
    {
        Time::sleep(200ms);
        echo 'before-class-returned ', Time::now()->toEpochMicros(), "\n";
    }

    #[Test]
    public function itRunsBesideItsSibling(): void
    {
        echo 'test-started ', Time::now()->toEpochMicros(), "\n";
        Time::sleep(1s);
        echo 'test-ended ', Time::now()->toEpochMicros(), "\n";
        Test::assertSame(1, 2);
    }

    #[Test]
    public function itRunsBesideItsSiblingToo(): void
    {
        echo 'test-started ', Time::now()->toEpochMicros(), "\n";
        Time::sleep(1s);
        echo 'test-ended ', Time::now()->toEpochMicros(), "\n";
        Test::assertSame(1, 2);
    }

    #[AfterClass]
    public static function cleanUp(): void
    {
        echo 'after-class-started ', Time::now()->toEpochMicros(), "\n";
    }
}
