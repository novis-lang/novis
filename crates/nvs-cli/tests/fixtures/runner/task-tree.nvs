<?nvs
// ADR 0079 § 16, from the language surface: the runner owns the test's task
// tree. The first test asks whether there is a calling task at all — a
// `Core\Task::all` with no task beneath it has nowhere to put its children —
// and the second leaves one running on purpose, which § 16 fails and names.
//
// The child path is written from `crates/nvs-cli`, which is where `cargo test`
// runs this crate from and where a relative `spawn script` path is anchored
// (`crates/nvs-cli/src/script.rs`). `crates/nvs-cli/src/runner.rs`'s own tests
// are the only reader of this file.
use Core\Task;
use Core\Test;

final class TaskTreeTest {
    #[Test]
    public function itRunsInsideATaskOfTheRunners(): void {
        var $answers = Task::all({
            first:  fn(): int => 1,
            second: fn(): int => 2,
        });
        Test::assertSame($answers->first + $answers->second, 3);
    }

    #[Test]
    public function itLeavesAnUnawaitedChildRunning(): void {
        var $orphan = spawn script 'tests/fixtures/runner/task-tree-child.nvs';
        // The one assertion the ledger needs, so that the only thing this test
        // is reported for is the child it never awaited.
        Test::assertTrue(true);
    }
}
