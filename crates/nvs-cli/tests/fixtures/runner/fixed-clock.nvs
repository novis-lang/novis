<?nvs
// ADR 0079 § 12, from the language surface: a fixed clock is per test. The
// first test reads the instant its own `at:` names; the second advances that
// reading and reads back the moved clock; the third declares no `at:` at all
// and so reads the host's. The third is the one that makes this a claim about
// the *isolate* rather than about the runner — a clock fixed anywhere above
// the isolate would pass the first two and fail it.
//
// `crates/nvs-cli/src/runner.rs`'s own tests are the only reader of this file.
use Core\Test;
use Core\Time;

final class FixedClockTest {
    #[Test(at: "2026-01-01T00:00:00Z")]
    public function itReadsTheClockItDeclared(): void {
        Test::assertSame(Time::now()->toIso(), "2026-01-01T00:00:00Z");
    }

    #[Test(at: "2026-01-01T00:00:00Z")]
    public function itReadsTheClockItAdvanced(): void {
        Test::advance(2h);
        Test::assertSame(Time::now()->toIso(), "2026-01-01T02:00:00Z");
    }

    #[Test]
    public function itReadsTheHostClockWithoutAnAt(): void {
        // Any instant after 2023 — the assertion is that this is *not* the
        // sibling's 2026 reading and not a zero one, so an exact number would
        // be a stronger claim than the runner can make about a real clock.
        Test::assertTrue(Time::now()->toEpochSeconds() > 1700000000);
    }
}
