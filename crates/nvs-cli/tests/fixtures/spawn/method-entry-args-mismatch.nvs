<?nvs
// `rule:security/isolate-shares-nothing`: a name `args:` holds that the entry does not declare,
// or a parameter it omits, is the ordinary named-argument error — reported at
// the spawn when the map is not a literal the compiler compared. Nothing is
// started, so this program dies where the spawn is written.
class Reports
{
    public static function monthly(int $month): int {
        return $month;
    }
}

var $job = spawn script Reports::monthly(...) with(args: ["moth" => 7]);
var $result = await $job;

echo "unreachable\n";
