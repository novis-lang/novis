<?nvs
// ADR 0006 § *Decision* binds `args:`'s entries to the entry's parameters as
// named arguments. That half is not compiled yet, and the child would call this
// method with no arguments at all — so the spawn is refused where it is
// written rather than accepted and given a different meaning.
class Reports
{
    public static function monthly(int $month): int {
        return $month;
    }
}

var $job = spawn script Reports::monthly(...) with(args: ["month" => 7]);
