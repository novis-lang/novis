<?nvs
// The pool has a ceiling, and a request that arrives at it waits before it is
// refused.
//
// [ADR 0067](/docs/decisions/0067.md) § 13 sizes a pool per core: `max` is
// how many connections one core may hold open under a block — so a
// deployment's ceiling on the server is `cores × max`, which is the number an
// operator sizes `max_connections` against — and `acquire` is how long a
// request that finds them all held waits for one to come free before it throws
// rather than hanging. `[db.tight]` in `nvs.toml` is a block written around
// that pair, `max = 1` and a short `acquire`, so this program reaches both
// bounds in under a second.
//
// **The wait is the half worth pinning, and it is a park.** A ceiling that
// refused on sight would print the same refusal, so the elapsed time is what
// separates those two: the second `connect` is answered no earlier than
// `acquire` after it asked. What elapsed time alone cannot tell apart is a
// *park* from a spin, and the last block below does: the wait happens inside a
// `Core\Task` child while a sibling task does three sleeps' worth of work
// beside it, so a wait that held the core would take the two in sequence and
// this program would print how long it took instead of the verdict.
//
// **Both elapsed readings below are `Core\Time::monotonic`.** Each is measured
// against a deadline the pool holds on the monotonic clock, and a wall clock is
// entitled to step under a wait that really elapsed — so `Core\Time::now` here
// could report a wait shorter than `acquire` and accuse the pool of refusing on
// sight. That is what `Core\Time::monotonic` answering a `Duration` rather than
// an instant is for: it is comparable with another reading of itself and with
// nothing else.
//
// The four lines this prints are frozen in `docs/agent/loop-goal.toml`; the
// source is not. `[db.tight]` is its own block and so its own pool, and
// `examples/db.nvs`'s `[db.main]` is reached by nothing here.

use Core\Db;
use Core\Db\Connection;

class Ceiling
{
    // The verdict as one line, so that a failure says which half failed rather
    // than printing a `false` three ways. `$waited` is milliseconds and 500 is
    // `[db.tight.pool] acquire` — the fixture reads the bound it was written
    // against, and a config that lowers it makes this line say so.
    public static function verdict(int $waited, bool $acquire, bool $ceiling): string
    {
        if ($waited < 500) {
            return 'refused after only ' . $waited . 'ms, which is inside `acquire`';
        }
        if (!$acquire) {
            return 'waited, and then refused without naming `acquire`';
        }
        if (!$ceiling) {
            return 'waited, and then refused without naming the ceiling it reached';
        }
        return 'waited `acquire` out, and named it';
    }

    // The park half's verdict, on the same one-line principle. `$beside` is how
    // many sleeps the sibling task got through, `$blocked` what the waiting
    // child ended with, and `$elapsed` the whole `Core\Task::all` in
    // milliseconds — 500 of `acquire` and 300 of sibling work, which a park
    // overlaps and a spin adds up.
    public static function park(int $elapsed, string $blocked, int $beside): string
    {
        if ($blocked != 'refused') {
            return 'a child opened a second connection, which `max = 1` forbids';
        }
        if ($beside != 3) {
            return 'the sibling task did not finish beside the wait';
        }
        if ($elapsed < 500) {
            return 'the child was refused inside `acquire`, so nothing waited';
        }
        if ($elapsed >= 800) {
            return 'the wait held the core: ' . $elapsed . 'ms is 500 then 300, not both at once';
        }
        return 'the core ran a sibling task while the request waited';
    }

    // The first column of the first row, or -1. The shape
    // `examples/transaction.nvs` uses and for the same reason: `?Row` and then
    // `?int` is two unwraps, and this program prints the number twice.
    public static function one(Connection $db, string $sql): int
    {
        var $row = $db->query($sql, [])->first();
        if ($row == null) {
            return -1;
        }
        var $n = $row->int('n');
        if ($n == null) {
            return -1;
        }
        return $n;
    }
}

// This request's own connection, and the block's only one. It is memoized
// (§ 2) and it holds its pool slot until the request ends, so the ceiling
// below is reached and never merely approached.
var $db = Db::connect('tight');
echo 'opened=', Ceiling::one($db, 'select 1 as n'), "\n";

// `{shared: false}` is what makes this a *second* connection rather than the
// one above handed back: § 2's memoization is per request, and opting out of it
// opts into the handshake — which is where the ceiling is, since § 13 takes the
// slot before the socket and so bounds every connection this core holds under
// the key rather than only the ones the pool itself supplied.
//
// No `timeout` is passed, deliberately: a shorter one is reported in its own
// words, and the refusal this fixture is about is the one `acquire` produces.
var $asked = Core\Time::monotonic();
try {
    Db::connect('tight', { shared: false });
    echo 'refused: nothing — a second connection opened, which `max = 1` forbids', "\n";
} catch (IOError $full) {
    var $waited = Core\Time::monotonic()->minus($asked)->toMilliseconds();
    echo 'refused: ', Ceiling::verdict(
        $waited,
        Core\Str::contains($full->message, '`acquire` was up'),
        Core\Str::contains($full->message, '`max` of 1'),
    ), "\n";
}

// The ceiling refused a second connection and did nothing to the first: a lease
// is given back by its own `Drop` on every path between the ask and the request
// ending, so a refusal that had taken this one's slot with it would show up
// here as a connection that no longer answers.
echo 'usable=', Ceiling::one($db, 'select 1 as n'), "\n";

// § 13's wait is a **park**: the core is handed back while a request queues for
// a slot, so it runs other work in the meantime rather than standing still.
// This is the only shape that can show it from a program — `Core\Task::all`
// (ADR 0072 § 1) puts two children on this core, one asking the full pool for
// the connection `$db` is still holding and one doing plain work beside it. A
// task child sees this request's configuration, which is what lets a
// capability-gated member run inside one at all (`Ctx::child`'s doc owns why
// the whole overlay crosses).
var $started = Core\Time::monotonic();
var $race = Core\Task::all({
    blocked: fn(): string => {
        try {
            Db::connect('tight', { shared: false });
            return 'opened';
        // `$busy` and not `$full`: a `catch` binding inside a closure that
        // spells a name the enclosing frame also binds is lowered as a capture
        // of that name (`docs/agent/playbook.md`).
        } catch (IOError $busy) {
            return 'refused';
        }
    },
    // Three sleeps rather than one, so the count it returns is evidence the
    // sibling ran to the end and not merely that it started.
    beside: fn(): int => {
        var $done = 0;
        while ($done < 3) {
            Core\Time::sleep(100ms);
            $done = $done + 1;
        }
        return $done;
    },
});
echo 'parked: ', Ceiling::park(
    Core\Time::monotonic()->minus($started)->toMilliseconds(),
    $race->blocked,
    $race->beside,
), "\n";
