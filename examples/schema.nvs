<?nvs
// A schema is a value: define it, plan it against a real database, and apply
// the half that cannot lose data.
//
// [ADR 0145](/docs/decisions/0145.md)
// is the design, and this program is § 3's whole model in twenty lines: there
// are no migrations, no version table and no ordering to get right. You say
// what should exist, and the difference between that and what does exist is
// computed against the server every time.
//
// § 1 is the array literal below. A schema has three interchangeable spellings
// — built in source, serialized to an array, introspected off a live
// connection — and the array form is the canonical one, so what this program
// writes is the same form `nvs schema dump` prints and a file on disk holds.
// Note what cannot be said in it: § 2's vocabulary is closed, a type is one
// string, a default is one key, and there is nowhere to put a fragment of SQL.
// That is what lets the diff be total.
//
// § 6 is the second line it prints. Every step carries a grade, and there are
// three rather than two, because "cannot lose data" and "cannot take the site
// down for an hour" are different promises and merging them is how an
// automatic tool loses an operator's trust.
//
// § 7 is the last two. `schema_legacy` is a table this schema does not declare
// — the ordinary state of a database an application shares with a queue, a
// reporting view and whatever an operator put there. Convergence **reports**
// it, with the complete SQL that would drop it, and never drops it: that is
// the step `applySafe` leaves behind. The drop that follows is written here,
// by hand, in the `Core\Db::execute` that has always been where a statement a
// human wrote goes — and that is why the second plan comes back empty.
//
// The four lines this prints are frozen by an exact check in a goal record
// under `data/goals/`; the source is not. The connection is an in-memory SQLite database
// this program owns rather than the `main` the other database fixtures share,
// because the step count here is exact and § 7 makes it depend on every other
// table in the database.

use Core\Db;
use Core\Db\Plan\Grade;
use Core\Db\Plan\Step;
use Core\Db\Schema;

var $db = Db::connect('schema');

// What an earlier version of this application left behind.
$db->execute('create table if not exists schema_legacy (id integer not null)', []);

var $schema = Schema::fromArray([
    'tables' => [
        [
            'name' => 'notes',
            'columns' => [
                ['name' => 'id', 'type' => 'int64', 'identity' => true],
                ['name' => 'title', 'type' => 'text(200)'],
                ['name' => 'body', 'type' => 'text', 'null' => true],
                ['name' => 'created_at', 'type' => 'instant', 'default' => ['now' => true]],
            ],
            'primary_key' => ['id'],
            'unique' => [['name' => 'notes_title', 'columns' => ['title']]],
        ],
        [
            'name' => 'tags',
            'columns' => [
                ['name' => 'note_id', 'type' => 'int64'],
                ['name' => 'tag', 'type' => 'text(40)'],
            ],
            'primary_key' => ['note_id', 'tag'],
        ],
    ],
]);

// § 9: planning is an ordinary read, under the `db.connect` this program
// already holds. Nothing about computing a plan is privileged.
var $plan = $schema->planAgainst($db);

var $total = 0;
var $safe = 0;
var $locking = 0;
var $destructive = 0;
foreach ($plan->steps() as Step $step) {
    $total = $total + 1;
    if ($step->grade() == Grade::Safe) {
        $safe = $safe + 1;
    } else if ($step->grade() == Grade::Locking) {
        $locking = $locking + 1;
    } else {
        $destructive = $destructive + 1;
    }
}
echo 'planned ', $total, ' steps', "\n";
echo 'safe ', $safe, ', locking ', $locking, ', destructive ', $destructive, "\n";

// Applying is not a read: § 9 gates it behind the deny-by-default `db.schema`
// capability, and the two entry points are named for what they risk at the
// call site. This one refuses the whole plan if a step it would run is not
// `Safe`; the reported drop is not one of those, so it stays where it is.
$schema->applySafe($db);
echo 'applied the safe half', "\n";

// § 7's escape hatch, and the only place in this program a table is dropped:
// the SQL the plan already carried, run by the program that decided it wanted
// that table gone.
foreach ($plan->steps() as Step $step) {
    if ($step->isRefused()) {
        $db->execute($step->sql(), []);
    }
}

// § 5's property, and the whole feasibility question this design rests on:
// apply a schema, read the server back, and the plan is empty. If it is not,
// something normalizes differently in one direction than the other, and the
// tool would converge on it forever.
var $left = 0;
foreach ($schema->planAgainst($db)->steps() as Step $step) {
    $left = $left + 1;
}
if ($left == 0) {
    echo 'second plan is empty', "\n";
} else {
    echo 'second plan still holds ', $left, ' step(s)', "\n";
}

// The fixture leaves the database as it found it: the acceptance sweep runs
// this program on two legs and under valgrind, and every one of those runs
// plans the same three steps as the first.
$db->execute('drop table tags', []);
$db->execute('drop table notes', []);
