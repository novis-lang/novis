<?nvs
// A durable background job, from the enqueue to the dead letter.
//
// `rule:concurrency/enqueue-commits-with-your-write` is the property the
// whole thing is built around: a job is a row in
// a `Core\Db` table, so `push` inside a transaction on the queue's own
// connection **commits with the write that caused it**. There is no window in
// which the order exists and the receipt job does not, and no outbox to
// write. That is why this is a table and not a broker — a broker cannot
// enlist in your database's transaction, whatever else it does better.
//
// `rule:concurrency/claiming-is-one-statement` is why a fleet needs no
// protocol of ours: a worker claims with one
// statement that atomically selects and marks the oldest due job
// (`FOR UPDATE SKIP LOCKED`, `READPAST`, or SQLite's immediate transaction),
// so the database provides the mutual exclusion and Novis writes no lease, no
// heartbeat and no coordinator.
//
// `rule:concurrency/delivery-is-at-least-once` and
// `rule:concurrency/attempts-are-finite-and-a-dead-letter-is-kept` are the
// last two lines: delivery is at-least-once and stated plainly,
// attempts are finite with nothing configured, and an exhausted job reaches
// the dead-letter table rather than being discarded.
//
// The jobs run in-process workers, which
// `[queue] workers` in `nvs.toml` turns on, over the `[queue] connection`
// that names a `[db.<name>]` block — `examples/db.nvs`'s, by design, since
// the transactional enqueue is only available to a queue sharing the application's own
// database.

use Core\Queue;

class Poll
{
    // Waiting for a worker on another core is the one thing this program does
    // that is not a `Core\Queue` call. Bounded rather than open-ended: a
    // fixture that hangs when the feature regresses is worse than one that
    // prints the wrong line, because the sweep has nothing to report about it.
    public static function until(callable $test): bool
    {
        var $turns = 0;
        while ($turns < 200) {
            if ($test() as bool) {
                return true;
            }
            Core\Time::sleep(25ms);
            $turns = $turns + 1;
        }
        return false;
    }

    // The same wait, answering with the count it saw rather than with whether
    // it saw one. A counter this fixture prints must be *read* by the wait that
    // waited for it: `claimed` is a state a job passes through, so asking again
    // after the wait returned is a second instant, and a worker that has since
    // finished the job answers `0` to a question that was already true.
    public static function counted(callable $test): uint
    {
        var $turns = 0;
        while ($turns < 200) {
            var $seen = $test() as uint;
            if ($seen > 0) {
                return $seen;
            }
            Core\Time::sleep(25ms);
            $turns = $turns + 1;
        }
        return 0;
    }
}

// Every run owns its queues, and the names are drawn rather than written.
// `stats` counts rows, and the queue's tables
// (`rule:core-classes/queue-storage-is-a-table`) are the deployment's rather than this
// program's — nothing empties them between runs, and `nvs queue migrate` is
// explicitly idempotent — so a fixture naming a fixed queue would count its own
// previous runs. A queue is created by a row naming it (`Core\Queue`'s own
// module doc: no queue is declared anywhere else), so a fresh name is a fresh
// counter and costs nothing.
var $queue = Core\Uuid::v4()->toString();
var $flaky = Core\Uuid::v4()->toString();

// `rule:concurrency/queue-four-members`: subject first, one trailing options
// shape. `args` is copied, never referenced, and refuses `secret`
// (`rule:concurrency/a-payload-refuses-secret-and-keeps-its-qualifiers`) — a durable row is an output, and a
// job needing a credential reads it from configuration at run time, which is
// where credentials live anyway.
var $receipt = Queue::push('queue/receipt.nvs', { args: { order: 7 }, queue: $queue });
echo 'enqueued', "\n";

// The claim is the worker's, not ours, and `stats` is how a program sees
// that it happened. One job was pushed to this queue, so one is claimed.
echo 'claimed ', Poll::counted(fn(): uint => { return Queue::stats($queue)->claimed(); }), "\n";

// At-least-once, so "it ran" is a state and not a callback.
Poll::until(fn(): bool => { return Queue::status($receipt) == Queue::State::Succeeded; });
echo 'ran', "\n";

// The failing half, on its own queue so its counters are its own. Two
// attempts and a short backoff, because the fixture asserts the *shape* of
// the retry ladder rather than the operator's default depth.
var $doomed = Queue::push('queue/flaky.nvs', {
    queue: $flaky,
    maxAttempts: 2,
    backoff: 50ms,
});

// A failed attempt is a retry, not a loss: the job returns to the queue and
// is claimed again after its backoff. A job exceeding its memory, CPU or time
// budget arrives here too, reported as a failed attempt rather than as an
// out-of-memory.
Poll::until(fn(): bool => { return Queue::stats($flaky)->attempts() > 1; });
echo 'retried', "\n";

// When every attempt fails, the job moves to the dead-letter table.
// The row keeps its payload, its errors and their timing, and it stays there.
// `stats` reports how many jobs are in that table.
Poll::until(fn(): bool => { return Queue::stats($flaky)->deadLettered() > 0; });
echo 'dead-lettered', "\n";
