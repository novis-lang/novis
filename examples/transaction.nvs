<?nvs
// A transaction is a closure, and that is the whole of the shape.
//
// [ADR 0067](/docs/decisions/0067.md) § 7 removes `beginTransaction`,
// `commit`, `rollBack` on the connection, `inTransaction` and explicit
// savepoints, and replaces all five with one member that owns the scope:
// the closure returns and the work commits, the closure throws and the work
// rolls back. A transaction left open by an early `return` is the failure
// mode the shape makes unspellable, so it is not a rule anyone has to
// remember.
//
// `Core\Db\Transaction implements Queryable by $connection`
// ([ADR 0043](/docs/decisions/0043.md)),
// so `$tx` has the same surface `$db` does and nothing is declared twice.
// A nested `transaction` is a savepoint.
//
// The five lines this prints are frozen by an exact check in a goal record
// under `data/goals/`; the source is not. It reads the same `[db.main]` block
// `examples/db.nvs` does.

use Core\Db;
use Core\Db\Transaction;

class Accounts
{
    // § 6's typed readers answer `?T`, a `null` being a NULL column — so a
    // count is unwrapped once, here, rather than at each of the two places
    // this program prints one.
    public static function count(Core\Db\Connection $db): int
    {
        var $row = $db->query('select count(*) as n from accounts', [])->first();
        if ($row == null) {
            return -1;
        }
        var $n = $row->int('n');
        if ($n == null) {
            return -1;
        }
        return $n;
    }
}

var $db = Db::connect('main');
$db->execute('drop table if exists accounts', []);
$db->execute('create table accounts (id integer primary key, owner text not null)', []);

// The rolling-back half. `rollBack` sets the rollback-only flag and throws
// `Db\RolledBack`, which propagates out of the owning `transaction()` call —
// so a caller that wants to continue catches it here, and one that does not
// gets the failure it should have got. There is no way to ask for a rollback
// and carry on inside the same transaction.
try {
    $db->transaction(fn (Transaction $tx): void => {
        $tx->executeMany('insert into accounts (id, owner) values (?, ?)', [
            [1, 'ada'],
            [2, 'grace'],
        ]);
        echo 'inserted 2', "\n";
        $tx->rollBack('this fixture keeps nothing from the first attempt');
    });
// The class is written out here rather than imported: a `use` alias reaches a
// `new` and a parameter type, and does not yet reach a `catch` — `nvs-ir`
// tests the thrown value against the source text of the clause.
} catch (Core\Db\RolledBack $rolled) {
    // The string `rollBack` was given is on the throwable as `$reason`, so the
    // caller that catches it can say *why* the work was abandoned without the
    // closure needing a second channel out — a transaction that returns nothing
    // has no other way to report the decision it made.
    echo 'rolled back: ', $rolled->reason, "\n";
}

// Nothing survived it. This is the line the whole design is for: the two rows
// were written and are gone, and no `commit` was ever reachable.
echo 'count=', Accounts::count($db), "\n";

// The committing half — the same closure without the refusal at the end.
// There is no `commit` member to call: returning is the commit.
$db->transaction(fn (Transaction $tx): void => {
    $tx->executeMany('insert into accounts (id, owner) values (?, ?)', [
        [1, 'ada'],
        [2, 'grace'],
    ]);
});
echo 'committed', "\n";
echo 'count=', Accounts::count($db), "\n";
