<?nvs
class Walk
{
    public static function digits(): string
    {
        var $out = "";
        var $n = 0;
        do {
            $out .= $n;
            $n++;
        } while ($n < 5);

        return $out;
    }

    public static function scan(array<int> $rows): string
    {
        var $seen = "";
        foreach ($rows as int $row) {
            var $inner = 0;
            while ($inner < 3) {
                $seen .= $row + $inner;
                if ($row + $inner >= 4) {
                    break 2;
                }

                $inner++;
            }
        }

        return $seen;
    }

    public static function guarded(string $mode): string
    {
        try {
            throw new LogicError("first");
        } catch (LogicError $caught) {
            if ($mode == "rethrow") {
                throw new RuntimeError("second");
            }

            return "handled";
        } finally {
            echo "cleanup " . $mode . "\n";
        }
    }
}

class Source
{
    public static function counting(): Iterator<int>
    {
        try {
            yield 1;
            yield 2;
            yield 3;
        } finally {
            echo "closed\n";
        }
    }
}

echo "digits=" . Walk::digits() . "\n";

array<int> $rows = [1, 5];
echo "scan=" . Walk::scan($rows) . "\n";

var $label = Core\Arr::count($rows) > 5 ? "big" : 0;
echo "label=" . $label . "\n";

echo "handled=" . Walk::guarded("return") . "\n";

try {
    Walk::guarded("rethrow");
    echo "not reached\n";
} catch (RuntimeError $second) {
    echo "rethrown=" . $second->message . "\n";
}

var $taken = 0;
foreach (Source::counting() as int $v) {
    $taken += $v;
    if ($v == 2) {
        break;
    }
}

echo "taken=" . $taken . "\n";
