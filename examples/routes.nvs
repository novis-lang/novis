<?nvs
// ADR 0077's compile-time route table, as a program.
//
// Nothing below names `App\Users`, and no `require` reaches its file. The
// route table is built by the same scan `Core\Program::implementing<T>()`
// uses (§ 5), so the `autoload` root on the next line is what finds the class
// — and a program declaring no route and calling no `Core\Router` member
// performs no scan at all.
autoload 'App' from './routes';

// The three routes this program declares, one line each.
//
// Nothing here enumerates the table, because § 4's roster — `match`,
// `methodsFor`, `url`, `urlAbsolute` — deliberately holds no member that
// could: each one asks about a name or a path the caller already has.
// `examples/octets.nvs` is where `match` is read back, over a route of its
// own. What asserts the table here is therefore the compiler, not the
// output: the two `Core\Router::url` calls below take a name written *directly in the code*, and
// § 4 makes an unknown name, and a `$params` array that does not cover the
// route's captures, compile errors. If `Users::show` were not in the table,
// or its `{id}` did not bind to a `uint $id` parameter, this program would
// not build.
echo 'GET /users/{id} -> Users::show', "\n";
echo 'GET /users -> Users::index', "\n";
echo 'POST /users -> Users::create', "\n";

// § 4: `url` is the launderer for the URL-path sink — it percent-encodes each
// substituted value and prepends the mount prefix, which is why a link is
// built through this member and never by concatenating a declared path.
echo 'url=', Core\Router::url('Users::show', ['id' => 7]), "\n";

// ADR 0102 § 6: the origin is configured, never sniffed from `Host` or
// `X-Forwarded-Host`, so `urlAbsolute` reads `[app] origin` (or the mount's
// own) and a unit that resolves none is a boot error rather than a link with
// an attacker's hostname in it.
echo 'absolute=', Core\Router::urlAbsolute('Users::show', ['id' => 7]), "\n";
