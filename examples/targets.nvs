<?nvs
class Registry
{
    public static int $hits = 0;

    public static function bump(int $by): int
    {
        Registry::$hits = Registry::$hits + $by;

        return Registry::$hits;
    }
}

class Point
{
    public int $x;
    public int $y;

    public function constructor(int $x, int $y)
    {
        $this->x = $x;
        $this->y = $y;
    }
}

class Any
{
    public static function pass(mixed $value): mixed
    {
        return $value;
    }
}

Registry::$hits = 0;
echo 'hits=' . Registry::bump(2) . ',' . Registry::bump(3) . "\n";

array<array<int>> $grid = [[1, 2], [3, 4]];
$grid[0][1] = 9;
echo 'grid=' . $grid[0][1] . $grid[1][0] . "\n";

mixed $sum = Any::pass(4);
echo 'mixedSum=' . ($sum + 1) . "\n";

mixed $box = Any::pass([1, 2, 3]);
echo 'elem=' . $box[1] . "\n";

?bool $unset = null;
echo 'flag=' . ($unset ? 'yes' : 'no') . "\n";

object $any = new Point(3, 4);
echo 'top=' . ($any is Point ? 'point' : 'other') . "\n";

// ADR 0007 § 2's grid gives a `bool` source the "anything → `string`" row and
// no numeric one, so a number out of a predicate is a branch said out loud
// (`E0708` names the spelling where `$yes as int` is written).
bool $yes = true;
echo 'asInt=' . ($yes ? 1 : 0) . ' asString=' . ($yes as string) . "\n";

// ADR 0007 § 2's `array<T>` → `array<U>` row *checks* every element against
// `U` rather than converting it, and what checks one is its runtime tag — so
// `as array<string>` over these throws at element 0, and `array<mixed>` is
// the target every tag satisfies.
array<int> $ints = [1, 2, 3];
array<mixed> $loose = $ints as array<mixed>;
echo 'converted=' . $loose[2] . "\n";
