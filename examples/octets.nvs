<?nvs
// This program shows that percent-decoding gives `bytes` where the result may not be text.
// A `string` is always valid UTF-8. Decoded bytes can be anything, so the decoders return `bytes`.
// You write `as string` when you need text. A route parameter must be a `string`.
// So a parameter that does not decode to valid UTF-8 throws an error.

// A class with one route. A program in one file has routes like any other program.
class Pages
{
    #[Core\Route(path: '/pages/{slug}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(string $slug): string
    {
        return $slug;
    }
}

// 1. `%ff%fe%fd` decodes to three bytes that are not valid UTF-8.
// So `decodeComponent` returns `bytes`. This prints each byte in hex.
bytes $octets = Core\Uri::decodeComponent('%ff%fe%fd');
echo 'decoded octets: ',
    Core\Encoding::toHex(Core\Bytes::slice($octets, 0, 1)), ' ',
    Core\Encoding::toHex(Core\Bytes::slice($octets, 1, 1)), ' ',
    Core\Encoding::toHex(Core\Bytes::slice($octets, 2, 1)), "\n";

// 2. `parseQuery` decodes a query string. `na%6de` decodes to the key `name`.
// The value can be any bytes, so it is `bytes`. It is equal to the bytes from step 1.
array<mixed> $query = Core\Uri::parseQuery('na%6de=%ff%fe%fd');
tainted bytes $value = $query['name'] as bytes;
if (Core\Bytes::compare($value, $octets) == 0) {
    echo 'query name and value decode as octets too', "\n";
}

// 3. `Core\Router::match` decodes a route parameter once. `%20` becomes a space.
// The handler gets `hello world`. A parameter that is not valid UTF-8 throws an error.
?Core\Router\Match $matched = Core\Router::match(Core\Http\Method::Get, '/pages/hello%20world');
if ($matched != null) {
    echo 'capture: ', $matched->param('slug') as string, "\n";
}
