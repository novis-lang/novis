<?nvs
// This program tries three things. Its `[[app]]` block in `nvs.toml` allows `fs.read` and not `fs.write` or `script.spawn`.
// A missing capability throws a `RuntimeError`. The program can catch it and continue.
// A memory or time limit is different: `catch` cannot stop it, and the program ends.
// Each `catch` below names `RuntimeError` and not `Throwable`, so any other error still stops the program.

// Granted: a read under the root the operator named.
try {
    string $greeting = Core\IO::read('capability/greeting.txt');
    echo 'granted: ' . Core\Str::trim($greeting) . "\n";
} catch (RuntimeError $refused) {
    echo 'granted: refused', "\n";
}

// Denied: the same directory, the other verb. The path is inside the
// granted root on purpose — what is missing is the capability, not the
// prefix, so a tree that checked only the path would pass the wrong half.
try {
    Core\IO::write('capability/denied.txt', 'unreachable');
    echo 'allowed: fs.write', "\n";
} catch (RuntimeError $refused) {
    echo 'denied: fs.write', "\n";
}

// Denied: `spawn script` without `script.spawn`. This throws *here*,
// unlike a child that fails on its own — `examples/isolate.nvs` covers
// that case and it is a value on this side, because a child may not end
// its parent. A spawn the parent was never allowed to attempt never
// reaches a child at all.
try {
    // `await` is an expression, so its result is bound rather than discarded:
    // a bare `await $child;` is not a statement this language has.
    var $child = spawn script 'isolate/hello.nvs' with(
        output: 'capture',
    );
    var $done = await $child;
    echo 'allowed: script.spawn', "\n";
} catch (RuntimeError $refused) {
    echo 'denied: script.spawn', "\n";
}
