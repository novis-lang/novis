<?nvs
// `Core\Script::finish()` — the fourth ending. A handler that is done answering
// says so, and everything a normal end would do still happens: every `finally`
// between the call and the root runs, the `Core\Script::onExit` queue drains,
// and `Core\Task::afterResponse` work goes out afterwards. That is the whole
// difference from `exit`, which runs none of the three.
Core\Script::onExit(fn (Core\Script\ExitReport $report): void => {
    string $reason = match ($report->reason()) {
        Core\Script\ExitReason::Normal => 'Normal',
        Core\Script\ExitReason::ExitCall => 'ExitCall',
        Core\Script\ExitReason::UncaughtThrow => 'UncaughtThrow',
        Core\Script\ExitReason::Finish => 'Finish',
    };
    echo 'exit hook: ', $reason, "\n";
});

Core\Task::afterResponse(fn (): void => {
    echo "after the response\n";
});

echo "start\n";
try {
    try {
        Core\Script::finish();
    } finally {
        echo "inner finally\n";
    }
} catch (Throwable $error) {
    // Never reached: the marker is a root of its own in the exception tree, so
    // no arm admits it — not even this one.
    echo "caught\n";
} finally {
    echo "outer finally\n";
}
echo "never reached\n";
