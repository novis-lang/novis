<?nvs
namespace App;

class Greet implements Command
{
    // ADR 0086 § 6: a parameter is a positional argument unless it carries
    // `#[Option]` — one sentence, with no inference from defaults or types —
    // so `$name` is positional and arrives `tainted string`, nothing about a
    // raw argument having been checked. A `bool` `#[Option]` is a flag.
    #[\Core\Command(name: "greet", about: "Say hello")]
    public static function greet(
        tainted string $name,
        #[\Core\Option(short: "l", about: "Shout it")] bool $loud,
    ): void {
        // ADR 0088 § 2: `Core\Str::upper`'s parameter carries no
        // classification, so it *refuses* a tainted argument — the default is
        // refusal and contagion is something an author writes. `echo` binds to
        // the terminal sink, which takes one and substitutes visibly (§ 1), so
        // the raw argument reaches output and reaches nothing else.
        echo $name, $loud ? "!" : "", "\n";
    }

    public function usage(): string
    {
        return "greet <name> [--loud]";
    }
}
