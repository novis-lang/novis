<?nvs
namespace App;

class Greet implements Command
{
    // `rule:tooling/a-parameter-is-an-argument-unless-it-is-an-option`: a parameter is a positional argument unless it carries
    // `#[Option]` — one sentence, with no inference from defaults or types —
    // so `$name` is positional and arrives `tainted string`, nothing about a
    // raw argument having been checked. A `bool` `#[Option]` is a flag.
    #[Core\Command(name: 'greet', about: 'Say hello')]
    public static function greet(
        tainted string $name,
        #[Core\Option(short: 'l', about: 'Shout it')] bool $loud,
    ): void
    {
        // `Core\Str::upper` does not accept a tainted argument, because its
        // parameter does not say it accepts one. `echo` writes to the terminal.
        // The terminal accepts a tainted value and shows each control byte as
        // a visible symbol, so the argument reaches the output and nothing
        // else.
        echo $name, $loud ? '!' : '', "\n";
    }

    public function usage(): string
    {
        return 'greet <name> [--loud]';
    }
}
