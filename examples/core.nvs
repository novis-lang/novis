<?nvs
array<int> $nums = Core\Arr::range(1, 10);
var $evens = Core\Arr::filter($nums, fn(int $n) => $n % 2 == 0);
echo 'evens=' . Core\Arr::count($evens) . "\n";

array<string> $words = ['pear', 'Apple', 'fig', 'banana'];

var $upper = Core\Arr::map($words, fn(string $w) => Core\Str::upper($w));
echo Core\Str::join($upper, '|') . "\n";

var $sorted = Core\Arr::sort($words, { by: fn(string $w) => Core\Str::length($w) });
echo Core\Str::join($sorted, ',') . "\n";

echo Core\Str::replace('a-b-c', '-', '+') . "\n";
echo Core\Str::padStart('7', 3, '0') . "\n";
echo Core\Str::upperFirst('nvs runs') . "\n";
