<?mwl
class Registry {
    public static int $hits = 0;

    public static function bump(int $by): int {
        Registry::$hits = Registry::$hits + $by;

        return Registry::$hits;
    }
}

class Point {
    public int $x;
    public int $y;

    public function constructor(int $x, int $y) {
        $this->x = $x;
        $this->y = $y;
    }
}

class Any {
    public static function pass(mixed $value): mixed {
        return $value;
    }
}

Registry::$hits = 0;
echo "hits=" . Registry::bump(2) . "," . Registry::bump(3) . "\n";

array<array<int>> $grid = [[1, 2], [3, 4]];
$grid[0][1] = 9;
echo "grid=" . $grid[0][1] . $grid[1][0] . "\n";

mixed $sum = Any::pass(4);
echo "mixedSum=" . ($sum + 1) . "\n";

mixed $box = Any::pass([1, 2, 3]);
echo "elem=" . $box[1] . "\n";

?bool $unset = null;
echo "flag=" . ($unset ? "yes" : "no") . "\n";

object $any = new Point(3, 4);
echo "top=" . ($any instanceof Point ? "point" : "other") . "\n";

bool $yes = true;
echo "asInt=" . ($yes as int) . " asString=" . ($yes as string) . "\n";

array<int> $ints = [1, 2, 3];
array<string> $texts = $ints as array<string>;
echo "converted=" . $texts[2] . "\n";
