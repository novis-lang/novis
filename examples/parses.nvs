<?nvs
// A class built from text, standing where `Core\Uuid` stands: in a route
// capture, in a `#[Query]`, and refusing a segment the router itself would
// have handed on.
//
// This leg runs under `nvs run --request examples/parses.nvsr`, so the method,
// the path and the query `dispatch` reads below are one real request's — that
// file describes it in the format `crates/nvs-test/src/request.rs` owns. The
// two walks after it are `Core\Router::match` over paths written here.

// `Parses` is one of the interfaces the compiler declares for every program:
// there is no `use` to write and no file to reach, and the class owes one
// member. Its `tryParse` twin is a default body on the interface rather than a
// second required member, so there is exactly one answer to "is this text a
// `Slug`" (`rule:expressions/try-parse`).
//
// The text arrives `tainted` because the text at every binding site came from
// outside the process, and the object built out of it carries no qualifier at
// all — `tainted` is a property of `string` and `bytes` and never of a class
// (`rule:security/tainted-qualifier`). That is why the field below says
// `tainted string`: a class cannot launder by declaring the field `string`,
// because the assignability rule that already stands refuses it.
class Slug implements Parses
{
    public tainted string $text = '';

    public function constructor(tainted string $text)
    {
        $this->text = $text;
    }

    // What counts as a slug is this class's business and nothing the router
    // knows. The matcher narrows on the conversions it reads natively — `int`,
    // `uint`, `decimal`, `Core\Uuid` and a closed set — and a capture at any
    // other `Parses` class matches on *shape*, because matching runs at the
    // door with no program installed and an implementor's body may not run
    // over every request URL that reaches it
    // (`rule:security/route-capture-is-laundered-by-its-type`).
    public static function parse(tainted string $s): static
    {
        if ($s != Core\Str::lower($s)) {
            throw new ParseError('a slug is written in lower case');
        }
        return new static($s);
    }
}

class Posts
{
    // `Slug` stands in the capture and in the `#[Query]` alike: a query
    // parameter is declared with a capture's type list
    // (`rule:routing/a-query-parameter-is-declared-like-a-capture`), and that
    // list's last entry is "a class implementing `Parses`". A parameter default
    // is a constant of the declared type, so a class-typed `#[Query]` has none
    // and its key is required: a request without `tag` is a `400`
    // (`rule:routing/a-bad-query-value-is-a-400`).
    #[Core\Route(path: '/posts/{slug}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function show(Slug $slug, #[Core\Query] Slug $tag): void
    {
        echo 'slug is ', $slug->text, "\n";
        echo 'tag is ', $tag->text, "\n";
    }

    // The engine's own class built from text, at the same site, for the
    // contrast this program's last line pins: `Core\Uuid` is one of the
    // conversions the matcher performs itself.
    #[Core\Route(path: '/posts/by-id/{id}', method: Core\Http\Method::Get)]
    #[Core\Access(allow: Core\Audience::Public)]
    public function byId(Core\Uuid $id): void
    {
        echo 'one post', "\n";
    }
}

// A gate that lets every route run and reports what it refused.
class Gate implements Core\Router\Gate
{
    public function allows(Core\Router\Match $route): bool
    {
        return true;
    }

    public function refused(Core\Router\Refusal $reason, ?Core\Router\Match $route): void
    {
        echo 'refused', "\n";
    }

    public function failed(?Core\Router\Match $route, ?Throwable $error): void
    {
        echo 'failed: ', $error?->message ?? 'no error', "\n";
    }
}

// Both halves of `show`, converted where the match crosses into the program
// rather than at the door: `dispatch` builds the `{slug}` capture and the
// `#[Query]` key `tag` through the same `Slug::parse`, then calls the method.
Core\Router::dispatch(new Gate());

// A segment the class refuses fails over a route that *did* match, so it is a
// `400` and never a `404`: the shape claimed the row, and the refusal happened
// one layer above the walk, where a served request is already past everything
// that rate-limits it.
try {
    ?Core\Router\Match $shouty = Core\Router::match(Core\Http\Method::Get, '/posts/Hello-World');
    echo 'unreachable: the class refused nothing', "\n";
} catch (ParseError $refusal) {
    echo 'a segment the class refuses is a 400', "\n";
}

// And the other half of that sentence. A `Core\Uuid` capture is converted by
// the matcher itself, so a segment it cannot read is simply not a match, the
// walk carries on, and nothing else claiming this path means a `404`. Two
// captures spelled the same way therefore fail two ways, and what decides
// which is who runs at the door.
?Core\Router\Match $refused = Core\Router::match(Core\Http\Method::Get, '/posts/by-id/not-a-uuid');
if ($refused == null) {
    echo "and a Core\\Uuid segment the router refuses is no match", "\n";
}
