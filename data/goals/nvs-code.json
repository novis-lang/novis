  "checks": [
    {
      "id": "nvs-lsp-a-one-shot-workspace-answers-by-name",
      "kind": "cargo-named",
      "stage": 2,
      "name": "nvs-lsp (a one-shot workspace answers references, implementations, a declaration, an outline and inferred types by fully-qualified name, the way the editor does)",
      "args": [
        "test",
        "-p",
        "nvs-lsp",
        "--test",
        "query"
      ],
      "tests": [
        "references_by_name_are_the_ones_the_editor_lists",
        "a_call_on_another_class_with_the_same_method_name_is_not_a_reference",
        "an_autoloaded_class_is_resolved_in_a_one_shot_workspace",
        "implementations_list_every_subtype_transitively_and_every_overrider",
        "a_declaration_by_name_carries_its_kind_site_and_doc_comment",
        "an_outline_lists_a_files_declarations_nested_by_owner_in_source_order",
        "types_list_each_binding_in_a_line_range_with_its_inferred_type",
        "an_unknown_name_gives_the_nearest_names"
      ]
    },
    {
      "id": "nvs-code-the-rule-exists",
      "kind": "command",
      "stage": 3,
      "name": "rulebook: `nvs code` has its rule",
      "argv": [
        "bun",
        "nv",
        "peek",
        "rule:tooling/nvs-code-answers-about-the-project"
      ],
      "want": [
        "docs/rules/tooling/nvs-code-answers-about-the-project.md"
      ]
    },
    {
      "id": "nvs-cli-nvs-code-answers",
      "kind": "cargo-named",
      "stage": 3,
      "name": "nvs-cli (`nvs code` prints references, cards, implementations, outlines and types as text and as JSON, and fails on an unknown name with the nearest ones)",
      "args": [
        "test",
        "-p",
        "nvs-cli",
        "--test",
        "code"
      ],
      "tests": [
        "refs_prints_the_declaration_first_then_each_use_with_its_position_and_line",
        "refs_of_a_name_nothing_uses_prints_nothing_and_exits_zero",
        "show_prints_the_signature_nvs_meta_writes_and_the_doc_comment",
        "show_of_a_core_name_prints_the_card_nvs_agent_show_prints",
        "an_unknown_name_fails_and_lists_the_nearest_names_with_their_backslashes",
        "every_verb_json_follows_the_check_json_conventions",
        "a_project_with_errors_still_answers_and_counts_them_on_stderr",
        "the_project_is_the_nearest_nvs_toml_at_or_above_the_working_directory",
        "a_position_is_one_based_and_counts_characters",
        "control_characters_from_the_project_are_printed_escaped"
      ]
    },
    {
      "id": "nvs-cli-agents-learn-of-nvs-code",
      "kind": "cargo-named",
      "stage": 4,
      "name": "nvs-cli (the agent protocol names `nvs code`, an older pointer is rewritten to say so, and the index lists the command and its verbs)",
      "args": [
        "test",
        "-p",
        "nvs-cli",
        "--test",
        "agent"
      ],
      "tests": [
        "the_protocol_names_nvs_code_for_questions_about_the_project",
        "a_pointer_written_before_nvs_code_is_outdated_and_rewritten",
        "the_index_lists_nvs_code_and_each_of_its_verbs"
      ]
    },
    {
      "id": "dossier-nvs-code-owes-nothing",
      "kind": "command",
      "stage": 5,
      "name": "proofs: `tools:cli/nvs-code` owes nothing, and its example and attack pass",
      "argv": [
        "bun",
        "nv",
        "proofs",
        "--verify",
        "--only",
        "tools:cli/nvs-code"
      ],
      "want": [
        "nothing owed in 1 named feature(s)",
        "proofs examples:",
        "0 failed",
        "proofs hostile:",
        "0 failed"
      ]
    },
    {
      "id": "dossier-nvs-code-programs-carry-plain-comments",
      "kind": "command",
      "stage": 5,
      "name": "proofs: the `nvs code` example and attack carry comments inside the plain-comment bounds",
      "argv": [
        "bun",
        "nv",
        "proofs",
        "--comments",
        "docs/examples/tools/cli/nvs-code",
        "tests/hostile/tools/cli/nvs-code"
      ],
      "want": [
        "each inside the bounds"
      ]
    },
    {
      "id": "dossier-the-whole-roster-owes-nothing-with-nvs-code",
      "kind": "command",
      "stage": 5,
      "name": "proofs: the whole roster owes nothing with `nvs code` on it",
      "argv": [
        "bun",
        "nv",
        "proofs",
        "--gate"
      ],
      "want": [
