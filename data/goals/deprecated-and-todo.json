  "checks": [
    {
      "id": "nvs-types-a-deprecation-template-is-checked-where-it-is-declared",
      "kind": "cargo-named",
      "stage": 2,
      "name": "nvs-types (`#[Core\\Deprecated]` is on the roster, and its template is refused where it does not compile, does not fit, is less visible or names something deprecated)",
      "args": [
        "test",
        "-p",
        "nvs-types"
      ],
      "tests": [
        "a_deprecated_attribute_takes_since_note_and_replace",
        "a_deprecated_attribute_on_an_attach_site_it_does_not_take_is_refused",
        "a_deprecation_template_that_does_not_compile_is_refused_at_the_declaration",
        "a_deprecation_template_whose_type_does_not_fit_is_refused",
        "a_deprecation_template_naming_a_less_visible_member_is_refused",
        "a_deprecation_template_naming_a_deprecated_member_is_refused",
        "a_class_replacement_missing_a_public_member_is_refused"
      ]
    },
    {
      "id": "nvs-types-every-use-of-a-deprecated-member-warns",
      "kind": "cargo-named",
      "stage": 2,
      "name": "nvs-types (every use of a deprecated method, constructor, property, constant, enum case, parameter and class is `W1003`, and nothing inside a deprecated declaration warns)",
      "args": [
        "test",
        "-p",
        "nvs-types"
      ],
      "tests": [
        "every_use_of_a_deprecated_member_is_w1003",
