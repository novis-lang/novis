  "checks": [
    {
      "id": "nvs-lsp-completion-files-are-found-read-and-reloaded",
      "kind": "cargo-named",
      "stage": 2,
      "name": "nvs-lsp (completion files are found under every `.novis` folder and in `vendor/`, merged, and read again only when they change)",
      "args": [
        "test",
        "-p",
        "nvs-lsp"
      ],
      "tests": [
        "a_completion_file_is_found_under_every_novis_folder_and_in_vendor",
        "a_json_file_outside_a_completion_folder_is_not_read",
        "two_files_for_one_parameter_merge_and_the_first_value_is_kept",
        "a_set_defined_in_one_file_attaches_in_another",
        "a_changed_completion_file_is_read_again_and_an_unchanged_one_is_not",
        "the_server_registers_a_watcher_for_completion_files_when_the_client_can"
      ]
    },
    {
      "id": "nvs-lsp-a-wrong-completion-file-is-reported",
      "kind": "cargo-named",
      "stage": 2,
      "name": "nvs-lsp (a completion file that is not valid, or names a method, parameter or set that does not exist, is reported on its own URI)",
      "args": [
        "test",
        "-p",
        "nvs-lsp"
      ],
      "tests": [
        "a_completion_file_with_an_unknown_field_contributes_nothing_and_is_reported",
        "a_completion_file_that_is_not_json_contributes_nothing_and_is_reported",
        "an_attachment_to_a_missing_method_or_parameter_is_reported_and_the_rest_of_the_file_is_kept",
        "an_attachment_to_a_class_the_index_does_not_declare_is_a_hint",
        "an_attachment_to_a_parameter_that_is_not_a_string_is_reported",
        "an_attachment_to_a_set_no_file_defines_is_reported",
        "a_completion_file_under_vendor_is_not_reported"
      ]
    },
    {
      "id": "nvs-lsp-completion-files-read-the-later-fields",
      "kind": "cargo-named",
      "stage": 2,
      "name": "nvs-lsp (a completion file's `location`, `replacement`, `when`, `strict` and `separator` are loaded, and a wrong one is reported)",
      "args": [
        "test",
        "-p",
        "nvs-lsp"
      ],
      "tests": [
        "a_list_written_with_a_separator_loads_its_whole_values",
        "a_list_with_an_unknown_separator_contributes_nothing_and_is_reported",
        "a_value_location_whose_file_does_not_exist_is_reported",
        "a_when_naming_a_missing_parameter_is_reported_and_its_attachment_contributes_nothing",
        "a_replacement_on_a_value_that_is_not_deprecated_is_reported"
      ]
    },
    {
      "id": "nvs-lsp-a-named-parameter-offers-its-values",
      "kind": "cargo-named",
      "stage": 3,
      "name": "nvs-lsp (a string argument at a parameter a completion file names offers its values, each changing only that string)",
      "args": [
        "test",
        "-p",
        "nvs-lsp"
      ],
      "tests": [
        "a_string_argument_at_a_named_parameter_offers_the_files_values",
        "an_inherited_method_is_reached_through_its_declaring_class",
        "an_item_carries_every_field_the_file_gives",
        "an_item_replaces_the_string_and_escapes_for_its_quote",
        "an_item_carries_no_command_and_no_other_edit",
        "a_relative_link_in_documentation_resolves_against_the_completion_file",
        "a_quote_opens_the_list_at_a_named_parameter",
        "a_path_parameter_with_a_completion_file_offers_both_lists",
        "every_completion_source_names_a_compiler_table",
        "no_completion_source_reads_a_directory_layout_or_the_network"
      ]
    },
    {
      "id": "nvs-lsp-dependent-values-and-segments",
      "kind": "cargo-named",
      "stage": 3,
      "name": "nvs-lsp (an attachment with `when` applies only when the other argument matches, and a list with a separator completes one segment at a time)",
      "args": [
        "test",
        "-p",
        "nvs-lsp"
      ],
      "tests": [
        "an_attachment_with_when_applies_only_when_the_other_argument_equals_one_of_its_strings",
        "an_attachment_with_when_does_not_apply_when_the_other_argument_is_not_a_literal",
        "a_named_argument_is_read_for_when_like_a_positional_one",
        "a_list_with_a_separator_offers_the_next_segment",
        "a_segment_item_replaces_only_the_segment_being_typed",
        "a_dot_opens_the_list_inside_a_string_whose_list_has_a_dot_separator",
        "a_dot_outside_such_a_string_opens_nothing"
      ]
    },
    {
      "id": "nvs-lsp-completion-values-answer-hover-definition-and-checks",
      "kind": "cargo-named",
      "stage": 4,
      "name": "nvs-lsp (a literal equal to a value answers hover and go-to-definition, a strict parameter warns on an unknown literal, and a deprecated value offers its replacement)",
      "args": [
        "test",
        "-p",
        "nvs-lsp"
      ],
      "tests": [
        "hover_on_a_literal_equal_to_a_value_shows_its_title_and_documentation",
        "definition_on_a_literal_equal_to_a_value_goes_to_its_location",
        "a_value_without_a_location_has_no_definition",
        "a_strict_parameter_warns_on_a_literal_that_is_not_one_of_its_values",
        "a_strict_parameter_does_not_check_a_value_built_at_run_time",
        "a_strict_check_is_skipped_where_a_when_cannot_be_decided",
        "a_parameter_without_strict_reports_nothing",
        "a_literal_equal_to_a_deprecated_value_gets_a_deprecated_hint",
        "the_replacement_quick_fix_rewrites_only_the_string_and_escapes_for_its_quote"
      ]
    },
    {
      "id": "nvs-lsp-a-literal-union-parameter-completes-its-members",
      "kind": "cargo-named",
      "stage": 5,
      "name": "nvs-lsp (a string argument at a parameter typed as a union of string literals offers its members)",
      "args": [
        "test",
        "-p",
        "nvs-lsp"
      ],
      "tests": [
        "a_string_argument_at_a_literal_union_parameter_offers_its_members",
        "a_nullable_literal_union_offers_its_string_members",
        "a_quote_opens_the_list_at_a_literal_union_parameter",
        "a_literal_union_parameter_with_a_completion_file_offers_both_lists_merged",
        "a_parameter_typed_string_offers_no_literal_members"
      ]
    },
