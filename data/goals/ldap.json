    {
      "id": "nvs-ldap-binds-and-pages-over-tls",
      "kind": "cargo-named",
      "stage": 3,
      "name": "nvs-ldap (LDAPS and StartTLS bind, an empty password refused in the client, a cleartext bind only under the host grant and the block's ask, a refused one is `EncryptionRequired`, paging holds one page, a reference is returned and not followed)",
      "args": [
        "test",
        "-p",
        "nvs-ldap",
        "--test",
        "samba"
      ],
      "tests": [
        "an_ldaps_simple_bind_and_whoami_succeed",
        "starttls_upgrades_the_connection_then_binds",
        "an_empty_password_is_refused_before_a_byte_is_sent",
        "a_cleartext_bind_to_a_host_off_the_grant_is_refused_in_the_client",
        "a_cleartext_bind_under_the_grant_and_the_blocks_ask_succeeds",
        "a_controller_refusing_a_cleartext_bind_is_encryption_required",
        "a_search_pages_past_a_thousand_entries_holding_one_page",
        "a_continuation_reference_is_returned_and_not_followed"
      ]
    },
    {
