    {
      "id": "nvs-stdlib-the-intl-interface-is-batch-shaped",
      "kind": "cargo-named",
      "stage": 2,
      "name": "nvs-stdlib (`wit/intl.wit` parses against the world in its types alone, and every formatting export takes a list and returns a list)",
      "args": [
        "test",
        "-p",
        "nvs-stdlib",
        "--test",
        "ext_world"
      ],
      "tests": [
        "the_intl_interface_parses_against_the_world_in_wit_types_alone",
        "every_intl_formatting_export_takes_a_list_and_returns_a_list"
      ]
    },
    {
      "id": "nvs-ext-the-intl-component-is-built-in-and-sorts-in-one-crossing",
      "kind": "cargo-named",
      "stage": 3,
      "name": "nvs-ext (the intl component is built in and answers with no configuration, sorting 10,000 strings is one crossing, counted, and the order is the locale's)",
      "args": [
        "test",
        "-p",
        "nvs-ext",
        "--test",
        "intl"
      ],
      "tests": [
        "the_intl_component_is_built_in_and_answers_with_no_configuration",
