{
  "title": "the website is four areas a newcomer can follow, and cannot go stale",
  "milestone": null,
  "files": [],
  "context": {
    "modules": [
      "website/astro.config.ts",
      "website/src/components/Header.astro",
      "website/src/components/Footer.astro",
      "tools/nv/renderers/index.ts",
      "tools/nv/renderers/website-core.ts",
      "tools/nv/proofs/roster.ts",
      "tools/nv/cmd/session.ts"
    ],
    "rules": [
      "testing/examples-live-in-the-repository",
      "testing/feature-proofs"
    ],
    "adrs": [],
    "shapes": [
      "A commit message",
      "A decision record",
      "A rule fragment"
    ],
    "playbook": [],
    "plan": [],
    "milestones": []
  },
  "stages": [
    {
      "number": 2,
      "title": "the structure and the stale guard",
      "summary": "Builds the four-area skeleton, removes the retired pages, and makes staleness a checked failure."
    },
    {
      "number": 3,
      "title": "Reference, generated and complete",
      "summary": "Generates every Core, configuration and CLI page with its examples and related links, and no empty heading.",
      "context": {
        "modules": [
          "website/src/lib/core.ts"
        ]
      }
    },
    {
      "number": 4,
      "title": "Syntax",
      "summary": "Writes the Syntax area: every language feature covered, a snippet and a Do / Don't list on every page."
    },
    {
      "number": 5,
      "title": "Install and Guides",
      "summary": "Writes Install, the eight Guides sections and the Notes example app."
    },
    {
      "number": 6,
      "title": "In-Depth, the home page and the last links",
      "summary": "Writes In-Depth, rewrites the home page, and reads the whole site once against the plain-English rule."
    }
  ],
  "checks": [
    {
      "id": "the-site-builds",
      "kind": "command",
      "stage": 2,
      "name": "the website builds",
      "argv": [
        "bun",
        "nv",
        "site",
        "--build"
      ],
      "want": [
        "site: built"
      ]
    },
    {
      "id": "the-site-has-the-four-areas-and-none-of-the-retired-pages",
      "kind": "command",
      "stage": 2,
      "name": "the nav is the four areas, Install and Sponsoring, with no retired page and no prev/next",
      "argv": [
        "bun",
        "nv",
        "site",
        "--check",
        "structure"
      ],
      "want": [
        "site structure: ok"
      ]
    },
    {
      "id": "every-snippet-on-the-site-runs-and-matches-its-output",
      "kind": "command",
      "stage": 2,
      "name": "every snippet on the site runs and matches its output, and no page has inline Novis code",
      "argv": [
        "bun",
        "nv",
        "site",
        "--check",
        "snippets"
      ],
      "want": [
        "site snippets: ok"
      ]
    },
    {
      "id": "no-page-covers-a-missing-or-changed-feature",
      "kind": "command",
      "stage": 2,
      "name": "no page covers a missing feature or a feature changed since its stamp",
      "argv": [
        "bun",
        "nv",
        "site",
        "--check",
        "stale"
      ],
      "want": [
        "site stale: ok"
      ]
    },
    {
      "id": "the-stale-guard-tests-pass",
      "kind": "command",
      "stage": 2,
      "name": "the stale guard's own tests pass",
      "argv": [
        "bun",
        "test",
        "tools/nv/cmd/site.test.ts"
      ],
      "want": [
        " 0 fail"
      ]
    },
    {
      "id": "every-handwritten-page-keeps-the-countable-prose-bounds",
      "kind": "command",
      "stage": 2,
      "name": "every handwritten page keeps the countable prose bounds",
      "argv": [
        "bun",
        "nv",
        "site",
        "--check",
        "prose"
      ],
      "want": [
        "site prose: ok"
      ]
    },
    {
      "id": "reference-covers-every-feature-with-no-empty-heading",
      "kind": "command",
      "stage": 3,
      "name": "Reference has a page for every Core, config and CLI feature, every example, and no empty heading",
      "argv": [
        "bun",
        "nv",
        "site",
        "--check",
        "reference"
      ],
      "want": [
        "site reference: ok"
      ]
    },
    {
      "id": "syntax-covers-every-language-and-type-feature",
      "kind": "command",
      "stage": 4,
      "name": "Syntax covers every language and type feature, each page with a snippet and a Do / Don't list",
      "argv": [
        "bun",
        "nv",
        "site",
        "--check",
        "syntax"
      ],
      "want": [
        "site syntax: ok"
      ]
    },
    {
      "id": "guides-has-its-eight-sections",
      "kind": "command",
      "stage": 5,
      "name": "Guides has its eight sections with the counts the goal names",
      "argv": [
        "bun",
        "nv",
        "site",
        "--check",
        "guides"
      ],
      "want": [
        "site guides: ok"
      ]
    },
    {
      "id": "every-example-app-passes-its-tests-and-serves",
      "kind": "command",
      "stage": 5,
      "name": "every example app passes its tests and serves its home page",
      "argv": [
        "bun",
        "nv",
        "site",
        "--check",
        "apps"
      ],
      "want": [
        "site apps: ok"
      ]
    },
    {
      "id": "in-depth-has-its-eight-sections",
      "kind": "command",
      "stage": 6,
      "name": "In-Depth has its eight sections",
      "argv": [
        "bun",
        "nv",
        "site",
        "--check",
        "in-depth"
      ],
      "want": [
        "site in-depth: ok"
      ]
    }
  ],
  "env": {
    "docker": {
      "compose": "tests/db/compose.yaml",
      "services": [
        "postgres",
        "redis"
      ],
      "memoizeOn": [
        "crates/nvs-server",
        "crates/nvs-db",
        "tests/db"
      ]
    },
    "valgrind": {
      "skip": [
        "examples/fatal.nvs",
        "examples/uncaught.nvs"
      ]
    },
    "wsl": {
      "targetDir": "/var/tmp/nvs-target-wsl"
    }
  }
}
