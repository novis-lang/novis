{
  "title": "an unwritten `dispatch` and `static` follow the mode a configuration names",
  "milestone": null,
  "files": [],
  "context": {
    "modules": [
      "crates/nvs-server/src/mount.rs",
      "crates/nvs-cli/src/serve/mounts.rs",
      "crates/nvs-config/src/server.rs",
      "crates/nvs-config/src/cache.rs",
      "crates/nvs-config/src/mode.rs"
    ],
    "rules": [
      "config/a-startup-default-is-never-flipped"
    ],
    "adrs": [],
    "shapes": [
      "A commit message"
    ],
    "playbook": [],
    "plan": [],
    "milestones": []
  },
  "stages": [
    {
      "number": 2,
      "title": "the switches",
      "summary": "Makes `dispatch` and `static` follow the server mode when neither is written."
    },
    {
      "number": 3,
      "title": "the template and the reference",
      "summary": "Says the mode's defaults in the template and the reference, and adds their feature proofs.",
      "context": {
        "rules": [
          "testing/feature-proofs"
        ]
      }
    }
  ],
  "checks": [
    {
      "id": "the-mount-table-reads-an-unwritten-switch-from-the-mode-and",
      "kind": "cargo-named",
      "stage": 2,
      "name": "the mount table reads an unwritten switch from the mode, and a written one as written",
      "args": [
        "test"
      ],
      "tests": [
        "an_unwritten_switch_follows_the_development_mode",
        "a_written_switch_wins_over_the_mode",
        "production_and_no_mode_keep_the_closed_switches"
      ]
    },
    {
      "id": "a-reload-that-changes-only-the-mode-rebuilds-a-core-s-mount",
      "kind": "cargo-named",
      "stage": 2,
      "name": "a reload that changes only the mode rebuilds a core's mount table",
      "args": [
        "test"
      ],
      "tests": [
        "a_snapshot_that_differs_only_in_its_mode_rebuilds_the_table"
      ]
    },
    {
      "id": "the-template-names-the-development-value-of-both-switches",
      "kind": "command",
      "stage": 3,
      "name": "the template names the development value of both switches",
      "argv": [
        "git",
        "grep",
        "-n",
        "in development",
        "--",
        "crates/nvs-config/src/default.toml"
      ],
      "want": [
        "#dispatch = \"entry\"",
        "#static = false"
      ]
    },
    {
      "id": "the-template-still-spells-every-key-with-a-note-saying-what",
      "kind": "command",
      "stage": 3,
      "name": "the template still spells every key with a note saying what unset does",
      "argv": [
        "bun",
        "nv",
        "directives",
        "--check-template"
      ],
      "want": [
        "each saying what unset does"
      ]
    },
    {
      "id": "the-server-chapter-s-server-block-names-the-development",
      "kind": "command",
      "stage": 3,
      "name": "the server chapter's [server] block names the development value of both switches",
      "argv": [
        "git",
        "grep",
        "-n",
        "in development",
        "--",
        "docs/reference/tools/25-server.md"
      ],
      "want": [
        "dispatch           = \"entry\"",
        "static             = false"
      ]
    }
  ],
  "env": {
    "docker": {
      "compose": "tests/db/compose.yaml",
      "services": [
        "postgres",
        "redis"
      ],
      "memoizeOn": [
