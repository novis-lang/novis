        "crates/nvs-db",
        "tests/db"
      ]
    },
    "valgrind": {
      "skip": [
        "examples/fatal.nvs",
        "examples/uncaught.nvs",
        "examples/cache-shared-socket.nvs",
        "examples/queue-sqlite.nvs",
        "examples/cache-shared-tls.nvs"
      ]
    },
    "wsl": {
      "targetDir": "/var/tmp/nvs-target-wsl"
    }
  }
