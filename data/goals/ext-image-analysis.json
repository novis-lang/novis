        "hash_distance_of_a_hash_with_itself_is_zero",
        "hash_distance_refuses_two_hashes_of_different_lengths"
      ]
    },
    {
      "id": "nvs-ext-placeholders-and-palette",
      "kind": "cargo-named",
      "stage": 3,
      "name": "nvs-ext (both placeholders decode to the image's average colour, and the palette returns at most its count, most frequent first)",
      "args": [
        "test",
        "-p",
        "nvs-ext",
        "--test",
        "image_analysis"
      ],
      "tests": [
        "a_blurhash_placeholder_decodes_to_the_image_average_colour",
        "a_thumbhash_placeholder_decodes_to_the_image_average_colour",
        "the_palette_of_a_two_colour_image_returns_those_two_colours",
        "palette_returns_at_most_count_colours"
      ]
    },
    {
      "id": "image-hashes-placeholders-and-palette-run",
