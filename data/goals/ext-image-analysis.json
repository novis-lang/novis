  "checks": [
    {
      "id": "fixture-compare-identical-and-one-pixel",
      "kind": "cargo-named",
      "stage": 2,
      "name": "fixture: `compare` of an image with itself is `identical` with `ssim` 1.0, and of two images differing in one pixel reports `differingPixels: 1`",
      "args": [
        "test",
        "-p",
        "nvs-ext",
        "--test",
        "image_analysis"
      ],
      "tests": [
        "compare_of_an_image_with_itself_is_identical_with_ssim_one",
        "compare_of_two_images_differing_in_one_pixel_reports_one_differing_pixel"
      ]
    },
    {
      "id": "nvs-ext-compare-refuses-renders-and-tolerates",
      "kind": "cargo-named",
      "stage": 2,
      "name": "nvs-ext (`compare` refuses a size mismatch as a `LogicError`, renders a diff on request, honours `tolerance`, and runs each `Image` argument once)",
      "args": [
        "test",
        "-p",
        "nvs-ext",
        "--test",
        "image_analysis"
      ],
      "tests": [
        "compare_refuses_a_size_mismatch_as_a_logic_error",
        "compare_with_render_returns_a_png_marking_the_differing_pixels",
        "compare_within_tolerance_counts_no_difference",
        "compare_of_two_pipelines_runs_each_once"
      ]
    },
    {
      "id": "image-compare-runs-and-refuses",
      "kind": "nvs-suite",
      "stage": 2,
      "name": "`Image::compare` reports an identical image, one differing pixel, and refuses two sizes",
      "args": [
        "test",
        "tests/conformance/"
      ],
      "cases": [
        "tests/conformance/novis/image-compare-of-an-image-with-itself-is-identical.nvst",
        "tests/conformance/novis/image-compare-reports-one-differing-pixel.nvst",
        "tests/conformance/novis/image-compare-refuses-two-sizes.nvst"
      ]
    },
    {
