# looper:begin gitattributes v1
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
# looper:end gitattributes

# Normalise to LF in the repository and in working copies on every platform.
#
# This is not cosmetic. Novis's conformance tests (`.nvst`) compare program output
# byte-for-byte against an expected block, and the lexer must be exercised
# against both line endings deliberately rather than by accident of checkout.
* text=auto eol=lf

# Source and config
*.rs      text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.sh      text eol=lf

# Novis sources and tests
*.nvs     text eol=lf
*.nvst    text eol=lf
*.php     text eol=lf
*.phpt    text eol=lf

# Fixtures that deliberately contain CRLF, to test the lexer's handling of it.
# Anything under a `crlf/` directory is preserved exactly as committed.
**/fixtures/crlf/**  -text

# Windows scripts keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Generated files. Each is committed, and a conflict in one is resolved by taking either side and
# rendering it again (docs/agent/commands.md § *A conflict in a generated file*).
# Written by `bun nv render`, each by its renderer under `tools/nv/renderers/`.
data/schema/*.schema.json                 linguist-generated
data/spec/core-members.json               linguist-generated
crates/nvs-stdlib/src/classes.rs          linguist-generated
website/config/novis.tmLanguage.json      linguist-generated
website/src/data/compare.json             linguist-generated
website/src/data/numbers.json             linguist-generated
# Written by `bun nv render --website`, which reads a built binary.
website/src/data/core.json                linguist-generated
website/src/data/reference.json           linguist-generated
website/public/llms-full.txt              linguist-generated
# Written by `bun nv rules --render` from `data/rules/` and the fragments under `docs/rules/<topic>/`.
docs/rules/*.md                           linguist-generated
docs/ground-rules.md                      linguist-generated

# The perf ledger is append-only, so a merge keeps the lines of both sides.
data/perf/members.ndjson                  merge=union

# Binary
*.png     binary
*.jpg     binary
*.ico     binary
*.nvso    binary
*.nvsx    binary
*.ttf     binary
