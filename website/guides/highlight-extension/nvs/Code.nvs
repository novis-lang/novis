<?nvs
namespace Example\Highlight;

use Core\Html;
use Core\Html\Markup;

/// Writes code as HTML with colors.
final class Code
{
    /// `Code::toHtml` returns `code` as a `<pre>` block, with a class on each token.
    /// The result is `null` when there is no grammar for `language`.
    public static function toHtml(tainted string $language, tainted string $code): ?Markup
    {
        var $tokens = Highlighter::tokens($language, $code);
        if ($tokens == null) {
            return null;
        }
        array<Markup> $parts = [];
        foreach ($tokens as var $token) {
            if ($token->kind == '') {
                $parts[] = html`{$token->text}`;
            } else {
                $parts[] = html`<span class="hl-{$token->kind}">{$token->text}</span>`;
            }
        }
        return html`<pre class="hl"><code>` + Html::join($parts, html``) + html`</code></pre>`;
    }

    /// `Code::styles` returns a `<style>` element with a color for each kind of token.
    public static function styles(): Markup
    {
        return html`<style>
.hl { background: #f6f8fa; padding: 1em; }
.hl-comment { color: #6a737d; }
.hl-string { color: #032f62; }
.hl-number, .hl-constant { color: #005cc5; }
.hl-keyword { color: #d73a49; }
.hl-function { color: #6f42c1; }
.hl-type { color: #22863a; }
.hl-variable { color: #e36209; }
</style>`;
    }
}
