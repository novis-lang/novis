<?nvs
use Core\Html\Markup;

Core\Response::slotted();
var $posts = Core\Html::later(fn(): Markup => {
    Core\Time::sleep(900ms);
    return html`<p>3 new blog posts</p>`;
}, { placeholder: html`<p>Loading posts…</p>` });
var $deals = Core\Html::later(fn(): Markup => {
    Core\Time::sleep(500ms);
    return html`<p>2 deals in the shop</p>`;
}, { placeholder: html`<p>Loading deals…</p>` });
echo html`<h1>Welcome back</h1>`, $posts, $deals;
