<?nvs
// This program uses `Core\Str`, `Core\Arr` and `Core\Response`. Each first argument is the input.
array<string> $colors = Core\Str::split('red,green,blue', ',');
array<string> $sorted = Core\Arr::sort($colors);

// `Core\Response::sendJson` sends the value as JSON.
Core\Response::sendJson({ count: Core\Arr::count($colors), sorted: $sorted });
