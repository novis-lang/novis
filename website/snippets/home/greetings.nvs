<?nvs
// This program builds a greeting for each name in a list and prints it.

var $names = ["Ada", "Grace", "Linus"];

// `Core\Arr::map` calls the function once for each name and returns a new array.
var $greetings = Core\Arr::map($names, fn(string $n): string => Core\Str::format("Hello, %s!", $n));

foreach ($greetings as var $line) {
    echo $line, "\n";
}
