<?nvs
// This program checks an API key without printing it.
secret string $key = "sk-12345";

// `==` works on a secret string. The result is a plain `bool`.
echo $key == "sk-12345" ? "key accepted" : "key rejected", "\n";

// A string built from a secret string is secret too. `echo $header` does not compile.
secret string $header = "Bearer " . $key;
echo $header == "Bearer sk-12345" ? "header ready" : "header wrong", "\n";
