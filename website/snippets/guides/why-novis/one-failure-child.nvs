<?nvs
// This is the file one-failure-child.nvs. With `args: true`, it calls itself until the call stack is too deep.
class Down {
    public static function forever(int $n): int {
        return Down::forever($n + 1) + 1;
    }
}

echo "child started\n";
if (Core\Script::args() == true) {
    echo Down::forever(0), "\n";
}
