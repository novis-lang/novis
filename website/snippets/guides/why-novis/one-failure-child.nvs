<?nvs
// This is the file one-failure-child.nvs. When the parent starts it with `arguments: true`,
// a method calls itself until the call stack is too deep.
class Down
{
    public static function forever(int $n): int
    {
        return Down::forever($n + 1) + 1;
    }
}

echo "child started\n";
if (Core\Script::arguments() == true) {
    echo Down::forever(0), "\n";
}
