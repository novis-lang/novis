<?nvs
// This program keeps a value in a cookie that the client cannot read or change.

// A real server reads its keys from its configuration. This program makes a new one.
array<secret bytes> $keys = [Core\Crypto::generateKey()];

// `seal` encrypts the value. The result is safe to send as a cookie.
string $cookie = Core\SignedCookie::seal("theme=dark", $keys);

// On the next request the client sends the cookie back. `open` returns the value.
// This prints `theme=dark`.
echo Core\SignedCookie::open($cookie, $keys), "\n";

// A cookie that the client changed throws a `RuntimeError`.
try {
    Core\SignedCookie::open("x" . $cookie, $keys);
} catch (RuntimeError $error) {
    echo "the cookie was changed\n";
}
