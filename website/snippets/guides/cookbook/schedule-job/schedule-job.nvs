<?nvs
// This program is a job that the server runs every Monday morning.
class WeeklyReport {
    // Returns the text of the report for the given orders.
    public static function text(array<uint> $orders): string {
        uint $total = 0;
        foreach ($orders as uint $count) {
            $total += $count;
        }
        return "orders last week: " . $total;
    }
}

// A real job would read these numbers from the database.
echo WeeklyReport::text([12, 9, 15, 11, 20, 4, 3]), "\n";
