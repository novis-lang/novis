<?nvs
// This program shows the HTML body of a reply safely.
var $inbox = Core\Imap::open('inbox')->folder('INBOX');
Core\Mail\Message $reply = $inbox->fetch(2);

// `html()` returns a tainted string. It comes from outside your program, so you must check or escape it.
// `Core\Html::sanitize` removes every tag and attribute that is not safe, such as `<script>`.
echo Core\Html::sanitize($reply->html() ?? ''), "\n";
