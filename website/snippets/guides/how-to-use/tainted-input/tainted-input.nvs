<?nvs
// This program reads two values from the address and uses them in a safe way.
// The request is `GET /search?q=<b>tea</b>&page=2`.

// `query` returns a `tainted string`, or `null` if the address has no `q`.
tainted string $search = Core\Request::query("q") ?? "";

// `as ?int` checks the value and gives a plain `int`, or `null`.
int $next = (Core\Request::query("page") as ?int ?? 1) + 1;

// A hole in an `html` template escapes the text, so the `<b>` is shown, not run.
echo html`<p>Results for {$search}</p>`, "\n";
echo "next page: ", $next, "\n";
