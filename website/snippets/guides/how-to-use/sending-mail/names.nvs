<?nvs
// This program sends a mail to an address with a name, and sets the sender name.
use Core\Mail;
use Core\Mail\Address;

Mail::send(
    'shop',
    [Address::of('anna@example.com', 'Anna Schmidt')],
    'Your order',
    'Thank you for your order.',
    { fromName: 'Example Shop Support', replyTo: Address::of('help@example.com', 'Support') },
);

// The sender address is still `shop@example.com`. Only the name is different.
echo "The mail is sent.\n";
