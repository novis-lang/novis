<?nvs
// This program reads a CSV file of sales and prints the total for each product.
class Report {
    // Returns the total amount for each product, with the product name as the key.
    public static function totals(string $path): array<float> {
        array<float> $totals = [];
        // `{header: true}` uses the first line as the column names.
        foreach (Core\Csv::parse(Core\IO::readText($path), {header: true}) as array<string> $row) {
            string $product = $row["product"];
            float $amount = ($row["qty"] as int) * ($row["price"] as float);
            $totals[$product] = ($totals[$product] ?? 0.0) + $amount;
        }
        return $totals;
    }
}

// The program writes a small file first, so that it runs as it is.
string $path = Core\Path::join(Core\IO::temporaryDir(), "sales.csv");
Core\IO::write($path, "product,qty,price\nfig,2,3.50\napple,10,0.40\nfig,1,3.50\n");

foreach (Report::totals($path) as string $product => float $total) {
    echo Core\Str::padEnd($product, 8), Core\Math::round($total, {precision: 2}), "\n";
}
