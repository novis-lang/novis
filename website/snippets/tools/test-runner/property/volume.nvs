<?nvs
// A property test that finds a bug in `limit`.
use Core\Test;
use Core\Test\Property;

final class Volume
{
    // The highest level is 10, but the check uses 100. This is the bug.
    public static function limit(int $level): int
    {
        if ($level > 100) {
            return 10;
        }
        return $level;
    }
}

final class VolumeTest
{
    // `$level` is a generated number from 0 to 1000. The test runs 100 times.
    #[Property(seed: 7, gen: { level: '0..1000' })]
    public function itNeverGoesAboveTen(int $level): void
    {
        Test::assertTrue(Volume::limit($level) <= 10);
    }
}
