$ nvs build --openapi shop.nvs
{
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      },
      "key": {
        "in": "header",
        "name": "X-Api-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "shop",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/orders/{id}": {
      "get": {
        "operationId": "Orders::show",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "success"
          },
          "404": {
            "description": "RuntimeError"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Shows one order.",
        "tags": [
          "Orders"
        ]
      }
    }
  }
}
exit 0
