<?nvs
// A scheduled job that saves three orders and reads them back.

var $db = Core\Db::connect('shop');
$db->execute('create table orders (id integer primary key, total integer not null)', []);
for (int $i = 1; $i <= 3; $i++) {
    $db->execute('insert into orders (id, total) values (?, ?)', [$i, $i * 20]);
}
int $count = 0;
foreach ($db->query('select id from orders', []) as Core\Db\Row $row) {
    $count++;
}
Core\Debug::dump(['orders' => $count]);
Core\Log::write(Core\Log::Level::Info, 'orders imported', ['count' => $count]);
