<?nvs
// A scheduled job whose mail server does not answer.
// Nothing catches the error, so the run fails and the viewer shows its stack.

class Receipts {
    public static function sendAll(array<int> $orders): void {
        foreach ($orders as int $order) {
            Receipts::send($order);
        }
    }

    public static function send(int $order): void {
        throw new RuntimeError('The mail server did not answer.');
    }
}

Receipts::sendAll([1, 2, 3]);
