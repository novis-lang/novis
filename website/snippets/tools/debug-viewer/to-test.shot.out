A test made from this request

Save this test in your project and run it with nvs test .. It sends the same request and checks that the response is the same.

<?nvs
// This test sends the request with the trace id <id> again.
// It checks that the program gives the same response.
use Core\Http\Method;
use Core\Test;

class GetApiNotes<id>Test
{
    #[Test]
public function givesTheRecordedResponse(): void
    {
        array<string> $headers = [
            'user-agent' => 'Bun/1.4.4',
            'accept' => '*/*',
            'host' => '127.0.0.1:<port>',
            'accept-encoding' => 'gzip, deflate, br, zstd',
        ];
        var $response = Test::request(Method::Get, '/api/notes', { headers: $headers });

        Test::assertEquals($response->status(), 200);
        Test::assertEquals($response->header('content-type'), 'application/json');
        Test::assertEquals($response->json(), Core\Json::decode('[]'));
    }
}

