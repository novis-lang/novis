<?nvs
// `secret` says that a string must not be printed or logged.
secret string $token = "hunter2";

// `==` works on a secret string. `echo $token` does not compile.
echo $token == "hunter2" ? "token is correct" : "wrong token", "\n";

// `Core\Secret::reveal` gives a plain string. The second argument says why.
string $shown = Core\Secret::reveal($token, "show it in this example");
echo $shown, "\n";
