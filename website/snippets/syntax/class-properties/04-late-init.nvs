<?nvs
// `LateInit` sets a `lateinit` property the first time a program reads it.
class Post implements LateInit {
    public lateinit array<string> $tags;

    // Novis calls this with the name of the property that has no value.
    public function initProperty(string $name): void {
        echo "loading ", $name, "\n";
        $this->tags = ["news"];
    }
}

var $post = new Post();

// `isinit` tests the property without reading it.
echo isinit($post->tags) ? "set" : "not set", "\n";
echo Core\Json::encode($post->tags), "\n";
echo isinit($post->tags) ? "set" : "not set", "\n";
