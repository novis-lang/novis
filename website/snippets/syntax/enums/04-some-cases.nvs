<?nvs
class Files {
    enum Mode { Read, Write, Delete }

    // This parameter accepts only `Mode::Read` or `Mode::Write`.
    public static function open(Mode::Read|Mode::Write $mode): string {
        return $mode == Mode::Read ? "opened to read" : "opened to write";
    }
}

echo Files::open(Files::Mode::Write), "\n";

// A value of type `Files::Mode` needs `as` to enter the smaller set.
Files::Mode $chosen = Files::Mode::Read;
echo Files::open($chosen as Files::Mode::Read|Files::Mode::Write), "\n";
