<?nvs
// An enum has no methods. The class that contains the enum gives each case a name.
class Logger {
    enum Level { Debug, Info, Warn }

    public static function name(Level $level): string {
        return match ($level) {
            Level::Debug => "debug",
            Level::Info => "info",
            Level::Warn => "warn",
        };
    }

    public static function all(): array<Level> {
        return [Level::Debug, Level::Info, Level::Warn];
    }
}

foreach (Logger::all() as Logger::Level $level) {
    echo Logger::name($level), " ";
}
echo "\n";
