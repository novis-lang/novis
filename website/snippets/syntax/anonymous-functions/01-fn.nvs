<?nvs
// `fn` creates an anonymous function. You can store it in a variable and call it.
callable $double = fn(int $x): int => $x * 2;

// An anonymous function with a block body uses `return`, and must declare its return type.
callable $sum = fn(array<int> $xs): int => {
    int $t = 0;
    foreach ($xs as int $x) {
        $t += $x;
    }
    return $t;
};

echo $double(4), " ", $sum([1, 2, 3]), "\n";
