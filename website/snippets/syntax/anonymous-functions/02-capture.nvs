<?nvs
// An anonymous function captures each outside variable it uses. It copies the value when it is created.
string $prefix = "one";
callable $tag = fn(string $s): string => $prefix . ":" . $s;
$prefix = "two";
// The function still has the old value. This prints `one:x`.
echo $tag("x"), "\n";

class Counter {
    public int $base = 10;

    // Inside a method, an anonymous function can use `$this`.
    public function adder(): callable {
        return fn(int $x): int => $this->base + $x;
    }
}

Counter $c = new Counter();
// This prints `15`.
echo $c->adder()(5), "\n";
