<?nvs
// This program declares two commands and lists them.

interface Command {
    public function usage(): string;
}

class Greet implements Command {
    // A parameter without `#[Core\Option]` is a positional argument.
    #[Core\Command(name: "greet", about: "Say hello")]
    public static function greet(
        tainted string $name,
        #[Core\Option(short: "l", about: "Shout it")] bool $loud,
    ): void {
        echo $name, $loud ? "!" : "", "\n";
    }

    public function usage(): string { return "greet <name> [--loud]"; }
}

class Migrate implements Command {
    // A command that returns `uint` returns its exit status.
    #[Core\Command(name: "migrate", about: "Apply pending migrations")]
    public static function migrate(
        #[Core\Option(about: "Print what would happen")] bool $pretend,
    ): uint {
        if ($pretend) { return 0; }
        return 1;
    }

    public function usage(): string { return "migrate [--pretend]"; }
}

foreach (Core\Program::implementing<Command>() as Command $command) {
    echo $command->usage(), "\n";
}

// The attributes of a command are read like any other attribute.
?{about: string} $about = Core\Attributes::get<{about: string}>(Greet::greet(...));
echo "greet: ", $about?->about ?? "", "\n";
?{about: string} $loud = Core\Attributes::get<{about: string}>(Greet::greet(...), "loud");
echo "--loud: ", $loud?->about ?? "", "\n";
