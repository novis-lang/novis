{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "GENERATED by bun nv render — do not edit",
  "name": "Novis",
  "aliases": [
    "novis",
    "nvs"
  ],
  "scopeName": "source.nvs",
  "patterns": [
    {
      "include": "#shebang"
    },
    {
      "include": "#code-mode"
    },
    {
      "include": "#code"
    }
  ],
  "injections": {
    "L:source.nvs -meta.embedded": {
      "patterns": [
        {
          "include": "#code-mode"
        }
      ]
    }
  },
  "repository": {
    "code-mode": {
      "name": "meta.embedded.block.nvs",
      "begin": "(<\\?nvs(?=[\\s?]|$)|<\\?=)|((?i:<\\?php)(?=[\\s?]|$)|(?i:<\\?nvs)(?=[\\s?]|$))",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.nvs"
        },
        "2": {
          "name": "invalid.illegal.open-tag.nvs"
        }
      },
      "end": "(\\?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.nvs"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "shebang": {
      "name": "meta.embedded.block.nvs",
      "begin": "^(#!.*)$",
      "beginCaptures": {
        "1": {
          "name": "comment.line.number-sign.shebang.nvs"
        }
      },
      "end": "(\\?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.nvs"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "inline-html": {
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "code": {
      "patterns": [
        {
          "include": "#attribute"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#contextual-keywords"
        },
        {
          "include": "#legacy-cast"
        },
        {
          "include": "#type-alias"
        },
        {
          "include": "#signature"
        },
        {
          "include": "#names"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#types"
        }
      ]
    },
    "attribute": {
      "name": "meta.attribute.nvs",
      "begin": "(#\\[)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.attribute.begin.nvs"
        }
      },
      "end": "(\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.attribute.end.nvs"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.nvs",
          "match": "///(?!/).*$"
        },
        {
          "name": "comment.line.double-slash.nvs",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.nvs",
          "match": "#(?!\\[).*$"
        },
        {
          "name": "comment.block.nvs",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "legacy-cast": {
      "match": "\\(\\s*(?:int|uint|float|string|bool|array|object)\\s*\\)\\s*(?=[$!~@+\\-\\w\"'(\\[])"
    },
    "names": {
      "patterns": [
        {
          "match": "(?<![$\\w])(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.nvs"
            },
            "2": {
              "name": "entity.name.type.class.nvs"
            }
          }
        },
        {
          "match": "(?<![$\\w])(interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.nvs"
            },
            "2": {
              "name": "entity.name.type.interface.nvs"
            }
          }
        },
        {
          "match": "(?<![$\\w])(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.nvs"
            },
            "2": {
              "name": "entity.name.type.enum.nvs"
            }
          }
        },
        {
          "match": "(?<![$\\w])(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.other.nvs"
            },
            "2": {
              "name": "entity.name.namespace.nvs"
            }
          }
        },
        {
          "match": "(\\?->|->|::)\\s*(class)\\b",
          "captures": {
            "1": {
              "name": "punctuation.accessor.nvs"
            },
            "2": {
              "name": "keyword.other.nvs"
            }
          }
        },
        {
          "match": "(\\?->|->|::)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.nvs"
            },
            "2": {
              "name": "variable.other.property.nvs"
            }
          }
        },
        {
          "name": "variable.language.nvs",
          "match": "\\$this\\b"
        },
        {
          "name": "variable.other.nvs",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nvs",
          "match": "(?<![$\\w])(?<!->)(?<!::)(?:break|case|catch|continue|default|do|elseif|else|finally|foreach|for|goto|if|match|return|switch|throw|try|while|yield)\\b"
        },
        {
          "name": "keyword.operator.nvs",
          "match": "(?<![$\\w])(?<!->)(?<!::)(?:and|as|instanceof|is|or|xor)\\b"
        },
        {
          "name": "keyword.other.nvs",
          "match": "(?<![$\\w])(?<!->)(?<!::)(?:autoload|clone|declare|die|echo|empty|eval|exit|extract|global|include_once|include|isset|list|namespace|new|print|require_once|require|settype|unset|use)\\b"
        },
        {
          "name": "storage.type.class.nvs",
          "match": "(?<![$\\w])(?<!->)(?<!::)(?:class|enum|interface|trait)\\b"
        },
        {
          "name": "storage.type.function.nvs",
          "match": "(?<![$\\w])(?<!->)(?<!::)(?:function|fn)\\b"
        },
        {
          "name": "storage.type.nvs",
          "match": "(?<![$\\w])(?<!->)(?<!::)(?:array|bool|bytes|callable|const|decimal|float|int|iterable|let|mixed|never|object|string|uint|var|void)\\b"
        },
        {
          "name": "storage.modifier.nvs",
          "match": "(?<![$\\w])(?<!->)(?<!::)(?:abstract|extends|final|implements|inout|insteadof|lateinit|private|protected|public|readonly|secret|static|tainted)\\b"
        },
        {
          "name": "constant.language.nvs",
          "match": "(?<![$\\w])(?<!->)(?<!::)(?:false|null|true)\\b"
        },
        {
          "name": "variable.language.nvs",
          "match": "(?<![$\\w])(?<!->)(?<!::)(?:parent|self)\\b"
        }
      ]
    },
    "type-alias": {
      "begin": "(?<![$\\w])(type)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?==)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.nvs"
        },
        "2": {
          "name": "entity.name.type.nvs"
        }
      },
      "end": "(?=;)|(?=\\?>)",
      "patterns": [
        {
          "include": "#type"
        }
      ]
    },
    "signature": {
      "begin": "(?<![$\\w])(function|fn)\\s*([A-Za-z_][A-Za-z0-9_]*)?\\s*(?=\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.nvs"
        },
        "2": {
          "name": "entity.name.function.nvs"
        }
      },
      "end": "(?==>)|(?=;)|(?=\\{(?![ \\t]*[A-Za-z_][A-Za-z0-9_]*[ \\t]*:))",
      "patterns": [
        {
          "include": "#return-type"
        },
        {
          "include": "#code"
        }
      ]
    },
    "return-type": {
      "begin": "(\\))\\s*(:)",
      "end": "(?==>)|(?=[;,)$])|(?=\\{(?![ \\t]*[A-Za-z_][A-Za-z0-9_]*[ \\t]*:))",
      "patterns": [
        {
          "include": "#type"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.nvs",
          "match": "(?<![$\\w\\\\])[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*(?=\\s*(?:\\.\\.\\.)?\\s*\\$)"
        },
        {
          "name": "entity.name.type.nvs",
          "match": "(?<![$\\w\\\\])[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*=)"
        },
        {
          "name": "entity.name.type.nvs",
          "match": "(?<=<)[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*(?=\\s*[,>])"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "include": "#shape-type"
        },
        {
          "include": "#type-parens"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "name": "entity.name.type.nvs",
          "match": "(?<![$\\w\\\\])[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*"
        }
      ]
    },
    "shape-type": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": {
              "name": "variable.other.property.nvs"
            }
          }
        },
        {
          "include": "#type"
        }
      ]
    },
    "type-parens": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#type"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.nvs",
          "match": "(?<![\\w.$])(?=\\d)(?:\\d[\\d_]*w)?(?:\\d[\\d_]*d)?(?:\\d[\\d_]*h)?(?:\\d[\\d_]*m)?(?:\\d[\\d_]*s)?(?:\\d[\\d_]*ms)?(?:\\d[\\d_]*us)?(?:\\d[\\d_]*ns)?(?![\\w.])"
        },
        {
          "name": "constant.numeric.nvs",
          "match": "(?<![\\w.$])0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.nvs",
          "match": "(?<![\\w.$])0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.nvs",
          "match": "(?<![\\w.$])0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.nvs",
          "match": "(?<![\\w.$])\\d[\\d_]*(?:\\.[\\d_]*)?(?:[eE][-+]?\\d[\\d_]*)?"
        }
      ]
    },
    "contextual-keywords": {
      "patterns": [
        {
          "match": "(?<![$\\w])(spawn)\\s+(script)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.nvs"
            },
            "2": {
              "name": "keyword.control.nvs"
            }
          }
        },
        {
          "match": "(?<![$\\w])(public|private|protected)\\s*\\(\\s*(set)\\s*\\)",
          "captures": {
            "1": {
              "name": "storage.modifier.nvs"
            },
            "2": {
              "name": "keyword.other.nvs"
            }
          }
        },
        {
          "name": "keyword.control.nvs",
          "match": "(?<![$\\w])await\\b(?=\\s+[$\\\\A-Za-z_])"
        },
        {
          "name": "keyword.other.nvs",
          "match": "(?<![$\\w])by\\b(?=\\s+\\$)"
        },
        {
          "name": "keyword.other.nvs",
          "match": "(?<![$\\w])(?:from|discover)\\b(?=\\s*['\"$])"
        },
        {
          "name": "keyword.other.nvs",
          "match": "(?<![$\\w])(?:get|set)\\b(?=\\s*(?:\\{|=>))"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#nowdoc"
        },
        {
          "include": "#heredoc"
        },
        {
          "include": "#single-quoted"
        },
        {
          "include": "#double-quoted"
        },
        {
          "include": "#html-template"
        }
      ]
    },
    "html-template": {
      "name": "string.quoted.other.html-template.nvs",
      "begin": "(html`)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.nvs"
        }
      },
      "end": "(`)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.nvs"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.nvs",
          "match": "\\\\[`{]"
        },
        {
          "include": "#escape"
        },
        {
          "include": "#html-template-echo-hole"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "html-template-echo-hole": {
      "name": "meta.embedded.line.nvs",
      "begin": "(<\\?=)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.nvs"
        }
      },
      "end": "(\\?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.nvs"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "single-quoted": {
      "name": "string.quoted.single.nvs",
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nvs"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nvs"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.nvs",
          "match": "\\\\['\\\\]"
        }
      ]
    },
    "double-quoted": {
      "name": "string.quoted.double.nvs",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.nvs"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.nvs"
        }
      },
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "heredoc": {
      "name": "string.unquoted.heredoc.nvs",
      "begin": "(<<<[ \\t]*(\"|)([A-Za-z_][A-Za-z0-9_]*)\\2)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.nvs"
        }
      },
      "end": "^[ \\t]*(\\3)(?![A-Za-z0-9_])",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.nvs"
        }
      },
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "nowdoc": {
      "name": "string.unquoted.nowdoc.nvs",
      "begin": "(<<<[ \\t]*'([A-Za-z_][A-Za-z0-9_]*)')[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.nvs"
        }
      },
      "end": "^[ \\t]*(\\2)(?![A-Za-z0-9_])",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.nvs"
        }
      }
    },
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.nvs",
          "match": "\\\\(?:[nrtvef\"$\\\\]|[0-7]{1,3}|x[0-9A-Fa-f]{1,2}|u\\{[0-9A-Fa-f]+\\})"
        },
        {
          "name": "invalid.illegal.escape.nvs",
          "match": "\\\\u\\{[0-9A-Fa-f]*\\}?"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "include": "#complex-interpolation"
        },
        {
          "include": "#simple-interpolation"
        }
      ]
    },
    "complex-interpolation": {
      "name": "meta.embedded.line.nvs",
      "begin": "(\\{)(?=\\$)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.nvs"
        }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.end.nvs"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "simple-interpolation": {
      "match": "(\\$[A-Za-z_][A-Za-z0-9_]*)(?:(->)([A-Za-z_][A-Za-z0-9_]*)|\\[(?:(-?[A-Za-z0-9_]+)|(\\$[A-Za-z_][A-Za-z0-9_]*))\\])?",
      "captures": {
        "1": {
          "name": "variable.other.nvs"
        },
        "2": {
          "name": "punctuation.accessor.nvs"
        },
        "3": {
          "name": "variable.other.property.nvs"
        },
        "4": {
          "name": "constant.other.nvs"
        },
        "5": {
          "name": "variable.other.nvs"
        }
      }
    }
  }
}
