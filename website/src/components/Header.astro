---
/**
 * Header override: the default Starlight header (the mark, search, social
 * icons, theme switch) plus the site navigation — Novis / Docs / Why Novis? /
 * Sponsoring.
 *
 * The mark comes from Starlight's `logo` option (see astro.config.ts) through
 * `<SiteTitle />`, and stands in for the wordmark, which the nav's first link
 * repeats anyway; its size is set below, because the default suits a wide
 * logo rather than a square one.
 *
 * Layout follows the default component so the search stays centered over the
 * content column; the nav sits between the title and the search.
 */
import config from 'virtual:starlight/user-config'

import { withBase } from '~/lib/base'

import LanguageSelect from 'virtual:starlight/components/LanguageSelect'
import Search from 'virtual:starlight/components/Search'
import SiteTitle from 'virtual:starlight/components/SiteTitle'
import SocialIcons from 'virtual:starlight/components/SocialIcons'
import ThemeSelect from 'virtual:starlight/components/ThemeSelect'

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro'

const nav = [
  { label: 'Novis', href: withBase('/') },
  { label: 'Docs', href: withBase('/docs/') },
  { label: 'Why Novis?', href: withBase('/why-novis/') },
  { label: 'Sponsoring', href: withBase('/sponsoring/') },
]

const { pathname } = Astro.url
const home = withBase('/')
const isCurrent = (href: string) =>
  href === home ? pathname === home : pathname === href || pathname.startsWith(href)
---

<div class="header">
  <div class="start-group">
    <div class="title-wrapper sl-flex">
      <SiteTitle />
    </div>
    <nav class="site-nav sl-hidden md:sl-flex print:hidden" aria-label="Site">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="sl-flex print:hidden search-wrapper">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  /* The mark and the nav links are each centered in the bar. With the
     wordmark hidden there is one text size in this row, so centering the
     boxes is enough: the links share a baseline with each other, and the mark
     sits on the bar's midline. */
  .start-group {
    --mark-size: 2.25rem;
    display: flex;
    align-items: center;
    gap: calc(var(--sl-nav-gap) + 0.5rem);
    min-width: 0;
  }
  @media (max-width: 50rem) {
    .start-group {
      --mark-size: 1.9rem;
    }
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  /* Starlight sizes a logo to the nav height less its padding, which suits a
     wide wordmark. Ours is a square mark inside a 512px export that carries
     ~7% transparent margin of its own, so the box is set a little larger to
     land the mark itself at the nav's text height. */
  .title-wrapper :global(.site-title img) {
    box-sizing: border-box;
    height: var(--mark-size);
    width: var(--mark-size);
    padding: 0.125rem;
    border-radius: 0.5rem;
  }
  /* In the dark theme the mark stands on a white rounded tile, as it does on
     the home-screen icon; the padding above is what keeps the crimson off the
     tile's edge, and it stays in the light theme so the mark is the same size
     in both. The light theme is the opted-in one, so "dark" is its absence. */
  :global(:root:not([data-theme='light'])) .title-wrapper :global(.site-title img) {
    background: white;
  }

  .site-nav {
    gap: 1.25rem;
    align-items: center;
  }
  .site-nav a {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    padding: 0.3rem 0.1rem;
    border-bottom: 2px solid transparent;
    transition: color 120ms ease;
  }
  .site-nav a:hover {
    color: var(--sl-color-white);
  }
  .site-nav a[aria-current='page'] {
    color: var(--sl-color-text-accent);
    border-bottom-color: var(--sl-color-text-accent);
  }

  .search-wrapper {
    flex: 1 1 auto;
    justify-content: flex-end;
    min-width: 0;
  }

  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
</style>
