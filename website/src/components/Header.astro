---
/**
 * Header override: the default Starlight header (the mark, search, social
 * icons, theme switch) plus the site navigation: the five areas from AREAS in
 * config/site.mjs, each with its subtitle on a second, smaller line, then
 * Install as the bar's one primary button, then the links in NAV_EXTRAS.
 *
 * `<SiteTitle />` (src/components/SiteTitle.astro) is the mark with the name
 * Novis-Lang beside it, on two lines, and links to the home page. The mark's
 * size is set below, because the default suits a wide logo and not a square one.
 *
 * The theme select is an icon alone, styled below.
 *
 * Every item in the bar is centered on the bar's midline. The mark and Install
 * never shrink and never move. When the bar is too narrow for everything, the
 * script at the end of the bar removes parts until the bar fits, in this
 * order: the subtitles, the social icons (they are in the footer too), the
 * search button's text, and then the links one at a time, from the end. A
 * removed link moves into the More menu, which shows each link with its
 * subtitle. More appears only when it has a link in it. It is orange when the
 * current page is one of its links. The script measures the bar instead of
 * using fixed widths, so a new link in AREAS or NAV_EXTRAS needs no change
 * here. It runs again only when the bar changes width or the fonts finish
 * loading. Without JavaScript every link stays in the bar.
 *
 * Below 50rem the whole navigation moves into the mobile menu, and the bar
 * keeps two links beside the mark: the first area and Install. Below 22rem
 * only Install stays.
 */
import config from 'virtual:starlight/user-config'

import { Icon } from '@astrojs/starlight/components'
import { AREAS, INSTALL, NAV_EXTRAS } from '@config/site.mjs'
import { withBase } from '~/lib/base'

import LanguageSelect from 'virtual:starlight/components/LanguageSelect'
import Search from 'virtual:starlight/components/Search'
import SocialIcons from 'virtual:starlight/components/SocialIcons'
import ThemeSelect from 'virtual:starlight/components/ThemeSelect'

import SiteTitle from './SiteTitle.astro'

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro'

const install = { ...INSTALL, href: withBase(INSTALL.href) }
/** Every link that can move into More, in bar order. `item` pairs a bar link with its copy in the menu. */
const links = [...AREAS, ...NAV_EXTRAS].map((link, item) => ({ ...link, href: withBase(link.href), item }))
const areas = links.slice(0, AREAS.length)
const extras = links.slice(AREAS.length)

const { pathname } = Astro.url
const current = (href: string) => (pathname.startsWith(href) ? 'page' : undefined)
---

<div class="header">
  <div class="start-group">
    <div class="title-wrapper sl-flex">
      <SiteTitle />
    </div>
    <nav class="site-nav sl-hidden md:sl-flex print:hidden" aria-label="Site">
      {
        areas.map((area) => (
          <a href={area.href} aria-current={current(area.href)} class="area" data-nav-item={area.item}>
            <span class="area-label">{area.label}</span>
            <span class="area-subtitle">{area.subtitle}</span>
          </a>
        ))
      }
      <a href={install.href} aria-current={current(install.href)} class="install">
        {install.label}
      </a>
      {
        extras.map((link) => (
          <a href={link.href} aria-current={current(link.href)} class="area" data-nav-item={link.item}>
            <span class="area-label">{link.label}</span>
          </a>
        ))
      }
      <button type="button" class="more-button" popovertarget="nv-more-menu" hidden>
        More
        <Icon name="down-caret" size="0.9em" />
      </button>
    </nav>
    <div id="nv-more-menu" class="more-menu print:hidden" popover>
      {
        links.map((link) => (
          <a href={link.href} aria-current={current(link.href)} data-nav-item={link.item} hidden>
            <span class="more-label">{link.label}</span>
            <span class="more-subtitle">{link.subtitle}</span>
          </a>
        ))
      }
    </div>
    <nav class="phone-nav print:hidden" aria-label="Quick links">
      <a href={areas[0].href} aria-current={current(areas[0].href)}>{areas[0].label}</a>
      <a href={install.href} aria-current={current(install.href)} class="install">
        {install.label}
      </a>
    </nav>
  </div>
  <div class="sl-flex print:hidden search-wrapper">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
  <script is:inline aria-hidden="true">
    // Fits the bar to its width; the doc comment at the top of this file
    // gives the order. The script is inline and last in the bar, so it runs
    // while the page is parsed, before the first paint. Each run starts from
    // the full bar and removes one part at a time until nothing overflows.
    ;(() => {
      try {
        const bar = document.currentScript.parentElement
        const button = bar.querySelector('.more-button')
        const menu = bar.querySelector('.more-menu')
        // Each bar link with its copy in the menu, the last link first.
        const pairs = [...bar.querySelectorAll('.site-nav [data-nav-item]')]
          .map((link) => [link, menu.querySelector(`[data-nav-item="${link.dataset.navItem}"]`)])
          .reverse()
        const wide = matchMedia('(min-width: 50rem)')
        const steps = ['subtitles', 'social', 'search']
        const overflows = () => bar.scrollWidth > bar.clientWidth + 1
        let moved = 0
        const fit = () => {
          bar.removeAttribute('data-squeeze')
          button.hidden = true
          for (const [link, copy] of pairs) {
            link.hidden = false
            copy.hidden = true
          }
          let count = 0
          if (wide.matches) {
            const removed = []
            for (const step of steps) {
              if (!overflows()) break
              removed.push(step)
              bar.setAttribute('data-squeeze', removed.join(' '))
            }
            if (overflows()) button.hidden = false
            for (const [link, copy] of pairs) {
              if (button.hidden || !overflows()) break
              link.hidden = true
              copy.hidden = false
              count++
            }
          }
          button.toggleAttribute(
            'data-current',
            pairs.some(([link]) => link.hidden && link.hasAttribute('aria-current')),
          )
          if (count !== moved && menu.matches(':popover-open')) menu.hidePopover()
          moved = count
        }
        // The menu opens under the More button, inside the window.
        menu.addEventListener('beforetoggle', (event) => {
          if (event.newState !== 'open') return
          const at = button.getBoundingClientRect()
          const width = parseFloat(getComputedStyle(menu).width)
          const right = document.documentElement.clientWidth - 8
          menu.style.top = `${at.bottom + 6}px`
          menu.style.left = `${Math.max(8, Math.min(at.left, right - width))}px`
        })
        fit()
        new ResizeObserver(fit).observe(bar)
        if (document.fonts) document.fonts.ready.then(fit)
      } catch {}
    })()
  </script>
</div>

<style>
  .header {
    display: flex;
    gap: var(--nv-space-4);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .start-group {
    --mark-size: 2rem;
    display: flex;
    align-items: center;
    gap: var(--nv-space-5);
    min-width: 0;
  }
  @media (max-width: 50rem) {
    .start-group {
      --mark-size: 1.75rem;
      gap: var(--nv-space-3);
    }
  }
  /* The mark and the links keep their width. When they do not fit, the bar
     overflows, and the script at the end of the bar sees that and removes
     parts until it fits. */
  @media (min-width: 50rem) {
    .start-group {
      flex-shrink: 0;
    }
  }
  .header [hidden] {
    display: none !important;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  /* Starlight sizes a logo to the nav height less its padding, which suits a
     wide wordmark. Ours is a square mark that all but fills its square image,
     so the box clears the nav's text height by the padding alone and the disc
     itself lands on that height. */
  .title-wrapper :global(.site-title img) {
    box-sizing: border-box;
    height: var(--mark-size);
    width: var(--mark-size);
    padding: 0.125rem;
    border-radius: 0.5rem;
    transition: transform var(--nv-slow) var(--nv-ease);
  }
  .title-wrapper :global(.site-title:hover img) {
    transform: rotate(-8deg) scale(1.05);
  }
  /* In the dark theme the mark stands on a white rounded tile, as it does on
     the home-screen icon; the padding above is what keeps the disc's edge off
     the tile's, and it stays in the light theme so the mark is the same size
     in both. The light theme is the opted-in one, so "dark" is its absence. */
  :global(:root:not([data-theme='light'])) .title-wrapper :global(.site-title img) {
    background: white;
  }

  .site-nav {
    gap: var(--nv-space-1);
    align-items: center;
  }
  .site-nav a {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.25rem 0.7rem;
    border-radius: var(--nv-radius);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--nv-fast) var(--nv-ease),
      background-color var(--nv-fast) var(--nv-ease);
  }
  .site-nav a:hover {
    color: var(--sl-color-white);
    background-color: var(--nv-hover);
  }
  .site-nav a:not(.install):active {
    background-color: var(--nv-wash);
  }
  /* The current area: orange text and a short bar under it. More looks the
     same when the current page is one of its links. */
  .site-nav a:not(.install)::after,
  .more-button::after {
    content: '';
    position: absolute;
    inset-inline: 0.7rem;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--sl-color-accent);
    transform: scaleX(0);
    transition: transform var(--nv-slow) var(--nv-ease);
  }
  .site-nav a[aria-current='page']:not(.install) {
    color: var(--sl-color-text-accent);
  }
  .site-nav a[aria-current='page']:not(.install)::after,
  .more-button[data-current]::after {
    transform: scaleX(1);
  }
  .site-nav .area-subtitle {
    margin-top: 0.1rem;
    font-size: var(--sl-text-2xs);
    font-weight: 500;
    color: var(--sl-color-gray-3);
  }
  .site-nav .area {
    min-height: 2.75rem;
  }
  .header[data-squeeze~='subtitles'] .area-subtitle {
    display: none;
  }
  .header[data-squeeze~='subtitles'] .site-nav .area {
    min-height: 2.5rem;
  }

  /* More: a plain link in the bar with a caret, and the menu it opens. */
  .more-button {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.5rem;
    margin: 0;
    padding: 0.25rem 0.6rem 0.25rem 0.7rem;
    border: 0;
    border-radius: var(--nv-radius);
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 650;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--nv-fast) var(--nv-ease),
      background-color var(--nv-fast) var(--nv-ease);
  }
  .more-button:hover {
    color: var(--sl-color-white);
    background-color: var(--nv-hover);
  }
  .more-button:active {
    background-color: var(--nv-wash);
  }
  .more-button[data-current] {
    color: var(--sl-color-text-accent);
  }
  .more-menu {
    position: fixed;
    inset: auto;
    width: 15rem;
    margin: 0;
    padding: 0.25rem;
    border: 1px solid var(--nv-hairline-strong);
    border-radius: var(--nv-radius);
    background-color: var(--sl-color-bg-nav);
    color: inherit;
    box-shadow: var(--nv-shadow-lg);
  }
  .more-menu a {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--nv-radius-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    line-height: 1.2;
  }
  .more-menu a:hover,
  .more-menu a:focus-visible {
    background-color: var(--nv-hover);
    color: var(--sl-color-white);
  }
  .more-menu a[aria-current='page'] {
    color: var(--sl-color-text-accent);
  }
  .more-label {
    font-size: var(--sl-text-sm);
    font-weight: 650;
  }
  .more-subtitle {
    font-size: var(--sl-text-2xs);
    font-weight: 500;
    color: var(--sl-color-gray-3);
  }

  /* Install: the one primary button in the bar. */
  .site-nav a.install {
    min-height: 2.25rem;
    margin-inline: var(--nv-space-2);
    padding: 0 1rem;
    border: 1px solid color-mix(in oklab, var(--nv-crimson-fill) 80%, black);
    border-radius: var(--nv-radius-pill);
    background-color: var(--nv-crimson-fill);
    background-image: linear-gradient(180deg, color-mix(in oklab, white 14%, transparent), transparent 70%);
    color: white;
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 22%, transparent),
      0 4px 14px -6px color-mix(in oklab, var(--nv-crimson) 70%, transparent);
    transition:
      transform var(--nv-fast) var(--nv-ease),
      box-shadow var(--nv-slow) var(--nv-ease);
  }
  .site-nav a.install:hover {
    color: white;
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white 22%, transparent),
      0 8px 20px -6px color-mix(in oklab, var(--nv-crimson) 80%, transparent);
  }
  .site-nav a.install:active {
    transform: translateY(0);
    background-image: none;
  }

  /* The two links in the bar on a phone: the first area as plain text, and
     Install as a small crimson pill. */
  .phone-nav {
    display: flex;
    align-items: center;
    gap: var(--nv-space-1);
  }
  .phone-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: 0.65rem;
    border-radius: var(--nv-radius-pill);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  .phone-nav a:not(.install):hover,
  .phone-nav a:not(.install):active {
    color: var(--sl-color-white);
    background-color: var(--nv-hover);
  }
  .phone-nav a[aria-current='page']:not(.install) {
    color: var(--sl-color-text-accent);
  }
  .phone-nav a.install {
    min-height: 2rem;
    padding-inline: 0.85rem;
    border: 1px solid color-mix(in oklab, var(--nv-crimson-fill) 80%, black);
    background-color: var(--nv-crimson-fill);
    background-image: linear-gradient(180deg, color-mix(in oklab, white 14%, transparent), transparent 70%);
    color: white;
    box-shadow: inset 0 1px 0 color-mix(in oklab, white 22%, transparent);
  }
  .phone-nav a.install:active {
    background-image: none;
  }
  @media (max-width: 22rem) {
    .phone-nav a:not(.install) {
      display: none;
    }
  }
  @media (min-width: 50rem) {
    .phone-nav {
      display: none;
    }
  }

  .search-wrapper {
    flex: 1 1 auto;
    justify-content: flex-end;
  }
  /* The search button is never narrower than its text, so a bar that is too
     full overflows instead of squeezing it. When space is short, it is the
     magnifier alone. */
  @media (min-width: 50rem) {
    .search-wrapper :global(button[data-open-modal]) {
      min-width: max-content;
    }
    .header[data-squeeze~='search'] .search-wrapper :global(button[data-open-modal]) {
      justify-content: center;
      width: 2.5rem;
      min-width: 0;
      padding: 0;
    }
    .header[data-squeeze~='search'] .search-wrapper :global(button[data-open-modal] > :not(svg)) {
      display: none !important;
    }
  }

  .right-group {
    gap: var(--nv-space-3);
    align-items: center;
  }
  .social-icons {
    gap: var(--nv-space-1);
    align-items: center;
  }
  .social-icons::after {
    content: '';
    height: 1.5rem;
    margin-inline-start: var(--nv-space-2);
    border-inline-end: 1px solid var(--nv-hairline-strong);
  }

  /* The theme select is an icon tile, the size of the social icons. The icon
     shows the current choice: a sun, a moon, or a laptop for the system
     setting. The select's text and caret are hidden, and the select still
     covers the whole tile, so a click opens the usual list. Its label stays
     for screen readers. */
  .right-group :global(starlight-theme-select label) {
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--nv-radius);
    transition:
      color var(--nv-fast) var(--nv-ease),
      background-color var(--nv-fast) var(--nv-ease);
  }
  .right-group :global(starlight-theme-select label:hover) {
    background-color: var(--nv-hover);
  }
  .right-group :global(starlight-theme-select label:active) {
    background-color: var(--nv-wash);
  }
  .right-group :global(starlight-theme-select .label-icon) {
    inset: 0;
    margin: auto;
    transform: none;
    font-size: 1rem;
  }
  .right-group :global(starlight-theme-select .caret) {
    display: none;
  }
  .right-group :global(starlight-theme-select select) {
    position: absolute;
    inset: 0;
    width: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-radius: inherit;
    color: transparent;
  }
  /* Where the browser lets a page style a select's list (Chrome and Edge),
     the list is a small panel under the tile, aligned to its right edge.
     Each choice has room around it, a hover color, and the current one is
     orange with a check mark. Other browsers show their own list. */
  .right-group :global(starlight-theme-select select),
  .right-group :global(starlight-theme-select select::picker(select)) {
    appearance: base-select;
  }
  .right-group :global(starlight-theme-select select::picker-icon) {
    display: none;
  }
  .right-group :global(starlight-theme-select select::picker(select)) {
    position-area: block-end span-inline-start;
    margin-block-start: var(--nv-space-1);
    min-width: 8rem;
    padding: 0.25rem;
    border: 1px solid var(--nv-hairline-strong);
    border-radius: var(--nv-radius);
    background-color: var(--sl-color-bg-nav);
    box-shadow: var(--nv-shadow-lg);
  }
  .right-group :global(starlight-theme-select option) {
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--nv-radius-sm);
    background-color: transparent;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    cursor: pointer;
  }
  .right-group :global(starlight-theme-select option:hover),
  .right-group :global(starlight-theme-select option:focus-visible) {
    background-color: var(--nv-hover);
    color: var(--sl-color-white);
    outline: none;
  }
  .right-group :global(starlight-theme-select option:checked) {
    color: var(--sl-color-text-accent);
  }
  .right-group :global(starlight-theme-select option::checkmark) {
    order: 1;
    margin-inline-start: auto;
  }

  .header[data-squeeze~='social'] .social-icons {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .title-wrapper :global(.site-title:hover img) {
      transform: none;
    }
  }
</style>
