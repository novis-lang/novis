---
/**
 * Starlight's ThemeProvider, with one change: **light is the default.**
 *
 * Starlight ships dark-first and falls back to `prefers-color-scheme`. This
 * site is designed light-first, so a visitor with no stored preference gets
 * light regardless of their OS setting. A visitor who *chooses* dark, or who
 * chooses `auto`, still gets exactly what they chose — the toggle in the header
 * is Starlight's own and is untouched.
 *
 * Setting `data-theme` here is not enough on its own. Starlight's
 * `<ThemeSelect>` runs a moment later and calls `onThemeChange(loadTheme())`
 * in its custom element's constructor; with nothing in storage that resolves
 * to `auto`, which reads the OS preference and puts the page straight back
 * into dark. So the default is recorded *in storage* rather than only on the
 * element, and ThemeSelect then agrees with us instead of undoing us.
 *
 * The distinction that makes this safe: Starlight writes `''` for "auto" and
 * leaves the key absent when the visitor has never chosen. Only the absent
 * case is filled in, so someone who deliberately picked "Auto" keeps it.
 *
 * KNOWN COUPLING. This file reimplements a Starlight internal contract: the
 * `window.StarlightThemeProvider.updatePickers()` function that
 * `<ThemeSelect>` calls, the `#theme-icons` template it reads, and the
 * `starlight-theme` storage key and its `''`-means-auto encoding. If a
 * Starlight upgrade breaks the theme toggle, this file is the first place to
 * look — diff it against
 * `node_modules/@astrojs/starlight/components/ThemeProvider.astro` and
 * `ThemeSelect.astro`. `python site.py check` warns when either has drifted.
 */
---

<script is:inline>
  window.StarlightThemeProvider = (() => {
    const KEY = 'starlight-theme';

    /**
     * The visitor's choice: 'light' | 'dark' | 'auto', or null if they have
     * never made one. Starlight writes '' for auto, which is why an empty
     * string is not the same as an absent key here.
     */
    function storedTheme() {
      try {
        const v = localStorage.getItem(KEY);
        if (v === null) return null;
        return v === 'light' || v === 'dark' ? v : 'auto';
      } catch {
        // Private mode, disabled storage, embedded webview.
        return null;
      }
    }

    function resolve(choice) {
      if (choice === 'dark' || choice === 'light') return choice;
      if (choice === 'auto') {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      // Never chosen. This is the line that differs from upstream, which
      // would fall through to the OS preference here.
      return 'light';
    }

    let choice = storedTheme();
    if (choice === null) {
      choice = 'light';
      // Record it, or ThemeSelect resolves the empty state as 'auto' and
      // flips the page back on a dark-mode machine.
      try {
        localStorage.setItem(KEY, 'light');
      } catch {
        /* storage unavailable; the attribute below still holds for this page */
      }
    }
    document.documentElement.dataset.theme = resolve(choice);

    return {
      updatePickers(theme = storedTheme() ?? 'light') {
        document.querySelectorAll('starlight-theme-select').forEach((picker) => {
          const select = picker.querySelector('select');
          if (select) select.value = theme;
          const tmpl = document.querySelector('#theme-icons');
          const newIcon = tmpl && tmpl.content.querySelector('.' + theme);
          if (newIcon) {
            const oldIcon = picker.querySelector('svg.label-icon');
            if (oldIcon) {
              oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
            }
          }
        });
      },
    };
  })();
</script>
