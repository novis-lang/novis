---
/**
 * The site-wide pre-alpha notice.
 *
 * Starlight's own banner is per-page frontmatter; this override makes it
 * unconditional, because the fact it carries is unconditional. Novis does not
 * run yet, and a documentation site that only says so on the front page is
 * lying to everyone who arrives from a search result — which, for a
 * documentation site, is most people.
 *
 * The milestone comes from `docs/implementation-plan.md` through
 * `tools/gen_status.py`, so the sentence maintains itself.
 *
 * When Novis reaches a usable release, delete this file and remove the
 * `Banner` entry from `astro.config.ts`. It is meant to be temporary and it
 * should be embarrassing to still be here.
 */
import { existsSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const url = new URL('../../generated/status.json', import.meta.url);
const status = existsSync(fileURLToPath(url)) ? JSON.parse(readFileSync(url, 'utf8')) : null;

const RAW_BASE = import.meta.env.BASE_URL || '/';
const BASE = RAW_BASE.endsWith('/') ? RAW_BASE : RAW_BASE + '/';

const milestone = status?.available ? status.milestone : null;
---

<div class="nv-status-banner" role="note">
  <b>Pre-alpha</b>
  <span>
    Novis does not run yet{milestone ? ` — the project is at milestone ${milestone}` : ''}. Everything
    here describes a language under construction, and none of it is stable.
    <a href={`${BASE}status/`}>What works today</a>
  </span>
</div>
