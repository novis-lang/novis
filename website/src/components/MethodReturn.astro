---
/**
 * A member's "Return value" section body: the type from core.json, and the
 * registry card's sentence about it when the card has one.
 */
import { findMember } from '~/lib/core'

interface Props {
  id: string
}

const { id } = Astro.props
const found = findMember(id)
if (!found) throw new Error(`MethodReturn: unknown member id "${id}"`)
const { member } = found
---

<p>
  Returns <code>{member.returnType}</code>.{member.doc?.returnHtml && <>{' '}<span set:html={member.doc.returnHtml} /></>}
</p>
