---
/**
 * Renders the claims collection (src/content/claims/) grouped by category.
 * Adding a claim to the page = adding one markdown file to that folder.
 * "ADR NNNN" in the proof/tradeoff lines is linkified automatically, to the
 * frozen decision record in the repository.
 */
import { getCollection, render } from 'astro:content'
import { decisionRecord } from '@config/site.mjs'

const CATEGORIES: { id: string; title: string; blurb: string }[] = [
  { id: 'security', title: 'Security', blurb: 'The reason Novis exists. Nothing below is an option or a linter rule — it is how the language is built.' },
  { id: 'performance', title: 'Performance', blurb: 'Claims here come with measurements, and the measurements are guarded by tests that fail the build when they regress.' },
  { id: 'simplicity', title: 'Simplicity', blurb: 'One way to do each thing — and the removed ways are documented, not just gone.' },
  { id: 'compatibility', title: 'Coming from PHP', blurb: 'Novis is PHP-shaped on purpose. Here is what carries over and what deliberately does not.' },
  { id: 'tooling', title: 'Tooling', blurb: 'The toolchain is part of the language, not an ecosystem you assemble.' },
  { id: 'honesty', title: 'Where Novis falls behind', blurb: 'An honest list. These are real costs of choosing Novis today, stated as plainly as the claims above.' },
]

const all = await getCollection('claims')
const rendered = await Promise.all(
  all.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
)

const byCategory = CATEGORIES.map((cat) => ({
  ...cat,
  claims: rendered
    .filter(({ entry }) => entry.data.category === cat.id)
    .sort((a, b) => a.entry.data.weight - b.entry.data.weight),
})).filter((cat) => cat.claims.length > 0)

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
/**
 * "ADR NNNN" in a claim's proof or tradeoff becomes a link to the frozen
 * decision record in the repository, and reads as "decision NNNN" — the site
 * publishes rules, and the records stay where they are written.
 */
const linkDecisions = (s: string) =>
  escape(s)
    .replace(/ADR (\d{4})/g, (_m, n) => `<a href="${decisionRecord(n)}">decision ${n}</a>`)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
---

<div class="nv-claims-page">
  {
    byCategory.map((cat) => (
      <section aria-labelledby={`claims-${cat.id}`}>
        <h2 id={`claims-${cat.id}`}>{cat.title}</h2>
        <p class="nv-claims-blurb">{cat.blurb}</p>
        <div class="nv-claims">
          {cat.claims.map(({ entry, Content }) => (
            <article class="nv-claim">
              <h3>{entry.data.claim}</h3>
              <div class="nv-claim-meta">
                {entry.data.comparedTo.map((target) => (
                  <span class="nv-claim-chip">vs {target}</span>
                ))}
                {entry.data.draft && (
                  <span class="nv-claim-chip nv-claim-chip-draft" title="This claim has not been reviewed yet.">
                    draft
                  </span>
                )}
              </div>
              <div class="nv-claim-body">
                <Content />
              </div>
              {entry.data.proof && (
                <p class="nv-claim-proof">
                  <strong>Proof — </strong>
                  <span set:html={linkDecisions(entry.data.proof)} />
                </p>
              )}
              {entry.data.tradeoff && (
                <p class="nv-claim-tradeoff">
                  <strong>The honest cost — </strong>
                  <span set:html={linkDecisions(entry.data.tradeoff)} />
                </p>
              )}
            </article>
          ))}
        </div>
      </section>
    ))
  }
</div>

<style>
  .nv-claims-blurb {
    color: var(--sl-color-gray-3);
    margin-top: 0.25rem;
  }
</style>
