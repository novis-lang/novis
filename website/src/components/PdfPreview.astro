---
/**
 * A PDF file shown on the page, with a link that opens it. `src` is a
 * root-absolute path to a file under public/, such as an example app's copy
 * under public/example-apps/ (`bun nv site --bless-apps` writes those). The
 * path gets the site's base here, since an MDX page's JSX never passes
 * through the base-links rewrite. A browser that cannot show a PDF inside a
 * page shows a sentence in its place, and the link under it.
 */
import { withBase } from '~/lib/base'

interface Props {
  src: string
  title: string
}

const { src, title } = Astro.props
const url = withBase(src)
---

<figure class="pdf-preview not-content">
  <object data={url} type="application/pdf" title={title}>
    <p>Your browser cannot show the PDF file inside this page. Use the link below to open it.</p>
  </object>
  <figcaption><a href={url}>Open {title}</a></figcaption>
</figure>

<style>
  .pdf-preview {
    margin-block: 1rem 2rem;
  }
  .pdf-preview object {
    display: block;
    width: 100%;
    height: 36rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }
  .pdf-preview figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
  }
</style>
