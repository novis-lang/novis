---
/**
 * A mind map: one question on the left, its branches in the middle, and the
 * leaves of each branch on the right. Each branch has its own tone, and a
 * leaf may link to the part of the page that explains it.
 *
 * The words are HTML, a list of lists, so a screen reader, search and a
 * narrow screen all get them as text. SVG draws only the curved lines, which
 * is why every row has a fixed height: the curves are laid out from it at
 * build time. Below 34rem the map is the plain list, each branch a pill with
 * its leaves under it.
 *
 * As the map scrolls into view, each line draws itself and each label fades
 * in, top to bottom. Where scroll-driven animations do not run, or the reader
 * asked for less motion, the map is simply shown.
 */
import Frame from './Frame.astro'
import { entryRange, label, tone, type Tone } from './diagram'

export interface MindMapData {
  /** The question in the middle of the map. */
  root: string
  branches: {
    label: string
    tone: Tone
    leaves: { label: string; href?: string }[]
  }[]
}

interface Props {
  data: MindMapData
}

const { data } = Astro.props

/** A leaf row's height and the gap between branches, in pixels. */
const ROW = 30
const GAP = 14
/** The width of a column of curves. */
const BEND = 30

let y = 0
const branches = data.branches.map((b) => {
  const height = b.leaves.length * ROW
  const top = y
  y += height + GAP
  return { ...b, top, height, mid: top + height / 2 }
})
const total = y - GAP
const curve = (y0: number, y1: number) => `M0 ${y0} C ${BEND * 0.6} ${y0}, ${BEND * 0.4} ${y1}, ${BEND} ${y1}`
---

<Frame label={data.root}>
  <div class="map">
    <p class="root" style={entryRange(0)}>{data.root}</p>
    <svg class="trunk" width={BEND} height={total} viewBox={`0 0 ${BEND} ${total}`} aria-hidden="true">
      {
        branches.map((b) => (
          <path
            d={curve(total / 2, b.mid)}
            pathLength="1"
            style={`--tone: ${tone(b.tone)}; ${entryRange(b.mid / total)}`}
          />
        ))
      }
    </svg>
    <ul class="branches" role="list" style={`--gap: ${GAP}px; --row: ${ROW}px`}>
      {
        branches.map((b) => (
          <li class="branch" style={`--tone: ${tone(b.tone)}`}>
            <span class="pill" style={entryRange(b.mid / total, 0.05)}>
              {label(b.label)}
            </span>
            <svg class="twig" width={BEND} height={b.height} viewBox={`0 0 ${BEND} ${b.height}`} aria-hidden="true">
              {b.leaves.map((_, j) => (
                <path
                  d={curve(b.height / 2, (j + 0.5) * ROW)}
                  pathLength="1"
                  style={entryRange((b.top + (j + 0.5) * ROW) / total, 0.1)}
                />
              ))}
            </svg>
            <ul class="leaves" role="list">
              {b.leaves.map((leaf, j) => (
                <li style={entryRange((b.top + (j + 0.5) * ROW) / total, 0.12)}>
                  {leaf.href ? <a href={leaf.href}>{label(leaf.label)}</a> : <span>{label(leaf.label)}</span>}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</Frame>

<style>
  .map {
    display: grid;
    grid-template-columns: 6.5rem auto minmax(0, 1fr);
    align-items: center;
    view-timeline: --dg-map block;
  }
  .root {
    margin: 0;
    padding: var(--nv-space-3);
    border: 1.5px solid var(--sl-color-accent);
    border-radius: var(--nv-radius-lg);
    background: var(--nv-surface-2);
    box-shadow: var(--nv-glow);
    color: var(--sl-color-white);
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
  }
  svg {
    display: block;
    overflow: visible;
  }
  path {
    fill: none;
    stroke: var(--tone, var(--sl-color-accent));
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .trunk path {
    stroke-width: 2.2;
  }
  .branches,
  .leaves {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .branches {
    display: grid;
    gap: var(--gap);
  }
  .branch {
    display: grid;
    grid-template-columns: 10.5rem auto minmax(0, 1fr);
    align-items: center;
    margin: 0;
  }
  .pill {
    padding: 0.3rem var(--nv-space-3);
    border: 1px solid var(--tone);
    border-radius: var(--nv-radius-pill);
    background: color-mix(in oklab, var(--tone) 16%, transparent);
    color: var(--sl-color-white);
    font-size: 0.8125rem;
    font-weight: 650;
    line-height: 1.3;
    text-align: center;
  }
  .leaves li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    height: var(--row);
    margin: 0;
    padding-inline-start: 0.2rem;
    font-size: 0.8125rem;
    white-space: nowrap;
    color: var(--sl-color-gray-1);
  }
  .leaves li::before {
    content: '';
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--tone);
  }
  .leaves a {
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .leaves a:hover,
  .leaves a:focus-visible {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Narrow: the plain list. The question on top, then each branch as a pill
     with its leaves under it on a line of the branch's tone. */
  @container (max-width: 34rem) {
    .map {
      display: block;
    }
    .root {
      margin-block-end: var(--nv-space-5);
    }
    svg {
      display: none;
    }
    .branches {
      gap: var(--nv-space-4);
    }
    .branch {
      display: block;
    }
    .pill {
      display: inline-block;
    }
    .leaves {
      margin: var(--nv-space-2) 0 0 var(--nv-space-3);
      padding-inline-start: var(--nv-space-3);
      border-inline-start: 2px solid color-mix(in oklab, var(--tone) 55%, transparent);
    }
    .leaves li {
      height: auto;
      padding-block: 0.15rem;
      white-space: normal;
    }
  }

  @media (forced-colors: active) {
    path {
      stroke: CanvasText;
    }
    .leaves li::before {
      background: CanvasText;
    }
  }

  /* Each line draws itself and each label fades in as its place scrolls in. */
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: -0.4rem 0;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.85;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      path,
      .pill,
      .root,
      .leaves li {
        animation-timeline: --dg-map;
        animation-range: entry var(--from) entry var(--to);
        animation-fill-mode: both;
        animation-timing-function: ease-out;
      }
      path {
        stroke-dasharray: 1;
        animation-name: draw;
      }
      .root,
      .pill {
        animation-name: pop;
      }
      .leaves li {
        animation-name: rise;
      }
    }
  }
</style>
