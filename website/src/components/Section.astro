---
/**
 * A titled band on the landing page. A heading, an optional one-line lead, and
 * whatever the page puts in it, separated from its neighbours by a hairline.
 */
interface Props {
  title: string;
  lead?: string;
  id?: string;
}

const { title, lead, id } = Astro.props;
---

<section class="nv-section" id={id}>
  <h2>{title}</h2>
  {lead && <p class="nv-section-lead" set:html={lead} />}
  <slot />
</section>
