---
/**
 * The human-facing site index: every page of the site, grouped, in one place.
 * The machine-facing equivalents are /sitemap-index.xml (search engines) and
 * /llms.txt (agents), both generated from the same content at build time.
 */
import { getCollection } from 'astro:content'

const docs = await getCollection('docs')

const pageUrl = (id: string) => (id === 'index' || id === '' ? '/' : `/${id.replace(/\/index$/, '')}/`)

interface Group {
  title: string
  match: (id: string) => boolean
  pages: { title: string; url: string }[]
}

const groups: Group[] = [
  { title: 'Start', match: (id) => !id.includes('/'), pages: [] },
  { title: 'Getting started', match: (id) => id.startsWith('docs/getting-started') || id === 'docs', pages: [] },
  { title: 'Release notes', match: (id) => id.startsWith('docs/release-notes'), pages: [] },
  { title: 'Core reference', match: (id) => id.startsWith('docs/core'), pages: [] },
  { title: 'Architecture decision records', match: (id) => id.startsWith('docs/adr'), pages: [] },
]

for (const doc of docs.sort((a, b) => a.id.localeCompare(b.id))) {
  const group = groups.find((g) => g.match(doc.id))
  if (group) group.pages.push({ title: doc.data.title, url: pageUrl(doc.id) })
}
---

<div class="nv-siteindex">
  {
    groups
      .filter((g) => g.pages.length > 0)
      .map((group) => (
        <section>
          <h2>
            {group.title} <span class="nv-siteindex-count">({group.pages.length})</span>
          </h2>
          <ul>
            {group.pages.map((p) => (
              <li>
                <a href={p.url}>{p.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
  }
</div>

<style>
  .nv-siteindex-count {
    font-size: var(--sl-text-sm);
    font-weight: 400;
    color: var(--sl-color-gray-3);
  }
</style>
