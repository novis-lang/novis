---
/**
 * Include a real file from the repository as a code block.
 *
 * The point is that a documentation example is never retyped. `examples/*.nvs`
 * and the `.nvt` conformance cases are exercised by the Rust test suite; a
 * snippet on this site is *that* file, read at build time, so an example cannot
 * silently stop being true. If the file moves or the region disappears, the
 * site build fails — which is the entire mechanism.
 *
 * Usage in `.mdx`:
 *
 *   import Snippet from '~/components/Snippet.astro';
 *   <Snippet file="examples/hello.nvs" />
 *   <Snippet file="examples/objects.nvs" region="declare" title="A class" />
 *
 * Regions are marked in the source file with ordinary comments, so they are
 * invisible to the compiler and to a reader of the repository:
 *
 *   // #region declare
 *   …
 *   // #endregion
 */
import { Code } from '@astrojs/starlight/components';
import { existsSync, readFileSync } from 'node:fs';
import { dirname, resolve } from 'node:path';

/**
 * The repository root, found by walking up from the working directory.
 *
 * Not derived from `import.meta.url`: during a production build this component
 * executes from a bundled chunk under `dist/`, so a path relative to the module
 * points somewhere that does not exist. The working directory is `website/` for
 * every command that runs Astro, in dev and in build alike.
 */
function findRepoRoot(): string {
  let dir = process.cwd();
  for (let i = 0; i < 6; i++) {
    if (existsSync(resolve(dir, 'Cargo.toml')) && existsSync(resolve(dir, 'docs'))) return dir;
    const up = dirname(dir);
    if (up === dir) break;
    dir = up;
  }
  // Not inside the workspace (someone cloned website/ alone). Fall back to the
  // parent of the working directory so the error message names a sane path.
  return resolve(process.cwd(), '..');
}

interface Props {
  /** Path from the repository root, e.g. `examples/hello.nvs`. */
  file: string;
  /** Optional `#region` name inside that file. */
  region?: string;
  /** Frame title. Defaults to the file path, which is usually what you want. */
  title?: string;
  /** Language override. Defaults to `nvs` for `.nvs` files. */
  lang?: string;
  /** Highlight these 1-based line numbers, relative to the extracted text. */
  mark?: string;
}

const { file, region, title, lang, mark } = Astro.props;

const abs = resolve(findRepoRoot(), file);

let text: string;
try {
  text = readFileSync(abs, 'utf8');
} catch {
  throw new Error(
    `<Snippet> could not read "${file}" (resolved to ${abs}).\n` +
      `Paths are relative to the repository root, not to the page.`,
  );
}

if (region) {
  const start = new RegExp(`^\\s*(?://|#)\\s*#region\\s+${region}\\s*$`, 'm');
  const end = /^\s*(?:\/\/|#)\s*#endregion\b.*$/m;
  const from = text.match(start);
  if (!from || from.index === undefined) {
    throw new Error(`<Snippet> found no "#region ${region}" in ${file}.`);
  }
  const after = text.slice(from.index + from[0].length);
  const to = after.match(end);
  text = (to && to.index !== undefined ? after.slice(0, to.index) : after).replace(/^\n/, '');
}

// Strip any remaining region markers so they never reach the page, then trim
// trailing blank lines and re-indent to the shallowest line in the extract.
const lines = text
  .split('\n')
  .filter((l) => !/^\s*(?:\/\/|#)\s*#(?:end)?region\b/.test(l));
while (lines.length && lines[0]!.trim() === '') lines.shift();
while (lines.length && lines[lines.length - 1]!.trim() === '') lines.pop();
const indent = Math.min(
  ...lines.filter((l) => l.trim()).map((l) => l.length - l.trimStart().length),
);
const code = lines.map((l) => l.slice(Number.isFinite(indent) ? indent : 0)).join('\n');

const language = lang ?? (file.endsWith('.nvs') || file.endsWith('.nvt') ? 'nvs' : 'text');
---

<Code code={code} lang={language} title={title ?? file} mark={mark} />
