---
/**
 * The lead paragraph of a method page, rendered from data so it follows the
 * repository: the registry's short description when the toolchain provides one
 * (ADR 0117), else a sentence derived from the spec's "Replaces" cell.
 * A human who wants their own lead replaces this component with prose.
 */
import { findMember } from '~/lib/core'

interface Props {
  id: string
}

const { id } = Astro.props
const found = findMember(id)
if (!found) throw new Error(`MethodLead: unknown member id "${id}" — run \`npm run sync:render\`?`)
const { cls, member } = found

let html = member.doc?.shortHtml ?? ''
if (!html) {
  const clean = (member.replaces ?? '').replace(/\s*\(([^)]*)\)/g, '').trim()
  if (clean && !/^nothing\b/i.test(clean)) {
    const escaped = clean.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    html = `Novis's replacement for PHP's ${escaped.replace(/`([^`]+)`/g, '<code>$1</code>')}.`
  } else {
    html = `A member of <code>${cls.name.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</code>.`
  }
}
---

<p set:html={html} />
