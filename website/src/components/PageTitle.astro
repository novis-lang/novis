---
/**
 * PageTitle override: the default title, plus a discreet draft notice on
 * generated Core pages a human has not reviewed yet (frontmatter
 * `novis.draft: true` — remove the flag after reviewing the prose).
 */
import Default from '@astrojs/starlight/components/PageTitle.astro'

const novis = (Astro.locals.starlightRoute.entry.data as { novis?: { draft?: boolean; kind?: string } }).novis
---

<Default><slot /></Default>
{
  novis?.draft && (
    <p class="nv-draft-note">
      <strong>Draft.</strong> This page renders straight from the repository's own data and has not
      been reviewed by a human yet. The signature block is exact either way.
    </p>
  )
}
