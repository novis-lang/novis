---
/**
 * The comparison page's charts for more than one core, from the `cores` and
 * `parallel` rows of the feature table, split into the two groups `grouped`
 * gives. `many-requests` is each peer's throughput with four cores against
 * the best peer's. `one-request` gives each peer two bars: the seconds one
 * part took, then the seconds four parts at once took, both against the
 * longest time in the chart. Only the four-part times have a place in their
 * group, and every one in place 1 takes the accent colour. In
 * `many-requests` every bar has a place.
 */
import Bars from './Bars.astro'
import { groupPlaces, grouped, manyRequests, oneRequest, overLeast, record } from '~/lib/compare'

export interface Props {
  chart: 'many-requests' | 'one-request'
}

const { chart } = Astro.props
const number = (n: number) => Math.round(n).toLocaleString('en-US')
const seconds = (n: number) => `${n.toFixed(2)} s`

const groups = (() => {
  if (chart === 'many-requests') {
    const best = Math.max(...manyRequests.map((s) => s.four))
    const place = groupPlaces(
      manyRequests.map((s) => s.peer),
      manyRequests.map((s) => s.four),
      false,
    )
    const bars = manyRequests.map((s, i) => ({
      peer: s.peer,
      label: s.label,
      place: place[i]!,
      share: best > 0 ? s.four / best : 0,
      best: place[i] === 1,
      value: number(s.four),
      figures: 'requests per second',
    }))
    return grouped(bars).map((g) => ({ title: g.title, bars: g.items }))
  }
  const longest = Math.max(...oneRequest.map((s) => Math.max(s.one, s.four)))
  const shortestOne = Math.min(...oneRequest.map((s) => s.one))
  const shortest = Math.min(...oneRequest.map((s) => s.four))
  const place = groupPlaces(
    oneRequest.map((s) => s.peer),
    oneRequest.map((s) => s.four),
    true,
  )
  const peers = oneRequest.map((s, i) => ({ ...s, place: place[i]! }))
  return grouped(peers).map((g) => ({
    title: g.title,
    bars: g.items.flatMap((s) => [
      {
        label: s.label,
        share: s.one / longest,
        best: false,
        value: seconds(s.one),
        compared: overLeast(s.one, shortestOne, 'fastest', 'slower'),
        figures: 'one part',
        above: true,
      },
      {
        label: '',
        place: s.place,
        share: s.four / longest,
        best: s.place === 1,
        value: seconds(s.four),
        compared: overLeast(s.four, shortest, 'fastest', 'slower'),
        figures: `four parts at the same time, with ${s.way}. Less is better.`,
      },
    ]),
  }))
})()
---

{
  record?.scenarios && groups.length > 0 ? (
    <Bars groups={groups} />
  ) : (
    <p class="compare-empty">No run of the feature table is recorded yet.</p>
  )
}
