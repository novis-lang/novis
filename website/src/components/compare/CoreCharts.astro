---
/**
 * The comparison page's charts for more than one core, from the `cores` and
 * `parallel` rows of the feature table. `many-requests` is how many times its
 * throughput on one core each peer reaches with four, against four times, best
 * first, with no place and no throughput shown: the row asks whether a peer
 * uses the cores, and the loop's throughput is a language's arithmetic speed,
 * which reads as the opposite ranking. `one-request` gives each
 * peer two bars: the seconds one part took, then the seconds four parts at
 * once took, both against the longest time in the chart. Only the four-part
 * times have a place, and every one in place 1 takes the accent colour.
 */
import Bars from './Bars.astro'
import { manyRequests, oneRequest, overLeast, places, positions, record } from '~/lib/compare'

export interface Props {
  chart: 'many-requests' | 'one-request'
}

const { chart } = Astro.props
// The cores the `cores` row gives each peer. A peer whose throughput grows by this factor fills its bar.
const CORES = 4
const seconds = (n: number) => `${n.toFixed(2)} s`

const groups = (() => {
  if (chart === 'many-requests') {
    const times = (s: (typeof manyRequests)[number]) => (s.one > 0 ? s.four / s.one : 0)
    const bars = [...manyRequests]
      .sort((a, b) => times(b) - times(a))
      .map((s) => ({
        peer: s.peer,
        label: s.label,
        share: times(s) / CORES,
        best: false,
        value: `${times(s).toFixed(2)}×`,
        compared: '',
        figures: '',
      }))
    return [{ bars }]
  }
  const longest = Math.max(...oneRequest.map((s) => Math.max(s.one, s.four)))
  const shortestOne = Math.min(...oneRequest.map((s) => s.one))
  const shortest = Math.min(...oneRequest.map((s) => s.four))
  const fours = oneRequest.map((s) => s.four)
  const place = places(fours, true)
  const position = positions(fours, true)
  const peers = oneRequest.map((s, i) => ({ ...s, place: place[i]!, position: position[i]! }))
  return [peers].map((all) => ({
    bars: all.flatMap((s) => [
      {
        label: s.label,
        peer: s.peer,
        share: s.one / longest,
        best: false,
        value: seconds(s.one),
        compared: overLeast(s.one, shortestOne, 'fastest', 'slower'),
        figures: 'one part',
        above: true,
      },
      {
        label: '',
        place: s.place,
        position: s.position,
        share: s.four / longest,
        best: s.place === 1,
        value: seconds(s.four),
        compared: overLeast(s.four, shortest, 'fastest', 'slower'),
        figures: `four parts at the same time, with ${s.way}. Less is better.`,
      },
    ]),
  }))
})()
---

{
  record?.scenarios && groups.length > 0 ? (
    <Bars groups={groups} />
  ) : (
    <p class="compare-empty">No run of the feature table is recorded yet.</p>
  )
}
