---
/**
 * The machine and the run behind the comparison page's figures, from
 * src/lib/compare.ts. Before a run is recorded it says so.
 */
import { record } from '~/lib/compare'

const facts = record
  ? [
      ['CPU', record.host.processor?.trim() || 'not recorded'],
      ['Cores', String(record.host.cpus ?? 'not recorded')],
      ['Operating system', record.host.platform ?? 'not recorded'],
      ['CPUs for each server', String(record.backend_cpus)],
      ['Requests in each test', `${record.requests.toLocaleString('en-US')}, best of ${record.reps}`],
    ]
  : []
---

{
  record ? (
    <dl class="compare-machine">
      {facts.map(([name, value]) => (
        <div>
          <dt>{name}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  ) : (
    <p class="compare-empty">No run is recorded yet.</p>
  )
}

<style>
  .compare-machine {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.5rem 1.5rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    font-size: var(--sl-text-sm);
  }
  .compare-machine div {
    margin: 0;
  }
  .compare-machine dt {
    color: var(--sl-color-gray-3);
    font-weight: normal;
  }
  .compare-machine dd {
    margin: 0;
    color: var(--sl-color-white);
  }
</style>
