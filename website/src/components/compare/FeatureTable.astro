---
/**
 * The comparison page's feature table: one row per recorded scenario, one
 * column per peer. Every cell links to the folder on GitHub with the programs
 * the row runs, so a reader can check the result. A row the page explains
 * under its own heading links there too. On a narrow screen the table
 * scrolls inside its own box, with the feature column fixed at the left, so
 * the page itself never scrolls sideways.
 */
import { peers, record, rows } from '~/lib/compare'
---

{
  record?.scenarios ? (
    <div class="compare-features-scroll">
    <table class="compare-features">
      <thead>
        <tr>
          <th>Feature</th>
          {peers.map((p) => (
            <th>{p.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr id={`row-${r.id}`}>
            <td>
              {r.text}
              {r.details && (
                <>
                  {' '}
                  <a class="compare-details" href={r.details}>
                    See details
                  </a>
                </>
              )}
            </td>
            {r.cells.map((c) =>
              c ? (
                <td class={`verdict-${c.verdict}`}>
                  <a href={r.url}>{c.text}</a>
                  {c.setting && (
                    <>
                      <br />
                      <code>{c.setting}</code>
                    </>
                  )}
                </td>
              ) : (
                <td>-</td>
              ),
            )}
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  ) : (
    <p class="compare-empty">No run of the feature table is recorded yet.</p>
  )
}

<style>
  .compare-features-scroll {
    max-width: 100%;
    overflow-x: auto;
  }
  .compare-features {
    display: table;
    overflow: visible;
  }
  .compare-features td,
  .compare-features th {
    vertical-align: top;
  }
  .compare-features td:first-child,
  .compare-features th:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    min-width: 12rem;
    background: var(--sl-color-bg);
  }
  @media (max-width: 50rem) {
    .compare-features td:first-child,
    .compare-features th:first-child {
      min-width: 9rem;
      max-width: 9rem;
    }
    .compare-features {
      font-size: var(--sl-text-xs);
    }
  }
  .compare-features code {
    font-size: var(--sl-text-xs);
    white-space: normal;
    overflow-wrap: anywhere;
  }
  .compare-features td a {
    white-space: nowrap;
  }
  .compare-features .compare-details {
    font-size: var(--sl-text-xs);
  }
  .compare-features .verdict-built-in a,
  .compare-features .verdict-on-by-default a {
    color: var(--sl-color-green-high);
  }
  .compare-features .verdict-no a {
    color: var(--sl-color-red-high);
  }
</style>
