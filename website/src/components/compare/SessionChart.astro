---
/**
 * The comparison page's chart for the `session` row: one bar per peer that
 * has sessions, the milliseconds its fast request waited while a slow request
 * of the same visitor ran, against the longest wait. Less is better, and every
 * one in place 1 takes the accent colour.
 */
import Bars from './Bars.astro'
import { overLeast, places, positions, record, sessionWaits } from '~/lib/compare'

// The wait from which the row counts the fast request as held, `SESSION_WAIT_LIMIT_MS` in `bun nv bench-compare`.
const WAITED_MS = 1000
const number =(n: number) => Math.round(n).toLocaleString('en-US')
const longest = Math.max(...sessionWaits.map((s) => s.waitMs))
const shortest = Math.min(...sessionWaits.map((s) => s.waitMs))
const waits = sessionWaits.map((s) => s.waitMs)
const place = places(waits, true)
const position = positions(waits, true)
const bars = sessionWaits.map((s, i) => ({
  peer: s.peer,
  label: s.label,
  place: place[i]!,
  position: position[i]!,
  share: longest > 0 ? s.waitMs / longest : 0,
  best: place[i] === 1,
  value: `${number(s.waitMs)} ms`,
  compared: overLeast(s.waitMs, shortest, 'fastest', 'longer'),
  figures:
    s.waitMs < WAITED_MS
      ? 'The fast request did not wait for the slow one.'
      : s.code === null
        ? 'The fast request waited for the slow one.'
        : `The fast request waited for the slow one. Your code can change that: ${s.code}.`,
}))
---

{
  record?.scenarios && bars.length > 0 ? (
    <Bars groups={[{ bars }]} />
  ) : (
    <p class="compare-empty">No run of the feature table is recorded yet.</p>
  )
}
