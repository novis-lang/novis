---
/**
 * One chart per recorded case on the comparison page, all four peers ranked
 * together. Each peer has two bars: its requests per second against the best
 * peer's, and its peak memory against the most any peer used. Each bar has
 * its place for its kind, and every bar in place 1 takes the accent colour:
 * the most requests, and the least memory. A case whose PHP ran with its file
 * check off says so above the bars.
 */
import Bars from './Bars.astro'
import { charts, overLeast, record } from '~/lib/compare'

const number = (n: number) => Math.round(n).toLocaleString('en-US')
const fileCheckNote = (labels: string[]) =>
  `${labels.join(' and ')} ran with the file check turned off, because that is faster. A new file is then not live until the server reloads.`
---

{
  record ? (
    charts.map((c) => {
      const memories = c.bars.flatMap((b) => (b.memoryMiB === null ? [] : [b.memoryMiB]))
      const most = Math.max(...memories)
      const least = Math.min(...memories)
      return (
        <section class="compare-case">
          <h3 id={`case-${c.id}`}>{c.title}</h3>
          <p>
            {c.text} {c.concurrency.toLocaleString('en-US')} connections at once.
          </p>
          <Bars
            groups={[c.bars].map((all) => {
              const off = all.filter((b) => b.fileCheckOff).map((b) => b.label)
              return {
                note: off.length > 0 ? fileCheckNote(off) : null,
                bars: all.flatMap((b) => [
                  {
                    label: b.label,
                    peer: b.peer,
                    place: b.place,
                    position: b.position,
                    share: b.share,
                    best: b.best,
                    value: number(b.requestsPerSec),
                    figures: b.p99Ms === null ? 'requests per second' : `requests per second, p99 ${b.p99Ms.toFixed(1)} ms`,
                    above: b.memoryMiB !== null,
                  },
                  ...(b.memoryMiB === null
                    ? []
                    : [
                        {
                          label: '',
                          place: b.memoryPlace!,
                          share: most > 0 ? b.memoryMiB / most : 0,
                          best: b.memoryPlace === 1,
                          value: `${b.memoryMiB.toFixed(0)} MiB`,
                          compared: overLeast(b.memoryMiB, least, 'least', 'more'),
                          figures: 'peak memory, less is better',
                        },
                      ]),
                ]),
              }
            })}
          />
        </section>
      )
    })
  ) : (
    <p class="compare-empty">No run is recorded yet.</p>
  )
}
