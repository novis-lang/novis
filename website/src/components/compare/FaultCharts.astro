---
/**
 * The comparison page's charts for a server under load while something goes
 * wrong, from rows of the feature table. `deploy` is one stacked bar per
 * server: every request its load sent while a new version was copied in, as
 * complete pages, failed requests and mixed pages, with the share of complete
 * pages at its end. Its place counts the failed and mixed ones, fewer being
 * better. It is split into the two groups `grouped`
 * gives, each in its own box with its note, because how a server takes a new
 * version is what the test measures. `memory` and `loop` are the requests
 * answered while one runaway request ran beside the load, over the requests
 * the same server answered with no runaway request, so each bar is the share
 * of its own speed a server kept and not how fast it is anyway. They rank all
 * four peers together. Every bar has its place, and every one in place 1
 * takes the accent colour.
 */
import Bars from './Bars.astro'
import { deploys, groupPlaces, grouped, places, record, runaways } from '~/lib/compare'

export interface Props {
  chart: 'deploy' | 'memory' | 'loop'
}

const { chart } = Astro.props
const number = (n: number) => Math.round(n).toLocaleString('en-US')
const DEPLOY_LEGEND = [
  { kind: 'ok' as const, label: 'Complete page' },
  { kind: 'failed' as const, label: 'Failed request' },
  { kind: 'mixed' as const, label: 'Mixed page' },
]

const groups = (() => {
  if (chart === 'deploy') {
    const wrong = deploys.map((d) => d.failed + d.mixed)
    const place = groupPlaces(
      deploys.map((d) => d.peer),
      wrong,
      true,
    )
    const bars = deploys.map((d, i) => {
      const ok = Math.max(0, d.requests - d.failed - d.mixed)
      const of = (n: number) => (d.requests > 0 ? n / d.requests : 0)
      return {
        peer: d.peer,
        label: d.label,
        place: place[i]!,
        share: 1,
        best: place[i] === 1,
        value: ok === d.requests ? '100%' : `${(Math.floor((ok / d.requests) * 1000) / 10).toFixed(1)}%`,
        compared: '',
        parts: [
          { kind: 'ok' as const, share: of(ok) },
          { kind: 'failed' as const, share: of(d.failed) },
          { kind: 'mixed' as const, share: of(d.mixed) },
        ],
        figures: `${number(d.requests)} requests: ${number(ok)} complete, ${number(d.failed)} failed, ${number(d.mixed)} mixed`,
      }
    })
    return grouped(bars).map((g) => ({ title: g.title, group: g.group, note: g.note, bars: g.items }))
  }
  const runs = runaways(chart)
  const place = places(
    runs.map((r) => r.kept),
    false,
  )
  const bars = runs.map((r, i) => ({
    peer: r.peer,
    label: r.label,
    place: place[i]!,
    share: r.kept,
    best: place[i] === 1,
    value: `${Math.round(r.kept * 100)}%`,
    figures: [
      `${number(r.requests)} of ${number(r.baseline)} requests answered`,
      `${number(r.failed)} failed`,
      ...(r.p99Ms === null ? [] : [`p99 ${r.p99Ms.toFixed(1)} ms`]),
      ...(r.restarts > 0 ? ['the server crashed and was restarted'] : r.running ? [] : ['the server crashed']),
    ].join(', '),
  }))
  return [{ bars }]
})()
---

{
  record?.scenarios && groups.length > 0 ? (
    <Bars groups={groups} legend={chart === 'deploy' ? DEPLOY_LEGEND : undefined} />
  ) : (
    <p class="compare-empty">No run of the feature table is recorded yet.</p>
  )
}
