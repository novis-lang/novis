---
/**
 * One bar chart on the comparison page, in groups. A group with a title is a
 * box with a coloured edge, its title and an optional note at the top, so
 * each group reads as its own part of the chart; `group` names its colour. A
 * group without a title is the bars alone, with the note above them. All
 * groups share one grid through `subgrid`, so the bars of every box line up
 * on one scale. Each bar's row has its place (1 for the best, empty for a bar
 * that is not ranked), its label, how it compares (its length as a percentage
 * unless the caller words it) left of the bar, the figure it shows right of
 * it, and a line of text under it, smaller. A bar with `best` takes the
 * accent colour. A row with an empty label continues the peer named above
 * it, and a bar with `above` prints its text above it, so two bars of one
 * peer sit together between their two lines. A bar with `parts` is stacked,
 * one colour per part, and `legend` names the colours above the chart.
 *
 * A peer's bars are one block: the bar with its label and the unlabelled
 * ones after it. Blocks are drawn best first, by the first place in the
 * block, inside each group, so every chart reads from the top down. The
 * block of `HOME_PEER` has a border, so a reader finds Novis at once.
 */
import { HOME_PEER } from '~/lib/compare'

export interface Props {
  /** The colours of a stacked bar's parts and what each means, shown above the chart. */
  legend?: { kind: 'ok' | 'failed' | 'mixed'; label: string }[]
  groups: {
    /** The box's heading. Without it the group is not boxed. */
    title?: string
    /** Which colour the box's edge takes: `files` or `build`. */
    group?: string
    /** A line of text under the heading, or above the bars of a group with no heading. */
    note?: string | null
    bars: Bar[]
  }[]
}

interface Bar {
  label: string
  /** The peer's id in the record, which marks the block of `HOME_PEER`. */
  peer?: string
  /** The bar's place, 1 for the best, or none for a bar that is not ranked. */
  place?: number
  /** The bar's position best first, from `positions`, which orders the bars that share a place. */
  position?: number
  /** The bar's length, from 0 to 1. */
  share: number
  best: boolean
  /** The figure printed at the end of the bar. */
  value: string
  /** The line of text printed under the bar, or above it with `above`. An empty one prints nothing. */
  figures: string
  /**
   * One stacked bar in place of a bar of length `share`: its parts fill the track together, in order.
   * A part above zero is drawn at least `MIN_PART` wide, so a few failed requests among many are seen.
   */
  parts?: { kind: 'ok' | 'failed' | 'mixed'; share: number }[]
  above?: boolean
  /** The text beside the value. Without it, the bar's length as a percentage. */
  compared?: string
}

const { groups, legend } = Astro.props
const percent = (share: number) => `${Math.round(share * 100)}%`

/**
 * `bars` as one block per peer, best first: a labelled bar starts a block. Blocks that share a place
 * are ordered by `position`, so the better figure of a tie is drawn first. The sort is stable after that.
 */
function blocks(bars: Bar[]): Bar[][] {
  const out: Bar[][] = []
  for (const b of bars) {
    if (b.label !== '' || out.length === 0) out.push([b])
    else out[out.length - 1]!.push(b)
  }
  const ranked = (block: Bar[]) => block.find((b) => b.place !== undefined)
  const key = (block: Bar[]) => ranked(block)?.place ?? Number.POSITIVE_INFINITY
  const tie = (block: Bar[]) => ranked(block)?.position ?? Number.POSITIVE_INFINITY
  return out
    .map((block, i) => ({ block, i }))
    .sort((a, b) => key(a.block) - key(b.block) || tie(a.block) - tie(b.block) || a.i - b.i)
    .map((x) => x.block)
}
/** The narrowest a part of a stacked bar is drawn, so a part above zero is never invisible. */
const MIN_PART = '4px'
---

{
  legend && (
    <p class="compare-bars legend">
      {legend.map((l) => (
        <span class="key">
          <span class:list={['swatch', l.kind]} />
          {l.label}
        </span>
      ))}
    </p>
  )
}
<div class="compare-bars">
  {
    groups.map((g) => (
      <section class:list={['group', { boxed: g.title !== undefined }]} data-group={g.group}>
        {(g.title !== undefined || g.note) && (
          <header>
            {g.title !== undefined && <span class="title">{g.title}</span>}
            {g.note && <span class="note">{g.note}</span>}
          </header>
        )}
        <ul>
          {blocks(g.bars).map((block) => (
            <li class:list={['block', { home: block.some((b) => b.peer === HOME_PEER) }]}>
              {block.map((b) => (
            <div class:list={['row', { best: b.best, paired: b.above }]}>
              {b.above && b.figures && <span class="figures above">{b.figures}</span>}
              <span class="place">
                {b.place !== undefined && (
                  <span class="badge" title={`Place ${b.place}`}>
                    {b.place}
                  </span>
                )}
              </span>
              <span class="peer">{b.label}</span>
              <span class="percent">{b.compared ?? percent(b.share)}</span>
              <span class="track">
                {b.parts ? (
                  b.parts
                    .filter((p) => p.share > 0)
                    .map((p) => <span class:list={['part', p.kind]} style={`flex: ${p.share} 0 ${MIN_PART}`} />)
                ) : (
                  <span class="bar" style={`width: ${(Math.min(b.share, 1) * 100).toFixed(1)}%`} />
                )}
              </span>
              <span class="value">{b.value}</span>
              {!b.above && b.figures && <span class="figures">{b.figures}</span>}
            </div>
              ))}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .compare-bars {
    display: grid;
    grid-template-columns: auto auto auto 1fr auto;
    column-gap: 0.75rem;
    row-gap: 1rem;
  }
  .compare-bars .group,
  .compare-bars ul {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: center;
  }
  .compare-bars .group {
    row-gap: 0.5rem;
  }
  .compare-bars ul {
    list-style: none;
    padding: 0;
    margin: 0;
    row-gap: 0.25rem;
  }
  .compare-bars li.block {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: center;
    row-gap: 0.25rem;
    border-radius: 0.4rem;
  }
  .compare-bars .row {
    display: contents;
  }
  /* Novis's block: an accent border drawn outside the bars, so nothing inside it moves. */
  .compare-bars li.block.home {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 0.3rem;
    margin-block: 0.4rem;
  }
  .compare-bars .group.boxed {
    --group-edge: var(--sl-color-gray-4);
    --group-tint: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-left: 0.3rem solid var(--group-edge);
    border-radius: 0.5rem;
    padding: 0 1rem 0.75rem;
    overflow: hidden;
  }
  .compare-bars .group[data-group='files'] {
    --group-edge: var(--sl-color-blue);
    --group-tint: var(--sl-color-blue-low);
  }
  .compare-bars .group[data-group='build'] {
    --group-edge: var(--sl-color-purple);
    --group-tint: var(--sl-color-purple-low);
  }
  .compare-bars header {
    grid-column: 1 / -1;
  }
  .compare-bars .boxed header {
    margin: 0 -1rem;
    padding: 0.6rem 1rem;
    background: var(--group-tint);
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .compare-bars .title {
    display: block;
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .compare-bars .note {
    display: block;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .compare-bars .place {
    grid-column: 1;
  }
  .compare-bars .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .compare-bars .best .badge {
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }
  .compare-bars .peer {
    grid-column: 2;
    font-weight: 600;
  }
  .compare-bars .track {
    height: 1rem;
    background: var(--sl-color-gray-6);
    border-radius: 0.25rem;
    overflow: hidden;
  }
  .compare-bars .bar {
    display: block;
    height: 100%;
    background: var(--sl-color-gray-3);
  }
  .compare-bars .best .bar {
    background: var(--sl-color-accent);
  }
  .compare-bars .track:has(.part) {
    display: flex;
    gap: 1px;
  }
  .compare-bars .part {
    display: block;
    height: 100%;
  }
  .compare-bars.legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-bottom: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .compare-bars .key {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .compare-bars .swatch {
    display: inline-block;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 0.2rem;
  }
  .compare-bars .part.ok,
  .compare-bars .swatch.ok {
    background: var(--compare-ok);
  }
  /* A green toward teal, quieter than the theme's own green, so the large "complete" part does not
     outshine the small red and orange parts beside it. Darker on the light theme for contrast. */
  .compare-bars {
    --compare-ok: #2fa58a;
  }
  :global(:root[data-theme='light']) .compare-bars {
    --compare-ok: #1f8a72;
  }
  .compare-bars .part.failed,
  .compare-bars .swatch.failed {
    background: var(--sl-color-red);
  }
  .compare-bars .part.mixed,
  .compare-bars .swatch.mixed {
    background: var(--sl-color-orange);
  }
  .compare-bars .value {
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
  .compare-bars .percent {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }
  .compare-bars .figures {
    grid-column: 4 / 6;
    margin-top: -0.25rem;
    margin-bottom: 0.5rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .compare-bars .figures.above {
    margin-top: 0.5rem;
    margin-bottom: -0.25rem;
  }
</style>
