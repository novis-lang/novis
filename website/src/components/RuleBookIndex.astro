---
/**
 * The rulebook hub: every chapter as a card, and a filter that searches all 900-odd
 * rule titles at once.
 *
 * Rendered from src/data/rules.json, which `bun nv render --website` generates from
 * data/rules/ in the repository. Nothing here is written by hand — including the
 * chapter titles, the section titles and the counts, all of which the render owns so the
 * site and the repository cannot disagree.
 *
 * The filter is deliberately a whole-rulebook search rather than a per-chapter one:
 * somebody arriving with a question ("what happens to a tainted regex pattern?") does
 * not know which of 22 chapters owns it, and the rule title is written to be the answer.
 */
import rules from '../data/rules.json'
import { withBase } from '~/lib/base'

const { totals, topics } = rules

/** Every rule, flattened, for the filter's result list. */
const allRules = topics.flatMap((topic) =>
  topic.sections.flatMap((section) =>
    section.rules.map((rule) => ({ ...rule, chapter: topic.title, section: section.title }))
  )
)

/**
 * A rule title, a chapter blurb or a section title, with its `code spans` marked up.
 *
 * The escape is the whole point of doing this in two steps. Rule titles are full of
 * `class<T>`, `array<mixed>` and `#[Route]`, so handing one to `set:html` unescaped
 * opens elements the browser never closes — `<T>` swallowed everything after it, this
 * grid included, and the page still rendered without an error anywhere.
 */
const titleHtml = (title: string) =>
  title
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
---

<div class="rb not-content">
  <div class="rb-counts">
    <div class="rb-count"><b>{totals.total}</b><span>rules</span></div>
    <div class="rb-count"><b>{totals.shipped}</b><span>shipped</span></div>
    <div class="rb-count"><b>{totals.designed}</b><span>designed</span></div>
    <div class="rb-count"><b>{totals.diverging}</b><span>differ from PHP</span></div>
  </div>

  <label class="rb-filter">
    <span class="sr-only">Search the rulebook</span>
    <input
      type="search"
      id="rb-filter"
      placeholder={`Search all ${totals.total} rules…`}
      autocomplete="off"
    />
  </label>
  <p class="sr-only" role="status" aria-live="polite" id="rb-status"></p>

  <ol class="rb-results" id="rb-results" hidden>
    {
      allRules.map((rule) => (
        <li class="rb-result" data-search={`${rule.title} ${rule.id}`.toLowerCase()} hidden>
          <a href={withBase(rule.href)}>
            <span class="rb-result-title" set:html={titleHtml(rule.title)} />
            <span class="rb-result-where">
              {rule.chapter} › {rule.section}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  <p class="rb-empty" id="rb-empty" hidden>No rule says anything about that.</p>

  <div class="rb-chapters" id="rb-chapters">
    {
      topics.map((topic) => (
        <a class="rb-chapter" href={withBase(topic.url)}>
          <span class="rb-chapter-head">
            <span class="rb-chapter-title">{topic.title}</span>
            <span class="rb-chapter-count">{topic.counts.total}</span>
          </span>
          <span
            class="rb-chapter-sections"
            set:html={titleHtml(
              topic.single ? topic.sections[0].blurb : topic.sections.map((s) => s.title).join(' · ')
            )}
          />
          <span class="rb-chapter-bar" aria-hidden="true">
            <span
              class="rb-chapter-bar-fill"
              style={`width: ${Math.round((topic.counts.shipped / topic.counts.total) * 100)}%`}
            />
          </span>
          <span class="rb-chapter-split">
            {topic.counts.shipped} shipped · {topic.counts.designed} designed
          </span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .rb-counts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--sl-color-hairline, var(--sl-color-gray-5));
  }
  .rb-count {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .rb-count b {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--sl-color-white);
    font-variant-numeric: tabular-nums;
  }
  .rb-count span {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .rb-count:first-child b {
    color: var(--sl-color-text-accent);
  }

  .rb-filter {
    display: block;
    margin-block: 1.5rem 0;
  }
  .rb-filter input {
    width: 100%;
    padding: 0.7rem 1rem;
    border: 1px solid var(--sl-color-hairline, var(--sl-color-gray-5));
    border-radius: 0.6rem;
    background: var(--sl-color-bg-nav, transparent);
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
  }
  .rb-filter input:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .rb-results {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .rb-result a {
    display: block;
    padding: 0.55rem 0.85rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    text-decoration: none;
    color: inherit;
  }
  .rb-result a:hover {
    border-color: var(--sl-color-accent);
    background: var(--nv-accent-softer);
  }
  .rb-result-title {
    display: block;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    color: var(--sl-color-white);
  }
  .rb-result-where {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--sl-text-xs);
    color: var(--nv-quiet);
  }
  .rb-empty {
    margin-top: 1.5rem;
    color: var(--sl-color-gray-3);
  }

  .rb-chapters {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .rb-chapter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.1rem 0.9rem;
    border: 1px solid var(--sl-color-hairline, var(--sl-color-gray-5));
    border-radius: 0.75rem;
    background: var(--sl-color-bg-nav);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 120ms ease,
      background-color 120ms ease;
  }
  .rb-chapter:hover {
    border-color: var(--sl-color-accent);
    background: var(--nv-accent-softer);
  }
  .rb-chapter-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .rb-chapter-title {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rb-chapter-count {
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-text-accent);
  }
  .rb-chapter-sections {
    flex: 1;
    font-size: var(--sl-text-xs);
    line-height: 1.55;
    color: var(--sl-color-gray-3);
  }
  .rb-chapter-sections code {
    font-size: 0.95em;
    color: var(--nv-quiet);
  }
  .rb-chapter-bar {
    display: block;
    height: 3px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--nv-quiet) 30%, transparent);
    overflow: hidden;
  }
  .rb-chapter-bar-fill {
    display: block;
    height: 100%;
    background: var(--nv-ok);
  }
  .rb-chapter-split {
    font-size: 0.68rem;
    color: var(--nv-quiet);
  }
</style>

<script>
  const input = document.getElementById('rb-filter') as HTMLInputElement | null
  const results = document.getElementById('rb-results')
  const chapters = document.getElementById('rb-chapters')
  const empty = document.getElementById('rb-empty')
  const status = document.getElementById('rb-status')

  if (input && results && chapters) {
    const rows = [...results.querySelectorAll<HTMLElement>('.rb-result')]
    // Long enough that a one- or two-letter query does not paint 900 rows, short
    // enough that "csrf" and "jwt" both answer.
    const MIN = 3
    const LIMIT = 40

    const apply = () => {
      const query = input.value.trim().toLowerCase()
      if (query.length < MIN) {
        for (const row of rows) row.hidden = true
        results.hidden = true
        chapters.hidden = false
        if (empty) empty.hidden = true
        if (status) status.textContent = ''
        return
      }
      let shown = 0
      for (const row of rows) {
        const match = (row.dataset.search ?? '').includes(query)
        row.hidden = !match || shown >= LIMIT
        if (match) shown++
      }
      results.hidden = shown === 0
      chapters.hidden = true
      if (empty) empty.hidden = shown > 0
      if (status) status.textContent = `${shown} rule${shown === 1 ? '' : 's'} match`
    }

    input.addEventListener('input', apply)
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = ''
        apply()
      }
    })
  }
</script>
