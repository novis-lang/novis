---
/**
 * One card inside `<Pillars>`.
 *
 * `kicker` is a short all-caps label — a category, not a slogan. It exists so
 * the three cards can be told apart by shape and word before colour, which
 * matters for the reader who cannot separate the hues.
 */
interface Props {
  kicker?: string;
  title: string;
  href?: string;
  linkText?: string;
}

const { kicker, title, href, linkText = 'Read more' } = Astro.props;
---

<article class="nv-pillar">
  {kicker && <span class="nv-pillar-kicker">{kicker}</span>}
  <h3>{title}</h3>
  <p><slot /></p>
  {
    href && (
      <a href={href}>
        {linkText} <span aria-hidden="true">&rarr;</span>
      </a>
    )
  }
</article>
