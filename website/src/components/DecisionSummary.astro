---
/**
 * The plain-language decision summary: every decision Novis has taken, grouped
 * by topic and in the order it was decided, written for a reader who has never
 * opened a decision record.
 *
 * Rendered from src/data/decisions.json, which is generated by
 * `bun nv decisions --render` from the summaries in data/decisions/ in the
 * repository. Nothing here is written by hand — including the group titles and
 * blurbs, which the tool owns so the site and the repository cannot disagree.
 *
 * The prose deliberately carries no cross-references; the one link per entry is
 * added here, by the renderer, so a reader who wants the full reasoning can
 * reach it without the text being about where to reach it. It leaves the site:
 * the frozen records stay in the repository, and what is true now is the
 * rulebook under /docs/rules/.
 */
import decisions from '../data/decisions.json'
import { externalLinkAttrs } from '@config/external-links.mjs'

const total = decisions.groups.reduce((n, g) => n + g.entries.length, 0)
---

<div class="dec not-content">
  <nav class="dec-jump" aria-label="Jump to a group">
    {
      decisions.groups.map((group) => (
        <a href={`#${group.id}`}>
          {group.title} <span class="dec-jump-count">{group.entries.length}</span>
        </a>
      ))
    }
  </nav>

  <label class="dec-filter">
    <span class="sr-only">Filter decisions</span>
    <input
      type="search"
      id="dec-filter"
      placeholder={`Filter ${total} decisions…`}
      autocomplete="off"
    />
  </label>
  <p class="sr-only" role="status" aria-live="polite" id="dec-status"></p>

  <div id="dec-groups">
    {
      decisions.groups.map((group) => (
        <section class="dec-group" id={group.id} data-group>
          <h2 class="dec-group-title">{group.title}</h2>
          <p class="dec-group-blurb">{group.blurb}</p>
          <ol class="dec-list">
            {group.entries.map((entry) => (
              <li
                class="dec-entry"
                data-search={`${entry.headline} ${entry.body}`.toLowerCase()}
              >
                <h3 class="dec-headline">{entry.headline}</h3>
                <p class="dec-body">{entry.body}</p>
                <a class="dec-more" href={entry.url} {...externalLinkAttrs(entry.url)}>
                  the full record
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
  <p class="dec-empty" id="dec-empty" hidden>Nothing matches that.</p>
</div>

<style>
  .dec-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
  }
  .dec-jump a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--sl-color-hairline, var(--sl-color-gray-5));
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .dec-jump a:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }
  .dec-jump-count {
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }

  .dec-filter input {
    width: 100%;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--sl-color-hairline, var(--sl-color-gray-5));
    border-radius: 0.4rem;
    background: var(--sl-color-bg-nav, transparent);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .dec-filter input:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .dec-group {
    margin-top: 2.75rem;
    scroll-margin-top: 6rem;
  }
  .dec-group-title {
    margin: 0;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }
  .dec-group-blurb {
    margin: 0.4rem 0 0;
    max-width: 62ch;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .dec-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .dec-entry {
    border-left: 2px solid var(--sl-color-hairline, var(--sl-color-gray-5));
    padding-left: 1rem;
  }
  .dec-headline {
    margin: 0;
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .dec-body {
    margin: 0.4rem 0 0;
    max-width: 70ch;
    font-size: var(--sl-text-sm);
    line-height: 1.65;
  }
  .dec-more {
    display: inline-block;
    margin-top: 0.35rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .dec-more:hover {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }
  .dec-empty {
    margin-top: 2rem;
    color: var(--sl-color-gray-3);
  }
</style>

<script>
  const input = document.getElementById('dec-filter') as HTMLInputElement | null
  const empty = document.getElementById('dec-empty')
  const status = document.getElementById('dec-status')
  if (input) {
    const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')]
    const apply = () => {
      const query = input.value.trim().toLowerCase()
      let shown = 0
      for (const group of groups) {
        let inGroup = 0
        for (const entry of group.querySelectorAll<HTMLElement>('.dec-entry')) {
          const match = query === '' || (entry.dataset.search ?? '').includes(query)
          entry.hidden = !match
          if (match) inGroup++
        }
        // A group whose every entry is filtered out takes its heading with it.
        group.hidden = inGroup === 0
        shown += inGroup
      }
      if (empty) empty.hidden = shown > 0
      if (status) {
        status.textContent = query === '' ? '' : `${shown} decision${shown === 1 ? '' : 's'} match`
      }
    }
    input.addEventListener('input', apply)
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = ''
        apply()
      }
    })
  }
</script>
