---
/**
 * Footer override: keeps Starlight's edit link and adds the site-wide
 * three-column footer below it. There are no previous and next links: a page
 * links to what comes next in its own text. There is no "last updated"
 * stamp -- see `lastUpdated` in astro.config.ts for why.
 */
import EditLink from 'virtual:starlight/components/EditLink'
import { GITHUB_URL, DISCORD_URL, AREAS, INSTALL } from '@config/site.mjs'
import { externalLinkAttrs } from '@config/external-links.mjs'
import { withBase } from '~/lib/base'

const year = new Date().getFullYear()

const columns = [
  {
    title: 'Learn',
    links: [INSTALL, ...AREAS].map(({ label, href }) => ({ label, href: withBase(href) })),
  },
  {
    title: 'Project',
    links: [
      { label: 'Release notes', href: withBase('/in-depth/what-changed/') },
      { label: 'Sponsoring', href: withBase('/sponsoring/') },
      { label: 'GitHub', href: GITHUB_URL },
      { label: 'Discord', href: DISCORD_URL },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Impressum', href: withBase('/impressum/') },
      { label: 'Datenschutzerklärung', href: withBase('/datenschutz/') },
      { label: 'License', href: `${GITHUB_URL}/blob/main/LICENSE` },
    ],
  },
]
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
  </div>

  <div class="site-footer">
    <div class="site-footer-grid">
      {
        columns.map((col) => (
          <div class="site-footer-col">
            <h2>{col.title}</h2>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href} {...externalLinkAttrs(link.href)}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="site-footer-note">© {year} The Novis project. Novis is open source.</p>
  </div>
</footer>

<style>
  footer {
    flex-direction: column;
    gap: 1.5rem;
  }
  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .site-footer {
    margin-top: 2rem;
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 2rem;
  }
  .site-footer-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  @media (max-width: 40rem) {
    .site-footer-grid {
      grid-template-columns: 1fr;
    }
  }
  .site-footer-col h2 {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
    margin: 0 0 0.75rem;
  }
  .site-footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .site-footer-col a {
    color: var(--sl-color-gray-2);
    text-decoration: none;
    font-size: var(--sl-text-sm);
  }
  .site-footer-col a:hover {
    color: var(--sl-color-text-accent);
  }
  .site-footer-note {
    margin-top: 2rem;
    font-size: var(--sl-text-xs);
    /* gray-3, not -4: the ramp's -4 step is a hairline tone, and this is the
       smallest running text on the site. */
    color: var(--sl-color-gray-3);
  }
</style>
