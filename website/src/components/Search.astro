---
/**
 * Search override: Starlight's own search dialog, with a list of pages found
 * by name between the input and Pagefind's results. The names are
 * /search/names.json (src/pages/search/names.json.ts), fetched once when the
 * input is first focused or typed in; after that, every keystroke matches in memory and
 * the list appears before Pagefind has answered. Pagefind still searches the
 * text of every page.
 *
 * A word of the query matches a word of a name when it is the whole word or
 * its start: `str len` finds `Core\Str::length`, and `memory limit` finds the
 * `limits.memory` key. A camelCase name also matches on each of its words.
 * Every word of the query has to match, so a question in plain words lists
 * nothing here and is left to Pagefind.
 *
 * A page the list shows is hidden from Pagefind's results, so no page is
 * listed twice. Pagefind's count above its results still counts it.
 *
 * Arrow keys move through the list, and Enter opens the selected page — the
 * first one when none is selected.
 */
import Default from '@astrojs/starlight/components/Search.astro'
---

<Default {...Astro.props} />

<script>
  type Kind = 'class' | 'method' | 'setting' | 'command'
  type Entry = [name: string, url: string, summary: string, kind: Kind]
  interface Named {
    name: string
    url: string
    summary: string
    kind: Kind
    /** The words of the name, lowercased, each camelCase word on its own as well as whole. */
    words: string[]
    /** The page's path and fragment, as the dedup against Pagefind compares them. */
    key: string
  }

  const SHOWN = 6
  const KIND_LABEL: Record<Kind, string> = { class: 'Class', method: 'Method', setting: 'Setting', command: 'Command' }

  const splitWords = (text: string) => text.split(/[^A-Za-z0-9]+/).filter(Boolean)

  /** A path and fragment with no trailing slash, so `/a/` and `/a` compare equal. */
  const pageKey = (href: string) => {
    const url = new URL(href, location.href)
    return `${url.pathname.replace(/\/+$/, '')}${url.hash}`
  }

  const toNamed = ([name, url, summary, kind]: Entry): Named => {
    const parts = splitWords(name)
    if ((kind === 'class' || kind === 'method') && parts[0] === 'Core') parts.shift()
    const words = new Set<string>()
    for (const part of parts) {
      words.add(part.toLowerCase())
      for (const piece of part.split(/(?<=[a-z0-9])(?=[A-Z])/)) words.add(piece.toLowerCase())
    }
    return { name, url, summary, kind, words: [...words], key: pageKey(url) }
  }

  /** The score of a name for the query's words, or 0 when one word matches nothing. */
  const score = (named: Named, query: string[]) => {
    let total = 0
    for (const word of query) {
      let best = 0
      for (const w of named.words) {
        if (w === word) {
          best = 3
          break
        }
        if (w.startsWith(word)) best = 2
      }
      if (best === 0) return 0
      total += best
    }
    return total
  }

  const find = (names: Named[], text: string) => {
    const query = splitWords(text.toLowerCase())
    if (query[0] === 'core' && query.length > 1) query.shift()
    if (query.join('').length < 2) return []
    const hits: { named: Named; score: number }[] = []
    for (const named of names) {
      const s = score(named, query)
      if (s > 0) hits.push({ named, score: s })
    }
    hits.sort((a, b) => b.score - a.score || a.named.name.length - b.named.name.length || a.named.name.localeCompare(b.named.name))
    return hits.slice(0, SHOWN).map((h) => h.named)
  }

  const attach = (root: HTMLElement) => {
    const form = root.querySelector<HTMLFormElement>('.pagefind-ui__form')
    const input = root.querySelector<HTMLInputElement>('.pagefind-ui__search-input')
    const drawer = root.querySelector<HTMLElement>('.pagefind-ui__drawer')
    if (!form || !input || !drawer) return false

    const list = document.createElement('nav')
    list.className = 'nv-names'
    list.setAttribute('aria-label', 'Pages found by name')
    list.hidden = true
    form.insertBefore(list, drawer)

    let names: Named[] | null = null
    let loading: Promise<void> | null = null
    let hits: Named[] = []
    let active = 0

    const load = () => {
      loading ??= fetch(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/search/names.json`)
        .then((r) => r.json() as Promise<Entry[]>)
        .then((entries) => {
          names = entries.map(toNamed)
          render()
        })
        .catch(() => {
          loading = null
        })
      return loading
    }

    /**
     * Hides each Pagefind result, or sub-result, that the list already shows. Pagefind's CSS
     * sets `display` on both, which the `hidden` attribute does not override.
     */
    const dedupe = () => {
      const shown = new Set(hits.map((h) => h.key))
      const hide = (el: HTMLElement, link: HTMLAnchorElement | null) => {
        el.style.display = link && shown.has(pageKey(link.href)) ? 'none' : ''
      }
      for (const result of drawer.querySelectorAll<HTMLElement>('.pagefind-ui__result')) {
        hide(result, result.querySelector('.pagefind-ui__result-title .pagefind-ui__result-link'))
        for (const nested of result.querySelectorAll<HTMLElement>('.pagefind-ui__result-nested')) {
          hide(nested, nested.querySelector('.pagefind-ui__result-link'))
        }
      }
    }

    const render = () => {
      if (!names) load()
      hits = names ? find(names, input.value) : []
      active = 0
      list.replaceChildren(
        ...hits.map((named, i) => {
          const a = document.createElement('a')
          a.href = named.url
          a.className = i === active ? 'nv-name is-active' : 'nv-name'
          const title = document.createElement('span')
          title.className = 'nv-name-title'
          title.textContent = named.name
          const kind = document.createElement('span')
          kind.className = 'nv-name-kind'
          kind.textContent = KIND_LABEL[named.kind]
          a.append(title, kind)
          if (named.summary) {
            const summary = document.createElement('span')
            summary.className = 'nv-name-summary'
            summary.textContent = named.summary
            a.append(summary)
          }
          return a
        })
      )
      list.hidden = hits.length === 0
      dedupe()
    }

    const select = (next: number) => {
      const links = list.querySelectorAll<HTMLAnchorElement>('.nv-name')
      links[active]?.classList.remove('is-active')
      active = (next + hits.length) % hits.length
      links[active]?.classList.add('is-active')
      links[active]?.scrollIntoView({ block: 'nearest' })
    }

    input.addEventListener('focus', load)
    input.addEventListener('input', render)
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        // Pagefind clears the input itself, after this handler.
        setTimeout(render)
        return
      }
      if (hits.length === 0) return
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault()
        select(active + (e.key === 'ArrowDown' ? 1 : -1))
      } else if (e.key === 'Enter') {
        e.preventDefault()
        list.querySelectorAll<HTMLAnchorElement>('.nv-name')[active]?.click()
      }
    })
    root.querySelector('.pagefind-ui__search-clear')?.addEventListener('click', () => setTimeout(render))
    new MutationObserver(dedupe).observe(drawer, { childList: true, subtree: true })
    if (document.activeElement === input) load()
    return true
  }

  // Starlight creates the Pagefind UI when the browser is idle after load; wait for its input.
  const root = document.getElementById('starlight__search')
  if (root && !attach(root)) {
    const waiting = new MutationObserver(() => {
      if (attach(root)) waiting.disconnect()
    })
    waiting.observe(root, { childList: true, subtree: true })
  }
</script>

<style is:global>
  .nv-names {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1rem;
  }
  .nv-names[hidden] {
    display: none;
  }
  .nv-name {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--nv-radius);
    background-color: var(--sl-color-black);
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .nv-name:hover,
  .nv-name.is-active {
    border-color: var(--sl-color-accent);
    background-color: var(--nv-wash-soft);
  }
  .nv-name-title {
    overflow: hidden;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .nv-name-kind {
    align-self: center;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
  .nv-name-summary {
    grid-column: 1 / -1;
    overflow: hidden;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
