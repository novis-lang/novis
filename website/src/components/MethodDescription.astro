---
/**
 * The default body of a method page's "Description" section: the registry's
 * short description (ADR 0117) and/or the spec's per-member note, else an
 * honest "not documented yet". A human writes the real description by
 * replacing this component with prose — this is the section registry docs
 * never fully cover, because extended prose stays in the page by design.
 */
import { findMember } from '~/lib/core'

interface Props {
  id: string
}

const { id } = Astro.props
const found = findMember(id)
if (!found) throw new Error(`MethodDescription: unknown member id "${id}" — run \`npm run sync:render\`?`)
const { member } = found

const parts: string[] = []
if (member.doc?.shortHtml) parts.push(member.doc.shortHtml)
if (member.notesHtml) parts.push(`The specification notes: ${member.notesHtml}`)
---

{parts.length > 0 ? parts.map((p) => <p set:html={p} />) : <p><em>Not documented yet.</em></p>}
