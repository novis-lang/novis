---
/**
 * A grid of equal-weight cards, separated by hairlines rather than boxed with
 * shadows. Used for the landing page's three-part pitch and for section
 * indexes. Wrap `<Pillar>` children.
 */
interface Props {
  cols?: 2 | 3;
}
const { cols = 3 } = Astro.props;
---

<div class="nv-pillars" data-cols={String(cols)}>
  <slot />
</div>
