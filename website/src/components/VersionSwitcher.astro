---
/**
 * The version switcher.
 *
 * Each documentation version is a **separate build of this same tree** at a
 * different base path — `/` for latest stable, `/main/` for the development
 * line, `/v0.3/` for a tag. Nothing about a version lives twice in the
 * repository; CI checks out the ref and builds it. See `website/README.md`.
 *
 * That has one consequence this component exists to handle: a build cut months
 * ago cannot know about versions released since. So the list is fetched at
 * runtime from `/versions.json`, which the assembly step writes at the site
 * root and every version therefore shares. Until that fetch lands — and on a
 * local build, where the file does not exist — the switcher shows this build's
 * own version and nothing else, which is true rather than empty.
 *
 * No framework, no hydration: one `<select>` and a small inline script.
 */
import { SITE_VERSION } from '../site.config';

const current = SITE_VERSION;
---

<div class="nv-versions" data-current={current}>
  <label class="sr-only" for="nv-version-select">Documentation version</label>
  <select id="nv-version-select" aria-label="Documentation version">
    <option value="" selected>{current}</option>
  </select>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('.nv-versions');
    if (!root) return;
    const select = root.querySelector('select');
    const current = root.dataset.current;

    // Same-origin, static file, written by the multi-version assembly step.
    // A local single-version build simply 404s here and keeps the one option.
    fetch('/versions.json', { cache: 'no-cache' })
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (!data || !Array.isArray(data.versions) || data.versions.length < 2) return;

        select.replaceChildren();
        for (const v of data.versions) {
          const opt = document.createElement('option');
          opt.value = v.base;
          opt.textContent = v.label + (v.preview ? ' (preview)' : v.default ? ' (latest)' : '');
          opt.selected = v.label === current;
          select.append(opt);
        }

        const active = data.versions.find((v) => v.label === current);
        root.dataset.preview = String(Boolean(active && active.preview));

        select.addEventListener('change', () => {
          const base = select.value || '/';
          // Try to land on the same page in the target version; fall back to
          // that version's root when the page does not exist there. A 404 is
          // worse than a landing, so we probe first.
          const here = location.pathname;
          const rest = active ? here.slice(active.base.replace(/\/$/, '').length) : here;
          const target = base.replace(/\/$/, '') + rest;
          fetch(target, { method: 'HEAD' })
            .then((r) => {
              location.href = r.ok ? target : base;
            })
            .catch(() => {
              location.href = base;
            });
        });
      })
      .catch(() => {
        /* offline or single-version build — the one option stands */
      });
  })();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
