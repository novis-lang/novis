---
/**
 * The project's live status, straight from `docs/implementation-plan.md`.
 *
 * The plan's status block has a fixed field set that the team overwrites in
 * place every working session. Rendering it here means the answer to "can I
 * use this yet" is never a stale copy — there is no copy.
 *
 * Prose around this component is authored. Facts inside it are not.
 */
import { existsSync, readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const url = new URL('../generated/status.json', import.meta.url);
const data = existsSync(fileURLToPath(url))
  ? JSON.parse(readFileSync(url, 'utf8'))
  : { available: false };

interface Props {
  /** Which fields to show, in order. Omit for all of them. */
  fields?: string[];
  milestones?: boolean;
}

const { fields, milestones = false } = Astro.props;

const all: Record<string, string> = data.fields ?? {};
const shown = (fields ?? Object.keys(all)).filter((k) => all[k]);
---

{
  !data.available ? (
    <p>
      <em>Status data was not available when this page was built.</em>
    </p>
  ) : (
    <>
      <dl class="nv-status">
        {shown.map((key) => (
          <div class="nv-status-row">
            <dt>{key}</dt>
            <dd>{all[key]}</dd>
          </div>
        ))}
      </dl>

      {milestones && data.milestones?.length > 0 && (
        <table class="nv-milestones">
          <thead>
            <tr>
              <th>Milestone</th>
              <th>What it delivers</th>
            </tr>
          </thead>
          <tbody>
            {data.milestones.map((m: { id: string; title: string }) => (
              <tr>
                <td>
                  <code>{m.id}</code>
                </td>
                <td>{m.title}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      <p class="nv-status-provenance">
        Generated from <code>{data.generatedFrom}</code>
        {data.date ? ` as of ${data.date}` : ''}. Edit that file, not this page.
      </p>
    </>
  )
}

<style>
  .nv-status {
    margin: 1.5rem 0;
    border-block-start: 1px solid var(--nv-rule);
  }

  .nv-status-row {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-block: 0.85rem;
    border-block-end: 1px solid var(--nv-rule);
  }

  @media (min-width: 40rem) {
    .nv-status-row {
      grid-template-columns: 10rem 1fr;
    }
  }

  .nv-status dt {
    font-weight: 650;
    font-size: 0.875rem;
    color: var(--nv-ink);
  }

  .nv-status dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--nv-ink-muted);
  }

  .nv-milestones {
    font-size: 0.9375rem;
  }

  .nv-status-provenance {
    font-size: 0.8125rem;
    color: var(--nv-ink-faint);
    margin-block-start: 1.5rem;
  }
</style>
