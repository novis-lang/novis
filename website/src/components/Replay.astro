---
/**
 * A recorded editor session that ends on one snippet from website/snippets/,
 * played like the VS Code extension. `src` names the snippet:
 *
 *   <Replay src="install/property-key-completion.nvs" />
 *
 * The `.replay` beside the snippet lists the steps, and the `.replay.out`
 * beside it is what `nvs lsp` returned for them. `tools/nv/cmd/site.ts`
 * § *A snippet* is the home of both formats, and `bun nv site --check
 * snippets` fails when the server returns something else. The replay ends on
 * the snippet's code, so a page needs no `<Snippet>` of the same file to show
 * that code.
 *
 * It is one tinted panel: a header and a notice that say it is a recording,
 * the editor window with its title bar and a progress bar, one button, and the
 * steps as text. The panel has its own look, so a reader does not take it for
 * a code example to copy. The window has the page's code colours in the dark
 * and the light theme.
 *
 * The code's font gets smaller until the widest line fits, and stops at 12px,
 * so the code stays readable on a phone. A line that is still too wide does not
 * wrap. The code scrolls sideways instead, and the player keeps the cursor and
 * the open list or card in view.
 *
 * A snippet with a `.dap` beside it, and no `.replay`, gets a debugger replay:
 * the `.dap` lists breakpoints and steps, and the `.dap.out` is what `nvs dap`
 * returned at each stop. The code does not change. Each frame shows the
 * breakpoints, the line the program stopped on, and the call stack and the
 * variables in a panel under that line. `config/replay-dap.mjs` writes its
 * frames.
 *
 * What is recorded: each completion list, each diagnostic, and where each list
 * opens, and each rename, code action, code lens, call hierarchy and hover card
 * with the edits it makes. What is imitated: the list narrowing as letters are typed, the typing
 * pace and the editor's look. It is close to VS Code and is not its exact
 * behaviour. `config/replay-frames.mjs` writes the HTML and the frames when the
 * site is built, `config/replay-colours.mjs` colours the code the way a
 * `<Snippet>` is coloured, and `config/replay-player.mjs` plays them.
 */
import { colourLines } from '../../config/replay-colours.mjs'
import { dapMarkup, dapOf, frameTexts, replayMarkup, replayOf } from '../../config/replay-frames.mjs'

interface Props {
  /** The snippet's path under website/snippets/. */
  src: string
}

// The globs below are relative to this file, so their keys start with this prefix.
const ROOT = '../../snippets/'

const sources = import.meta.glob('../../snippets/**/*.nvs', { query: '?raw', import: 'default', eager: true }) as Record<string, string>
const replays = import.meta.glob('../../snippets/**/*.replay', { query: '?raw', import: 'default', eager: true }) as Record<string, string>
const recordings = import.meta.glob('../../snippets/**/*.replay.out', { query: '?raw', import: 'default', eager: true }) as Record<string, string>
const daps = import.meta.glob('../../snippets/**/*.dap', { query: '?raw', import: 'default', eager: true }) as Record<string, string>
const dapRecordings = import.meta.glob('../../snippets/**/*.dap.out', { query: '?raw', import: 'default', eager: true }) as Record<string, string>

const { src } = Astro.props
const text = sources[`${ROOT}${src}`]
if (text === undefined) throw new Error(`Replay: no file website/snippets/${src}`)
const beside = (ext: string) => `${ROOT}${src.replace(/\.nvs$/, ext)}`
const replay = replays[beside('.replay')]
const dap = daps[beside('.dap')]
if (replay === undefined && dap === undefined) throw new Error(`Replay ${src}: there is no .replay or .dap beside it`)
const recording = replay === undefined ? dapRecordings[beside('.dap.out')] : recordings[beside('.replay.out')]
const out = replay === undefined ? '.dap.out' : '.replay.out'
if (recording === undefined) throw new Error(`Replay ${src}: there is no ${out} beside it; run \`bun nv site --bless\` on the snippet`)
const where = `website/snippets/${src}`
const title = src.split('/').at(-1)!
const install = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/install/editor/`
// Each frame's code is coloured by the engine that colours a <Snippet>, once per distinct text.
const data = replay === undefined ? dapOf({ dap: dap!, recording, text, title, where }) : replayOf({ replay, recording, where })
const texts = [...new Set(frameTexts(data))]
const coloured = new Map(await Promise.all(texts.map(async (t) => [t, await colourLines(t)] as const)))
const colours = (t: string) => coloured.get(t)!
const html = replay === undefined ? dapMarkup({ dap: dap!, recording, text, title, install, where, colours }) : replayMarkup({ replay, recording, title, install, where, colours })
---

<Fragment set:html={html} />

<script>
  import { startReplays } from '../../config/replay-player.mjs'
  startReplays()
</script>

<style is:global>
  /* The panel: the accent wash and an accent border, in both themes. */
  .nv-replay {
    margin: 1.5rem 0 0;
    padding: 1rem;
    border: 1px solid color-mix(in oklab, var(--sl-color-accent) 35%, transparent);
    border-radius: var(--nv-radius-lg, 1rem);
    background: var(--nv-wash-soft);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .nv-replay-head {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    line-height: 1.45;
  }
  .nv-replay-icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in oklab, var(--sl-color-accent) 30%, transparent);
    border-radius: var(--nv-radius, 0.625rem);
    background: var(--nv-wash);
    color: var(--sl-color-text-accent);
    font-size: 1.25rem;
  }
  .nv-replay-heading {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .nv-replay-title {
    font-size: var(--sl-text-base);
    font-weight: 650;
    color: var(--sl-color-white);
  }
  .nv-replay-note {
    color: var(--sl-color-gray-2);
  }
  .nv-replay a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .nv-replay a:hover {
    color: var(--sl-color-white);
  }

  /* The editor window: a title bar with three dots and the file name, the code, and the progress bar. */
  .nv-replay-frame {
    container-type: inline-size;
    overflow: hidden;
    border: 1px solid var(--nv-hairline-strong, var(--sl-color-gray-5));
    border-radius: var(--nv-radius, 0.625rem);
    background: var(--nv-code-bg);
    box-shadow: var(--nv-shadow-md, none);
    color: var(--sl-color-white);
    cursor: default;
    user-select: none;
  }
  .nv-replay-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.8rem;
    border-bottom: 1px solid var(--nv-hairline, var(--sl-color-gray-5));
    background: var(--nv-surface-2, var(--sl-color-black));
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
  }
  .nv-replay-dots {
    display: inline-flex;
    gap: 0.35rem;
  }
  .nv-replay-dots i {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--nv-hairline-strong, var(--sl-color-gray-5));
  }
  .nv-replay-tab {
    font-family: var(--__sl-font-mono, monospace);
  }
  /* The font gets smaller until the widest line, its line number and the cursor fit, and stops at 12px.
     JetBrains Mono is 0.6em wide per character. A line that is still too wide does not wrap: the code
     scrolls sideways, and the player keeps the cursor in view. The window is inert, so only the player
     scrolls it. */
  .nv-replay-code {
    --nv-lh: 1.6em;
    --nv-gutter: calc(0.75rem + 5ch);
    --nv-fit: calc((100cqi - 0.75rem) / ((var(--nv-cols) + 7) * 0.6));
    position: relative;
    overflow: hidden;
    padding: 0.75rem 0;
    min-height: calc((var(--nv-rows) + 7) * var(--nv-lh));
    font-family: var(--__sl-font-mono, monospace);
    font-size: clamp(0.75rem, var(--nv-fit), var(--sl-text-sm, 0.875rem));
    line-height: var(--nv-lh);
  }
  .nv-replay .nv-line {
    display: flex;
    width: max-content;
    min-width: 100%;
    height: var(--nv-lh);
    padding-right: 2ch;
    white-space: pre;
  }
  /* A token's colours are those of a <Snippet>: --0 in the dark theme, --1 in the light one. */
  .nv-replay .nv-text span[style^='--'] {
    color: var(--0, inherit);
    font-style: var(--0fs, inherit);
    font-weight: var(--0fw, inherit);
  }
  :root[data-theme='light'] .nv-replay .nv-text span[style^='--'] {
    color: var(--1, inherit);
    font-style: var(--1fs, inherit);
    font-weight: var(--1fw, inherit);
  }
  /* The line numbers are --nv-gutter wide, and they stay in place when the code scrolls sideways. */
  .nv-replay .nv-ln {
    position: sticky;
    left: 0;
    flex: none;
    box-sizing: content-box;
    width: 3ch;
    padding: 0 2ch 0 0.75rem;
    background: var(--nv-code-bg);
    text-align: right;
    color: var(--sl-color-gray-4);
  }
  .nv-replay .nv-caret {
    display: inline-block;
    width: 0;
    height: 1.2em;
    margin-right: -2px;
    vertical-align: text-bottom;
    border-left: 2px solid var(--sl-color-white, currentColor);
    /* The replay's root is a `data-motion` region (config/replay-frames.mjs),
       so the blink pauses while the replay is off screen. */
    animation: nv-blink 1s step-end infinite;
  }
  @keyframes nv-blink {
    50% {
      border-color: transparent;
    }
  }
  .nv-replay .nv-squiggle {
    text-decoration: underline wavy var(--sl-color-red);
    text-decoration-skip-ink: none;
    text-underline-offset: 0.2em;
  }
  /* A list opens on the line under the cursor, at the column where the completed word starts. It is as
     wide as its rows, even where it opens past the visible part of the code. */
  .nv-replay .nv-list,
  .nv-replay .nv-hover {
    --nv-left: calc(var(--nv-gutter) + var(--nv-col) * 1ch);
    position: absolute;
    top: calc(0.75rem + var(--nv-line) * var(--nv-lh));
    left: var(--nv-left);
    width: max-content;
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    background: var(--sl-color-black);
    box-shadow: var(--sl-shadow-md);
  }
  /* An empty box right of the list or the card, so the code scrolls far enough to leave a gap after it. */
  .nv-replay .nv-list::after,
  .nv-replay .nv-hover::after {
    content: '';
    position: absolute;
    top: 0;
    left: 100%;
    width: 0.5rem;
    height: 1px;
  }
  .nv-replay .nv-list {
    min-width: 22ch;
    padding: 0.15rem 0;
    list-style: none;
  }
  .nv-replay .nv-row {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0 0.5rem 0 0.25rem;
    white-space: pre;
  }
  .nv-replay .nv-selected {
    background: color-mix(in oklab, var(--sl-color-accent) 30%, transparent);
  }
  .nv-replay .nv-kind {
    flex: none;
    width: 2ch;
    margin-right: 0.5ch;
    text-align: center;
  }
  .nv-replay .nv-kind-fn {
    color: var(--sl-color-purple);
  }
  .nv-replay .nv-kind-var {
    color: var(--sl-color-blue);
  }
  .nv-replay .nv-kind-type {
    color: var(--sl-color-orange);
  }
  .nv-replay .nv-kind-word {
    color: var(--sl-color-gray-3);
  }
  .nv-replay .nv-row mark {
    padding: 0;
    background: none;
    color: var(--sl-color-accent-high);
    font-weight: 700;
  }
  .nv-replay .nv-after,
  .nv-replay .nv-right {
    color: var(--sl-color-gray-3);
  }
  .nv-replay .nv-right {
    margin-left: auto;
    padding-left: 2ch;
  }
  /* The error card wraps its text to fit the space right of where it opens, when that space is at least
     36 characters wide. It is never wider than the code right of the line numbers, or than 60 characters. */
  .nv-replay .nv-hover {
    max-width: min(60ch, max(100% - var(--nv-left) - 0.5rem, 36ch), 100cqi - var(--nv-gutter) - 1rem);
    padding: 0.35rem 0.6rem;
    white-space: pre-wrap;
  }
  .nv-replay .nv-hover-code {
    color: var(--sl-color-gray-3);
  }
  /* A code lens is a grey line above the line it is about. It has no line number. */
  .nv-replay .nv-lens .nv-text {
    color: var(--sl-color-gray-3);
    font-size: 0.85em;
  }
  /* The rename box shows the new name, as the editor's input box does. */
  .nv-replay .nv-rename {
    padding: 0.1rem 0.25rem;
    white-space: pre;
  }
  .nv-replay .nv-rename-input {
    display: inline-block;
    min-width: 16ch;
    padding: 0 0.35rem;
    border: 1px solid var(--sl-color-accent);
  }
  .nv-replay .nv-actions .nv-label {
    padding-left: 0.25rem;
  }
  /* A hover card and the call hierarchy wrap their text as the error card does. */
  .nv-replay .nv-card,
  .nv-replay .nv-calls {
    white-space: normal;
  }
  .nv-replay .nv-card p,
  .nv-replay .nv-card ul,
  .nv-replay .nv-card hr {
    margin: 0.35rem 0;
  }
  .nv-replay .nv-card ul {
    padding-left: 1.5ch;
  }
  .nv-replay .nv-card hr {
    border: none;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .nv-replay .nv-card-code {
    margin: 0;
    padding: 0;
    background: none;
    white-space: pre-wrap;
  }
  .nv-replay .nv-calls-title {
    margin-top: 0.35rem;
    color: var(--sl-color-gray-3);
  }
  /* A breakpoint is a red dot left of its line number, and the line the program stopped on has a yellow
     background, as in VS Code. */
  .nv-replay .nv-break .nv-ln::before {
    content: '';
    position: absolute;
    top: calc(50% - 0.3em);
    left: 0.3rem;
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--sl-color-red);
  }
  .nv-replay .nv-stopped,
  .nv-replay .nv-stopped .nv-ln {
    background: color-mix(in oklab, var(--sl-color-orange) 25%, var(--nv-code-bg));
  }
  .nv-replay .nv-debug .nv-calls-title:first-child {
    margin-top: 0;
  }
  .nv-replay-progress {
    height: 3px;
    background: var(--nv-hairline, var(--sl-color-gray-5));
  }
  .nv-replay-progress span {
    display: block;
    height: 100%;
    background: var(--sl-color-accent);
    transform: scaleX(var(--nv-progress, 0));
    transform-origin: left;
    transition: transform 0.2s linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .nv-replay .nv-caret {
      animation: none;
    }
    .nv-replay-progress span {
      transition: none;
    }
  }

  /* One button: the site's primary button, smaller. */
  .nv-replay-controls {
    margin-top: 0.85rem;
  }
  .nv-replay .nv-replay-button {
    min-height: 2.25rem;
    padding: 0.4rem 1rem;
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 650;
    cursor: pointer;
  }
  .nv-replay .nv-replay-button svg,
  .nv-replay .nv-replay-button:hover svg {
    flex: none;
    transform: none;
  }
  .nv-replay .nv-replay-button:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .nv-replay-steps {
    margin-top: 0.85rem;
    color: var(--sl-color-gray-2);
  }
  .nv-replay-steps summary {
    cursor: pointer;
    color: var(--sl-color-white);
  }
  .nv-replay-steps ol {
    margin: 0.5rem 0 0;
    padding-left: 1.5rem;
    list-style: decimal;
  }
  .nv-replay-steps li + li {
    margin-top: 0.25rem;
  }
  .nv-replay-steps code {
    padding: 0.05rem 0.3rem;
    border-radius: var(--nv-radius-sm, 0.375rem);
    background: var(--nv-code-bg);
    font-family: var(--__sl-font-mono, monospace);
    font-size: 0.9em;
  }
</style>
