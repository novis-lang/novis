---
/**
 * A grid of equal-weight cards. Wrap `<Card>` children.
 *
 * Real cards with real gaps, rather than tiles separated by a one-pixel grid
 * gap over a coloured background — that trick reads as overlapping boxes the
 * moment anything about the layout is off, which is exactly what happened the
 * first time this site was built.
 */
interface Props {
  cols?: 2 | 3;
}
const { cols = 3 } = Astro.props;
---

<div class="nv-cards" data-cols={String(cols)}>
  <slot />
</div>
