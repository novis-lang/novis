---
/**
 * The frame of one walkthrough: the stage the parts sit in, the caption under it and the controls.
 * A scene component puts its parts in the slot and starts itself with a client script; see
 * `scenes/AfterResponse.astro` for the shape.
 *
 *   <Stage id="after-response" label="How afterResponse works, step by step">…parts…</Stage>
 */
import './walkthrough.css'

interface Props {
  /** The element id, which the scene's script finds the stage by. */
  id: string
  /** What the walkthrough shows, for a screen reader. */
  label: string
}

const { id, label } = Astro.props
---

<section class="wt not-content" id={id} tabindex="0" aria-label={label} data-captions="on">
  <div class="wt-viewport">
    <div class="wt-world">
      <slot />
    </div>
    <button class="wt-start" type="button" aria-label="Play">
      <span>
        <svg width="34" height="34" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
      </span>
    </button>
  </div>
  <p class="wt-caption" aria-live="polite"></p>
  <div class="wt-controls">
    <button class="wt-btn-i wt-prev" type="button" aria-label="Previous step">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M18 5.5v13L8.5 12z" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
    </button>
    <button class="wt-btn-i wt-play-i" type="button" aria-label="Play or pause">
      <svg class="wt-i-play" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15L19.5 12z" fill="currentColor"></path></svg>
      <svg class="wt-i-pause" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5h3.5v15H7zM13.5 4.5H17v15h-3.5z" fill="currentColor"></path></svg>
    </button>
    <button class="wt-btn-i wt-next" type="button" aria-label="Next step">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M6 5.5v13L15.5 12z" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
    </button>
    <div class="wt-scrub" role="slider" aria-label="Position" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="wt-scrub-track"><div class="wt-scrub-fill"></div></div>
    </div>
    <div class="wt-step"></div>
    <button class="wt-btn-i wt-cc" type="button" aria-label="Captions" aria-pressed="true">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="3" fill="none" stroke="currentColor" stroke-width="2"></rect><path d="M10.5 10.2a2.2 2.2 0 1 0 0 3.6M16.5 10.2a2.2 2.2 0 1 0 0 3.6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
    </button>
    <button class="wt-btn-i wt-full" type="button" aria-label="Fullscreen">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </button>
  </div>
</section>
