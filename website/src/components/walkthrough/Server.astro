---
/**
 * The markup of a `Server` part: a window whose body holds the request lanes `parts/server.ts`
 * draws. `pps` is how many world units a bar grows per scene second.
 */
import { placeAttrs, type Place } from './rect'

interface Props {
  name: string
  place: Place
  title: string
  pps?: number
}

const { name, place, title, pps = 120 } = Astro.props
---

<div class="wt-part wt-server" data-part={name} data-pps={pps} {...placeAttrs(place)}>
  <div class="wt-win">
    <div class="wt-titlebar">
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="2"></rect><rect x="3" y="13" width="18" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="2"></rect><circle cx="7" cy="7.5" r="1.3" fill="currentColor"></circle><circle cx="7" cy="16.5" r="1.3" fill="currentColor"></circle></svg>
      <span class="wt-title">{title}</span>
    </div>
    <div class="wt-lanes"></div>
  </div>
</div>
