---
/**
 * The markup of an `Editor` part: a code window with snippets from website/snippets/, coloured the way
 * a `<Snippet>` is. `parts/editor.ts` animates it.
 *
 *   <Editor name="editor" src="walkthroughs/after-response.nvs" place={{ wide: [60, 60, 700, 420] }} />
 *
 * With several files, `src` is a list and `tabs` names the tab of each, in the same order. Files with
 * the same tab name share one tab, so the scene can change what a file says. A `.js` file is coloured
 * as JavaScript.
 *
 * A line that is exactly `// stage: cut` ends what the window shows of a file. The lines below it are
 * there so the snippet runs, and the stage never shows them.
 */
import { colourLines } from '../../../config/replay-colours.mjs'
import { placeAttrs, type Place } from './rect'

interface Props {
  name: string
  /** The snippet's path under website/snippets/, or one path per file. */
  src: string | string[]
  /** One tab name per file in `src`. Without it, the window has one file and no tabs. */
  tabs?: string[]
  place: Place
  /** The window title of a window with one file; the file name when not given. */
  title?: string
}

const sources = import.meta.glob('../../../snippets/**/*.{nvs,js}', { query: '?raw', import: 'default', eager: true }) as Record<string, string>
const { name, src, tabs, place, title } = Astro.props
const srcs = Array.isArray(src) ? src : [src]
if (tabs && tabs.length !== srcs.length) throw new Error(`Editor ${name}: ${srcs.length} files and ${tabs.length} tab names`)

const CUT = '// stage: cut'
const files = await Promise.all(
  srcs.map(async (path) => {
    const text = sources[`../../../snippets/${path}`]
    if (text === undefined) throw new Error(`Editor: no file website/snippets/${path}`)
    const all = text.replace(/\r\n?/g, '\n').split('\n')
    const cut = all.findIndex((l) => l.trim() === CUT)
    const shown = (cut < 0 ? all : all.slice(0, cut)).join('\n').replace(/\s+$/, '')
    return (await colourLines(shown, path.endsWith('.js') ? 'js' : 'novis')) as [string, string][][]
  }),
)
// Each distinct tab name is one tab, in the order of its first file.
const names = tabs ? [...new Set(tabs)] : []
const tabOf = (i: number) => (tabs ? names.indexOf(tabs[i]) : 0)
---

<div class="wt-part wt-editor" data-part={name} {...placeAttrs(place)}>
  <div class="wt-win">
    <div class="wt-titlebar">
      <span class="wt-dots"><i></i><i></i><i></i></span>
      {
        tabs ? (
          <span class="wt-etabs">
            {names.map((n) => (
              <span class="wt-etab">{n}</span>
            ))}
          </span>
        ) : (
          <span class="wt-title">{title ?? srcs[0].split('/').at(-1)}</span>
        )
      }
    </div>
    <div class="wt-sheets">
      {
        files.map((lines, f) => (
          <div class="wt-code" data-tab={tabOf(f)}>
            <div class="wt-hl" />
            {lines.map((runs, i) => (
              <div class="wt-line">
                <span class="wt-ln">{i + 1}</span>
                <span class="wt-text">{runs.map(([t, style]) => (style ? <span style={style}>{t}</span> : t))}</span>
              </div>
            ))}
            <div class="wt-caret" />
          </div>
        ))
      }
    </div>
  </div>
</div>
