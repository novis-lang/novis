---
/**
 * The small drawings on the technique cards of the page about testing: one
 * picture of the everyday comparison each card makes. Each is a 96 by 96
 * SVG in the theme's tones, hidden from screen readers because the card's
 * text says the same thing.
 *
 * Each has one quiet motion: dots fly at a box, an eye looks left and right,
 * a bell rings. The motion follows the scroll, a few times over while the
 * drawing crosses the view, so a page that is not scrolling runs no
 * animation at all. Without scroll-driven animations, or when the reader
 * asked for less motion, the drawings are still.
 */
export type ArtName = 'fuzzing' | 'miri' | 'asan' | 'tsan' | 'attack' | 'soak' | 'growth' | 'drill'

interface Props {
  name: ArtName
}

const { name } = Astro.props
---

<svg class:list={['art', name]} viewBox="0 0 96 96" aria-hidden="true" focusable="false">
  <circle class="halo" cx="48" cy="48" r="45"></circle>
  {
    name === 'fuzzing' && (
      <>
        <rect class="line" x="56" y="28" width="26" height="40" rx="6" />
        <path class="line thin" d="M62 40 H76 M62 48 H76 M62 56 H72" />
        {[22, 36, 48, 60, 74].map((y, i) => (
          <circle class="spark fly" cx="14" cy={y} r="3.2" style={`--i: ${i}; --dy: ${48 - y}px`} />
        ))}
      </>
    )
  }
  {
    name === 'miri' && (
      <>
        <rect class="line" x="60" y="14" width="16" height="38" rx="8" />
        <circle class="stop blink" cx="68" cy="24" r="4.2" />
        <circle class="off" cx="68" cy="34" r="4" />
        <circle class="off" cx="68" cy="43" r="4" />
        <path class="road" d="M12 74 Q48 60 84 74" />
        <ellipse class="line" cx="34" cy="50" rx="13" ry="8.5" />
        <circle class="fill look" cx="34" cy="50" r="3.8" />
      </>
    )
  }
  {
    name === 'asan' && (
      <>
        {[16, 40, 64].map((x) => (
          <rect class="line" x={x} y="38" width="16" height="22" rx="3" />
        ))}
        <path class="wire" d="M10 32 H86 M10 66 H86" />
        <circle class="spark blink" cx="58" cy="32" r="4" />
      </>
    )
  }
  {
    name === 'tsan' && (
      <>
        <path class="line thin" d="M18 30 H78 M18 66 H78 M18 30 V66 M38 30 V66 M58 30 V66 M78 30 V66 M18 48 H78" />
        <rect class="cell" x="38" y="30" width="20" height="18" />
        <path class="fill hand left" d="M14 70 L24 52 L27 63 L35 60 Z" />
        <path class="fill hand right" d="M82 70 L72 52 L69 63 L61 60 Z" />
      </>
    )
  }
  {
    name === 'attack' && (
      <>
        <path class="line" d="M34 44 V34 A14 14 0 0 1 62 34 V44" />
        <rect class="line" x="26" y="44" width="44" height="34" rx="6" />
        <circle class="fill" cx="48" cy="58" r="4" />
        <path class="fill" d="M46 60 H50 L51 68 H45 Z" />
        <path class="spark-line pick" d="M48 63 L80 80" />
      </>
    )
  }
  {
    name === 'soak' && (
      <>
        <path class="line" d="M20 22 H50 V30 M30 22 V14 H40 V22" />
        <circle class="spark drop" cx="50" cy="36" r="2.6" />
        <path class="line" d="M34 46 L38 80 H62 L66 46" />
        <path class="water" d="M35.6 58 H64.4 L62 80 H38 Z" />
        <path class="level" d="M24 58 H76" />
      </>
    )
  }
  {
    name === 'growth' && (
      <>
        <path class="line thin" d="M14 80 H84 M14 80 V14" />
        {[6, 12, 24, 48].map((h, i) => (
          <rect class="bar" x={22 + i * 15} y={78 - h} width="10" height={h} rx="2" style={`--i: ${i}`} />
        ))}
        <path class="road" d="M22 74 L82 26" />
        <path class="quad" d="M22 76 Q60 74 70 14" />
      </>
    )
  }
  {
    name === 'drill' && (
      <>
        <g class="bell">
          <path class="line" d="M32 62 C32 40 36 28 48 28 C60 28 64 40 64 62 Z" />
          <path class="line" d="M28 62 H68" />
          <circle class="fill" cx="48" cy="68" r="4" />
        </g>
        <path class="wave" d="M20 36 Q14 46 20 56 M76 36 Q82 46 76 56" />
        <path class="wave late" d="M12 30 Q4 46 12 62 M84 30 Q92 46 84 62" />
      </>
    )
  }
</svg>

<style>
  .art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    --ink: var(--tone, var(--sl-color-accent));
  }
  .halo {
    fill: color-mix(in oklab, var(--ink) 13%, transparent);
  }
  .line,
  .wire,
  .road,
  .quad,
  .wave,
  .level,
  .spark-line {
    fill: none;
    stroke: var(--sl-color-gray-1);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .thin {
    stroke-width: 1.4;
    stroke: var(--sl-color-gray-3);
  }
  .fill {
    fill: var(--sl-color-gray-1);
  }
  .off {
    fill: var(--sl-color-gray-5);
  }
  .stop,
  .spark {
    fill: var(--nv-crimson-text);
  }
  .spark-line {
    stroke: var(--nv-crimson-text);
  }
  .road,
  .wave,
  .level {
    stroke: var(--ink);
  }
  .wire {
    stroke: var(--ink);
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
  }
  .quad {
    stroke: var(--nv-crimson-text);
    stroke-width: 1.6;
    stroke-dasharray: 3 3;
    opacity: 0.7;
  }
  .cell {
    fill: color-mix(in oklab, var(--ink) 35%, transparent);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .water {
    fill: color-mix(in oklab, var(--ink) 35%, transparent);
  }
  .level {
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
  }
  .bar {
    fill: color-mix(in oklab, var(--ink) 55%, transparent);
    stroke: var(--ink);
    stroke-width: 1.2;
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  @media (forced-colors: active) {
    .halo {
      fill: none;
    }
    .line,
    .wire,
    .road,
    .quad,
    .wave,
    .level,
    .spark-line,
    .cell,
    .bar {
      stroke: CanvasText;
    }
    .fill,
    .stop,
    .spark,
    .off {
      fill: CanvasText;
    }
  }

  @keyframes fly {
    0% {
      translate: 0 0;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    80% {
      translate: 40px var(--dy);
      opacity: 1;
    }
    100% {
      translate: 40px var(--dy);
      opacity: 0;
    }
  }
  @keyframes look {
    0%,
    35%,
    100% {
      translate: 0 0;
    }
    50%,
    85% {
      translate: 6px 0;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  @keyframes left {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 8px -6px;
    }
  }
  @keyframes right {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: -8px -6px;
    }
  }
  @keyframes pick {
    0%,
    100% {
      rotate: 0deg;
    }
    50% {
      rotate: -8deg;
    }
  }
  @keyframes drop {
    0% {
      translate: 0 0;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      translate: 0 20px;
      opacity: 0;
    }
  }
  @keyframes grow {
    0%,
    10% {
      scale: 1 0;
    }
    50%,
    100% {
      scale: 1 1;
    }
  }
  @keyframes ring {
    0%,
    60%,
    100% {
      rotate: 0deg;
    }
    10%,
    30% {
      rotate: 12deg;
    }
    20%,
    40% {
      rotate: -12deg;
    }
  }
  @keyframes wave {
    0%,
    100% {
      opacity: 0;
    }
    20%,
    40% {
      opacity: 1;
    }
  }
  .hand {
    transform-box: fill-box;
  }
  .pick {
    transform-origin: 48px 63px;
  }
  .bell {
    transform-origin: 48px 28px;
  }

  /* Longhands only: the build's CSS minifier folds a timeline into the
     `animation` shorthand, which browsers do not accept there. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .art {
        view-timeline: --art block;
      }
      .fly,
      .look,
      .blink,
      .left,
      .right,
      .pick,
      .drop,
      .bar,
      .bell,
      .wave {
        animation-timeline: --art;
        animation-fill-mode: both;
        animation-timing-function: ease-in-out;
      }
      .fly {
        animation-name: fly;
        animation-iteration-count: 3;
        animation-timing-function: ease-in;
        animation-range: cover calc(var(--i) * 5%) cover calc(80% + var(--i) * 4%);
      }
      .look {
        animation-name: look;
        animation-iteration-count: 2;
      }
      .blink {
        animation-name: blink;
        animation-iteration-count: 6;
        animation-timing-function: steps(1);
      }
      .left {
        animation-name: left;
        animation-iteration-count: 3;
      }
      .right {
        animation-name: right;
        animation-iteration-count: 3;
      }
      .pick {
        animation-name: pick;
        animation-iteration-count: 4;
      }
      .drop {
        animation-name: drop;
        animation-iteration-count: 5;
        animation-timing-function: ease-in;
      }
      .bar {
        animation-name: grow;
        animation-iteration-count: 2;
        animation-timing-function: ease-out;
        animation-range: cover calc(var(--i) * 4%) cover calc(88% + var(--i) * 4%);
      }
      .bell {
        animation-name: ring;
        animation-iteration-count: 3;
      }
      .wave {
        animation-name: wave;
        animation-iteration-count: 3;
      }
      .late {
        animation-range: cover 4% cover 100%;
      }
    }
  }
</style>
