---
/**
 * Every example of one member under an "Examples" heading, by
 * FeatureExamples. The page renders this only when the member has an
 * example.
 */
import FeatureExamples from '~/components/FeatureExamples.astro'
import { findMember } from '~/lib/core'

interface Props {
  id: string
}

const found = findMember(Astro.props.id)
if (!found) throw new Error(`MethodExamples: unknown member id "${Astro.props.id}"`)
---

<FeatureExamples feature={found.member} heading="Examples" id="examples" />
