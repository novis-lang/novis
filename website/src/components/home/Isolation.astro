---
/**
 * Request isolation: the text on one side and a small drawing on the other.
 * The drawing shows four requests that run at the same time; one of them
 * goes over its memory limit and stops, and the other three finish. Each
 * point's icon tile is tinted as the drawing is: green for what keeps
 * running, red for the request that stops.
 *
 * The drawing is a `Lanes` diagram (components/diagrams/), whose bars grow
 * as it scrolls into view.
 */
import { Icon } from '@astrojs/starlight/components'
import Section from './Section.astro'
import Rich from './Rich.astro'
import Lanes from '../diagrams/Lanes.astro'
import { withBase } from '~/lib/base'

const lanes = [
  { label: 'GET /', end: 0.97, ok: true },
  { label: 'GET /search', end: 0.85, ok: true },
  { label: 'POST /report', end: 0.47, ok: false, note: 'memory limit' },
  { label: 'GET /cart', end: 0.91, ok: true },
]

const points = [
  { icon: 'puzzle', tint: 'ok', text: 'Each request has its own memory and its own copy of every static property.' },
  { icon: 'setting', tint: 'info', text: 'You set limits for memory and time in `nvs.toml`. They apply to every request.' },
  { icon: 'error', tint: 'danger', text: 'A request that uses more than a limit stops immediately. Only that request stops.' },
]
---

<Section
  id="isolation"
  align="start"
  eyebrow="Every request on its own"
  title="One request cannot break another"
  lead="A request can crash, run out of memory or loop forever. When that happens, only that request stops. The server keeps running, and every other request finishes normally."
>
  <div class="layout">
    <div class="points nv-reveal">
      <ul role="list">
        {
          points.map((p) => (
            <li>
              <span class="nv-icon-tile" data-tint={p.tint}>
                <Icon name={p.icon as any} size="1.2rem" />
              </span>
              <span>
                <Rich text={p.text} />
              </span>
            </li>
          ))
        }
      </ul>
      <div class="links">
        <a class="nv-button nv-button-secondary" href={withBase('/in-depth/concepts/isolation/')}>
          How isolation works
          <Icon name="right-arrow" size="1rem" />
        </a>
        <a class="nv-button nv-button-secondary" href={withBase('/in-depth/concepts/limits/')}>
          Memory and CPU limits
          <Icon name="right-arrow" size="1rem" />
        </a>
      </div>
    </div>

    <Lanes
      class="nv-reveal"
      flush
      title="Four requests run at the same time. One request goes over its memory limit and stops. The other three finish."
      axis="time"
      lanes={lanes}
      legend={{ ok: 'finished', stop: 'stopped, alone' }}
    />
  </div>
</Section>

<style>
  .layout {
    display: grid;
    gap: var(--nv-space-6);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: var(--nv-space-7);
    }
  }

  .points ul {
    display: grid;
    gap: var(--nv-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    display: flex;
    align-items: center;
    gap: var(--nv-space-3);
    color: var(--sl-color-gray-2);
    line-height: 1.6;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nv-space-3);
    margin-block-start: var(--nv-space-6);
  }
  .links .nv-button {
    font-size: var(--sl-text-sm);
  }
</style>
