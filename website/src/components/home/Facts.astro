---
/**
 * A strip of four short facts under the hero. Each is a FeatureLink card, the
 * same card the grid of features uses further down the page. Four columns
 * from 64rem, two from 36rem, one below.
 */
import FeatureLink from './FeatureLink.astro'

const facts = [
  {
    icon: 'warning',
    tint: 'warn',
    title: 'Input is tainted',
    text: 'Text from a request must be checked or escaped before it reaches a database, a shell or a page.',
    href: '/in-depth/concepts/tainted-input/',
  },
  {
    icon: 'puzzle',
    tint: 'ok',
    title: 'Every request on its own',
    text: 'Each request has its own memory. When one request crashes, the others keep running.',
    href: '/in-depth/concepts/isolation/',
  },
  {
    icon: 'setting',
    tint: 'info',
    title: 'One program',
    text: '`nvs` runs your code, serves web requests, runs your tests and formats your files.',
    href: '/reference/cli/one-binary/',
  },
  {
    icon: 'rocket',
    tint: 'highlight',
    title: 'Compiled to machine code',
    text: 'Each file is compiled the first time it is needed. You never run a build step.',
    href: '/in-depth/concepts/compiled/',
  },
] as const
---

<ul class="facts not-content" role="list">
  {
    facts.map((fact) => (
      <li>
        <FeatureLink {...fact} heading="span" />
      </li>
    ))
  }
</ul>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--nv-space-4);
    margin: var(--nv-space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  /* A list item adds no space above a card. */
  .facts > li {
    margin: 0;
  }
</style>
