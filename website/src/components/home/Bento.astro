---
/**
 * A grid of features in cards of different sizes. Four cards hold a snippet,
 * passed in the named slots `conversion`, `unicode`, `json` and `tasks`; four
 * smaller cards are links with an icon. Twelve columns from 64rem, two from
 * 40rem (a snippet card then takes the full width), one below.
 */
import { Icon } from '@astrojs/starlight/components'
import Section from './Section.astro'
import { withBase } from '~/lib/base'
import Rich from './Rich.astro'

type Feature = { icon: string; title: string; text: string; href: string; more: string }

const code: Record<'conversion' | 'unicode' | 'json' | 'tasks', Feature> = {
  conversion: {
    icon: 'approve-check',
    title: 'Every conversion is checked',
    text: '`as int` throws an error when the text is not a whole number. `as ?int` gives `null`, and your code decides what happens next.',
    href: '/guides/why-novis/checked-conversions/',
    more: 'Checked conversions',
  },
  unicode: {
    icon: 'comment',
    title: 'Text as people read it',
    text: '`Core\\Str` counts the characters a person sees. An accent or an emoji stays whole.',
    href: '/guides/why-novis/unicode-strings/',
    more: 'Unicode strings',
  },
  json: {
    icon: 'forward-slash',
    title: 'JSON in one line',
    text: '`Core\\Response::json` sends a value as JSON. A shape keeps its keys in the order you write them.',
    href: '/reference/core/response/',
    more: 'Core\\Response',
  },
  tasks: {
    icon: 'random',
    title: 'Jobs that run at the same time',
    text: '`Core\\Task::all` runs several functions at the same time. Each result has its own name and its own type.',
    href: '/syntax/concurrency/tasks/',
    more: 'Tasks',
  },
}

const links: Feature[] = [
  {
    icon: 'document',
    title: 'HTML that escapes itself',
    text: 'An `html` template escapes every value in it. A comment from a user is shown as text.',
    href: '/guides/why-novis/html-escapes/',
    more: '',
  },
  {
    icon: 'list-format',
    title: 'Typed JSON',
    text: '`Core\\Json::decodeAs` reads JSON into an object of your class and checks every field.',
    href: '/guides/why-novis/typed-json/',
    more: '',
  },
  {
    icon: 'information',
    title: 'Null is checked',
    text: 'A `User` is never `null`. Only a `?User` can be, and the compiler checks every place that uses it.',
    href: '/guides/why-novis/no-null-surprises/',
    more: '',
  },
  {
    icon: 'error',
    title: 'Errors with a default',
    text: '`catch` after a call gives a default value when the call throws an error.',
    href: '/guides/why-novis/simple-errors/',
    more: '',
  },
]
---

<Section
  id="features"
  eyebrow="The language"
  title="Small programs, clear rules"
  lead="Novis checks the things that often go wrong in web code. The checks are part of the language, so there is nothing extra to install."
>
  <div class="bento">
    {
      (['conversion', 'unicode', 'json', 'tasks'] as const).map((key) => {
        const f = code[key]
        return (
          <article class:list={['cell code-cell nv-reveal', key]}>
            <div class="cell-head">
              <span class="nv-icon-tile">
                <Icon name={f.icon as any} size="1.2rem" />
              </span>
              <h3>{f.title}</h3>
            </div>
            <p>
              <Rich text={f.text} />
            </p>
            <div class="snippet">
              {key === 'conversion' && <slot name="conversion" />}
              {key === 'unicode' && <slot name="unicode" />}
              {key === 'json' && <slot name="json" />}
              {key === 'tasks' && <slot name="tasks" />}
            </div>
            <a class="nv-more" href={withBase(f.href)}>
              {f.more} <Icon name="right-arrow" size="1rem" />
            </a>
          </article>
        )
      })
    }
    {
      links.map((f) => (
        <a class="cell link-cell nv-card-link nv-reveal" href={withBase(f.href)}>
          <span class="nv-icon-tile">
            <Icon name={f.icon as any} size="1.2rem" />
          </span>
          <h3>{f.title}</h3>
          <p>
            <Rich text={f.text} />
          </p>
          <span class="arrow" aria-hidden="true">
            <Icon name="right-arrow" size="1.1rem" />
          </span>
        </a>
      ))
    }
  </div>
</Section>

<style>
  .bento {
    display: grid;
    gap: var(--nv-space-4);
  }
  @media (min-width: 40rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .code-cell {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .conversion {
      grid-column: span 7;
    }
    .unicode {
      grid-column: span 5;
    }
    .json {
      grid-column: span 5;
      grid-row: 3;
    }
    .tasks {
      grid-column: span 7;
      grid-row: 3;
    }
    .link-cell {
      grid-column: span 3;
      grid-row: 2;
    }
  }

  .cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--nv-space-3);
    min-width: 0;
    padding: var(--nv-space-5);
    border: 1px solid var(--nv-hairline);
    border-radius: var(--nv-radius-lg);
    background: var(--nv-surface);
    box-shadow: var(--nv-shadow-sm);
  }
  .code-cell {
    background:
      linear-gradient(180deg, var(--nv-wash-soft), transparent 45%),
      var(--nv-surface);
  }
  .cell-head {
    display: flex;
    align-items: center;
    gap: var(--nv-space-3);
  }
  h3 {
    margin: 0;
    font-size: var(--sl-text-lg);
    font-weight: 750;
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: var(--sl-color-white);
  }
  p {
    margin: 0;
    font-size: var(--sl-text-sm);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }
  .snippet {
    flex: 1;
    min-width: 0;
  }
  .snippet :global(.expressive-code) {
    margin: 0;
  }
  .snippet :global(.expressive-code + .expressive-code) {
    margin-top: var(--nv-space-2);
  }
  .snippet :global(.expressive-code pre) {
    font-size: 0.78rem;
  }
  .link-cell {
    text-decoration: none;
    padding-block-end: var(--nv-space-6);
  }
  .link-cell .nv-icon-tile {
    margin-block-end: var(--nv-space-1);
  }
  .arrow {
    position: absolute;
    inset-inline-end: var(--nv-space-4);
    inset-block-end: var(--nv-space-3);
    color: var(--nv-faint);
    transition:
      transform var(--nv-fast) var(--nv-ease),
      color var(--nv-fast) var(--nv-ease);
  }
  .link-cell:hover .arrow {
    color: var(--sl-color-text-accent);
    transform: translateX(3px);
  }
  .link-cell:hover h3 {
    color: var(--sl-color-text-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .link-cell:hover .arrow {
      transform: none;
    }
  }
</style>
