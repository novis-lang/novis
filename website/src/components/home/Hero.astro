---
/**
 * The front page's hero: the page's one `<h1>` with the slogan as its second
 * line, the tagline, the two calls to action, and a code window with three
 * small web programs. The programs come in through the named slots `html`,
 * `sql` and `secret`, because the site checker finds a page's snippets in the
 * page itself. Two columns from 64rem, stacked below.
 *
 * The window is a tablist once the script below has run. Without the script
 * the tablist stays hidden and the three panels are shown one under the
 * other, each with its own label. With it, only the selected panel is shown,
 * and the window is aligned to the top of its column, so the tabs stay where
 * they are when the window's height changes. Arrow keys, Home and End move
 * between the tabs.
 *
 * The `<h1>` carries Starlight's title id, so the skip link lands on it;
 * src/components/PageTitle.astro renders no other title on this page.
 * The glow behind it is static radial gradients: no filter, no animation.
 */
import { Icon } from '@astrojs/starlight/components'
import { INSTALL } from '@config/site.mjs'
import { withBase } from '~/lib/base'

// One entry per tab: the slot its snippet comes in through, the tab's label,
// and the line under the snippet that says what happened.
const panels = [
  { slot: 'html', label: 'HTML', result: 'The script is escaped. Your code calls no escaping function.' },
  { slot: 'sql', label: 'SQL', result: 'The compiler stops SQL injection before the program runs.' },
  { slot: 'secret', label: 'Secrets', result: 'The compiler keeps the password out of the page.' },
] as const
---

<section class="home-hero not-content" aria-labelledby="_top">
  <div class="backdrop" aria-hidden="true"></div>

  <div class="copy">
    <a class="pill" href={withBase('/guides/why-novis/')}>
      <span class="nv-chip">Why Novis?</span>
      <span class="pill-text">What the compiler checks</span>
      <Icon name="right-arrow" size="1rem" />
    </a>
    <h1 id="_top" data-page-title>
      <span class="brand">Novis-Lang</span>
      <span class="headline">The programming language for web applications.</span>
      <span class="slogan nv-gradient-text">Fast. <span class="keep">Secure by default.</span></span>
    </h1>
    <p class="tagline">
      Novis is a programming language for web applications and the command line. It compiles your code to
      machine code. The compiler checks every value that comes from outside.
    </p>
    <div class="actions">
      <a class="nv-button nv-button-primary" href={withBase(INSTALL.href)}>
        Install Novis
        <Icon name="right-arrow" size="1.1rem" />
      </a>
      <a class="nv-button nv-button-secondary" href={withBase('/guides/tour/')}>
        <Icon name="open-book" size="1.1rem" />
        Take the tour
      </a>
    </div>
    <ul class="meta">
      <li><Icon name="approve-check-circle" size="1rem" /> Free and open source</li>
      <li><Icon name="laptop" size="1rem" /> Windows, Linux and macOS</li>
      <li><Icon name="vscode" size="1rem" /> An extension for VS Code</li>
    </ul>
  </div>

  <div class="stage">
    <figure class="window" data-hero-tabs>
      <div class="bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="tabs" role="tablist" aria-label="What the compiler checks" hidden>
          {
            panels.map((p, i) => (
              <button
                type="button"
                role="tab"
                id={`hero-tab-${p.slot}`}
                aria-controls={`hero-panel-${p.slot}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {p.label}
              </button>
            ))
          }
        </div>
        <span class="server" aria-hidden="true">nvs serve</span>
      </div>
      <div class="panels">
        {
          panels.map((p) => (
            <div class="panel" id={`hero-panel-${p.slot}`}>
              <p class="panel-label">{p.label}</p>
              <div class="code">
                {p.slot === 'html' && <slot name="html" />}
                {p.slot === 'sql' && <slot name="sql" />}
                {p.slot === 'secret' && <slot name="secret" />}
              </div>
              <p class="result">
                <span class="result-icon">
                  <Icon name="approve-check" size="0.9rem" />
                </span>
                {p.result}
              </p>
            </div>
          ))
        }
      </div>
      <figcaption class="sr-only">
        Three small Novis programs for a web server, with the response or the compiler error for each.
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // Turns the stacked panels into tabs. Without this script all three stay visible.
  for (const root of document.querySelectorAll<HTMLElement>('[data-hero-tabs]')) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')
    if (list === null) continue
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls') ?? ''))
    if (panels.some((p) => p === null)) continue

    const select = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index
        tab.setAttribute('aria-selected', String(on))
        tab.tabIndex = on ? 0 : -1
        const panel = panels[i] as HTMLElement
        panel.toggleAttribute('data-inactive', !on)
      })
      if (focus) tabs[index]?.focus()
    }

    panels.forEach((panel, i) => {
      const p = panel as HTMLElement
      p.setAttribute('role', 'tabpanel')
      p.setAttribute('aria-labelledby', tabs[i]?.id ?? '')
      p.tabIndex = 0
    })
    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i, false)))
    list.addEventListener('keydown', (event) => {
      const current = tabs.indexOf(document.activeElement as HTMLButtonElement)
      if (current < 0) return
      const last = tabs.length - 1
      const next =
        event.key === 'ArrowRight' ? (current === last ? 0 : current + 1)
        : event.key === 'ArrowLeft' ? (current === 0 ? last : current - 1)
        : event.key === 'Home' ? 0
        : event.key === 'End' ? last
        : -1
      if (next < 0) return
      event.preventDefault()
      select(next, true)
    })

    select(0, false)
    list.hidden = false
    root.setAttribute('data-tabs-ready', '')
  }
</script>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--nv-space-7);
    align-items: center;
    padding-block: var(--nv-space-6) var(--nv-space-5);
  }
  @media (min-width: 64rem) {
    .home-hero {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--nv-space-6);
      padding-block: var(--nv-space-8) var(--nv-space-7);
    }
  }

  /* Two soft color fields and a dot grid that fades out at its edges. */
  .backdrop {
    position: absolute;
    z-index: -1;
    inset: -3rem 0 -2rem;
    pointer-events: none;
    background:
      radial-gradient(38% 46% at 82% 38%, color-mix(in oklab, var(--nv-violet) 26%, transparent), transparent 70%),
      radial-gradient(30% 40% at 58% 78%, color-mix(in oklab, var(--nv-crimson) 20%, transparent), transparent 70%),
      radial-gradient(22% 30% at 12% 10%, color-mix(in oklab, var(--nv-gold) 10%, transparent), transparent 70%);
  }
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in oklab, var(--sl-color-white) 16%, transparent) 1px, transparent 1.5px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 70% 45%, black 10%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 70% at 70% 45%, black 10%, transparent 75%);
  }
  :global([data-theme='light']) .backdrop {
    background:
      radial-gradient(38% 46% at 82% 38%, color-mix(in oklab, var(--nv-violet) 16%, transparent), transparent 70%),
      radial-gradient(30% 40% at 58% 78%, color-mix(in oklab, var(--nv-crimson) 10%, transparent), transparent 70%),
      radial-gradient(22% 30% at 12% 10%, color-mix(in oklab, var(--nv-gold) 14%, transparent), transparent 70%);
  }

  /* The column is a size container, so the name above the headline can be
     sized to its width. */
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--nv-space-5);
    container-type: inline-size;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--nv-space-2);
    max-width: 100%;
    padding: 0.25rem 0.75rem 0.25rem 0.3rem;
    border: 1px solid var(--nv-hairline-strong);
    border-radius: var(--nv-radius-pill);
    background: var(--nv-surface);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: var(--nv-shadow-sm);
    transition:
      border-color var(--nv-fast) var(--nv-ease),
      color var(--nv-fast) var(--nv-ease),
      transform var(--nv-fast) var(--nv-ease);
  }
  .pill .nv-chip,
  .pill svg {
    flex-shrink: 0;
  }
  .pill-text {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pill svg {
    transition: transform var(--nv-fast) var(--nv-ease);
  }
  .pill:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .pill:hover svg {
    transform: translateX(3px);
  }
  .pill:active {
    transform: scale(0.98);
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: 0.12em;
    margin: 0;
    font-size: clamp(2.1rem, 1.5rem + 1.9vw, 3rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
  }
  h1 > span {
    text-wrap: balance;
  }
  /* The project's name, the trademark: the one line of the page set larger
     than the headline, in a gradient from the text color into violet and
     crimson, over a short bar in the signature line. Its size follows the
     column's width, so the one line always fits the column. */
  .brand {
    position: relative;
    align-self: flex-start;
    margin-block-end: 0.32em;
    padding-block-end: 0.12em;
    font-size: clamp(2.5rem, 17cqi, 5.4rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
    background: linear-gradient(
      100deg,
      var(--sl-color-white) 0%,
      var(--sl-color-white) 28%,
      var(--nv-grad-b) 62%,
      var(--nv-grad-a) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .brand::after {
    content: '';
    position: absolute;
    inset-inline-start: 0.04em;
    inset-block-end: -0.12em;
    width: 1.6em;
    height: 0.07em;
    min-height: 3px;
    border-radius: 999px;
    background: var(--nv-gradient-line);
  }
  @media (forced-colors: active) {
    .brand {
      background: none;
      color: CanvasText;
      -webkit-text-fill-color: CanvasText;
    }
    .brand::after {
      background: CanvasText;
    }
  }
  .slogan {
    /* Room for descenders inside the clipped background. */
    padding-block-end: 0.06em;
  }
  /* The slogan breaks after "Fast." when it needs two lines. */
  .slogan .keep {
    display: inline-block;
  }

  .tagline {
    margin: 0;
    max-width: 34rem;
    font-size: var(--sl-text-lg);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nv-space-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--nv-space-2) var(--nv-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .meta svg {
    color: var(--sl-color-text-accent);
  }

  /* ------------------------------------------------------------ the window */
  .stage {
    min-width: 0;
  }
  @media (min-width: 64rem) {
    .stage {
      align-self: start;
      margin-block-start: var(--nv-space-7);
    }
  }
  .window {
    position: relative;
    margin: 0;
    border: 1px solid var(--nv-hairline-strong);
    border-radius: var(--nv-radius-lg);
    background: var(--nv-code-bg);
    box-shadow: var(--nv-shadow-lg), 0 30px 80px -40px color-mix(in oklab, var(--nv-violet) 60%, transparent);
    overflow: hidden;
  }
  /* A gradient hairline along the top edge. */
  .window::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    height: 1px;
    background: var(--nv-gradient-line);
    opacity: 0.9;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--nv-space-3);
    min-height: 2.75rem;
    padding: 0 0.9rem;
    border-bottom: 1px solid var(--nv-hairline);
    background: var(--nv-surface-2);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }
  .dots {
    display: inline-flex;
    flex-shrink: 0;
    gap: 0.4rem;
  }
  .dots i {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--nv-crimson-fill);
  }
  .dots i:nth-child(2) {
    background: var(--nv-gold);
  }
  .dots i:nth-child(3) {
    background: var(--sl-color-accent);
  }
  .server {
    margin-inline-start: auto;
    padding: 0.1rem 0.5rem;
    border-radius: var(--nv-radius-pill);
    background: var(--nv-wash);
    color: var(--sl-color-text-accent);
    font-weight: 600;
    white-space: nowrap;
  }

  /* The tabs sit in the bar; the selected one has the code's ground and an
     accent line along its bottom edge. */
  .tabs {
    display: flex;
    align-self: stretch;
    gap: 0.15rem;
    min-width: 0;
  }
  .tabs[hidden] {
    display: none;
  }
  .tabs button {
    position: relative;
    padding: 0 0.75rem;
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-family: var(--sl-font);
    font-size: var(--sl-text-sm);
    font-weight: 650;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--nv-fast) var(--nv-ease),
      background-color var(--nv-fast) var(--nv-ease);
  }
  .tabs button:hover {
    color: var(--sl-color-white);
    background: var(--nv-hover);
  }
  .tabs button[aria-selected='true'] {
    color: var(--sl-color-white);
    background: var(--nv-code-bg);
  }
  .tabs button[aria-selected='true']::after {
    content: '';
    position: absolute;
    inset: auto 0.5rem 0;
    height: 2px;
    border-radius: 2px 2px 0 0;
    background: var(--sl-color-accent);
  }
  .tabs button:focus-visible {
    outline-offset: -2px;
  }

  /* Without the script: the panels one under the other, each with a label. */
  .panel + .panel {
    border-top: 1px solid var(--nv-hairline-strong);
  }
  .panel-label {
    margin: 0;
    padding: 0.5rem 0.9rem 0;
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
  }

  /* With the script: only the selected panel is shown. */
  [data-tabs-ready] .panel {
    border-top: 0;
  }
  [data-tabs-ready] .panel[data-inactive] {
    display: none;
  }
  [data-tabs-ready] .panel-label {
    display: none;
  }
  [data-tabs-ready] .panel:focus-visible {
    outline-offset: -2px;
  }

  .result {
    display: flex;
    align-items: center;
    gap: var(--nv-space-2);
    margin: 0;
    padding: 0.7rem 0.9rem;
    border-top: 1px solid var(--nv-hairline);
    background: color-mix(in oklab, var(--nv-ok) 8%, var(--nv-surface-2));
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.4;
    color: var(--sl-color-white);
  }
  .result-icon {
    display: inline-flex;
    flex-shrink: 0;
    padding: 0.2rem;
    border-radius: 50%;
    background: var(--nv-ok);
    color: var(--sl-color-black);
  }

  /* The snippet inside: no frame of its own, the window is the frame. */
  .code :global(.expressive-code) {
    margin: 0;
  }
  .code :global(.expressive-code + .expressive-code) {
    margin: 0;
  }
  .code :global(.expressive-code .frame) {
    border-radius: 0;
    box-shadow: none;
  }
  .code :global(.expressive-code pre) {
    border: 0;
    border-radius: 0;
    font-size: 0.75rem;
  }
  /* A diagnostic wraps its long lines, so the reader sees all of it. */
  .code :global([data-snippet-part='diagnostic'] .expressive-code pre) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .code :global(.expressive-code .frame.has-title .header) {
    border-radius: 0;
  }
  .code :global(.expressive-code + .expressive-code .frame) {
    border-top: 1px solid var(--nv-hairline);
  }
  /* A compiler error keeps its red edge and tint, without the gap and the
     rounded corners it has elsewhere. */
  .code :global([data-snippet-part='diagnostic']) {
    margin: 0;
    border-top: 1px solid var(--nv-hairline);
  }
  .code :global([data-snippet-part='diagnostic'] .expressive-code .frame) {
    border-radius: 0;
    box-shadow: inset 3px 0 0 var(--nv-danger);
  }

  @media (max-width: 49.99rem) {
    .home-hero {
      gap: var(--nv-space-6);
      padding-block-start: var(--nv-space-4);
    }
    .tagline {
      font-size: var(--sl-text-base);
    }
    .actions {
      width: 100%;
    }
    .actions .nv-button {
      flex: 1 1 12rem;
      justify-content: center;
    }
    .pill {
      width: 100%;
      justify-content: center;
    }
    .server {
      display: none;
    }
  }
</style>
