---
/**
 * The front page's hero, in two rows. The first is the page's one `<h1>`,
 * centred across the full width: the name Novis-Lang, the headline with the
 * small note "and the command line" above its words "web applications", and
 * the slogan. The second is the tagline, the two calls to action and the facts
 * beside a code window with three small web programs. The programs come in
 * through the named slots `html`, `sql` and `secret`, because the site
 * checker finds a page's snippets in the page itself. The second row has two
 * columns from 64rem; below that it is stacked, and its text is centred too.
 *
 * The window is a tablist once the script below has run. Without the script
 * the tablist stays hidden and the three panels are shown one under the
 * other, each with its own label. With it, only the selected panel is shown,
 * and the window is aligned to the top of its column, so the tabs stay where
 * they are when the window's height changes. Arrow keys, Home and End move
 * between the tabs.
 *
 * The `<h1>` carries Starlight's title id, so the skip link lands on it;
 * src/components/PageTitle.astro renders no other title on this page.
 *
 * The slogan turns through a list of short phrases, one every few seconds,
 * each swinging down out of view as the next swings in from above. A click
 * on it shows the next phrase and ends the automatic turning for the rest of
 * the page view. The phrases are a separate, aria-hidden copy laid
 * over the slogan, so a screen reader reads the slogan alone and never hears
 * a change. Without the script the slogan stands still. When the reader asks
 * for less motion it also stands still, and a click swaps the phrase without
 * the swing. The turning waits while the hero is off-screen or the tab is
 * hidden.
 *
 * The bar under the name grows from its centre on load, and a glow behind it
 * breathes slowly. The three color fields behind the title drift and swell.
 * All of this motion is transform and opacity alone, and none of it runs when
 * the reader asks for less motion.
 */
import { Icon } from '@astrojs/starlight/components'
import { INSTALL } from '@config/site.mjs'
import { withBase } from '~/lib/base'

// One entry per tab: the slot its snippet comes in through, the tab's label,
// and the line under the snippet that says what happened.
const panels = [
  { slot: 'html', label: 'HTML', result: 'The script is escaped. Your code calls no escaping function.' },
  { slot: 'sql', label: 'SQL', result: 'The compiler stops SQL injection before the program runs.' },
  { slot: 'secret', label: 'Secrets', result: 'The compiler keeps the password out of the page.' },
] as const

// The phrases the slogan turns through after its own first one, in order.
// Each repeats something a section further down the page says.
const phrases = [
  'Agentic coding is easy.',
  'No SQL injection.',
  'HTML escapes itself.',
  'Secrets stay secret.',
  'Every request on its own.',
  'Null is checked.',
  'Typed JSON.',
  'Tests in your code.',
  'All tools built in.',
] as const
---

<section class="home-hero not-content" aria-labelledby="_top">
  <div class="backdrop" aria-hidden="true">
    <i class="field field-violet"></i>
    <i class="field field-crimson"></i>
    <i class="field field-gold"></i>
  </div>

  <div class="title">
    <h1 id="_top" data-page-title>
      <span class="brand">Novis-Lang</span>
      <span class="headline"
        >The programming language for <span class="noted"
          >web applications<span class="note"
            ><span class="sr-only"> (</span>and the command line<span class="sr-only">)</span></span
          ></span
        >.</span
      >
      <span class="slogan" data-slogan>
        <span class="slogan-text nv-gradient-text">Fast. <span class="keep">Secure by default.</span></span>
        <span class="rotator" aria-hidden="true">
          <span class="phrase nv-gradient-text" data-phrase data-state="in">
            Fast. <span class="keep">Secure by default.</span>
          </span>
          {phrases.map((p) => <span class="phrase nv-gradient-text" data-phrase>{p}</span>)}
        </span>
      </span>
    </h1>
  </div>

  <div class="copy">
    <div class="text">
      <p class="tagline">
        You can build a business app, a website, an API or any other web service with it. The tools that a modern
        web application needs are built in.
      </p>
    </div>
    <div class="actions">
      <a class="nv-button nv-button-primary" href={withBase(INSTALL.href)}>
        Install Novis
        <Icon name="right-arrow" size="1.1rem" />
      </a>
      <a class="nv-button nv-button-secondary" href={withBase('/guides/tour/')}>
        <Icon name="open-book" size="1.1rem" />
        Take the tour
      </a>
    </div>
    <ul class="meta">
      <li><Icon name="approve-check-circle" size="1rem" /> Free and open source</li>
      <li><Icon name="laptop" size="1rem" /> Windows, Linux and macOS</li>
      <li><Icon name="vscode" size="1rem" /> An extension for VS Code</li>
    </ul>
  </div>

  <div class="stage">
    <figure class="window" data-hero-tabs>
      <div class="bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="tabs" role="tablist" aria-label="What the compiler checks" hidden>
          {
            panels.map((p, i) => (
              <button
                type="button"
                role="tab"
                id={`hero-tab-${p.slot}`}
                aria-controls={`hero-panel-${p.slot}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {p.label}
              </button>
            ))
          }
        </div>
        <span class="server" aria-hidden="true">nvs serve</span>
      </div>
      <div class="panels">
        {
          panels.map((p) => (
            <div class="panel" id={`hero-panel-${p.slot}`}>
              <p class="panel-label">{p.label}</p>
              <div class="code">
                {p.slot === 'html' && <slot name="html" />}
                {p.slot === 'sql' && <slot name="sql" />}
                {p.slot === 'secret' && <slot name="secret" />}
              </div>
              <p class="result">
                <span class="result-icon">
                  <Icon name="approve-check" size="0.9rem" />
                </span>
                {p.result}
              </p>
            </div>
          ))
        }
      </div>
      <figcaption class="sr-only">
        Three small Novis programs for a web server, with the response or the compiler error for each.
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // Turns the stacked panels into tabs. Without this script all three stay visible.
  for (const root of document.querySelectorAll<HTMLElement>('[data-hero-tabs]')) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')
    if (list === null) continue
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute('aria-controls') ?? ''))
    if (panels.some((p) => p === null)) continue

    const select = (index: number, focus: boolean) => {
      tabs.forEach((tab, i) => {
        const on = i === index
        tab.setAttribute('aria-selected', String(on))
        tab.tabIndex = on ? 0 : -1
        const panel = panels[i] as HTMLElement
        panel.toggleAttribute('data-inactive', !on)
      })
      if (focus) tabs[index]?.focus()
    }

    panels.forEach((panel, i) => {
      const p = panel as HTMLElement
      p.setAttribute('role', 'tabpanel')
      p.setAttribute('aria-labelledby', tabs[i]?.id ?? '')
      p.tabIndex = 0
    })
    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i, false)))
    list.addEventListener('keydown', (event) => {
      const current = tabs.indexOf(document.activeElement as HTMLButtonElement)
      if (current < 0) return
      const last = tabs.length - 1
      const next =
        event.key === 'ArrowRight' ? (current === last ? 0 : current + 1)
        : event.key === 'ArrowLeft' ? (current === 0 ? last : current - 1)
        : event.key === 'Home' ? 0
        : event.key === 'End' ? last
        : -1
      if (next < 0) return
      event.preventDefault()
      select(next, true)
    })

    select(0, false)
    list.hidden = false
    root.setAttribute('data-tabs-ready', '')
  }

  // Turns the slogan through its phrases. Without this script the slogan stays as it is.
  // The rotation runs only when the reader allows motion, and it waits while the hero is
  // off-screen or the tab is hidden. A click shows the next phrase and ends the rotation.
  const HOLD = 3400
  for (const root of document.querySelectorAll<HTMLElement>('[data-slogan]')) {
    const phrases = [...root.querySelectorAll<HTMLElement>('[data-phrase]')]
    const hero = root.closest<HTMLElement>('.home-hero')
    if (phrases.length < 2 || hero === null) continue
    const motion = matchMedia('(prefers-reduced-motion: no-preference)')
    let current = 0
    let clicked = false
    let onScreen = true
    let timer = 0

    const show = (index: number) => {
      phrases.forEach((phrase, i) => {
        if (i === index) phrase.dataset.state = 'in'
        else if (i === current) phrase.dataset.state = 'out'
        else delete phrase.dataset.state
      })
      current = index
    }
    const next = () => show((current + 1) % phrases.length)

    const update = () => {
      const active = motion.matches || clicked
      if (!active && current !== 0) show(0)
      root.toggleAttribute('data-running', active)
      const rotate = motion.matches && !clicked && onScreen && !document.hidden
      if (rotate && timer === 0) timer = window.setInterval(next, HOLD)
      if (!rotate && timer !== 0) {
        window.clearInterval(timer)
        timer = 0
      }
    }

    root.addEventListener('click', () => {
      clicked = true
      update()
      next()
    })
    motion.addEventListener('change', update)
    document.addEventListener('visibilitychange', update)
    new IntersectionObserver((entries) => {
      onScreen = entries.some((entry) => entry.isIntersecting)
      hero.toggleAttribute('data-offscreen', !onScreen)
      update()
    }).observe(hero)

    root.setAttribute('data-slogan-ready', '')
    update()
  }
</script>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--nv-space-7);
    align-items: center;
    padding-block: var(--nv-space-6) var(--nv-space-5);
  }
  @media (min-width: 64rem) {
    .home-hero {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--nv-space-7) var(--nv-space-7);
      align-items: start;
      padding-block: var(--nv-space-8) var(--nv-space-7);
    }
  }

  /* Three soft color fields and a dot grid. The mask fades the whole
     backdrop out before it reaches any edge of its box, so no color field
     and no dot stops at a line. Each field is its own element, an ellipse
     drawn by a radial gradient that fills it, so it can move without being
     painted again. */
  .backdrop {
    position: absolute;
    z-index: -1;
    inset: -3rem 0 -2rem;
    overflow: hidden;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(farthest-side at 50% 50%, black 55%, transparent 100%);
    mask-image: radial-gradient(farthest-side at 50% 50%, black 55%, transparent 100%);
  }
  .field {
    position: absolute;
    background: radial-gradient(closest-side, var(--glow), transparent 70%);
  }
  .field-violet {
    --glow: color-mix(in oklab, var(--nv-violet) 26%, transparent);
    inset: -2% -6% 14% 38%;
  }
  .field-crimson {
    --glow: color-mix(in oklab, var(--nv-crimson) 20%, transparent);
    inset: 44% 26% -16% 14%;
  }
  .field-gold {
    --glow: color-mix(in oklab, var(--nv-gold) 10%, transparent);
    inset: -4% 48% 44% 4%;
  }
  :global([data-theme='light']) .field-violet {
    --glow: color-mix(in oklab, var(--nv-violet) 16%, transparent);
  }
  :global([data-theme='light']) .field-crimson {
    --glow: color-mix(in oklab, var(--nv-crimson) 10%, transparent);
  }
  :global([data-theme='light']) .field-gold {
    --glow: color-mix(in oklab, var(--nv-gold) 14%, transparent);
  }
  /* The fields drift and swell slowly. The three durations share no
     common beat, so the picture never repeats in a way the eye can follow.
     Only transform and opacity change. */
  @keyframes drift-violet {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-7%, 6%) scale(1.12);
    }
    100% {
      transform: translate(-3%, -5%) scale(0.94);
    }
  }
  @keyframes drift-crimson {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 1;
    }
    50% {
      transform: translate(9%, -7%) scale(1.15);
      opacity: 0.75;
    }
    100% {
      transform: translate(4%, 4%) scale(0.92);
      opacity: 1;
    }
  }
  @keyframes drift-gold {
    0% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(8%, 10%) scale(1.2);
    }
    100% {
      transform: translate(-4%, 4%) scale(1.05);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .field-violet {
      animation: drift-violet 23s ease-in-out infinite alternate;
    }
    .field-crimson {
      animation: drift-crimson 29s ease-in-out -7s infinite alternate;
    }
    .field-gold {
      animation: drift-gold 17s ease-in-out -4s infinite alternate;
    }
  }
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(color-mix(in oklab, var(--sl-color-white) 16%, transparent) 1px, transparent 1.5px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 50% 60% at 55% 45%, black 10%, transparent 80%);
    mask-image: radial-gradient(ellipse 50% 60% at 55% 45%, black 10%, transparent 80%);
  }
  :global([data-theme='light']) .backdrop {
    background:
      radial-gradient(34% 44% at 72% 42%, color-mix(in oklab, var(--nv-violet) 16%, transparent), transparent 70%),
      radial-gradient(30% 36% at 44% 80%, color-mix(in oklab, var(--nv-crimson) 10%, transparent), transparent 70%),
      radial-gradient(24% 30% at 28% 26%, color-mix(in oklab, var(--nv-gold) 14%, transparent), transparent 70%);
  }

  /* The title row spans both columns and is centred. It is a size
     container, so the name can be sized to its width. */
  .title {
    grid-column: 1 / -1;
    container-type: inline-size;
    text-align: center;
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--nv-space-5);
    text-align: center;
  }
  @media (min-width: 64rem) {
    .copy {
      align-items: flex-start;
      padding-block-start: var(--nv-space-4);
      text-align: start;
    }
  }

  h1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.12em;
    max-width: 52rem;
    margin: 0 auto;
    font-size: clamp(2.1rem, 1.4rem + 2.2vw, 3.4rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
  }
  h1 > span {
    text-wrap: balance;
  }
  /* The project's name, the trademark: the one line of the page set larger
     than the headline, in a gradient from the text color into violet and
     crimson, over a short centred bar in the signature line. Its size
     follows the row's width, so the one line always fits. */
  .brand {
    position: relative;
    margin-block-end: 0.32em;
    padding-block-end: 0.12em;
    font-size: clamp(2.5rem, 16cqi, 7rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
    background: linear-gradient(
      100deg,
      var(--sl-color-white) 0%,
      var(--sl-color-white) 28%,
      var(--nv-grad-b) 62%,
      var(--nv-grad-a) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  .brand::before,
  .brand::after {
    content: '';
    position: absolute;
    inset-inline-start: calc(50% - 0.8em);
    inset-block-end: -0.12em;
    width: 1.6em;
    height: 0.07em;
    min-height: 3px;
    border-radius: 999px;
    background: var(--nv-gradient-line);
  }
  /* A soft glow behind the bar: the same bar, blurred once and drawn
     behind the text. */
  .brand::before {
    z-index: -1;
    filter: blur(0.08em);
    opacity: 0.55;
  }
  /* On load the bar grows from its centre, and the glow behind it then
     breathes slowly for as long as the page is open. */
  @keyframes bar-in {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes glow-in {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 0.4;
    }
  }
  @keyframes glow-breathe {
    from {
      transform: scaleX(1) scaleY(1);
      opacity: 0.4;
    }
    to {
      transform: scaleX(1.15) scaleY(1.8);
      opacity: 0.9;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .brand::after {
      animation: bar-in 900ms cubic-bezier(0.16, 1, 0.3, 1) 150ms both;
    }
    .brand::before {
      animation:
        glow-in 900ms cubic-bezier(0.16, 1, 0.3, 1) 150ms both,
        glow-breathe 1.8s ease-in-out 1050ms infinite alternate;
    }
    .home-hero[data-offscreen] .field,
    .home-hero[data-offscreen] .brand::before {
      animation-play-state: paused;
    }
  }
  @media (forced-colors: active) {
    .brand {
      background: none;
      color: CanvasText;
      -webkit-text-fill-color: CanvasText;
    }
    .brand::after {
      background: CanvasText;
    }
  }
  /* The color fields, the dot grid and the glow behind the bar are only
     decoration. With more contrast, less transparency or forced colors they
     are hidden, and with more contrast the name is solid text. */
  @media (prefers-contrast: more), (prefers-reduced-transparency: reduce), (forced-colors: active) {
    .backdrop,
    .brand::before {
      display: none;
    }
  }
  @media (prefers-contrast: more) {
    .brand {
      background: none;
      color: var(--sl-color-white);
      -webkit-text-fill-color: currentColor;
    }
  }

  /* The slogan is one grid cell. The slogan's own text and every phrase of
     the rotator sit in it on top of each other, so the cell is always as
     large as the largest of them and the line never changes size. Without
     the script, the rotator is invisible and the slogan's own text shows.
     While the rotator runs, the slogan's own text is invisible and stays
     there for screen readers; the rotator is hidden from them. */
  .slogan {
    display: grid;
    perspective: 40rem;
  }
  .slogan-text,
  .rotator,
  .phrase {
    grid-area: 1 / 1;
  }
  .rotator {
    display: grid;
    visibility: hidden;
  }
  .slogan-text,
  .phrase {
    justify-self: center;
    align-self: start;
    /* Room for descenders inside the clipped background. */
    padding-block-end: 0.06em;
  }
  /* The slogan breaks after "Fast." when it needs two lines. */
  .slogan .keep {
    display: inline-block;
  }
  [data-slogan-ready] {
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
  }
  [data-running] .slogan-text {
    opacity: 0;
  }
  [data-running] .rotator {
    visibility: visible;
  }

  /* A phrase waits above the line, turned away. It swings down into place,
     and then on down and away while the next one comes in. */
  .phrase {
    opacity: 0;
    transform: translateY(-0.45em) rotateX(80deg);
    transform-origin: 50% 0;
  }
  .phrase[data-state='in'] {
    opacity: 1;
    transform: none;
  }
  .phrase[data-state='out'] {
    opacity: 0;
    transform: translateY(0.45em) rotateX(-80deg);
    transform-origin: 50% 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .phrase[data-state='in'] {
      transition:
        transform 700ms cubic-bezier(0.2, 0.9, 0.3, 1) 260ms,
        opacity 420ms ease-out 260ms;
    }
    .phrase[data-state='out'] {
      transition:
        transform 550ms cubic-bezier(0.55, 0, 0.75, 0.3),
        opacity 340ms ease-in;
    }
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: var(--nv-space-2);
    max-width: 34rem;
  }
  .tagline {
    margin: 0;
    font-size: var(--sl-text-lg);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  /* "and the command line" is a small note written above "web applications",
     tilted a little, like a word added to a finished sentence. It stays out
     of the line, so the sentence reads on without it. A screen reader reads
     it in brackets after the two words. The two words are an inline block
     with room above them for the note, so only their line is taller and the
     note never touches the line above. */
  .noted {
    --note-size: max(0.8rem, 0.3em);
    position: relative;
    display: inline-block;
    padding-block-start: calc(var(--note-size) + 0.24em);
    white-space: nowrap;
  }
  .note {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 0.13em;
    translate: -50% 0;
    rotate: -3deg;
    font-size: var(--note-size);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--sl-color-text-accent);
    pointer-events: none;
  }
  .note::before {
    content: '+ ';
    content: '+ ' / '';
    color: var(--nv-gold);
  }
  :global(:root[data-theme='light']) .note::before {
    color: var(--nv-gold-text);
  }
  @keyframes note-in {
    from {
      opacity: 0;
      translate: -50% 0.4em;
    }
    to {
      opacity: 1;
      translate: -50% 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .note {
      animation: note-in 420ms var(--nv-ease) 650ms both;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--nv-space-3);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--nv-space-2) var(--nv-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .meta svg {
    color: var(--sl-color-text-accent);
  }
  @media (min-width: 64rem) {
    .actions,
    .meta {
      justify-content: flex-start;
    }
  }

  /* ------------------------------------------------------------ the window */
  .stage {
    min-width: 0;
  }

  .window {
    position: relative;
    margin: 0;
    border: 1px solid var(--nv-hairline-strong);
    border-radius: var(--nv-radius-lg);
    background: var(--nv-code-bg);
    box-shadow: var(--nv-shadow-lg), 0 30px 80px -40px color-mix(in oklab, var(--nv-violet) 60%, transparent);
    overflow: hidden;
  }
  /* A gradient hairline along the top edge. */
  .window::before {
    content: '';
