---
/**
 * A page that exists in the navigation but has not been written yet.
 *
 * Placeholder pages are a documentation site's worst habit: they look finished,
 * they rank in search, and they waste the reader's click. This component makes
 * the opposite trade — it says plainly that the page is not written, and sends
 * the reader to the material that *does* exist, which for Novis is usually the
 * design decision the page will eventually be written from.
 *
 * It also excludes the page from the search index, so nobody arrives here from
 * a search expecting an answer.
 *
 * Delete the component from a page the moment real content lands. Every use of
 * it is listed by `python site.py check`.
 */
interface Props {
  /** Design decisions that already cover this material. */
  adrs?: { id: string; title: string }[];
}

const { adrs = [] } = Astro.props;

const RAW_BASE = import.meta.env.BASE_URL || '/';
const BASE = RAW_BASE.endsWith('/') ? RAW_BASE : RAW_BASE + '/';
---

<div class="nv-unwritten" data-pagefind-ignore>
  <p class="nv-unwritten-head">
    <strong>This page has not been written yet.</strong>
  </p>
  <p>
    It is in the navigation because the feature is decided and the page is planned — not because
    there is something here to read. Rather than show you filler, here is where the material
    actually is today.
  </p>
  {
    adrs.length > 0 && (
      <ul>
        {adrs.map((a) => (
          <li>
            <a href={`${BASE}design/adr/${a.id}/`}>{a.title}</a> — the decision this page will be
            written from. Dense, but complete and accurate.
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .nv-unwritten {
    border: 1px solid var(--nv-rule);
    border-inline-start: 3px solid var(--nv-warning);
    background: var(--nv-warning-wash);
    border-radius: 4px;
    padding: 1rem 1.15rem;
    margin-block: 1.5rem;
  }

  .nv-unwritten p {
    margin-block: 0 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .nv-unwritten p:last-child,
  .nv-unwritten ul:last-child {
    margin-block-end: 0;
  }

  .nv-unwritten-head strong {
    color: var(--nv-warning);
  }

  .nv-unwritten ul {
    margin: 0;
    padding-inline-start: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
  }
</style>
