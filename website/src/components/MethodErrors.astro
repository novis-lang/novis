---
/**
 * A member's "Errors" section body: each error its registry card lists, and
 * when it is thrown. The page renders this only when the card lists one.
 */
import { findMember } from '~/lib/core'

interface Props {
  id: string
}

const { id } = Astro.props
const found = findMember(id)
if (!found) throw new Error(`MethodErrors: unknown member id "${id}"`)
const errors = found.member.doc?.errors ?? []
---

<ul class="nv-param-docs">
  {errors.map((e) => (
    <li>
      <strong>
        <code>{e.error}</code>
      </strong>
      {e.descHtml && <>{' '}— <span set:html={e.descHtml} /></>}
    </li>
  ))}
</ul>
