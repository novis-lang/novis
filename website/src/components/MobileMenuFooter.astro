---
/**
 * MobileMenuFooter override: the site navigation (hidden from the header on
 * small screens) followed by the default social icons and theme switcher.
 * The sidebar renders it at its foot; on a page without a sidebar it is the
 * whole of the mobile menu (see PageFrame.astro).
 */
import Default from '@astrojs/starlight/components/MobileMenuFooter.astro'
import { AREAS, INSTALL } from '@config/site.mjs'
import { withBase } from '~/lib/base'
---

<nav class="nv-mobile-nav" aria-label="Site">
  {AREAS.map((area) => <a href={withBase(area.href)}>{area.label}</a>)}
  <a href={withBase(INSTALL.href)}>{INSTALL.label}</a>
  <a href={withBase('/sponsoring/')}>Sponsoring</a>
</nav>
<Default><slot /></Default>

<style>
  .nv-mobile-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    padding: 0.75rem var(--sl-sidebar-pad-x, 1rem);
    border-top: 1px solid var(--sl-color-hairline);
  }
  .nv-mobile-nav a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }
</style>
