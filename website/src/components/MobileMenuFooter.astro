---
/**
 * MobileMenuFooter override: the site navigation (hidden from the header on
 * small screens) followed by the default social icons and theme switcher.
 * The sidebar renders it at its foot; on a page without a sidebar it is the
 * whole of the mobile menu (see PageFrame.astro).
 */
import Default from '@astrojs/starlight/components/MobileMenuFooter.astro'
import { AREAS, INSTALL } from '@config/site.mjs'
import { withBase } from '~/lib/base'
---

<nav class="nv-mobile-nav" aria-label="Site">
  {AREAS.map((area) => <a href={withBase(area.href)}>{area.label}</a>)}
  <a href={withBase(INSTALL.href)}>{INSTALL.label}</a>
  <a href={withBase('/sponsoring/')}>Sponsoring</a>
</nav>
<Default><slot /></Default>

<style>
  /* Two columns of 44px tiles. */
  .nv-mobile-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--nv-space-2);
    padding-block: var(--nv-space-4);
    border-top: 1px solid var(--nv-hairline);
  }
  .nv-mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--nv-space-4);
    border: 1px solid var(--nv-hairline);
    border-radius: var(--nv-radius);
    background-color: var(--nv-surface);
    color: var(--sl-color-white);
    font-weight: 650;
    text-decoration: none;
    transition:
      background-color var(--nv-fast) var(--nv-ease),
      border-color var(--nv-fast) var(--nv-ease);
  }
  .nv-mobile-nav a:hover,
  .nv-mobile-nav a:active {
    border-color: var(--sl-color-accent);
    background-color: var(--nv-wash-soft);
  }
</style>
