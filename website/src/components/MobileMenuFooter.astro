---
/**
 * MobileMenuFooter override, for a page without a sidebar: there it is the
 * whole of the mobile menu (see PageFrame.astro), so it starts with the site
 * navigation (SiteNav.astro) and then shows the default social icons and
 * theme switch, whose own line sets the two apart. A page with a sidebar shows the site navigation at the top of
 * its menu instead, and the default footer at the end (see Sidebar.astro).
 */
import Default from '@astrojs/starlight/components/MobileMenuFooter.astro'
import SiteNav from './SiteNav.astro'
---

<SiteNav divider={false} />
<Default><slot /></Default>
