---
/**
 * MobileMenuFooter override: the site navigation (hidden from the header on
 * small screens) followed by the default social icons and theme switcher.
 */
import Default from '@astrojs/starlight/components/MobileMenuFooter.astro'
import { withBase } from '~/lib/base'
---

<nav class="nv-mobile-nav" aria-label="Site">
  <a href={withBase('/')}>Novis</a>
  <a href={withBase('/docs/')}>Docs</a>
  <a href={withBase('/why-novis/')}>Why Novis?</a>
  <a href={withBase('/sponsoring/')}>Sponsoring</a>
</nav>
<Default><slot /></Default>

<style>
  .nv-mobile-nav {
    display: flex;
    gap: 1.25rem;
    padding: 0.75rem var(--sl-sidebar-pad-x, 1rem);
    border-top: 1px solid var(--sl-color-hairline);
  }
  .nv-mobile-nav a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }
</style>
