{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Read|Bash|PowerShell", "hooks": [ { "type": "command", "command": "bun nv guard" } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python tools/peek.py:*)",
      "Bash(bun nv peek:*)",
      "Bash(bun nv brief:*)",
      "Bash(bun nv orient:*)",
      "Bash(bun nv verify:*)",
      "Bash(bun nv rules:*)",
      "Bash(bun nv plan:*)",
      "Bash(bun nv playbook:*)",
      "Bash(bun nv records:*)",
      "Bash(bun nv links:*)",
      "Bash(bun nv loop-stats:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(./target/debug/nvs.exe:*)",
      "Bash(target/debug/nvs.exe:*)"
    ]
  }
}